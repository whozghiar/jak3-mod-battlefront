;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-portraits.gc
;; name in dgo: battlefront-portraits
;; dgos: GAME

#|
  Battlefront mod -- the class page's picture of each class (battlefront.gc `bf-draw-portrait`).

  GENERATED by scripts/battlefront/make_portraits.py from smoke scenario 53's screenshots (each
  class model alone on black): do not edit by hand. One 512 x 128 texture of 8-bit palette
  indices, a 80 x 120 cell for each class side by side, palette index 0 transparent.
|#

