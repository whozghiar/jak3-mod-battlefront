;; GS TEX0 of the texture as uploaded (tbp 8, mt8, 512 x 128, its alpha used, palette loaded).
(define *bf-portrait-tex0* (new 'static 'array uint64 1 #x20000005e5320008))

;; The cell of each class (BF_CLASS_*), -1 for none.
(define *bf-portrait-cell* (new 'static 'array int32 8 0 1 -1 -1 2 3 4 5))

(defconstant BF_PORTRAIT_W 80) ;; a cell's texels across
(defconstant BF_PORTRAIT_H 120) ;; and down
(defconstant BF_PORTRAIT_TEX_W 512)
(defconstant BF_PORTRAIT_TEX_H 128)
