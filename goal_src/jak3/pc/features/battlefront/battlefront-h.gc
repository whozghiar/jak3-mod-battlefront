;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-h.gc
;; name in dgo: battlefront-h
;; dgos: GAME

#|
  Battlefront mod (jak3-mod-battlefront) -- shared state, zone and class tables, skeletons of the
  Jak 2 models, and the functions the stock Haven City code calls.

  Why GAME: the stock unit code that calls into the mod (guard.gc, flying-turret.gc,
  traffic-engine.gc, traffic-manager.gc) is level code, linked again every time CWI, CTYPESA,
  CTYPESC, DESRESC or WWD loads. The functions it calls must exist whichever of those levels is
  loaded, so they live here, in GAME, and every one of them returns the stock answer while no
  battle runs.

  How a battle is wired (details in docs/modding/current_mod/battlefront_readme.md):
    * the Freedom League side is the stock Freedom League guards (`crimson-guard`, traffic type
      guard-a) and blue jetpack guards (the Spargus Citizen is a player class only: see
      battlefront-city.gc);
    * the Krimzon Guard side is red Krimzon Guards (Jak 2 model on the `crimson-guard` code, from
      the same guard-a pool), red jetpack guards, KG roboguards (`roboguard-city`) and spider
      robots (`spydroid`);
    * both jetpack guards are the Jak 2 hover guard drawn on the stock KG `flying-turret` code;
    * Haven City's attack controller makes them fight: the red guards register as roboguards and
      the blue jetpacks as rifle guards, so each side hates the other with the stock hatred table.
|#

;; DECOMP BEGINS

;; ---------------------------------------------------------------------------------------------
;; Constants
;; ---------------------------------------------------------------------------------------------

(defconstant BF_RESERVE 500)          ;; units in stock per side at the start of a battle
(defconstant BF_TEAM_COUNT 2)
(defconstant BF_CLASS_COUNT 9)
(defconstant BF_ZONE_COUNT 3)          ;; Jak 3's Haven City, Jak 2's Haven City, Spargus (`*bf-zones*`)
(defconstant BF_ZONE_FIRST 1)          ;; the first zone of the war zone page: Jak 3's city no longer offered (round 42, the author's wish)
(defconstant BF_ZONE_JAK2 1)           ;; Jak 2's Haven City (bf-havenj2), when the player's discs built it
(defconstant BF_ZONE_SPARGUS 2)        ;; Jak 3's Spargus (bf-spargus, round 50), when the level port built it

;; Teams. The values index `reserve` and `losses` in `bf-state`.
(defconstant BF_TEAM_NONE -1)
(defconstant BF_TEAM_FF 0)            ;; Freedom League ("Ligue de la liberte")
(defconstant BF_TEAM_KG 1)            ;; Krimzon Guard ("Grenagarde")

;; Classes. 0-3 Freedom League, 4-7 Krimzon Guard. Neither the Spargus Citizen (2) nor Jak (3) is
;; playable any more: their entries only keep the indices. Round 46: the Freedom League offers the
;; robotguard and the spider robot too, classes 6 and 7 drawn blue (`bf-row-class`).
(defconstant BF_CLASS_BLUE_GUARD 0)
(defconstant BF_CLASS_BLUE_JETPACK 1)
(defconstant BF_CLASS_WASTELANDER 2)
(defconstant BF_CLASS_JAK 3)
(defconstant BF_CLASS_RED_GUARD 4)
(defconstant BF_CLASS_RED_JETPACK 5)
(defconstant BF_CLASS_ROBOGUARD 6)
(defconstant BF_CLASS_SPYDROID 7)
(defconstant BF_CLASS_BARON 8)    ;; Baron Praxis, the Krimzon Guard's special character (round 44, battlefront-baron.gc)
(defconstant BF_CLASS_ASHELIN 9)  ;; Ashelin, the Freedom League's special character (round 53, battlefront-ashelin.gc)
(defconstant BF_CLASS_COUNT 10)

(defun bf-row-class ((team int) (row int))
  "The class on row ROW of side TEAM's class page: the Krimzon Guard's 4 on (Baron Praxis 8 on row
   4), the Freedom League's 0 and 1, then the robotguard and the spider robot (6 and 7, round 46:
   blue on that side), then Ashelin (9, round 53)."
  (cond
    ((and (= team BF_TEAM_FF) (= row 4)) BF_CLASS_ASHELIN)
    ((and (= team BF_TEAM_FF) (>= row 2)) (+ row 4))
    (else (+ (* 4 team) row))
    )
  )

(defun bf-class-row ((team int) (class int))
  "The row of CLASS on side TEAM's class page (`bf-row-class`'s reverse)."
  (cond
    ((= class BF_CLASS_ASHELIN) 4)
    ((and (= team BF_TEAM_FF) (>= class 4)) (- class 4))
    (else (- class (* 4 team)))
    )
  )

(defun bf-own-mover? ((class int))
  "#t for a special character's class, Baron Praxis (round 44) or Ashelin (round 53): it moves
   itself (its own collision, gravity, jumps and attacks, battlefront-baron.gc and
   battlefront-ashelin.gc), Jak standing hidden where it stands, its pad its own (`*bf-baron-pad*`)."
  (or (= class BF_CLASS_BARON) (= class BF_CLASS_ASHELIN))
  )

;; Battle phases.
(defconstant BF_PHASE_OFF 0)          ;; no battle: every hook answers like the stock game
(defconstant BF_PHASE_DEPLOY 1)       ;; travelling to the zone, waiting for its levels
(defconstant BF_PHASE_FIGHT 2)        ;; fighting
(defconstant BF_PHASE_OVER 3)         ;; one side ran out of units: result screen

;; The battle's hold on Haven City's loaded sections (`*bf*` city-load, battlefront.gc
;; `bf-whole-city-update`): every street section at once during a battle, two chunks of the level
;; heap each, the stock layout (two sections, six chunks each) emptied before and after.
(defconstant BF_LOAD_OFF 0)       ;; the stock game's levels
(defconstant BF_LOAD_DRAIN_IN 1)  ;; a battle starts: ctywide and the unit levels alone, until every other level is gone
(defconstant BF_LOAD_WHOLE 2)     ;; every street section (`*bf-whole-city*`), two chunks each
(defconstant BF_LOAD_DRAIN_OUT 3) ;; the battle is over: ctywide and the unit levels alone, until no battle section is left

;; Haven City's street sections a battle loads at once: everywhere the player can walk but the
;; interiors, the ruins of the old town (ctygenb) and the Metal Head nest (mhcitya, mhcityb), both
;; closed by a force field (battlefront-city.gc).
(define *bf-whole-city* '(ctysluma ctyslumb ctyslumc ctyinda ctyindb ctyport))

;; Weapons of the two guard classes (D-pad: left tazer, down rifle, up grenade launcher).
(defconstant BF_WEAPON_RIFLE 0)
(defconstant BF_WEAPON_TAZER 1)
(defconstant BF_WEAPON_GRENADE 2)
(defconstant BF_WEAPON_ROCKET 3)   ;; the jetpack guards' rockets (L1, round 36), for the gun HUD
(defconstant BF_WEAPON_BOT_GRENADE 4) ;; the robotguard's grenades (L1, round 38), for the gun HUD
(defconstant BF_WEAPON_PISTOL 5)   ;; Ashelin's pistols (Square, round 54): her magazine in `*bf*` mag, the gun HUD

;; Indices of `*game-info*` gun-ammo. The class weapons spend Jak's own ammo, so the stock ammo
;; pickups refill them: yellow the rifles and guns, red the grenades, blue the tazer, dark the
;; jetpack's rockets. The battle saves Jak's ammo at its start and gives it back at its end.
(defconstant BF_AMMO_NONE -1)
(defconstant BF_AMMO_YELLOW 0)
(defconstant BF_AMMO_RED 1)
(defconstant BF_AMMO_BLUE 2)
(defconstant BF_AMMO_DARK 3)

(defconstant BF_CEILING (meters 30))  ;; force-field ceiling of the jetpacks, above the higher spawn
(defconstant BF_DROP_MAX 8)           ;; pickups of dead units waiting for the director
(defconstant BF_BAG_DROPS 6)          ;; pickups left by every 10 fallen units (`bf-queue-drop`)
(defconstant BF_DROP_LIFE (seconds 10)) ;; a pickup left by a fallen unit goes this long after it appears
(defconstant BF_UNIT_RESPAWN (seconds 5)) ;; a fallen unit's place in its side's army waits this long
(defconstant BF_RESPAWN_TIME (seconds 2)) ;; a dead player watches the battle at least this long before he chooses (4 s, then the respawn page, until round 27)

;; Army caps: units per side on the street at once, the battle setup's choice (30 to 100, 100 by
;; default since round 43; round 41, the author's wish: 40 until round 39, 63 in round 40). `bf-caps-set!` splits it:
;; each side two fifths of guards (the Krimzon Guard's three riflemen for one grenadier), a fifth
;; each of jetpack guards and robotguards, the rest spider robots (round 46: the Freedom League's
;; robotguards and spiders, blue; until then 72 % blue guards and the rest jetpack guards). The
;; traffic pools are capped to their sums (`*bf-pool-caps*`, `bf-want-count`), and each new unit
;; takes the look of its kind furthest below its share (`*bf-look-share*`). The four kinds are walkers of the traffic:
;; it wakes them on one tracker, which lists 224 awake objects since round 41 (traffic-engine-h.gc;
;; 126 stock, 63 a side). A traffic pool keeps its sleeping units in 20 slots (traffic-engine.gc
;; reset-and-init-from-manager): the guard pool and the flying turrets' get `*bf-guard-pool-slots*`
;; and `*bf-turret-pool-slots*` instead.
(defconstant BF_AT_ONCE_MIN 30)
(defconstant BF_AT_ONCE_MAX 200) ;; 100 until round 44
;; The setup's units at once count the whole city, both sides (round 45, the author's wish: "200
;; guards at once in the whole city"; rounds 41 to 44 counted a side): half of it each side.
(defconstant BF_CITY_AT_ONCE_MIN 60)
(defconstant BF_CITY_AT_ONCE_MAX 200)

;; The guard pool's sleeping units (traffic-engine.gc reset-and-init-from-manager points guard-a's
;; slots here): the most guards a battle has (72 + 40) and room to spare, where the stock 20 slots
;; would run into the next types' (guard-b, the Metal Heads).
(define *bf-guard-pool-slots* (new 'static 'array uint64 256))
;; The same for the flying turrets: the most a battle has (56 + 40) and room to spare (round 40).
(define *bf-turret-pool-slots* (new 'static 'array uint64 128))
;; And for the robotguards and the spiders (round 44: 40 each at 200 a side, the stock 20 slots).
(define *bf-robot-pool-slots* (new 'static 'array uint64 64))
(define *bf-spider-pool-slots* (new 'static 'array uint64 64))

;; The battle's units awake of each kind (guards, flying turrets, robotguards, spiders), counted by
;; the Haven City side every frame (battlefront-city.gc `bf-city-dots`): the pools keep only
;; BF_POOL_SPARE asleep above them (`bf-want-count`, round 44).
(define *bf-awake-kinds* (new 'static 'array int32 4 0 0 0 0))
(defconstant BF_POOL_SPARE 24)

;; The battle's unit kinds (traffic types: guard-a, flying-turret, roboguard, spydroid) and each
;; side's share of the caps above, Freedom League then Krimzon Guard, in that order: what its troop
;; transports bring it (levels/city/battlefront/bf-transport.gc).
(defconstant BF_KIND_COUNT 4)
(define *bf-kinds* (new 'static 'array int32 4 6 16 14 15))
(define *bf-team-caps* (new 'static 'array int32 8 43 17 0 0 24 12 12 12))

;; The traffic pools' caps, from `*bf-team-caps*`: guards, flying turrets, robotguards, spider robots.
(define *bf-pool-caps* (new 'static 'array int32 4 67 29 12 12))

;; ---------------------------------------------------------------------------------------------
;; Types
;; ---------------------------------------------------------------------------------------------

(deftype bf-zone (basic)
  "One war zone, with a continue point of each side: its base. The battlefield is the whole of
   Haven City; the game loads its sections around the player as it does outside a battle."
  ((name        string)    ;; menu label
   (desc        string)    ;; menu description
   (name-fr     string)    ;; the same in French (game language French)
   (desc-fr     string)
   (ff-continue string)    ;; Freedom League base
   (kg-continue string)    ;; Krimzon Guard base
   (city        symbol)    ;; the level holding the battle's city code (Jak 3's ctywide, bf-havenj2 or bf-spargus)
   (bases       int32)     ;; its headquarters: the first points of its table (`*bf-base-count*`)
   )
  )

(deftype bf-class-info (basic)
  "One playable class: label, description (English, French) and side. The description is lines of
   the class page, each drawn as it is: a button is its icon tag (<PAD_R1>, <PAD_L2>...: the PC
   font's button icons, common/util/font/dbs/font_db_jak3.cpp), the first line the class's
   features."
  ((name     string)
   (desc     (array string))
   (name-fr  string)
   (desc-fr  (array string))
   (team     int32)
   )
  )

;; Battle points: the sides' bases (headquarters), the first points of a zone's table, point i the
;; Freedom League's when i is even and the Krimzon Guard's when odd (`*bf-base-count*`: 2 in Jak 3's
;; city, 4 in Jak 2's since round 42), then a control point in each district the units fight in,
;; neutral at the start (`*bf-point-defs*`). A side holding one sends
;; its troop transports there and its player may respawn there (battlefront.gc `bf-update-points`,
;; battlefront-city.gc).
(defconstant BF_POINT_MAX 17)     ;; the most a war zone has: Jak 2's city, 4 bases and 13 control points
;; (Jak 3's city: 2 bases and 8 control points, two in each district). A zone's count is its table's
;; (`bf-control-count`).
(defconstant BF_POINT_RADIUS (meters 50))      ;; units within it count for its capture (round 44, wider against crowds: 35 m until then, 25 m until round 35)
(defconstant BF_NEUTRALIZE_TIME 20.0)          ;; seconds another side's majority takes to make a held point neutral (round 44)
(defconstant BF_CAPTURE_TIME 15.0)             ;; seconds a side's majority takes to capture a neutral point (round 44; one 30 s step until then)

(deftype bf-point (structure)
  "A battle point: a side's base, or a control point the sides capture (`bf-update-points`)."
  ((pos        vector :inline) ;; on the ground
   (owner      int32)          ;; BF_TEAM_FF, BF_TEAM_KG, or BF_TEAM_NONE: neutral
   (base?      symbol)         ;; a side's base: never changes hands
   (prog-team  int32)          ;; the side taking it (neutralizing it from its holder, or capturing it neutral), BF_TEAM_NONE for none
   (progress   float)          ;; seconds of that so far, up to BF_NEUTRALIZE_TIME held, BF_CAPTURE_TIME neutral
   (near       int32 2)        ;; units of each side within BF_POINT_RADIUS at the last count
   (ship       handle)         ;; the troop transport over it now (a base's), #f for none (battlefront-city.gc)
   (old-ship   handle)         ;; the one leaving it after a capture: the new holder's waits for it to go
   (fight      float)          ;; seconds of a fight away from the player since its last losses
   (snapped?   symbol)         ;; moved onto the open ground nearest it once its section loaded
   (icon       connection-minimap) ;; its mark on the game's minimap during a fight, #f for none
   (ship-done? symbol)         ;; a base whose ship brought its `*bf-ship-load*` units and left: no ship comes there again this battle
   )
  )

;; A troop transport leaves into the sky once it brought this many units (round 45, the author's
;; wish: 100); the tests lower it.
(define *bf-ship-load* 100)

(deftype bf-point-def (basic)
  "Where a battle point stands: its name (English, French), the continue point whose levels a
   respawn there loads (a base stands on it), and, for a control point, its place: the middle of a
   lane of its district, where units walk and transports find ground."
  ((name      string)
   (name-fr   string)
   (continue  string)
   (x         float)  ;; meters
   (y         float)
   (z         float)
   )
  )

(deftype bf-state (structure)
  "The whole state of the current battle. One static instance, `*bf*`."
  ((phase         int32)
   (zone          int32)
   (team          int32)          ;; player's side
   (class         int32)          ;; player's class
   (winner        int32)          ;; side that won, BF_TEAM_NONE while fighting
   (reserve       int32  2)       ;; units left per side
   (losses        int32  2)       ;; units lost per side
   (center        vector :inline) ;; battlefield sphere: xyz center, w radius
   (spawn         vector 2 :inline) ;; each side's spawn point
   (phase-time    time-frame)     ;; when `phase` last changed
   (respawn-time  time-frame)     ;; the dead player may choose from then (battlefront.gc `bf-target-death`), 0 alive
   (redeploying?  symbol)         ;; the player's death is a redeploy: the class page at once
   (respawn-choice int32)         ;; the point the class page picked for the dead player's respawn, -1 for none (battlefront.gc `bf-target-death`)
   (respawn-point int32)          ;; the player's respawn point, kept from one death to the next (round 30): his base at a deployment
   (reserve-max   int32)          ;; units per side at the battle's start (the configuration page, battlefront.gc `*bf-config*`), 0 unlimited
   (time-limit    int32)          ;; minutes the fight lasts at most, 0 for no limit
   (victory       int32)          ;; BF_WIN_POINTS or BF_WIN_UNITS
   (hold-team     int32)          ;; the side holding every control point now, BF_TEAM_NONE for none
   (hold-time     time-frame)     ;; since when it holds them
   (safe          vector :inline) ;; the player's last place standing inside the zone's levels
   (safe-level    symbol)         ;; the level he was in there
   (safe-time     time-frame)     ;; when that place was taken
   ;; Handles live here, not in globals: a global symbol holds 32 bits and a handle is 64, its pid
   ;; in the upper half, so a handle kept in a `define`d global never resolves (Lisp wiki common
   ;; 1.4.17). Handles, not ppointers: the avatar comes from *default-dead-pool*, a dead-pool-heap
   ;; whose freed records go to the next process spawned (gkernel.gc dead-pool-heap return-process).
   (avatar        handle)         ;; the model of the player's class (battlefront-player.gc)
   (director      handle)         ;; the process running the battle (battlefront.gc)
   (spectate      handle)         ;; the unit the camera follows while the player waits to respawn
   (weapon        int32)          ;; BF_WEAPON_* in the hands of a guard class
   (mag           int32 6)        ;; shots left in each weapon's magazine, by BF_WEAPON_* (Ashelin's pistols 5, round 54)
   (rockets       int32)          ;; a jetpack guard's rockets, or a robotguard's grenades, left this life (battlefront-player.gc BF_ROCKETS)
   (nova-kills    int32)          ;; foes the spider's last blast struck (`bf-avatar-nova`), for the tests
   (redraw?       symbol)         ;; the class model must be drawn again (red guard weapon change)
   (shield?       symbol)         ;; the robotguard's shield is up (battlefront.gc target-attacked)
   (ceiling       float)          ;; highest y a jetpack may reach (force field)
   (light-saved   float)          ;; Jak's light eco before the battle (the shield's hits take some)
   (dark-saved    float)          ;; Jak's dark eco before the battle (a battle turns it into fuel)
   (endless-dark? symbol)         ;; the endless dark eco secret was on before the battle
   (endless-light? symbol)        ;; the same for light eco
   (ammo-saved    float 4)        ;; Jak's gun ammo before the battle
   (aim-frame     int64)          ;; frame the free aim below was computed for (`bf-free-aim`)
   (aim-foe       handle)         ;; foe under the crosshair, #f for none
   (aim           vector :inline) ;; where the crosshair's ray meets the world
   (drop-count    int32)          ;; pickups of dead units waiting for the director
   (drop-kind     int32 8)        ;; their pickup-type
   (drop-pos      vector 8 :inline)
   ;; The battle's third-person camera (battlefront-player.gc `bf-cam-rig`): where it looks, turned
   ;; by the right stick. Kept here, not in the rig, so a class change or a respawn keeps the view.
   (view-yaw      float)          ;; heading, rotation units (0 looks along +z)
   (view-pitch    float)          ;; up positive, rotation units
   (view-set?     symbol)         ;; the view was set for this battle (else taken from Jak's facing)
   (rig           handle)         ;; the camera rig, #f for none
   (kills         int32)          ;; units the player killed in this battle (the HUD's counter)
   (tazer-time    time-frame)     ;; guard: the last tazer strike (BF_TAZER_RECHARGE before the next)
   (own-attack    float)          ;; damage (24 scale) of the player's attack being sent, -1.0 none
   (points        bf-point BF_POINT_MAX :inline) ;; 0 and 1 the sides' bases, then the control points
   (point-count   int32)          ;; points in use
   (point-time    time-frame)     ;; last capture count (`bf-update-points`)
   (respawn-pick  int32)          ;; the point the dead player chose to respawn at, -1 none yet
   (combat-time   time-frame)     ;; the player's last shot, blow or hit taken, on the game clock (`bf-combat!`)
   (respawn-at    int32)          ;; the point a far respawn's reset brings the player to, -1 none
   (redeploy-ok?  symbol)         ;; the player may redeploy now (the director's clock; the START menu reads it)
   (flicker-until time-frame)     ;; the player's spawn shield blinks his class model until then (game clock)
   (city-load     int32)          ;; BF_LOAD_*: the battle's hold on the city's loaded sections (battlefront.gc)
   (deaths        int32)          ;; the player's deaths in this battle
   (bag-deaths    int32)          ;; unit deaths left in the pickup bag (`bf-queue-drop`), 0 for a new bag
   (bag-drops     int32)          ;; pickups left in it
   (overlay?      symbol)         ;; L3 shows the kills, the deaths and the whole city's map (battlefront.gc)
   ;; The player's fall from the sky after a respawn (battlefront.gc `bf-sky-drop!`)
   (sky-point     int32)          ;; the point the Haven City side looks around (BF_CITY_SKY_SPOT)
   (sky-found?    symbol)         ;; it found a nav poly there
   (sky-ground    vector :inline) ;; that poly's middle, where the player lands
   (dropping?     symbol)         ;; he falls now: his controls are off until he lands (`bf-pad-lock!`)
   (drop-time     time-frame)     ;; when the fall began (game clock)
   (land-time     time-frame)     ;; when he landed (game clock), 0 none: his class model's landing clip
   (drop-collide  collide-spec)   ;; what Jak collides with, kept while he falls (he meets the scenery only)
   (still-until   time-frame)     ;; the player stands still until then (game clock): a grenade throw, a tazer stab (`bf-pad-lock!`)
   (spawned       int32 2)        ;; units each side brought onto the field this battle, ships and sky (`bf-unit-brought!`, round 44)
   )
  )

(define *bf* (new 'static 'bf-state :phase BF_PHASE_OFF :team BF_TEAM_FF :winner BF_TEAM_NONE))
;; a zero handle names process 0, which is not #f: start with no process
(set! (-> *bf* avatar) (the-as handle #f))
(set! (-> *bf* director) (the-as handle #f))
(set! (-> *bf* aim-foe) (the-as handle #f))
(set! (-> *bf* spectate) (the-as handle #f))
(set! (-> *bf* rig) (the-as handle #f))
(set! (-> *bf* own-attack) -1.0)
;; a symbol field of a static structure starts as 0, which is not #f (it tests true): the robotguard's
;; shield flag left at 0 kept Jak's shield level up in every battle, so no attack ever hurt the player
(set! (-> *bf* safe-level) #f)
(set! (-> *bf* redraw?) #f)
(set! (-> *bf* shield?) #f)
(set! (-> *bf* endless-dark?) #f)
(set! (-> *bf* endless-light?) #f)
(set! (-> *bf* view-set?) #f)
(set! (-> *bf* respawn-at) -1)
(set! (-> *bf* sky-found?) #f)
(set! (-> *bf* dropping?) #f)

(defun bf-combat! ()
  "The player is in combat now (a shot, a blow, a hit taken): `*bf*` combat-time, on the game clock.
   Each process reads its own clock with `current-time`, and Jak's, the class model's, the director's
   and the START menu's are not all the same: the menu's 30 s test never passed."
  (set! (-> *bf* combat-time) (-> *display* game-clock frame-counter))
  (none)
  )
(set! (-> *bf* redeploy-ok?) #f)
(set! (-> *bf* overlay?) #f)
;; the points' ships: no process (a zero handle names process 0)
(dotimes (i BF_POINT_MAX)
  (set! (-> *bf* points i ship) (the-as handle #f))
  (set! (-> *bf* points i old-ship) (the-as handle #f))
  (set! (-> *bf* points i snapped?) #f)
  (set! (-> *bf* points i icon) #f)
  (set! (-> *bf* points i ship-done?) #f)
  )

;; The units awake, for the maps (battlefront.gc `bf-draw-city-map`): their places, headings and
;; sides, written every frame of a fight by the Haven City side (battlefront-city.gc `bf-city-dots`).
(defconstant BF_DOT_MAX 512) ;; 400 units at most (200 a side since round 44) and the player

(deftype bf-unit-dots (structure)
  ((count  int32)
   (pos    vector BF_DOT_MAX :inline)
   (yaw    float  BF_DOT_MAX)   ;; heading, rotation units (0 along +z)
   (team   int8   BF_DOT_MAX)
   )
  )

(define *bf-unit-dots* (new 'static 'bf-unit-dots))

;; Set by the Mods menu. While it is on, START opens the battle's pause page (battlefront.gc);
;; turning it off during a battle loads the last save (battlefront.gc `bf-leave-to-save!`).
;; On by default (the author's wish, round 29): the Mods menu still switches it off.
(define *mod-battlefront-enable* #t)

;; Commands of `*bf-city-hook*`, the Haven City side of a battle (levels/city/battlefront/battlefront-city.gc).
(defconstant BF_CITY_PREPARE 0)   ;; the zone is loaded, the fight starts
(defconstant BF_CITY_UPDATE 1)    ;; every frame of the fight
(defconstant BF_CITY_RESET 2)     ;; the battle ends
(defconstant BF_CITY_FREE_NAVS 3) ;; just before an `initialize!` 'life: the units give back the default nav mesh
(defconstant BF_CITY_SKY_SPOT 4)  ;; a nav poly at random around `*bf*` sky-point, into sky-ground (sky-found?)

;; Factions of a battle: Freedom League and Krimzon Guard both strong everywhere, Metal Heads
;; out; guards at the "combat" spawn level (guard-a 13), KG robots at "war" (roboguard 5,
;; spydroid 4, flying turret 5), no civilians, no traffic vehicles. Given to the stock
;; `faction-command` setting, and re-applied by battlefront-city.gc (a death reset or a task
;; change restores the stock faction state).
(define *bf-faction-commands*
  '((faction-strength ff 20)
    (faction-strength kg 20)
    (faction-strength mh -20)
    (faction-spawn ff-guard combat)
    (faction-spawn kg-guard war)
    (faction-spawn mh-guard off)
    (faction-spawn ff-ped war)
    (faction-spawn ff-vehicle off)
    (faction-spawn kg-ambient off)
    (faction-spawn mh-ambient off)
    )
  )

;; Set by battlefront-city.gc each time CWI links. Only called while ctywide is active, which
;; guarantees it points into the current link.
(define *bf-city-hook* (the-as (function int none) #f))

;; The same for the player's grenades (from, landing point): their projectile type is CWI code.
(define *bf-city-grenade* (the-as (function vector vector none) #f))

;; ---------------------------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------------------------

;; The war zone: the whole of Haven City. Each side's base is a stock continue point: the Freedom
;; League's at the entrance of its headquarters (the point Jak comes out at when he leaves them), the
;; Krimzon Guard's in the middle of the Port, 89 m from where its control point stood before round 23
;; (the continue point nearest it), the control point on the east docks where the base stood: the
;; author swapped them. The battle used to hold one district,
;; its sections kept loaded and a force field at its edges; the author wanted the whole city.
(define *bf-zones*
  (new 'static 'boxed-array :type bf-zone
    (new 'static 'bf-zone
      :name "Haven City"
      :desc "The whole city: a control point in each district, the Port, the Industrial Zone, the Slums and Freedom HQ."
      :name-fr "Haven City"
      :desc-fr "Toute la ville : un point de contrôle dans chaque quartier, le Port, la zone industrielle, les bas quartiers et le QG de la Ligue."
      :ff-continue "ctyslumc-freehq-exit"
      :kg-continue "ctyport-bbush-8"
      :city 'ctywide
      :bases 2
      )
    ;; Jak 2's Haven City (round 40, the author's wish), one level made from the player's Jak 2 and
    ;; Jak 3 discs at install (bf-havenj2: battlefront-havenj2-info.gc); without Jak 2, greyed
    ;; (`bf-zone-open?`). Two headquarters a side (round 42): the Freedom League's in the slums by
    ;; the hideout (where it deploys) and at the port, the Krimzon Guard's at the stadium (where it
    ;; deploys) and at the palace's foot; a control point in each of its 13 other districts.
    (new 'static 'bf-zone
      :name "Haven City (Jak 2)"
      :desc "Jak 2's whole Haven City: two HQs a side, a control point in each of the 13 other districts. Freedom League: the slums and the port. Krimzon Guard: the stadium and the palace."
      :name-fr "Haven City (Jak 2)"
      :desc-fr "Toute la Haven City de Jak 2 : deux QG par camp, un point de contrôle dans chacun des 13 autres quartiers. Ligue : bas quartiers et port. Grenagarde : stade et palais."
      :ff-continue "bfh-ctysluma-alley"
      :kg-continue "bfh-stadium-start"
      :city 'bf-havenj2
      :bases 4
      )
    ;; Jak 3's Spargus (round 50, the author's wish), one level made from the player's Jak 3 disc at
    ;; install (bf-spargus: battlefront-spargus-info.gc): its two districts with Haven City's traffic
    ;; code, no Wastelander, its doors to the garage, the arena and the palace walled. Since round 54
    ;; the destruction of an objective (battlefront-artifact.gc): the Freedom League defends a
    ;; precursor artifact by the precursor game, in the west district, the Krimzon Guard comes from
    ;; the east one to destroy it; no control point.
    (new 'static 'bf-zone
      :name "Spargus"
      :desc "The desert city, the destruction of an objective: the Freedom League defends a precursor artifact by the precursor game, in the west district; the Krimzon Guard comes from the east district to destroy it."
      :name-fr "Spargus"
      :desc-fr "La cité du désert, destruction d'objectif : la Ligue défend un artefact précurseur près du jeu précurseur, dans le quartier ouest ; la Grenagarde vient du quartier est pour le détruire."
      ;; round 54: the Freedom League at the west camp by the precursor game (the port's "kg-camp"),
      ;; the Krimzon Guard at the east one (its "ff-camp"), as `*bf-point-defs-spargus*`
      :ff-continue "bfs-kg-camp"
      :kg-continue "bfs-ff-camp"
      :city 'bf-spargus
      :bases 2
      )
    )
  )

;; The battle points, in `*bf*` points order: the bases (their places are their continue points),
;; then a control point in each district, the middle of a lane between that district's ends (found
;; on its streets by the battles of round 16), with a continue point of its section.
(define *bf-point-defs-jak3*
  (new 'static 'boxed-array :type bf-point-def
    (new 'static 'bf-point-def :name "Freedom League base" :name-fr "Base de la Ligue" :continue "ctyslumc-freehq-exit")
    (new 'static 'bf-point-def :name "Krimzon Guard base" :name-fr "Base de la Grenagarde" :continue "ctyport-bbush-8")
    ;; on the east docks, where the Krimzon Guard's base stood (its continue point's place, as the
    ;; battle moved it onto open ground)
    (new 'static 'bf-point-def :name "Port" :name-fr "Port" :continue "ctyport-bombbot"
      :x 619.80 :y 7.70 :z 1476.66)
    (new 'static 'bf-point-def :name "Industrial Zone" :name-fr "Zone industrielle" :continue "ctyinda-bbush-5"
      :x 929.45 :y 10.17 :z 854.68)
    (new 'static 'bf-point-def :name "Slums" :name-fr "Bas quartiers" :continue "ctysluma-alley"
      :x 1000.76 :y 10.35 :z 266.12)
    (new 'static 'bf-point-def :name "Freedom HQ" :name-fr "QG de la Ligue" :continue "ctyslumb-bbush-4"
      :x 522.14 :y 2.88 :z -339.72)
    ;; round 27: a second point in each district, on a continue point of its section (Jak's place
    ;; there, on the street), each between two points of the chain (`*bf-point-links*`)
    (new 'static 'bf-point-def :name "Port Gate" :name-fr "Porte du port" :continue "ctyport-warzone"
      :x 741.40 :y 6.70 :z 1348.60)
    (new 'static 'bf-point-def :name "North Industrial Zone" :name-fr "Zone industrielle nord" :continue "ctyinda-bbush-5"
      :x 895.40 :y 10.00 :z 1148.60)
    (new 'static 'bf-point-def :name "South Industrial Zone" :name-fr "Zone industrielle sud" :continue "ctyindb-start"
      :x 971.40 :y 10.00 :z 546.10)
    ;; the street to the sewer's exit, where Slums B's nav mesh ends (the exit itself, 61 m east, has
    ;; no nav mesh and its continue point loads the sewer: round 27's tests)
    (new 'static 'bf-point-def :name "Sewer Exit" :name-fr "Sortie des égouts" :continue "ctyslumb-start"
      :x 721.20 :y 4.90 :z -293.90)
    )
  )

;; The control points in their order from the Krimzon Guard's base to the Freedom League's, the
;; order of their letters (`bf-point-letter`, A first) on the HUD and the minimap.
(define *bf-point-order-jak3* (new 'static 'array int32 8 2 6 7 3 8 4 9 5))

;; Which points are next to which (the districts' streets): a side fights for a point away from
;; the player only from one next to it (battlefront.gc `bf-update-points`). Bit i: point i.
(define *bf-point-links-jak3*
  (new 'static 'array uint32 10
    #b0000100000  ;; Freedom League base: Freedom HQ
    #b0000000100  ;; Krimzon Guard base (the Port's middle): Port
    #b0001000010  ;; Port (the east docks): Krimzon Guard base, Port Gate
    #b0110000000  ;; Industrial Zone: North and South Industrial Zone
    #b1100000000  ;; Slums: South Industrial Zone, Sewer Exit
    #b1000000001  ;; Freedom HQ: Freedom League base, Sewer Exit
    #b0010000100  ;; Port Gate: Port, North Industrial Zone
    #b0001001000  ;; North Industrial Zone: Port Gate, Industrial Zone
    #b0000011000  ;; South Industrial Zone: Industrial Zone, Slums
    #b0000110000  ;; Sewer Exit: Slums, Freedom HQ
    )
  )

