(defconstant BF_BARON_CLIP_WALK 4)
(defconstant BF_BARON_CLIP_JUMP 5)
(defconstant BF_BARON_CLIP_SLASH 6)
(defconstant BF_BARON_CLIP_SPIN 7)
(defconstant BF_BARON_CLIP_BLOCK 8)
(defconstant BF_BARON_CLIP_CAST 9)
(defconstant BF_BARON_CLIP_HIT 10)
(defconstant BF_BARON_CLIP_DEATH 11)
(defconstant BF_BARON_CLIP_TURN 12)
(defconstant BF_BARON_CLIP_PLANT 13)   ;; round 46: X then Square, he plants his sword in the ground
(defconstant BF_BARON_CLIP_AIRSPIN 14) ;; round 46: X then Circle, he spins a full turn in the air
(def-art-elt bf-baron-ag bf-baron-lod0-jg 0)
