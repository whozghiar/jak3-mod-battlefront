(defconstant BF_ASHELIN_CLIP_UNKNEEL 14)    ;; up again
(defconstant BF_ASHELIN_CLIP_STRAFE_LEFT 15) ;; Jak's walk aside with his gun
(defconstant BF_ASHELIN_CLIP_STRAFE_RIGHT 16)
(defconstant BF_ASHELIN_CLIP_WALK_BACK 17)  ;; Jak's walk reversed
(defconstant BF_ASHELIN_CLIP_KICK 18)       ;; Jak's spinning kick
(defconstant BF_ASHELIN_CLIP_RELOAD 19)     ;; her pistols lowered and raised again
(defconstant BF_ASHELIN_CLIP_ROLL 20)       ;; Jak's roll with his gun in hand, and its end
(defconstant BF_ASHELIN_CLIP_FIRE 21)       ;; her own shot and recoil, her pistols in turn: her arms alone
;; Her joints the firing clip takes, over her legs' clip (round 55, `top-anim`'s interp-select: a
;; joint's bit is its node index minus 1, joint-nodes.gc ashelin-lod0-jg): her arms Lshoulder to
;; Rhand 6 to 11, her pistol (gun) 21, her fingers 29 to 36.
(defconstant BF_ASHELIN_UPPER #x1fe0200fc0)
(def-art-elt bf-ashelin-ag bf-ashelin-lod0-jg 0)
(def-art-elt bf-ashelin-ag bf-ashelin-lod0-mg 1)
