    #b00000011100000000  ;; West Quarter: South Quarter, Central Quarter, West Farms
    #b00000000010100010  ;; South Quarter: Stadium HQ, Fortress Slums, West Quarter
    #b00100000010000000  ;; Central Quarter: West Quarter, Palace Plaza
    #b00001000010000000  ;; West Farms: West Quarter, West Market
    #b00001000000000100  ;; North Farms: Port HQ, West Market
    #b00100110000000000  ;; West Market: West Farms, North Farms, Palace Plaza
    #b10100000000000000  ;; East Market: Palace Plaza, South Industrial Zone
    #b00011001000001100  ;; Palace Plaza: Port HQ, Palace HQ, Central Quarter, West Market, East Market
    #b10000000000000100  ;; North Industrial Zone: Port HQ, South Industrial Zone
    #b01010000000010000  ;; South Industrial Zone: Hideout Slums, East Market, North Industrial Zone
    )
  )

;; Spargus (round 54, the destruction of an objective): each side's camp at one end of the city (the
;; level port's continue points, on the nav mesh), then the precursor artifact's point, which no side
;; takes (battlefront-artifact.gc; it moves onto the nav poly nearest the precursor game's door as
;; the artifact stands, `bf-artifact-update`). The Freedom League's camp is the west one by the
;; precursor game (the port's "kg-camp", its name of rounds 50 to 53), the Krimzon Guard's the east
;; one (the port's "ff-camp"). Rounds 50 to 53 had 4 control points: wascityb's market (1775.9, 29.7,
;; -367.7) and western heights (1763.4, 47.9, -224.5), the pass (2078.4, 26.9, -310.4) and
;; wascitya's square (2262.4, 3.4, -171.2). The level port links the two districts' meshes at the
;; pass with a strip of polys across their 17 to 19 m gap (port.jsonc's nav "links", round 51).
(define *bf-point-defs-spargus*
  (new 'static 'boxed-array :type bf-point-def
    (new 'static 'bf-point-def :name "Freedom League camp" :name-fr "Camp de la Ligue" :continue "bfs-kg-camp")
    (new 'static 'bf-point-def :name "Krimzon Guard camp" :name-fr "Camp de la Grenagarde" :continue "bfs-ff-camp")
    (new 'static 'bf-point-def :name "Precursor artifact" :name-fr "Artefact précurseur" :continue "bfs-wascityb-start"
      :x 1477.1 :y 28.2 :z -370.8)
    )
  )

;; letters from the Krimzon Guard's side (the east) to the Freedom League's (the west): the one point
(define *bf-point-order-spargus* (new 'static 'array int32 1 2))

(define *bf-point-links-spargus*
  (new 'static 'array uint32 3
    #b100  ;; Freedom League camp: the artifact
    #b100  ;; Krimzon Guard camp: the artifact
    #b011  ;; the artifact: both camps
    )
  )

;; The current war zone's tables: the whole battle code reads these three and its base count, which
;; `bf-zone-select!` points at the zone's own (Jak 3's city until a zone is picked).
(define *bf-point-defs* *bf-point-defs-jak3*)
(define *bf-point-order* *bf-point-order-jak3*)
(define *bf-point-links* *bf-point-links-jak3*)
(define *bf-base-count* 2)

(defun bf-zone-select! ((zone int))
  "Point the battle's tables (`*bf-point-defs*`, `*bf-point-order*`, `*bf-point-links*`,
   `*bf-base-count*`) at war zone ZONE's, and the units' levels (ctypesa, ctypesc) at its city level as their host: they load into
   its borrow heaps (level.gc level-find-borrow-slot: a borrow-city-small level borrows from its
   master level only), Jak 3's ctywide's, bf-havenj2's or bf-spargus's."
  (let ((city (-> *bf-zones* zone city)))
    (set! *bf-base-count* (-> *bf-zones* zone bases))
    (cond
      ((= zone BF_ZONE_JAK2)
       (set! *bf-point-defs* *bf-point-defs-jak2*)
       (set! *bf-point-order* *bf-point-order-jak2*)
       (set! *bf-point-links* *bf-point-links-jak2*)
       )
      ((= zone BF_ZONE_SPARGUS)
       (set! *bf-point-defs* *bf-point-defs-spargus*)
       (set! *bf-point-order* *bf-point-order-spargus*)
       (set! *bf-point-links* *bf-point-links-spargus*)
       )
      (else
        (set! *bf-point-defs* *bf-point-defs-jak3*)
        (set! *bf-point-order* *bf-point-order-jak3*)
        (set! *bf-point-links* *bf-point-links-jak3*)
        )
      )
    (let ((a (lookup-level-info 'ctypesa))
          (c (lookup-level-info 'ctypesc))
          )
      (if a (set! (-> a master-level) city))
      (if c (set! (-> c master-level) city))
      )
    )
  (none)
  )

(defun bf-control-count ()
  "The current war zone's control points (its table's points but its bases)."
  (- (-> *bf-point-defs* length) *bf-base-count*)
  )

(defun bf-zone-ported? ((zone int))
  "#t for a war zone that is one level made by the level port (Jak 2's city, Spargus): no street
   section to load, no force field."
  (or (= zone BF_ZONE_JAK2) (= zone BF_ZONE_SPARGUS))
  )

(defun bf-zone-open? ((zone int))
  "#t when war zone ZONE can be played: one of `*bf-zones*`, Jak 2's and Spargus only once the
   level port built their level (`*bfh-built*`, `*bfs-built*`)."
  (and (< zone BF_ZONE_COUNT)
       (cond
         ((= zone BF_ZONE_JAK2) *bfh-built*)
         ((= zone BF_ZONE_SPARGUS) *bfs-built*)
         (else #t)
         )
       )
  )

(defun bf-zone-sections ((zone int))
  "The street sections a battle in war zone ZONE loads besides its city level: Jak 3's six
   (`*bf-whole-city*`), none for Jak 2's city and Spargus, one level each."
  (if (bf-zone-ported? zone)
      '()
      *bf-whole-city*
      )
  )

(defun bf-city-level ()
  "The level holding the current battle's city code (its zone's `city`): Jak 3's ctywide,
   bf-havenj2 or bf-spargus."
  (-> *bf-zones* (-> *bf* zone) city)
  )

(define *bf-team-names* (new 'static 'boxed-array :type string "Freedom League" "Krimzon Guard"))
(define *bf-team-names-fr* (new 'static 'boxed-array :type string "Ligue de la liberté" "Grenagarde"))

;; What a class does, with its buttons (round 29, the author's wish: nothing else), shown on the
;; class page for the class picked (battlefront.gc `bf-draw-class-page`).
;; The guards' help, the same for both colors. A button a line, its name in a column: ~Y keeps the
;; line's start, ~Z goes back to it and ~+94H past the widest icons (L2, the plus at 24H and the
;; stick at 37H), so every name starts at the same place (round 41). The font has no icon for the left D-pad button, and its
;; <PAD_DPAD_DOWN> lights the up part too: the tazer's and the rifle's lines build theirs from the
;; icon's parts the way font_db_jak3.cpp builds <PAD_DPAD_UP>, the left part lit (~3L) for the
;; tazer, the down part alone for the rifle.
(define *bf-guard-help*
  (new 'static 'boxed-array :type string
    "~Y<PAD_R1>~Z~+94H Fire"
    "~Y<PAD_TRIANGLE>~Z~+94H Reload"
    "~Y<PAD_SQUARE>~Z~+94H Rifle butt"
    "~Y<PAD_L1>~Z~+94H Crouch: steadier aim"
    "~Y<PAD_L2>~Z~+24H+~Z~+37H<PAD_ANALOG_LEFT_RIGHT>~Z~+57H Strafe"
    "~Y<PAD_R2>~Z~+24H+~Z~+37H<PAD_ANALOG_LEFT_RIGHT>~Z~+57H Roll"
    "~Y~3L<PAD_PART_DPAD_L>~Z~22L~+17H~-13V<PAD_PART_DPAD_U>~Z~22L~+17H~+14V<PAD_PART_DPAD_D>~Z~22L~+32H<PAD_PART_DPAD_R>~Z~+94H Tazer (every 20 s)"
    "~Y~22L<PAD_PART_DPAD_L>~Z~22L~+17H~-13V<PAD_PART_DPAD_U>~Z~3L~+17H~+14V<PAD_PART_DPAD_D>~Z~22L~+32H<PAD_PART_DPAD_R>~Z~+94H Rifle"
    "~Y<PAD_DPAD_UP>~Z~+94H Grenade launcher"
