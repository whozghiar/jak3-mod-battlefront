;; Ashelin (rounds 53 and 54): Jak 3's Ashelin, her red turned to the blue guards' blue, a second
;; pistol in her left hand, and clips made at install (custom_assets/jak3/models/models.jsonc
;; "made_clips", mod_models.py: since round 55 Jak's own moves on her skeleton, and moves made from her
;; own clips): in that order from 2.
(defconstant BF_ASHELIN_CLIP_IDLE 2)        ;; Jak's idle
(defconstant BF_ASHELIN_CLIP_RUN 3)         ;; Jak's run
(defconstant BF_ASHELIN_CLIP_WALK 4)        ;; Jak's walk
(defconstant BF_ASHELIN_CLIP_JUMP 5)        ;; Jak's jump, from its push off the ground
(defconstant BF_ASHELIN_CLIP_FLIP 6)        ;; her second jump and her roll's jump: Jak's flip out of a roll
(defconstant BF_ASHELIN_CLIP_FLIP_LEFT 7)   ;; her cartwheel to the left
(defconstant BF_ASHELIN_CLIP_FLIP_RIGHT 8)  ;; the same, mirrored
(defconstant BF_ASHELIN_CLIP_THROW 9)       ;; an overhand throw of her left hand
(defconstant BF_ASHELIN_CLIP_HIT 10)
(defconstant BF_ASHELIN_CLIP_DEATH 11)
(defconstant BF_ASHELIN_CLIP_KNEEL 12)      ;; Jak's crouch (L1): down
