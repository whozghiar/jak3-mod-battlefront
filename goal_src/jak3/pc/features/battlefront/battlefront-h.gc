;; The help lines shared by two classes, linked in here (static data cannot name another symbol).
(set! (-> *bf-classes* BF_CLASS_BLUE_GUARD desc) *bf-guard-help*)
(set! (-> *bf-classes* BF_CLASS_BLUE_GUARD desc-fr) *bf-guard-help-fr*)
(set! (-> *bf-classes* BF_CLASS_RED_GUARD desc) *bf-guard-help*)
(set! (-> *bf-classes* BF_CLASS_RED_GUARD desc-fr) *bf-guard-help-fr*)
(set! (-> *bf-classes* BF_CLASS_BLUE_JETPACK desc) *bf-jetpack-help*)
(set! (-> *bf-classes* BF_CLASS_BLUE_JETPACK desc-fr) *bf-jetpack-help-fr*)
(set! (-> *bf-classes* BF_CLASS_RED_JETPACK desc) *bf-jetpack-help*)
(set! (-> *bf-classes* BF_CLASS_RED_JETPACK desc-fr) *bf-jetpack-help-fr*)
(set! (-> *bf-classes* BF_CLASS_WASTELANDER desc) *bf-no-help*)
(set! (-> *bf-classes* BF_CLASS_WASTELANDER desc-fr) *bf-no-help*)
(set! (-> *bf-classes* BF_CLASS_JAK desc) *bf-no-help*)
(set! (-> *bf-classes* BF_CLASS_JAK desc-fr) *bf-no-help*)

;; ---------------------------------------------------------------------------------------------
;; Text (English, or French when the game runs in French)
;; ---------------------------------------------------------------------------------------------

(defun bf-fr? ()
  "#t when the game text is French. The PC port draws game text in the language of its settings
   (pc-settings text-language), not in the one a save game restores."
  (= (-> *pc-settings* text-language) (pc-language french))
  )

(defun bf-tr ((en string) (fr string))
  "EN, or FR when the game runs in French."
  (if (bf-fr?) fr en)
  )

;; The Controls page (battlefront.gc `bf-draw-controls-page`, round 44): what every class does, then
;; each class's own buttons. The font has no L3 nor START icon: their names stand in their place, the
;; text past them (+124H: START is wider than the class help's 94H column).
(define *bf-controls-help*
  (new 'static 'boxed-array :type string
    "~Y<PAD_ANALOG_ANY>~Z~+124H Left stick: move"
    "~Y<PAD_ANALOG_ANY>~Z~+124H Right stick: aim"
    "~YL3 +~Z~+44H<PAD_ANALOG_UP_DOWN>~Z~+124H Camera closer / farther"
    "~YL3~Z~+124H Kills, deaths, live map"
    "~YSTART~Z~+124H Battle menu"
    "~Y<PAD_X>~Z~+124H Dead: respawn"
    "~Y<PAD_TRIANGLE>~Z~+124H Dead: class and point"
    )
  )

(define *bf-controls-help-fr*
  (new 'static 'boxed-array :type string
    "~Y<PAD_ANALOG_ANY>~Z~+124H Stick gauche : se déplacer"
    "~Y<PAD_ANALOG_ANY>~Z~+124H Stick droit : viser"
    "~YL3 +~Z~+44H<PAD_ANALOG_UP_DOWN>~Z~+124H Caméra plus près / plus loin"
    "~YL3~Z~+124H Éliminations, morts, carte"
    "~YSTART~Z~+124H Menu de bataille"
    "~Y<PAD_X>~Z~+124H Mort : réapparaître"
    "~Y<PAD_TRIANGLE>~Z~+124H Mort : classe et point"
    )
  )

;; The Controls page's classes, one per set of buttons (the guards' and the jetpacks' the same in
;; both colors): BF_CLASS_* whose help it shows.
(define *bf-help-kinds* (new 'static 'boxed-array :type int32 0 1 6 7 8 9))

(defun bf-help-kind-of ((class int))
  "The index in `*bf-help-kinds*` of the buttons of CLASS (a red guard's are the blue one's)."
  (case class
    ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) 1)
    ((BF_CLASS_ROBOGUARD) 2)
    ((BF_CLASS_SPYDROID) 3)
    ((BF_CLASS_BARON) 4)
    ((BF_CLASS_ASHELIN) 5)
    (else 0)
    )
  )

(defun bf-help-kind-name ((class int))
  "The Controls page's name for the buttons of CLASS (a BF_CLASS_*), the same for both colors."
  (case class
    ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) (bf-tr "Jetpack guard" "Garde à jetpack"))
    ((BF_CLASS_ROBOGUARD) (bf-tr "Robotguard" "Robotgarde"))
    ((BF_CLASS_SPYDROID) (bf-tr "Spider robot" "Araignée robot"))
    ((BF_CLASS_BARON) "Baron Praxis")
    ((BF_CLASS_ASHELIN) "Ashelin")
    (else (bf-tr "Guard" "Garde"))
    )
  )

(defun bf-team-name ((team int))
  "Name of side TEAM in the game's language."
  (if (bf-fr?) (-> *bf-team-names-fr* team) (-> *bf-team-names* team))
  )

(defun bf-zone-name ((zone int))
  "Name of war zone ZONE in the game's language."
  (bf-tr (-> *bf-zones* zone name) (-> *bf-zones* zone name-fr))
  )

(defun bf-class-name ((class int))
  "Name of class CLASS in the game's language."
  (bf-tr (-> *bf-classes* class name) (-> *bf-classes* class name-fr))
  )

