;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-h.gc
;; name in dgo: battlefront-h
;; dgos: GAME

#|
  Battlefront mod (jak3-mod-battlefront) -- shared state, zone and class tables, skeletons of the
  Jak 2 models, and the functions the stock Haven City code calls.

  Why GAME: the stock unit code that calls into the mod (guard.gc, flying-turret.gc,
  traffic-engine.gc, traffic-manager.gc) is level code, linked again every time CWI, CTYPESA,
  CTYPESC, DESRESC or WWD loads. The functions it calls must exist whichever of those levels is
  loaded, so they live here, in GAME, and every one of them returns the stock answer while no
  battle runs.

  How a battle is wired (details in docs/modding/current_mod/battlefront_readme.md):
    * the Freedom League side is the stock Freedom League guards (`crimson-guard`, traffic type
      guard-a) and blue jetpack guards (the Spargus Citizen is a player class only: see
      battlefront-city.gc);
    * the Krimzon Guard side is red Krimzon Guards (Jak 2 model on the `crimson-guard` code, from
      the same guard-a pool), red jetpack guards, KG roboguards (`roboguard-city`) and spider
      robots (`spydroid`);
    * both jetpack guards are the Jak 2 hover guard drawn on the stock KG `flying-turret` code;
    * Haven City's attack controller makes them fight: the red guards register as roboguards and
      the blue jetpacks as rifle guards, so each side hates the other with the stock hatred table.
|#

;; DECOMP BEGINS

;; ---------------------------------------------------------------------------------------------
;; Constants
;; ---------------------------------------------------------------------------------------------

(defconstant BF_RESERVE 500)          ;; units in stock per side at the start of a battle
(defconstant BF_TEAM_COUNT 2)
(defconstant BF_CLASS_COUNT 8)
(defconstant BF_ZONE_COUNT 1)          ;; the whole of Haven City (`*bf-zones*`)

;; Teams. The values index `reserve` and `losses` in `bf-state`.
(defconstant BF_TEAM_NONE -1)
(defconstant BF_TEAM_FF 0)            ;; Freedom League ("Ligue de la liberte")
(defconstant BF_TEAM_KG 1)            ;; Krimzon Guard ("Grenagarde")

;; Classes. 0-3 Freedom League, 4-7 Krimzon Guard. Neither the Spargus Citizen (2) nor Jak (3) is
;; playable any more: the Freedom League offers 0 and 1, and their entries only keep the indices.
(defconstant BF_CLASS_BLUE_GUARD 0)
(defconstant BF_CLASS_BLUE_JETPACK 1)
(defconstant BF_CLASS_WASTELANDER 2)
(defconstant BF_CLASS_JAK 3)
(defconstant BF_CLASS_RED_GUARD 4)
(defconstant BF_CLASS_RED_JETPACK 5)
(defconstant BF_CLASS_ROBOGUARD 6)
(defconstant BF_CLASS_SPYDROID 7)

;; Battle phases.
(defconstant BF_PHASE_OFF 0)          ;; no battle: every hook answers like the stock game
(defconstant BF_PHASE_DEPLOY 1)       ;; travelling to the zone, waiting for its levels
(defconstant BF_PHASE_FIGHT 2)        ;; fighting
(defconstant BF_PHASE_OVER 3)         ;; one side ran out of units: result screen

;; Weapons of the two guard classes (D-pad: left tazer, down rifle, up grenade launcher).
(defconstant BF_WEAPON_RIFLE 0)
(defconstant BF_WEAPON_TAZER 1)
(defconstant BF_WEAPON_GRENADE 2)

;; Indices of `*game-info*` gun-ammo. The class weapons spend Jak's own ammo, so the stock ammo
;; pickups refill them: yellow the rifles and guns, red the grenades, blue the tazer. The battle
;; saves Jak's ammo at its start and gives it back at its end.
(defconstant BF_AMMO_NONE -1)
(defconstant BF_AMMO_YELLOW 0)
(defconstant BF_AMMO_RED 1)
(defconstant BF_AMMO_BLUE 2)

(defconstant BF_CEILING (meters 30))  ;; force-field ceiling of the jetpacks, above the higher spawn
(defconstant BF_DROP_MAX 8)           ;; pickups of dead units waiting for the director
(defconstant BF_RESPAWN_TIME (seconds 4)) ;; a dead player watches the battle this long, then respawns

;; Army caps: at most 20 units per side on the street at once. Freedom League: 14 blue guards and 6
;; blue jetpack guards. Krimzon Guard: 4 red riflemen, 4 red grenadiers, 4 red jetpack guards, 4
;; robotguards and 4 spider robots. The traffic pools are capped to these sums (`bf-want-count`), and
;; each new guard or jetpack guard takes the look furthest below its share (`*bf-look-share*`). The
;; stock "war" spawn level fields about 50 units (guard-a 13, roboguards 6, spydroids 9, flying
;; turrets 6, Metal Heads 17, traffic-manager.gc *want-count-levels*): the battle's 40 and no citizen
;; stay under it.
(defconstant BF_CAP_GUARDS 22)
(defconstant BF_CAP_TURRETS 10)
(defconstant BF_CAP_ROBOGUARDS 4)
(defconstant BF_CAP_SPYDROIDS 4)

;; The battle's unit kinds (traffic types: guard-a, flying-turret, roboguard, spydroid) and each
;; side's share of the caps above, Freedom League then Krimzon Guard, in that order: what its troop
;; transports bring it (levels/city/battlefront/bf-transport.gc).
(defconstant BF_KIND_COUNT 4)
(define *bf-kinds* (new 'static 'array int32 4 6 16 14 15))
(define *bf-team-caps* (new 'static 'array int32 8 14 6 0 0 8 4 4 4))

;; ---------------------------------------------------------------------------------------------
;; Types
;; ---------------------------------------------------------------------------------------------

(deftype bf-zone (basic)
  "One war zone, with a continue point of each side: its base. The battlefield is the whole of
   Haven City; the game loads its sections around the player as it does outside a battle."
  ((name        string)    ;; menu label
   (desc        string)    ;; menu description
   (name-fr     string)    ;; the same in French (game language French)
   (desc-fr     string)
   (ff-continue string)    ;; Freedom League base
   (kg-continue string)    ;; Krimzon Guard base
   )
  )

(deftype bf-class-info (basic)
  "One playable class: label, description (English, French) and side. The description is lines of
   the class page, each drawn as it is: a button is its icon tag (<PAD_R1>, <PAD_L2>...: the PC
   font's button icons, common/util/font/dbs/font_db_jak3.cpp), the first line the class's
   features."
  ((name     string)
   (desc     (array string))
   (name-fr  string)
   (desc-fr  (array string))
   (team     int32)
   )
  )

;; Battle points: the two sides' bases (their spawns, points 0 and 1), and a control point in each
;; district the units fight in, neutral at the start (`*bf-point-defs*`). A side holding one sends
;; its troop transports there and its player may respawn there (battlefront.gc `bf-update-points`,
;; battlefront-city.gc).
(defconstant BF_POINT_MAX 6)
(defconstant BF_CONTROL_POINTS 4)
(defconstant BF_POINT_RADIUS (meters 15))      ;; units within it count for its capture
(defconstant BF_CAPTURE_TIME 30.0)             ;; seconds a side's majority on it takes to capture it

(deftype bf-point (structure)
  "A battle point: a side's base, or a control point the sides capture (`bf-update-points`)."
  ((pos        vector :inline) ;; on the ground
   (owner      int32)          ;; BF_TEAM_FF, BF_TEAM_KG, or BF_TEAM_NONE: neutral
   (base?      symbol)         ;; a side's base: never changes hands
   (prog-team  int32)          ;; the side capturing it, BF_TEAM_NONE for none
   (progress   float)          ;; seconds of capture so far, up to BF_CAPTURE_TIME
   (near       int32 2)        ;; units of each side within BF_POINT_RADIUS at the last count
   (ship       handle)         ;; the troop transport serving it now, #f for none (battlefront-city.gc)
   (fight      float)          ;; seconds of a fight away from the player since its last losses
   )
  )

(deftype bf-point-def (basic)
  "Where a battle point stands: its name (English, French), the continue point whose levels a
   respawn there loads (a base stands on it), and, for a control point, its place: the middle of a
   lane of its district, where units walk and transports find ground."
  ((name      string)
   (name-fr   string)
   (continue  string)
   (x         float)  ;; meters
   (y         float)
   (z         float)
   )
  )

(deftype bf-state (structure)
  "The whole state of the current battle. One static instance, `*bf*`."
  ((phase         int32)
   (zone          int32)
   (team          int32)          ;; player's side
   (class         int32)          ;; player's class
   (winner        int32)          ;; side that won, BF_TEAM_NONE while fighting
   (reserve       int32  2)       ;; units left per side
   (losses        int32  2)       ;; units lost per side
   (center        vector :inline) ;; battlefield sphere: xyz center, w radius
   (spawn         vector 2 :inline) ;; each side's spawn point
   (phase-time    time-frame)     ;; when `phase` last changed
   (respawn-time  time-frame)     ;; the dead player respawns then (battlefront.gc `bf-target-death`), 0 alive
   (safe          vector :inline) ;; the player's last place standing inside the zone's levels
   (safe-level    symbol)         ;; the level he was in there
   (safe-time     time-frame)     ;; when that place was taken
   ;; Handles live here, not in globals: a global symbol holds 32 bits and a handle is 64, its pid
   ;; in the upper half, so a handle kept in a `define`d global never resolves (Lisp wiki common
   ;; 1.4.17). Handles, not ppointers: the avatar comes from *default-dead-pool*, a dead-pool-heap
   ;; whose freed records go to the next process spawned (gkernel.gc dead-pool-heap return-process).
   (avatar        handle)         ;; the model of the player's class (battlefront-player.gc)
   (director      handle)         ;; the process running the battle (battlefront.gc)
   (spectate      handle)         ;; the unit the camera follows while the player waits to respawn
   (weapon        int32)          ;; BF_WEAPON_* in the hands of a guard class
   (mag           int32 3)        ;; shots left in each guard weapon's magazine, by BF_WEAPON_*
   (redraw?       symbol)         ;; the class model must be drawn again (red guard weapon change)
   (shield?       symbol)         ;; the robotguard's shield is up (battlefront.gc target-attacked)
   (ceiling       float)          ;; highest y a jetpack may reach (force field)
   (light-saved   float)          ;; Jak's light eco before the battle (the shield's hits take some)
   (dark-saved    float)          ;; Jak's dark eco before the battle (a battle turns it into fuel)
   (endless-dark? symbol)         ;; the endless dark eco secret was on before the battle
   (endless-light? symbol)        ;; the same for light eco
   (ammo-saved    float 4)        ;; Jak's gun ammo before the battle
   (aim-frame     int64)          ;; frame the free aim below was computed for (`bf-free-aim`)
   (aim-foe       handle)         ;; foe under the crosshair, #f for none
   (aim           vector :inline) ;; where the crosshair's ray meets the world
   (drop-count    int32)          ;; pickups of dead units waiting for the director
   (drop-kind     int32 8)        ;; their pickup-type
   (drop-pos      vector 8 :inline)
   ;; The battle's third-person camera (battlefront-player.gc `bf-cam-rig`): where it looks, turned
   ;; by the right stick. Kept here, not in the rig, so a class change or a respawn keeps the view.
   (view-yaw      float)          ;; heading, rotation units (0 looks along +z)
   (view-pitch    float)          ;; up positive, rotation units
   (view-set?     symbol)         ;; the view was set for this battle (else taken from Jak's facing)
   (rig           handle)         ;; the camera rig, #f for none
   (kills         int32)          ;; units the player killed in this battle (the HUD's counter)
   (tazer-time    time-frame)     ;; guard: the last tazer strike (BF_TAZER_RECHARGE before the next)
   (own-attack    float)          ;; damage (24 scale) of the player's attack being sent, -1.0 none
   (points        bf-point BF_POINT_MAX :inline) ;; 0 and 1 the sides' bases, then the control points
   (point-count   int32)          ;; points in use
   (point-time    time-frame)     ;; last capture count (`bf-update-points`)
   (respawn-pick  int32)          ;; the point the dead player chose to respawn at, -1 none yet
   (combat-time   time-frame)     ;; the player's last shot, blow or hit taken, on the game clock (`bf-combat!`)
   (respawn-at    int32)          ;; the point a far respawn's reset brings the player to, -1 none
   (redeploy-ok?  symbol)         ;; the player may redeploy now (the director's clock; the START menu reads it)
   (deaths        int32)          ;; the player's deaths in this battle
   (bag-deaths    int32)          ;; unit deaths left in the pickup bag (`bf-queue-drop`), 0 for a new bag
   (bag-drops     int32)          ;; pickups left in it
   )
  )

(define *bf* (new 'static 'bf-state :phase BF_PHASE_OFF :team BF_TEAM_FF :winner BF_TEAM_NONE))
;; a zero handle names process 0, which is not #f: start with no process
(set! (-> *bf* avatar) (the-as handle #f))
(set! (-> *bf* director) (the-as handle #f))
(set! (-> *bf* aim-foe) (the-as handle #f))
(set! (-> *bf* spectate) (the-as handle #f))
(set! (-> *bf* rig) (the-as handle #f))
(set! (-> *bf* own-attack) -1.0)
;; a symbol field of a static structure starts as 0, which is not #f (it tests true): the robotguard's
;; shield flag left at 0 kept Jak's shield level up in every battle, so no attack ever hurt the player
(set! (-> *bf* safe-level) #f)
(set! (-> *bf* redraw?) #f)
(set! (-> *bf* shield?) #f)
(set! (-> *bf* endless-dark?) #f)
(set! (-> *bf* endless-light?) #f)
(set! (-> *bf* view-set?) #f)
(set! (-> *bf* respawn-at) -1)

(defun bf-combat! ()
  "The player is in combat now (a shot, a blow, a hit taken): `*bf*` combat-time, on the game clock.
   Each process reads its own clock with `current-time`, and Jak's, the class model's, the director's
   and the START menu's are not all the same: the menu's 30 s test never passed."
  (set! (-> *bf* combat-time) (-> *display* game-clock frame-counter))
  (none)
  )
(set! (-> *bf* redeploy-ok?) #f)
;; the points' ships: no process (a zero handle names process 0)
(dotimes (i BF_POINT_MAX)
  (set! (-> *bf* points i ship) (the-as handle #f))
  )

;; Set by the Mods menu. While it is on, START > Options shows Gamemode (the battle's pages);
;; turning it off during a battle loads the last save (battlefront.gc `bf-leave-to-save!`).
(define *mod-battlefront-enable* #f)

;; Commands of `*bf-city-hook*`, the Haven City side of a battle (levels/city/battlefront/battlefront-city.gc).
(defconstant BF_CITY_PREPARE 0)   ;; the zone is loaded, the fight starts
(defconstant BF_CITY_UPDATE 1)    ;; every frame of the fight
(defconstant BF_CITY_RESET 2)     ;; the battle ends
(defconstant BF_CITY_FREE_NAVS 3) ;; just before an `initialize!` 'life: the units give back the default nav mesh

;; Factions of a battle: Freedom League and Krimzon Guard both strong everywhere, Metal Heads
;; out; guards at the "combat" spawn level (guard-a 13), KG robots at "war" (roboguard 5,
;; spydroid 4, flying turret 5), no civilians, no traffic vehicles. Given to the stock
;; `faction-command` setting, and re-applied by battlefront-city.gc (a death reset or a task
;; change restores the stock faction state).
(define *bf-faction-commands*
  '((faction-strength ff 20)
    (faction-strength kg 20)
    (faction-strength mh -20)
    (faction-spawn ff-guard combat)
    (faction-spawn kg-guard war)
    (faction-spawn mh-guard off)
    (faction-spawn ff-ped war)
    (faction-spawn ff-vehicle off)
    (faction-spawn kg-ambient off)
    (faction-spawn mh-ambient off)
    )
  )

;; Set by battlefront-city.gc each time CWI links. Only called while ctywide is active, which
;; guarantees it points into the current link.
(define *bf-city-hook* (the-as (function int none) #f))

;; The same for the player's grenades (from, landing point): their projectile type is CWI code.
(define *bf-city-grenade* (the-as (function vector vector none) #f))

;; ---------------------------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------------------------

;; The war zone: the whole of Haven City. Each side's base is a stock continue point: the Freedom
;; League's at the entrance of its headquarters (the point Jak comes out at when he leaves them), the
;; Krimzon Guard's on the Port's east docks, by its war zone. The battle used to hold one district,
;; its sections kept loaded and a force field at its edges; the author wanted the whole city.
(define *bf-zones*
  (new 'static 'boxed-array :type bf-zone
    (new 'static 'bf-zone
      :name "Haven City"
      :desc "The whole city: a control point in each district, the Port, the Industrial Zone, the Slums and Freedom HQ."
      :name-fr "Haven City"
      :desc-fr "Toute la ville : un point de contrôle dans chaque quartier, le Port, la zone industrielle, les bas quartiers et le QG de la Ligue."
      :ff-continue "ctyslumc-freehq-exit"
      :kg-continue "ctyport-bombbot"
      )
    )
  )

;; The battle points, in `*bf*` points order: the bases (their places are their continue points),
;; then a control point in each district, the middle of a lane between that district's ends (found
;; on its streets by the battles of round 16), with a continue point of its section.
(define *bf-point-defs*
  (new 'static 'boxed-array :type bf-point-def
    (new 'static 'bf-point-def :name "Freedom League base" :name-fr "Base de la Ligue" :continue "ctyslumc-freehq-exit")
    (new 'static 'bf-point-def :name "Krimzon Guard base" :name-fr "Base de la Grenagarde" :continue "ctyport-bombbot")
    (new 'static 'bf-point-def :name "Port" :name-fr "Port" :continue "ctyport-bbush-6"
      :x 225.08 :y 9.71 :z 1368.35)
    (new 'static 'bf-point-def :name "Industrial Zone" :name-fr "Zone industrielle" :continue "ctyinda-bbush-5"
      :x 929.45 :y 10.17 :z 854.68)
    (new 'static 'bf-point-def :name "Slums" :name-fr "Bas quartiers" :continue "ctysluma-alley"
      :x 1000.76 :y 10.35 :z 266.12)
    (new 'static 'bf-point-def :name "Freedom HQ" :name-fr "QG de la Ligue" :continue "ctyslumb-bbush-4"
      :x 522.14 :y 2.88 :z -339.72)
    )
  )

;; Which points are next to which (the districts' streets): a side fights for a point away from
;; the player only from one next to it (battlefront.gc `bf-update-points`). Bit i: point i.
(define *bf-point-links*
  (new 'static 'array uint32 6
    #b100000  ;; Freedom League base: Freedom HQ
    #b001100  ;; Krimzon Guard base: Port, Industrial Zone
    #b001010  ;; Port: Krimzon Guard base, Industrial Zone
    #b010110  ;; Industrial Zone: Krimzon Guard base, Port, Slums
    #b101000  ;; Slums: Industrial Zone, Freedom HQ
    #b010001  ;; Freedom HQ: Freedom League base, Slums
    )
  )

(define *bf-team-names* (new 'static 'boxed-array :type string "Freedom League" "Krimzon Guard"))
(define *bf-team-names-fr* (new 'static 'boxed-array :type string "Ligue de la liberté" "Grenagarde"))

;; The guards' help, the same for both colors. The font has no icon for the left D-pad button, only
;; for its up and down ones and all four: the tazer's line builds it from the icon's parts the way
;; font_db_jak3.cpp builds <PAD_DPAD_UP>, its left part lit (~3L) instead of its up part.
(define *bf-guard-help*
  (new 'static 'boxed-array :type string
    "24 HP. Rifle 10/20, 5 grenades"
    "<PAD_R1> Fire    <PAD_SQUARE> Rifle butt"
    "<PAD_L2> + <PAD_ANALOG_ANY> Roll"
    "<PAD_R2> + <PAD_ANALOG_ANY> Strafe"
    "~Y~3L<PAD_PART_DPAD_L>~Z~22L~+17H~-13V<PAD_PART_DPAD_U>~Z~22L~+17H~+14V<PAD_PART_DPAD_D>~Z~22L~+32H<PAD_PART_DPAD_R>~Z~+56H Tazer (every 20 s)"
    "<PAD_DPAD_DOWN> Rifle    <PAD_DPAD_UP> Grenades"
    )
  )

(define *bf-guard-help-fr*
  (new 'static 'boxed-array :type string
    "24 PV. Fusil 10/20, 5 grenades"
    "<PAD_R1> Tir    <PAD_SQUARE> Crosse"
    "<PAD_L2> + <PAD_ANALOG_ANY> Roulade"
    "<PAD_R2> + <PAD_ANALOG_ANY> Pas chassé"
    "~Y~3L<PAD_PART_DPAD_L>~Z~22L~+17H~-13V<PAD_PART_DPAD_U>~Z~22L~+17H~+14V<PAD_PART_DPAD_D>~Z~22L~+32H<PAD_PART_DPAD_R>~Z~+56H Tazer (toutes les 20 s)"
    "<PAD_DPAD_DOWN> Fusil    <PAD_DPAD_UP> Grenades"
    )
  )

(define *bf-jetpack-help*
  (new 'static 'boxed-array :type string
    "18 HP. Flies without limit."
    "<PAD_X> Up    <PAD_CIRCLE> Down"
    "<PAD_R2> + <PAD_ANALOG_ANY> Boost"
    "Dark eco refills the boost."
    "<PAD_R1> 2 shots    <PAD_SQUARE> Dive kick"
    )
  )

(define *bf-jetpack-help-fr*
  (new 'static 'boxed-array :type string
    "18 PV. Vol sans limite."
    "<PAD_X> Monter    <PAD_CIRCLE> Descendre"
    "<PAD_R2> + <PAD_ANALOG_ANY> Accélérer"
    "L'éco noire recharge la jauge."
    "<PAD_R1> Deux tirs    <PAD_SQUARE> Piqué"
    )
  )

(define *bf-no-help* (new 'static 'boxed-array :type string ""))

(define *bf-classes*
  (new 'static 'boxed-array :type bf-class-info
    (new 'static 'bf-class-info :name "Blue Guard" :team BF_TEAM_FF :name-fr "Garde bleu")
    (new 'static 'bf-class-info :name "Blue Guard (Jetpack)" :team BF_TEAM_FF :name-fr "Garde bleu (jetpack)")
    ;; Spargus Citizen: no longer playable (kept for the indices)
    (new 'static 'bf-class-info :name "Spargus Citizen" :team BF_TEAM_FF :name-fr "Citoyen de Spargus")
    ;; Jak: no longer playable (kept for the indices)
    (new 'static 'bf-class-info :name "Jak" :team BF_TEAM_FF :name-fr "Jak")
    (new 'static 'bf-class-info :name "Red Krimzon Guard" :team BF_TEAM_KG :name-fr "Garde rouge")
    (new 'static 'bf-class-info :name "Red Krimzon Guard (Jetpack)" :team BF_TEAM_KG :name-fr "Garde rouge (jetpack)")
    (new 'static 'bf-class-info :name "Robotguard" :team BF_TEAM_KG
         :desc (new 'static 'boxed-array :type string
                 "24 HP. Slow and heavy."
                 "<PAD_R1> Two shots    <PAD_SQUARE> Punch"
                 "<PAD_CIRCLE> Shield for 5 s"
                 "Shield recharge: 25 s"
                 "<PAD_R2> Ball / stand up"
                 )
         :name-fr "Robotgarde"
         :desc-fr (new 'static 'boxed-array :type string
                    "24 PV. Lent et lourd."
                    "<PAD_R1> Deux tirs    <PAD_SQUARE> Poing"
                    "<PAD_CIRCLE> Bouclier pendant 5 s"
                    "Recharge du bouclier : 25 s"
                    "<PAD_R2> Boule / redéploiement"
                    )
         )
    (new 'static 'bf-class-info :name "Spider Robot" :team BF_TEAM_KG
         :desc (new 'static 'boxed-array :type string
                 "12 HP. Fast."
                 "<PAD_X> 11 m leap    <PAD_CIRCLE> Bite"
                 "<PAD_R2> Sprint, 10 s gauge"
                 )
         :name-fr "Araignée robot"
         :desc-fr (new 'static 'boxed-array :type string
                    "12 PV. Rapide."
                    "<PAD_X> Bond de 11 m    <PAD_CIRCLE> Morsure"
                    "<PAD_R2> Sprint, jauge de 10 s"
                    )
         )
    )
  )

;; The help lines shared by two classes, linked in here (static data cannot name another symbol).
(set! (-> *bf-classes* BF_CLASS_BLUE_GUARD desc) *bf-guard-help*)
(set! (-> *bf-classes* BF_CLASS_BLUE_GUARD desc-fr) *bf-guard-help-fr*)
(set! (-> *bf-classes* BF_CLASS_RED_GUARD desc) *bf-guard-help*)
(set! (-> *bf-classes* BF_CLASS_RED_GUARD desc-fr) *bf-guard-help-fr*)
(set! (-> *bf-classes* BF_CLASS_BLUE_JETPACK desc) *bf-jetpack-help*)
(set! (-> *bf-classes* BF_CLASS_BLUE_JETPACK desc-fr) *bf-jetpack-help-fr*)
(set! (-> *bf-classes* BF_CLASS_RED_JETPACK desc) *bf-jetpack-help*)
(set! (-> *bf-classes* BF_CLASS_RED_JETPACK desc-fr) *bf-jetpack-help-fr*)
(set! (-> *bf-classes* BF_CLASS_WASTELANDER desc) *bf-no-help*)
(set! (-> *bf-classes* BF_CLASS_WASTELANDER desc-fr) *bf-no-help*)
(set! (-> *bf-classes* BF_CLASS_JAK desc) *bf-no-help*)
(set! (-> *bf-classes* BF_CLASS_JAK desc-fr) *bf-no-help*)

;; ---------------------------------------------------------------------------------------------
;; Text (English, or French when the game runs in French)
;; ---------------------------------------------------------------------------------------------

(defun bf-fr? ()
  "#t when the game text is French. The PC port draws game text in the language of its settings
   (pc-settings text-language), not in the one a save game restores."
  (= (-> *pc-settings* text-language) (pc-language french))
  )

(defun bf-tr ((en string) (fr string))
  "EN, or FR when the game runs in French."
  (if (bf-fr?) fr en)
  )

(defun bf-team-name ((team int))
  "Name of side TEAM in the game's language."
  (if (bf-fr?) (-> *bf-team-names-fr* team) (-> *bf-team-names* team))
  )

(defun bf-zone-name ((zone int))
  "Name of war zone ZONE in the game's language."
  (bf-tr (-> *bf-zones* zone name) (-> *bf-zones* zone name-fr))
  )

(defun bf-class-name ((class int))
  "Name of class CLASS in the game's language."
  (bf-tr (-> *bf-classes* class name) (-> *bf-classes* class name-fr))
  )

;; ---------------------------------------------------------------------------------------------
;; Skeletons of the Jak 2 models (art built by build-actor, shipped in CTYPESA / CTYPESC)
;; ---------------------------------------------------------------------------------------------

;; Red Krimzon Guard: the Jak 3 guard's skeleton and clips, at the stock crimson-guard indices
;; (custom_assets/jak3/models/models.jsonc pads the clips so idle is 4, as in crimson-guard-ag).
(def-art-elt bf-red-guard-ag bf-red-guard-lod0-jg 0)
(def-art-elt bf-red-guard-ag bf-red-guard-lod0-mg 1)
(def-art-elt bf-red-guard-ag bf-red-guard-idle-ja 4)

(defskelgroup skel-bf-red-guard bf-red-guard bf-red-guard-lod0-jg -1
              ((bf-red-guard-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              :origin-joint-index 3
              )

;; The same guard with the grenade launcher / tazer instead of the rifle (a build-actor model
;; draws all its primitives, so each weapon is its own model).
(def-art-elt bf-red-guard-gl-ag bf-red-guard-gl-lod0-jg 0)
(def-art-elt bf-red-guard-gl-ag bf-red-guard-gl-lod0-mg 1)
(def-art-elt bf-red-guard-gl-ag bf-red-guard-gl-idle-ja 4)

(defskelgroup skel-bf-red-guard-gl bf-red-guard-gl bf-red-guard-gl-lod0-jg -1
              ((bf-red-guard-gl-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              :origin-joint-index 3
              )

;; Jetpack guards. Clip order (custom_assets/jak3/models/models.jsonc): the three the flying-turret code plays first
;; (2 idle, 3 hover, 4 fire), then the others.
(def-art-elt bf-hover-red-ag bf-hover-red-lod0-jg 0)
(def-art-elt bf-hover-red-ag bf-hover-red-lod0-mg 1)
(def-art-elt bf-hover-red-ag bf-hover-red-idle-ja 2)
(def-art-elt bf-hover-blue-ag bf-hover-blue-lod0-jg 0)
(def-art-elt bf-hover-blue-ag bf-hover-blue-lod0-mg 1)
(def-art-elt bf-hover-blue-ag bf-hover-blue-idle-ja 2)

(defskelgroup skel-bf-hover-red bf-hover-red bf-hover-red-lod0-jg bf-hover-red-idle-ja
              ((bf-hover-red-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              :origin-joint-index 3
              )

(defskelgroup skel-bf-hover-blue bf-hover-blue bf-hover-blue-lod0-jg bf-hover-blue-idle-ja
              ((bf-hover-blue-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              :origin-joint-index 3
              )

;; Pace of the jetpack guards' clips, in clip frames per 60th of a second. They are the Jak 2 rip's
;; frames, 15 a second (game.gp build-actor :framerate 15.0), which build-actor stores with a speed
;; of one frame per 60th (seen in game: speed 1.0). Played at that speed, the player's jetpack
;; looped its 16-frame hover clip four times a second and its legs shook; the units' own, at 0.5,
;; twice too fast.
(defconstant BF_HOVER_RATE 0.25)

;; Clip indices of the jetpack guard art groups (both share the order).
(defconstant BF_HOVER_IDLE 2)
(defconstant BF_HOVER_FLY_FORWARD 3)
(defconstant BF_HOVER_SHOOT 4)
(defconstant BF_HOVER_FLY_RIGHT 5)
(defconstant BF_HOVER_FLY_LEFT 6)
(defconstant BF_HOVER_FLY_BACK 7)
(defconstant BF_HOVER_DEATH 12)

;; ---------------------------------------------------------------------------------------------
;; State helpers
;; ---------------------------------------------------------------------------------------------

(defun bf-active? ()
  "#t from the deployment to the end of the result screen. Every hook below answers like the stock
   game while this is #f."
  (!= (-> *bf* phase) BF_PHASE_OFF)
  )

(defun bf-fighting? ()
  "#t while losses count."
  (= (-> *bf* phase) BF_PHASE_FIGHT)
  )

(defun bf-set-phase! ((phase int))
  "Enter PHASE and stamp its start time."
  (set! (-> *bf* phase) phase)
  (set! (-> *bf* phase-time) (current-time))
  (none)
  )

(defun bf-other-team ((team int))
  "The opposite side of TEAM."
  (if (= team BF_TEAM_FF) BF_TEAM_KG BF_TEAM_FF)
  )

(defun bf-art-name ((proc process))
  "Name of the joint geometry (the skeleton, named <art group>-lod0) PROC draws, or \"\" when it has
   no draw-control yet. A unit is told by its skeleton, not by its art group: a red guard plays the
   blue guard's clips, from crimson-guard-ag (`bf-guard-clips`)."
  (let ((pd (the-as process-drawable proc)))
    (if (and (type? proc process-drawable) (nonzero? (-> pd draw)) (-> pd draw) (-> pd draw jgeo))
        (-> pd draw jgeo name)
        ""
        )
    )
  )

(defun bf-red-guard? ((proc process))
  "#t when PROC is a crimson-guard drawn with one of the red Jak 2 models."
  (and (= (-> proc type symbol) 'crimson-guard)
       (let ((name (bf-art-name proc)))
         (or (string= name "bf-red-guard-lod0") (string= name "bf-red-guard-gl-lod0"))
         )
       )
  )

(defun bf-guard-clips ((this process-drawable))
  "Called right after a red guard's skeleton is set up (guard.gc init-enemy!, and the red guard
   class's avatar): it plays the blue guard's clips. Its model is Jak 2's on Jak 3's 41-joint guard
   skeleton (the same joints and bind pose), so its draw takes crimson-guard-ag, when that art group
   is in its level, as the art group its clips (and their sound and death effects) are looked up
   in; its own meshes stay. The model's own clips (build-actor, 15 frames a second) ran too fast;
   these run at the blue guard's pace. The effects need an effect-control, which a process only gets
   when its model has an effect-name lump (effect-control's new), and a build-actor model has none:
   it gets one, made like effect-control's new does. The method comes from the mod Haven City: New
   Dawn. Returns nothing. Side effects: the draw-control's art-group, the skeleton's effect-control
   (process heap)."
  (when (and (-> this level)
             (let ((name (bf-art-name this)))
               (or (string= name "bf-red-guard-lod0") (string= name "bf-red-guard-gl-lod0"))
               )
             )
    (let ((ag (load-to-heap-by-name (-> this level art-group) "crimson-guard" 'test global 0)))
      (when (and ag
                 (= (-> ag type) art-group)
                 (= (-> (the-as art-joint-geo (-> ag data 0)) length) (-> this draw jgeo length))
                 )
        (set! (-> this draw art-group) ag)
        (when (not (-> this skel effect))
          (let ((ec (the-as effect-control ((method-of-type object new) 'process effect-control (the-as int (-> effect-control size))))))
            (set! (-> ec process) this)
            (set! (-> ec last-frame-group) #f)
            (set! (-> this skel effect) ec)
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-custom-model? ((proc process))
  "#t when PROC draws one of the mod's build-actor models (the red guards, the jetpack guards)."
  (let ((name (bf-art-name proc)))
    (or (string= name "bf-red-guard-lod0")
        (string= name "bf-red-guard-gl-lod0")
        (string= name "bf-hover-red-lod0")
        (string= name "bf-hover-blue-lod0")
        )
    )
  )

;; Stock effect step, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-do-effect* (function effect-control string float int none)
             (method-of-type effect-control do-effect)
             )

(defmethod do-effect ((this effect-control) (arg0 string) (arg1 float) (arg2 int))
  "Every effect of a clip goes through here (effect-control.gc). A death effect (death-default and
   the other death-* effects) is skipped for the mod's build-actor models (`bf-custom-model?`): it
   sets the draw-control's death-timer, which makes the PC renderer draw the model through generic
   merc (foreground.gc, the PC reassign), and a build-actor model has only a dummy merc-ctrl there
   (goalc/build_actor/jak3/build_actor.cpp): mercneric_convert reads its dummy fragments (seen in
   game: crashes in mercneric_convert, mips2c generic_merc.cpp, seconds into battles, as units
   died). The red guards play the blue guard's clips, effects included
   (`bf-guard-clips`): their 'event-death runs death-default (guard.gc). The body then goes with
   its death clip, without the dissolve (Lisp wiki jak3 4.35). Every other effect: the stock step."
  (let ((name (cond
                ((= (rtype-of arg0) symbol) (symbol->string (the-as symbol arg0)))
                ((= (rtype-of arg0) string) arg0)
                (else (the-as string #f))
                )
              )
        )
    (if (and name (string-prefix= "death-" name) (-> this process) (bf-custom-model? (-> this process)))
        (none)
        (*bf-stock-do-effect* this arg0 arg1 arg2)
        )
    )
  (none)
  )

(defun bf-reload-break-ok? ((this process-drawable))
  "Called by guard-grenade.gc grenade-throw-post-reloading's trans before a grenade guard breaks off
   its reload because its target came close. During a battle it breaks it off only for the player:
   against another guard it finishes reloading. With a guard as its target within half its
   keep-away distance, the reload, the backing away and the grenade state chained within one frame,
   a new reload grenade each time, until the stack overflowed and the game crashed (Lisp wiki jak3
   4.40, seen in the mod Haven City: New Dawn). #t out of a battle. No side effects."
  (or (not (bf-active?)) (= (handle->process (-> (the-as enemy this) focus handle)) *target*))
  )

(defun bf-hover-art? ((proc process))
  "#t when PROC draws one of the two jetpack guard models."
  (let ((name (bf-art-name proc)))
    (or (string= name "bf-hover-red-lod0") (string= name "bf-hover-blue-lod0"))
    )
  )

(defun bf-hover-nozzle! ((this process-drawable) (pos vector) (dir vector) (side int))
  "Called by flying-turret-method-229 (flying-turret.gc) before each of its two thruster flames. A
   jetpack guard's flame comes out of its jetpack's turbine, node 15 (SIDE 0, Lturbine) or 17 (SIDE
   1, Rturbine) of the Jak 2 hover guard model, along the joint's -z axis, not from the turret's
   spots under its root (the mod Haven City: New Dawn's fix for the same model). POS, DIR: set to
   the joint's place and that axis. Returns #t when it set them, #f (both unchanged) for a stock
   flying turret."
  (cond
    ((bf-hover-art? this)
     (let ((joint (-> this node-list data (if (zero? side) 15 17))))
       (vector<-cspace! pos joint)
       (vector-normalize-copy! dir (-> joint bone transform vector 2) -1.0)
       )
     #t
     )
    (else
      #f
      )
    )
  )

(defun bf-unit-team ((proc process))
  "Side of a unit, BF_TEAM_NONE for anything that does not fight in the battle."
  (let ((sym (-> proc type symbol)))
    (cond
      ((= proc *target*) (-> *bf* team))
      ((= sym 'crimson-guard) (if (bf-red-guard? proc) BF_TEAM_KG BF_TEAM_FF))
      ((= sym 'flying-turret) (if (string= (bf-art-name proc) "bf-hover-blue-lod0") BF_TEAM_FF BF_TEAM_KG))
      ((or (= sym 'roboguard-city) (= sym 'spydroid)) BF_TEAM_KG)
      (else BF_TEAM_NONE)
      )
    )
  )

;; ---------------------------------------------------------------------------------------------
;; Health and damage on one 24 point scale
;; ---------------------------------------------------------------------------------------------

;; During a fight every unit and every class has its health on one scale, 24 points for a guard, and
;; every weapon takes the same points from any of them: the stock hit points of each unit type and
;; the stock damage of each weapon differ (a guard 4, a flying turret 1, a shot 1, a grenade 6).
(defconstant BF_DMG_RIFLE 8.0)        ;; a rifle shot (the guards', the player guard's)
(defconstant BF_DMG_GRENADE 20.0)     ;; a guard grenade's blast
(defconstant BF_DMG_TAZER 24.0)       ;; the player guard's tazer strike
(defconstant BF_DMG_MELEE 10.0)       ;; a rifle butt, a robotguard's punch, a jetpack's dive kick
(defconstant BF_DMG_BITE 12.0)        ;; a spider robot's bite
(defconstant BF_DMG_ROBOT_SHOT 4.0)   ;; a robotguard's shot
(defconstant BF_DMG_JET_SHOT 6.0)     ;; a jetpack guard's shot

;; Full health of each class, indexed by BF_CLASS_*: guards and robotguard 24, jetpacks 18, spider 12.
(define *bf-class-hp* (new 'static 'array float 8 24.0 18.0 24.0 24.0 24.0 18.0 24.0 12.0))

(defun bf-class-health ((class int))
  "Jak's health for CLASS's full health: his whole health bar (fact health-max, the health ring's
   segments) stands for 24 points, so the spider robot starts half full. Needs *target*."
  (* (-> *target* fact health-max) (/ (-> *bf-class-hp* class) 24.0))
  )

(defun bf-unit-hp ((proc process))
  "Full health of PROC on the 24 point scale: guards and robotguards 24, jetpack guards 18, spider
   robots 12 (the classes' own), the player's class for Jak, 0.0 for anything else."
  (let ((sym (-> proc type symbol)))
    (cond
      ((= proc *target*) (-> *bf-class-hp* (-> *bf* class)))
      ((or (= sym 'crimson-guard) (= sym 'roboguard-city)) 24.0)
      ((= sym 'flying-turret) 18.0)
      ((= sym 'spydroid) 12.0)
      (else 0.0)
      )
    )
  )

(defun bf-shot-damage ((owner process))
  "Damage of a guard-shot fired for OWNER: the player's class's gun (rifle, robotguard, jetpack:
   the avatar fires guard-shots for all three), a guard's rifle for any unit."
  (if (= owner *target*)
      (case (-> *bf* class)
        ((BF_CLASS_ROBOGUARD) BF_DMG_ROBOT_SHOT)
        ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) BF_DMG_JET_SHOT)
        (else BF_DMG_RIFLE)
        )
      BF_DMG_RIFLE
      )
  )

(defun bf-attack-damage ((sender process) (owner process))
  "Damage, on the 24 point scale, of an attack that SENDER sent for OWNER (the attacker: a shot's or
   a blast's owner), -1.0 to leave it to the stock rules. Told by the sender's type. The player's own
   attacks carry theirs (`*bf*` own-attack, set while `bf-send-attack` sends them); any other blow
   of Jak's body (running or jumping into a unit) deals none."
  (let ((sym (if sender (-> sender type symbol) #f)))
    (cond
      ((not sender) -1.0)
      ((= sender *target*) (fmax 0.0 (-> *bf* own-attack)))
      ((or (= sym 'guard-shot) (= sym 'guard-lazer-shot)) (bf-shot-damage owner))
      ((= sym 'roboguard-shot) BF_DMG_ROBOT_SHOT)
      ((= sym 'flying-turret-shot) BF_DMG_JET_SHOT)
      ((or (= sym 'explosion) (= sym 'vehicle-grenade) (= sym 'vehicle-grenade-deflect)) BF_DMG_GRENADE)
      ((= sym 'spydroid) BF_DMG_BITE)
      ((or (= sym 'crimson-guard) (= sym 'roboguard-city) (= sym 'flying-turret)) BF_DMG_MELEE)
      (else -1.0)
      )
    )
  )

;; Stock damage step of the city's units, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-damage-enemy* (function nav-enemy object event-message-block float)
             (method-of-type nav-enemy damage-enemy-from-attack!)
             )

(defmethod damage-enemy-from-attack! ((this nav-enemy) (arg0 object) (arg1 event-message-block))
  "Every attack on a nav-enemy takes its hit points here (enemy.gc enemy-event-handler; the guards'
   own step calls it after its alert). During a fight, for a unit of the battle (`bf-unit-hp`), the
   attack's points on the 24 point scale (`bf-attack-damage`) become the same share of the unit's
   stock hit points (enemy-info default-hit-points, which caps them first: a guard's 'victory
   raises them); its own side's fire takes none; a kill of the player's counts in `*bf*` kills.
   Anything else: the stock step. Defined on nav-enemy, the parent of every unit of the battle
   (citizen and its children, in level code linked after GAME, which copy it at their creation);
   GAME links with method-set propagation on (kmachine.cpp), so nav-enemy's own children in GAME
   take it too (Lisp wiki jak3 4.10). Returns the hit points taken."
  (let* ((sender (the-as process arg0))
         (owner (handle->process (-> this incoming attacker-handle)))
         (full (if (bf-fighting?) (bf-unit-hp this) 0.0))
         (dmg (if (< 0.0 full) (bf-attack-damage sender owner) -1.0))
         )
    (cond
      ((< dmg 0.0)
       (*bf-stock-damage-enemy* this arg0 arg1)
       )
      (else
        (if (and owner (>= (bf-unit-team owner) 0) (= (bf-unit-team owner) (bf-unit-team this)))
            (set! dmg 0.0)
            )
        (let ((max-hp (-> this enemy-info default-hit-points)))
          (set! (-> this hit-points) (fmin (-> this hit-points) max-hp))
          (let ((taken (apply-incoming-hitpoint-mods this (* max-hp (/ dmg full)))))
            (set! (-> this hit-points) (- (-> this hit-points) taken))
            (if (not (logtest? (-> this enemy-flags) (enemy-flag auto-reset-penetrate)))
                (set! (-> this root penetrated-by) (get-penetrated-by this))
                )
            (if (and (< 0.0 taken) (>= 0.0 (-> this hit-points)) (= owner *target*))
                (+! (-> *bf* kills) 1)
                )
            taken
            )
          )
        )
      )
    )
  )

(defun bf-guard-weapon ((proc process) (want int))
  "Called by guard.gc crimson-guard-method-267 (every weapon change of a guard) and -270 (its
   off-screen change): the guard-type a guard of a battle gets for WANT. No unit of the battle has
   the tazer: a red guard carries its model's weapon (the rifle, or the launcher of
   bf-red-guard-gl), a blue guard the rifle or the launcher it was given, in place of the tazer the
   rifle or the launcher by its pid (one or the other for good; the squads give the blue guards the
   tazer mostly, and the launcher alone left no rifle among them, seen in game), and the rifle in
   place of a vehicle gunner's type (Lisp wiki jak3 4.37: a guard on foot with another type
   deactivates itself). WANT out of a battle."
  (let ((name (bf-art-name proc)))
    (cond
      ((not (bf-active?)) want)
      ((string= name "bf-red-guard-lod0") (the-as int (guard-type rifle)))
      ((string= name "bf-red-guard-gl-lod0") (the-as int (guard-type grenade)))
      ((= want (the-as int (guard-type tazer)))
       (the-as int (if (logtest? (-> proc pid) 1) (guard-type rifle) (guard-type grenade)))
       )
      ((or (= want (the-as int (guard-type rifle))) (= want (the-as int (guard-type grenade)))) want)
      (else (the-as int (guard-type rifle)))
      )
    )
  )

(defun bf-count-loss ((team int))
  "One unit of TEAM is lost: take it from the reserve, and end the battle when the reserve is empty.
   No-op outside the fight phase."
  (when (and (bf-fighting?) (>= team 0) (< team BF_TEAM_COUNT))
    (set! (-> *bf* reserve team) (max 0 (+ (-> *bf* reserve team) -1)))
    (+! (-> *bf* losses team) 1)
    (when (zero? (-> *bf* reserve team))
      (set! (-> *bf* winner) (bf-other-team team))
      (bf-set-phase! BF_PHASE_OVER)
      )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Functions called by stock level code (each a `;; MOD battlefront` line in the stock file)
;; ---------------------------------------------------------------------------------------------

;; Live units of each look: blue guard, red rifleman, red grenadier, blue jetpack, red jetpack.
;; Counted by the director every frame of a battle (`bf-count-looks!`, in its own process), and
;; raised by the two functions below for each unit they hand a look to, so that a pool spawning
;; several units in one frame stays balanced.
(defconstant BF_LOOK_BLUE 0)
(defconstant BF_LOOK_RED 1)
(defconstant BF_LOOK_RED_GL 2)
(defconstant BF_LOOK_JET_BLUE 3)
(defconstant BF_LOOK_JET_RED 4)
(define *bf-looks* (new 'static 'array int32 5 0 0 0 0 0))

(defun bf-count-looks! ()
  "Count the live guards and jetpack guards of each look into `*bf-looks*`. Called by the director,
   never from a unit's init: a unit is set up on the small stack of the traffic manager, and a walk
   of the whole process tree there crashed the game (illegal instruction while a zone loaded)."
  (dotimes (i 5)
    (set! (-> *bf-looks* i) 0)
    )
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (let ((sym (-> p type symbol)))
        (when (or (= sym 'crimson-guard) (= sym 'flying-turret))
          (let ((name (bf-art-name p)))
            (cond
              ((string= name "crimson-guard-lod0") (+! (-> *bf-looks* BF_LOOK_BLUE) 1))
              ((string= name "bf-red-guard-lod0") (+! (-> *bf-looks* BF_LOOK_RED) 1))
              ((string= name "bf-red-guard-gl-lod0") (+! (-> *bf-looks* BF_LOOK_RED_GL) 1))
              ((string= name "bf-hover-blue-lod0") (+! (-> *bf-looks* BF_LOOK_JET_BLUE) 1))
              ((string= name "bf-hover-red-lod0") (+! (-> *bf-looks* BF_LOOK_JET_RED) 1))
              )
            )
          )
        )
      #t
      )
    *null-kernel-context*
    )
  (none)
  )

;; Share of each look in its pool (army caps above): 14 + 4 + 4 = BF_CAP_GUARDS, 6 + 4 = BF_CAP_TURRETS.
(define *bf-look-share* (new 'static 'array int32 5 14 4 4 6 4))

(defun bf-take-look ((look int))
  "Count one more unit of LOOK (it is being spawned) and return LOOK."
  (+! (-> *bf-looks* look) 1)
  look
  )

(defun bf-look-gap ((look int))
  "How many units LOOK lacks to reach its share of its pool (negative when it has too many)."
  (- (-> *bf-look-share* look) (-> *bf-looks* look))
  )

(defun bf-guard-skel-name ()
  "Skeleton for a new crimson-guard process (guard.gc init-enemy!). During a battle the guard-a
   pool holds 14 blue guards (Freedom League) and 8 red Jak 2 Krimzon Guards, half riflemen, half
   grenadiers: the new guard takes the look furthest below its share. An alternation was not
   enough: the traffic kills and spawns guards all the time (trims, section changes), and in game
   the pool drifted to no blue guard at all."
  (if (not (bf-active?))
      "skel-crimson-guard"
      (let ((look BF_LOOK_BLUE))
        (if (< (bf-look-gap look) (bf-look-gap BF_LOOK_RED))
            (set! look BF_LOOK_RED)
            )
        (if (< (bf-look-gap look) (bf-look-gap BF_LOOK_RED_GL))
            (set! look BF_LOOK_RED_GL)
            )
        (bf-take-look look)
        (case look
          ((BF_LOOK_RED) "skel-bf-red-guard")
          ((BF_LOOK_RED_GL) "skel-bf-red-guard-gl")
          (else "skel-crimson-guard")
          )
        )
      )
  )

(defun bf-turret-skel-name ()
  "Skeleton for a new flying-turret process (flying-turret.gc init-enemy!). During a battle the
   flying turrets become jetpack guards, 6 blue (Freedom League) and 4 red: the new one takes the
   colour furthest below its share (see `bf-guard-skel-name`)."
  (if (not (bf-active?))
      "skel-flying-turret"
      (let ((look (if (< (bf-look-gap BF_LOOK_JET_BLUE) (bf-look-gap BF_LOOK_JET_RED))
                      BF_LOOK_JET_RED
                      BF_LOOK_JET_BLUE
                      )
                  )
            )
        (bf-take-look look)
        (if (= look BF_LOOK_JET_BLUE)
            "skel-bf-hover-blue"
            "skel-bf-hover-red"
            )
        )
      )
  )

(defun bf-want-count ((kind int) (stock int))
  "Army cap of traffic type KIND during a battle, STOCK otherwise. Asked twice:
   * the pool size (traffic-manager.gc traffic-manager-method-22, every frame): a pool spawns its
     units up to it and deactivates the sleeping ones above it (traffic-manager-method-18);
   * how many units of the type may be awake (traffic-engine.gc activate-one-vehicle), in place
     of the squad controls' count for the territory, which they rewrite with their alert level:
     at the Port it allowed 7 guards, 1 flying turret and no roboguard, and the battle starved."
  (if (bf-active?)
      (case (the-as traffic-type kind)
        (((traffic-type guard-a)) BF_CAP_GUARDS)
        (((traffic-type flying-turret)) BF_CAP_TURRETS)
        (((traffic-type roboguard)) BF_CAP_ROBOGUARDS)
        (((traffic-type spydroid)) BF_CAP_SPYDROIDS)
        ;; no citizen on a battlefield: walkers, pilots, and their bikes and cars (the faction
        ;; commands leave some civilians to the faction manager's levels)
        (((traffic-type civilian-male)
          (traffic-type civilian-female)
          (traffic-type civilian-fat)
          (traffic-type civilian-pilot)
          (traffic-type civilian-bike-a)
          (traffic-type civilian-bike-b)
          (traffic-type civilian-bike-c)
          (traffic-type civilian-car-a)
          (traffic-type civilian-car-b)
          (traffic-type civilian-car-c)
          )
         0
         )
        (else stock)
        )
      stock
      )
  )

(defun bf-wake-count ((kind int) (stock int))
  "How many units of traffic type KIND the traffic may wake on its own (traffic-engine.gc
   activate-one-vehicle), STOCK out of a battle. During a fight none of the battle's four kinds: the
   sides' troop transports bring every unit (levels/city/battlefront/bf-transport.gc), woken with
   'activate-object, which this count does not hold back. Before the fight, and for the other
   kinds, the army caps (`bf-want-count`)."
  (if (and (bf-fighting?)
           (or (= kind (the-as int (traffic-type guard-a)))
               (= kind (the-as int (traffic-type flying-turret)))
               (= kind (the-as int (traffic-type roboguard)))
               (= kind (the-as int (traffic-type spydroid)))
               )
           )
      0
      (bf-want-count kind stock)
      )
  )

(defun bf-unit-scale ((proc process) (stock float))
  "Root scale of a flying-turret: the turret is drawn at 2.0, a jetpack guard at its own size."
  (if (bf-hover-art? proc) 1.0 stock)
  )

(defun bf-attacker-type ((proc process) (stock int))
  "Haven City attack-controller type a unit registers with (city-target-type). The red guard
   registers as a roboguard (9) and the blue jetpack as a rifle guard (4), so the stock hatred
   table sends each side against the other."
  (cond
    ((not (bf-active?)) stock)
    ((bf-red-guard? proc) 9)
    ((string= (bf-art-name proc) "bf-hover-blue-lod0") 4)
    (else stock)
    )
  )

(defun bf-guard-flags ((proc process) (flags uint) (dark uint))
  "Called by crimson-guard citizen-method-194 (guard.gc) as a guard is put on the street, before
   Jak 3 reads its dark-guard flag. FLAGS: the guard's citizen flags, DARK: the dark-guard bit (the
   citizen-flag enum is CWI's, unknown here). A red guard is never a dark guard: a dark guard shows
   the mesh effects 0 and 2 (crimson-guard-method-267, setup-masks 5), and a build-actor model has
   its envmap draws, the red guard's shiny armor, in effect 1: only its legs showed (seen in game).
   Returns the flags to set."
  (if (bf-red-guard? proc)
      (logclear flags dark)
      flags
      )
  )

(defun bf-guard-activated ((proc process))
  "Tail of crimson-guard citizen-method-194 (each time a guard is put on the street). A red guard
   gets `process-mask enemy` back, which stock citizens lose: Jak's aim and the wastelanders'
   foe search only consider processes that carry it."
  (when (bf-red-guard? proc)
    (logior! (-> proc mask) (process-mask enemy))
    )
  (none)
  )

(defun bf-queue-drop ((proc process))
  "Maybe leave a pickup where PROC died: 3 of every 10 fallen units leave one, in a random order (a
   bag of 10 deaths holding 3 pickups: 30 % exactly, where a 30 % chance at each death gave 26 % in
   two long battles), 12 in 30 yellow ammo (the rifle's reserve), 7 red (grenades), 6 health, 5
   dark eco (the jetpack's boost); no blue ammo: the tazer needs none. Queued for the director,
   which spawns it in its own process (`bf-spawn-drops`): this runs on the traffic manager's small
   stack."
  (when (and (type? proc process-drawable) (< (-> *bf* drop-count) BF_DROP_MAX))
    (when (<= (-> *bf* bag-deaths) 0)
      (set! (-> *bf* bag-deaths) 10)
      (set! (-> *bf* bag-drops) 3)
      )
    (let ((drop? (< (rand-vu-int-count (-> *bf* bag-deaths)) (-> *bf* bag-drops))))
      (+! (-> *bf* bag-deaths) -1)
      (when drop?
        (+! (-> *bf* bag-drops) -1)
        (let* ((roll (rand-vu-int-count 30))
               (kind (cond
                       ((< roll 12) (pickup-type ammo-yellow))
                       ((< roll 19) (pickup-type ammo-red))
                       ((< roll 25) (pickup-type health))
                       (else (pickup-type eco-pill-dark))
                       )
                     )
               (i (-> *bf* drop-count))
               )
          (set! (-> *bf* drop-kind i) (the-as int kind))
          (vector-copy! (-> *bf* drop-pos i) (-> (the-as process-drawable proc) root trans))
          (+! (-> *bf* drop-count) 1)
          )
        )
      )
    )
  (none)
  )

(defun bf-unit-killed ((proc process))
  "Called by the traffic engine when one of its units dies (traffic-tracker set-process-to-killed,
   reached once per real death; units recycled out of view do not go there): its side loses one
   unit, and it may leave a pickup."
  (when (bf-fighting?)
    (bf-count-loss (bf-unit-team proc))
    (bf-queue-drop proc)
    )
  (none)
  )

(defun bf-foe? ((proc process) (team int))
  "#t when PROC is a living unit of the side opposite TEAM, or the player when on that side."
  (and proc
       (type? proc process-focusable)
       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
       (let ((other (bf-unit-team proc)))
         (and (>= other 0) (!= other team))
         )
       )
  )

(defun bf-hover-animate ((this process-drawable) (speed float))
  "Post of a flying-turret drawn as a jetpack guard (flying-turret.gc enemy-common-post). The
   turret code holds its idle pose; this loops the jetpack guard's idle or forward clip by SPEED
   (units per second) at BF_HOVER_RATE unless the turret code is playing the firing clip."
  (when (and (bf-hover-art? this) (nonzero? (-> this skel)) (> (-> this skel active-channels) 0))
    (let* ((chan (-> this skel root-channel 0))
           (fire (-> this draw art-group data BF_HOVER_SHOOT))
           )
      (when (!= (-> chan frame-group) fire)
        (let ((want (the-as art-joint-anim (-> this draw art-group data (if (< speed (meters 4))
                                                                              BF_HOVER_IDLE
                                                                              BF_HOVER_FLY_FORWARD
                                                                              )
                                                    )
                            )
                    )
              )
          (when (!= (-> chan frame-group) want)
            (joint-control-channel-group! chan want num-func-identity)
            (set! (-> chan frame-num) 0.0)
            )
          (let ((last (the float (+ (-> want frames num-frames) -1))))
            (set! (-> chan frame-num) (+ (-> chan frame-num) (* BF_HOVER_RATE (-> this clock time-adjust-ratio))))
            (if (>= (-> chan frame-num) last)
                (set! (-> chan frame-num) 0.0)
                )
            )
          )
        )
      )
    )
  (none)
  )
