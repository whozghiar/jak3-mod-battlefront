(define *bf-point-order-jak2* (new 'static 'array int32 13 11 14 12 10 9 15 7 13 8 16 5 6 4))

(define *bf-point-links-jak2*
  (new 'static 'array uint32 17
    #b00000000000010000  ;; Slums HQ: Hideout Slums
    #b00000000100000000  ;; Stadium HQ: South Quarter
    #b01100100000000000  ;; Port HQ: North Farms, Palace Plaza, North Industrial Zone
    #b00100000000000000  ;; Palace HQ: Palace Plaza
    #b10000000000100001  ;; Hideout Slums: Slums HQ, Fortress Slums, South Industrial Zone
    #b00000000101010000  ;; Fortress Slums: Hideout Slums, South Slums, South Quarter
