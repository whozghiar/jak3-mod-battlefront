                    "~Y<PAD_R2>~Z~+94H Boule / se relever"
                    "~Y<PAD_L1>~Z~+94H Grenades (10 par vie)"
                    )
         )
    (new 'static 'bf-class-info :name "Spider Robot" :team BF_TEAM_KG
         :desc (new 'static 'boxed-array :type string
                 "~Y<PAD_X>~Z~+94H 11 m leap"
                 "~Y<PAD_SQUARE>~Z~+94H Headbutt, shocks 2 more"
                 "~Y<PAD_R2>~Z~+94H Blue eco sprint"
                 "~Y<PAD_L1>~Z~+94H Blow up (orange gauge)"
                 )
         :name-fr "Araignée robot"
         :desc-fr (new 'static 'boxed-array :type string
                    "~Y<PAD_X>~Z~+94H Bond de 11 m"
                    "~Y<PAD_SQUARE>~Z~+94H Coup de tête électrique"
                    "~Y<PAD_R2>~Z~+94H Sprint à l'éco bleue"
                    "~Y<PAD_L1>~Z~+94H Exploser (jauge orange)"
                    )
         )
    (new 'static 'bf-class-info :name "Baron Praxis" :team BF_TEAM_KG
         :desc (new 'static 'boxed-array :type string
                 "~Y<PAD_SQUARE>~Z~+94H Sword slash"
                 "~Y<PAD_CIRCLE>~Z~+94H Sword spin"
                 "~Y<PAD_X>~Z~+94H Jump"
                 "~Y<PAD_L2>~Z~+94H White barrier, walking slowly"
                 "~Y<PAD_R2>~Z~+94H Yellow eco ball (yellow gauge)"
                 )
         :name-fr "Baron Praxis"
         :desc-fr (new 'static 'boxed-array :type string
                    "~Y<PAD_SQUARE>~Z~+94H Coup d'épée"
                    "~Y<PAD_CIRCLE>~Z~+94H Coup d'épée circulaire"
                    "~Y<PAD_X>~Z~+94H Sauter"
                    "~Y<PAD_L2>~Z~+94H Barrière blanche, marche lente"
                    "~Y<PAD_R2>~Z~+94H Boule d'éco jaune (jauge jaune)"
                    )
         )
    (new 'static 'bf-class-info :name "Ashelin" :team BF_TEAM_FF
         :desc (new 'static 'boxed-array :type string
                 "~Y<PAD_SQUARE>~Z~+94H Both pistols"
                 "~Y<PAD_TRIANGLE>~Z~+94H Reload"
                 "~Y<PAD_R1>~Z~+94H Grenade (10 a life)"
                 "~Y<PAD_CIRCLE>~Z~+94H Spinning kick"
                 "~Y<PAD_L1>~Z~+94H Kneel"
                 "~Y<PAD_R2>~Z~+24H+~Z~+37H<PAD_ANALOG_LEFT_RIGHT>~Z~+57H Side flip"
                 "~Y<PAD_X>~Z~+94H Jump, again: a flip"
                 )
         :name-fr "Ashelin"
         :desc-fr (new 'static 'boxed-array :type string
                    "~Y<PAD_SQUARE>~Z~+94H Les deux pistolets"
                    "~Y<PAD_TRIANGLE>~Z~+94H Recharger"
                    "~Y<PAD_R1>~Z~+94H Grenade (10 par vie)"
                    "~Y<PAD_CIRCLE>~Z~+94H Coup de pied circulaire"
