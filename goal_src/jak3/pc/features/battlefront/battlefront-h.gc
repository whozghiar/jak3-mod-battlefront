;; Pace of the jetpack guards' clips, in clip frames per 60th of a second. They are the Jak 2 rip's
;; frames, 15 a second (game.gp build-actor :framerate 15.0), which build-actor stores with a speed
;; of one frame per 60th (seen in game: speed 1.0). Played at that speed, the player's jetpack
;; looped its 16-frame hover clip four times a second and its legs shook; the units' own, at 0.5,
;; twice too fast.
(defconstant BF_HOVER_RATE 0.25)

;; Clip indices of the jetpack guard art groups (both share the order).
(defconstant BF_HOVER_IDLE 2)
(defconstant BF_HOVER_FLY_FORWARD 3)
(defconstant BF_HOVER_SHOOT 4)
(defconstant BF_HOVER_FLY_RIGHT 5)
(defconstant BF_HOVER_FLY_LEFT 6)
(defconstant BF_HOVER_FLY_BACK 7)
(defconstant BF_HOVER_DEATH 12)

;; ---------------------------------------------------------------------------------------------
;; State helpers
;; ---------------------------------------------------------------------------------------------

(defun bf-active? ()
  "#t from the deployment to the end of the result screen. Every hook below answers like the stock
   game while this is #f."
  (!= (-> *bf* phase) BF_PHASE_OFF)
  )

(defun bf-fighting? ()
  "#t while losses count."
  (= (-> *bf* phase) BF_PHASE_FIGHT)
  )

(defconstant BF_ROLL_SCALE 2.25) ;; the robotguards' ball rolls this much faster in a battle (1.5 from round 25, 1.5 times that from round 33)

(defun bf-roll-scale ()
  "Called by roboguard-city's roll-chase (levels/city/protect/roboguard-city.gc), which rolls the
   robot as a ball at 20 m/s: its speed scale, BF_ROLL_SCALE during a battle (the author's wish: the
   ball faster, 45 m/s since round 33), 1.0 otherwise (the stock speed)."
  (if (bf-active?) BF_ROLL_SCALE 1.0)
  )

(defconstant BF_SKY_HEIGHT (meters 30)) ;; a unit or the player brought to a control point falls from this high

(defun bf-sky-height ((ground vector))
  "How far above GROUND (a nav poly's middle) a unit or the respawned player starts its fall onto
   it: BF_SKY_HEIGHT under the open sky, else 2.5 m under the first scenery above (a platform, a
   bridge, a roof), 0 when a probe down from there, 2 m wide, still meets something more than 2 m
   over the spot (the city's floors have no underside: a probe up goes through them): the fall then
   starts on the ground. The poly's middle lies up to 1.4 m under the ground's collision (0.5 to 0.7 m in
   the streets): a probe down to 0.5 m over it met the street itself."
  (let ((cq (new 'stack-no-clear 'collide-query))
        (h BF_SKY_HEIGHT)
        )
    (vector-copy! (-> cq start-pos) ground)
    (+! (-> cq start-pos y) (meters 1))
    (set-vector! (-> cq move-dist) 0.0 (- BF_SKY_HEIGHT (meters 1)) 0.0 1.0)
    (set! (-> cq radius) (meters 0.5))
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (let ((u (fill-and-probe-using-line-sphere *collide-cache* cq)))
      (if (>= u 0.0)
          (set! h (fmax 0.0 (- (+ (meters 1) (* u (- BF_SKY_HEIGHT (meters 1)))) (meters 2.5))))
          )
      )
    (when (< (meters 2.5) h)
      ;; as wide as a spider: with a thin probe, falling spiders stopped on pipes and walkways
      ;; beside the line (6 in 14 stayed 11 m up on average)
      (set! (-> cq radius) (meters 2))
      (vector-copy! (-> cq start-pos) ground)
      (+! (-> cq start-pos y) h)
      (set-vector! (-> cq move-dist) 0.0 (- (meters 4) h) 0.0 1.0)
      (if (>= (fill-and-probe-using-line-sphere *collide-cache* cq) 0.0)
          (set! h 0.0)
          )
      )
    h
    )
  )

;; The units the control points brought down from the sky (levels/city/battlefront/battlefront-city.gc
;; `bf-city-spawn-near`), the last BF_SKY_LOG, for the tests (docs/modding/current_mod/battlefront_smoke.gc).
(defconstant BF_SKY_LOG 64)

(deftype bf-sky-log (structure)
  "Each unit's handle, traffic type, the nav poly's middle it falls onto, and the height it starts
   from; COUNT units logged in all, the last at (COUNT - 1) mod BF_SKY_LOG."
  ((count   int32)
   (unit    handle BF_SKY_LOG)
   (kind    int32  BF_SKY_LOG)
   (ground  vector BF_SKY_LOG :inline)
   (height  float  BF_SKY_LOG)
   )
  )

(define *bf-sky-log* (new 'static 'bf-sky-log))

(defun bf-set-phase! ((phase int))
  "Enter PHASE and stamp its start time."
  (set! (-> *bf* phase) phase)
  (set! (-> *bf* phase-time) (current-time))
  (none)
  )

(defun bf-other-team ((team int))
  "The opposite side of TEAM."
  (if (= team BF_TEAM_FF) BF_TEAM_KG BF_TEAM_FF)
  )

(defun bf-art-name ((proc process))
  "Name of the joint geometry (the skeleton, named <art group>-lod0) PROC draws, or \"\" when it has
   no draw-control yet. A unit is told by its skeleton, not by its art group: a red guard plays the
   blue guard's clips, from crimson-guard-ag (`bf-guard-clips`)."
  (let ((pd (the-as process-drawable proc)))
    (if (and (type? proc process-drawable) (nonzero? (-> pd draw)) (-> pd draw) (-> pd draw jgeo))
        (-> pd draw jgeo name)
        ""
        )
    )
  )

(defun bf-red-guard? ((proc process))
  "#t when PROC is a crimson-guard drawn with one of the red Jak 2 models."
  (and (= (-> proc type symbol) 'crimson-guard)
       (let ((name (bf-art-name proc)))
         (or (string= name "bf-red-guard-lod0") (string= name "bf-red-guard-gl-lod0"))
         )
       )
  )

(defun bf-guard-clips ((this process-drawable))
  "Called right after a red guard's skeleton is set up (guard.gc init-enemy!, and the red guard
   class's avatar): it plays the blue guard's clips. Its model is Jak 2's on Jak 3's 41-joint guard
   skeleton (the same joints and bind pose), so its draw takes crimson-guard-ag, when that art group
   is in its level, as the art group its clips (and their sound and death effects) are looked up
   in; its own meshes stay. The model's own clips (build-actor, 15 frames a second) ran too fast;
   these run at the blue guard's pace. The effects need an effect-control, which a process only gets
   when its model has an effect-name lump (effect-control's new), and a build-actor model has none:
   it gets one, made like effect-control's new does. The method comes from the mod Haven City: New
   Dawn. Returns nothing. Side effects: the draw-control's art-group, the skeleton's effect-control
   (process heap). Round 46: the blue robotguard and spider robot play the stock roboguard-city's
   and spydroid's clips the same way."
  (let ((stock (let ((name (bf-art-name this)))
                 (cond
                   ((or (string= name "bf-red-guard-lod0") (string= name "bf-red-guard-gl-lod0")) "crimson-guard")
                   ;; round 46: the blue robotguard and spider play the stock ones' clips
                   ((string= name "bf-robot-blue-lod0") "roboguard-city")
                   ((string= name "bf-spider-blue-lod0") "spydroid")
                   (else (the-as string #f))
                   )
                 )
               )
        )
    (when (and (-> this level) stock)
      (let ((ag (load-to-heap-by-name (-> this level art-group) stock 'test global 0)))
        (when (and ag
                   (= (-> ag type) art-group)
                   (= (-> (the-as art-joint-geo (-> ag data 0)) length) (-> this draw jgeo length))
                   )
          (set! (-> this draw art-group) ag)
          (when (not (-> this skel effect))
            (let ((ec (the-as effect-control ((method-of-type object new) 'process effect-control (the-as int (-> effect-control size))))))
              (set! (-> ec process) this)
              (set! (-> ec last-frame-group) #f)
              (set! (-> this skel effect) ec)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-custom-model? ((proc process))
  "#t when PROC draws one of the mod's build-actor models (the red guards, the jetpack guards)."
  (let ((name (bf-art-name proc)))
    (or (string= name "bf-red-guard-lod0")
        (string= name "bf-red-guard-gl-lod0")
        (string= name "bf-hover-red-lod0")
        (string= name "bf-hover-blue-lod0")
        )
    )
  )

(define-extern bf-fizz-start! (function process-drawable symbol))

;; Stock effect step, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-do-effect* (function effect-control string float int none)
             (method-of-type effect-control do-effect)
             )

;; For the tests: Jak's effects and sounds printed while on (`do-effect`, battlefront.gc
;; `sound-play-by-name`).
(define *bf-log-sounds* #f)

(defmethod do-effect ((this effect-control) (arg0 string) (arg1 float) (arg2 int))
  "Every effect of a clip goes through here (effect-control.gc). A death effect (death-default and
   the other death-* effects) is skipped for the mod's build-actor models (`bf-custom-model?`): it
   sets the draw-control's death-timer, which makes the PC renderer draw the model through generic
   merc (foreground.gc, the PC reassign), and a build-actor model has only a dummy merc-ctrl there
   (goalc/build_actor/jak3/build_actor.cpp): mercneric_convert reads its dummy fragments (seen in
   game: crashes in mercneric_convert, mips2c generic_merc.cpp, seconds into battles, as units
   died). The red guards play the blue guard's clips, effects included
   (`bf-guard-clips`): their 'event-death runs death-default (guard.gc). The body then goes with
   its death clip, without the dissolve (Lisp wiki jak3 4.35). Every other effect: the stock step."
  (let ((name (cond
                ((= (rtype-of arg0) symbol) (symbol->string (the-as symbol arg0)))
                ((= (rtype-of arg0) string) arg0)
                (else (the-as string #f))
                )
              )
        )
    (if (and *bf-log-sounds* (= (-> this process) *target*))
        (format 0 "SMOKE jak effect ~A~%" (if name name arg0))
        )
    (cond
      ((and name (= (-> this process) *target*) (string-prefix= "breath" name) (bf-fighting?) (!= (-> *bf* class) BF_CLASS_JAK))
       ;; Jak's breaths and grunts (breath-in-loud, breath-out-loud, his clips' effects): his voice
       ;; as a hit lands, not his class's (round 29's tests); his class cries instead
       ;; (battlefront.gc `bf-class-hit-cry`)
       (none)
       )
      ((and name (string-prefix= "death-" name) (-> this process) (bf-custom-model? (-> this process)))
       ;; a red guard of the battle dissolves as the blue ones do, in the dissolve's sparks
       ;; (`bf-fizz-start!`; the author's wish, round 28: its body stayed until the pool took it)
       (if (= (-> this process type symbol) 'crimson-guard)
           (bf-fizz-start! (the-as process-drawable (-> this process)))
           )
       )
      (else
        (*bf-stock-do-effect* this arg0 arg1 arg2)
        )
      )
    )
  (none)
  )

;; The red guards' death: the blue guards' dissolve (the death-default effect, merc-death.gc), which
;; a build-actor model cannot take (`do-effect`), made of its purple sparks (Lisp wiki jak3 4.35).
(defconstant BF_FIZZ_MAX 16)
(defconstant BF_FIZZ_SPARKS 6)             ;; sparks a frame from a dissolving red guard
(defconstant BF_FIZZ_HIDE (seconds 1.25))  ;; its body hidden then: death-default's 75 frames
(defconstant BF_FIZZ_TIME (seconds 1.75))  ;; and let go then

(deftype bf-fizz (structure)
  "The red guards dissolving (`bf-fizz-start!`, `bf-fizz-tick`)."
  ((unit  handle     BF_FIZZ_MAX)
   (time  time-frame BF_FIZZ_MAX)
   )
  )

(define *bf-fizz* (new 'static 'bf-fizz))

;; no unit yet: a 0 handle is read as a process at address 0 and crashes (Lisp wiki common.md, `handle->process`)
(dotimes (i BF_FIZZ_MAX)
  (set! (-> *bf-fizz* unit i) (the-as handle #f))
  )

(defun bf-fizz-sparks ((proc process-drawable) (n int))
  "N purple sparks of the game's dissolve from as many joints of PROC drawn at random, each up to
   0.4 m off it: part 53, launched as the dissolve launches it from the model's vertices
   (merc-death.gc `merc-death-spawn`: `sp-launch-particles-death` in the 2D particle system).
   Launched with `launch-particles` (round 28) they showed as a few pale discs, the blue guards'
   dissolve as a purple cloud (round 29's films). Side effects: particles."
  (let ((joints (-> proc node-list length))
        (pos (new 'stack-no-clear 'vector))
        (part (-> *part-id-table* 53))
        )
    (when (and (< 2 joints) (nonzero? part))
      (dotimes (k n)
        (vector<-cspace! pos (-> proc node-list data (+ 1 (rand-vu-int-count (+ joints -1)))))
        (+! (-> pos x) (* (meters 0.4) (+ -1.0 (* 2.0 (rand-vu)))))
        (+! (-> pos y) (* (meters 0.4) (+ -1.0 (* 2.0 (rand-vu)))))
        (+! (-> pos z) (* (meters 0.4) (+ -1.0 (* 2.0 (rand-vu)))))
        (sp-launch-particles-death *sp-particle-system-2d* part pos)
        )
      )
    )
  (none)
  )

(defun bf-fizz-start! ((proc process-drawable))
  "Called by `do-effect` for a red guard's death effect, skipped: PROC dissolves in sparks
   (`bf-fizz-tick`), with the dissolve's sound (enemy-fizz). Returns #t when it starts, #f when it
   dissolves already or no room is left."
  (let ((h (process->handle proc))
        (now (-> *display* game-clock frame-counter))
        )
    (dotimes (i BF_FIZZ_MAX)
      (if (= (-> *bf-fizz* unit i) h)
          (return #f)
          )
      )
    (dotimes (i BF_FIZZ_MAX)
      (when (not (handle->process (-> *bf-fizz* unit i)))
        (set! (-> *bf-fizz* unit i) h)
        (set! (-> *bf-fizz* time i) now)
        (sound-play "enemy-fizz" :position (-> proc root trans))
        (return #t)
        )
      )
    )
  #f
  )

(defun bf-fizz-tick ()
  "Every frame of a battle (the director): each red guard dissolving (`*bf-fizz*`) launches
   BF_FIZZ_SPARKS sparks a frame (`bf-fizz-sparks`) until BF_FIZZ_HIDE, when its body is hidden;
   let go at BF_FIZZ_TIME, or at once once it is no longer dead (its pool woke it again: its reset,
   citizen.gc citizen-method-194, shows it again)."
  (let ((now (-> *display* game-clock frame-counter)))
    (dotimes (i BF_FIZZ_MAX)
      (let ((p (the-as process-focusable (handle->process (-> *bf-fizz* unit i)))))
        (when p
          (let ((t (- now (-> *bf-fizz* time i))))
            (cond
              ((or (>= t BF_FIZZ_TIME) (not (focus-test? p dead)))
               (set! (-> *bf-fizz* unit i) (the-as handle #f))
               )
              ((< t BF_FIZZ_HIDE)
               (bf-fizz-sparks p BF_FIZZ_SPARKS)
               )
              (else
                (logior! (-> p draw status) (draw-control-status no-draw))
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-reload-break-ok? ((this process-drawable))
  "Called by guard-grenade.gc grenade-throw-post-reloading's trans before a grenade guard breaks off
   its reload because its target came close. During a battle it breaks it off only for the player:
   against another guard it finishes reloading. With a guard as its target within half its
   keep-away distance, the reload, the backing away and the grenade state chained within one frame,
   a new reload grenade each time, until the stack overflowed and the game crashed (Lisp wiki jak3
   4.40, seen in the mod Haven City: New Dawn). #t out of a battle. No side effects."
  (or (not (bf-active?)) (= (handle->process (-> (the-as enemy this) focus handle)) *target*))
  )

(defun bf-hover-art? ((proc process))
  "#t when PROC draws one of the two jetpack guard models."
  (let ((name (bf-art-name proc)))
    (or (string= name "bf-hover-red-lod0") (string= name "bf-hover-blue-lod0"))
    )
  )

(defun bf-hover-nozzle! ((this process-drawable) (pos vector) (dir vector) (side int))
  "Called by flying-turret-method-229 (flying-turret.gc) before each of its two thruster flames. A
   jetpack guard's flame comes out of its jetpack's turbine, node 15 (SIDE 0, Lturbine) or 17 (SIDE
   1, Rturbine) of the Jak 2 hover guard model, along the joint's -z axis, not from the turret's
   spots under its root (the mod Haven City: New Dawn's fix for the same model). POS, DIR: set to
   the joint's place and that axis. Returns #t when it set them, #f (both unchanged) for a stock
   flying turret, 'hide for a model not drawn: its joints were not moved since it was last drawn
   (no-draw: knocked down, or hidden as it wakes; no-draw-temp: past the units drawn at once,
   battlefront-city.gc `bf-city-draw-cap`), and its flames stayed in the air alone where it was
   (the author's report, round 45): no flame then."
  (cond
    ((and (bf-hover-art? this) (logtest? (-> this draw status) (draw-control-status no-draw no-draw-temp)))
     'hide
     )
    ((bf-hover-art? this)
     (let ((joint (-> this node-list data (if (zero? side) 15 17))))
       (vector<-cspace! pos joint)
       ;; straight down under the turbine (the author's wish, round 29: along the joint's -z they
       ;; pointed back)
       (set-vector! dir 0.0 -1.0 0.0 1.0)
       )
     #t
     )
    (else
      #f
      )
    )
  )

(defun bf-blue-bot? ((proc process))
  "#t when PROC draws the Freedom League's blue robotguard or spider robot (round 46)."
  (let ((name (bf-art-name proc)))
    (or (string= name "bf-robot-blue-lod0") (string= name "bf-spider-blue-lod0"))
    )
  )

(define-extern bf-boss-team (function process int))

(defun bf-unit-team ((proc process))
  "Side of a unit, BF_TEAM_NONE for anything that does not fight in the battle."
  (let ((sym (-> proc type symbol)))
    (cond
      ((= proc *target*) (-> *bf* team))
      ((= sym 'crimson-guard) (if (bf-red-guard? proc) BF_TEAM_KG BF_TEAM_FF))
      ((= sym 'flying-turret) (if (string= (bf-art-name proc) "bf-hover-blue-lod0") BF_TEAM_FF BF_TEAM_KG))
      ((or (= sym 'roboguard-city) (= sym 'spydroid)) (if (bf-blue-bot? proc) BF_TEAM_FF BF_TEAM_KG))
      ;; a side's champion (round 49: Baron Praxis; round 53: Ashelin, battlefront-baron.gc)
      ((or (= sym 'bf-boss-body) (= sym 'bf-boss)) (bf-boss-team proc))
      (else BF_TEAM_NONE)
      )
    )
  )

;; ---------------------------------------------------------------------------------------------
;; The guards' reloads (round 46)
;; ---------------------------------------------------------------------------------------------

;; The stock rifle guard plays its reload between two bursts of 1 to 3 shots (guard-rifle.gc
;; rifle-hostile, while its last shot is under 2.5 to 4.5 s old), loops it while its foe is dead,
;; and gets 3 rounds back from each; the grenade guard plays its own each time it stands at its
;; spot (guard-grenade.gc grenade-hostile). In a battle the guards were seen reloading most of the
;; time (the author's report, round 46).

(defun bf-guard-hold? ((this process) (ammo int))
  "Called by guard-rifle.gc rifle-hostile and guard-grenade.gc grenade-hostile where the stock guard
   THIS would reload with AMMO rounds left: #t when it keeps its ground instead, a battle's guard
   with rounds left. Its next burst comes when the stock pause is over; it reloads once empty. #f
   out of a battle. No side effects."
  (and (bf-active?) (>= (bf-unit-team this) 0) (> ammo 0))
  )

(defun bf-guard-calm! ((this process) (full? symbol))
  "Called by guard-rifle.gc rifle-hostile when rifle guard THIS has no foe left, where the stock
   guard reloads, again and again until it gets one. #t when a battle's guard with its magazine
   full (FULL?) walks its lanes again instead: its focus is cleared (the caller then goes to
   'active, as `bf-city-robot-free` sends the robotguards). #f, nothing changed, out of a battle or
   with rounds to reload."
  (when (and full? (bf-active?) (>= (bf-unit-team this) 0))
    (set! (-> (the-as enemy this) focus handle) (the-as handle #f))
    #t
    )
  )

(defun bf-melee-ok? ((this process))
  "Called where a guard (guard-rifle.gc, guard-grenade.gc, guard-tazer.gc, guard-states.gc,
   guard.gc) or a robotguard (roboguard-city.gc roboguard-city-method-236) THIS would deal a blow at
   close range (a rifle butt, a robotguard's punch): #f for a battle's unit, which keeps to its gun
   (the author's wish, round 52: no blows but the champion's and the spider robots'); #t, the stock
   blow, otherwise. No side effects."
  (not (and (bf-active?) (>= (bf-unit-team this) 0)))
  )

;; For the tests (docs/modding/current_mod/battlefront_smoke.gc): #t, the battle's guards fire as
;; the stock ones (`bf-guard-drill?`), to compare.
(define *bf-guard-stock-fire* #f)

(defun bf-guard-drill? ((this process))
  "Called by guard-rifle.gc gun-shoot and rifle-hostile: #t when rifle guard THIS fires by the
   battle's drill (the author's report, round 52: the guards fired too often, and before their
   rifle was up): a burst of one or two shots, not up to three; a pause of 4.5 to 6.5 s between two
   bursts (`bf-guard-pause`), which the stock guard skips in its faction's war mode; before its
   first shot it aims 0.3 s, its rifle shouldered, turning to face its foe, and holds each shot's
   pose until the clip's blend is over; no shot at a foe more than 20 degrees off its way. #f out
   of a battle (or `*bf-guard-stock-fire*`). No side effects."
  (and (bf-active?) (>= (bf-unit-team this) 0) (not *bf-guard-stock-fire*))
  )

(defconstant BF_GUARD_PAUSE_MORE (seconds 2)) ;; a battle's guard waits this much longer between two bursts

(defun bf-guard-pause ((this process) (stock time-frame))
  "Called by guard-rifle.gc rifle-hostile: rifle guard THIS's pause between two bursts, STOCK (2.5
   to 4.5 s) and BF_GUARD_PAUSE_MORE under the battle's drill (`bf-guard-drill?`), STOCK otherwise."
  (if (bf-guard-drill? this)
      (+ stock BF_GUARD_PAUSE_MORE)
      stock
      )
  )

;; For the tests: the battle's guards' shots, [0] all, [1] those fired more than 20 degrees off
;; their foe's way (`bf-guard-shot!`).
(define *bf-guard-shots* (new 'static 'array int32 2 0 0))

(defun bf-guard-shot! ((this process) (angle float))
  "Called by guard-rifle.gc gun-shoot as rifle guard THIS fires, ANGLE its foe's way off its
   facing: counted in `*bf-guard-shots*` for a battle's guard. Returns nothing."
  (when (and (bf-active?) (>= (bf-unit-team this) 0))
    (+! (-> *bf-guard-shots* 0) 1)
    (if (< (degrees 20) (fabs angle))
        (+! (-> *bf-guard-shots* 1) 1)
        )
    )
  (none)
  )

(defun bf-guard-reload-count ((this process) (n int))
  "Called by guard.gc crimson-guard-method-285, which adds N rounds to guard THIS's magazine (N
   negative for a shot): a battle's guard reloading (N positive) fills it, 3 rounds a reload for
   the stock rifle guard. N otherwise."
  (if (and (> n 0) (bf-active?) (>= (bf-unit-team this) 0))
      100
      n
      )
  )

;; ---------------------------------------------------------------------------------------------
;; Health and damage on one 24 point scale
;; ---------------------------------------------------------------------------------------------

;; During a fight every unit and every class has its health on one scale, 24 points for a guard, and
;; every weapon takes the same points from any of them: the stock hit points of each unit type and
;; the stock damage of each weapon differ (a guard 4, a flying turret 1, a shot 1, a grenade 6).
(defconstant BF_DMG_RIFLE 8.0)        ;; a rifle shot (the guards', the player guard's)
(defconstant BF_DMG_GRENADE 20.0)     ;; a guard grenade's blast
(defconstant BF_GRENADE_BLAST (meters 8)) ;; the player guard's grenade blast radius: twice the stock 4 m (round 44)
(defconstant BF_DMG_TAZER 24.0)       ;; the player guard's tazer strike
(defconstant BF_DMG_MELEE 10.0)       ;; a rifle butt, a robotguard's punch, a jetpack's dive kick
(defconstant BF_DMG_BITE 12.0)        ;; a spider robot's bite
(defconstant BF_DMG_ROBOT_SHOT 4.0)   ;; a robotguard's shot
(defconstant BF_DMG_PISTOL 4.0)       ;; a shot of Ashelin's pistols (round 53, battlefront-ashelin.gc)
(defconstant BF_DMG_JET_SHOT 6.0)     ;; a jetpack guard's shot
(defconstant BF_DMG_ECO_BALL 24.0)    ;; the Baron's yellow eco ball and its burst (round 44): a whole guard
(defconstant BF_DMG_NOVA 24.0)        ;; the player spider's blast (L1, round 38): a whole unit, as the Super Nova kills

;; Full health of each class, indexed by BF_CLASS_*: guards and robotguard 24, jetpacks 18, spider 12.
(define *bf-class-hp* (new 'static 'array float 10 24.0 18.0 24.0 24.0 24.0 18.0 24.0 12.0 36.0 36.0))

(defun bf-class-health ((class int))
  "Jak's health for CLASS's full health: his whole health bar (fact health-max, the health ring's
   segments) stands for the class's own points (`*bf-class-hp*`: 24, 18 or 12), so every class
   starts with a full ring (round 31: the spider robot's half ring read as damage at each spawn);
   `bf-class-points` turns points into segments. Needs *target*."
  (-> *target* fact health-max)
  )

(defun bf-class-points ((class int) (points float))
  "Jak's health for POINTS of CLASS's (`bf-class-health`): a hit or a health pack on the battle's
   points, in the ring's segments. Needs *target*."
  (* points (/ (-> *target* fact health-max) (-> *bf-class-hp* class)))
  )

(defun bf-unit-hp ((proc process))
  "Full health of PROC on the 24 point scale: guards and robotguards 24, jetpack guards 18, spider
   robots 12 (the classes' own), the player's class for Jak, 0.0 for anything else."
  (let ((sym (-> proc type symbol)))
    (cond
      ((= proc *target*) (-> *bf-class-hp* (-> *bf* class)))
      ((or (= sym 'crimson-guard) (= sym 'roboguard-city)) 24.0)
      ((= sym 'flying-turret) 18.0)
      ((= sym 'spydroid) 12.0)
      (else 0.0)
      )
    )
  )

(defun bf-shot-damage ((owner process))
  "Damage of a guard-shot fired for OWNER: the player's class's gun (rifle, robotguard, jetpack:
   the avatar fires guard-shots for all three), a guard's rifle for any unit."
  (cond
    ((= owner *target*)
     (case (-> *bf* class)
       ((BF_CLASS_ROBOGUARD) BF_DMG_ROBOT_SHOT)
       ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) BF_DMG_JET_SHOT)
       ((BF_CLASS_ASHELIN) BF_DMG_PISTOL)
       (else BF_DMG_RIFLE)
       )
     )
    ;; the Freedom League's champion's pistols (round 53); the Baron fires none
    ((and owner (= (-> owner type symbol) 'bf-boss-body)) BF_DMG_PISTOL)
    (else BF_DMG_RIFLE)
    )
  )

;; The points of the Krimzon Guard's champion's blow being sent (battlefront-baron.gc
;; `bf-boss-send-attack`, round 49), read by `bf-attack-damage`.
(define *bf-boss-attack* 0.0)

(defconstant BF_PLAYER_DAMAGE 2.0) ;; the player's shots and blows on units deal this many times a unit's (`damage-enemy-from-attack!`)

(defun bf-attack-damage ((sender process) (owner process))
  "Damage, on the 24 point scale, of an attack that SENDER sent for OWNER (the attacker: a shot's or
   a blast's owner), -1.0 to leave it to the stock rules. Told by the sender's type. The player's own
   attacks carry theirs (`*bf*` own-attack, set while `bf-send-attack` sends them); any other blow
   of Jak's body (running or jumping into a unit) deals none."
  (let ((sym (if sender (-> sender type symbol) #f)))
    (cond
      ((not sender) -1.0)
      ((= sender *target*) (fmax 0.0 (-> *bf* own-attack)))
      ((or (= sym 'guard-shot) (= sym 'guard-lazer-shot)) (bf-shot-damage owner))
      ((= sym 'roboguard-shot) BF_DMG_ROBOT_SHOT)
      ((= sym 'flying-turret-shot) BF_DMG_JET_SHOT)
      ((or (= sym 'explosion) (= sym 'vehicle-grenade) (= sym 'vehicle-grenade-deflect)) BF_DMG_GRENADE)
      ;; a jetpack guard's rocket, its hit and its blast (battlefront-player.gc `bf-rocket`)
      ;; and a robotguard's grenade (round 38, `bf-grenade`)
      ((or (= sym 'bf-rocket) (= sym 'bf-grenade) (= sym 'bf-lob)) BF_DMG_GRENADE)
      ;; the Baron's yellow eco ball (round 44, battlefront-baron.gc `bf-eco-ball`)
      ((= sym 'bf-eco-ball) BF_DMG_ECO_BALL)
      ((= sym 'spydroid) BF_DMG_BITE)
      ;; the Krimzon Guard's champion's sword (round 49)
      ((= sym 'bf-boss-body) *bf-boss-attack*)
      ((or (= sym 'crimson-guard) (= sym 'roboguard-city) (= sym 'flying-turret)) BF_DMG_MELEE)
      (else -1.0)
      )
    )
  )

;; Stock ground snap of the enemies, kept the same way.
(define-perm *bf-stock-move-to-ground* (function enemy meters meters symbol collide-spec symbol)
             (method-of-type enemy move-to-ground)
             )

(defmethod move-to-ground ((this enemy) (arg0 meters) (arg1 meters) (arg2 symbol) (arg3 collide-spec))
  "Every enemy's snap to the ground under it (enemy.gc; a city unit's wake, citizen.gc
   'traffic-activate). The stock step, which prints a warning when it finds no ground within ARG0 up
   and ARG1 down with ARG2: during a fight, never for a unit of the battle. The robotguards and the
   spiders wake in the sky over their nav poly, up to 30 m, or in a ship's hatch, and fall from
   there (battlefront-city.gc `bf-city-spawn-near`): 317 such lines in a five-minute battle of 200
   a side (round 45, the author's report of the log). Returns #t when it found the ground. Defined
   on enemy: GAME links with method-set propagation on, and the level code's units copy it at their
   creation (Lisp wiki jak3 4.10)."
  (*bf-stock-move-to-ground* this arg0 arg1 (and arg2 (not (and (bf-fighting?) (>= (bf-unit-team this) 0)))) arg3)
  )

;; Stock damage step of the city's units, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-damage-enemy* (function nav-enemy object event-message-block float)
             (method-of-type nav-enemy damage-enemy-from-attack!)
             )

(define-extern bf-hit-note! (function process process none))

(defmethod damage-enemy-from-attack! ((this nav-enemy) (arg0 object) (arg1 event-message-block))
  "Every attack on a nav-enemy takes its hit points here (enemy.gc enemy-event-handler; the guards'
   own step calls it after its alert). During a fight, for a unit of the battle (`bf-unit-hp`), the
   attack's points on the 24 point scale (`bf-attack-damage`) become the same share of the unit's
   stock hit points (enemy-info default-hit-points, which caps them first: a guard's 'victory
   raises them); its own side's fire takes none; a kill of the player's counts in `*bf*` kills.
   Anything else: the stock step. Defined on nav-enemy, the parent of every unit of the battle
   (citizen and its children, in level code linked after GAME, which copy it at their creation);
   GAME links with method-set propagation on (kmachine.cpp), so nav-enemy's own children in GAME
   take it too (Lisp wiki jak3 4.10). Returns the hit points taken."
  (let* ((sender (the-as process arg0))
         (owner (handle->process (-> this incoming attacker-handle)))
         (full (if (bf-fighting?) (bf-unit-hp this) 0.0))
         (dmg (if (< 0.0 full) (bf-attack-damage sender owner) -1.0))
         )
    (cond
      ((< dmg 0.0)
       (*bf-stock-damage-enemy* this arg0 arg1)
       )
      (else
        (if (and owner (>= (bf-unit-team owner) 0) (= (bf-unit-team owner) (bf-unit-team this)))
            (set! dmg 0.0)
            )
        ;; a foe's hit, kept (`bf-hit-note!`): a spider's kill leaves blue eco (`bf-queue-drop`)
        (if (and owner (< 0.0 dmg))
            (bf-hit-note! this owner)
            )
        ;; the player's shots and blows deal BF_PLAYER_DAMAGE times a unit's (the author's wish, round 29)
        (if (= owner *target*)
            (set! dmg (* BF_PLAYER_DAMAGE dmg))
            )
        (let ((max-hp (-> this enemy-info default-hit-points))
              (was-fated? (nonzero? (-> this fated-time)))
              )
          (set! (-> this hit-points) (fmin (-> this hit-points) max-hp))
          (let ((taken (apply-incoming-hitpoint-mods this (* max-hp (/ dmg full)))))
            (set! (-> this hit-points) (- (-> this hit-points) taken))
            (if (not (logtest? (-> this enemy-flags) (enemy-flag auto-reset-penetrate)))
                (set! (-> this root penetrated-by) (get-penetrated-by this))
                )
            ;; the player's kill: the hit that empties the unit, or the one that fates it. A lethal
            ;; blue shot (the tazer, the spider's shock) leaves 1 point and sets `fated-time`
            ;; (apply-incoming-hitpoint-mods), and the knocked state then kills the unit by itself
            ;; (enemy-states.gc, hit points set to 0), with no hit to count: counted here, once
            ;; (round 38: the spider's shocked foes died, none counted, seen in game)
            (if (and (< 0.0 taken)
                     (= owner *target*)
                     (not was-fated?)
                     (or (>= 0.0 (-> this hit-points)) (nonzero? (-> this fated-time)))
                     )
                (+! (-> *bf* kills) 1)
                )
            taken
            )
          )
        )
      )
    )
  )

;; Stock reaction step of the city's units, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-attack-msg* (function nav-enemy process event-message-block float symbol)
             (method-of-type nav-enemy msg-for-incoming-attack)
             )

(defmethod msg-for-incoming-attack ((this nav-enemy) (arg0 process) (arg1 event-message-block) (arg2 float))
  "The reaction to an attack (enemy.gc enemy event handler, after `damage-enemy-from-attack!`): during
   a fight, a unit of the battle hit by its own side (the attacker the handler has just found,
   `incoming attacker-handle`) does not react at all (#f): its damage was already none, but the hit
   still knocked it, and a knocked flying turret explodes (flying-turret.gc 'knocked): the Freedom
   League's jetpack guards all died that way, 74 in 90 s (round 46, scenario 132: blue guards'
   shots and blue robots' and spiders' blasts). Otherwise the stock reaction. Defined on nav-enemy
   as the damage step is: citizen and roboguard-city (level code) call it as their parent method."
  (let ((owner (handle->process (-> this incoming attacker-handle))))
    (if (and (bf-fighting?) owner (>= (bf-unit-team this) 0) (= (bf-unit-team owner) (bf-unit-team this)))
        #f
        (*bf-stock-attack-msg* this arg0 arg1 arg2)
        )
    )
  )

(defun bf-guard-weapon ((proc process) (want int))
  "Called by guard.gc crimson-guard-method-267 (every weapon change of a guard) and -270 (its
   off-screen change): the guard-type a guard of a battle gets for WANT. No unit of the battle has
   the tazer: a red guard carries its model's weapon (the rifle, or the launcher of
   bf-red-guard-gl), a blue guard the rifle or, one in four by a hash of its pid (for good), the launcher, in
   place of the tazer, the rifle or the launcher the squads give it (mostly the tazer; the launcher
   alone left no rifle among them, seen in game; one in two by pid gave launchers to most of them,
   the author's report, round 46), and the rifle in place of a vehicle gunner's type (Lisp wiki jak3
   4.37: a guard on foot with another type deactivates itself). WANT out of a battle."
  (let ((name (bf-art-name proc)))
    (cond
      ((not (bf-active?)) want)
      ((string= name "bf-red-guard-lod0") (the-as int (guard-type rifle)))
      ((string= name "bf-red-guard-gl-lod0") (the-as int (guard-type grenade)))
      ((or (= want (the-as int (guard-type tazer)))
           (= want (the-as int (guard-type rifle)))
           (= want (the-as int (guard-type grenade)))
           )
       ;; one in four by a hash of its pid (its two low bits gave a third, scenario 130: the pids of
       ;; a pool's guards do not run one by one)
       (the-as int (if (zero? (shr (logand (* (-> proc pid) #x9e3779b1) #xffffffff) 30)) (guard-type grenade) (guard-type rifle)))
       )
      (else (the-as int (guard-type rifle)))
      )
    )
  )

(defun bf-unlimited? ()
  "#t when the battle's units per side are unlimited (the setup's Unlimited, round 44: `*bf*`
   reserve-max 0): no reserve runs out, losses are only counted."
  (zero? (-> *bf* reserve-max))
  )

(defun bf-count-loss ((team int))
  "One unit of TEAM is lost: take it from the reserve, and end the battle when the reserve is empty
   (with unlimited units, `bf-unlimited?`, only counted). No-op outside the fight phase."
  (when (and (bf-fighting?) (>= team 0) (< team BF_TEAM_COUNT))
    (+! (-> *bf* losses team) 1)
    (when (and (not (bf-unlimited?)) (zero? (set! (-> *bf* reserve team) (max 0 (+ (-> *bf* reserve team) -1)))))
      (set! (-> *bf* winner) (bf-other-team team))
      (bf-set-phase! BF_PHASE_OVER)
      )
    )
  (none)
  )

(defun bf-unit-brought! ((team int))
  "One unit of side TEAM came onto the field (a ship's drop, a fall from the sky at a control point):
   counted in `*bf*` spawned (`bf-ships-gone?`)."
  (if (and (>= team 0) (< team BF_TEAM_COUNT))
      (+! (-> *bf* spawned team) 1)
      )
  (none)
  )

(defun bf-ships-gone? ((team int))
  "#t once side TEAM's troop transports brought as many units as it has (the setup's units per side,
   `*bf*` reserve-max; never with unlimited units): its ships leave for good, and its headquarters
   are no longer a place to come down, its units and its player coming down only at the control
   points it holds (round 44, the author's wish)."
  (and (>= team 0) (< team BF_TEAM_COUNT)
       (not (bf-unlimited?))
       (>= (-> *bf* spawned team) (-> *bf* reserve-max))
       )
  )

(defun bf-point-spawn-ok? ((i int) (team int))
  "#t when side TEAM may come down at point I: it holds it, and a headquarters only while its ships
   come (`bf-ships-gone?`) and its own ship has not left for good (`ship-done?`, round 45)."
  (and (>= i 0) (< i (-> *bf* point-count))
       (= (-> *bf* points i owner) team)
       (or (not (-> *bf* points i base?))
           (and (not (bf-ships-gone? team)) (not (-> *bf* points i ship-done?)))
           )
       )
  )

;; The foe that last hit each unit (round 44): a unit a spider killed leaves blue eco
;; (`bf-queue-drop`). By process id; a slot shared by two units holds the last one hit.
(defconstant BF_HIT_SLOTS 512)

(deftype bf-hits (structure)
  ((unit  handle     BF_HIT_SLOTS)
   (by    handle     BF_HIT_SLOTS)
   (time  time-frame BF_HIT_SLOTS)
   )
  )

(define *bf-hits* (new 'static 'bf-hits))
;; no unit yet: a 0 handle names process 0 (Lisp wiki common.md)
(dotimes (i BF_HIT_SLOTS)
  (set! (-> *bf-hits* unit i) (the-as handle #f))
  (set! (-> *bf-hits* by i) (the-as handle #f))
  )

(defun bf-hit-note! ((unit process) (by process))
  "UNIT was just hit by BY: kept in `*bf-hits*` with the game clock."
  (let ((k (logand (-> unit pid) (+ BF_HIT_SLOTS -1))))
    (set! (-> *bf-hits* unit k) (process->handle unit))
    (set! (-> *bf-hits* by k) (process->handle by))
    (set! (-> *bf-hits* time k) (-> *display* game-clock frame-counter))
    )
  (none)
  )

(defun bf-hit-by ((unit process) (within time-frame))
  "The foe that hit UNIT last, if within WITHIN of the game clock and still there; #f for none."
  (let ((k (logand (-> unit pid) (+ BF_HIT_SLOTS -1))))
    (if (and (= (-> *bf-hits* unit k) (process->handle unit))
             (< (- (-> *display* game-clock frame-counter) (-> *bf-hits* time k)) within)
             )
        (handle->process (-> *bf-hits* by k))
        )
    )
  )

;; ---------------------------------------------------------------------------------------------
;; Functions called by stock level code (each a `;; MOD battlefront` line in the stock file)
;; ---------------------------------------------------------------------------------------------

;; Live units of each look: blue guard, red rifleman, red grenadier, blue jetpack, red jetpack, and
;; since round 46 blue and red robotguard, blue and red spider robot.
;; Counted by the director every frame of a battle (`bf-count-looks!`, in its own process), and
;; raised by the two functions below for each unit they hand a look to, so that a pool spawning
;; several units in one frame stays balanced.
(defconstant BF_LOOK_BLUE 0)
(defconstant BF_LOOK_RED 1)
(defconstant BF_LOOK_RED_GL 2)
(defconstant BF_LOOK_JET_BLUE 3)
(defconstant BF_LOOK_JET_RED 4)
(defconstant BF_LOOK_ROBOT_BLUE 5)
(defconstant BF_LOOK_ROBOT_RED 6)
(defconstant BF_LOOK_SPIDER_BLUE 7)
(defconstant BF_LOOK_SPIDER_RED 8)
(defconstant BF_LOOK_COUNT 9)
(define *bf-looks* (new 'static 'array int32 9 0 0 0 0 0 0 0 0 0))

(defun bf-count-looks! ()
  "Count the live guards and jetpack guards of each look into `*bf-looks*`. Called by the director,
   never from a unit's init: a unit is set up on the small stack of the traffic manager, and a walk
   of the whole process tree there crashed the game (illegal instruction while a zone loaded)."
  (dotimes (i BF_LOOK_COUNT)
    (set! (-> *bf-looks* i) 0)
    )
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (let ((sym (-> p type symbol)))
        (when (or (= sym 'crimson-guard) (= sym 'flying-turret) (= sym 'roboguard-city) (= sym 'spydroid))
          (let ((name (bf-art-name p)))
            (cond
              ((string= name "crimson-guard-lod0") (+! (-> *bf-looks* BF_LOOK_BLUE) 1))
              ((string= name "bf-red-guard-lod0") (+! (-> *bf-looks* BF_LOOK_RED) 1))
              ((string= name "bf-red-guard-gl-lod0") (+! (-> *bf-looks* BF_LOOK_RED_GL) 1))
              ((string= name "bf-hover-blue-lod0") (+! (-> *bf-looks* BF_LOOK_JET_BLUE) 1))
              ((string= name "bf-hover-red-lod0") (+! (-> *bf-looks* BF_LOOK_JET_RED) 1))
              ((string= name "bf-robot-blue-lod0") (+! (-> *bf-looks* BF_LOOK_ROBOT_BLUE) 1))
              ((string= name "roboguard-city-lod0") (+! (-> *bf-looks* BF_LOOK_ROBOT_RED) 1))
              ((string= name "bf-spider-blue-lod0") (+! (-> *bf-looks* BF_LOOK_SPIDER_BLUE) 1))
              ((string= name "spydroid-lod0") (+! (-> *bf-looks* BF_LOOK_SPIDER_RED) 1))
              )
            )
          )
        )
      #t
      )
    *null-kernel-context*
    )
  (none)
  )

;; Share of each look in its pool (`bf-caps-set!`): blue guards, red riflemen, red grenadiers, blue
;; jetpack guards, red jetpack guards, blue and red robotguards, blue and red spider robots.
(define *bf-look-share* (new 'static 'array int32 9 40 30 10 20 20 20 20 20 20))

(defun bf-caps-set! ((n int))
  "Each side's army cap from N units at once (the battle setup's, BF_AT_ONCE_MIN to BF_AT_ONCE_MAX),
   the same for both sides since round 46 (the author's wish: blue robotguards and spiders for the
   Freedom League): two fifths of guards (the Krimzon Guard's three riflemen for one grenadier), a
   fifth each of jetpack guards and robotguards, the rest spider robots; into `*bf-team-caps*`,
   `*bf-look-share*` and the pools' `*bf-pool-caps*`. Until round 46 the Freedom League had 72 %
   blue guards and the rest blue jetpack guards."
  (let* ((n (max BF_AT_ONCE_MIN (min BF_AT_ONCE_MAX n)))
         (k (/ n 5))
         (spiders (- n (* 4 k)))
         )
    (dotimes (team 2)
      (set! (-> *bf-team-caps* (* 4 team)) (* 2 k))
      (set! (-> *bf-team-caps* (+ (* 4 team) 1)) k)
      (set! (-> *bf-team-caps* (+ (* 4 team) 2)) k)
      (set! (-> *bf-team-caps* (+ (* 4 team) 3)) spiders)
      )
    (set! (-> *bf-look-share* BF_LOOK_BLUE) (* 2 k))
    (set! (-> *bf-look-share* BF_LOOK_RED) (- (* 2 k) (/ k 2)))
    (set! (-> *bf-look-share* BF_LOOK_RED_GL) (/ k 2))
    (set! (-> *bf-look-share* BF_LOOK_JET_BLUE) k)
    (set! (-> *bf-look-share* BF_LOOK_JET_RED) k)
    (set! (-> *bf-look-share* BF_LOOK_ROBOT_BLUE) k)
    (set! (-> *bf-look-share* BF_LOOK_ROBOT_RED) k)
    (set! (-> *bf-look-share* BF_LOOK_SPIDER_BLUE) spiders)
    (set! (-> *bf-look-share* BF_LOOK_SPIDER_RED) spiders)
    (set! (-> *bf-pool-caps* 0) (* 4 k))
    (set! (-> *bf-pool-caps* 1) (* 2 k))
    (set! (-> *bf-pool-caps* 2) (* 2 k))
    (set! (-> *bf-pool-caps* 3) (* 2 spiders))
    )
  (none)
  )

(defun bf-take-look ((look int))
  "Count one more unit of LOOK (it is being spawned) and return LOOK."
  (+! (-> *bf-looks* look) 1)
  look
  )

(defun bf-look-gap ((look int))
  "How many units LOOK lacks to reach its share of its pool (negative when it has too many)."
  (- (-> *bf-look-share* look) (-> *bf-looks* look))
  )

(defun bf-guard-skel-name ()
  "Skeleton for a new crimson-guard process (guard.gc init-enemy!). During a battle the guard-a
   pool holds the blue guards (Freedom League) and the red Jak 2 Krimzon Guards, three riflemen for
   one grenadier (`bf-caps-set!`): the new guard takes the look furthest below its share. An alternation was not
   enough: the traffic kills and spawns guards all the time (trims, section changes), and in game
   the pool drifted to no blue guard at all."
  (if (not (bf-active?))
      "skel-crimson-guard"
      (let ((look BF_LOOK_BLUE))
        (if (< (bf-look-gap look) (bf-look-gap BF_LOOK_RED))
            (set! look BF_LOOK_RED)
            )
        (if (< (bf-look-gap look) (bf-look-gap BF_LOOK_RED_GL))
            (set! look BF_LOOK_RED_GL)
            )
        (bf-take-look look)
        (case look
          ((BF_LOOK_RED) "skel-bf-red-guard")
          ((BF_LOOK_RED_GL) "skel-bf-red-guard-gl")
          (else "skel-crimson-guard")
          )
        )
      )
  )

(defun bf-bot-skel-name ((spider? symbol))
  "Skeleton for a new roboguard-city process (roboguard-city.gc init-enemy!), or with SPIDER? a
   spydroid (spydroid.gc init-enemy!). During a battle the robots of each kind are blue (the Freedom
   League's, round 46) or red: the new one takes the color furthest below its share (see
   `bf-guard-skel-name`)."
  (let ((blue (if spider? BF_LOOK_SPIDER_BLUE BF_LOOK_ROBOT_BLUE))
        (red (if spider? BF_LOOK_SPIDER_RED BF_LOOK_ROBOT_RED))
        )
    (cond
      ((not (bf-active?))
       (if spider? "skel-spydroid" "skel-roboguard-city")
       )
      ((< (bf-look-gap blue) (bf-look-gap red))
       (bf-take-look red)
       (if spider? "skel-spydroid" "skel-roboguard-city")
       )
      (else
        (bf-take-look blue)
        (if spider? "skel-bf-spider-blue" "skel-bf-robot-blue")
        )
      )
    )
  )

(defun bf-turret-skel-name ()
  "Skeleton for a new flying-turret process (flying-turret.gc init-enemy!). During a battle the
   flying turrets become jetpack guards, 6 blue (Freedom League) and 4 red: the new one takes the
   colour furthest below its share (see `bf-guard-skel-name`)."
  (if (not (bf-active?))
      "skel-flying-turret"
      (let ((look (if (< (bf-look-gap BF_LOOK_JET_BLUE) (bf-look-gap BF_LOOK_JET_RED))
                      BF_LOOK_JET_RED
                      BF_LOOK_JET_BLUE
                      )
                  )
            )
        (bf-take-look look)
        (if (= look BF_LOOK_JET_BLUE)
            "skel-bf-hover-blue"
            "skel-bf-hover-red"
            )
        )
      )
  )

;; ---------------------------------------------------------------------------------------------
;; The Freedom League models' shine (round 49)
;; ---------------------------------------------------------------------------------------------

;; A build-actor model's envmap shine is tinted by the merc extra info build-actor writes for each
;; of its effects: always (255 161 102), orange (goalc/build_actor/jak3/build_actor.cpp
;; gen_dummy_extra_info; foreground.gc multiplies it by the time of day's env color). The blue
;; robotguard, spider robot, jetpack and troop transport, recolored from red, shone orange (the
;; author's report, round 49). Their shine takes the same tint mirrored to blue.
(define *bf-blue-shine* (new 'static 'rgba :r #x66 :g #xa1 :b #xff :a #x80))

;; The blue robotguard's tint: the stock robotguard's own, a dim grey (55 55 55 in most of the
;; effects of roboguard-city's art, read in game, round 52). With `*bf-blue-shine*` it shone about
;; three times as bright as the red one (the author's report, round 52).
(define *bf-robot-shine* (new 'static 'rgba :r #x55 :g #x55 :b #x55 :a #x80))

(defun bf-blue-shine! ((sg skeleton-group) (tint rgba))
  "The envmap tint of every mesh of SG's model (its levels of detail, in its loaded art group) set to
   TINT (`*bf-blue-shine*`, `*bf-robot-shine*`). No-op while the art group is not loaded. Writes the
   art data itself: every process drawing that model shines so."
  (let ((ag (art-group-get-by-name *level* (-> sg art-group-name) (the-as (pointer level) #f))))
    (when ag
      (dotimes (lod (+ (-> sg max-lod) 1))
        (let ((k (-> sg mgeo lod)))
          (when (and (>= k 0) (< k (-> ag length)))
            (let ((geo (the-as merc-ctrl (-> ag data k))))
              (when (and geo (= (-> geo type) merc-ctrl))
                (dotimes (e (the-as int (-> geo header effect-count)))
                  (let ((ei (-> geo effect e extra-info)))
                    (when (and ei (nonzero? ei) (nonzero? (-> ei envmap-tint-offset)))
                      (set! (-> (the-as mei-envmap-tint (+ (the-as uint ei) (* (-> ei envmap-tint-offset) 16))) tint)
                            tint
                            )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-blue-shine-all! ()
  "Called once a second during a battle (battlefront.gc `bf-director-update`): the blue
   robotguard's, spider robot's and jetpack's shine blue (`bf-blue-shine!`), whenever their level
   has loaded. The blue transport's is set as each one starts (bf-transport.gc)."
  (bf-blue-shine! skel-bf-robot-blue *bf-robot-shine*)
  (bf-blue-shine! skel-bf-spider-blue *bf-blue-shine*)
  (bf-blue-shine! skel-bf-hover-blue *bf-blue-shine*)
  ;; Ashelin (round 53): the robots' dim grey, not build-actor's orange
  (bf-blue-shine! skel-bf-ashelin *bf-robot-shine*)
  (none)
  )

(defconstant BF_NAV_USERS 200) ;; units on one nav mesh of a ported war zone's level at most (64 stock, round 44)

(defun bf-nav-max-users ((stock int))
  "Users of a nav mesh the level being loaded holds (nav-mesh.gc init-from-entity, at its login):
   BF_NAV_USERS in the Battlefront's ported war zones' levels, bf-havenj2 and bf-spargus (round
   50), STOCK in every other level. Each user takes 288 bytes of the level's heap."
  (let ((lev (-> *level* loading-level)))
    (if (and lev (or (= (-> lev name) 'bf-havenj2) (= (-> lev name) 'bf-spargus)))
        (max stock BF_NAV_USERS)
        stock
        )
    )
  )

(defun bf-pool-size ((k int))
  "The size of the pool of the battle's kind K (an index of `*bf-pool-caps*`): its cap, and during a
   battle (its deployment too: a redeploy's reset spawns the pools again) no more than its units
   awake (`*bf-awake-kinds*`) and BF_POOL_SPARE."
  (if (bf-active?)
      (min (-> *bf-pool-caps* k) (+ (-> *bf-awake-kinds* k) BF_POOL_SPARE))
      (-> *bf-pool-caps* k)
      )
  )

(defun bf-want-count ((kind int) (stock int))
  "Army cap of traffic type KIND during a battle, STOCK otherwise. Asked twice:
   * the pool size (traffic-manager.gc traffic-manager-method-22, every frame): a pool spawns its
     units up to it and deactivates the sleeping ones above it (traffic-manager-method-18);
   * how many units of the type may be awake (traffic-engine.gc activate-one-vehicle), in place
     of the squad controls' count for the territory, which they rewrite with their alert level:
     at the Port it allowed 7 guards, 1 flying turret and no roboguard, and the battle starved.
   During a fight a pool is no bigger than its units awake and BF_POOL_SPARE asleep (round 44): every
   unit a pool spawns holds one of the engine's default nav mesh's 255 nav-controls until it is
   first woken, and 200 a side would hold more."
  (if (bf-active?)
      (case (the-as traffic-type kind)
        (((traffic-type guard-a)) (bf-pool-size 0))
        (((traffic-type flying-turret)) (bf-pool-size 1))
        (((traffic-type roboguard)) (bf-pool-size 2))
        (((traffic-type spydroid)) (bf-pool-size 3))
        ;; no citizen on a battlefield: walkers, pilots, and their bikes and cars (the faction
        ;; commands leave some civilians to the faction manager's levels)
        (((traffic-type civilian-male)
          (traffic-type civilian-female)
          (traffic-type civilian-fat)
          (traffic-type civilian-pilot)
          (traffic-type civilian-bike-a)
          (traffic-type civilian-bike-b)
          (traffic-type civilian-bike-c)
          (traffic-type civilian-car-a)
          (traffic-type civilian-car-b)
          (traffic-type civilian-car-c)
          )
         0
         )
        (else stock)
        )
      stock
      )
  )

(defun bf-wake-count ((kind int) (stock int))
  "How many units of traffic type KIND the traffic may wake on its own (traffic-engine.gc
   activate-one-vehicle), STOCK out of a battle. During a battle, its deployment too, none of the
   battle's four kinds: the sides' troop transports bring every unit from their bases
   (levels/city/battlefront/bf-transport.gc), woken with 'activate-object, which this count does
   not hold back; woken by the traffic during the deployment, the Krimzon Guard's stood around the
   Freedom League's base when the fight began. For the other kinds, the army caps (`bf-want-count`)."
  (if (and (bf-active?)
           (or (= kind (the-as int (traffic-type guard-a)))
               (= kind (the-as int (traffic-type flying-turret)))
               (= kind (the-as int (traffic-type roboguard)))
               (= kind (the-as int (traffic-type spydroid)))
               )
           )
      0
      (bf-want-count kind stock)
      )
  )

(defun bf-unit-scale ((proc process) (stock float))
  "Root scale of a flying-turret: the turret is drawn at 2.0, a jetpack guard at its own size."
  (if (bf-hover-art? proc) 1.0 stock)
  )

(defun bf-attacker-type ((proc process) (stock int))
  "Haven City attack-controller type a unit registers with (city-target-type). The red guard
   registers as a roboguard (9) and the blue jetpack, robotguard and spider robot (round 46) as a
   rifle guard (4), so the stock hatred table sends each side against the other."
  (cond
    ((not (bf-active?)) stock)
    ((bf-red-guard? proc) 9)
    ((string= (bf-art-name proc) "bf-hover-blue-lod0") 4)
    ((bf-blue-bot? proc) 4)
    (else stock)
    )
  )

(defun bf-guard-flags ((proc process) (flags uint) (dark uint))
  "Called by crimson-guard citizen-method-194 (guard.gc) as a guard is put on the street, before
   Jak 3 reads its dark-guard flag. FLAGS: the guard's citizen flags, DARK: the dark-guard bit (the
   citizen-flag enum is CWI's, unknown here). A red guard is never a dark guard: a dark guard shows
   the mesh effects 0 and 2 (crimson-guard-method-267, setup-masks 5), and a build-actor model has
   its envmap draws, the red guard's shiny armor, in effect 1: only its legs showed (seen in game).
   Returns the flags to set."
  (if (bf-red-guard? proc)
      (logclear flags dark)
      flags
      )
  )

(defun bf-guard-activated ((proc process))
  "Tail of crimson-guard citizen-method-194 (each time a guard is put on the street). A red guard
   gets `process-mask enemy` back, which stock citizens lose: Jak's aim and the wastelanders'
   foe search only consider processes that carry it."
  (when (bf-red-guard? proc)
    (logior! (-> proc mask) (process-mask enemy))
    )
  (none)
  )

;; The pickups left by the fallen units since the battle began, by kind, for the tests
;; (docs/modding/current_mod/battlefront_smoke.gc): dark eco, yellow ammo, red ammo, blue ammo, health,
;; and a jetpack's rockets (dark ammo, `bf-queue-drop`).
(define *bf-drop-kinds* (new 'static 'array int32 6))

(define *bf-drop-types* (new 'static 'array uint32 6
                           (pickup-type eco-pill-dark) (pickup-type ammo-yellow) (pickup-type ammo-red)
                           (pickup-type ammo-blue) (pickup-type health) (pickup-type ammo-dark)
                           )
        )

(defconstant BF_DROP_ROCKETS 5) ;; index of the dark ammo (a jetpack's rockets, a robotguard's grenades) in `*bf-drop-types*`

;; The jetpack guards' rockets bag (`bf-queue-drop`): of every 10 jetpack guards fallen, one leaves
;; its rockets (the author's 10 %), what is left of it and its full load: rockets, nothing. The
;; robotguards' grenades have a bag of their own, the same 10 % (round 38).
(define *bf-rocket-bag* (new 'static 'array int32 2))
(define *bf-grenade-bag* (new 'static 'array int32 2))
(define *bf-rocket-bag-full* (new 'static 'array int32 2 1 9))

(deftype bf-drop-bags (structure)
  "What is left in the pickups' two bags (`bf-drop-roll`): KIND, of 10 pickups (dark eco, ammo,
   health), and AMMO, of 10 ammo pickups (yellow, red, blue)."
  ((kind  int32 3)
   (ammo  int32 3)
   )
  )

(define *bf-drop-bags* (new 'static 'bf-drop-bags))
(define *bf-drop-kind-full* (new 'static 'array int32 3 3 4 3)) ;; dark eco, ammo, health in 10
(define *bf-drop-ammo-full* (new 'static 'array int32 3 6 3 1)) ;; yellow, red, blue in 10 ammo

(defun bf-bag-draw ((bag (pointer int32)) (full (pointer int32)) (n int))
  "One of the N kinds of BAG (what is left of each), weighted by what is left, taken out; the bag
   refilled from FULL when empty. Returns the kind's index."
  (let ((left 0))
    (dotimes (i n)
      (+! left (-> bag i))
      )
    (when (<= left 0)
      (dotimes (i n)
        (set! (-> bag i) (-> full i))
        (+! left (-> full i))
        )
      )
    (let ((r (the int (mod (rand-uint31-gen *random-generator*) (the uint left))))
          (k 0)
          )
      (while (>= r (-> bag k))
        (set! r (- r (-> bag k)))
        (+! k 1)
        )
      (+! (-> bag k) -1)
      k
      )
    )
  )

(defun bf-drop-roll ()
  "A pickup's kind, its index in `*bf-drop-types*`: dark eco 30 %, ammo 40 % (yellow 60, red 30,
   blue 10 % of it), health 30 % (the author's shares), exact over each bag of 10 (`bf-bag-draw`).
   A draw at each pickup gave health 50 times in 108 over three battles, with rand-vu and then
   rand-uint31-gen, whose code gives 30 % in 200000 draws simulated away from the game: the cause
   was not found, the bags make the shares exact whatever it is."
  (case (bf-bag-draw (-> *bf-drop-bags* kind) *bf-drop-kind-full* 3)
    ((0) 0)
    ((1) (+ 1 (bf-bag-draw (-> *bf-drop-bags* ammo) *bf-drop-ammo-full* 3)))
    (else 4)
    )
  )

(defconstant BF_BLUE_ECO_DROP 0.75) ;; a spider's kill leaves blue eco this often (round 44, the author's "high share")

(defun bf-spider? ((proc process))
  "#t for a spider robot: an AI one, or the player playing one."
  (or (= (-> proc type symbol) 'spydroid) (and (= proc *target*) (= (-> *bf* class) BF_CLASS_SPYDROID)))
  )

(defun bf-queue-drop ((proc process))
  "Maybe leave a pickup where PROC died: 6 of every 10 fallen units leave one, in a random order (a
   bag of 10 deaths holding 6, where a chance at each death gave less in two long battles): dark eco
   (the jetpack's boost) 30 %, ammo 40 % (of it yellow, the rifle's reserve, 60 %, red, grenades,
   30 %, blue, which recharges the tazer at once, 10 %), health 30 % (the author's shares). Each one
   goes 10 s after it appears (`bf-spawn-drops`). Queued for the director, which spawns it in its
   own process: this runs on the traffic manager's small stack.
   A jetpack guard (a flying-turret) also leaves its rockets, one in 10 (`*bf-rocket-bag*`, the
   author's 10 %, round 37), and a robotguard its grenades, one in 10 too (`*bf-grenade-bag*`,
   round 38): the stock dark ammo pickup, purple as their icons, which a jetpack player takes as
   rockets and a robotguard player as grenades (battlefront-player.gc BF_ROCKET_PICKUP).
   A unit a spider killed (the last foe that hit it, `bf-hit-by`) also leaves Jak and Daxter's blue
   eco, BF_BLUE_ECO_DROP of the time: the spider's sprint (round 44)."
  (let ((killer (bf-hit-by proc (seconds 5))))
    (when (and killer
               (bf-spider? killer)
               (type? proc process-drawable)
               (< (-> *bf* drop-count) BF_DROP_MAX)
               (< (rand-vu) BF_BLUE_ECO_DROP)
               )
      (let ((i (-> *bf* drop-count)))
        (set! (-> *bf* drop-kind i) (the-as int (pickup-type eco-blue)))
        (vector-copy! (-> *bf* drop-pos i) (-> (the-as process-drawable proc) root trans))
        (+! (-> *bf* drop-count) 1)
        )
      )
    )
  (let ((bag (case (-> proc type symbol)
               (('flying-turret) *bf-rocket-bag*)
               (('roboguard-city) *bf-grenade-bag*)
               (else (the-as (pointer int32) #f))
               )
             )
        )
    (when (and bag
               (type? proc process-drawable)
               (< (-> *bf* drop-count) BF_DROP_MAX)
               (zero? (bf-bag-draw bag *bf-rocket-bag-full* 2))
               )
      (let ((i (-> *bf* drop-count)))
        (set! (-> *bf* drop-kind i) (the-as int (-> *bf-drop-types* BF_DROP_ROCKETS)))
        (+! (-> *bf-drop-kinds* BF_DROP_ROCKETS) 1)
        (vector-copy! (-> *bf* drop-pos i) (-> (the-as process-drawable proc) root trans))
        (+! (-> *bf* drop-count) 1)
        )
      )
    )
  (when (and (type? proc process-drawable) (< (-> *bf* drop-count) BF_DROP_MAX))
    (when (<= (-> *bf* bag-deaths) 0)
      (set! (-> *bf* bag-deaths) 10)
      (set! (-> *bf* bag-drops) BF_BAG_DROPS)
      )
    (let ((drop? (< (rand-vu-int-count (-> *bf* bag-deaths)) (-> *bf* bag-drops))))
      (+! (-> *bf* bag-deaths) -1)
      (when drop?
        (+! (-> *bf* bag-drops) -1)
        (let ((k (bf-drop-roll))
              (i (-> *bf* drop-count))
              )
          (set! (-> *bf* drop-kind i) (the-as int (-> *bf-drop-types* k)))
          (+! (-> *bf-drop-kinds* k) 1)
          (vector-copy! (-> *bf* drop-pos i) (-> (the-as process-drawable proc) root trans))
          (+! (-> *bf* drop-count) 1)
          )
        )
      )
    )
  (none)
  )

(defconstant BF_FALLEN_MAX 256) ;; 64 until round 44

(deftype bf-fallen (structure)
  "The last units fallen, the newest over the oldest once full: when, and their side and kind
   (4 team + the kind's index in `*bf-kinds*`), so that a side's ship waits BF_UNIT_RESPAWN before
   it brings the next unit in a fallen one's place (levels/city/battlefront/bf-transport.gc
   `bf-transport-next-kind`)."
  ((time  time-frame BF_FALLEN_MAX)
   (slot  int32      BF_FALLEN_MAX)
   (next  int32)
   )
  )

(define *bf-fallen* (new 'static 'bf-fallen))

(defun bf-unit-kind ((proc process))
  "Index in `*bf-kinds*` of unit PROC's kind: 0 guard, 1 jetpack guard, 2 robotguard, 3 spider
   robot; -1 for any other process."
  (case (-> proc type symbol)
    (('crimson-guard) 0)
    (('flying-turret) 1)
    (('roboguard-city) 2)
    (('spydroid) 3)
    (else -1)
    )
  )

(defun bf-fallen-count ((team int) (kind int))
  "Units of side TEAM and kind KIND (`bf-unit-kind`) fallen less than BF_UNIT_RESPAWN ago."
  (let ((n 0)
        (want (+ (* 4 team) kind))
        )
    (dotimes (i BF_FALLEN_MAX)
      (if (and (= (-> *bf-fallen* slot i) want)
               (nonzero? (-> *bf-fallen* time i))
               (not (time-elapsed? (-> *bf-fallen* time i) BF_UNIT_RESPAWN))
               )
          (+! n 1)
          )
      )
    n
    )
  )

(defun bf-unit-killed ((proc process))
  "Called by the traffic engine when one of its units dies (traffic-tracker set-process-to-killed,
   reached once per real death; units recycled out of view do not go there): its side loses one
   unit, it may leave a pickup, and its place waits BF_UNIT_RESPAWN for the next one (`*bf-fallen*`)."
  (when (bf-fighting?)
    (let ((team (bf-unit-team proc))
          (kind (bf-unit-kind proc))
          )
      (bf-count-loss team)
      (when (and (>= team 0) (>= kind 0))
        (let ((k (-> *bf-fallen* next)))
          (set-time! (-> *bf-fallen* time k))
          (set! (-> *bf-fallen* slot k) (+ (* 4 team) kind))
          (set! (-> *bf-fallen* next) (mod (+ k 1) BF_FALLEN_MAX))
          )
        )
      )
    (bf-queue-drop proc)
    )
  (none)
  )

(defun bf-foe? ((proc process) (team int))
  "#t when PROC is a living unit of the side opposite TEAM, or the player when on that side."
  (and proc
       (type? proc process-focusable)
       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
       (let ((other (bf-unit-team proc)))
         (and (>= other 0) (!= other team))
         )
       )
  )

(defconstant BF_HOVER_CEILING (meters 15)) ;; a jetpack guard flies this high over its nav poly's middle at most:
                                           ;; a ship's highest hover over the street (bf-transport.gc
                                           ;; BF_TRANSPORT_HOVER_MAX, 14 m), the middle ~1 m under the street
(defconstant BF_HOVER_RISE (meters 6))     ;; the most the scenery under it lifts its flight

(defun bf-nan? ((f float))
  "#t when F is a NaN or an infinity: its exponent bits all set."
  (= (logand (the-as int f) #x7f800000) #x7f800000)
  )

(defun bf-hover-turn-fix! ((this process-drawable) (heading quaternion) (roll quaternion))
  "Called by enemy-common-post (flying-turret.gc) after the stock flight (flying-turret-method-227)
   turned the unit: during a battle, a turn that is not a number (the flight normalizes its thrust's
   direction across the ground, and a thrust straight up or none has no such direction) is put back
   to none: its HEADING and ROLL quaternions and its root's. A NaN turn stayed NaN for good (each
   frame blends into the last), and so did its bones and the shots its gun bone aims: each guard
   such a shot knocked flew off at NaN (round 32, scenario 60: a jetpack's 16 shots, 5 guards)."
  (when (and (bf-active?) (or (bf-nan? (-> this root quat x)) (bf-nan? (-> heading x)) (bf-nan? (-> roll x))))
    (quaternion-identity! heading)
    (quaternion-identity! roll)
    (quaternion-identity! (-> this root quat))
    )
  (none)
  )

(defun bf-hover-ceiling! ((this nav-enemy) (ground float))
  "Called by enemy-common-post (flying-turret.gc) after the stock flight set its height:
   during a battle, a jetpack guard's GROUND (the stock ground-height: the first surface a probe 25
   m long meets under it) is held at most BF_HOVER_RISE over the middle of its nav poly, and the
   guard at most BF_HOVER_CEILING over it (the author's wish: no higher than a ship). The stock
   probe met roofs and kept their height once past them (it reaches 25 m down only): the jetpack
   guards climbed from roof to roof, up to 45 m over the street (round 26's tests). Returns the
   ground-height to keep; moves the guard down (root trans y)."
  (if (and (bf-active?)
           (nonzero? (-> this nav))
           (-> this nav state mesh)
           (-> this nav state current-poly)
           )
      (let ((street (-> (poly-centroid (-> this nav state mesh) (-> this nav state current-poly) (new 'stack-no-clear 'vector)) y)))
        (if (< (+ street BF_HOVER_CEILING) (-> this root trans y))
            (set! (-> this root trans y) (+ street BF_HOVER_CEILING))
            )
        (fmin ground (+ street BF_HOVER_RISE))
        )
      ground
      )
  )

(defun bf-hover-animate ((this process-drawable) (speed float))
  "Post of a flying-turret drawn as a jetpack guard (flying-turret.gc enemy-common-post). The
   turret code holds its idle pose; this loops the jetpack guard's idle or forward clip by SPEED
   (units per second) at BF_HOVER_RATE unless the turret code is playing the firing clip."
  (when (and (bf-hover-art? this) (nonzero? (-> this skel)) (> (-> this skel active-channels) 0))
    (let* ((chan (-> this skel root-channel 0))
           (fire (-> this draw art-group data BF_HOVER_SHOOT))
           )
      (when (!= (-> chan frame-group) fire)
        (let ((want (the-as art-joint-anim (-> this draw art-group data (if (< speed (meters 4))
                                                                              BF_HOVER_IDLE
                                                                              BF_HOVER_FLY_FORWARD
                                                                              )
                                                    )
                            )
                    )
              )
          (when (!= (-> chan frame-group) want)
            (joint-control-channel-group! chan want num-func-identity)
            (set! (-> chan frame-num) 0.0)
            )
          (let ((last (the float (+ (-> want frames num-frames) -1))))
            (set! (-> chan frame-num) (+ (-> chan frame-num) (* BF_HOVER_RATE (-> this clock time-adjust-ratio))))
            (if (>= (-> chan frame-num) last)
                (set! (-> chan frame-num) 0.0)
                )
            )
          )
        )
      )
    )
  (none)
  )
