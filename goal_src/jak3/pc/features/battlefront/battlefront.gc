;;-*-Lisp-*-
(in-package goal)

;; name: battlefront.gc
;; name in dgo: battlefront
;; dgos: GAME

#|
  Battlefront mod -- the director of a battle, its menus, its HUD and its Mods menu entry.

  Flow:
    Mods menu (L3 + SELECT, as every mod) > battlefront > Battlefront mode: the mode's switch. On,
    START opens the battle's pause page (the game's menu behind its Options entry), where the
    battle is chosen and run:
      New battle -> page 1: war zone  -> page 2: side  -> page 3: class (turning preview), while
                    the deployment loads the zone under it
      Change class (the fight goes on), Redeploy, Restart the battle, Quit the battle.
    Switched off during a battle, it loads the last save.
    Deployment: the director (a process of *pc-pool*, which outlives level changes and deaths)
    owns the settings of the battle (borrowed unit levels, faction strengths) and sends Jak to his
    side's spawn the way a death does (`initialize!` 'life), which spawns every unit pool of
    Haven City again, now with the battle's skins (battlefront-h.gc). The class page opens at once,
    with the game running under it while the zone loads: the class models, and the page's preview
    of them, live in the unit levels the deployment loads, so the preview shows once they are in.
    Once Jak stands at the spawn the game pauses under the page, and X deploys him.
    Fight: each side has BF_RESERVE units in stock; every death of a unit or of the player takes
    one (battlefront-h.gc `bf-count-loss`). The first side down to 0 loses. A dead player watches
    the battle for four seconds, the camera on a unit of his side, then comes back at his side's
    spawn with his class and fresh ammo (`bf-target-death`). A force field holds the player inside
    the battlefield, and the jetpacks under its ceiling.
    End: result page, then everything the battle changed is undone (settings die with their
    owner's entries removed, hatred written back, Jak's ammo and light eco given back, the player
    respawned at his spawn so every unit is spawned again with its stock skin).

  HUD of the fight: both reserves, the crosshair, the class's weapon and ammo, the jetpack's fuel
  or the spider's blue eco, and Jak's health HUD kept shown, with the class model in its center
  in place of the light and dark eco gauges.

  Everything here is idle while the Mods menu flag is off: the director is not even spawned.
|#

;; DECOMP BEGINS

(define-extern mods-menu-close! (function none))
;; defined further down this file: the player's base continue point and its levels, and the redeploy
(define-extern bf-camp-continue (function continue-point))
(define-extern bf-camp-loaded? (function continue-point symbol))
(define-extern bf-can-redeploy? (function symbol))
(define-extern bf-out-of-combat? (function symbol))

;; Pages of the battle menu.
(defconstant BF_PAGE_NONE 0)
(defconstant BF_PAGE_ZONE 1)
(defconstant BF_PAGE_TEAM 2)
(defconstant BF_PAGE_CLASS 3)
(defconstant BF_PAGE_RESULT 4)
(defconstant BF_PAGE_PAUSE 5)  ;; START during the mode: the battle's own pause page, the live map
(defconstant BF_PAGE_CONFIG 7) ;; the battle's configuration (round 29): its settings, its map, its sides
(defconstant BF_PAGE_LOADING 8) ;; a deployment loading its war zone on black (round 30: the class is picked before)

;; What the class page is for (round 30), the director's class-mode
(defconstant BF_CLASS_DEPLOY 0)   ;; a new battle's class, before its war zone loads
(defconstant BF_CLASS_RESPAWN 1)  ;; the dead player's respawn, Triangle on the death screen: class and point
(defconstant BF_CLASS_REDEPLOY 2) ;; the pause page's Redeploy: class and point

;; Requests of the START menu's battle page to the director (it runs them in its own process, so
;; the settings it creates and removes are its own).
(defconstant BF_REQ_NONE 0)
(defconstant BF_REQ_LOBBY 1)
(defconstant BF_REQ_END 3)
(defconstant BF_REQ_RESTART 4)
(defconstant BF_REQ_REDEPLOY 5)
(defconstant BF_REQ_PAUSE 6)      ;; START pressed while the mode is on (`activate-progress` below)
(defconstant BF_REQ_GAME_MENU 7)  ;; the pause page's last entry: the game's own START menu
(defconstant BF_REQ_TITLE 8)      ;; the title page (the game's title menu asked for, or the debug boot)
(defconstant BF_REQ_START 9)      ;; a battle started from the title: once Jak stands in the city, its deployment
(defconstant BF_REQ_RESPAWN 10)   ;; the dead player's class page, with his respawn point (`bf-target-death`)

;; The battle's victory conditions (the configuration page, `*bf-config*`).
(defconstant BF_WIN_POINTS 0)     ;; a side holding every control point for BF_HOLD_WIN wins; a side out of units loses
(defconstant BF_WIN_UNITS 1)      ;; only a side out of units loses
(defconstant BF_HOLD_WIN (seconds 20))
(defconstant BF_REDEPLOY_CALM (seconds 30)) ;; out of combat this long, the player may redeploy

(defconstant BF_DEPLOY_TIMEOUT (seconds 120)) ;; give up when the zone is not loaded by then (every street section, round 19)
(defconstant BF_FALL_DEPTH (meters 20))       ;; that far below his last safe place, Jak fell out of
                                              ;; the zone (the game's fall death comes some 25 m down;
                                              ;; the city's walkways stand well under 20 m)

(deftype bf-director (process)
  "Runs the battle. One instance, `(-> *bf* director)`."
  ((page          int32)
   (cursor        int32)
   (pick-zone     int32)
   (pick-team     int32)
   (want-avatar?  symbol)     ;; the class model must be (re)drawn as soon as it is loaded
   (prepared?     symbol)     ;; the city side of the battle is set up (BF_CITY_PREPARE)
   (end-pending?  symbol)     ;; end asked while Jak drives: done once he is on foot
   (leaving?      symbol)     ;; the mode was switched off in a battle: the last save is loading
   (hud-time      time-frame) ;; last time the health HUD was asked to show
   (field-time    time-frame) ;; last force-field spark
   (field-sound   time-frame) ;; last force-field sound
   (page-time     time-frame) ;; when a page was last handed to the START menu, or the pause page closed, on the real clock
   (from-title?   symbol)     ;; the menu began at the title: the zone page leads to the configuration, the class page starts the battle
   (respawn?      symbol)     ;; the class page picks the player's respawn point too (BF_CLASS_RESPAWN, BF_CLASS_REDEPLOY)
   (class-mode    int32)      ;; what the class page is for, BF_CLASS_*
   (pick-class    int32)      ;; the class page's class, the last class row the cursor stood on
   (pick-point    int32)      ;; the class page's respawn point (`respawn?`)
   )
  (:state-methods
    idle
    )
  )

(define *bf-request* BF_REQ_NONE)

;; The configuration page's choices (round 29, the author's wish), kept from one battle to the next.
(deftype bf-config (structure)
  ((minutes  int32)   ;; time limit, 0 for none (`*bf-time-choices*`)
   (units    int32)   ;; units per side, 50 to 1000 by 50
   (at-once  int32)   ;; units per side on the street at once, 30 to 100 by 10 (`bf-caps-set!`, round 41)
   (victory  int32)   ;; BF_WIN_POINTS or BF_WIN_UNITS
   (team-a   int32)   ;; the player's side, the top panel
   (team-b   int32)   ;; the other side, the bottom panel: never the same
   )
  )

(define *bf-config* (new 'static 'bf-config :minutes 0 :units 500 :at-once 60 :victory 0 :team-a 1 :team-b 0))
(define *bf-time-choices* (new 'static 'array int32 6 0 5 10 15 20 30))
(defconstant BF_CONFIG_COUNT 8) ;; the configuration page's rows: 5 settings, 2 sides, Next
(defconstant BF_CONFIG_SETTINGS 5)
;; Set once the debug boot opened the title page (`cpad-get-data`).
(define *bf-boot-menu?* #f)
;; Set to let the next START through to the game's own menu (the pause page's last entry).
(define *bf-stock-start?* #f)
(define *bf-text* (new 'global 'string 256 (the-as string #f)))

;; Haven City alias levels as a battle needs them: Freedom League guards (ctypesa) and Krimzon
;; Guard robots (ctypesc) in every faction mix the sections ask for.
(define *bf-borrow*
  '((ctywide-ff alias ctywide copy ctypesa special ctypesc special dummy auto)
    (ctywide-kg alias ctywide copy ctypesa special ctypesc special dummy auto)
    (ctywide-ff-kg alias ctywide copy ctypesa special ctypesc special dummy auto)
    )
  )

;; ---------------------------------------------------------------------------------------------
;; Drawing
;; ---------------------------------------------------------------------------------------------

(defun bf-draw-text ((buf dma-buffer) (str string) (x float) (y float) (scale float) (color font-color) (center? symbol))
  "Draw STR into BUF at (X, Y) in screen font units (512 wide). CENTER? centers it on X, or on the
   screen when X is 0 (the middle flag centers the text on origin x). A page draws its panel and all
   its text into one buffer, panel first, or the panel ends up over the text."
  (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 color (font-flags shadow kerning large))))
    (set! (-> font scale) scale)
    (set! (-> font origin x) (if (and center? (= x 0.0)) 256.0 x))
    (set! (-> font origin y) y)
    (if center?
        (logior! (-> font flags) (font-flags middle))
        )
    (pc-encode-utf8-string str *pc-encoded-temp-string*)
    (draw-string-adv *pc-encoded-temp-string* buf font)
    )
  (none)
  )

;; One line of a wrapped text.
(define *bf-line* (new 'global 'string 128 (the-as string #f)))

(defun bf-draw-text-wrapped ((buf dma-buffer) (str string) (x float) (y float) (scale float) (color font-color) (max-chars int))
  "Draw STR from Y down, broken at spaces into lines of at most MAX-CHARS bytes (16 units apart),
   centered on the screen when X is 0, else from X. draw-string-adv does not wrap, and a
   description is wider than the menu panel."
  (let ((len (length str))
        (start 0)
        (line-y y)
        )
    (while (< start len)
      (let ((end (min len (+ start max-chars))))
        ;; cut inside a word: back up to the last space of the line
        (when (< end len)
          (let ((cut end))
            (while (and (> cut start) (!= (-> str data cut) 32))
              (+! cut -1)
              )
            (if (> cut start)
                (set! end cut)
                )
            )
          )
        (dotimes (i (- end start))
          (set! (-> *bf-line* data i) (-> str data (+ start i)))
          )
        (set! (-> *bf-line* data (- end start)) (the-as uint 0))
        (bf-draw-text buf *bf-line* x line-y scale color (= x 0.0))
        (set! start end)
        (while (and (< start len) (= (-> str data start) 32))
          (+! start 1)
          )
        (+! line-y 16.0)
        )
      )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; The battle's pages in the START menu (round 29, the author's wish: drawn as the game's own
;; menus, inside the START menu's ring, after the multiplayer mod's lobby)
;; ---------------------------------------------------------------------------------------------

;; The class page's middle column, where its class turns: fractions of the START menu's screen
;; across and down (`*bf-frame*`). The screen's background box leaves it open
;; (`draw-bg-box-alpha-1`): drawn at the nearest depth, the box hides any model under it.
(defconstant BF_CLASS_HOLE_X0 0.4)
(defconstant BF_CLASS_HOLE_X1 0.66)
(defconstant BF_CLASS_HOLE_Y0 0.12)
(defconstant BF_CLASS_HOLE_Y1 0.74)

;; The game's window, width and height in pixels (`bf-x-squeeze`).
(define *bf-window* (new 'static 'array int64 2 0 0))

(defun bf-x-squeeze ()
  "Screen units across for one down that keep a shape round on the display: the 512 x 416 screen
   is stretched over the game's window (pc-get-window-size, as the START menu's resolution page
   reads it; Jak 3 leaves `*pc-settings*` framebuffer sizes at 0), so a unit across is 512/416 times
   its height over its width: 0.923 in 4:3, 0.692 in 16:9. relative-x-scale stayed 1.0 there: a
   radius in plain units drew the class page's radar 1.46 times wider than tall, seen in game."
  (pc-get-window-size (&-> *bf-window* 0) (&-> *bf-window* 1))
  (let ((w (-> *bf-window* 0))
        (h (-> *bf-window* 1))
        )
    (if (and (< 0 w) (< 0 h))
        (/ (* 1.2308 (the float h)) (the float w))
        0.923
        )
    )
  )

(deftype bf-frame (structure)
  "The START menu's screen this frame (`bf-frame-update!`): the box inside its ring under its
   header, in the 512 x 416 units the pages draw in, and the page's fade."
  ((x     float)
   (y     float)
   (w     float)
   (h     float)
   (alpha float)
   )
  )

(define *bf-frame* (new 'static 'bf-frame))

(defun bf-frame-update! ()
  "`*bf-frame*` from the START menu's small screen (progress.gc `*progress-work*`: 79 to 434
   across in 16:9, 70 to 444 in 4:3), squeezed to the display's width as the stock pages are
   (adjust-game-x), under the page's header, where the multiplayer lobby puts its own; its fade the
   menu's (menu-transition)."
  (let* ((wide? (= (get-aspect-ratio) 'aspect16x9))
         (x0 (if wide? 79.0 70.0))
         (x1 (if wide? 434.0 444.0))
         (left (if (-> *pc-settings* use-vis?) x0 (the float (adjust-game-x x0))))
         (right (if (-> *pc-settings* use-vis?) x1 (the float (adjust-game-x x1))))
         )
    (set! (-> *bf-frame* x) left)
    (set! (-> *bf-frame* w) (- right left))
    (set! (-> *bf-frame* y) (if wide? 84.0 110.0))
    (set! (-> *bf-frame* h) (- (if wide? 358.0 326.0) (-> *bf-frame* y)))
    (set! (-> *bf-frame* alpha)
          (if *progress-process*
              (fmax 0.0 (* 2.0 (- 0.5 (-> *progress-process* 0 menu-transition))))
              0.0
              )
          )
    )
  (none)
  )

(defun bf-fx ((k float))
  "The screen x at fraction K of the START menu's screen across (`*bf-frame*`)."
  (+ (-> *bf-frame* x) (* k (-> *bf-frame* w)))
  )

(defun bf-fy ((k float))
  "The screen y at fraction K of the START menu's screen down (`*bf-frame*`)."
  (+ (-> *bf-frame* y) (* k (-> *bf-frame* h)))
  )

(defun bf-fade ((color rgba))
  "COLOR with its alpha scaled by the page's fade (`*bf-frame*`), as the menu fades its pages."
  (let ((c (the-as int color)))
    (the-as rgba (logior (logand c #xffffff)
                         (shl (the int (* (-> *bf-frame* alpha) (the float (logand (shr c 24) 255)))) 24)
                         )
            )
    )
  )

(defun bf-fit-scale ((str string) (scale float) (width float))
  "The font scale at which STR, drawn as `bf-ptext` draws it, is WIDTH wide at most: SCALE, or less
   (60 % of it at least)."
  (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags kerning large))))
    (pc-encode-utf8-string str *pc-encoded-temp-string*)
    (set-scale! font scale)
    (let ((w (-> (get-string-length *pc-encoded-temp-string* font) length)))
      (if (< width w)
          (fmax (* 0.6 scale) (/ (* scale width) w))
          scale
          )
      )
    )
  )

(defun bf-ptext ((buf dma-buffer) (str string) (x float) (y float) (scale float) (color font-color) (center? symbol) (width float))
  "STR into BUF as the START menu writes: its font, COLOR (font-color-32 its yellow, font-color-33
   its white for the choice under the cursor), faded with the page; from X, or centered on X when
   CENTER?; at SCALE, smaller when wider than WIDTH (60 % at most, then it runs over), as the
   multiplayer lobby fits its lines. Button tags become the font's button icons
   (pc-encode-utf8-string)."
  (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 color (font-flags kerning large))))
    (pc-encode-utf8-string str *pc-encoded-temp-string*)
    (set-scale! font scale)
    (let ((w (-> (get-string-length *pc-encoded-temp-string* font) length)))
      (if (< width w)
          (set-scale! font (fmax (* 0.6 scale) (/ (* scale width) w)))
          )
      )
    (set! (-> font origin x) x)
    (set! (-> font origin y) y)
    (set! (-> font alpha) (-> *bf-frame* alpha))
    (if center?
        (logior! (-> font flags) (font-flags middle))
        )
    (draw-string-adv *pc-encoded-temp-string* buf font)
    )
  (none)
  )

(defun bf-pwrap ((buf dma-buffer) (str string) (x float) (y float) (scale float) (width float) (max-chars int))
  "STR from Y down in the START menu's yellow (`bf-ptext`, WIDTH wide), broken at spaces into lines
   of at most MAX-CHARS bytes: the font does not wrap."
  (let ((len (length str))
        (start 0)
        (line-y y)
        )
    (while (< start len)
      (let ((end (min len (+ start max-chars))))
        ;; cut inside a word: back up to the last space of the line
        (when (< end len)
          (let ((cut end))
            (while (and (> cut start) (!= (-> str data cut) 32))
              (+! cut -1)
              )
            (if (> cut start)
                (set! end cut)
                )
            )
          )
        (dotimes (i (- end start))
          (set! (-> *bf-line* data i) (-> str data (+ start i)))
          )
        (set! (-> *bf-line* data (- end start)) (the-as uint 0))
        (bf-ptext buf *bf-line* x line-y scale (font-color font-color-32) #f width)
        (set! start end)
        (while (and (< start len) (= (-> str data start) 32))
          (+! start 1)
          )
        (+! line-y (* 34.0 scale))
        )
      )
    )
  (none)
  )

(defun bf-pbox ((buf dma-buffer) (x float) (y float) (w float) (h float) (color rgba))
  "A box of COLOR, faded with the page (`bf-fade`)."
  (draw-sprite2d-xy buf (the int x) (the int y) (the int w) (the int h) (bf-fade color) #x3fffff)
  (none)
  )

(defun bf-pheader ((buf dma-buffer) (str string))
  "The page's title where the START menu's pages have theirs (draw-page-header): over the screen,
   centered, at FONT_SIZE_HEADER in the menu's yellow."
  (bf-ptext buf str (bf-fx 0.5) (if (= (get-aspect-ratio) 'aspect16x9) 55.0 82.0) 0.6 (font-color font-color-32) #t (-> *bf-frame* w))
  (none)
  )

(defun bf-pkeys ((buf dma-buffer) (str string))
  "The page's keys at the bottom of the START menu's screen, centered."
  (bf-ptext buf str (bf-fx 0.5) (bf-fy 0.94) 0.38 (font-color font-color-32) #t (-> *bf-frame* w))
  (none)
  )

(defun bf-prow ((buf dma-buffer) (str string) (x float) (y float) (w float) (on? symbol) (ok? symbol))
  "A choice of a page's list at (X, Y), W wide: under the START menu's highlight bar and in its
   white when ON? (the cursor's), in its yellow otherwise, grey when not OK?."
  (if on?
      (bf-pbox buf (+ x -4.0) (+ y -2.0) (+ w 8.0) 17.0 (static-rgba 128 128 64 64))
      )
  (bf-ptext buf str x y 0.45
            (cond
              ((not ok?) (font-color menu-invalid))
              (on? (font-color font-color-33))
              (else (font-color font-color-32))
              )
            #f
            w
            )
  (none)
  )

(defun bf-progress-on? ()
  "#t while the START menu shows the battle's page ('battlefront) or turns to it."
  (and *progress-process*
       (or (= (-> *progress-process* 0 current) 'battlefront) (= (-> *progress-process* 0 next) 'battlefront))
       )
  )

(defun bf-progress-spawn! ()
  "Open the START menu on the battle's page, as activate-progress does (progress.gc), without its
   progress-allowed? check: a dead player's settings may shut the START menu, and his respawn page
   must open. The director asks for it only in the 'game master mode, out of a blackout
   (`bf-can-open-menu?`)."
  (when *target*
    (when *progress-process*
      (deactivate (-> *progress-process* 0))
      (set-menu-mode *blit-displays-work* #t)
      )
    (set! *progress-process*
          (process-spawn progress 'battlefront :name "progress" :to *dproc* :stack (&-> *progress-stack* DPROCESS_STACK_SIZE))
          )
    (set-master-mode 'progress)
    )
  (none)
  )

(defun bf-draw-box ((buf dma-buffer) (x int) (y int) (w int) (h int))
  "A dark panel with a light border into BUF, like the popup menus."
  (draw-sprite2d-xy buf x y w h (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf (+ x 1) (+ y 1) (+ w -2) (+ h -2) (static-rgba 0 0 0 200) #x3fffff)
  (none)
  )

(defun bf-draw-frame ((buf dma-buffer) (x int) (y int) (w int) (h int))
  "The light border of a panel without its fill: the class preview, drawn with the world, shows
   through it."
  (draw-sprite2d-xy buf x y w 1 (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf x (+ y h -1) w 1 (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf x y 1 h (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf (+ x w -1) y 1 h (static-rgba 255 255 255 75) #x3fffff)
  (none)
  )

;; The pause page (START while the mode is on): its entries, and the request each hands the director
;; once the page is closed (BF_REQ_NONE: back to the battle).
(defconstant BF_PAUSE_COUNT 6)
(defconstant BF_PAUSE_REDEPLOY 2) ;; its Redeploy: the class page at once, its class and respawn point (round 30)
(define *bf-pause-reqs*
  (new 'static 'array int32 6 0 1 5 4 3 7)
  )

(defun bf-pause-label ((i int))
  "Label of entry I of the pause page. Redeploy in combat (`*bf*` redeploy-ok? off) costs a unit."
  (case i
    ((0) (bf-tr "Resume" "Reprendre"))
    ((1) (bf-tr "New battle" "Nouvelle bataille"))
    ((2) (if (or (-> *bf* redeploy-ok?) (not (bf-can-redeploy?)))
             (bf-tr "Redeploy" "Se redéployer")
             (bf-tr "Redeploy (lose a unit)" "Se redéployer (une perte)")
             )
     )
    ((3) (bf-tr "Restart the battle" "Recommencer la bataille"))
    ((4) (bf-tr "Quit the battle" "Quitter la bataille"))
    (else (bf-tr "Options" "Options"))
    )
  )

(defun bf-pause-ok? ((i int))
  "#t when entry I of the pause page can be chosen now (the others are grey)."
  (case i
    ((1) (not (bf-active?)))
    ((2) (bf-can-redeploy?))
    ((3) (bf-fighting?))
    ((4) (bf-active?))
    (else #t)
    )
  )

(defun bf-class-count ()
  "Classes of the player's side on the class page: the Freedom League's third and fourth, the
   Spargus Citizen and Jak, are no longer playable."
  (if (= (-> *bf* team) BF_TEAM_FF) 2 4)
  )

(defun bf-respawn-page? ()
  "#t when the open class page picks the dead player's respawn point too (the director's `respawn?`)."
  (let ((dir (the-as bf-director (handle->process (-> *bf* director)))))
    (and dir (-> dir respawn?))
    )
  )

(defun bf-page-count ((page int))
  "Number of choices of PAGE."
  (cond
    ((= page BF_PAGE_PAUSE) BF_PAUSE_COUNT)
    ((= page BF_PAGE_CONFIG) BF_CONFIG_COUNT)
    ;; the war zones, then Spargus, to come (grey, refused); Triangle goes back
    ((= page BF_PAGE_ZONE) (+ BF_ZONE_COUNT 1))
    ((= page BF_PAGE_TEAM) BF_TEAM_COUNT)
    ;; the Freedom League's third and fourth classes, the Spargus Citizen and Jak, are no longer
    ;; playable
    ;; its classes, its respawn point after a death (`respawn?`), its button
    ((= page BF_PAGE_CLASS) (+ (bf-class-count) (if (bf-respawn-page?) 2 1)))
    (else 1)
    )
  )

(defun bf-page-label ((page int) (team int) (i int))
  "Label of choice I of PAGE (TEAM picks the classes)."
  (cond
    ((= page BF_PAGE_ZONE)
     (cond
       ((< i BF_ZONE_COUNT) (bf-zone-name i))
       (else (bf-tr "Spargus (coming soon)" "Spargus (à venir)"))
       )
     )
    ((= page BF_PAGE_TEAM) (bf-team-name i))
    ((= page BF_PAGE_CLASS) (bf-class-name (+ (* team 4) i)))
    ((= page BF_PAGE_PAUSE) (bf-pause-label i))
    (else "")
    )
  )

(defun bf-page-desc ((page int) (team int) (i int))
  "Description of choice I of PAGE."
  (cond
    ((and (= page BF_PAGE_ZONE) (< i BF_ZONE_COUNT) (not (bf-zone-open? i)))
     (bf-tr "Made from your own Jak 2: install Jak 2 in the OpenGOAL Launcher, then reinstall this mod."
            "Faite à partir de votre propre Jak 2 : installez Jak 2 dans l'OpenGOAL Launcher, puis réinstallez ce mod."
            )
     )
    ((= page BF_PAGE_ZONE) (if (< i BF_ZONE_COUNT)
                               (bf-tr (-> *bf-zones* i desc) (-> *bf-zones* i desc-fr))
                               (bf-tr "The Wastelanders' desert city: coming in a later version."
                                      "La ville du désert des Wastelanders : dans une prochaine version."
                                      )
                               )
     )
    ((= page BF_PAGE_TEAM) (if (= i BF_TEAM_FF)
                               (bf-tr "Blue guards and jetpack guards."
                                      "Gardes bleus et gardes à jetpack."
                                      )
                               (bf-tr "Red Krimzon Guards, jetpack guards, robotguards and spider robots."
                                      "Gardes rouges, gardes à jetpack, robotgardes et araignées robots."
                                      )
                               )
     )
    ;; the class page draws its help lines itself (`bf-draw-class-page`)
    (else "")
    )
  )

;; The zone pages' map: the war zone's own minimap, the texture the game's minimap shows on its
;; battlefield (battlefront-minimaps.gc), framed on the battlefield in the right frame.
(deftype bf-zmap (structure)
  "Where the war zone's map goes (`bf-zone-view!`), in the 512 x 416 units: its center, at most half
   its height and half its width (round 31: the map alone, no disc around it)."
  ((x      float)
   (y      float)
   (half   float)
   (half-w float)
   )
  )

(define *bf-zmap* (new 'static 'bf-zmap :x 373.0 :y 206.0 :half 120.0 :half-w 96.0))

(defun bf-zmap-set! ((x float) (y float) (half float) (half-w float))
  "Place the war zone's map (`*bf-zmap*`): the HUD's (L3) at (373, 206), 120 by 96; each page its
   own (`bf-page-map`)."
  (set! (-> *bf-zmap* x) x)
  (set! (-> *bf-zmap* y) y)
  (set! (-> *bf-zmap* half) half)
  (set! (-> *bf-zmap* half-w) half-w)
  (none)
  )

(deftype bf-zone-view (structure)
  "Where `bf-zone-view!` puts a zone's map this frame: its box on the screen, and screen units per
   texel across and down."
  ((x0   float)
   (y0   float)
   (x1   float)
   (y1   float)
   (kx   float)
   (ky   float)
   )
  )

(define *bf-zone-view* (new 'static 'bf-zone-view))

;; Jak 2's city's map (round 40): no picture yet (its marks on the frame's dark background), its
;; size and corner fitted to the city's streets (x -700 to 1400 m, z -1000 to 2150 m), the shape of
;; Jak 3's map (256 x 384 texels, 8.2 m each).
(define *bf-zone-jak2-map-size* (new 'static 'array int32 3 256 384 256))
(define *bf-zone-jak2-map-corner* (new 'static 'array float 3 -2867200.0 -4096000.0 33587.2))

(defun bf-zone-map-size ((zone int) (k int))
  "ZONE's map: stored width (K 0), height (1), width the map fills (2), in texels
   (battlefront-minimaps.gc, or Jak 2's city's)."
  (if (= zone BF_ZONE_JAK2)
      (-> *bf-zone-jak2-map-size* k)
      (-> *bf-zone-minimap-size* (+ (* 3 zone) k))
      )
  )

(defun bf-zone-map-corner ((zone int) (k int))
  "ZONE's map: world x (K 0) and z (1) of its top left corner, and the world units a texel covers (2)."
  (if (= zone BF_ZONE_JAK2)
      (-> *bf-zone-jak2-map-corner* k)
      (-> *bf-zone-minimap-corner* (+ (* 3 zone) k))
      )
  )

(defun bf-zone-view! ((zone int))
  "Fit ZONE's whole map (battlefront-minimaps.gc: the minimap of its district) in the right frame,
   centered, its shape kept, into `*bf-zone-view*`. A texel is square in the world: on the 512 x 416
   screen stretched to the display, it is `bf-x-squeeze` times wider than tall in units."
  (let* ((view *bf-zone-view*)
         (w (the float (bf-zone-map-size zone 2)))
         (h (the float (bf-zone-map-size zone 1)))
         (aspect (bf-x-squeeze))
         (ky (fmin (/ (* 2.0 (-> *bf-zmap* half)) h) (/ (* 2.0 (-> *bf-zmap* half-w)) (* w aspect))))
         (kx (* ky aspect))
         )
    (set! (-> view kx) kx)
    (set! (-> view ky) ky)
    (set! (-> view x0) (- (-> *bf-zmap* x) (* 0.5 kx w)))
    (set! (-> view x1) (+ (-> *bf-zmap* x) (* 0.5 kx w)))
    (set! (-> view y0) (- (-> *bf-zmap* y) (* 0.5 ky h)))
    (set! (-> view y1) (+ (-> *bf-zmap* y) (* 0.5 ky h)))
    )
  #t
  )

(defun bf-map-sprite ((buf dma-buffer) (zone int))
  "The uploaded map of ZONE into BUF over the view's box (`*bf-zone-view*`), white so the texture
   shows its own colors: its texels from 0 to the width the map fills, and its height. bigmap.gc
   sprite-dma with the texels and the box as arguments (screen x from 1792, GS y from 1840)."
  (let ((p (the-as (inline-array vector4w) (-> buf base)))
        (view *bf-zone-view*)
        )
    (set! (-> p 0 quad) (-> *bigmap* sprite-tmpl dma-vif quad))
    (set! (-> p 1 quad) (-> *bigmap* sprite-tmpl quad 1))
    (set-vector! (-> p 2) 128 128 128 128)
    (set-vector! (-> p 3) 0 0 0 0)
    (set-vector! (-> p 4) (* (+ (the int (-> view x0)) 1792) 16) (* (+ (the int (-> view y0)) 1840) 16) #xfffff0 0)
    (set-vector! (-> p 5)
                 (* 16 (bf-zone-map-size zone 2))
                 (* 16 (bf-zone-map-size zone 1))
                 0
                 0
                 )
    (set-vector! (-> p 6) (* (+ (the int (-> view x1)) 1792) 16) (* (+ (the int (-> view y1)) 1840) 16) #xfffff0 0)
    )
  (&+! (-> buf base) 112)
  (none)
  )

(defun bf-draw-zone-minimap ((zone int))
  "Zone and side pages: ZONE's map (battlefront-minimaps.gc, the minimap of its whole district) in
   the right frame (`bf-zone-view!`), its marks drawn over it by `bf-draw-map-marks`. Its texels
   are uploaded the way the START menu's map uploads its own (bigmap.gc bigmap-method-20,
   `pc-upload-map-texture`: 8-bit texels into the texture at tbp 8, with their ct32 palette), then
   drawn as one sprite in a bucket of their own, under the page's. The upload marks the default
   level's VRAM dirty, as the START menu's map does."
  (bf-zone-view! zone)
  ;; Jak 2's city has no picture yet: its marks alone
  (when (!= zone BF_ZONE_JAK2)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id tex-hud-hud-alpha))
    (dma-buffer-add-gs-set buf
                           (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                           (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                           (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
                           )
    (pc-upload-map-texture buf
                           (the-as pointer (&-> *bf-zone-minimap-texels* (-> *bf-zone-minimap-offset* zone)))
                           (the-as pointer (&-> *bf-zone-minimap-clut* 0))
                           (-> *bf-zone-minimap-size* (* 3 zone))
                           (-> *bf-zone-minimap-size* (+ (* 3 zone) 1))
                           8
                           0
                           )
    (dma-buffer-add-gs-set buf
                           (tex0-1 (the-as gs-tex0 (-> *bf-zone-minimap-tex0* zone)))
                           (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                           (texflush 0)
                           )
    (bf-map-sprite buf zone)
    )
  (set-dirty-mask! (-> *level* level-default) 4 #x1a400 0)
  )
  (none)
  )

(defun bf-draw-tri ((buf dma-buffer) (x0 float) (y0 float) (x1 float) (y1 float) (x2 float) (y2 float) (color rgba))
  "A filled triangle of COLOR with corners (X0, Y0), (X1, Y1), (X2, Y2) in the screen units of
   `draw-sprite2d-xy` (display.gc), whose GIF packet this copies with a triangle primitive: its
   prim, color, three vertices and the color again (six registers: a whole number of quadwords)."
  (let ((start (-> buf base)))
    (let ((pkt (the-as dma-packet (-> buf base))))
      (set! (-> pkt dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
      (set! (-> pkt vif0) (new 'static 'vif-tag))
      (set! (-> pkt vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer pkt) 16))
      )
    (let ((tag (the-as gs-gif-tag (-> buf base))))
      (set! (-> tag tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :flg (gif-flag reg-list) :nreg #x6))
      (set! (-> tag regs) (new 'static 'gif-tag-regs
                            :regs1 (gif-reg-id rgbaq)
                            :regs2 (gif-reg-id xyzf2)
                            :regs3 (gif-reg-id xyzf2)
                            :regs4 (gif-reg-id xyzf2)
                            :regs5 (gif-reg-id rgbaq)
                            )
            )
      (set! (-> buf base) (&+ (the-as pointer tag) 16))
      )
    (let ((d (-> buf base)))
      (set! (-> (the-as (pointer gs-prim) d) 0) (new 'static 'gs-prim :prim (gs-prim-type tri) :abe #x1))
      (set! (-> (the-as (pointer gs-rgbaq) d) 1) (the-as gs-rgbaq color))
      (set! (-> (the-as (pointer gs-xyzf) d) 2)
            (new 'static 'gs-xyzf :x (the int (* 16.0 (+ 1792.0 x0))) :y (the int (* 16.0 (+ 1840.0 y0))) :z #x3fffff)
            )
      (set! (-> (the-as (pointer gs-xyzf) d) 3)
            (new 'static 'gs-xyzf :x (the int (* 16.0 (+ 1792.0 x1))) :y (the int (* 16.0 (+ 1840.0 y1))) :z #x3fffff)
            )
      (set! (-> (the-as (pointer gs-xyzf) d) 4)
            (new 'static 'gs-xyzf :x (the int (* 16.0 (+ 1792.0 x2))) :y (the int (* 16.0 (+ 1840.0 y2))) :z #x3fffff)
            )
      (set! (-> (the-as (pointer gs-rgbaq) d) 5) (the-as gs-rgbaq color))
      (set! (-> buf base) (&+ d 48))
      )
    ;; the DMA tag and the VIF direct count the quadwords after the tag
    (let ((qwc (/ (the-as int (+ (- -16 (the-as int start)) (the-as int (-> buf base)))) 16)))
      (logior! (-> (the-as (pointer uint64) start) 0) (shr (shl qwc 48) 48))
      (logior! (-> (the-as (pointer uint64) start) 1) (shl (shr (shl qwc 48) 48) 32))
      )
    )
  (none)
  )

(defun bf-draw-disc ((buf dma-buffer) (x float) (y float) (r float) (color rgba))
  "A filled disc of COLOR, radius R, centered on (X, Y): eight triangles (`bf-draw-tri`). The screen
   units are 512 wide, so a disc keeps its roundness with the screen's width (`bf-x-squeeze`)."
  (let ((rx (* r (bf-x-squeeze))))
    (dotimes (k 8)
      (let ((a0 (* 8192.0 (the float k)))
            (a1 (* 8192.0 (the float (+ k 1))))
            )
        (bf-draw-tri buf x y
                     (+ x (* rx (sin a0))) (+ y (* r (cos a0)))
                     (+ x (* rx (sin a1))) (+ y (* r (cos a1)))
                     color
                     )
        )
      )
    )
  (none)
  )

(defmacro bf-draw-quad (buf x0 y0 x1 y1 x2 y2 x3 y3 color)
  "A filled quad of COLOR, corners (X0, Y0) to (X3, Y3) in order around it: two triangles
   (`bf-draw-tri`), in the screen units of `draw-sprite2d-xy`. A macro: a function takes 8
   arguments at most."
  `(let ((qx0 ,x0)
         (qy0 ,y0)
         (qx2 ,x2)
         (qy2 ,y2)
         (qc ,color)
         )
     (bf-draw-tri ,buf qx0 qy0 ,x1 ,y1 qx2 qy2 qc)
     (bf-draw-tri ,buf qx0 qy0 qx2 qy2 ,x3 ,y3 qc)
     )
  )

(defun bf-draw-line ((buf dma-buffer) (x0 float) (y0 float) (x1 float) (y1 float) (w float) (color rgba))
  "A line of COLOR, W screen units thick, from (X0, Y0) to (X1, Y1): a quad (`bf-draw-quad`)."
  (let* ((dx (- x1 x0))
         (dy (- y1 y0))
         (len (fmax 0.001 (sqrtf (+ (* dx dx) (* dy dy)))))
         (nx (* (/ (- dy) len) 0.5 w))
         (ny (* (/ dx len) 0.5 w))
         )
    (bf-draw-quad buf (+ x0 nx) (+ y0 ny) (+ x1 nx) (+ y1 ny) (- x1 nx) (- y1 ny) (- x0 nx) (- y0 ny) color)
    )
  (none)
  )

(defun bf-draw-ring ((buf dma-buffer) (x float) (y float) (r0 float) (r1 float) (color rgba))
  "A ring of COLOR around (X, Y), from radius R0 to R1: sixteen quads (`bf-draw-quad`), round with
   the screen's width (`bf-x-squeeze`) as `bf-draw-disc`."
  (let ((sx (bf-x-squeeze)))
    (dotimes (k 16)
      (let ((a0 (* 4096.0 (the float k)))
            (a1 (* 4096.0 (the float (+ k 1))))
            )
        (bf-draw-quad buf
                      (+ x (* sx r0 (sin a0))) (+ y (* r0 (cos a0)))
                      (+ x (* sx r1 (sin a0))) (+ y (* r1 (cos a0)))
                      (+ x (* sx r1 (sin a1))) (+ y (* r1 (cos a1)))
                      (+ x (* sx r0 (sin a1))) (+ y (* r0 (cos a1)))
                      color
                      )
        )
      )
    )
  (none)
  )

(defun bf-draw-portrait ((class int) (x float) (y float) (w float) (h float))
  "CLASS's picture (battlefront-portraits.gc, made by scripts/battlefront/make_portraits.py) into
   BUF, centered in the box X, Y, W, H as large as it fits, its proportions kept on the display
   (`bf-x-squeeze`): the round 30 class page shows it in place of a turning model (the author's
   wish: no model to load). Uploaded as the war zone's map is (`bf-draw-zone-minimap`, the same
   texture place), in a texture bucket of its own after the map's and the page's (an upload in the
   page's text bucket stopped the game: its renderer takes no PC texture upload), then one sprite
   of its cell, its background transparent."
  (let ((k (-> *bf-portrait-cell* class)))
    (when (>= k 0)
     (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id tex-hud-pris2))
      (let* ((ph (fmin h (/ (* w BF_PORTRAIT_H) (* BF_PORTRAIT_W (bf-x-squeeze)))))
             (pw (* ph (/ (the float BF_PORTRAIT_W) (the float BF_PORTRAIT_H)) (bf-x-squeeze)))
             (x0 (+ x (* 0.5 (- w pw))))
             (y0 (+ y (* 0.5 (- h ph))))
             (u0 (* k BF_PORTRAIT_W))
             )
        (dma-buffer-add-gs-set buf
                               (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                               (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                               (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
                               )
        (pc-upload-map-texture buf
                               (the-as pointer (&-> *bf-portrait-texels* 0))
                               (the-as pointer (&-> *bf-portrait-clut* 0))
                               BF_PORTRAIT_TEX_W
                               BF_PORTRAIT_TEX_H
                               8
                               0
                               )
        (dma-buffer-add-gs-set buf
                               (tex0-1 (the-as gs-tex0 (-> *bf-portrait-tex0* 0)))
                               (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                               (texflush 0)
                               )
        (let ((p (the-as (inline-array vector4w) (-> buf base))))
          (set! (-> p 0 quad) (-> *bigmap* sprite-tmpl dma-vif quad))
          (set! (-> p 1 quad) (-> *bigmap* sprite-tmpl quad 1))
          (set-vector! (-> p 2) 128 128 128 128)
          (set-vector! (-> p 3) (* 16 u0) 0 0 0)
          (set-vector! (-> p 4) (* (+ (the int x0) 1792) 16) (* (+ (the int y0) 1840) 16) #xfffff0 0)
          (set-vector! (-> p 5) (* 16 (+ u0 BF_PORTRAIT_W)) (* 16 BF_PORTRAIT_H) 0 0)
          (set-vector! (-> p 6) (* (+ (the int (+ x0 pw)) 1792) 16) (* (+ (the int (+ y0 ph)) 1840) 16) #xfffff0 0)
          )
        (&+! (-> buf base) 112)
        )
      )
      (set-dirty-mask! (-> *level* level-default) 4 #x1a400 0)
      )
    )
  (none)
  )

(defun bf-zone-xy ((zone int) (p vector) (out vector))
  "OUT x and y get world point P on ZONE's map in the right frame (`*bf-zone-view*`); returns #f when
   it falls outside the frame."
  (let* ((view *bf-zone-view*)
         (texel (bf-zone-map-corner zone 2))
         (tx (/ (- (-> p x) (bf-zone-map-corner zone 0)) texel))
         (ty (/ (- (-> p z) (bf-zone-map-corner zone 1)) texel))
         )
    (set! (-> out x) (+ (-> view x0) (* (-> view kx) tx)))
    (set! (-> out y) (+ (-> view y0) (* (-> view ky) ty)))
    (and (< (-> view x0) (-> out x)) (< (-> out x) (-> view x1)) (< (-> view y0) (-> out y)) (< (-> out y) (-> view y1)))
    )
  )

(define-extern bf-menu-back (function none :behavior bf-director))
(define-extern bf-draw-map-marks (function dma-buffer int int none))
(define-extern bf-director-ensure! (function none))

;; Indexed by BF_WEAPON_*: the gun (pickup-type) whose icon the stock gun HUD shows for a guard's
;; weapon: the rifle yellow 1, the tazer blue 2, the grenade launcher red 3; for the rockets and the
;; robotguard's grenades the red 3, whose icon the HUD hides and draws theirs over
;; (`bf-draw-pixel-icon`).
(define *bf-hud-weapons* (new 'static 'array int32 5 29 33 28 28 28))

(defun bf-gun-hud-weapon ()
  "BF_WEAPON_* the gun HUD shows, during a fight with the class model up: a guard's weapon in hand, a
   jetpack guard's rockets (BF_WEAPON_ROCKET, round 36), a robotguard's grenades
   (BF_WEAPON_BOT_GRENADE, round 38); -1 otherwise (the spider has no ammo: no gun HUD)."
  (cond
    ((not (and (bf-fighting?) (bf-avatar-alive?))) -1)
    ((bf-guard-class? (-> *bf* class)) (-> *bf* weapon))
    ((or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK)) BF_WEAPON_ROCKET)
    ((= (-> *bf* class) BF_CLASS_ROBOGUARD) BF_WEAPON_BOT_GRENADE)
    (else -1)
    )
  )

(define-perm *bf-stock-gun-update* (function hud-gun none)
             (method-of-type hud-gun update-values!)
             )

(defmethod update-values! ((this hud-gun))
  "Jak's gun HUD (hud-classes.gc), top right. During a fight it shows a guard's weapon in place of
   Jak's gun, which the battle puts away: the stock icon of the weapon (`*bf-hud-weapons*`); its
   ammo is drawn by the `draw` below. Otherwise the stock handling, which hides it while Jak has no
   gun out."
  (let ((weapon (bf-gun-hud-weapon)))
    (cond
      ((>= weapon 0)
       (set! (-> this values 0 target) (-> *bf-hud-weapons* weapon))
       (set! (-> this values 1 target) 1)
       (logclear! (-> this flags) (hud-flags disable))
       (logior! (-> this flags) (hud-flags show))
       ((method-of-type hud update-values!) this)
       )
      (else
        (*bf-stock-gun-update* this)
        )
      )
    )
  (none)
  )

(define-perm *bf-stock-gun-draw* (function hud-gun none)
             (method-of-type hud-gun draw)
             )

(define *bf-gun-text* (new 'global 'string 32 (the-as string #f)))


;; The icons' widths on the 512-unit screen: the rocket a little under the stock gun icon's 128 (the
;; author's wish, round 37), the robotguard's grenade, a shorter drawing, narrower (round 38).
(defconstant BF_ROCKET_ICON_DRAW_W 100.0)
(defconstant BF_GRENADE_ICON_DRAW_W 64.0)

(defun bf-draw-pixel-icon ((buf dma-buffer) (cx float) (cy float) (grenade? symbol))
  "One of the gun HUD's pixel-art icons into BUF (a direct bucket), centered on CX, CY (the 512 x 416
   screen of the HUD's sprites), its art pixels square on the display (`bf-x-squeeze`): the jetpack's
   rocket, BF_ROCKET_ICON_DRAW_W across, or with GRENADE? the robotguard's grenade,
   BF_GRENADE_ICON_DRAW_W across. Each is one of the author's drawings (battlefront-icons.gc, made by
   scripts/battlefront/make_hud_icons.py) as one flat sprite per run of one color, all in one GIF
   packet (draw-sprite2d-xy's, display.gc, looped). A texture uploaded as the L3 map's never
   showed in a fight, whatever its bucket."
  (let* ((colors (if grenade? *bf-grenade-icon-colors* *bf-rocket-icon-colors*))
         (runs (if grenade? *bf-grenade-icon-runs* *bf-rocket-icon-runs*))
         (count (if grenade? BF_GRENADE_ICON_RUNS BF_ROCKET_ICON_RUNS))
         (draw-w (if grenade? BF_GRENADE_ICON_DRAW_W BF_ROCKET_ICON_DRAW_W))
         (px (/ draw-w (the float (if grenade? BF_GRENADE_ICON_W BF_ROCKET_ICON_W))))
         (py (/ px (bf-x-squeeze)))
         (x0 (- cx (* 0.5 draw-w)))
         (y0 (- cy (* 0.5 py (the float (if grenade? BF_GRENADE_ICON_H BF_ROCKET_ICON_H)))))
         (pkt (the-as dma-packet (-> buf base)))
         )
    ;; the DMA tag and the VIF direct count the GIF tag and 2 quadwords a run
    (set! (-> pkt dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc (+ 1 (* 2 count))))
    (set! (-> pkt vif0) (new 'static 'vif-tag))
    (set! (-> pkt vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1 :imm (+ 1 (* 2 count))))
    (&+! (-> buf base) 16)
    (let ((tag (the-as gs-gif-tag (-> buf base))))
      (set! (-> tag tag) (new 'static 'gif-tag64 :nloop count :eop #x1 :flg (gif-flag reg-list) :nreg #x4))
      (set! (-> tag regs) (new 'static 'gif-tag-regs :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2) :regs3 (gif-reg-id xyzf2)))
      )
    (&+! (-> buf base) 16)
    (dotimes (i count)
      (let* ((run (-> runs i))
             (d (-> buf base))
             (rx (+ x0 (* px (the float (logand run #xff)))))
             (ry (+ y0 (* py (the float (logand (shr run 8) #xff)))))
             (rw (* px (the float (logand (shr run 16) #xff))))
             )
        (set! (-> (the-as (pointer gs-prim) d) 0) (new 'static 'gs-prim :prim (gs-prim-type sprite) :abe #x1))
        (set! (-> (the-as (pointer gs-rgbaq) d) 1) (the-as gs-rgbaq (-> colors (shr run 24))))
        (set! (-> (the-as (pointer gs-xyzf) d) 2)
              (new 'static 'gs-xyzf :x (the int (* 16.0 (+ 1792.0 rx))) :y (the int (* 16.0 (+ 1840.0 ry))) :z #x3fffff)
              )
        (set! (-> (the-as (pointer gs-xyzf) d) 3)
              (new 'static 'gs-xyzf :x (the int (* 16.0 (+ 1792.0 rx rw))) :y (the int (* 16.0 (+ 1840.0 ry py))) :z #x3fffff)
              )
        (&+! (-> buf base) 32)
        )
      )
    )
  (none)
  )

(defun bf-draw-rocket-hud ((buf dma-buffer))
  "The director's HUD, each frame of a fight: into BUF, a jetpack guard's rocket icon or a
   robotguard's grenade icon (round 38) where the gun HUD shows a weapon's (`bf-draw-pixel-icon`),
   while that HUD is up (not hidden), placed from its sprite 0 (the stock reticle at the icon's right
   end: the icon's middle 52 units left of it, 9 below its top, where the stock icon was measured),
   which moves as the HUD slides in. Its count and shells are the gun HUD's (`bf-draw-gun-ammo`)."
  (let ((weapon (bf-gun-hud-weapon)))
    (when (and *target* (or (= weapon BF_WEAPON_ROCKET) (= weapon BF_WEAPON_BOT_GRENADE)))
      (let ((hg (the-as hud-gun (process-by-name "hud-gun" *target*))))
        (if (and hg (not (hidden? hg)))
            (bf-draw-pixel-icon buf (+ -52.0 (the float (-> hg sprites 0 pos x))) (+ 9.0 (the float (-> hg sprites 0 pos y)))
                                (= weapon BF_WEAPON_BOT_GRENADE)
                                )
            )
        )
      )
    )
  (none)
  )

(defun bf-draw-gun-ammo ((this hud-gun) (weapon int))
  "Under the guard's weapon icon, in place of the stock count and shells: the rifle's magazine as 20
   shells in two columns of 10, full or empty, and \"magazine/reserve\" (20/100); the grenades as 5 shells and their
   count; for the tazer no ammo, only the seconds left while it recharges, in red. Placed as the
   stock draw places its own (hud-classes.gc hud-gun draw: the shells from the icon's position, 5
   units apart upward; the text at the spot it gave its string)."
  (let* ((rifle? (= weapon BF_WEAPON_RIFLE))
         ;; the rockets and the robotguard's grenades (round 38) count from `*bf*` rockets
         (rocket? (or (= weapon BF_WEAPON_ROCKET) (= weapon BF_WEAPON_BOT_GRENADE)))
         (slots (cond
                  (rifle? BF_MAG_RIFLE)
                  ((= weapon BF_WEAPON_GRENADE) (the int BF_GRENADES))
                  (rocket? BF_ROCKETS)
                  (else 0)
                  )
                )
         (full (cond
                 (rifle? (-> *bf* mag BF_WEAPON_RIFLE))
                 ((= weapon BF_WEAPON_GRENADE) (the int (-> *game-info* gun-ammo BF_AMMO_RED)))
                 (rocket? (-> *bf* rockets))
                 (else 0)
                 )
               )
         (shell (-> this sprites 14))
         )
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id hud-draw-hud-alpha)
                                 )
      (when (> slots 0)
        ;; the stock offsets for these icons: rifle (yellow) 10 and 7, launcher (red) 23 and -2
        (set-as-offset-from! shell (-> this sprites 0 pos) (if rifle? -58 -45) (if rifle? 129 120))
        (set! (-> shell scale-x) 1.0)
        (dotimes (i slots)
          ;; past 10 shells, a second column beside the first
          (when (= i 10)
            (+! (-> shell pos x) 7)
            (+! (-> shell pos y) 50)
            )
          (set! (-> shell tid)
                (the-as texture-id (cond
                                     ((>= i full) (get-texture hud-gun-empty-shell-01 level-default-minimap))
                                     (rifle? (get-texture hud-gun-yellow-shell-01 level-default-minimap))
                                     ;; the robotguard's grenades, the dark ammo they come from (round 38)
                                     ((= weapon BF_WEAPON_BOT_GRENADE) (get-texture hud-gun-purple-shell-01 level-default-minimap))
                                     (else (get-texture hud-gun-red-shell-01 level-default-minimap))
                                     )
                        )
                )
          (draw shell buf (-> this level) #f)
          (+! (-> shell pos y) -5)
          )
        (set! (-> shell scale-x) 0.0)
        )
      (clear *bf-gun-text*)
      (cond
        (rifle?
         (format *bf-gun-text* "~D/~D" full (the int (-> *game-info* gun-ammo BF_AMMO_YELLOW)))
         )
        ((or (= weapon BF_WEAPON_GRENADE) rocket?)
         (format *bf-gun-text* "~D" full)
         )
        ((not (bf-tazer-ready?))
         (format *bf-gun-text* "~D" (+ 1 (/ (- BF_TAZER_RECHARGE (- (current-time) (-> *bf* tazer-time))) (seconds 1))))
         )
        )
      (when (nonzero? (length *bf-gun-text*))
        (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
          (set-vector! (-> font origin)
                       (the float (-> this strings 0 pos x))
                       (the float (-> this strings 0 pos y))
                       (the float (-> this strings 0 pos z))
                       1.0
                       )
          (set! (-> font scale) 0.4)
          (set! (-> font flags) (font-flags kerning middle large))
          (set! (-> font color) (if (or (zero? full) (= weapon BF_WEAPON_TAZER)) (font-color red) (font-color white)))
          (set-context! *font-work* font)
          (draw-string *bf-gun-text* buf font)
          )
        )
      )
    )
  (none)
  )

(defmethod draw ((this hud-gun))
  "Jak's gun HUD drawn. For a guard's weapon (`bf-gun-hud-weapon`): the stock icon, without its
   stock count and shells (scaled to nothing for the call: they show Jak's own ammo against its
   stock maximum), then the guard's ammo (`bf-draw-gun-ammo`). Otherwise the stock draw."
  (let ((weapon (bf-gun-hud-weapon)))
    (cond
      ((< weapon 0)
       (*bf-stock-gun-draw* this)
       )
      (else
        (let ((text-scale (-> this strings 0 scale))
              (shell-y (-> this sprites 14 scale-y))
              )
          (set! (-> this strings 0 scale) 0.0)
          (set! (-> this sprites 14 scale-y) 0.0)
          ;; the rockets and the robotguard's grenades: the stock icon see-through (sprites 0 and 1, whose scales the stock draw sets
          ;; itself) and its reticle (sprite 15, whose color it sets) shrunk to nothing; the director
          ;; draws the rocket's in its place (`bf-draw-rocket-hud`)
          (when (or (= weapon BF_WEAPON_ROCKET) (= weapon BF_WEAPON_BOT_GRENADE))
            (set! (-> this sprites 0 color w) 0)
            (set! (-> this sprites 1 color w) 0)
            (set! (-> this sprites 15 scale-x) 0.0)
            )
          (*bf-stock-gun-draw* this)
          (set! (-> this strings 0 scale) text-scale)
          (set! (-> this sprites 14 scale-y) shell-y)
          (when (or (= weapon BF_WEAPON_ROCKET) (= weapon BF_WEAPON_BOT_GRENADE))
            (set! (-> this sprites 0 color w) 128)
            (set! (-> this sprites 1 color w) 128)
            (set! (-> this sprites 15 scale-x) 1.0)
            )
          )
        (if (not (hidden? this))
            (bf-draw-gun-ammo this weapon)
            )
        )
      )
    )
  (none)
  )

(defun bf-class-gauge ()
  "Level (0 to 1) of the class's gauge: the jetpack's boost, the spider's blue eco, or the
   robotguard's shield (draining while it is up, then refilling until it can go up again); -1.0
   for none. The shield's times are the avatar's clock: the HUD runs on another one, and read on
   it the gauge came back full at once while the shield still recharged."
  (let ((av (the-as bf-avatar (handle->process (-> *bf* avatar))))
        (class (-> *bf* class))
        )
    (cond
      ((not av) -1.0)
      ((or (= class BF_CLASS_BLUE_JETPACK) (= class BF_CLASS_RED_JETPACK)) (-> av fuel))
      ((= class BF_CLASS_SPYDROID) (-> av boost))
      ((= class BF_CLASS_ROBOGUARD)
       (let ((since (the float (- (-> av clock frame-counter) (-> av shield-time)))))
         (cond
           ((-> av shield?) (fmax 0.0 (- 1.0 (/ since (the float BF_SHIELD_TIME)))))
           ((zero? (-> av shield-time)) 1.0)
           (else (fmin 1.0 (/ since (the float BF_SHIELD_RECHARGE))))
           )
         )
       )
      (else -1.0)
      )
    )
  )

;; The crosshair sprite: Jak's gun reticle texture (hud-gun).
(define *bf-reticle* (new 'static 'hud-sprite))

(defun bf-draw-reticle ()
  "The crosshair, fixed above the screen's center where the free aim's ray goes (`bf-free-aim`),
   red when the ray meets a foe. While the tazer locks a foe by itself (`bf-avatar-update-aim`), it
   moves onto that foe. A HUD sprite, so it goes in the HUD's sprite bucket."
  (bf-free-aim)
  (let ((av (the-as bf-avatar (handle->process (-> *bf* avatar))))
        (spr *bf-reticle*)
        (x BF_CROSS_X)
        (y BF_CROSS_Y)
        (foe? (if (handle->process (-> *bf* aim-foe)) #t #f))
        )
    (when (and av (-> av locked?))
      (let ((scr (new 'stack-no-clear 'vector)))
        ;; screen point in GS units: the screen's origin is at (1792, 1840) (bigmap.gc)
        (when (transform-point-vector! scr (-> av aim))
          (set! x (- (-> scr x) 1792.0))
          (set! y (- (-> scr y) 1840.0))
          (set! foe? #t)
          )
        )
      )
    (set! (-> spr tid) (the-as texture-id (get-texture hud-gun-reticle level-default-minimap)))
    (set! (-> spr flags) (hud-sprite-flags hsf3))
    ;; a guard's crosshair as wide as its rifle's spread (battlefront-player.gc `bf-avatar-spread`):
    ;; small kneeling, larger on the move
    (let ((size (if (and av (< 0.0 (-> av spread)))
                    (+ 0.7 (* 0.8 (/ (-> av spread) (degrees 3.5))))
                    1.0
                    )
                )
          )
      (set! (-> spr scale-x) size)
      (set! (-> spr scale-y) size)
      )
    (set! (-> spr angle) 0.0)
    (set-vector! (-> spr pos) (the int x) (the int y) #xffffff 0)
    (set-vector! (-> spr color) 128 (if foe? 32 128) (if foe? 32 128) 128)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id hud-draw-hud-alpha))
      (draw spr buf (-> *level* level-default) #f)
      )
    )
  (none)
  )

(defbehavior bf-hud-health-update bf-director ((on? symbol))
  "Jak's health HUD (hud-classes.gc hud-health) during the fight (ON?): asked to show every second,
   so it stays up. Its class gauge is `bf-hud-health-gauges`."
  (let ((hud (the-as hud (and *target* (process-by-name "hud-health" *target*)))))
    (when (and hud on? (time-elapsed? (-> self hud-time) (seconds 1)))
      (set-time! (-> self hud-time))
      (send-event hud 'show)
      )
    )
  (none)
  )

(defun bf-hud-health-gauges ((hud hud))
  "Called by hud-health's draw (hud-classes.gc) once it has set its eco gauges and before its
   sprites are drawn. During a fight, the class's gauge (`bf-class-gauge`) takes the place of one of
   them, its stock sprite at the stock scale, with the class's color: the jetpack's fuel in the dark
   eco gauge (sprite 2, the right half; its color, the bright one it takes when Jak has eco enough
   for a dark bomb), the spider's blue eco and the robotguard's roll in the light eco gauge (sprite
   1, the left half) in blue and in red. The battle keeps Jak's own light and dark eco at 0. Drawn
   before the ring, as the stock gauges, the ring's windows shape them; a sprite drawn after the
   ring was hidden behind it (seen in game). The spider's blast charge (`bf-nova-charge`, round 39)
   fills its dark eco gauge in orange."
  (let ((av (the-as bf-avatar (handle->process (-> *bf* avatar)))))
    (when (and av (bf-fighting?) (= (-> *bf* class) BF_CLASS_SPYDROID))
      (let ((pulse (+ 0.75 (* 0.25 (sin (degrees (the float (mod (-> *display* game-clock frame-counter) 360))))))))
        (set! (-> hud sprites 2 scale-y) (* -9.7 (bf-nova-charge av)))
        (set-vector! (-> hud sprites 2 color) (the int (* 128.0 pulse)) (the int (* 56.0 pulse)) (the int (* 8.0 pulse)) 128)
        )
      )
    )
  (let ((level (if (bf-fighting?) (bf-class-gauge) -1.0)))
    (when (<= 0.0 level)
      (let ((dark? (or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK)))
            ;; the stock gauges' pulse (hud-health draw), here 0.5 to 1: the stock one, 0 to 1, made
            ;; the fuel vanish on the dark disc half the time
            (pulse (+ 0.75 (* 0.25 (sin (degrees (the float (mod (-> *display* game-clock frame-counter) 360)))))))
            )
        (cond
          (dark?
            (set! (-> hud sprites 2 scale-y) (* -9.7 level))
            (set-vector! (-> hud sprites 2 color)
                         (the int (* 0.35 255.0 pulse))
                         (the int (* 25.5 pulse))
                         (the int (* 0.8 255.0 pulse))
                         128
                         )
            )
          (else
            (set! (-> hud sprites 1 scale-y) (* -9.8 level))
            (if (= (-> *bf* class) BF_CLASS_SPYDROID)
                (set-vector! (-> hud sprites 1 color) (the int (* 20.0 pulse)) (the int (* 60.0 pulse)) (the int (* 128.0 pulse)) 128)
                (set-vector! (-> hud sprites 1 color) (the int (* 128.0 pulse)) (the int (* 16.0 pulse)) (the int (* 16.0 pulse)) 128)
                )
            )
          )
        )
      )
    )
  (none)
  )


(defconstant BF_HUD_L 144.0)  ;; the reserve meter's top bar, left end (screen units, 512 wide)
(defconstant BF_HUD_R 368.0)  ;; its right end
(defconstant BF_HUD_T 6.0)    ;; its top
(defconstant BF_HUD_B 24.0)   ;; its bottom, where the counts' compartment hangs
(defconstant BF_HUD_C 42.0)   ;; the compartment's bottom

(defun bf-draw-reserves ((buf dma-buffer))
  "Top middle, the reinforcement meter as the author drew it (round 29): a wide, flat T in a
   semi-transparent slate blue with a thin light blue-grey border and a divider down its middle; in
   its top bar the two reserves fill outward from the middle, the Freedom League's in bright blue to
   the left, the Krimzon Guard's in bright red to the right, each as long as its reserve
   (BF_RESERVE fills it); under it, an inverted trapezoid holds the two counts on either side of the
   divider. Narrow enough to stay clear of the stock gun HUD top right."
  (let* ((l BF_HUD_L)
         (r BF_HUD_R)
         (top BF_HUD_T)
         (bot BF_HUD_B)
         (mid (* 0.5 (+ top bot)))
         (cb BF_HUD_C)
         (bev 9.0)
         (back (static-rgba 46 64 96 80))
         (edge (static-rgba 170 192 214 120))
         (track (static-rgba 20 24 34 90))
         (half (- 256.0 (+ l bev 3.0)))
         (full (the float (max 1 (-> *bf* reserve-max))))
         (ff (* half (fmin 1.0 (/ (the float (-> *bf* reserve BF_TEAM_FF)) full))))
         (kg (* half (fmin 1.0 (/ (the float (-> *bf* reserve BF_TEAM_KG)) full))))
         )
    ;; the background: the top bar, an elongated hexagon, then the compartment under its middle
    (bf-draw-quad buf (+ l bev) top (- r bev) top (- r bev) bot (+ l bev) bot back)
    (bf-draw-tri buf l mid (+ l bev) top (+ l bev) bot back)
    (bf-draw-tri buf r mid (- r bev) top (- r bev) bot back)
    (bf-draw-quad buf 200.0 bot 312.0 bot 298.0 cb 214.0 cb back)
    ;; the bars' tracks, then the two reserves from the middle outward
    (bf-draw-quad buf (- 254.0 half) (+ top 4.0) 254.0 (+ top 4.0) 254.0 (- bot 4.0) (- 254.0 half) (- bot 4.0) track)
    (bf-draw-quad buf 258.0 (+ top 4.0) (+ 258.0 half) (+ top 4.0) (+ 258.0 half) (- bot 4.0) 258.0 (- bot 4.0) track)
    (if (< 0.5 ff)
        (bf-draw-quad buf (- 254.0 ff) (+ top 4.0) 254.0 (+ top 4.0) 254.0 (- bot 4.0) (- 254.0 ff) (- bot 4.0) (static-rgba 40 140 255 128))
        )
    (if (< 0.5 kg)
        (bf-draw-quad buf 258.0 (+ top 4.0) (+ 258.0 kg) (+ top 4.0) (+ 258.0 kg) (- bot 4.0) 258.0 (- bot 4.0) (static-rgba 245 45 45 128))
        )
    ;; the border, the compartment's sides and the divider
    (bf-draw-line buf (+ l bev) top (- r bev) top 1.0 edge)
    (bf-draw-line buf (- r bev) top r mid 1.0 edge)
    (bf-draw-line buf r mid (- r bev) bot 1.0 edge)
    (bf-draw-line buf (- r bev) bot 312.0 bot 1.0 edge)
    (bf-draw-line buf 312.0 bot 298.0 cb 1.0 edge)
    (bf-draw-line buf 298.0 cb 214.0 cb 1.0 edge)
    (bf-draw-line buf 214.0 cb 200.0 bot 1.0 edge)
    (bf-draw-line buf 200.0 bot (+ l bev) bot 1.0 edge)
    (bf-draw-line buf (+ l bev) bot l mid 1.0 edge)
    (bf-draw-line buf l mid (+ l bev) top 1.0 edge)
    (bf-draw-line buf 256.0 top 256.0 cb 1.0 edge)
    ;; the counts
    (clear *bf-text*)
    (format *bf-text* "~D" (-> *bf* reserve BF_TEAM_FF))
    (bf-draw-text buf *bf-text* 232.0 (+ bot 3.0) 0.42 (font-color cyan) #t)
    (clear *bf-text*)
    (format *bf-text* "~D" (-> *bf* reserve BF_TEAM_KG))
    (bf-draw-text buf *bf-text* 280.0 (+ bot 3.0) 0.42 (font-color red) #t)
    ;; the time left, under the meter, when the battle has a limit
    (when (and (< 0 (-> *bf* time-limit)) (bf-fighting?))
      (let ((left (max 0 (- (* 60 (-> *bf* time-limit)) (/ (- (current-time) (-> *bf* phase-time)) (seconds 1))))))
        (clear *bf-text*)
        (format *bf-text* "~D:~2,'0D" (/ left 60) (mod left 60))
        (bf-draw-text buf *bf-text* 0.0 (+ cb 2.0) 0.38 (font-color default) #t)
        )
      )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Battle points: the sides' bases and the control points (`*bf*` points)
;; ---------------------------------------------------------------------------------------------

;; The points' beams, drawn each frame by `draw-beam` (gun-util.gc): the player's gun beam (gun-part.gc
;; part 231) lasting one frame, 150 m tall and 1.5 m wide, blue for the Freedom League, red for the
;; Krimzon Guard, white for a neutral point. Free ids above the stock 5154.
(defpart 5200
  :init-specs ((:texture (gun-blue-beam level-default-sprite))
    (:birth-func 'birth-func-setup-beam)
    (:num 1.0)
    (:scale-x (meters 1.5))
    (:scale-y (meters 150))
    (:r 40.0)
    (:g 90.0)
    (:b 255.0)
    (:a 80.0)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 left-multiply-quat))
    )
  )

(defpart 5201
  :init-specs ((:texture (gun-blue-beam level-default-sprite))
    (:birth-func 'birth-func-setup-beam)
    (:num 1.0)
    (:scale-x (meters 1.5))
    (:scale-y (meters 150))
    (:r 255.0)
    (:g 20.0)
    (:b 20.0)
    (:a 80.0)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 left-multiply-quat))
    )
  )

(defpart 5202
  :init-specs ((:texture (gun-blue-beam level-default-sprite))
    (:birth-func 'birth-func-setup-beam)
    (:num 1.0)
    (:scale-x (meters 1.5))
    (:scale-y (meters 150))
    (:r 255.0)
    (:g 255.0)
    (:b 255.0)
    (:a 64.0)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 left-multiply-quat))
    )
  )

(defun bf-points-setup ()
  "The battle's points as its fight starts: the two bases at the sides' spawns (`*bf*` spawn, point
   0 the Freedom League's, 1 the Krimzon Guard's), then a control point in each district, neutral,
   where `*bf-point-defs*` puts it."
  (set! (-> *bf* point-count) (-> *bf-point-defs* length))
  (set! (-> *bf* respawn-pick) -1)
  (set! (-> *bf* point-time) 0)
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (cond
        ((< i 2)
         (vector-copy! (-> pt pos) (-> *bf* spawn i))
         (set! (-> pt owner) i)
         (set! (-> pt base?) #t)
         )
        (else
          (let ((def (-> *bf-point-defs* i)))
            (set-vector! (-> pt pos) (meters (-> def x)) (meters (-> def y)) (meters (-> def z)) 1.0)
            )
          (set! (-> pt owner) BF_TEAM_NONE)
          (set! (-> pt base?) #f)
          )
        )
      (set! (-> pt prog-team) BF_TEAM_NONE)
      (set! (-> pt progress) 0.0)
      (set! (-> pt fight) 0.0)
      (set! (-> pt snapped?) #f)
      (set! (-> pt old-ship) (the-as handle #f))
      (set! (-> pt near 0) 0)
      (set! (-> pt near 1) 0)
      (set! (-> pt ship) (the-as handle #f))
      )
    )
  (none)
  )

(defun bf-point-name ((i int))
  "Name of point I in the game's language (`*bf-point-defs*`)."
  (bf-tr (-> *bf-point-defs* i name) (-> *bf-point-defs* i name-fr))
  )

(defun bf-point-rank ((i int))
  "Place of control point I in `*bf-point-order*` (battlefront-h.gc), 0 for the first; -1 for a
   base."
  (dotimes (r (bf-control-count))
    (if (= (-> *bf-point-order* r) i)
        (return r)
        )
    )
  -1
  )

;; A to O: Jak 2's city has 15 control points (round 40; Jak 3's 8 take A to H)
(define *bf-letters* (new 'static 'boxed-array :type string "A" "B" "C" "D" "E" "F" "G" "H" "I" "J" "K" "L" "M" "N" "O"))

(defun bf-point-letter ((i int))
  "Letter of control point I on the HUD and the minimap: A to H from the Krimzon Guard's base to the
   Freedom League's (`bf-point-rank`); \"?\" for a base, not lettered."
  (let ((r (bf-point-rank i)))
    (if (>= r 0)
        (-> *bf-letters* r)
        "?"
        )
    )
  )

(defun bf-point-live? ((pt bf-point))
  "#t when the section PT stands in is loaded with its streets: a nav mesh within 8 m (the game
   finds one in active levels only). Its fight is then the units' own (`bf-point-count`)."
  (if (find-nearest-nav-mesh (-> pt pos) (meters 8)) #t #f)
  )

(defun bf-point-pressure ((i int) (team int))
  "How many points next to point I (`*bf-point-links*`) side TEAM holds."
  (let ((n 0))
    (dotimes (k (-> *bf* point-count))
      (if (and (logtest? (-> *bf-point-links* i) (ash 1 k)) (= (-> *bf* points k owner) team))
          (+! n 1)
          )
      )
    n
    )
  )

(defconstant BF_FIGHT_LOSS 10.0) ;; seconds of a fight away from the player per unit each side loses

(defun bf-point-away ((i int) (dt float))
  "The fight for point I while its section is not loaded, DT seconds of it: no unit is there to
   count, so a side fights for it from the points next to it it holds (`bf-point-pressure`). A side
   alone at it captures it at the normal pace, at half pace when the holder holds a point next to
   it too; both sides at a neutral one, the one holding more neighbours; a tie holds it. Every
   BF_FIGHT_LOSS seconds of fight, each side there loses a unit (`bf-count-loss`)."
  (let* ((pt (-> *bf* points i))
         (owner (-> pt owner))
         (ff (if (= owner BF_TEAM_FF) 0 (bf-point-pressure i BF_TEAM_FF)))
         (kg (if (= owner BF_TEAM_KG) 0 (bf-point-pressure i BF_TEAM_KG)))
         (held (if (= owner BF_TEAM_NONE) 0 (bf-point-pressure i owner)))
         (major (cond
                  ((< kg ff) BF_TEAM_FF)
                  ((< ff kg) BF_TEAM_KG)
                  (else BF_TEAM_NONE)
                  )
                )
         (pace (if (< 0 held) 0.5 1.0))
         )
    (set! (-> pt near 0) 0)
    (set! (-> pt near 1) 0)
    (cond
      ((and (zero? ff) (zero? kg))
       ;; no one comes: a capture under way fades
       (set! (-> pt fight) 0.0)
       (set! (-> pt progress) (fmax 0.0 (- (-> pt progress) dt)))
       (if (= (-> pt progress) 0.0)
           (set! (-> pt prog-team) BF_TEAM_NONE)
           )
       )
      (else
        (+! (-> pt fight) dt)
        (when (>= (-> pt fight) BF_FIGHT_LOSS)
          (set! (-> pt fight) 0.0)
          (if (< 0 ff)
              (bf-count-loss BF_TEAM_FF)
              )
          (if (< 0 kg)
              (bf-count-loss BF_TEAM_KG)
              )
          (if (< 0 held)
              (bf-count-loss owner)
              )
          )
        (cond
          ((= major BF_TEAM_NONE)
           0
           )
          ((and (!= (-> pt prog-team) BF_TEAM_NONE) (!= (-> pt prog-team) major))
           (set! (-> pt progress) (fmax 0.0 (- (-> pt progress) dt)))
           (if (= (-> pt progress) 0.0)
               (set! (-> pt prog-team) major)
               )
           )
          (else
            (set! (-> pt prog-team) major)
            (+! (-> pt progress) (* pace dt))
            (when (>= (-> pt progress) BF_CAPTURE_TIME)
              (set! (-> pt owner) major)
              (set! (-> pt progress) 0.0)
              (set! (-> pt prog-team) BF_TEAM_NONE)
              (set! (-> pt fight) 0.0)
              (format 0 "battlefront: point ~S captured away from the player by side ~D~%" (bf-point-name i) major)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-point-count ((pt bf-point))
  "Units of each side within BF_POINT_RADIUS of PT now, into its near counts; the player counts with
   his side's, while his class model is up."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> pt pos)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        )
    (set! (-> pt near 0) 0)
    (set! (-> pt near 1) 0)
    (set! (-> probe w) BF_POINT_RADIUS)
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            ;; the actor hash can hold a process moved or gone since it was filled: its handle tells
            (when (and proc
                       (= (handle->process (process->handle proc)) proc)
                       (!= proc *target*)
                       (type? proc process-focusable)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (< (vector-vector-distance (-> (the-as process-focusable proc) root trans) (-> pt pos))
                          BF_POINT_RADIUS
                          )
                       )
              (let ((team (bf-unit-team proc)))
                (if (or (= team BF_TEAM_FF) (= team BF_TEAM_KG))
                    (+! (-> pt near team) 1)
                    )
                )
              )
            )
          )
        )
      )
    (when (and *target*
               (not (focus-test? *target* dead))
               (bf-avatar-alive?)
               (< (vector-vector-distance (-> *target* control trans) (-> pt pos)) BF_POINT_RADIUS)
               )
      (+! (-> pt near (-> *bf* team)) 1)
      )
    )
  (none)
  )

(defun bf-update-points ()
  "Four times a second during a fight: each control point's capture. In a loaded section
   (`bf-point-live?`) the side with more units within BF_POINT_RADIUS (`bf-point-count`) captures
   it: its progress grows by the time gone by, and at BF_CAPTURE_TIME seconds the point is its.
   Another side's capture under way is first taken back down to zero; a tie, or no one, holds it;
   the holder's majority takes a capture back down. Away from the player, `bf-point-away`."
  (when (or (zero? (-> *bf* point-time)) (time-elapsed? (-> *bf* point-time) (seconds 0.25)))
    (let ((dt (if (zero? (-> *bf* point-time))
                  0.0
                  (fmin 1.0 (* 0.0033333334 (the float (- (current-time) (-> *bf* point-time)))))
                  )
              )
          )
      (set-time! (-> *bf* point-time))
      (dotimes (i (-> *bf* point-count))
        (let ((pt (-> *bf* points i)))
          (cond
            ((-> pt base?)
             0
             )
            ((not (bf-point-live? pt))
             (bf-point-away i dt)
             )
            (else
          (bf-point-count pt)
          (set! (-> pt fight) 0.0)
            (let* ((ff (-> pt near BF_TEAM_FF))
                   (kg (-> pt near BF_TEAM_KG))
                   (major (cond
                            ((< kg ff) BF_TEAM_FF)
                            ((< ff kg) BF_TEAM_KG)
                            (else BF_TEAM_NONE)
                            )
                          )
                   )
              (cond
                ((= major BF_TEAM_NONE)
                 0
                 )
                ((or (= major (-> pt owner)) (and (!= (-> pt prog-team) BF_TEAM_NONE) (!= (-> pt prog-team) major)))
                 ;; the holder's majority, or another side's capture to undo first
                 (set! (-> pt progress) (fmax 0.0 (- (-> pt progress) dt)))
                 (when (= (-> pt progress) 0.0)
                   (set! (-> pt prog-team) (if (= major (-> pt owner)) BF_TEAM_NONE major))
                   )
                 )
                (else
                  (set! (-> pt prog-team) major)
                  (+! (-> pt progress) dt)
                  (when (>= (-> pt progress) BF_CAPTURE_TIME)
                    (set! (-> pt owner) major)
                    (set! (-> pt progress) 0.0)
                    (set! (-> pt prog-team) BF_TEAM_NONE)
                    (format 0 "battlefront: point ~S captured by side ~D~%" (bf-point-name i) major)
                    )
                  )
                )
              )
            )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-draw-points ()
  "Each frame of a fight: every point's beam from its ground up, in its holder's color, white while
   neutral (parts 5200 to 5202). draw-beam turns its part along the direction: straight up makes no
   rotation, so the beam leans 0.6 degrees."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (draw-beam (-> *part-id-table* (case (-> pt owner)
                                       ((BF_TEAM_FF) 5200)
                                       ((BF_TEAM_KG) 5201)
                                       (else 5202)
                                       )
                     )
                 (-> pt pos)
                 (new 'static 'vector :y 1.0 :z 0.01 :w 1.0)
                 #f
                 )
      )
    )
  (none)
  )

(defun bf-team-color ((team int))
  "Font color of side TEAM, white for none."
  (case team
    ((BF_TEAM_FF) (font-color cyan))
    ((BF_TEAM_KG) (font-color red))
    (else (font-color white))
    )
  )

(define-extern bf-draw-minimap-letters (function dma-buffer none))

(defun bf-draw-points-hud ((buf dma-buffer))
  "The control points: on the minimap, each one's mark (`bf-draw-minimap-letters`); under the
   reserves, only the point whose capture zone the player stands in (BF_POINT_RADIUS; the author's
   wish, round 29: until then all eight, A to H), its letter in its holder's color (white neutral)
   and, under it, the capture under way in percent in the capturing side's color, else its
   holder's hold (100 %, 0 % neutral)."
  (bf-draw-minimap-letters buf)
  (when *target*
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?))
                   (< (vector-vector-xz-distance (-> *target* control trans) (-> pt pos)) BF_POINT_RADIUS)
                   )
          (bf-draw-text buf (bf-point-letter i) 0.0 52.0 0.8 (bf-team-color (-> pt owner)) #t)
          (clear *bf-text*)
          (cond
            ((and (!= (-> pt prog-team) BF_TEAM_NONE) (< 0.0 (-> pt progress)))
             (format *bf-text* "~D%" (the int (* 100.0 (/ (-> pt progress) BF_CAPTURE_TIME))))
             (bf-draw-text buf *bf-text* 0.0 76.0 0.5 (bf-team-color (-> pt prog-team)) #t)
             )
            (else
              (format *bf-text* "~D%" (if (= (-> pt owner) BF_TEAM_NONE) 0 100))
              (bf-draw-text buf *bf-text* 0.0 76.0 0.5 (bf-team-color (-> pt owner)) #t)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-point-held? ((i int) (team int))
  "#t when point I is in use and side TEAM holds it."
  (and (>= i 0) (< i (-> *bf* point-count)) (= (-> *bf* points i owner) team))
  )

(defun bf-next-held-point ((from int) (team int) (step int))
  "The point side TEAM holds after (STEP 1) or before (STEP -1) point FROM, around the list; FROM
   when it holds no other."
  (let ((n (-> *bf* point-count))
        (i from)
        )
    (dotimes (k n)
      (set! i (mod (+ i step n) n))
      (if (bf-point-held? i team)
          (return i)
          )
      )
    from
    )
  )

;; L3 held now, and SELECT pressed with it (`bf-l3-tapped?`)
(define *bf-l3-held?* #f)
(define *bf-l3-select?* #f)

(defun bf-l3-tapped? ()
  "Every frame of the director: #t the frame L3 lets go after a press with no SELECT (L3 + SELECT
   opens the Mods menu, mods-menu.gc) and no zoom (L3 + the right stick, battlefront-player.gc
   `*bf-l3-zoomed?*`), else #f."
  (let ((held? (cpad-hold? 0 l3))
        (tap? #f)
        )
    (cond
      (held?
       (when (not *bf-l3-held?*)
         (set! *bf-l3-select?* #f)
         (set! *bf-l3-zoomed?* #f)
         )
       (if (cpad-hold? 0 select)
           (set! *bf-l3-select?* #t)
           )
       )
      (*bf-l3-held?*
       (set! tap? (not (or *bf-l3-select?* *bf-l3-zoomed?*)))
       )
      )
    (set! *bf-l3-held?* held?)
    tap?
    )
  )

(defun bf-draw-overlay ((buf dma-buffer))
  "L3 in a fight (`*bf*` overlay?): the player's kills and deaths where the game shows its orb and
   skull gem counters (hud-classes.gc hud-skullgem 150 and hud-skill 270 units down, on the left),
   and the whole city's map, live, as every menu shows it (`bf-draw-map-marks`, round)."
  (bf-draw-box buf 14 118 104 186)
  (bf-draw-text buf (bf-tr "Kills" "Éliminations") 66.0 130.0 0.45 (font-color menu-parent) #t)
  (clear *bf-text*)
  (format *bf-text* "~D" (-> *bf* kills))
  (bf-draw-text buf *bf-text* 66.0 152.0 1.0 (font-color green) #t)
  (bf-draw-text buf (bf-tr "Deaths" "Morts") 66.0 236.0 0.45 (font-color menu-parent) #t)
  (clear *bf-text*)
  (format *bf-text* "~D" (-> *bf* deaths))
  (bf-draw-text buf *bf-text* 66.0 258.0 1.0 (font-color red) #t)
  (bf-draw-text buf (bf-tr "L3: close" "L3 : fermer") 373.0 360.0 0.4 (font-color default) #t)
  (bf-draw-map-marks buf (-> *bf* zone) -1)
  (none)
  )

(defun bf-draw-respawn-frame ((buf dma-buffer))
  "The death screen's frame on the right (the author's wish, round 30): where the player comes back
   (his respawn point, his base when that point is lost) and as which class, then, once he may,
   X to respawn there and Triangle to change them on the class page."
  (let ((pick (if (bf-point-held? (-> *bf* respawn-point) (-> *bf* team)) (-> *bf* respawn-point) (-> *bf* team))))
    (bf-draw-box buf 352 96 150 120)
    (bf-draw-text buf (bf-tr "RESPAWN" "RÉAPPARITION") 427.0 104.0 0.5 (font-color menu-parent) #t)
    (clear *bf-text*)
    (format *bf-text* "~S" (if (< pick 2) (bf-tr "Base" "Base") (bf-point-name pick)))
    (bf-draw-text buf *bf-text* 427.0 132.0 0.45 (bf-team-color (-> *bf* team)) #t)
    (bf-draw-text buf (bf-class-name (-> *bf* class)) 427.0 152.0 0.42 (font-color default) #t)
    (when (>= (current-time) (-> *bf* respawn-time))
      (bf-draw-text buf (bf-tr "<PAD_X> Respawn" "<PAD_X> Réapparaître") 427.0 178.0 0.4 (font-color default) #t)
      (bf-draw-text buf (bf-tr "<PAD_TRIANGLE> Change" "<PAD_TRIANGLE> Modifier") 427.0 196.0 0.4 (font-color default) #t)
      )
    )
  (none)
  )

(defbehavior bf-draw-hud bf-director ()
  "The reserves (`bf-draw-reserves`), the L3 overlay (`bf-draw-overlay`, the game's minimap hidden
   meanwhile) or the respawn page, the
   warnings of the fight, the countdown of a dead player, and the crosshair. The class's gun and ammo are in the stock gun HUD
   (hud-gun `update-values!` and `draw` above)."
  ;; L3: the whole map, round as in the menus, under the HUD
  (when (-> *bf* overlay?)
    (bf-zmap-set! 373.0 206.0 120.0 96.0)
    (bf-draw-zone-minimap (-> *bf* zone))
    )
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf2))
    ;; a jetpack guard's rocket icon in the gun HUD
    (bf-draw-rocket-hud buf)
    (bf-draw-reserves buf)
    (bf-draw-points-hud buf)
    ;; L3: the kills, the deaths and the whole map (`bf-draw-overlay`)
    (if (-> *bf* overlay?)
        (bf-draw-overlay buf)
        )
    (if (not (time-elapsed? (-> self field-time) (seconds 1)))
        (bf-draw-text buf (bf-tr "CEILING" "PLAFOND") 0.0 150.0 0.6 (font-color red) #t)
        )
    ;; the dead player watches the battle (`bf-target-death`), his respawn in a frame on the right:
    ;; X respawns him there as that class, Triangle opens the class page to change them
    (when (and (nonzero? (-> *bf* respawn-time)) (< (-> *bf* respawn-pick) 0) (not (-> *bf* redeploying?)))
      (bf-draw-text buf (bf-tr "YOU WERE KILLED" "VOUS ÊTES MORT") 0.0 250.0 0.8 (font-color red) #t)
      (bf-draw-respawn-frame buf)
      )
    )
  (if (and *target* (not (focus-test? *target* dead)))
      (bf-draw-reticle)
      )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Battle life cycle (run inside the director's process)
;; ---------------------------------------------------------------------------------------------

(defun bf-city-call ((cmd int))
  "Run CMD on the Haven City side when ctywide is active (its hook then points into the current
   link of battlefront-city.gc)."
  (when (and *bf-city-hook* (= (level-status? *level* (bf-city-level) #f) 'active))
    (*bf-city-hook* cmd)
    )
  (none)
  )

(defun bf-zone-continue ((zone int) (team int))
  "Spawn continue point of TEAM in ZONE."
  (get-continue-by-name *game-info*
                        (if (= team BF_TEAM_FF) (-> *bf-zones* zone ff-continue) (-> *bf-zones* zone kg-continue))
                        )
  )

(defconstant BF_SPAWN_SHIELD (seconds 3)) ;; invulnerable this long after a deployment or a respawn

(defun bf-spawn-shield ()
  "The player just deployed or respawned: invulnerable for BF_SPAWN_SHIELD (`target-timed-invulnerable`),
   his class model blinking meanwhile (`*bf*` flicker-until, battlefront-player.gc
   `bf-avatar-blink`), then steady."
  (when *target*
    (target-timed-invulnerable BF_SPAWN_SHIELD *target* 1)
    (set! (-> *bf* flicker-until) (+ (-> *display* game-clock frame-counter) BF_SPAWN_SHIELD))
    )
  (none)
  )

(defun bf-refill-ammo ()
  "Loadout of a deployment (the first class page, a class change, a respawn, a restart): a full
   rifle magazine (BF_MAG_RIFLE) and its reserve (BF_RESERVE_RIFLE, Jak's yellow ammo), and the
   grenades (BF_GRENADES, his red ammo). The tazer needs none; Jak's blue ammo goes, so a blue
   pickup alone recharges it, and his dark ammo, so a dark pickup alone gives a jetpack rockets
   (battlefront-player.gc `bf-avatar-moves`)."
  (set! (-> *game-info* gun-ammo BF_AMMO_YELLOW) BF_RESERVE_RIFLE)
  (set! (-> *game-info* gun-ammo BF_AMMO_BLUE) 0.0)
  (set! (-> *game-info* gun-ammo BF_AMMO_DARK) 0.0)
  (set! (-> *game-info* gun-ammo BF_AMMO_RED) BF_GRENADES)
  (bf-refill-mags)
  (none)
  )

(defun bf-spectate-end! ()
  "The dead player's wait (`bf-target-death`) is over or cut short: no countdown, the camera on Jak
   again. The stock death's reset does the same (game-info.gc, `initialize!`)."
  (when (nonzero? (-> *bf* respawn-time))
    (set! (-> *bf* respawn-time) 0)
    (set! (-> *bf* spectate) (the-as handle #f))
    (when *target*
      (send-event *camera* 'change-target *target*)
      (send-event *camera* 'teleport)
      )
    )
  (none)
  )

(defbehavior bf-start-battle! bf-director ((zone int) (team int) (class int))
  "Set up a battle in ZONE, the player on TEAM as CLASS, and send the player there."
  (let ((ff (bf-zone-continue zone BF_TEAM_FF))
        (kg (bf-zone-continue zone BF_TEAM_KG))
        )
    (cond
      ((not (and ff kg))
       (format 0 "battlefront: a continue point of zone ~D is missing~%" zone)
       )
      (else
        (set! (-> *bf* zone) zone)
        (bf-zone-select! zone)
        ;; the armies' caps from the setup's units at once (round 41)
        (bf-caps-set! (-> *bf-config* at-once))
        (set! (-> *bf* team) team)
        (set! (-> *bf* class) class)
        (set! (-> *bf* weapon) BF_WEAPON_RIFLE)
        (set! (-> *bf* redraw?) #f)
        (set! (-> *bf* shield?) #f)
        (set! (-> *bf* drop-count) 0)
        (set! (-> *bf* winner) BF_TEAM_NONE)
        (set! (-> *bf* kills) 0)
        (set! (-> *bf* combat-time) 0)
        (set! (-> *bf* respawn-at) -1)
        (set! (-> *bf* deaths) 0)
        (set! (-> *bf* redeploy-ok?) #f)
        (set! (-> *bf* tazer-time) 0)
        ;; the configuration page's settings (`*bf-config*`; BF_RESERVE units a side until round 28)
        (set! (-> *bf* reserve-max) (-> *bf-config* units))
        (set! (-> *bf* time-limit) (-> *bf-config* minutes))
        (set! (-> *bf* victory) (-> *bf-config* victory))
        (set! (-> *bf* hold-team) BF_TEAM_NONE)
        (dotimes (i BF_TEAM_COUNT)
          (set! (-> *bf* reserve i) (-> *bf* reserve-max))
          (set! (-> *bf* losses i) 0)
          )
        ;; the class weapons spend Jak's ammo, the shield's hits his light eco: given back at the end
        (dotimes (i 4)
          (set! (-> *bf* ammo-saved i) (-> *game-info* gun-ammo i))
          )
        (set! (-> *bf* light-saved) (-> *game-info* eco-pill-light))
        ;; dark eco picked up in the battle refills the jetpacks (battlefront-player.gc): none to start;
        ;; no light eco either, so the stock eco gauges of the health HUD stay empty
        (set! (-> *bf* dark-saved) (-> *game-info* eco-pill-dark))
        (set! (-> *game-info* eco-pill-dark) 0.0)
        (set! (-> *game-info* eco-pill-light) 0.0)
        ;; the endless dark eco secret refills Jak's every frame (powerups.gc target-eco-process):
        ;; it would keep the jetpacks full, so it is off during the battle
        (set! (-> *bf* endless-dark?) (logtest? (-> *game-info* secrets) (game-secrets endless-dark)))
        (logclear! (-> *game-info* secrets) (game-secrets endless-dark))
        ;; the endless light eco secret would keep the health HUD's light eco gauge full: off too
        (set! (-> *bf* endless-light?) (logtest? (-> *game-info* secrets) (game-secrets endless-light)))
        (logclear! (-> *game-info* secrets) (game-secrets endless-light))
        ;; every unit is spawned again by the respawn below: no look is taken yet
        (dotimes (i 5)
          (set! (-> *bf-looks* i) 0)
          )
        (vector-copy! (-> *bf* spawn BF_TEAM_FF) (-> ff trans))
        (vector-copy! (-> *bf* spawn BF_TEAM_KG) (-> kg trans))
        ;; the district's middle, and the radius around it that covers its map (battlefront-minimaps.gc):
        ;; the reinforcements search their lanes there
        (let ((texel (bf-zone-map-corner zone 2))
              (w (the float (bf-zone-map-size zone 2)))
              (h (the float (bf-zone-map-size zone 1)))
              )
          (set-vector! (-> *bf* center)
                       (+ (bf-zone-map-corner zone 0) (* 0.5 w texel))
                       (* 0.5 (+ (-> ff trans y) (-> kg trans y)))
                       (+ (bf-zone-map-corner zone 1) (* 0.5 h texel))
                       (* 0.5 texel (sqrtf (+ (* w w) (* h h))))
                       )
          )
        ;; the force field's first safe place: the player's spawn (`bf-keep-in-zone`)
        (let ((own (if (= team BF_TEAM_FF) ff kg)))
          (vector-copy! (-> *bf* safe) (-> own trans))
          (set! (-> *bf* safe-level) (-> own level))
          (set! (-> *bf* safe-time) 0)
          )
        (set! (-> *bf* ceiling) (+ (fmax (-> ff trans y) (-> kg trans y)) BF_CEILING))
        (set! (-> *bf* respawn-time) 0)
        ;; the battle camera looks where Jak faces at his spawn (battlefront-player.gc bf-cam-rig-spawn)
        (set! (-> *bf* view-set?) #f)
        (set! (-> self prepared?) #f)
        (set! (-> self leaving?) #f)
        (set! (-> self want-avatar?) #t)
        ;; the battle's settings, owned by the director
        (remove-setting! 'borrow)
        (remove-setting! 'faction-command)
        (remove-setting! 'exclusive-task)
        (remove-setting! 'pilot)
        (remove-setting! 'airlock)
        (remove-setting! 'disable-parking-spots?)
        (remove-setting! 'allow-look-around)
        (set-setting! 'borrow *bf-borrow* 0.0 0)
        (set-setting! 'faction-command *bf-faction-commands* 0.0 0)
        ;; outside the campaign: only the tasks this setting names stay open (task-control.gc
        ;; game-task-node-info-method-12), and no node has the task none, so no mission or
        ;; activity starts (NPC prompts, burning bushes, task managers, their minimap icons)
        (set-setting! 'exclusive-task #f 0.0 (game-task none))
        ;; no vehicle either: vehicle `check-player-get-on` (vehicle-util.gc) wants this setting on
        (set-setting! 'pilot #f 0.0 0)
        ;; the fight stays in the streets: no door, airlock, warp gate or air train opens
        ;; (airlock.gc want-cross-airlock?, warp-gate.gc), and the parking spots hold no vehicle
        ;; (ctywide-obs.gc parking-spot)
        (set-setting! 'airlock #f 0.0 0)
        (set-setting! 'disable-parking-spots? #t 0.0 0)
        ;; no stock first-person look around on R3 (logic-target.gc): the camera is the class's
        ;; over the shoulder; L3 shows the battle's overlay (`bf-draw-overlay`)
        (set-setting! 'allow-look-around #f 0.0 0)
        ;; the city's war music everywhere (the game's own for its assaults on the city: assault-task.gc,
        ;; ctyport-attack.gc), in place of each district's
        (remove-setting! 'music)
        (set-setting! 'music 'portattk 0.0 0)
        (apply-settings *setting-control*)
        (bf-avatar-kill)
        (bf-set-phase! BF_PHASE_DEPLOY)
        ;; respawn the player at his side's spawn the way a death does (target-death-reset):
        ;; `initialize!` 'life resets every actor and runs each active level's activate function,
        ;; so Haven City's traffic is rebuilt and every unit pool spawned again, now with the
        ;; battle's skins. Rebuilding the traffic on its own in mid-game (ctywide-activate) left
        ;; process records broken: a later level change crashed the game deactivating an airlock.
        (set-continue! *game-info* (if (= team BF_TEAM_FF) ff kg) #f)
        ;; every street section at once (`bf-whole-city-update`): the stock ones out first
        (set! (-> *bf* city-load) BF_LOAD_DRAIN_IN)
        (bf-city-call BF_CITY_FREE_NAVS)
        (initialize! *game-info* 'life (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        )
      )
    )
  (none)
  )

(defun bf-restore-player! ()
  "Give Jak back what the battle set aside: his gun ammo, light and dark eco, and the endless dark
   and light eco secrets."
  (dotimes (i 4)
    (set! (-> *game-info* gun-ammo i) (-> *bf* ammo-saved i))
    )
  (set! (-> *game-info* eco-pill-light) (-> *bf* light-saved))
  (set! (-> *game-info* eco-pill-dark) (-> *bf* dark-saved))
  (if (-> *bf* endless-dark?)
      (logior! (-> *game-info* secrets) (game-secrets endless-dark))
      )
  (if (-> *bf* endless-light?)
      (logior! (-> *game-info* secrets) (game-secrets endless-light))
      )
  (set! (-> *bf* drop-count) 0)
  (none)
  )

;; A control point on the game's minimap: a bright red disc, four times a guard's mark (the "guard"
;; dot of *minimap-class-list*, class 10, scaled), drawn at the point (`bf-point-icons`), its letter
;; inside it (`bf-draw-minimap-letters`). A base: the same disc in black, smaller (every point's until
;; round 27). The minimap's color multiplies the class's (128 for 1): 255 lights the red twice.
(define *bf-point-minimap-class*
  (new 'static 'minimap-class-node
    :default-position (new 'static 'vector :w 1.0)
    :name "bf-point"
    :icon-xy (new 'static 'vector2ub :data (new 'static 'array uint8 2 #x0 #x1))
    :scale 0.01
    :color (new 'static 'rgba :a #x80)
    )
  )

(define *bf-base-minimap-class*
  (new 'static 'minimap-class-node
    :default-position (new 'static 'vector :w 1.0)
    :name "bf-base"
    :icon-xy (new 'static 'vector2ub :data (new 'static 'array uint8 2 #x0 #x1))
    :scale 1.8
    :color (new 'static 'rgba :a #x80)
    )
  )

;; Where the minimap drew each control point's mark: its center in GS screen units and the frame
;; (`bf-minimap-icon-at`).
(deftype bf-icon-spots (structure)
  ((x     float      BF_POINT_MAX)
   (y     float      BF_POINT_MAX)
   (frame time-frame BF_POINT_MAX)
   )
  )

(define *bf-icon-spots* (new 'static 'bf-icon-spots))

(defun bf-minimap-icon-at ((c connection-minimap) (at vector))
  "Called by minimap.gc draw-connection for each mark it draws, AT its center in GS screen units
   (x, and z for the height): a control point's mark keeps its place and frame in `*bf-icon-spots*`
   for its letter (`bf-draw-minimap-letters`). Anything else: nothing."
  (when (= (-> c class) *bf-point-minimap-class*)
    (dotimes (i (-> *bf* point-count))
      (when (= (-> *bf* points i icon) c)
        (set! (-> *bf-icon-spots* x i) (-> at x))
        (set! (-> *bf-icon-spots* y i) (-> at z))
        (set! (-> *bf-icon-spots* frame i) (-> *display* base-clock integral-frame-counter))
        )
      )
    )
  (none)
  )


(defun bf-rgba-k ((color rgba) (k float))
  "COLOR with its alpha scaled by K."
  (let ((c (the-as int color)))
    (the-as rgba (logior (logand c #xffffff) (shl (the int (* k (the float (logand (shr c 24) 255)))) 24)))
    )
  )

(defun bf-point-capturing? ((pt bf-point))
  "#t while a side's units take control point PT from its holder: a capture under way, its side
   there (`bf-update-points`)."
  (and (not (-> pt base?))
       (!= (-> pt prog-team) BF_TEAM_NONE)
       (!= (-> pt prog-team) (-> pt owner))
       (< 0.0 (-> pt progress))
       (< 0 (-> pt near (-> pt prog-team)))
       )
  )

(defun bf-draw-point-mark ((buf dma-buffer) (x float) (y float) (r float) (letter string) (owner int) (blink? symbol) (alpha float))
  "A battle point's mark, the same on the game's minimap and on every map of the menus (the author's
   wish, round 30): a soft glow, a thin luminous ring, a gap, then a solid disc of radius R in its
   holder's color (blue the Freedom League, red the Krimzon Guard, grey neutral) with LETTER in
   white inside it, sized to the disc so it never runs over (none for a base); round 31, smaller,
   the glow and the ring closer. BLINK?, a capture under way, dims it every other quarter second;
   ALPHA fades it with a page."
  (let* ((k (* alpha (if (and blink? (logtest? (/ (-> *display* real-clock frame-counter) (seconds 0.25)) 1)) 0.3 1.0)))
         (s (* 0.05 r))
         )
    (case owner
      ((BF_TEAM_FF)
       (bf-draw-disc buf x y (* 1.6 r) (bf-rgba-k (static-rgba 40 120 255 22) k))
       (bf-draw-ring buf x y (* 1.2 r) (* 1.4 r) (bf-rgba-k (static-rgba 90 170 255 120) k))
       (bf-draw-disc buf x y r (bf-rgba-k (static-rgba 40 120 255 128) k))
       )
      ((BF_TEAM_KG)
       (bf-draw-disc buf x y (* 1.6 r) (bf-rgba-k (static-rgba 255 40 40 22) k))
       (bf-draw-ring buf x y (* 1.2 r) (* 1.4 r) (bf-rgba-k (static-rgba 255 110 110 120) k))
       (bf-draw-disc buf x y r (bf-rgba-k (static-rgba 235 30 30 128) k))
       )
      (else
        (bf-draw-disc buf x y (* 1.6 r) (bf-rgba-k (static-rgba 255 255 255 18) k))
        (bf-draw-ring buf x y (* 1.2 r) (* 1.4 r) (bf-rgba-k (static-rgba 235 235 235 110) k))
        (bf-draw-disc buf x y r (bf-rgba-k (static-rgba 150 150 150 128) k))
        )
      )
    (if letter
        (bf-draw-text buf letter (+ x (* 3.75 s)) (- y (* 11.75 s)) s (font-color white) #t)
        )
    )
  (none)
  )

(defun bf-draw-minimap-letters ((buf dma-buffer))
  "Each control point's mark on the minimap (`bf-draw-point-mark`, the menus' maps draw the same),
   blinking while a side takes it. Drawn where the
   minimap drew the point's own mark, an invisible icon, this frame or the one before
   (`*bf-icon-spots*`): a mark out of the minimap, or the minimap hidden, gets none. GS units to
   screen units: the 512 by 416 screen starts at 1792, 1840 (hud.gc)."
  (let ((now (-> *display* base-clock integral-frame-counter)))
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?)) (>= (-> *bf-icon-spots* frame i) (+ now -1)))
          (let ((x (+ -1792.0 (-> *bf-icon-spots* x i)))
                (y (+ -1840.0 (-> *bf-icon-spots* y i)))
                )
            (bf-draw-point-mark buf x y 5.0 (bf-point-letter i) (-> pt owner) (bf-point-capturing? pt) 1.0)
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior bf-point-icons bf-director ()
  "Each frame of a fight: every battle point without its mark on the game's minimap gets one, a
   connection of the director at the point's place (minimap.gc add-icon!, class 10, then
   `*bf-point-minimap-class*`, or `*bf-base-minimap-class*` for a base)."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (when (not (-> pt icon))
        (let ((c (add-icon! *minimap* self (the-as uint 10) (the-as int #f) (-> pt pos) 0)))
          (when c
            (set! (-> c class) (if (-> pt base?) *bf-base-minimap-class* *bf-point-minimap-class*))
            (set! (-> pt icon) c)
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-point-icons-kill ()
  "Take every battle point's mark off the game's minimap (minimap.gc kill-callback)."
  (dotimes (i BF_POINT_MAX)
    (let ((pt (-> *bf* points i)))
      (when (-> pt icon)
        (kill-callback (-> *minimap* engine) (-> pt icon))
        (set! (-> pt icon) #f)
        )
      )
    )
  (none)
  )

(defbehavior bf-end-battle! bf-director ()
  "Undo everything the battle changed and go back to the stock game. While Jak drives, wait: the
   respawn that ends it would take the vehicle from under him."
  (when (and (bf-active?)
             *target*
             (focus-test? *target* pilot)
             (= (level-status? *level* (bf-city-level) #f) 'active)
             )
    (set! (-> self end-pending?) #t)
    (return #f)
    )
  (set! (-> self end-pending?) #f)
  (bf-spectate-end!)
  (bf-avatar-kill)
  ;; Jak drawn again: the director hid him while his class model was away (`bf-director-update`)
  (if *target*
      (send-event *target* 'draw #t)
      )
  (bf-point-icons-kill)
  (set! (-> *bf* overlay?) #f)
  (remove-setting! 'minimap)
  (bf-hud-health-update #f)
  (let ((city? (and (bf-active?) (= (level-status? *level* (bf-city-level) #f) 'active))))
    (when (bf-active?)
      ;; phase off first: the pools spawned again by the respawn below get the stock skins
      (bf-set-phase! BF_PHASE_OFF)
      ;; the battle's sections out before the game loads its own (`bf-whole-city-update`)
      (if (!= (-> *bf* city-load) BF_LOAD_OFF)
          (set! (-> *bf* city-load) BF_LOAD_DRAIN_OUT)
          )
      (bf-city-call BF_CITY_RESET)
      (bf-restore-player!)
      )
    (remove-setting! 'borrow)
    (remove-setting! 'faction-command)
    (remove-setting! 'exclusive-task)
    (remove-setting! 'pilot)
    (remove-setting! 'airlock)
    (remove-setting! 'disable-parking-spots?)
    (remove-setting! 'allow-look-around)
    (remove-setting! 'music)
    (apply-settings *setting-control*)
    ;; respawn at the current continue (the side's spawn) the way a death does: every unit of the
    ;; battle is replaced by a stock one
    (if city?
        (bf-city-call BF_CITY_FREE_NAVS)
        (initialize! *game-info* 'life (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        )
    )
  (bf-set-phase! BF_PHASE_OFF)
  ;; the units' levels back to Jak 3's city as their host: the stock game's (`bf-zone-select!`)
  (bf-zone-select! 0)
  (none)
  )

(defun bf-whole-city-section? ((name symbol))
  "#t when level NAME is one of the street sections a battle loads at once (`bf-zone-sections`)."
  (let ((l (bf-zone-sections (-> *bf* zone))))
    (while (not (null? l))
      (if (= (car l) name)
          (return #t)
          )
      (set! l (cdr l))
      )
    )
  #f
  )

(defun bf-whole-city-chunk ((lev level))
  "`*bf-alloc-hook*` (level.gc `load-begin`): while the battle holds every street section
   (BF_LOAD_WHOLE), the first of the two chunks of the level heap section LEV takes: the first pair
   of 0-1, 2-3, 4-5, 12-13, 14-15 and 16-17 no other level uses (ctywide keeps 6 to 11, its
   borrowed levels inside it). -1 for the stock banks: another level, or no battle."
  (when (and (= (-> *bf* city-load) BF_LOAD_WHOLE) (bf-whole-city-section? (-> lev name)))
    (let ((starts (new 'static 'array int32 6 0 2 4 12 14 16)))
      (dotimes (k 6)
        (let ((mask (ash 3 (-> starts k)))
              (free? #t)
              )
          (dotimes (i 11)
            (let ((other (-> *level* level i)))
              (if (and (!= other lev) (logtest? (-> other memory-mask) mask))
                  (set! free? #f)
                  )
              )
            )
          (when free?
            (format 0 "battlefront: ~A in chunks ~D and ~D~%" (-> lev name) (-> starts k) (+ (-> starts k) 1))
            (return (-> starts k))
            )
          )
        )
      )
    )
  -1
  )

(defun bf-whole-city-set-want ((ls load-state) (i int) (name symbol) (display symbol))
  "Set slot I of the levels LS wants to level NAME, shown as DISPLAY (#f clears the slot)."
  (set! (-> ls want i name) name)
  (set! (-> ls want i display?) display)
  (set! (-> ls want i force-vis?) #f)
  (set! (-> ls want i force-inside?) #f)
  (none)
  )

(defun bf-whole-city-want ((ls load-state))
  "`*bf-want-hook*` (load-state.gc `add-borrow-levels`): while the battle holds the city's levels,
   the levels LS wants become ctywide and the two unit levels (ctypesa, ctypesc) and, once every
   other level is gone (BF_LOAD_WHOLE), every street section displayed: nine of the game's ten
   level slots. The game's own requests (its load boundaries, doors, continue points, ctywide's
   aliases and the cars and citizens they borrow) are left out: with a tenth level wanted,
   `level-get-for-use` (level.gc) evicts a loaded one, a borrowed level whose units still live,
   and the game crashes."
  (when (!= (-> *bf* city-load) BF_LOAD_OFF)
    (dotimes (i 10)
      (bf-whole-city-set-want ls i #f #f)
      )
    (bf-whole-city-set-want ls 0 (bf-city-level) 'display)
    (bf-whole-city-set-want ls 1 'ctypesa 'special)
    (bf-whole-city-set-want ls 2 'ctypesc 'special)
    (when (= (-> *bf* city-load) BF_LOAD_WHOLE)
      (let ((i 3)
            (l (bf-zone-sections (-> *bf* zone)))
            )
        (while (not (null? l))
          (bf-whole-city-set-want ls i (the-as symbol (car l)) 'display)
          (+! i 1)
          (set! l (cdr l))
          )
        )
      )
    )
  (none)
  )

(defun bf-whole-city-drained? ()
  "#t when no level but ctywide and the levels it borrows holds a chunk the street sections take
   (0 to 5, 12 to 17); at once for a zone without sections (Jak 2's city, one level)."
  (if (null? (bf-zone-sections (-> *bf* zone)))
      (return #t)
      )
  (dotimes (i 10)
    (let ((lev (-> *level* level i)))
      (if (and (!= (-> lev status) 'inactive) (logtest? (-> lev memory-mask) #x3f03f))
          (return #f)
          )
      )
    )
  #t
  )

(defun bf-whole-city-foreign ()
  "The first loaded level a battle over the whole city does not want (ctywide, ctypesa and ctypesc
   are its own until the sections come): a stock section, or a car or citizen level the city
   borrow manager (cty-borrow-manager.gc) keeps until its last traffic object is gone. #f once
   every such level is out."
  (dotimes (i 10)
    (let ((lev (-> *level* level i)))
      (when (and (!= (-> lev status) 'inactive)
                 (not (or (= (-> lev name) (bf-city-level)) (= (-> lev name) 'ctypesa) (= (-> lev name) 'ctypesc)))
                 )
        (return lev)
        )
      )
    )
  (the-as level #f)
  )

(defun bf-whole-city-loaded? ()
  "#t when every street section of the zone (`bf-zone-sections`) is active."
  (let ((l (bf-zone-sections (-> *bf* zone))))
    (while (not (null? l))
      (if (!= (level-status? *level* (the-as symbol (car l)) #f) 'active)
          (return #f)
          )
      (set! l (cdr l))
      )
    )
  #t
  )

(defun bf-whole-city-update ()
  "Every frame, battle or not: a battle's start empties every level but ctywide and the unit levels
   (BF_LOAD_DRAIN_IN, `bf-whole-city-foreign`), then loads every street section (BF_LOAD_WHOLE,
   `bf-whole-city-want`, `bf-whole-city-chunk`); its end empties them (BF_LOAD_DRAIN_OUT), then
   gives the game back its continue point's levels, as a respawn there does (target-death.gc
   target-continue), which it loads in its own banks (a section left in two chunks would leave the
   stock six nowhere: the game stops: level.gc, could not find free bank)."
  (cond
    ((= (-> *bf* city-load) BF_LOAD_DRAIN_IN)
     (let ((lev (bf-whole-city-foreign)))
       (cond
         (lev
           ;; what holds the battle back, every 2 s
           (if (zero? (mod (-> *display* real-clock integral-frame-counter) 120))
               (format 0 "battlefront: waiting for ~A (~A) to unload~%" (-> lev name) (-> lev status))
               )
           )
         (else
           (format 0 "battlefront: every other level gone, loading the whole city~%")
           (set! (-> *bf* city-load) BF_LOAD_WHOLE)
           (add-borrow-levels *load-state*)
           )
         )
       )
     )
    ((= (-> *bf* city-load) BF_LOAD_DRAIN_OUT)
     (when (bf-whole-city-drained?)
       (format 0 "battlefront: battle sections gone, the game's levels back~%")
       (set! (-> *bf* city-load) BF_LOAD_OFF)
       (let ((cont (-> *game-info* current-continue))
             (ls *load-state*)
             )
         (when cont
           (dotimes (i 10)
             (if (< i (-> cont want-count))
                 (bf-whole-city-set-want ls i (-> cont want i name) (-> cont want i display?))
                 (bf-whole-city-set-want ls i #f #f)
                 )
             )
           )
         (add-borrow-levels ls)
         )
       )
     )
    )
  (none)
  )

(set! *bf-alloc-hook* (the-as (function level int) bf-whole-city-chunk))
(set! *bf-want-hook* bf-whole-city-want)

(defbehavior bf-zone-ready? bf-director ()
  "#t once the player stands at his base with its levels (`bf-camp-loaded?`), every street section
   (`bf-whole-city-loaded?`) and the unit levels active. The battle's
   Haven City alias reloads ctywide and its collision: Jak must have stood on real ground (stance,
   not the stale on-surface flag of his continue state) after the first 2 seconds."
  (and *target*
       (let ((cont (bf-camp-continue)))
         (or (not cont) (bf-camp-loaded? cont))
         )
       (not (focus-test? *target* dead))
       (time-elapsed? (-> *bf* phase-time) (seconds 2))
       (logtest? (-> *target* control status) (collide-status on-surface))
       (= (-> *target* state name) 'target-stance)
       (< (-> *game-info* blackout-time) (current-time))
       (= (level-status? *level* (bf-city-level) #f) 'active)
       (= (level-status? *level* 'ctypesa #f) 'active)
       (= (level-status? *level* 'ctypesc #f) 'active)
       (= (-> *bf* city-load) BF_LOAD_WHOLE)
       (bf-whole-city-loaded?)
       )
  )

(defbehavior bf-force-field-spark bf-director ((pos vector))
  "Sparks of Light Jak's shield at POS, where Jak meets the force field (every 0.15 s at most), and
   its sound every 0.6 s."
  (when (time-elapsed? (-> self field-time) (seconds 0.15))
    (set-time! (-> self field-time))
    (vector-copy! (-> *launch-matrix* trans) pos)
    (if (logtest? (-> group-lightjak-shield-hit flags) (sp-group-flag sp13))
        (part-tracker-spawn part-tracker-subsampler :to self :group group-lightjak-shield-hit)
        (part-tracker-spawn part-tracker :to self :group group-lightjak-shield-hit)
        )
    (when (time-elapsed? (-> self field-sound) (seconds 0.6))
      (set-time! (-> self field-sound))
      (sound-play "shield-hit")
      )
    )
  (none)
  )

(defbehavior bf-keep-in-zone bf-director ()
  "The whole city is the battlefield: no force field holds the player (round 17). As he falls
   BF_FALL_DEPTH below the last place he stood (a hole, or a section that is not loaded), he is put
   back at that place (`*bf*` safe, taken every 0.5 s while he stands), his speed cancelled and the
   game's level of him set back. A jetpack class cannot climb past the ceiling: its thrust fades
   under it (battlefront-player.gc), and 2 m above it, which only a jump carries it to, its rise is
   turned into a fall, with Light Jak's shield sparks."
  (when (and *target* (not (focus-test? *target* dead)))
    (let ((pos (-> *target* control trans)))
      (cond
        ((< (- (-> *bf* safe y) BF_FALL_DEPTH) (-> pos y))
         (when (and (logtest? (-> *target* control status) (collide-status on-surface))
                    (time-elapsed? (-> *bf* safe-time) (seconds 0.5))
                    )
           (vector-copy! (-> *bf* safe) pos)
           (set! (-> *bf* safe-level) (-> *load-state* vis-nick))
           (set-time! (-> *bf* safe-time))
           )
         )
        (else
          (move-to-point! (-> *target* control) (-> *bf* safe))
          (vector-reset! (-> *target* control transv))
          (want-vis-level *load-state* (-> *bf* safe-level))
          )
        )
      (when (and (or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK))
                 (< (+ (-> *bf* ceiling) (meters 2)) (-> pos y))
                 )
        (set! (-> *target* control transv y) (fmin (-> *target* control transv y) (meters -2)))
        (let ((top (vector-copy! (new 'stack-no-clear 'vector) pos)))
          (+! (-> top y) (meters 2.5))
          (bf-force-field-spark top)
          )
        )
      )
    )
  (none)
  )

(defun bf-want-level ((ls load-state) (name symbol))
  "Want level NAME displayed, in a free slot of LS, unless it is wanted already."
  (let ((wanted? #f))
    (dotimes (i 10)
      (if (= (-> ls want i name) name)
          (set! wanted? #t)
          )
      )
    (dotimes (i 10)
      (when (and (not wanted?) (not (-> ls want i name)))
        (set! wanted? #t)
        (set! (-> ls want i name) name)
        (set! (-> ls want i display?) 'display)
        (set! (-> ls want i force-vis?) #f)
        (set! (-> ls want i force-inside?) #f)
        )
      )
    )
  (none)
  )

(defconstant BF_DROP_MAX_TIME (seconds 6)) ;; a fall from the sky ends this long after it began, landed or not

(defun bf-sky-drop! ((pick int) (ground vector))
  "The player respawning at point PICK falls from the sky, as the units brought to a control point
   do (the author's wish): above a nav poly drawn at random within 90 m of the point (the Haven City
   side's `bf-city-spawn-spot`, BF_RESPAWN_REACH, BF_CITY_SKY_SPOT), `bf-sky-height` above it and under the jetpacks'
   ceiling, his controls off until he lands (`bf-pad-lock!`, `bf-sky-drop-update`). GROUND: set to
   that poly's middle, where he lands; he falls through the units, meeting the scenery only. Returns
   #t when he falls, #f (GROUND unchanged) when the city found no poly."
  (set! (-> *bf* sky-point) pick)
  (set! (-> *bf* sky-found?) #f)
  (bf-city-call BF_CITY_SKY_SPOT)
  (cond
    ((-> *bf* sky-found?)
     (vector-copy! ground (-> *bf* sky-ground))
     (let ((sky (vector-copy! (new 'stack-no-clear 'vector) ground))
           (h (bf-sky-height ground))
           )
       ;; a jetpack starts under its force field's ceiling
       (+! (-> sky y) h)
       (if (or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK))
           (set! (-> sky y) (fmax (-> ground y) (fmin (-> sky y) (- (-> *bf* ceiling) (meters 1)))))
           )
       (format 0 "battlefront: respawn from the sky at ~S, ~M over the ground (~M up, the ceiling ~M up)~%"
               (bf-point-name pick) (- (-> sky y) (-> ground y)) (-> ground y) (-> *bf* ceiling))
       (move-to-point! (-> *target* control) sky)
       (vector-reset! (-> *target* control transv))
       )
     ;; through the units: he met the scenery only (one fall stopped 21 m up for 6 s, on a unit
     ;; in the air over the point); `bf-sky-drop-update` gives his collision back as he lands
     (when (not (-> *bf* dropping?))
       (set! (-> *bf* drop-collide) (-> *target* control root-prim prim-core collide-with))
       (set! (-> *target* control root-prim prim-core collide-with) (collide-spec backgnd))
       )
     (set! (-> *bf* dropping?) #t)
     (set! (-> *bf* drop-time) (-> *display* game-clock frame-counter))
     (set! (-> *bf* land-time) 0)
     #t
     )
    (else
      #f
      )
    )
  )

(defun bf-sky-drop-update ()
  "Every frame of a fight (the director): the player's fall from the sky (`bf-sky-drop!`) ends once
   he stands on the ground, BF_DROP_MAX_TIME after it began at the latest: his controls come back,
   his class model plays its landing (`*bf*` land-time, battlefront-player.gc), and the spawn shield
   starts again from there (`bf-spawn-shield`). Until then Jak falls straight down, never up: the X that picked the
   point on the respawn page made him jump as he appeared (the page clears its confirm, not X, and
   Jak's jump reads the presses of the last 15 frames)."
  (when (-> *bf* dropping?)
    (when *target*
      (if (< 0.0 (-> *target* control transv y))
          (set! (-> *target* control transv y) 0.0)
          )
      ;; straight down: nothing pushes him off his poly (a unit falling beside him did, 7 m)
      (set! (-> *target* control transv x) 0.0)
      (set! (-> *target* control transv z) 0.0)
      )
    (let ((now (-> *display* game-clock frame-counter)))
      (when (or (not *target*)
                (focus-test? *target* dead)
                (and (logtest? (-> *target* control status) (collide-status on-surface))
                     (< (seconds 0.2) (- now (-> *bf* drop-time)))
                     )
                (< BF_DROP_MAX_TIME (- now (-> *bf* drop-time)))
                )
        (set! (-> *bf* dropping?) #f)
        (set! (-> *bf* land-time) now)
        (if *target*
            (set! (-> *target* control root-prim prim-core collide-with) (-> *bf* drop-collide))
            )
        (if (and *target* (not (focus-test? *target* dead)))
            (bf-spawn-shield)
            )
        )
      )
    )
  (none)
  )

;; Until when (the real clock) pad 0 presses START for the title screen after a battle
;; (`bf-to-title!`, `bf-title-press!`), 0 for no more.
(define *bf-title-press-until* (the-as time-frame 0))

(defun bf-title-press! ((pad cpad-info))
  "After a battle's end (`bf-to-title!`): while the title screen waits for START (levels/title/
   title-obs.gc title-control, state wait, its Press START), pad 0 presses it every other frame, a
   press's edge, so the title menu opens at once (round 33, the author's wish: the menu after the
   intro). Stops once the title control opens the menu (state idle), or after 60 s. Side effect:
   PAD's buttons."
  (when (and (zero? (-> pad number)) (< (-> *display* real-clock frame-counter) *bf-title-press-until*))
    (let ((tc (process-by-name "title-control" *entity-pool*)))
      (when (and tc (-> tc next-state))
        (cond
          ((= (-> tc next-state name) 'idle)
           (set! *bf-title-press-until* 0)
           )
          ((and (= (-> tc next-state name) 'wait) (logtest? (-> *display* real-clock integral-frame-counter) 1))
           (set! (-> pad button0) (logior (-> pad button0) (the-as uint (pad-buttons start))))
           )
          )
        )
      )
    )
  (none)
  )

;; The pad read (pad.gc cpad-get-data, the kernel's), kept before `bf-pad-lock!` wraps it.
(define-perm *bf-stock-cpad-get-data* (function cpad-info cpad-info) cpad-get-data)

(defun bf-pad-lock! ((pad cpad-info))
  "While the player falls from the sky in a fight (`*bf*` dropping?), pad 0 gives only START and
   SELECT and a centered left stick: no move, jump, weapon or class move until he lands (the
   author's wish); the right stick still turns the camera. The same while he stands still for a
   grenade throw, a rifle shot or a tazer stab (`*bf*` still-until, battlefront-player.gc): no
   weapon fires on the run since round 28 (the author's wish; the rifle did in rounds 26 and 27).
   After a battle, START for the title screen (`bf-title-press!`). Returns PAD."
  (bf-title-press! pad)
  ;; a guard jumps once, no second jump in the air; the robotguard does not jump (the author's
  ;; wish, round 29): X off then. Not while a page or a menu is up (X picks there), nor dead. Since
  ;; round 34 a guard's X held stays on in the air, so the jump rises as long as it is held: in the
  ;; air X passes only when it was down the frame before (the pad's button0-abs 0, not yet updated
  ;; here), a press with no edge; a new press in the air stays off (Jak's second jump)
  (when (and (zero? (-> pad number))
             (bf-fighting?)
             (not *popup-menu-open*)
             *target*
             (not (focus-test? *target* dead))
             )
    ;; a jetpack guard's L1 fires a rocket (battlefront-player.gc `*bf-jet-l1*`), a robotguard's a
    ;; grenade (round 38), a spider's blows it up (round 38): read here, then taken from Jak, who
    ;; would duck or roll on it (round 36)
    (when (or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK)
              (= (-> *bf* class) BF_CLASS_ROBOGUARD) (= (-> *bf* class) BF_CLASS_SPYDROID)
              )
      (set! *bf-jet-l1* (logtest? (-> pad button0) (pad-buttons l1)))
      (set! (-> pad button0) (logclear (-> pad button0) (pad-buttons l1)))
      )
    (let ((x? (logtest? (-> pad button0) (pad-buttons x))))
      (cond
        ((= (-> *bf* class) BF_CLASS_ROBOGUARD)
         (set! (-> pad button0) (logclear (-> pad button0) (pad-buttons x)))
         )
        ((not (bf-guard-class? (-> *bf* class)))
         0
         )
        ((not (or (not (logtest? (-> *target* control status) (collide-status on-surface))) (bf-target-airborne?)))
         ;; on the ground: X as it is
         0
         )
        ((and x? (logtest? (-> pad button0-abs 0) (pad-buttons x)))
         ;; held since the frame before: the jump's rise goes on
         0
         )
        (else
          (set! (-> pad button0) (logclear (-> pad button0) (pad-buttons x)))
          )
        )
      )
    )
  (when (and (zero? (-> pad number))
             (or (-> *bf* dropping?) (< (-> *display* game-clock frame-counter) (-> *bf* still-until)))
             (bf-fighting?)
             )
    (set! (-> pad button0) (logand (-> pad button0) (the-as uint (pad-buttons start select))))
    (set! (-> pad leftx) (the-as uint 128))
    (set! (-> pad lefty) (the-as uint 128))
    )
  pad
  )

(defun cpad-get-data ((pad cpad-info))
  "The stock pad read, then `bf-pad-lock!`. In a debug boot (`task boot-game`: the game starts in
   a level, no title), the mode on, the battle's title page opens once Jak stands (round 29, the
   author's wish)."
  (when (and (not *bf-boot-menu?*) *debug-segment* *mod-battlefront-enable* *target* (not (bf-active?))
             (logtest? (-> *target* control status) (collide-status on-surface))
             (< (-> *game-info* blackout-time) (-> *display* game-clock frame-counter))
             )
    (set! *bf-boot-menu?* #t)
    (bf-director-ensure!)
    (set! *bf-request* BF_REQ_TITLE)
    )
  (bf-pad-lock! (*bf-stock-cpad-get-data* pad))
  )

(defbehavior bf-respawn-at-point bf-director ()
  "After a far respawn's reset (`bf-target-death`): once Jak stands at the point's continue point,
   its levels in, move him onto the point (`*bf*` respawn-at), with his class's full health, a fresh
   loadout, the spawn shield (`bf-spawn-shield`) and the camera on him; the point is the safe place of a
   fall. The director draws his class again on its own (`want-avatar?`)."
  (when (and (>= (-> *bf* respawn-at) 0)
             *target*
             (not (focus-test? *target* dead))
             (= (-> *target* state name) 'target-stance)
             (logtest? (-> *target* control status) (collide-status on-surface))
             (< (-> *game-info* blackout-time) (current-time))
             )
    (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points (-> *bf* respawn-at) pos))))
      (format 0 "battlefront: respawned at ~S after the reset~%" (bf-point-name (-> *bf* respawn-at)))
      ;; from the sky onto a nav poly around the point (`bf-sky-drop!`, AT set to it), else on the point
      (when (not (bf-sky-drop! (-> *bf* respawn-at) at))
        (move-to-point! (-> *target* control) at)
        (vector-reset! (-> *target* control transv))
        )
      (set! (-> *bf* respawn-at) -1)
      (vector-copy! (-> *bf* safe) at)
      (set! (-> *bf* safe-level) (-> *load-state* vis-nick))
      (set! (-> *bf* safe-time) 0)
      (set! (-> *target* fact health) (bf-class-health (-> *bf* class)))
      (bf-refill-ammo)
      (bf-spawn-shield)
      (send-event *camera* 'teleport)
      )
    )
  (none)
  )

(defbehavior bf-hold-at-spawn bf-director ()
  "During a deployment, keep Jak at his side's spawn until he stands on real ground: the battle's
   `start` drops him there before the collision of the ground is loaded (seen in game: he fell
   through the port and died)."
  (let* ((cont (bf-camp-continue))
         (at (if cont (-> cont trans) (-> *bf* spawn (-> *bf* team))))
         )
    (when (and *target*
               (not (focus-test? *target* dead))
               (not (logtest? (-> *target* control status) (collide-status on-surface)))
               (< (-> *target* control trans y) (+ (-> at y) (meters -1)))
               )
      (move-to-point! (-> *target* control) at)
      (vector-reset! (-> *target* control transv))
      )
    )
  (none)
  )

;; The fact the dead units' pickups are born with: gone BF_DROP_LIFE after they appear, wherever
;; Jak is (collectables.gc initialize-options: without no-distance-check-fadeout a pickup only
;; fades with Jak over 50 m away). Its process stays 0: birth-pickup-at-point reads the entity of a
;; nonzero one.
(define *bf-drop-fact* (new 'static 'fact-info
                            :options (actor-option fade-out no-distance-check-fadeout)
                            :fade-time BF_DROP_LIFE
                            )
  )

(define-perm *bf-stock-verify-pickup-type* (function pickup-type pickup-type) verify-pickup-type)

(defun verify-pickup-type ((arg0 pickup-type))
  "The pickup a type turns into (collectables.gc): red, blue and dark ammo become yellow when the
   player lacks that gun. During a battle red, blue and dark ammo stay what they are: the grenades,
   the tazer's recharge and a jetpack's rockets (`bf-queue-drop`), whatever guns the save has."
  (if (and (bf-active?)
           (or (= arg0 (pickup-type ammo-red)) (= arg0 (pickup-type ammo-blue)) (= arg0 (pickup-type ammo-dark)))
           )
      arg0
      (*bf-stock-verify-pickup-type* arg0)
      )
  )

(defconstant BF_DROP_PROBE (meters 80)) ;; how far down a dead unit's pickups look for the ground

(defun bf-ground-under ((pos vector))
  "The height a pickup rests at under POS: the centre of a 0.3 m sphere probed straight down
   BF_DROP_PROBE onto the scenery, so 0.3 m over the ground. POS's own height when nothing is there
   (over the sea, off the map)."
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (vector-copy! (-> cq start-pos) pos)
    (set-vector! (-> cq move-dist) 0.0 (- BF_DROP_PROBE) 0.0 1.0)
    (set! (-> cq radius) (meters 0.3))
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (let ((u (fill-and-probe-using-line-sphere *collide-cache* cq)))
      (if (>= u 0.0)
          (- (-> pos y) (* u BF_DROP_PROBE))
          (-> pos y)
          )
      )
    )
  )

(defbehavior bf-spawn-drops bf-director ()
  "Spawn the pickups the dead units left (battlefront-h.gc `bf-queue-drop`): the stock ammo, health
   and dark eco pickups, which give Jak ammo and health the stock way, each gone BF_DROP_LIFE after
   it appears (`*bf-drop-fact*`). Dark eco comes as 3 pills (6 units), a full jetpack's worth
   (battlefront-player.gc BF_DARK_FUEL).
   They pop up from where the unit died and fall onto the ground under it (round 32, the author's
   wish): a pickup born moving bounces (collectables.gc `deploy`: gravity, no collision) down to its
   `base`, the height it was born at, so a jetpack guard's pickups stayed in the air. Each one born
   here gets the ground's height (`bf-ground-under`) as its `base`."
  (dotimes (i (-> *bf* drop-count))
    (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* drop-pos i))))
      (+! (-> pos y) (meters 1))
      (let ((kind (the-as pickup-type (-> *bf* drop-kind i))))
        (birth-pickup-at-point pos kind (if (= kind (pickup-type eco-pill-dark)) 6.0 1.0) #t *entity-pool* *bf-drop-fact*)
        )
      ;; the pickups just born head *entity-pool*'s children (gkernel.gc change-parent puts a new
      ;; child first), their base where they were born; an ammo pickup also takes no fade time
      ;; from its fact (collectables.gc initialize-ammo-by-other: 15 s)
      (let ((y (fmin (-> pos y) (bf-ground-under pos)))
            (p (-> *entity-pool* child))
            )
        (while (and p
                    (type? (-> p 0) collectable)
                    (= (vector-vector-distance (-> (the-as collectable (-> p 0)) base) pos) 0.0)
                    )
          (set! (-> (the-as collectable (-> p 0)) base y) y)
          (set! (-> (the-as collectable (-> p 0)) fadeout-timeout) BF_DROP_LIFE)
          (set! p (-> p 0 brother))
          )
        )
      )
    )
  (set! (-> *bf* drop-count) 0)
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------------------------

;; Black pages: under the battle's pages only the class preview is drawn, on black. The world's
;; renderers are off (the vu1 mask the stock menus set, which drawable.gc copies every frame), and
;; every drawn model other than a `bf-icon` is hidden, its handle kept to show it again.
(deftype bf-black-work (structure)
  ((on?     symbol)
   (count   int32)
   (vu1     vu1-renderer-mask)  ;; the renderers on before
   (hidden  uint64 1024)        ;; handles of the hidden models
   )
  )

(define *bf-black* (new 'static 'bf-black-work))
(set! (-> *bf-black* on?) #f)

(defun bf-black-hide ((proc process))
  "`bf-black-set!` callback: hide PROC's model when it is drawn and not a `bf-icon`, keeping its
   handle. Jak stays drawn while a deployment loads the zone (the game runs under its class page): a
   hidden Jak's bones, and his collision with them, stay where they were, and moved by a respawn
   while hidden he fell through the ground (battlefront-player.gc `bf-target-bones!`). #t: go on
   into its children."
  (when (and (type? proc process-drawable)
             (not (type? proc bf-icon))
             (not (and (= proc *target*) (= (-> *bf* phase) BF_PHASE_DEPLOY)))
             (< (-> *bf-black* count) 1024)
             )
    (let ((draw (-> (the-as process-drawable proc) draw)))
      (when (and draw (nonzero? draw) (not (logtest? (-> draw status) (draw-control-status no-draw))))
        (logior! (-> draw status) (draw-control-status no-draw))
        (set! (-> *bf-black* hidden (-> *bf-black* count)) (the-as uint64 (process->handle proc)))
        (+! (-> *bf-black* count) 1)
        )
      )
    )
  #t
  )

(defun bf-black-set! ((on? symbol))
  "Black pages on (ON?) or off (`*bf-black*`). On: only the foreground renderers, which draw the
   preview, and the models hidden. Off: the renderers and the models back. The renderers kept are
   the game's own: while the START menu's still screen is up, or its last frames (a page closing
   into a deployment), the display holds the menu's (merc alone) and the still screen keeps the
   game's (blit-displays.gc); kept from the display then, they left the battle with no scenery."
  (when (!= on? (-> *bf-black* on?))
    (set! (-> *bf-black* on?) on?)
    (cond
      (on?
        (set! (-> *bf-black* vu1) (if (get-screen-copied *blit-displays-work*)
                                      (-> *blit-displays-work* vu1-enable-user-menu)
                                      (-> *display* vu1-enable-user-menu)
                                      )
              )
        (set! (-> *display* vu1-enable-user-menu) (vu1-renderer-mask generic merc emerc))
        (set! (-> *bf-black* count) 0)
        (iterate-process-tree *active-pool* (the-as (function object object) bf-black-hide) *kernel-context*)
        )
      (else
        (set! (-> *display* vu1-enable-user-menu) (-> *bf-black* vu1))
        (dotimes (i (-> *bf-black* count))
          (let ((proc (handle->process (the-as handle (-> *bf-black* hidden i)))))
            (if proc
                (logclear! (-> (the-as process-drawable proc) draw status) (draw-control-status no-draw))
                )
            )
          )
        (set! (-> *bf-black* count) 0)
        )
      )
    )
  (none)
  )

(defbehavior bf-progress-host! bf-director ()
  "The open page in the START menu: the menu opened on it ('battlefront, `bf-progress-spawn!`), or
   turned to it from the menu's page up (the title menu, `push-state`); kept when it shows it. The
   menu pauses the game ('progress)."
  (set! (-> self page-time) (-> *display* real-clock frame-counter))
  (if *progress-process*
      (format 0 "battlefront: page ~D to the START menu (~A, next ~A, depth ~D)~%" (-> self page)
              (-> *progress-process* 0 current) (-> *progress-process* 0 next) (-> *progress-process* 0 state-pos))
      (format 0 "battlefront: page ~D to a new START menu~%" (-> self page))
      )
  (cond
    ((bf-progress-on?)
     0
     )
    ((and *progress-process*
          (!= (-> *progress-process* 0 current) 'go-away)
          (!= (-> *progress-process* 0 next) 'go-away)
          )
     (push-state (-> *progress-process* 0))
     (set-next-state (-> *progress-process* 0) 'battlefront 0)
     )
    (else
      (bf-progress-spawn!)
      )
    )
  (none)
  )

(defun bf-to-title! ()
  "A battle over (its result page's X, or Quit the battle on its pause page): the game's title menu,
   its entries the battle's (`*bf-title*`: Start a battle, Options, Quit; round 33, the author's
   wish). A new game at the title's continue point without its intro, title-restart, as the stock
   demo's return to the title does (progress.gc). Side effects: the whole game reset."
  (set! (-> *game-info* mode) 'play)
  (initialize! *game-info* 'game (the-as game-save #f) "title-restart" (the-as resetter-spec #f))
  (set-master-mode 'game)
  ;; its "Press START" pressed for the player: the menu at once (`bf-title-press!`)
  (set! *bf-title-press-until* (+ (-> *display* real-clock frame-counter) (seconds 60)))
  (none)
  )

(defbehavior bf-back-to-title bf-director ()
  "Triangle on the war zone page opened from the title: the page gone, the START menu back to the
   title menu (`pop-state`)."
  (set! (-> self page) BF_PAGE_NONE)
  (set! (-> self from-title?) #f)
  (false! *popup-menu-open*)
  (if *progress-process*
      (pop-state (-> *progress-process* 0))
      )
  (none)
  )

(defbehavior bf-show-page bf-director ((page int))
  "Show PAGE in the START menu (`bf-progress-host!`); BF_PAGE_LOADING, a deployment loading its war
   zone, on black, the game running (`bf-deploy-update` closes it once the zone is ready). Like
   popup-menu, the flag keeps the Mods menu from opening over it."
  (set! (-> self page) page)
  (set! (-> self cursor) 0)
  (true! *popup-menu-open*)
  (cond
    ((= page BF_PAGE_LOADING)
     (if (bf-progress-on?)
         (set-next-state (-> *progress-process* 0) 'go-away 0)
         )
     (bf-black-set! #t)
     )
    (else
      (bf-progress-host!)
      )
    )
  (none)
  )

(defbehavior bf-open-page bf-director ((page int))
  "Show PAGE (`bf-show-page`)."
  (bf-show-page page)
  (none)
  )

(defbehavior bf-close-page bf-director ()
  "Hide the page: the START menu closes when it shows it ('go-away), the game resumes."
  (set! (-> self page) BF_PAGE_NONE)
  (set! (-> *bf* respawn-pick) -1)
  (bf-black-set! #f)
  (false! *popup-menu-open*)
  (if (bf-progress-on?)
      (set-next-state (-> *progress-process* 0) 'go-away 0)
      )
  (none)
  )

(defbehavior bf-open-class-page bf-director ((mode int))
  "The class page of the player's side (round 30), MODE BF_CLASS_*: a new battle's class
   (BF_CLASS_DEPLOY, the side `pick-team`), the dead player's respawn or the pause page's
   Redeploy, class and respawn point (BF_CLASS_RESPAWN, BF_CLASS_REDEPLOY). The cursor on his class,
   the point his respawn point while his side holds it, else its base."
  (set! (-> self class-mode) mode)
  (set! (-> self respawn?) (!= mode BF_CLASS_DEPLOY))
  (if (= mode BF_CLASS_DEPLOY)
      ;; the side's classes (`bf-class-count` reads the battle's side)
      (set! (-> *bf* team) (-> self pick-team))
      (set! (-> self pick-team) (-> *bf* team))
      )
  (bf-show-page BF_PAGE_CLASS)
  (set! (-> self cursor) (if (= mode BF_CLASS_DEPLOY)
                             (max 0 (min (+ (bf-class-count) -1) (-> self pick-class)))
                             (max 0 (min (+ (bf-class-count) -1) (- (-> *bf* class) (* 4 (-> *bf* team)))))
                             )
        )
  (set! (-> self pick-class) (-> self cursor))
  (set! (-> self pick-point) (if (and (bf-active?) (bf-point-held? (-> *bf* respawn-point) (-> *bf* team)))
                                 (-> *bf* respawn-point)
                                 (-> *bf* team)
                                 )
        )
  (none)
  )

(defbehavior bf-class-apply! bf-director ()
  "A deployment's war zone is ready: the player goes in as his class (`*bf*` class, picked before)
   with fresh ammo and his class's full health, his model drawn as soon as it is in (`want-avatar?`),
   Jak hidden meanwhile, the spawn shield on; his respawn point his base."
  (set! (-> *bf* weapon) BF_WEAPON_RIFLE)
  (set! (-> *bf* respawn-point) (-> *bf* team))
  (bf-refill-ammo)
  (if *target*
      (set! (-> *target* fact health) (bf-class-health (-> *bf* class)))
      )
  (set! (-> self want-avatar?) #t)
  (bf-avatar-kill)
  (if *target*
      (logior! (-> *target* draw status) (draw-control-status no-draw))
      )
  (bf-spawn-shield)
  (none)
  )

(defbehavior bf-menu-confirm bf-director ()
  "X on the open page."
  (let ((page (-> self page))
        (i (-> self cursor))
        )
    (cond
      ((and (= page BF_PAGE_ZONE) (not (bf-zone-open? i)))
       ;; Spargus, to come, and Jak 2's city without Jak 2: refused
       (sound-play "menu-back")
       (return #f)
       )
      ((and (= page BF_PAGE_ZONE) (-> self from-title?))
       (set! (-> self pick-zone) i)
       ;; its tables and its city level as the units' levels' host, before its levels load
       (set! (-> *bf* zone) i)
       (bf-zone-select! i)
       (bf-open-page BF_PAGE_CONFIG)
       (set! (-> self cursor) (+ BF_CONFIG_COUNT -1))
       )
      ((= page BF_PAGE_ZONE)
       (set! (-> self pick-zone) i)
       (set! (-> *bf* zone) i)
       (bf-zone-select! i)
       (bf-open-page BF_PAGE_TEAM)
       )
      ((and (= page BF_PAGE_CONFIG) (< i (+ BF_CONFIG_COUNT -1)))
       ;; a setting: Left and Right change it
       (return #f)
       )
      ((= page BF_PAGE_CONFIG)
       ;; Next: the class first (round 30), then the battle
       (set! (-> self pick-team) (-> *bf-config* team-a))
       (bf-open-class-page BF_CLASS_DEPLOY)
       )
      ((= page BF_PAGE_TEAM)
       (set! (-> self pick-team) i)
       (bf-open-class-page BF_CLASS_DEPLOY)
       )
      ((and (= page BF_PAGE_CLASS) (= (-> self class-mode) BF_CLASS_DEPLOY) (-> self from-title?))
       ;; from the title: a new game in the city, at the side's spawn; the battle's deployment once
       ;; Jak stands there (`*bf-request*` BF_REQ_START, `bf-director-update`), as the class picked
       (bf-close-page)
       (set! *bf-request* BF_REQ_START)
       (set! (-> *game-info* mode) 'play)
       (initialize! *game-info* 'game (the-as game-save #f)
                    (if (= (-> self pick-team) BF_TEAM_FF)
                        (-> *bf-zones* (-> self pick-zone) ff-continue)
                        (-> *bf-zones* (-> self pick-zone) kg-continue)
                        )
                    (the-as resetter-spec #f)
                    )
       (set-master-mode 'game)
       )
      ((and (= page BF_PAGE_CLASS) (= (-> self class-mode) BF_CLASS_DEPLOY))
       ;; in the city: the deployment at once, its war zone loading on black (`bf-deploy-update`)
       (bf-close-page)
       (bf-start-battle! (-> self pick-zone) (-> self pick-team) (+ (* 4 (-> self pick-team)) (-> self pick-class)))
       (if (bf-active?)
           (bf-open-page BF_PAGE_LOADING)
           )
       )
      ((and (= page BF_PAGE_CLASS) (-> self respawn?) (< i (bf-class-count)))
       ;; a respawn or a redeploy, X on a class (round 31, the author's wish): that class, the
       ;; cursor on to the respawn point, whose X then confirms both
       (set! (-> self pick-class) i)
       (set! (-> self cursor) (bf-class-count))
       )
      ((= page BF_PAGE_CLASS)
       ;; a respawn or a redeploy: his class and respawn point, kept for the next deaths
       (set! (-> *bf* class) (+ (* (-> self pick-team) 4) (-> self pick-class)))
       (set! (-> *bf* weapon) BF_WEAPON_RIFLE)
       (set! (-> *bf* respawn-point) (-> self pick-point))
       (set! (-> *bf* respawn-choice) (-> self pick-point))
       (bf-close-page)
       ;; a redeploy: his death without a wait, then there (`bf-target-death`)
       (if (= (-> self class-mode) BF_CLASS_REDEPLOY)
           (set! *bf-request* BF_REQ_REDEPLOY)
           )
       (set! (-> self respawn?) #f)
       )
      ((= page BF_PAGE_RESULT)
       (bf-close-page)
       (bf-end-battle!)
       (bf-to-title!)
       )
      ((and (= page BF_PAGE_PAUSE) (not (bf-pause-ok? i)))
       (sound-play "menu-back")
       (return #f)
       )
      ((and (= page BF_PAGE_PAUSE) (= i BF_PAUSE_REDEPLOY))
       ;; Redeploy: the class page, its class and respawn point (round 30)
       (bf-open-class-page BF_CLASS_REDEPLOY)
       )
      ((= page BF_PAGE_PAUSE)
       ;; the request runs once the page is closed and the game runs again (`bf-director-update`)
       (bf-close-page)
       (set! *bf-request* (-> *bf-pause-reqs* i))
       )
      )
    )
  (sound-play "menu-pick")
  (none)
  )

(defbehavior bf-menu-back bf-director ()
  "Triangle or Circle on the open page: the page before it (round 30: the class page too). A
   respawn's class page goes back to the death screen, a redeploy's to the pause page."
  (let ((page (-> self page)))
    (cond
      ((and (= page BF_PAGE_ZONE) (-> self from-title?))
       (bf-back-to-title)
       )
      ((= page BF_PAGE_ZONE)
       (bf-open-page BF_PAGE_PAUSE)
       (set! (-> self cursor) 1)
       )
      ((and (= page BF_PAGE_CLASS) (= (-> self class-mode) BF_CLASS_DEPLOY) (-> self from-title?))
       (bf-open-page BF_PAGE_CONFIG)
       (set! (-> self cursor) (+ BF_CONFIG_COUNT -1))
       )
      ((and (= page BF_PAGE_CLASS) (= (-> self class-mode) BF_CLASS_DEPLOY))
       (bf-open-page BF_PAGE_TEAM)
       (set! (-> self cursor) (-> self pick-team))
       )
      ((and (= page BF_PAGE_CLASS) (= (-> self class-mode) BF_CLASS_REDEPLOY))
       (set! (-> self respawn?) #f)
       (bf-open-page BF_PAGE_PAUSE)
       (set! (-> self cursor) BF_PAUSE_REDEPLOY)
       )
      ((= page BF_PAGE_CLASS)
       ;; the respawn's: back to the death screen, nothing changed
       (set! (-> self respawn?) #f)
       (set! (-> *bf* respawn-choice) -1)
       (bf-close-page)
       )
      ((= page BF_PAGE_CONFIG)
       (bf-open-page BF_PAGE_ZONE)
       (set! (-> self cursor) (-> self pick-zone))
       )
      ((= page BF_PAGE_TEAM)
       (bf-open-page BF_PAGE_ZONE)
       (set! (-> self cursor) (-> self pick-zone))
       )
      ((= page BF_PAGE_PAUSE)
       (bf-close-page)
       (set! (-> self page-time) (-> *display* real-clock frame-counter))
       )
      )
    )
  (sound-play "menu-pick")
  (none)
  )

(defun bf-config-change ((row int) (step int))
  "Left (STEP -1) or Right (1) on row ROW of the configuration page (`*bf-config*`): the time limit
   through `*bf-time-choices*`, the units per side by 50 from 50 to 1000, the units at once per side
   by 10 from 30 to 100, the victory condition, the special characters (refused: none yet), the
   player's side or the other, each changing both (two sides never the same)."
  (let ((c *bf-config*))
    (case row
      ((0)
       (let ((k 0))
         (dotimes (i 6)
           (if (= (-> *bf-time-choices* i) (-> c minutes))
               (set! k i)
               )
           )
         (set! (-> c minutes) (-> *bf-time-choices* (mod (+ k step 6) 6)))
         )
       )
      ((1)
       (set! (-> c units) (max 50 (min 1000 (+ (-> c units) (* 50 step)))))
       )
      ((2)
       (set! (-> c at-once) (max BF_AT_ONCE_MIN (min BF_AT_ONCE_MAX (+ (-> c at-once) (* 10 step)))))
       )
      ((3)
       (set! (-> c victory) (- 1 (-> c victory)))
       )
      ((4)
       (sound-play "menu-back")
       (return #f)
       )
      ((5 6)
       (set! (-> c team-a) (- 1 (-> c team-a)))
       (set! (-> c team-b) (- 1 (-> c team-a)))
       )
      (else
        (return #f)
        )
      )
    )
  (sound-play "menu-pick")
  (none)
  )

(defun bf-config-value ((row int))
  "Value of row ROW of the configuration page, in the game's language."
  (let ((c *bf-config*))
    (clear *bf-text*)
    (case row
      ((0)
       (if (zero? (-> c minutes))
           (format *bf-text* (bf-tr "None" "Aucune"))
           (format *bf-text* "~D min" (-> c minutes))
           )
       )
      ((1) (format *bf-text* "~D" (-> c units)))
      ((2) (format *bf-text* "~D" (-> c at-once)))
      ((3) (format *bf-text* (if (= (-> c victory) BF_WIN_POINTS) (bf-tr "Control points" "Contrôle des points") (bf-tr "Units wiped out" "Unités anéanties"))))
      ((4) (format *bf-text* (bf-tr "No" "Non")))
      ((5) (format *bf-text* "~S" (bf-team-name (-> c team-a))))
      (else (format *bf-text* "~S" (bf-team-name (-> c team-b))))
      )
    *bf-text*
    )
  )

(defun bf-draw-panel-border ((buf dma-buffer) (x float) (y float) (w float) (h float) (color rgba))
  "The border of a panel, 1.5 screen units thick, in COLOR (`bf-draw-line`)."
  (bf-draw-line buf x y (+ x w) y 1.5 color)
  (bf-draw-line buf (+ x w) y (+ x w) (+ y h) 1.5 color)
  (bf-draw-line buf (+ x w) (+ y h) x (+ y h) 1.5 color)
  (bf-draw-line buf x (+ y h) x y 1.5 color)
  (none)
  )


(defun bf-draw-arrow ((buf dma-buffer) (x float) (y float) (dir float) (on? symbol))
  "A small arrow pointing left (DIR -1) or right (1), its tip at (X, Y), in the START menu's white
   when ON? (the cursor's row), else its yellow, faded with the page: the font draws < and > as its
   button icons."
  (bf-draw-tri buf x y (- x (* dir 6.0)) (- y 5.0) (- x (* dir 6.0)) (+ y 5.0)
               (bf-fade (if on? (static-rgba 128 128 128 128) (static-rgba 128 120 50 128)))
               )
  (none)
  )

(defun bf-draw-map-marks ((buf dma-buffer) (zone int) (pick int))
  "Over a map of the war zone, the same on every page and on L3 (the author's wish, round 30):
   during a battle the units awake as small dots of their side's
   color (`*bf-unit-dots*`) and each point's mark in its holder's color, live, blinking while a side
   takes it (`bf-draw-point-mark`), Jak in white; before one, where `*bf-point-defs*` puts them,
   the bases in their side's color and the control points grey. The point PICK (-1 none) ringed in
   blinking yellow."
  ;; out of a battle, the zone shown is the one picked or under the cursor: its points
  (if (not (bf-active?))
      (bf-zone-select! zone)
      )
  (bf-zone-view! zone)
  (let ((at (new 'stack-no-clear 'vector))
        (blink? (logtest? (/ (-> *display* real-clock frame-counter) (seconds 0.25)) 1))
        (alpha (-> *bf-frame* alpha))
        (active? (and (bf-active?) (< 0 (-> *bf* point-count))))
        )
    (if (= *master-mode* 'game)
        (set! alpha 1.0)
        )
    (when active?
      (dotimes (d (-> *bf-unit-dots* count))
        (if (bf-zone-xy zone (-> *bf-unit-dots* pos d) at)
            (bf-draw-disc buf (-> at x) (-> at y) 1.4
                          (bf-rgba-k (if (= (-> *bf-unit-dots* team d) BF_TEAM_FF) (static-rgba 60 150 255 128) (static-rgba 255 60 60 128)) alpha)
                          )
            )
        )
      )
    (dotimes (i (-> *bf-point-defs* length))
      (let ((base? (< i 2))
            (owner (cond
                     ((< i 2) i)
                     (active? (-> *bf* points i owner))
                     (else BF_TEAM_NONE)
                     )
                   )
            )
        (if active?
            (vector-copy! at (-> *bf* points i pos))
            (let ((def (-> *bf-point-defs* i))
                  (cont (if (< i 2) (bf-zone-continue zone i) (the-as continue-point #f)))
                  )
              (if cont
                  (vector-copy! at (-> cont trans))
                  (set-vector! at (meters (-> def x)) (meters (-> def y)) (meters (-> def z)) 1.0)
                  )
              )
            )
        (when (bf-zone-xy zone at at)
          (bf-draw-point-mark buf (-> at x) (-> at y) (if base? 3.0 3.6) (if base? (the-as string #f) (bf-point-letter i)) owner
                              (and active? (bf-point-capturing? (-> *bf* points i))) alpha
                              )
          (if (= i pick)
              (bf-draw-ring buf (-> at x) (-> at y) 6.0 7.5
                            (bf-rgba-k (if blink? (static-rgba 255 230 60 128) (static-rgba 255 230 60 60)) alpha)
                            )
              )
          )
        )
      )
    (if (and active? *target* (not (focus-test? *target* dead)) (bf-zone-xy zone (-> *target* control trans) at))
        (bf-draw-disc buf (-> at x) (-> at y) 2.2 (bf-rgba-k (static-rgba 255 255 255 128) alpha))
        )
    )
  (none)
  )

(defbehavior bf-draw-list-page bf-director ((buf dma-buffer))
  "The war zone and side pages: the choices on the left and, under them, what the one under the
   cursor is; on the right the war zone's map with its bases and points (`bf-draw-zone-minimap`
   under the page), or Coming soon for Spargus."
  (let* ((page (-> self page))
         (cur (-> self cursor))
         (x (bf-fx 0.03))
         (w (* 0.45 (-> *bf-frame* w)))
         )
    (bf-pheader buf (if (= page BF_PAGE_ZONE) (bf-tr "War zone" "Zone de guerre") (bf-tr "Your side" "Votre camp")))
    (dotimes (i (bf-page-count page))
      (bf-prow buf (bf-page-label page (-> self pick-team) i) x (+ (bf-fy 0.03) (* 21.0 (the float i))) w (= i cur)
               (not (and (= page BF_PAGE_ZONE) (not (bf-zone-open? i))))
               )
      )
    (bf-pwrap buf (bf-page-desc page (-> self pick-team) cur) x (bf-fy 0.4) 0.36 w (the int (/ w 6.0)))
    (if (and (= page BF_PAGE_ZONE) (not (bf-zone-open? cur)))
        (bf-ptext buf (if (>= cur BF_ZONE_COUNT) (bf-tr "Coming soon" "À venir") (bf-tr "Needs Jak 2" "Jak 2 requis")) (bf-fx 0.76) (bf-fy 0.42) 0.6 (font-color menu-invalid) #t (* 0.45 (-> *bf-frame* w)))
        (bf-draw-map-marks buf (if (= page BF_PAGE_ZONE) cur (-> self pick-zone)) -1)
        )
    (bf-pkeys buf (bf-tr "<PAD_X> Select    <PAD_TRIANGLE> Back" "<PAD_X> Choisir    <PAD_TRIANGLE> Retour"))
    )
  (none)
  )

(defbehavior bf-draw-config-page bf-director ((buf dma-buffer))
  "The battle setup (round 29), in three columns: its settings on the left, each its value between
   arrows; the war zone's map with its points in the middle; the two sides on the right, the
   player's on top, and Next. The cursor's row in the START menu's white under its highlight bar."
  (let* ((cur (-> self cursor))
         (lx (bf-fx 0.0))
         (lw (* 0.37 (-> *bf-frame* w)))
         (rx (bf-fx 0.66))
         (rw (* 0.34 (-> *bf-frame* w)))
         (rh (fmin 50.0 (* 0.2 (-> *bf-frame* h))))
         )
    (bf-pheader buf (bf-tr "Battle setup" "Configuration de la bataille"))
    (dotimes (i BF_CONFIG_SETTINGS)
      (let ((y (+ (bf-fy 0.02) (* rh (the float i)))))
        (if (= i cur)
            (bf-pbox buf lx (+ y -2.0) lw (+ rh -6.0) (static-rgba 128 128 64 64))
            )
        (bf-ptext buf
                  (case i
                    ((0) (bf-tr "Time limit" "Limite de temps"))
                    ((1) (bf-tr "Units per side" "Unités par équipe"))
                    ((2) (bf-tr "Units at once per side" "Unités simultanées par équipe"))
                    ((3) (bf-tr "Victory" "Condition de victoire"))
                    (else (bf-tr "Special characters" "Personnages spéciaux"))
                    )
                  (+ lx 4.0) y 0.36 (font-color font-color-32) #f (+ lw -8.0)
                  )
        (bf-config-value i)
        (bf-draw-arrow buf (+ lx 4.0) (+ y 23.0) -1.0 (= i cur))
        (bf-ptext buf *bf-text* (+ lx (* 0.5 lw)) (+ y 17.0) 0.4
                  (cond
                    ((= i 4) (font-color menu-invalid))
                    ((= i cur) (font-color font-color-33))
                    (else (font-color font-color-32))
                    )
                  #t (+ lw -26.0)
                  )
        (bf-draw-arrow buf (+ lx lw -4.0) (+ y 23.0) 1.0 (= i cur))
        )
      )
    (bf-ptext buf (bf-tr "Yes: coming soon" "Oui : à venir") (+ lx (* 0.5 lw)) (+ (bf-fy 0.02) (* 4.0 rh) 31.0) 0.3
              (font-color menu-invalid) #t lw
              )
    ;; the sides
    (dotimes (k 2)
      (let ((y (+ (bf-fy 0.04) (* 54.0 (the float k))))
            (row (+ BF_CONFIG_SETTINGS k))
            )
        (if (= row cur)
            (bf-pbox buf rx (+ y -2.0) rw 42.0 (static-rgba 128 128 64 64))
            )
        (bf-ptext buf (if (zero? k) (bf-tr "Your side" "Votre camp") (bf-tr "The enemy" "L'adversaire"))
                  (+ rx (* 0.5 rw)) y 0.36 (font-color font-color-32) #t rw
                  )
        (bf-config-value row)
        (bf-draw-arrow buf (+ rx 4.0) (+ y 23.0) -1.0 (= row cur))
        (bf-ptext buf *bf-text* (+ rx (* 0.5 rw)) (+ y 17.0) 0.4
                  (if (= row cur)
                      (font-color font-color-33)
                      (bf-team-color (if (zero? k) (-> *bf-config* team-a) (-> *bf-config* team-b)))
                      )
                  #t (+ rw -26.0)
                  )
        (bf-draw-arrow buf (+ rx rw -4.0) (+ y 23.0) 1.0 (= row cur))
        )
      )
    (let ((y (bf-fy 0.78)))
      (if (= cur (+ BF_CONFIG_COUNT -1))
          (bf-pbox buf (+ rx 4.0) (+ y -3.0) (+ rw -10.0) 22.0 (static-rgba 128 128 64 64))
          )
      (bf-draw-panel-border buf (+ rx 4.0) (+ y -3.0) (+ rw -10.0) 22.0 (bf-fade (static-rgba 128 128 64 110)))
      (bf-ptext buf (bf-tr "Next" "Suivant") (+ rx (* 0.5 rw)) y 0.5
                (if (= cur (+ BF_CONFIG_COUNT -1)) (font-color font-color-33) (font-color font-color-32))
                #t rw
                )
      )
    (bf-draw-map-marks buf (-> self pick-zone) -1)
    (bf-pkeys buf (bf-tr "<PAD_X> Next    <PAD_DPAD_ANY> Change    <PAD_TRIANGLE> Back"
                         "<PAD_X> Suivant    <PAD_DPAD_ANY> Modifier    <PAD_TRIANGLE> Retour"
                         )
              )
    )
  (none)
  )

(defbehavior bf-draw-class-page bf-director ((buf dma-buffer))
  "The class page (round 29: a deployment, a death's respawn, a redeploy, Change class), in three
   columns: on the left the side's classes, the cursor's under the highlight bar, then after a death
   or for a redeploy the respawn point (Left and Right: the side's base or a control point it holds),
   then what the class picked does with its buttons (battlefront-h.gc `*bf-classes*`); in the middle
   the reserves, the class's picture (`bf-draw-portrait`) and the button (Spawn,
   Start the battle from the title, Deploy); on the right the objective and the battlefield's radar
   on the war zone's own map, live (`bf-draw-map-marks`)."
  (let* ((team (-> self pick-team))
         (n (bf-class-count))
         (cur (-> self cursor))
         (respawn? (-> self respawn?))
         (button (if respawn? (+ n 1) n))
         (class (+ (* team 4) (-> self pick-class)))
         (lx (bf-fx 0.0))
         (lw (* 0.38 (-> *bf-frame* w)))
         (mx (bf-fx BF_CLASS_HOLE_X0))
         (mw (* (- BF_CLASS_HOLE_X1 BF_CLASS_HOLE_X0) (-> *bf-frame* w)))
         (cxm (+ mx (* 0.5 mw)))
         (rx (bf-fx 0.68))
         (rw (* 0.32 (-> *bf-frame* w)))
         (y (bf-fy 0.01))
         (rim (bf-fade (static-rgba 128 128 64 110)))
         )
    (bf-pheader buf (if respawn? (bf-tr "Respawn" "Réapparition") (bf-team-name team)))
    ;; left: the classes, the respawn point, the help of the class picked
    (let ((scale 0.36))
      (dotimes (i n)
        (set! scale (fmin scale (bf-fit-scale (bf-class-name (+ (* team 4) i)) 0.36 (+ lw -12.0))))
        )
      (dotimes (i n)
        (if (= i cur)
            (bf-pbox buf (+ lx 2.0) (+ y -1.0) (+ lw -4.0) 14.0 (static-rgba 128 128 64 64))
            )
        (bf-ptext buf (bf-class-name (+ (* team 4) i)) (+ lx 6.0) y scale
                  (if (= i cur) (font-color font-color-33) (font-color font-color-32))
                  #f (+ lw -12.0)
                  )
        (+! y 15.0)
        )
      )
    (when respawn?
      (+! y 3.0)
      (if (= cur n)
          (bf-pbox buf (+ lx 2.0) (+ y -1.0) (+ lw -4.0) 28.0 (static-rgba 128 128 64 64))
          )
      (bf-ptext buf (bf-tr "Respawn point" "Point de réapparition") (+ lx 6.0) y 0.3 (font-color font-color-32) #f (+ lw -12.0))
      (clear *bf-text*)
      (format *bf-text* "~S" (if (< (-> self pick-point) 2) (bf-tr "Base" "Base") (bf-point-name (-> self pick-point))))
      (bf-draw-arrow buf (+ lx 8.0) (+ y 18.0) -1.0 (= cur n))
      (bf-ptext buf *bf-text* (+ lx (* 0.5 lw)) (+ y 12.0) 0.36
                (if (= cur n) (font-color font-color-33) (bf-team-color team))
                #t (+ lw -26.0)
                )
      (bf-draw-arrow buf (+ lx lw -8.0) (+ y 18.0) 1.0 (= cur n))
      (+! y 30.0)
      )
    (+! y 4.0)
    (let ((lines (if (bf-fr?) (-> *bf-classes* class desc-fr) (-> *bf-classes* class desc))))
      (dotimes (i (-> lines length))
        (let* ((line (-> lines i))
               ;; a D-pad icon stands taller than a line
               (tall? (or (string-prefix= "~Y" line) (string-prefix= "<PAD_DPAD" line)))
               )
          (if tall?
              (+! y 2.0)
              )
          (bf-ptext buf line (+ lx 6.0) y 0.27 (font-color font-color-32) #f (+ lw -10.0))
          (+! y (if tall? 13.0 11.0))
          )
        )
      )
    ;; middle: the class's picture (round 30), the reserves (the setup's units before a battle), the
    ;; button
    (let* ((active? (bf-active?))
           (full (the float (max 1 (if active? (-> *bf* reserve-max) (-> *bf-config* units)))))
           (n-ff (if active? (-> *bf* reserve BF_TEAM_FF) (-> *bf-config* units)))
           (n-kg (if active? (-> *bf* reserve BF_TEAM_KG) (-> *bf-config* units)))
           (half (* 0.5 mw))
           (by (bf-fy 0.01))
           (ff (* (+ half -4.0) (fmin 1.0 (/ (the float n-ff) full))))
           (kg (* (+ half -4.0) (fmin 1.0 (/ (the float n-kg) full))))
           )
      (bf-pbox buf mx by mw 26.0 (static-rgba 46 64 96 80))
      (bf-draw-panel-border buf mx by mw 26.0 rim)
      (if (< 0.5 ff)
          (bf-pbox buf (- cxm 1.0 ff) (+ by 4.0) ff 6.0 (static-rgba 40 140 255 128))
          )
      (if (< 0.5 kg)
          (bf-pbox buf (+ cxm 1.0) (+ by 4.0) kg 6.0 (static-rgba 245 45 45 128))
          )
      (clear *bf-text*)
      (format *bf-text* "~D" n-ff)
      (bf-ptext buf *bf-text* (- cxm (* 0.5 half)) (+ by 11.0) 0.32 (font-color cyan) #t half)
      (clear *bf-text*)
      (format *bf-text* "~D" n-kg)
      (bf-ptext buf *bf-text* (+ cxm (* 0.5 half)) (+ by 11.0) 0.32 (font-color red) #t half)
      )
    (bf-draw-panel-border buf mx (bf-fy BF_CLASS_HOLE_Y0) mw (* (- BF_CLASS_HOLE_Y1 BF_CLASS_HOLE_Y0) (-> *bf-frame* h)) rim)
    (let ((by (bf-fy 0.79)))
      (if (= cur button)
          (bf-pbox buf mx (+ by -3.0) mw 22.0 (static-rgba 128 128 64 64))
          )
      (bf-draw-panel-border buf mx (+ by -3.0) mw 22.0 rim)
      (bf-ptext buf
                (cond
                  ((= (-> *bf* phase) BF_PHASE_DEPLOY) (bf-tr "Loading..." "Chargement..."))
                  (respawn? (bf-tr "Spawn" "Apparaître"))
                  ((-> self from-title?) (bf-tr "Start the battle" "Démarrer la bataille"))
                  (else (bf-tr "Deploy" "Déployer"))
                  )
                cxm by 0.45 (if (= cur button) (font-color font-color-33) (font-color font-color-32)) #t (+ mw -6.0)
                )
      )
    ;; right: the objective, the radar
    (bf-ptext buf (bf-tr "Objective" "Objectif") (+ rx 4.0) (bf-fy 0.01) 0.4 (font-color font-color-33) #f (+ rw -6.0))
    (bf-pwrap buf (bf-tr "For now: capture the control points" "Pour le moment : capturer les points de contrôle")
              (+ rx 4.0) (+ (bf-fy 0.01) 17.0) 0.32 (+ rw -6.0) (the int (/ rw 5.0))
              )
    (bf-draw-map-marks buf (if (bf-active?) (-> *bf* zone) (-> self pick-zone)) (if respawn? (-> self pick-point) -1))
    (bf-pkeys buf (if respawn?
                      (bf-tr "<PAD_X> Confirm    <PAD_DPAD_ANY> Class and respawn point" "<PAD_X> Valider    <PAD_DPAD_ANY> Classe et point de réapparition")
                      (bf-tr "<PAD_X> Confirm    <PAD_DPAD_ANY> Class" "<PAD_X> Valider    <PAD_DPAD_ANY> Classe")
                      )
              )
    )
  (none)
  )

(defbehavior bf-draw-pause-page bf-director ((buf dma-buffer))
  "START while the mode is on: the battle's entries on the left (the ones that do not apply grey),
   the city's map as it stands on the right, its points and units live (`bf-draw-map-marks`)."
  (let ((x (bf-fx 0.03))
        (w (* 0.42 (-> *bf-frame* w)))
        )
    (bf-pheader buf "Battlefront")
    (dotimes (i BF_PAUSE_COUNT)
      (bf-prow buf (bf-pause-label i) x (+ (bf-fy 0.03) (* 21.0 (the float i))) w (= i (-> self cursor)) (bf-pause-ok? i))
      )
    (bf-draw-map-marks buf (-> *bf* zone) -1)
    (bf-pkeys buf (bf-tr "<PAD_X> Select    <PAD_TRIANGLE> Resume" "<PAD_X> Choisir    <PAD_TRIANGLE> Reprendre"))
    )
  (none)
  )

(defun bf-draw-result-page ((buf dma-buffer))
  "A side has won: VICTORY or DEFEAT, the winner and both sides' losses; X leaves the battle."
  (let ((won? (= (-> *bf* winner) (-> *bf* team))))
    (bf-pheader buf "Battlefront")
    (bf-ptext buf (if won? (bf-tr "VICTORY" "VICTOIRE") (bf-tr "DEFEAT" "DÉFAITE")) (bf-fx 0.5) (bf-fy 0.14) 1.1
              (if won? (font-color green) (font-color red)) #t (-> *bf-frame* w)
              )
    (clear *bf-text*)
    (format *bf-text* (bf-tr "~S win" "Victoire : ~S") (bf-team-name (max 0 (-> *bf* winner))))
    (bf-ptext buf *bf-text* (bf-fx 0.5) (bf-fy 0.44) 0.5 (font-color font-color-33) #t (-> *bf-frame* w))
    (clear *bf-text*)
    (format *bf-text* (bf-tr "Losses: ~S ~D, ~S ~D" "Pertes : ~S ~D, ~S ~D")
            (bf-team-name 0) (-> *bf* losses 0) (bf-team-name 1) (-> *bf* losses 1)
            )
    (bf-ptext buf *bf-text* (bf-fx 0.5) (bf-fy 0.58) 0.4 (font-color font-color-32) #t (-> *bf-frame* w))
    (bf-pkeys buf (bf-tr "<PAD_X> Leave the battle" "<PAD_X> Quitter la bataille"))
    )
  (none)
  )

(defbehavior bf-page-map bf-director ()
  "Where the open page shows the war zone's map (`bf-zmap-set!`), and which zone, -1 for none: the
   same map on every page (the author's wish, round 30), the map alone (round 31: no disc), on the
   right of the war zone, side and pause pages, in the middle of the setup, on the right of the
   class page."
  (let ((page (-> self page))
        (w (-> *bf-frame* w))
        (h (-> *bf-frame* h))
        )
    (cond
      ((or (= page BF_PAGE_ZONE) (= page BF_PAGE_TEAM))
       (bf-zmap-set! (bf-fx 0.76) (bf-fy 0.45) (* 0.42 h) (* 0.21 w))
       (cond
         ((= page BF_PAGE_TEAM) (-> self pick-zone))
         ((bf-zone-open? (-> self cursor)) (-> self cursor))
         (else -1)
         )
       )
      ((= page BF_PAGE_CONFIG)
       (bf-zmap-set! (bf-fx 0.515) (bf-fy 0.45) (* 0.44 h) (* 0.12 w))
       (-> self pick-zone)
       )
      ((= page BF_PAGE_PAUSE)
       (bf-zmap-set! (bf-fx 0.74) (bf-fy 0.45) (* 0.44 h) (* 0.23 w))
       (-> *bf* zone)
       )
      ((= page BF_PAGE_CLASS)
       (bf-zmap-set! (bf-fx 0.84) (bf-fy 0.6) (* 0.3 h) (* 0.15 w))
       (if (bf-active?) (-> *bf* zone) (-> self pick-zone))
       )
      (else
        -1
        )
      )
    )
  )

(defbehavior bf-menu-draw bf-director ()
  "The open page in the START menu this frame, once the menu shows it: the war zone's map under it
   (`bf-page-map`, `bf-draw-zone-minimap`), then the page in the menu's text bucket, its shapes
   first, its text over them."
  (when (and *progress-process* (= (-> *progress-process* 0 current) 'battlefront) (< 0.0 (-> *bf-frame* alpha)))
    (let ((zone (bf-page-map)))
      (if (>= zone 0)
          (bf-draw-zone-minimap zone)
          )
      )
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id hud-draw-hud-alpha))
      (dma-buffer-add-gs-set buf
                             (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                             (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                             )
      (let ((page (-> self page)))
        (cond
          ((or (= page BF_PAGE_ZONE) (= page BF_PAGE_TEAM)) (bf-draw-list-page buf))
          ((= page BF_PAGE_CONFIG) (bf-draw-config-page buf))
          ((= page BF_PAGE_CLASS) (bf-draw-class-page buf))
          ((= page BF_PAGE_PAUSE) (bf-draw-pause-page buf))
          ((= page BF_PAGE_RESULT) (bf-draw-result-page buf))
          )
        )
      )
    ;; the class page's picture, in its own bucket (`bf-draw-portrait`)
    (if (= (-> self page) BF_PAGE_CLASS)
        (bf-draw-portrait (+ (* (-> self pick-team) 4) (-> self pick-class))
                          (+ (bf-fx BF_CLASS_HOLE_X0) 3.0)
                          (+ (bf-fy BF_CLASS_HOLE_Y0) 3.0)
                          (+ (* (- BF_CLASS_HOLE_X1 BF_CLASS_HOLE_X0) (-> *bf-frame* w)) -6.0)
                          (+ (* (- BF_CLASS_HOLE_Y1 BF_CLASS_HOLE_Y0) (-> *bf-frame* h)) -6.0)
                          )
        )
    )
  (none)
  )

(defun bf-draw-loading ()
  "A deployment loading its war zone, the game running on black (`bf-black-set!`): the screen says so."
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf2))
    (bf-draw-text buf (bf-tr "Loading the war zone..." "Chargement de la zone de guerre...") 0.0 200.0 0.6 (font-color default) #t)
    )
  (none)
  )

(defbehavior bf-menu-input bf-director ()
  "The open page's keys, handed by the START menu (`menu-bf-page-option`): up and down move the
   cursor, Left and Right change a setting or the respawn point, X chooses, Triangle or Circle goes
   back."
  (let ((count (bf-page-count (-> self page))))
    (cond
      ((cpad-pressed? 0 up l-analog-up)
       (set! (-> self cursor) (if (> (-> self cursor) 0) (+ (-> self cursor) -1) (+ count -1)))
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 down l-analog-down)
       (set! (-> self cursor) (if (< (-> self cursor) (+ count -1)) (+ (-> self cursor) 1) 0))
       (sound-play "roll-over")
       )
      ((and (= (-> self page) BF_PAGE_CONFIG) (cpad-pressed? 0 left right))
       (bf-config-change (-> self cursor) (if (cpad-pressed? 0 left) -1 1))
       )
      ((and (= (-> self page) BF_PAGE_CLASS) (-> self respawn?) (= (-> self cursor) (bf-class-count)) (cpad-pressed? 0 left right))
       ;; the respawn point: the side's base or a control point it holds (`bf-next-held-point`)
       (set! (-> self pick-point) (bf-next-held-point (-> self pick-point) (-> *bf* team) (if (cpad-pressed? 0 left) -1 1)))
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 x)
       (bf-menu-confirm)
       )
      ((cpad-pressed? 0 circle triangle)
       (bf-menu-back)
       )
      )
    )
  (none)
  )

(defbehavior bf-menu-update bf-director ()
  "Every frame of an open page: the class page's picks, then the page in the START menu
   (`bf-menu-draw`) or, while a deployment loads its war zone on black, the loading line. The
   START menu gone under the page (START): the class and result pages, which need a choice, come
   back; the others close."
  (bf-frame-update!)
  ;; the class page: its class the last class row the cursor stood on; a respawn page shows its point
  ;; to the tests as the old respawn page did (`*bf*` respawn-pick)
  (when (= (-> self page) BF_PAGE_CLASS)
    (if (< (-> self cursor) (bf-class-count))
        (set! (-> self pick-class) (-> self cursor))
        )
    (if (-> self respawn?)
        (set! (-> *bf* respawn-pick) (-> self pick-point))
        )
    )
  (cond
    ((-> *bf-black* on?)
     ;; black again each frame: the START menu's still screen, closing, gives the game's renderers back
     (set! (-> *display* vu1-enable-user-menu) (vu1-renderer-mask generic merc emerc))
     (if (= (-> *bf* phase) BF_PHASE_DEPLOY)
         (bf-draw-loading)
         )
     )
    (else
      (bf-menu-draw)
      (when (and (not (bf-progress-on?))
                 (< (seconds 0.5) (- (-> *display* real-clock frame-counter) (-> self page-time)))
                 )
        (cond
          ((or (= (-> self page) BF_PAGE_CLASS) (= (-> self page) BF_PAGE_RESULT))
           (if (and (= *master-mode* 'game) (< (-> *game-info* blackout-time) (current-time)))
               (bf-progress-host!)
               )
           )
          (else
            (bf-close-page)
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior bf-deploy-update bf-director ()
  "One frame of a deployment: Jak held at his spawn (`bf-hold-at-spawn`), and once the zone is
   ready (`bf-zone-ready?`) the fight starts, the player in as the class he picked before
   (`bf-class-apply!`). The loading page is black meanwhile, the game running (each frame the
   models the reset spawns are hidden too). Past BF_DEPLOY_TIMEOUT the battle is cancelled."
  (bf-hold-at-spawn)
  (if (-> *bf-black* on?)
      (iterate-process-tree *active-pool* (the-as (function object object) bf-black-hide) *kernel-context*)
      )
  (cond
    ((bf-zone-ready?)
     (when (not (-> self prepared?))
       ;; the bases and the control points; the Haven City side moves the latter onto the streets
       (bf-points-setup)
       (bf-city-call BF_CITY_PREPARE)
       (set! (-> self prepared?) #t)
       )
     (bf-set-phase! BF_PHASE_FIGHT)
     ;; in as the class picked before the loading (round 30)
     (when (= (-> self page) BF_PAGE_LOADING)
       (bf-close-page)
       (bf-class-apply!)
       )
     )
    ((time-elapsed? (-> *bf* phase-time) BF_DEPLOY_TIMEOUT)
     (format 0 "battlefront: the war zone did not load, battle cancelled~%")
     (if (!= (-> self page) BF_PAGE_NONE)
         (bf-close-page)
         )
     (bf-end-battle!)
     )
    )
  (none)
  )

(defbehavior bf-restart-battle! bf-director ()
  "The pause page's Restart the battle: the same zone, side and class from
   full reserves, at the side's spawn, with a fresh loadout. What the battle set aside goes back to
   Jak first, so that `bf-start-battle!` sets Jak's own aside again."
  (when (bf-active?)
    (let ((zone (-> *bf* zone))
          (team (-> *bf* team))
          (class (-> *bf* class))
          )
      (bf-close-page)
      (bf-spectate-end!)
      (bf-restore-player!)
      (bf-start-battle! zone team class)
      (when (bf-active?)
        (bf-refill-ammo)
        (if *target*
            (set! (-> *target* fact health) (bf-class-health class))
            )
        )
      )
    )
  (none)
  )

(defbehavior bf-leave-to-save! bf-director ()
  "The mode was switched off in the Mods menu during a battle: load the last save, the slot the game
   last loaded or saved (`*game-info*` auto-save-which, kept by the auto-save process's `done`,
   game-save.gc), as the START menu's Load Game does (progress.gc). The load's reset ends the battle
   (`initialize!` below). With no save loaded or made since the boot, end the battle at the side's
   spawn."
  (set! (-> self leaving?) #t)
  (cond
    ((-> *setting-control* user-default auto-save)
     (bf-spectate-end!)
     (auto-save-command 'restore 0 (-> *game-info* auto-save-which) self #f)
     )
    (else
      (bf-end-battle!)
      )
    )
  (none)
  )

(defun bf-can-open-menu? ()
  "No other menu is up and nothing is loading in a blackout."
  (and (not *popup-menu-open*)
       (< (-> *game-info* blackout-time) (current-time))
       (= *master-mode* 'game)
       )
  )

;; ---------------------------------------------------------------------------------------------
;; Director
;; ---------------------------------------------------------------------------------------------

(defun bf-check-victory ()
  "Every frame of a fight, the configuration's end (round 29, `*bf-config*`): past its time limit,
   the side holding more control points wins (on a tie, the one with more units left); with
   BF_WIN_POINTS, a side holding every control point for BF_HOLD_WIN wins. A side out of units
   loses in any case (battlefront-h.gc `bf-count-loss`)."
  (when (bf-fighting?)
    (let ((ff 0)
          (kg 0)
          (cps 0)
          )
      (dotimes (i (-> *bf* point-count))
        (let ((pt (-> *bf* points i)))
          (when (not (-> pt base?))
            (+! cps 1)
            (case (-> pt owner)
              ((BF_TEAM_FF) (+! ff 1))
              ((BF_TEAM_KG) (+! kg 1))
              )
            )
          )
        )
      (cond
        ((and (< 0 (-> *bf* time-limit)) (< (* (-> *bf* time-limit) (seconds 60)) (- (current-time) (-> *bf* phase-time))))
         (set! (-> *bf* winner)
               (cond
                 ((< kg ff) BF_TEAM_FF)
                 ((< ff kg) BF_TEAM_KG)
                 ((< (-> *bf* reserve BF_TEAM_KG) (-> *bf* reserve BF_TEAM_FF)) BF_TEAM_FF)
                 (else BF_TEAM_KG)
                 )
               )
         (format 0 "battlefront: time up, ~D points to ~D~%" ff kg)
         (bf-set-phase! BF_PHASE_OVER)
         )
        ((= (-> *bf* victory) BF_WIN_POINTS)
         (let ((holder (cond
                         ((and (< 0 cps) (= ff cps)) BF_TEAM_FF)
                         ((and (< 0 cps) (= kg cps)) BF_TEAM_KG)
                         (else BF_TEAM_NONE)
                         )
                       )
               )
           (cond
             ((= holder BF_TEAM_NONE)
              (set! (-> *bf* hold-team) BF_TEAM_NONE)
              )
             ((!= holder (-> *bf* hold-team))
              (set! (-> *bf* hold-team) holder)
              (set! (-> *bf* hold-time) (current-time))
              )
             ((time-elapsed? (-> *bf* hold-time) BF_HOLD_WIN)
              (set! (-> *bf* winner) holder)
              (format 0 "battlefront: every control point held by side ~D~%" holder)
              (bf-set-phase! BF_PHASE_OVER)
              )
             )
           )
         )
        )
      )
    )
  (none)
  )

(define *bf-live?* #f)        ;; the battle runs under the START menu (the 'process-mask setting in engine-hi)
(define *bf-live-sounds?* #f) ;; its sounds let go on under the open menu
(define *bf-menu-at* 0)       ;; the real clock the last time the START menu was up during a fight
(define *bf-pad-backup* (new 'global 'cpad-info 0)) ;; pad 0 as read, while it is hidden from the world
(define *bf-pad-held?* #f)

(defun bf-live-update ()
  "Every frame (the director): during a fight the world runs under the START menu (the author's
   wish, round 30: the battle goes on behind every menu), as the multiplayer mod's online game:
   the opposite of the menu's 'process-mask setting in `*setting-control*` engine-hi (Lisp wiki
   jak3), the sounds the menu paused let go on, the live game shown behind it (`set-menu-mode`
   below), the pad hidden from the world meanwhile (`bf-input-update`)."
  (let ((live? (bf-fighting?)))
    (when (!= live? *bf-live?*)
      (set! *bf-live?* live?)
      (if live?
          (set-setting-by-param *setting-control* 'process-mask 'clear 0 (process-mask progress))
          (remove-by-param0 (-> *setting-control* engine-hi) 'process-mask)
          )
      (apply-settings *setting-control*)
      )
    (cond
      ((and live? (= *master-mode* 'progress))
       (when (not *bf-live-sounds?*)
         (set! *bf-live-sounds?* #t)
         (sound-group-continue (the-as sound-group #xffffffff))
         )
       )
      (else
        (set! *bf-live-sounds?* #f)
        )
      )
    )
  (none)
  )

(defun bf-input-update ()
  "Run first every frame (`bf-input`): while the START menu is up over the running battle, and 0.3 s
   after (the press that closed it), pad 0 is kept in `*bf-pad-backup*` and hidden from what runs
   next, the PC's high-fps history emptied too (the jump reads it); the per-frame hook gives it back
   before the menu reads it (`bf-menu-hook`). The multiplayer mod's way (Lisp wiki jak3)."
  (if (and *bf-live?* *progress-process*)
      (set! *bf-menu-at* (-> *display* real-clock frame-counter))
      )
  (when (and *bf-live?*
             (or *progress-process* (< (- (-> *display* real-clock frame-counter) *bf-menu-at*) (seconds 0.3)))
             )
    (let ((pad (-> *cpad-list* cpads 0))
          (history (-> *cpad-history-list* cpads 0))
          )
      (mem-copy! (the-as pointer (&-> *bf-pad-backup* type)) (the-as pointer (&-> pad type)) (the-as int (size-of cpad-info)))
      (cpad-invalid! pad)
      (set! (-> pad valid) (-> *bf-pad-backup* valid))
      ;; the raw state the next read compares with (pad.gc service-cpads: button0-abs 1 from it):
      ;; zeroed, a button held under the menu came as a new press every frame (round 31, seen in
      ;; game: the cursor ran through the pages)
      (set! (-> pad button0-shadow-abs 0) (-> *bf-pad-backup* button0-shadow-abs 0))
      (dotimes (i 15)
        (set! (-> history button0-abs i) (pad-buttons))
        (set! (-> history button0-rel i) (pad-buttons))
        )
      (set! *bf-pad-held?* #t)
      )
    )
  (none)
  )

(defun bf-menu-hook ()
  "The per-frame hook (main.gc `*mods-menu-hook*`): pad 0 back as read (`bf-input-update`), for the
   menus, then the Mods menu's own update."
  (when *bf-pad-held?*
    (mem-copy! (the-as pointer (&-> (-> *cpad-list* cpads 0) type)) (the-as pointer (&-> *bf-pad-backup* type)) (the-as int (size-of cpad-info)))
    (set! *bf-pad-held?* #f)
    )
  (mods-menu-update)
  (none)
  )

(set! *mods-menu-hook* bf-menu-hook)

;; The first process to run every frame: its pool is the newest child of *active-pool*, which the
;; kernel runs first (change-parent puts a child at the front).
(define-perm *bf-input-pool* process-tree
  (let ((pool (new 'global 'process-tree "bf-input-pool")))
    (change-parent pool *active-pool*)
    (set! (-> pool mask) (process-mask process-tree))
    pool
    )
  )

(deftype bf-input (process)
  "Hides pad 0 from the world while the START menu is up over the running battle (`bf-input-update`)."
  ()
  (:state-methods
    idle
    )
  )

(defstate idle (bf-input)
  :virtual #t
  :code (behavior ()
    (loop
      (bf-input-update)
      (suspend)
      )
    )
  )

(defbehavior bf-input-init-by-other bf-input ()
  "Runs in every master mode (no freeze, pause, menu or progress bit)."
  (logclear! (-> self mask) (process-mask freeze pause menu progress))
  (go-virtual idle)
  )

(define *bf-input* (the-as handle #f))

(defun bf-input-ensure! ()
  "Spawn the pad hider once (`bf-input`)."
  (when (not (handle->process *bf-input*))
    (let ((proc (process-spawn bf-input :name "bf-input" :to *bf-input-pool*)))
      (if proc
          (set! *bf-input* (ppointer->handle proc))
          )
      )
    )
  (none)
  )

;; When the orbs and crates were last looked for (`bf-clear-orbs-and-crates`).
(define *bf-pickups-time* (the-as time-frame 0))
;; The orbs and crates found by one look, 64 at most.
(define *bf-clear-handles* (new 'static 'array uint64 64))
(define *bf-clear-count* 0)

(defun bf-clear-orbs-and-crates ()
  "A battle under way: every precursor orb (collectables.gc money) and every crate (crates.gc
   crate) goes (round 36, the author's wish: none in a battle), its entity marked dead first so it
   is not born again (a new game, the battle's end at the title, gives them back). Run 4 times a
   second: the levels the battle loads bring theirs. The tree is walked first, the processes
   deactivated after: a process deactivated during the walk would cut the walk short."
  (when (time-elapsed? *bf-pickups-time* (seconds 0.25))
    (set! *bf-pickups-time* (-> *display* game-clock frame-counter))
    (set! *bf-clear-count* 0)
    (iterate-process-tree
      *active-pool*
      (lambda ((p process))
        (when (and (< *bf-clear-count* 64) (or (type? p money) (type? p crate)))
          (set! (-> *bf-clear-handles* *bf-clear-count*) (the-as uint (process->handle p)))
          (+! *bf-clear-count* 1)
          )
        #t
        )
      *null-kernel-context*
      )
    (dotimes (i *bf-clear-count*)
      (let ((p (handle->process (the-as handle (-> *bf-clear-handles* i)))))
        (when p
          (if (-> p entity)
              (process-entity-status! p (entity-perm-status dead) #t)
              )
          (deactivate p)
          )
        )
      )
    )
  (none)
  )

(define *bf-counters-hidden?* #f)

(defun bf-stock-counters-hide! ((hide? symbol))
  "HIDE? (during a fight): the game's orb and skull gem counters (hud-classes.gc hud-skullgem and
   hud-skill, which the stock shows while L3 is held, hud.gc) stay disabled, sent 'disable every
   frame (a death's reset spawns them again): L3 held zooms the battle camera (round 35) and L3
   tapped draws the battle's own counters there (`bf-draw-overlay`). Out of a fight: 'enable once."
  (when (and *target* (or hide? *bf-counters-hidden?*))
    (let ((gem (process-by-name "hud-skullgem" *target*))
          (skill (process-by-name "hud-skill" *target*))
          )
      (if gem
          (send-event gem (if hide? 'disable 'enable))
          )
      (if skill
          (send-event skill (if hide? 'disable 'enable))
          )
      )
    (set! *bf-counters-hidden?* hide?)
    )
  (none)
  )

(defbehavior bf-director-update bf-director ()
  "One frame of the battle."
  (bf-stock-counters-hide! (bf-fighting?))
  (if (bf-active?)
      (bf-clear-orbs-and-crates)
      )
  ;; requests of the battle's pause page (START), run once that page is closed
  (let ((req *bf-request*))
    (cond
      ((= req BF_REQ_END)
       ;; Quit the battle: the title menu, as at a battle's end (round 33)
       (set! *bf-request* BF_REQ_NONE)
       (bf-close-page)
       (bf-end-battle!)
       (bf-to-title!)
       )
      ((and (= req BF_REQ_LOBBY) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       (if (not (bf-active?))
           (bf-open-page BF_PAGE_ZONE)
           )
       )
      ((and (= req BF_REQ_RESTART) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       (bf-restart-battle!)
       )
      ((and (= req BF_REQ_RESPAWN) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       (when (bf-fighting?)
         (bf-open-class-page BF_CLASS_RESPAWN)
         (set! (-> *bf* respawn-pick) (-> self pick-point))
         )
       )
      ((and (= req BF_REQ_PAUSE) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       ;; not the START press that just closed it (`bf-menu-update`)
       (when (< (seconds 0.4) (- (-> *display* real-clock frame-counter) (-> self page-time)))
         (bf-open-page BF_PAGE_PAUSE)
         (set! (-> self page-time) (-> *display* real-clock frame-counter))
         )
       )
      ((and (= req BF_REQ_GAME_MENU) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       ;; the game's own START menu, once (`activate-progress` below lets it through)
       (set! *bf-stock-start?* #t)
       (set-master-mode 'progress)
       )
      ((and (= req BF_REQ_TITLE) (bf-can-open-menu?))
       ;; a debug boot: the game's title menu, its entries the battle's (`set-menu-options` below)
       (set! *bf-request* BF_REQ_NONE)
       (if (not (bf-active?))
           (activate-progress *dproc* 'title)
           )
       )
      ((and (= req BF_REQ_START)
            (bf-can-open-menu?)
            *target*
            (not (focus-test? *target* dead))
            (= (level-status? *level* (bf-city-level) #f) 'active)
            (logtest? (-> *target* control status) (collide-status on-surface))
            )
       ;; the new game stands in the city: the battle's deployment and its class page, which starts it
       (set! *bf-request* BF_REQ_NONE)
       ;; the title's flow is over: a new battle from the pause page goes by the side page
       (set! (-> self from-title?) #f)
       (when (not (bf-active?))
         (bf-start-battle! (-> self pick-zone) (-> self pick-team) (+ (* 4 (-> self pick-team)) (-> self pick-class)))
         (if (bf-active?)
             (bf-open-page BF_PAGE_LOADING)
             )
         )
       )
      ((and (= req BF_REQ_REDEPLOY) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       ;; the respawn page at once (`bf-target-death`'s redeploy modes): free out of combat
       ;; (`*bf*` redeploy-ok?), a unit of the side lost in it
       (when (bf-can-redeploy?)
         (format 0 "battlefront: redeploy~A~%" (if (-> *bf* redeploy-ok?) "" ", a unit lost"))
         (send-event *target* 'change-state target-death (if (-> *bf* redeploy-ok?) 'bf-redeploy 'bf-redeploy-hot))
         )
       )
      )
    )
  ;; the mode switched off in the Mods menu during a battle: back to the last save, once that menu
  ;; is closed
  (when (and (not *mod-battlefront-enable*) (bf-active?) (not (-> self leaving?)))
    (if (!= (-> self page) BF_PAGE_NONE)
        (bf-close-page)
        )
    (if (bf-can-open-menu?)
        (bf-leave-to-save!)
        )
    )
  (when (and (-> self end-pending?) (not (and *target* (focus-test? *target* pilot))))
    (bf-end-battle!)
    )
  ;; the battle's hold on the city's sections, battle or not (its end drains them)
  (bf-whole-city-update)
  ;; the looks the pools give their new units follow the live counts (battlefront-h.gc)
  (if (bf-active?)
      (bf-count-looks!)
      )
  (if (!= (-> self page) BF_PAGE_NONE)
      (bf-menu-update)
      )
  ;; the battle under the START menu (`bf-live-update`): the fight goes on under its pages
  (bf-live-update)
  (cond
    ((= (-> *bf* phase) BF_PHASE_DEPLOY)
     (bf-deploy-update)
     )
    ((= (-> *bf* phase) BF_PHASE_FIGHT)
     (cond
       ((!= (level-status? *level* (bf-city-level) #f) 'active)
        ;; Haven City is gone (a warp, a cutscene): the battle cannot go on
        (when (< (-> *game-info* blackout-time) (current-time))
          (format 0 "battlefront: Haven City unloaded, battle cancelled~%")
          (bf-end-battle!)
          )
        )
       (else
         (bf-city-call BF_CITY_UPDATE)
         (bf-update-points)
         (bf-check-victory)
         (bf-draw-points)
         ;; a red guard changed between its two models (battlefront-player.gc bf-avatar-pick-weapon)
         (when (-> *bf* redraw?)
           (set! (-> *bf* redraw?) #f)
           (bf-avatar-kill)
           (set! (-> self want-avatar?) #t)
           )
         (bf-point-icons)
         ;; the red guards dissolving (battlefront-h.gc `bf-fizz-tick`)
         (bf-fizz-tick)
         ;; no Jak on the battlefield: hidden while his class model is away (a class change, a
         ;; respawn, the frames before the model is in), which used to show him for a moment
         (if (and *target* (!= (-> *bf* class) BF_CLASS_JAK) (not (bf-avatar-alive?)))
             (logior! (-> *target* draw status) (draw-control-status no-draw))
             )
         ;; L3: the kills, the deaths and the whole map, on and off (`bf-draw-overlay`), as L3
         ;; lets go, unless SELECT came with it (L3 + SELECT opens the Mods menu)
         (when (and (bf-l3-tapped?) (= (-> self page) BF_PAGE_NONE) (< (-> *bf* respawn-pick) 0))
           (set! (-> *bf* overlay?) (not (-> *bf* overlay?)))
           ;; the game's minimap at the bottom right goes while the whole map is up
           (if (-> *bf* overlay?)
               (set-setting! 'minimap 'clear 0.0 (minimap-flag minimap))
               (remove-setting! 'minimap)
               )
           (sound-play "menu-pick")
           )
         (when (and *target* (not (focus-test? *target* dead)) (< (-> *game-info* blackout-time) (current-time)))
           (cond
             ((and (-> self want-avatar?) (bf-avatar-spawn (-> *bf* class)))
              (set! (-> self want-avatar?) #f)
              )
             ((and (!= (-> *bf* class) BF_CLASS_JAK) (not (-> self want-avatar?)) (not (bf-avatar-alive?)))
              ;; the avatar went with its level or a reset: draw it again
              (set! (-> self want-avatar?) #t)
              )
             )
           (bf-respawn-at-point)
           (bf-sky-drop-update)
           (set! (-> *bf* redeploy-ok?) (and (bf-can-redeploy?) (bf-out-of-combat?)))
           (bf-keep-in-zone)
           (bf-spawn-drops)
           )
         ;; the HUD under no page
         (when (= (-> self page) BF_PAGE_NONE)
           (bf-hud-health-update #t)
           (bf-draw-hud)
           )
         )
       )
     )
    ((= (-> *bf* phase) BF_PHASE_OVER)
     (when (and (= (-> self page) BF_PAGE_NONE) (bf-can-open-menu?))
       (bf-avatar-kill)
       (bf-hud-health-update #f)
       (bf-open-page BF_PAGE_RESULT)
       )
     )
    )
  (none)
  )

(defstate idle (bf-director)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('bf-pad)
       ;; the open page's keys, from the START menu (`menu-bf-page-option`)
       (bf-menu-input)
       )
      (('bf-title)
       ;; Start a battle on the title menu (`menu-bf-title-option`)
       (set! (-> self from-title?) #t)
       (bf-open-page BF_PAGE_ZONE)
       )
      )
    )
  :trans (behavior ()
    (bf-director-update)
    )
  :code sleep-code
  )

(defbehavior bf-director-init-by-other bf-director ()
  "The director runs while the game is paused under its pages, in the START menu (menu, pause and
   progress masks cleared)."
  (process-mask-clear! (-> self mask) menu pause progress)
  (set! (-> self page) BF_PAGE_NONE)
  (set! (-> self cursor) 0)
  (set! (-> self pick-zone) 0)
  (set! (-> self pick-team) BF_TEAM_FF)
  (set! (-> self want-avatar?) #f)
  (set! (-> self prepared?) #f)
  (set! (-> self end-pending?) #f)
  (set! (-> self leaving?) #f)
  (set! (-> self class-mode) BF_CLASS_DEPLOY)
  (set! (-> self from-title?) #f)
  (set! (-> self respawn?) #f)
  (set! (-> self pick-class) 0)
  (set! (-> self pick-point) 0)
  (set! (-> self hud-time) 0)
  (set! (-> self field-time) 0)
  (set! (-> self field-sound) 0)
  (go-virtual idle)
  )

(defun bf-director-ensure! ()
  "Spawn the director once, and the pad hider (`bf-input-ensure!`)."
  (bf-input-ensure!)
  (when (not (handle->process (-> *bf* director)))
    (set! (-> *bf* director)
          (ppointer->handle (process-spawn bf-director :name "bf-director" :from *pc-dead-pool* :to *pc-pool*))
          )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Player death and hits
;; ---------------------------------------------------------------------------------------------

;; Stock sound player, kept the same way.
(define-perm *bf-stock-sound-play-by-name*
             (function sound-name sound-id int int int sound-group object sound-id :behavior process-drawable)
             sound-play-by-name
             )

(define *bf-cry-time* (new 'static 'array time-frame 1 0))

(defun bf-class-hit-cry ()
  "The player's class cries as a hit lands (the author's wish, round 29), at most every half second:
   a guard or a jetpack guard as the battle's guards do (their speech, `speech-type` guard-hit,
   guard.gc; the guards have no hit sound in their banks), the robotguard its metal rattle
   (robo-mtl-rattle), the spider its jabber (spydroid-jabber), from Jak's place."
  (let ((now (-> *display* game-clock frame-counter)))
    (when (and *target* (< (seconds 0.5) (- now (-> *bf-cry-time* 0))))
      (set! (-> *bf-cry-time* 0) now)
      (case (-> *bf* class)
        ((BF_CLASS_ROBOGUARD)
         (sound-play "robo-mtl-rattle" :position (-> *target* control trans))
         )
        ((BF_CLASS_SPYDROID)
         (sound-play "spydroid-jabber" :position (-> *target* control trans))
         )
        (else
          (speech-control-method-13 *speech-control* *target* (speech-type guard-hit) (rand-vu-int-count 2))
          )
        )
      )
    )
  (none)
  )

(defbehavior sound-play-by-name process-drawable ((name sound-name)
                                                  (id sound-id)
                                                  (vol int)
                                                  (pitch int)
                                                  (bend int)
                                                  (group sound-group)
                                                  (trans object)
                                                  )
  "Every sound the game plays by name. During a fight with the class model up: Jak's cries as a hit
   lands (target-death.gc target-hit, target-handler.gc: oof, hit-up) are silent, his class crying
   instead (`bf-class-hit-cry`, from `target-attacked`); his jumps (jump, jump-double, target.gc)
   are his class's (the author's wish, round 29): the guards' and the jetpack guards' crimson-jump
   (their bank, CITYFFH), the spider's a robot's metal rattle (robo-mtl-rattle, CITYKGF), none for
   the robotguard, which does not jump. The rest is the stock player."
  (if (and *bf-log-sounds* (= self *target*))
      (format 0 "SMOKE jak sound ~A~%" (sound-name->string name))
      )
  (cond
    ((not (and (bf-fighting?) (bf-avatar-alive?) (= self *target*)))
     (*bf-stock-sound-play-by-name* name id vol pitch bend group trans)
     )
    ((or (sound-name= name (static-sound-name "oof")) (sound-name= name (static-sound-name "hit-up")))
     id
     )
    ;; a hard landing's sounds: his class cried (`pickup-collectable!`), Jak is silent (round 30)
    ((and (-> self state) (= (-> self state name) 'target-hit-ground-hard)
          (not (sound-name= name (static-sound-name "robo-mtl-rattle")))
          (not (sound-name= name (static-sound-name "spydroid-jabber")))
          )
     id
     )
    ((or (sound-name= name (static-sound-name "jump")) (sound-name= name (static-sound-name "jump-double")))
     (case (-> *bf* class)
       ((BF_CLASS_ROBOGUARD) id)
       ((BF_CLASS_SPYDROID) (*bf-stock-sound-play-by-name* (static-sound-name "robo-mtl-rattle") id vol pitch bend group trans))
       (else (*bf-stock-sound-play-by-name* (static-sound-name "crimson-jump") id vol pitch bend group trans))
       )
     )
    (else
      (*bf-stock-sound-play-by-name* name id vol pitch bend group trans)
      )
    )
  )

;; Stock pickup step of Jak's facts, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-pickup-collectable* (function fact-info-target pickup-type float handle float)
             (method-of-type fact-info-target pickup-collectable!)
             )

(defconstant BF_HEALTH_PACK 3.0) ;; points of the 24 point scale a health pickup gives back in a fight

(defmethod pickup-collectable! ((this fact-info-target) (pickup pickup-type) (amount float) (pickup-handle handle))
  "Every pickup Jak takes (game-info.gc). During a fight, with a class, a health pickup gives back
   BF_HEALTH_PACK points of the 24 point scale (the author's wish, round 29; the stock pack, 2 of
   the ring's 8 segments, was 6), no more than the class's full health (`bf-class-health`). The
   rest: the stock step."
  (cond
    ;; a fall's damage (target2.gc target-hit-ground-hard): none from the spawn's drop from the sky
    ;; or the second after it lands (the author's wish, round 30); else the class cries, not Jak
    ((and (= pickup (pickup-type health)) (< amount 0.0) (bf-fighting?) *target*)
     (cond
       ((or (-> *bf* dropping?) (< (- (-> *display* game-clock frame-counter) (-> *bf* land-time)) (seconds 1)))
        0.0
        )
       (else
         (if (bf-avatar-alive?)
             (bf-class-hit-cry)
             )
         (*bf-stock-pickup-collectable* this pickup amount pickup-handle)
         )
       )
     )
    ((and (= pickup (pickup-type health)) (< 0.0 amount) (bf-fighting?) (!= (-> *bf* class) BF_CLASS_JAK) *target*)
     (let ((ret (*bf-stock-pickup-collectable* this pickup (bf-class-points (-> *bf* class) BF_HEALTH_PACK) pickup-handle)))
       (set! (-> this health) (fmin (-> this health) (bf-class-health (-> *bf* class))))
       ret
       )
     )
    (else
      (*bf-stock-pickup-collectable* this pickup amount pickup-handle)
      )
    )
  )

;; Stock attack handler of the player, kept the same way.
(define-perm *bf-stock-target-attacked*
             (function symbol attack-info process touching-shapes-entry (state symbol attack-info target) object :behavior target)
             target-attacked
             )

(defbehavior target-attacked target ((arg0 symbol)
                                     (arg1 attack-info)
                                     (arg2 process)
                                     (arg3 touching-shapes-entry)
                                     (arg4 (state symbol attack-info target))
                                     )
  "Every attack on the player goes through here. During a fight with the class model up: an attack
   from the player's own side is ignored (no damage, no hit reaction: returns #f); any other takes
   its points on the battle's 24 point scale (battlefront-h.gc `bf-attack-damage`, from its sender
   and its attacker) off Jak's health, his whole bar standing for 24 points (`bf-class-health`),
   and kills when it leaves less than one segment of the ring;
   one the battle does not know keeps its own damage (Jak's health-single-inc when it names none).
   While the robotguard's shield is up, Jak's shield level stops every attack, shot, blast or blow
   (set for each attack, then the stock handler runs)."
  (let ((ignore? #f))
    (when (and (bf-fighting?) (bf-avatar-alive?))
      (let* ((owner (find-offending-process-focusable arg2 arg1))
             (dmg (bf-attack-damage arg2 owner))
             )
        (cond
          ((and owner (!= owner self) (= (bf-unit-team owner) (-> *bf* team)))
           (set! ignore? #t)
           )
          ((<= 0.0 dmg)
           (let ((hp (bf-class-points (-> *bf* class) dmg)))
             ;; the health ring lights (the int health) segments: a hit that leaves less than one
             ;; shows an empty ring, and took one more hit to die (the author's play). It kills.
             (if (< (- (-> self fact health) hp) 1.0)
                 (set! hp (-> self fact health))
                 )
             (set! (-> arg1 damage) hp)
             )
           (logior! (-> arg1 mask) (attack-mask damage))
           )
          )
        ;; a hit taken: in combat (redeploying waits BF_REDEPLOY_CALM); the class cries, unless the
        ;; robotguard's shield stops it
        (when (not ignore?)
          (bf-combat!)
          (if (not (-> *bf* shield?))
              (bf-class-hit-cry)
              )
          )
        )
      )
    (set! (-> self fact shield-level) (if (-> *bf* shield?) 1.0 0.0))
    (if ignore?
        #f
        (*bf-stock-target-attacked* arg0 arg1 arg2 arg3 arg4)
        )
    )
  )

(defun bf-ally? ((proc process) (team int))
  "#t when PROC is a living unit of side TEAM other than the player."
  (and proc
       (!= proc *target*)
       (type? proc process-focusable)
       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
       (= (bf-unit-team proc) team)
       )
  )

(defun bf-spectate-pick ((from vector))
  "The living unit of the player's side nearest to FROM within 150 m, #f for none."
  (let ((probe (new 'stack-no-clear 'vector))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (best (the-as process-focusable #f))
        (best-dist (meters 150))
        )
    (vector-copy! probe from)
    (set! (-> probe w) (meters 150))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (bf-ally? proc (-> *bf* team))
              (let ((dist (vector-vector-distance (-> (the-as process-focusable proc) root trans) from)))
                (when (< dist best-dist)
                  (set! best-dist dist)
                  (set! best (the-as process-focusable proc))
                  )
                )
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-spectate-follow ((from vector))
  "While the player waits to respawn: keep the camera on a living unit of his side, the one it
   follows or, once that one dies or goes, the nearest to FROM (`bf-spectate-pick`). The camera's
   'change-target focuses it on any process-focusable (cam-master.gc, as camera-look-at does)."
  (when (not (bf-ally? (handle->process (-> *bf* spectate)) (-> *bf* team)))
    (let ((next (bf-spectate-pick from)))
      (when next
        (set! (-> *bf* spectate) (process->handle next))
        (send-event *camera* 'change-target next)
        (send-event *camera* 'teleport)
        )
      )
    )
  (none)
  )

(defun bf-camp-continue ()
  "The continue point the player deploys at: the one of the point a far respawn takes him to
   (`*bf*` respawn-at, `*bf-point-defs*`), else his camp's in the battle's zone (`*bf-zones*`); #f
   for none."
  (get-continue-by-name *game-info* (cond
                                      ((>= (-> *bf* respawn-at) 0)
                                       (-> *bf-point-defs* (-> *bf* respawn-at) continue)
                                       )
                                      ((= (-> *bf* team) BF_TEAM_FF)
                                       (-> *bf-zones* (-> *bf* zone) ff-continue)
                                       )
                                      (else
                                        (-> *bf-zones* (-> *bf* zone) kg-continue)
                                        )
                                      )
                        )
  )

(defun bf-camp-level? ((cont continue-point) (i int))
  "#t when entry I of continue point CONT's level list is a city section or an interior it shows
   (not the Haven City base: the battle loads its own alias of ctywide)."
  (let ((name (-> cont want i name)))
    (and name (-> cont want i display?) (not (string-prefix= "ctywide" (symbol->string name)))
         (!= name (bf-city-level))
         )
    )
  )

(defun bf-want-camp-levels ((cont continue-point))
  "Want the levels continue point CONT lists, as a respawn there does (target-death.gc
   target-continue): its sections in place of the ones wanted now (Haven City holds two at most),
   the game's level of the player set to CONT's, then the borrowed levels added again. A camp at a
   district's edge stands on the next section's ground (the Port's war zone, on ctyinda's), which
   the game loads only near it."
  (let ((ls *load-state*))
    (dotimes (i 10)
      (let ((name (-> ls want i name)))
        (when (and name (not (string-prefix= "ctywide" (symbol->string name))))
          (set! (-> ls want i name) #f)
          (set! (-> ls want i display?) #f)
          (set! (-> ls want i force-vis?) #f)
          (set! (-> ls want i force-inside?) #f)
          )
        )
      )
    (dotimes (i (-> cont want-count))
      (if (bf-camp-level? cont i)
          (bf-want-level ls (-> cont want i name))
          )
      )
    (let ((info (lookup-level-info (-> cont vis-nick))))
      (if info
          (set! (-> ls vis-nick) (-> info name))
          )
      )
    (add-borrow-levels ls)
    )
  (none)
  )

(defun bf-camp-loaded? ((cont continue-point))
  "#t once every level continue point CONT lists (`bf-camp-level?`) is active."
  (let ((loaded? #t))
    (dotimes (i (-> cont want-count))
      (if (and (bf-camp-level? cont i) (!= (level-status? *level* (-> cont want i name) #f) 'active))
          (set! loaded? #f)
          )
      )
    loaded?
    )
  )

(defbehavior bf-death-class-page target ()
  "In `bf-target-death`, Triangle on the death screen: the class page of the player's side with his
   respawn point (the director's, BF_REQ_RESPAWN; round 30), until it closes; the battle goes on
   meanwhile. #t when he picked (its X: his class and `*bf*` respawn-point set, `bf-menu-confirm`),
   #f when he went back (Triangle) to the death screen."
  (set! (-> *bf* respawn-choice) -1)
  (set! *bf-request* BF_REQ_RESPAWN)
  (let ((t0 (current-time))
        (opened? #f)
        )
    (until (or (not (bf-fighting?))
               (and opened? (let ((dir (the-as bf-director (handle->process (-> *bf* director)))))
                              (or (not dir) (= (-> dir page) BF_PAGE_NONE))
                              )
                    )
               (and (not opened?) (time-elapsed? t0 (seconds 3)))
               )
      (logior! (-> self draw status) (draw-control-status no-draw))
      (if (not (bf-avatar-alive?))
          (bf-spectate-follow (-> self control trans))
          )
      (let ((dir (the-as bf-director (handle->process (-> *bf* director)))))
        (if (and dir (= (-> dir page) BF_PAGE_CLASS))
            (set! opened? #t)
            )
        )
      (suspend)
      )
    )
  (>= (-> *bf* respawn-choice) 0)
  )

(defbehavior bf-target-death target ((mode symbol))
  "Jak's death during a fight, in place of the stock one (`target-death` below): his side loses a
   unit and his class model plays its death (the camera on it), then the camera follows a living
   unit of his side (`bf-spectate-follow`) until he chooses (the author's wish, round 30): after
   BF_RESPAWN_TIME, X respawns him at his respawn point as his class, both shown on the right
   (`bf-draw-respawn-frame`); Triangle opens the class page (`bf-death-class-page`) to change them.
   He is back there once its levels are loaded, facing the battlefield, alive, full health, with a fresh
   loadout and three seconds of invulnerability, his class model blinking (`bf-spawn-shield`), and
   the director draws his class again. MODE 'bf-redeploy (the pause page's Redeploy, its class and
   point picked on the class page first, out of combat for BF_REDEPLOY_CALM): no loss and no wait;
   'bf-redeploy-hot (Redeploy in combat): the same, a unit lost. The world runs on meanwhile. The stock death freezes the
   enemies (a 'process-mask setting), may play a death movie, and its reset ('life, `initialize!`)
   spawned every unit of Haven City again: the battle's units vanished and came back at each death.
   First it sets what the stock death sets that the game reads: Jak dead (units leave him alone),
   his attacks off, his gun away."
  (set! (-> self neck flex-blend) 0.0)
  (target-timed-invulnerable-off self 0)
  (logior! (-> self focus-status) (focus-status dead))
  (logior! (-> self target-flags) (target-flags disable-attacks))
  (if (using-gun? self)
      (target-gun-end-mode #f)
      )
  (set! (-> self control mod-surface) *neutral-mods*)
  (vector-reset! (-> self control transv))
  (when (!= mode 'bf-redeploy)
    (bf-count-loss (-> *bf* team))
    (+! (-> *bf* deaths) 1)
    )
  (set! (-> *bf* redeploy-ok?) #f)
  ;; the class model plays its own death (battlefront-player.gc `bf-avatar-dying`), a redeploy none
  (if (or (= mode 'bf-redeploy) (= mode 'bf-redeploy-hot))
      (bf-avatar-kill)
      (bf-avatar-die)
      )
  (set! (-> *bf* respawn-time)
        (+ (current-time) (if (or (= mode 'bf-redeploy) (= mode 'bf-redeploy-hot)) 0 BF_RESPAWN_TIME))
        )
  (set! (-> *bf* redeploying?) (or (= mode 'bf-redeploy) (= mode 'bf-redeploy-hot)))
  (set! (-> *bf* spectate) (the-as handle #f))
  (let ((dir (the-as bf-director (handle->process (-> *bf* director)))))
    (if dir
        (set! (-> dir want-avatar?) #t)
        )
    )
  ;; the camera further back and higher than behind Jak: the units stand up to twice his height,
  ;; and with the stock string a guard filled the screen (seen in game)
  (set-setting! 'string-min-length 'abs (meters 10) 0)
  (set-setting! 'string-max-length 'abs (meters 14) 0)
  (set-setting! 'string-min-height 'abs (meters 4) 0)
  (set-setting! 'string-max-height 'abs (meters 6) 0)
  ;; the wait for his choice (round 30): X respawns him at his respawn point as his class, Triangle
  ;; opens the class page to change them first (back from it, the wait goes on); a death that ends
  ;; the battle cuts it short, for the result page. A redeploy has picked them already
  (let ((chosen? (-> *bf* redeploying?)))
    (cpad-clear! 0 confirm)
    (cpad-clear! 0 triangle)
    (while (and (bf-fighting?) (not chosen?))
      (logior! (-> self draw status) (draw-control-status no-draw))
      ;; the camera stays on the dying class model, then follows a unit of his side
      (if (not (bf-avatar-alive?))
          (bf-spectate-follow (-> self control trans))
          )
      (when (>= (current-time) (-> *bf* respawn-time))
        (cond
          ((cpad-pressed? 0 confirm)
           (set! chosen? #t)
           )
          ((cpad-pressed? 0 triangle)
           (cpad-clear! 0 triangle)
           (if (bf-death-class-page)
               (set! chosen? #t)
               )
           (cpad-clear! 0 confirm)
           (cpad-clear! 0 triangle)
           )
          )
        )
      (suspend)
      )
    (cpad-clear! 0 confirm)
    (cpad-clear! 0 triangle)
    )
  (set! (-> *bf* redeploying?) #f)
  ;; his respawn point (`*bf*` respawn-point, kept from death to death), his base while it is lost
  (let ((pick (-> *bf* respawn-point)))
    (set! (-> *bf* respawn-pick) -1)
    (set! (-> *bf* respawn-choice) -1)
    ;; a point lost meanwhile: the base
    (if (not (bf-point-held? pick (-> *bf* team)))
        (set! pick (-> *bf* team))
        )
    (let ((at (-> *bf* points pick pos))
          (cont (get-continue-by-name *game-info* (-> *bf-point-defs* pick continue)))
          )
      (when (and cont (not (bf-camp-loaded? cont)))
        ;; far, its sections not loaded: the stock way, a reset at the point's continue point
        ;; (`initialize!` 'life, as the battle's start and the stock death do), then the director
        ;; brings him onto the point (`bf-respawn-at-point`). Moving him there and wanting its
        ;; levels instead unloaded the section that held the borrowed unit levels: every unit's
        ;; process went, the traffic spawned its pools again over them, the engine's default nav
        ;; mesh ran out of its 128 nav-controls and a new guard's setup crashed the game (nav-enemy
        ;; setup-enemy!).
        (remove-setting! 'string-min-length)
        (remove-setting! 'string-max-length)
        (remove-setting! 'string-min-height)
        (remove-setting! 'string-max-height)
        (bf-spectate-end!)
        (set! (-> *bf* respawn-at) pick)
        (format 0 "battlefront: respawn at ~S through a reset at ~S~%" (bf-point-name pick) (-> cont name))
        ;; as the battle's start does: its ships down and the stock hatred (the Haven City side's
        ;; reset), then the deployment, the traffic waking its units the stock way while Jak waits
        ;; for the levels (`bf-deploy-update`; its points kept: they are set up once a battle)
        (bf-city-call BF_CITY_RESET)
        (bf-set-phase! BF_PHASE_DEPLOY)
        (set-continue! *game-info* cont #f)
        (vector-reset! (-> self control transv))
        (bf-city-call BF_CITY_FREE_NAVS)
        (initialize! *game-info* 'life (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        (sleep-code)
        )
      ;; near, its sections loaded: there at once, the levels left as they are, from the sky onto a
      ;; nav poly around the point (`bf-sky-drop!`), else on the point; where he lands is the safe
      ;; place of a fall (`bf-keep-in-zone`), not where he died
      (let ((ground (vector-copy! (new 'stack-no-clear 'vector) at)))
        (when (not (bf-sky-drop! pick ground))
          (move-to-point! (-> self control) at)
          (vector-reset! (-> self control transv))
          )
        (if cont
            (set! (-> *bf* safe-level) (-> cont level))
            )
        (vector-copy! (-> *bf* safe) ground)
        )
      (set! (-> *bf* safe-time) 0)
      (format 0 "battlefront: respawned at ~S~%" (bf-point-name pick))
      )
    )
  (remove-setting! 'string-min-length)
  (remove-setting! 'string-max-length)
  (remove-setting! 'string-min-height)
  (remove-setting! 'string-max-height)
  ;; the class's full health on the battle's 24 point scale (the spider robot half Jak's bar)
  (set! (-> self fact health) (bf-class-health (-> *bf* class)))
  (bf-refill-ammo)
  (bf-spectate-end!)
  ;; facing the battlefield's center, the camera 6 m behind him: it came back on him from wherever
  ;; it followed the unit, in front of him at times (seen in game)
  (let ((dir (vector-! (new 'stack-no-clear 'vector) (-> *bf* center) (-> self control trans)))
        (cam (new 'stack-no-clear 'vector))
        )
    (set! (-> dir y) 0.0)
    (when (< (meters 1) (vector-length dir))
      (vector-normalize! dir 1.0)
      ;; the battle camera, back with the class model, looks there too (battlefront-player.gc bf-cam-rig)
      (set! (-> *bf* view-yaw) (vector-y-angle dir))
      (set! (-> *bf* view-pitch) 0.0)
      (set! (-> *bf* view-set?) #t)
      (forward-up->quaternion (-> self control quat-for-control) dir *y-vector*)
      (quaternion-copy! (-> self control quat) (-> self control quat-for-control))
      (quaternion-copy! (-> self control dir-targ) (-> self control quat))
      (vector+float*! cam (-> self control trans) dir (meters -6))
      (+! (-> cam y) (meters 3))
      (send-event *camera* 'teleport-to-vector-start-string cam)
      )
    )
  (bf-spawn-shield)
  (go target-stance)
  (none)
  )

;; The stock death's code, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-death-code* function (-> target-death code))

(defbehavior bf-target-death-code target ((mode symbol))
  "Code of Jak's `target-death` state (target-death.gc): `bf-target-death` during a fight, the stock
   death otherwise."
  (if (bf-fighting?)
      (bf-target-death mode)
      ((the-as (function symbol none :behavior target) *bf-stock-death-code*) mode)
      )
  (none)
  )

(set! (-> target-death code) bf-target-death-code)

;; ---------------------------------------------------------------------------------------------
;; Outside the campaign: no save during a battle, and a load ends it
;; ---------------------------------------------------------------------------------------------

(defun bf-locked-option? ((name text-id))
  "#t for the START menu ring's options a battle shuts: Save, Load Game (a load would end the battle
   in the middle of the menu) and Secrets (cheats that change the fight)."
  (or (= name (text-id progress-save-game)) (= name (text-id progress-load-save)) (= name (text-id progress-secrets)))
  )

(define-perm *bf-stock-main-respond* (function menu-main-menu-option progress symbol int)
             (method-of-type menu-main-menu-option respond-progress)
             )

(defmethod respond-progress ((this menu-main-menu-option) (arg0 progress) (arg1 symbol))
  "START menu ring, an option's input. During a battle, X on Save, Load Game or Secrets
   (`bf-locked-option?`) is refused with the stock refusal beep (progress.gc, a hero mode save on
   the autosave slot); the rest is the stock handling."
  (cond
    ((and (bf-active?) (bf-locked-option? (-> this name)) (cpad-pressed? 0 confirm))
     (cpad-clear! 0 confirm)
     (sound-play "generic-beep" :pitch -0.6)
     0
     )
    (else
      (*bf-stock-main-respond* this arg0 arg1)
      )
    )
  )

(define-perm *bf-stock-main-draw* (function menu-main-menu-option progress font-context int symbol none)
             (method-of-type menu-main-menu-option draw-option)
             )

(defmethod draw-option ((this menu-main-menu-option) (arg0 progress) (fnt font-context) (arg2 int) (arg3 symbol))
  "START menu ring, the selected option's name. During a battle Save, Load Game and Secrets
   (`bf-locked-option?`) are drawn grey, the color of the PC menus' disabled options (progress-generic-draw-pc.gc); the rest is the stock drawing. The
   grey label is the stock one (progress-draw-pc.gc), its color aside."
  (cond
    ((and (bf-active?)
          (bf-locked-option? (-> this name))
          (= arg2 (-> arg0 option-index))
          )
     (set-scale! fnt 0.75)
     (set-color! fnt (font-color font-color-44))
     (set-alpha! fnt (- 1.0 (-> arg0 menu-transition)))
     (set-flags! fnt (font-flags shadow kerning middle large))
     (set-width! fnt (if (= (get-aspect-ratio) 'aspect4x3) 235 175))
     (set-height! fnt 80)
     (set! (-> fnt origin x) (the float (if (= (get-aspect-ratio) 'aspect4x3) 140 170)))
     (set! (-> fnt origin y) (the float (if (= (get-aspect-ratio) 'aspect4x3) 180 175)))
     (when (not (-> *pc-settings* use-vis?))
       (set! (-> fnt origin x) (the float (adjust-game-x (-> fnt origin x))))
       (*! (-> fnt width) (-> *pc-settings* aspect-ratio-reciprocal))
       )
     (print-game-text (lookup-text! *common-text* (-> this name) #f) fnt #f 44 (bucket-id hud-draw-hud-alpha))
     )
    (else
      (*bf-stock-main-draw* this arg0 fnt arg2 arg3)
      )
    )
  (none)
  )

(defun bf-stop-now! ()
  "A loaded save, a new game or the title ends the battle at once, from inside the game's reset
   (`initialize!` below): the avatar and the Haven City side go, Jak gets back what the battle set
   aside, the mode is switched off, and the director goes with every setting it owns (the battle's
   alias levels, faction commands and closed tasks). The reset then sets the game from the save."
  (bf-avatar-kill)
  (when (bf-active?)
    (bf-set-phase! BF_PHASE_OFF)
    (bf-city-call BF_CITY_RESET)
    (bf-restore-player!)
    )
  (set! *mod-battlefront-enable* #f)
  (set! *bf-request* BF_REQ_NONE)
  (bf-black-set! #f)
  ;; the world paused under the START menu again (`bf-live-update`): the director goes
  (when *bf-live?*
    (set! *bf-live?* #f)
    (remove-by-param0 (-> *setting-control* engine-hi) 'process-mask)
    (apply-settings *setting-control*)
    )
  (let ((director (handle->process (-> *bf* director))))
    (if director
        (deactivate director)
        )
    )
  (set! (-> *bf* director) (the-as handle #f))
  (set! (-> *bf* respawn-time) 0)
  (set! (-> *bf* spectate) (the-as handle #f))
  (none)
  )

(define-perm *bf-stock-initialize* (function game-info symbol game-save string resetter-spec game-info)
             (method-of-type game-info initialize!)
             )

(defmethod initialize! ((this game-info) (arg0 symbol) (arg1 game-save) (arg2 string) (arg3 resetter-spec))
  "Every reset of the game goes through here. A 'game reset (a save loaded from the START menu, a
   new game, the title) or a 'boot ends a running battle first (`bf-stop-now!`), before the reset
   and the save's data: deaths and the battle's own respawns ('life) go on as before."
  (if (and (or (= arg0 'game) (= arg0 'boot)) (bf-active?))
      (bf-stop-now!)
      )
  (*bf-stock-initialize* this arg0 arg1 arg2 arg3)
  )

;; ---------------------------------------------------------------------------------------------
;; START: the battle's own page, the game's menu behind its Options entry
;; ---------------------------------------------------------------------------------------------

(define-perm *bf-stock-activate-progress* (function process symbol none) activate-progress)

(defun activate-progress ((arg0 process) (arg1 symbol))
  "The game opens its START menu here (main.gc, master mode 'progress) with ARG1 'main. While the
   Battlefront mode is on, START opens the battle's pause page instead, its entries and the city's
   live map (`bf-draw-pause-page`, BF_PAGE_PAUSE), handed to the director: no menu yet, so the game
   goes back to 'game, and the director opens the START menu on its page ('battlefront). The page's
   Options entry lets the next one through (`*bf-stock-start?*`): the game's menu, where a battle
   shuts Save, Load Game, Secrets and Restart Mission. Every other menu (the title menu, save icons,
   card errors) is the stock one."
  (cond
    ((and (= arg1 'main) *mod-battlefront-enable* (not *bf-stock-start?*) *target*)
     (bf-director-ensure!)
     (set! *bf-request* BF_REQ_PAUSE)
     )
    (else
      (set! *bf-stock-start?* #f)
      (*bf-stock-activate-progress* arg0 arg1)
      )
    )
  (none)
  )


;; ---------------------------------------------------------------------------------------------
;; The START menu's pages: the battle's ('battlefront), and the title menu's entries
;; ---------------------------------------------------------------------------------------------

(deftype menu-bf-page-option (menu-option)
  "The battle's page in the START menu: the director draws it (`bf-menu-draw`); this hands it the
   keys."
  ()
  )

(defmethod draw-option ((this menu-bf-page-option) (progress progress) (font font-context) (index int) (selected? symbol))
  "Nothing: the director draws the page (`bf-menu-draw`)."
  (none)
  )

(defmethod respond-progress ((this menu-bf-page-option) (progress progress) (selected? symbol))
  "The page's keys to the director (`bf-menu-input`) once the menu shows it, then cleared: the START
   menu's own handling (respond-to-cpad: up and down, X, Triangle back a page) sees none of them."
  (let ((dir (handle->process (-> *bf* director))))
    (if (and dir (= (-> progress menu-transition) 0.0))
        (send-event dir 'bf-pad)
        )
    )
  (cpad-clear! 0 up down left right x circle triangle l-analog-up l-analog-down)
  0
  )

(define *bf-progress-options*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-bf-page-option)
      )
    )
  )

(defun bf-title-start ()
  "Start a battle on the title menu: the director's war zone page, from the title (the setup's Next
   starts a new game into the battle)."
  (bf-director-ensure!)
  (send-event (handle->process (-> *bf* director)) 'bf-title)
  (none)
  )

(deftype menu-bf-title-option (menu-option)
  "Start a battle, the title menu's first entry while the mode is on (`*bf-title*`)."
  ()
  )

(defmethod draw-option ((this menu-bf-title-option) (progress progress) (font font-context) (index int) (selected? symbol))
  "Drawn as the title menu's own entries are (progress-draw-pc.gc menu-sub-menu-option)."
  (let ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition))))))
    (set! (-> font alpha) alpha)
    (set-scale! font 0.85)
    (adjust-font-origin-y progress font (-> this offset-y))
    (cond
      ((= (-> progress option-index) index)
       (draw-highlight-bar progress font (the int (+ -6.0 (-> font origin y))) 35 alpha)
       (set-color! font (font-color font-color-33))
       )
      (else
        (set-color! font (font-color font-color-32))
        )
      )
    (pc-encode-utf8-string (bf-tr "Start a battle" "Démarrer une bataille") *pc-encoded-temp-string*)
    (print-game-text *pc-encoded-temp-string* font #f 44 (bucket-id hud-draw-hud-alpha))
    )
  (none)
  )

(defmethod respond-progress ((this menu-bf-title-option) (progress progress) (selected? symbol))
  "X: the battle's war zone page (`bf-title-start`)."
  (when (cpad-pressed? 0 confirm)
    (cpad-clear! 0 confirm)
    (sound-play "generic-beep")
    (bf-title-start)
    )
  0
  )

;; The title menu while the mode is on (round 29, the author's wish): Start a battle, the game's
;; Options and Quit, in place of New Game, Load Game, Options, Secrets and Quit. Quit sits 0.07
;; higher while Secrets is locked (menu-exit-game-option).
(define *bf-title*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-bf-title-option :offset-y 0.3)
      (new 'static 'menu-sub-menu-option :name (text-id progress-options) :offset-y 0.45 :next-state 'title-options)
      (new 'static 'menu-exit-game-option :name (text-id progress-quit) :offset-y 0.67)
      )
    )
  )

(define-perm *bf-stock-set-menu-options* (function progress symbol int)
  (the-as (function progress symbol int) (method-of-type progress set-menu-options))
  )

(defmethod set-menu-options ((this progress) (arg0 symbol))
  "Stock, plus the battle's page ('battlefront, `*bf-progress-options*`) and, while the mode is on,
   the title menu's entries (`*bf-title*`)."
  (cond
    ((= arg0 'battlefront)
     (set! (-> this current-options) *bf-progress-options*)
     0
     )
    (else
      (let ((ret (*bf-stock-set-menu-options* this arg0)))
        (when (and (= arg0 'title) *mod-battlefront-enable*)
          ;; the director up before Start a battle sends it its event: one spawned that frame is not
          ;; in its state yet, and drops it
          (bf-director-ensure!)
          (set! (-> this current-options) *bf-title*)
          (set! (-> this option-index) (min (-> this option-index) 2))
          )
        ret
        )
      )
    )
  )

(defun bf-page-needs-choice? ()
  "#t while the director's class or result page is up: it needs a choice."
  (let ((dir (the-as bf-director (handle->process (-> *bf* director)))))
    (and dir (or (= (-> dir page) BF_PAGE_CLASS) (= (-> dir page) BF_PAGE_RESULT)))
    )
  )

(define-perm *bf-stock-can-go-back?* (function progress symbol)
  (the-as (function progress symbol) (method-of-type progress can-go-back?))
  )

(defmethod can-go-back? ((this progress))
  "Stock, except on the battle's class and result pages, which need a choice: START does not close
   them (drawable.gc, the pause buttons)."
  (and (*bf-stock-can-go-back?* this)
       (not (and (= (-> this current) 'battlefront) (bf-page-needs-choice?)))
       )
  )

(define-perm *bf-stock-set-menu-mode* (function blit-displays-work symbol symbol)
  (method-of-type blit-displays-work set-menu-mode)
  )

(defmethod set-menu-mode ((this blit-displays-work) (arg0 symbol))
  "Stock, except during a fight (round 30): no still copy, the battle shows live behind the START
   menu (`bf-live-update`), as the multiplayer mod's online game does."
  (*bf-stock-set-menu-mode* this (and arg0 (not (bf-fighting?))))
  )


(defun bf-out-of-combat? ()
  "#t when the player has been out of combat (no shot, blow or hit taken, `*bf*` combat-time) for
   BF_REDEPLOY_CALM: his redeploy is free."
  (< BF_REDEPLOY_CALM (- (-> *display* game-clock frame-counter) (-> *bf* combat-time)))
  )

(defun bf-can-redeploy? ()
  "#t when the player may redeploy (the pause page's Redeploy): in a fight, alive with his class,
   not falling from the sky. In combat it costs his side a unit (`bf-out-of-combat?`)."
  (if (and (bf-fighting?)
           *target*
           (not (focus-test? *target* dead))
           (bf-avatar-alive?)
           (not (-> *bf* dropping?))
           )
      #t
      #f
      )
  )

;; ---------------------------------------------------------------------------------------------
;; The guards' voices
;; ---------------------------------------------------------------------------------------------

(defun bf-guard-taunt? ((kind speech-type))
  "#t for the Jak 3 guards' battle lines (speech-h.gc: guard-generic-battle 1 to guard-bumped-by-jak-b
   18, their cries when hit, 9 and 10, aside)."
  (let ((k (the int kind)))
    (and (<= 1 k) (<= k 18) (!= k 9) (!= k 10))
    )
  )

(define-perm *bf-stock-speech-request* (function speech-control process-drawable speech-type none)
  (the-as (function speech-control process-drawable speech-type none)
          (method-of-type speech-control speech-control-method-12)
          )
  )

(defmethod speech-control-method-12 ((this speech-control) (arg0 process-drawable) (arg1 speech-type))
  "A speech request (every one goes through here, speech-control-method-13 too): the stock one, but
   during a battle a red guard does not say the Jak 3 guards' battle lines (`bf-guard-taunt?`): they
   are the Freedom League's voices, its blue guards' (round 33, the author's wish). Its cries when
   hit stay. Returns nothing."
  (if (not (and (bf-active?)
                arg0
                (= (-> arg0 type symbol) 'crimson-guard)
                (bf-red-guard? arg0)
                (bf-guard-taunt? arg1)
                )
           )
      (*bf-stock-speech-request* this arg0 arg1)
      )
  (none)
  )

;; The game's Quit / Restart page during a battle: Restart Mission is refused with the refusal beep
;; (a mission's restart would run the game's own reset in the middle of the battle); Quit is the
;; stock one.
(define-perm *bf-stock-restart-respond* (function menu-restart-mission-qr-option progress symbol int)
             (the-as (function menu-restart-mission-qr-option progress symbol int)
                     (method-of-type menu-qr-option respond-progress)
                     )
             )

(defmethod respond-progress ((this menu-restart-mission-qr-option) (arg0 progress) (arg1 symbol))
  "Restart Mission's input: during a battle, X is refused with the stock refusal beep; else the
   stock handling (progress.gc, menu-qr-option)."
  (cond
    ((and arg1 (bf-active?) (cpad-pressed? 0 confirm))
     (cpad-clear! 0 confirm)
     (sound-play "generic-beep" :pitch -0.6)
     0
     )
    (else
      (*bf-stock-restart-respond* this arg0 arg1)
      )
    )
  )

;; ---------------------------------------------------------------------------------------------
;; Mods menu (L3 + SELECT, the bind of every mod: mods-menu.gc) > battlefront
;; ---------------------------------------------------------------------------------------------

(define *mod-battlefront-menu*
  (new 'static 'popup-menu-submenu :label "battlefront"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      (new 'static 'popup-menu-flag :label "Battlefront mode"
           :is-toggled? (lambda () *mod-battlefront-enable*)
           :on-confirm (lambda ()
                         (set! *mod-battlefront-enable* (not *mod-battlefront-enable*))
                         (cond
                           ;; off during a battle: the director loads the last save once this
                           ;; menu is closed
                           ((and (not *mod-battlefront-enable*) (bf-active?))
                            (mods-menu-close!)
                            )
                           ;; on: this menu closes and the battle's page opens at once (the
                           ;; director, once this menu is closed; the author's wish, round 28)
                           (*mod-battlefront-enable*
                             (mods-menu-close!)
                             (bf-director-ensure!)
                             (set! *bf-request* BF_REQ_PAUSE)
                             )
                           )
                         (none)
                         )
           )
      )
    )
  )

(defun mod-battlefront-build-menu ()
  "Entry of the mod in the Mods menu: the mode's switch."
  (the-as popup-menu-entry *mod-battlefront-menu*)
  )

(mods-menu-register "battlefront" mod-battlefront-build-menu)
