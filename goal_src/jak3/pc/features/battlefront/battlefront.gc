;;-*-Lisp-*-
(in-package goal)

;; name: battlefront.gc
;; name in dgo: battlefront
;; dgos: GAME

#|
  Battlefront mod -- the director of a battle, its menus, its HUD and its Mods menu entry.

  Flow:
    Mods menu (L3 + SELECT, as every mod) > battlefront > Battlefront mode: the mode's switch. On,
    it adds START > Options > Gamemode > Battlefront, where the battle is chosen and run:
      New battle -> page 1: war zone  -> page 2: side  -> page 3: class (turning preview), while
                    the deployment loads the zone under it
      Change class (the fight goes on), Restart the battle, Quit the battle.
    Switched off during a battle, it loads the last save.
    Deployment: the director (a process of *pc-pool*, which outlives level changes and deaths)
    owns the settings of the battle (borrowed unit levels, faction strengths) and sends Jak to his
    side's spawn the way a death does (`initialize!` 'life), which spawns every unit pool of
    Haven City again, now with the battle's skins (battlefront-h.gc). The class page opens at once,
    with the game running under it while the zone loads: the class models, and the page's preview
    of them, live in the unit levels the deployment loads, so the preview shows once they are in.
    Once Jak stands at the spawn the game pauses under the page, and X deploys him.
    Fight: each side has BF_RESERVE units in stock; every death of a unit or of the player takes
    one (battlefront-h.gc `bf-count-loss`). The first side down to 0 loses. A dead player watches
    the battle for four seconds, the camera on a unit of his side, then comes back at his side's
    spawn with his class and fresh ammo (`bf-target-death`). A force field holds the player inside
    the battlefield, and the jetpacks under its ceiling.
    End: result page, then everything the battle changed is undone (settings die with their
    owner's entries removed, hatred written back, Jak's ammo and light eco given back, the player
    respawned at his spawn so every unit is spawned again with its stock skin).

  HUD of the fight: both reserves, the crosshair, the class's weapon and ammo, the jetpack's fuel
  or the spider's blue eco, and Jak's health HUD kept shown, with the class model in its center
  in place of the light and dark eco gauges.

  Everything here is idle while the Mods menu flag is off: the director is not even spawned.
|#

;; DECOMP BEGINS

(define-extern mods-menu-close! (function none))
;; defined further down this file: the player's base continue point and its levels, and the redeploy
(define-extern bf-camp-continue (function continue-point))
(define-extern bf-camp-loaded? (function continue-point symbol))
(define-extern bf-can-redeploy? (function symbol))

;; Pages of the battle menu.
(defconstant BF_PAGE_NONE 0)
(defconstant BF_PAGE_ZONE 1)
(defconstant BF_PAGE_TEAM 2)
(defconstant BF_PAGE_CLASS 3)
(defconstant BF_PAGE_RESULT 4)

;; Requests of the START menu's battle page to the director (it runs them in its own process, so
;; the settings it creates and removes are its own).
(defconstant BF_REQ_NONE 0)
(defconstant BF_REQ_LOBBY 1)
(defconstant BF_REQ_CLASS 2)
(defconstant BF_REQ_END 3)
(defconstant BF_REQ_RESTART 4)
(defconstant BF_REQ_REDEPLOY 5)
(defconstant BF_REDEPLOY_CALM (seconds 30)) ;; out of combat this long, the player may redeploy

(defconstant BF_DEPLOY_TIMEOUT (seconds 120)) ;; give up when the zone is not loaded by then (every street section, round 19)
(defconstant BF_FALL_DEPTH (meters 20))       ;; that far below his last safe place, Jak fell out of
                                              ;; the zone (the game's fall death comes some 25 m down;
                                              ;; the city's walkways stand well under 20 m)

(deftype bf-director (process)
  "Runs the battle. One instance, `(-> *bf* director)`."
  ((page          int32)
   (cursor        int32)
   (pick-zone     int32)
   (pick-team     int32)
   (menu-mode?    symbol)     ;; the director holds the 'menu master mode
   (want-avatar?  symbol)     ;; the class model must be (re)drawn as soon as it is loaded
   (refill?       symbol)     ;; the open class page deploys the player: fresh ammo
   (prepared?     symbol)     ;; the city side of the battle is set up (BF_CITY_PREPARE)
   (end-pending?  symbol)     ;; end asked while Jak drives: done once he is on foot
   (leaving?      symbol)     ;; the mode was switched off in a battle: the last save is loading
   (preview       handle)     ;; turning class model of the class page
   (hud-time      time-frame) ;; last time the health HUD was asked to show
   (field-time    time-frame) ;; last force-field spark
   (field-sound   time-frame) ;; last force-field sound
   )
  (:state-methods
    idle
    )
  )

(define *bf-request* BF_REQ_NONE)
(define *bf-text* (new 'global 'string 256 (the-as string #f)))

;; Haven City alias levels as a battle needs them: Freedom League guards (ctypesa) and Krimzon
;; Guard robots (ctypesc) in every faction mix the sections ask for.
(define *bf-borrow*
  '((ctywide-ff alias ctywide copy ctypesa special ctypesc special dummy auto)
    (ctywide-kg alias ctywide copy ctypesa special ctypesc special dummy auto)
    (ctywide-ff-kg alias ctywide copy ctypesa special ctypesc special dummy auto)
    )
  )

;; ---------------------------------------------------------------------------------------------
;; Drawing
;; ---------------------------------------------------------------------------------------------

(defun bf-draw-text ((buf dma-buffer) (str string) (x float) (y float) (scale float) (color font-color) (center? symbol))
  "Draw STR into BUF at (X, Y) in screen font units (512 wide). CENTER? centers it on X, or on the
   screen when X is 0 (the middle flag centers the text on origin x). A page draws its panel and all
   its text into one buffer, panel first, or the panel ends up over the text."
  (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 color (font-flags shadow kerning large))))
    (set! (-> font scale) scale)
    (set! (-> font origin x) (if (and center? (= x 0.0)) 256.0 x))
    (set! (-> font origin y) y)
    (if center?
        (logior! (-> font flags) (font-flags middle))
        )
    (pc-encode-utf8-string str *pc-encoded-temp-string*)
    (draw-string-adv *pc-encoded-temp-string* buf font)
    )
  (none)
  )

;; One line of a wrapped text.
(define *bf-line* (new 'global 'string 128 (the-as string #f)))

(defun bf-draw-text-wrapped ((buf dma-buffer) (str string) (x float) (y float) (scale float) (color font-color) (max-chars int))
  "Draw STR from Y down, broken at spaces into lines of at most MAX-CHARS bytes (16 units apart),
   centered on the screen when X is 0, else from X. draw-string-adv does not wrap, and a
   description is wider than the menu panel."
  (let ((len (length str))
        (start 0)
        (line-y y)
        )
    (while (< start len)
      (let ((end (min len (+ start max-chars))))
        ;; cut inside a word: back up to the last space of the line
        (when (< end len)
          (let ((cut end))
            (while (and (> cut start) (!= (-> str data cut) 32))
              (+! cut -1)
              )
            (if (> cut start)
                (set! end cut)
                )
            )
          )
        (dotimes (i (- end start))
          (set! (-> *bf-line* data i) (-> str data (+ start i)))
          )
        (set! (-> *bf-line* data (- end start)) (the-as uint 0))
        (bf-draw-text buf *bf-line* x line-y scale color (= x 0.0))
        (set! start end)
        (while (and (< start len) (= (-> str data start) 32))
          (+! start 1)
          )
        (+! line-y 16.0)
        )
      )
    )
  (none)
  )

(defun bf-draw-box ((buf dma-buffer) (x int) (y int) (w int) (h int))
  "A dark panel with a light border into BUF, like the popup menus."
  (draw-sprite2d-xy buf x y w h (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf (+ x 1) (+ y 1) (+ w -2) (+ h -2) (static-rgba 0 0 0 200) #x3fffff)
  (none)
  )

(defun bf-draw-frame ((buf dma-buffer) (x int) (y int) (w int) (h int))
  "The light border of a panel without its fill: the class preview, drawn with the world, shows
   through it."
  (draw-sprite2d-xy buf x y w 1 (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf x (+ y h -1) w 1 (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf x y 1 h (static-rgba 255 255 255 75) #x3fffff)
  (draw-sprite2d-xy buf (+ x w -1) y 1 h (static-rgba 255 255 255 75) #x3fffff)
  (none)
  )

(defun bf-page-count ((page int))
  "Number of choices of PAGE."
  (cond
    ;; the war zones, then Spargus, to come (grey, refused)
    ((= page BF_PAGE_ZONE) (+ BF_ZONE_COUNT 1))
    ((= page BF_PAGE_TEAM) BF_TEAM_COUNT)
    ;; the Freedom League's third and fourth classes, the Spargus Citizen and Jak, are no longer
    ;; playable
    ((= page BF_PAGE_CLASS) (if (= (-> *bf* team) BF_TEAM_FF) 2 4))
    (else 1)
    )
  )

(defun bf-page-label ((page int) (team int) (i int))
  "Label of choice I of PAGE (TEAM picks the classes)."
  (cond
    ((= page BF_PAGE_ZONE) (if (< i BF_ZONE_COUNT) (bf-zone-name i) (bf-tr "Spargus (coming soon)" "Spargus (à venir)")))
    ((= page BF_PAGE_TEAM) (bf-team-name i))
    ((= page BF_PAGE_CLASS) (bf-class-name (+ (* team 4) i)))
    (else "")
    )
  )

(defun bf-page-desc ((page int) (team int) (i int))
  "Description of choice I of PAGE."
  (cond
    ((= page BF_PAGE_ZONE) (if (< i BF_ZONE_COUNT)
                               (bf-tr (-> *bf-zones* i desc) (-> *bf-zones* i desc-fr))
                               (bf-tr "The Wastelanders' desert city: coming in a later version."
                                      "La ville du désert des Wastelanders : dans une prochaine version."
                                      )
                               )
     )
    ((= page BF_PAGE_TEAM) (if (= i BF_TEAM_FF)
                               (bf-tr "Blue guards and jetpack guards."
                                      "Gardes bleus et gardes à jetpack."
                                      )
                               (bf-tr "Red Krimzon Guards, jetpack guards, robotguards and spider robots."
                                      "Gardes rouges, gardes à jetpack, robotgardes et araignées robots."
                                      )
                               )
     )
    ;; the class page draws its help lines itself (`bf-draw-class-help`)
    (else "")
    )
  )

(defun bf-draw-class-help ((buf dma-buffer) (class int) (y float))
  "The class page's description of CLASS into BUF: its help lines (battlefront-h.gc `*bf-classes*`,
   French when the game runs in French), one under the other from Y, each drawn as it is: its
   button tags become the font's button icons (`bf-draw-text`, pc-encode-utf8-string), the first
   line, the class's features, in the page's title color."
  (let ((lines (if (bf-fr?) (-> *bf-classes* class desc-fr) (-> *bf-classes* class desc))))
    (dotimes (i (-> lines length))
      (bf-draw-text buf (-> lines i) 52.0 (+ y (* 17.0 (the float i))) 0.36
                    (if (zero? i) (font-color menu-parent) (font-color default))
                    #f
                    )
      )
    )
  (none)
  )

;; The zone pages' map: the war zone's own minimap, the texture the game's minimap shows on its
;; battlefield (battlefront-minimaps.gc), framed on the battlefield in the right frame.
(defconstant BF_ZMAP_X 373.0)       ;; center of the map, on the 512 x 416 screen
(defconstant BF_ZMAP_Y 206.0)
(defconstant BF_ZMAP_HALF 120.0)    ;; at most half its height
(defconstant BF_ZMAP_HALF_W 96.0)   ;; at most half its width, to stay in the frame

(deftype bf-zone-view (structure)
  "Where `bf-zone-view!` puts a zone's map this frame: its box on the screen, and screen units per
   texel across and down."
  ((x0   float)
   (y0   float)
   (x1   float)
   (y1   float)
   (kx   float)
   (ky   float)
   )
  )

(define *bf-zone-view* (new 'static 'bf-zone-view))

(defun bf-zone-view! ((zone int))
  "Fit ZONE's whole map (battlefront-minimaps.gc: the minimap of its district) in the right frame,
   centered, its shape kept, into `*bf-zone-view*`. A texel is square in the world: on the 512 x 416
   screen stretched to the display, it is `0.923 relative-x-scale` times wider than tall in units."
  (let* ((view *bf-zone-view*)
         (w (the float (-> *bf-zone-minimap-size* (+ (* 3 zone) 2))))
         (h (the float (-> *bf-zone-minimap-size* (+ (* 3 zone) 1))))
         (aspect (* 0.923 (-> *video-params* relative-x-scale)))
         (ky (fmin (/ (* 2.0 BF_ZMAP_HALF) h) (/ (* 2.0 BF_ZMAP_HALF_W) (* w aspect))))
         (kx (* ky aspect))
         )
    (set! (-> view kx) kx)
    (set! (-> view ky) ky)
    (set! (-> view x0) (- BF_ZMAP_X (* 0.5 kx w)))
    (set! (-> view x1) (+ BF_ZMAP_X (* 0.5 kx w)))
    (set! (-> view y0) (- BF_ZMAP_Y (* 0.5 ky h)))
    (set! (-> view y1) (+ BF_ZMAP_Y (* 0.5 ky h)))
    )
  #t
  )

(defun bf-map-sprite ((buf dma-buffer) (zone int))
  "The uploaded map of ZONE into BUF over the view's box (`*bf-zone-view*`), white so the texture
   shows its own colors: its texels from 0 to the width the map fills, and its height. bigmap.gc
   sprite-dma with the texels and the box as arguments (screen x from 1792, GS y from 1840)."
  (let ((p (the-as (inline-array vector4w) (-> buf base)))
        (view *bf-zone-view*)
        )
    (set! (-> p 0 quad) (-> *bigmap* sprite-tmpl dma-vif quad))
    (set! (-> p 1 quad) (-> *bigmap* sprite-tmpl quad 1))
    (set-vector! (-> p 2) 128 128 128 128)
    (set-vector! (-> p 3) 0 0 0 0)
    (set-vector! (-> p 4) (* (+ (the int (-> view x0)) 1792) 16) (* (+ (the int (-> view y0)) 1840) 16) #xfffff0 0)
    (set-vector! (-> p 5)
                 (* 16 (-> *bf-zone-minimap-size* (+ (* 3 zone) 2)))
                 (* 16 (-> *bf-zone-minimap-size* (+ (* 3 zone) 1)))
                 0
                 0
                 )
    (set-vector! (-> p 6) (* (+ (the int (-> view x1)) 1792) 16) (* (+ (the int (-> view y1)) 1840) 16) #xfffff0 0)
    )
  (&+! (-> buf base) 112)
  (none)
  )

(defun bf-draw-zone-minimap ((zone int))
  "Zone and side pages: ZONE's map (battlefront-minimaps.gc, the minimap of its whole district) in
   the right frame (`bf-zone-view!`), its marks drawn over it by `bf-draw-zone-marks`. Its texels
   are uploaded the way the START menu's map uploads its own (bigmap.gc bigmap-method-20,
   `pc-upload-map-texture`: 8-bit texels into the texture at tbp 8, with their ct32 palette), then
   drawn as one sprite in a bucket of their own, under the page's. The upload marks the default
   level's VRAM dirty, as the START menu's map does."
  (bf-zone-view! zone)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id tex-hud-hud-alpha))
    (dma-buffer-add-gs-set buf
                           (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                           (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                           (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
                           )
    (pc-upload-map-texture buf
                           (the-as pointer (&-> *bf-zone-minimap-texels* (-> *bf-zone-minimap-offset* zone)))
                           (the-as pointer (&-> *bf-zone-minimap-clut* 0))
                           (-> *bf-zone-minimap-size* (* 3 zone))
                           (-> *bf-zone-minimap-size* (+ (* 3 zone) 1))
                           8
                           0
                           )
    (dma-buffer-add-gs-set buf
                           (tex0-1 (the-as gs-tex0 (-> *bf-zone-minimap-tex0* zone)))
                           (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                           (texflush 0)
                           )
    (bf-map-sprite buf zone)
    )
  (set-dirty-mask! (-> *level* level-default) 4 #x1a400 0)
  (none)
  )

(defun bf-zone-dot ((buf dma-buffer) (zone int) (p vector) (size int) (color rgba))
  "A SIZE unit dot of COLOR at world point P on ZONE's map (`*bf-zone-view*`), inside its box."
  (let* ((view *bf-zone-view*)
         (texel (-> *bf-zone-minimap-corner* (+ (* 3 zone) 2)))
         (tx (/ (- (-> p x) (-> *bf-zone-minimap-corner* (* 3 zone))) texel))
         (ty (/ (- (-> p z) (-> *bf-zone-minimap-corner* (+ (* 3 zone) 1))) texel))
         (x (+ (-> view x0) (* (-> view kx) tx)))
         (y (+ (-> view y0) (* (-> view ky) ty)))
         )
    (when (and (< (-> view x0) x) (< x (-> view x1)) (< (-> view y0) y) (< y (-> view y1)))
      (draw-sprite2d-xy buf (- (the int x) (/ size 2)) (- (the int y) (/ size 2)) size size color #x3fffff)
      )
    )
  (none)
  )

(defun bf-draw-zone-marks ((buf dma-buffer) (zone int))
  "Over the zone's map (`bf-draw-zone-minimap`): its frame, the Freedom League's base (blue), the
   Krimzon Guard's (red), the control points (grey, `*bf-point-defs*`) and Jak (white). The whole
   city is the battlefield."
  (bf-zone-view! zone)
  (let ((view *bf-zone-view*)
        (ff (get-continue-by-name *game-info* (-> *bf-zones* zone ff-continue)))
        (kg (get-continue-by-name *game-info* (-> *bf-zones* zone kg-continue)))
        )
    (bf-draw-frame buf
                   (the int (-> view x0))
                   (the int (-> view y0))
                   (the int (- (-> view x1) (-> view x0)))
                   (the int (- (-> view y1) (-> view y0)))
                   )
    (if ff
        (bf-zone-dot buf zone (-> ff trans) 9 (static-rgba 40 110 255 128))
        )
    (if kg
        (bf-zone-dot buf zone (-> kg trans) 9 (static-rgba 255 40 40 128))
        )
    (when (not (bf-active?))
      (let ((at (new 'stack-no-clear 'vector)))
        (dotimes (i BF_CONTROL_POINTS)
          (let ((def (-> *bf-point-defs* (+ i 2))))
            (set-vector! at (meters (-> def x)) (meters (-> def y)) (meters (-> def z)) 1.0)
            (bf-zone-dot buf zone at 7 (static-rgba 220 220 220 128))
            )
          )
        )
      )
    (if *target*
        (bf-zone-dot buf zone (-> *target* control trans) 5 (static-rgba 255 255 255 128))
        )
    )
  (none)
  )

(defbehavior bf-draw-page bf-director ()
  "Draw the open page of the battle menu. The zone, side and class pages share one layout: the
   choices on the left, the zone's map or the class's preview on the right. The preview
   (`bf-preview-update`) is drawn with the world, under any panel: its frame has no fill."
  (let ((page (-> self page))
        (team (-> self pick-team))
        )
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf2))
      (cond
        ((= page BF_PAGE_RESULT)
         (bf-draw-box buf 56 70 400 250)
         (bf-draw-text buf "BATTLEFRONT" 0.0 84.0 0.7 (font-color menu-parent) #t)
         (bf-draw-text buf (if (= (-> *bf* winner) (-> *bf* team)) (bf-tr "VICTORY" "VICTOIRE") (bf-tr "DEFEAT" "DÉFAITE"))
                   0.0 130.0 1.2 (if (= (-> *bf* winner) (-> *bf* team)) (font-color green) (font-color red)) #t)
         (clear *bf-text*)
         (format *bf-text* (bf-tr "~S win" "Victoire : ~S") (bf-team-name (max 0 (-> *bf* winner))))
         (bf-draw-text buf *bf-text* 0.0 190.0 0.6 (font-color default) #t)
         (clear *bf-text*)
         (format *bf-text* (bf-tr "Losses: ~S ~D, ~S ~D" "Pertes : ~S ~D, ~S ~D")
                 (bf-team-name 0) (-> *bf* losses 0) (bf-team-name 1) (-> *bf* losses 1))
         (bf-draw-text-wrapped buf *bf-text* 0.0 216.0 0.45 (font-color default) 40)
         (bf-draw-text buf (bf-tr "<PAD_X> Leave the battle" "<PAD_X> Quitter la bataille") 0.0 290.0 0.5 (font-color default) #t)
         )
        (else
          ;; left panel: the title, the choices, the description of the one under the cursor; right:
          ;; a frame around the turning class (`bf-preview-update`) or the zone's map
          (bf-draw-box buf 40 60 226 292)
          (bf-draw-frame buf 274 60 198 292)
          (bf-draw-text buf (if (= page BF_PAGE_CLASS) (bf-team-name team) "BATTLEFRONT") 54.0 68.0 0.6 (font-color menu-parent) #f)
          (bf-draw-text buf
                    (cond
                      ((= page BF_PAGE_ZONE) (bf-tr "Choose the war zone" "Choisissez la zone de guerre"))
                      ((= page BF_PAGE_TEAM) (bf-tr "Choose your side" "Choisissez votre camp"))
                      (else (bf-tr "Choose your class" "Choisissez votre classe"))
                      )
                    54.0 92.0 0.45 (font-color default) #f)
          (dotimes (i (bf-page-count page))
            (bf-draw-text buf
                      (bf-page-label page team i)
                      54.0
                      (+ 122.0 (* 22.0 (the float i)))
                      ;; the class names are longer ("Red Krimzon Guard (Jetpack)" ran past the panel)
                      (if (= page BF_PAGE_CLASS) 0.43 0.5)
                      (cond
                        ((and (= page BF_PAGE_ZONE) (>= i BF_ZONE_COUNT)) (font-color menu-invalid))
                        ((= i (-> self cursor)) (font-color cyan))
                        (else (font-color default))
                        )
                      #f)
            )
          (if (= page BF_PAGE_CLASS)
              ;; under the class list, which holds two or four names
              (bf-draw-class-help buf (+ (* team 4) (-> self cursor)) (+ 128.0 (* 22.0 (the float (bf-page-count page)))))
              (bf-draw-text-wrapped buf (bf-page-desc page team (-> self cursor)) 54.0 216.0 0.38 (font-color menu-parent) 27)
              )
          (bf-draw-text buf
                    (cond
                      ((= page BF_PAGE_ZONE) (bf-tr "<PAD_X> Select  <PAD_CIRCLE> Cancel" "<PAD_X> Choisir  <PAD_CIRCLE> Annuler"))
                      ((= page BF_PAGE_TEAM) (bf-tr "<PAD_X> Select  <PAD_CIRCLE> Back" "<PAD_X> Choisir  <PAD_CIRCLE> Retour"))
                      ;; the deployment still loads the zone under the page (`bf-deploy-update`)
                      ((= (-> *bf* phase) BF_PHASE_DEPLOY) (bf-tr "Loading the war zone..." "Chargement de la zone de guerre..."))
                      (else (bf-tr "<PAD_X> Deploy" "<PAD_X> Déployer"))
                      )
                    54.0 330.0 0.4 (font-color default) #f)
          (cond
            ((= page BF_PAGE_CLASS)
             0
             )
            ((and (= page BF_PAGE_ZONE) (>= (-> self cursor) BF_ZONE_COUNT))
             (bf-draw-text buf (bf-tr "Coming soon" "À venir") 373.0 200.0 0.6 (font-color menu-invalid) #t)
             )
            (else
              (bf-draw-zone-marks buf (if (= page BF_PAGE_ZONE) (-> self cursor) (-> self pick-zone)))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior bf-preview-update bf-director ()
  "Class page: the class under the cursor stands in the right frame and turns a full circle every 4
   seconds (a `bf-icon` 3 m in front of the camera of the paused game). Any other page: none."
  (let ((want (if (= (-> self page) BF_PAGE_CLASS) (+ (* (-> self pick-team) 4) (-> self cursor)) -1))
        (icon (handle->process (-> self preview)))
        )
    (when (and icon (!= want (-> (the-as bf-icon icon) class)))
      (deactivate icon)
      (set! icon #f)
      )
    (when (and (>= want 0) (not icon))
      (set! icon (bf-icon-spawn want 90.0 0.0 self))
      (set! (-> self preview) (process->handle icon))
      )
    (if icon
        (bf-icon-place icon 373.0 206.0 230.0 (meters 3))
        )
    )
  (none)
  )

;; Indexed by BF_WEAPON_*: the gun (pickup-type) whose icon the stock gun HUD shows for a guard's
;; weapon: the rifle yellow 1, the tazer blue 2, the grenade launcher red 3.
(define *bf-hud-weapons* (new 'static 'array int32 3 29 33 28))

(defun bf-gun-hud-weapon ()
  "BF_WEAPON_* the gun HUD shows: a guard's weapon in hand, during a fight with the class model up;
   -1 otherwise (the jetpacks', the robotguard's and the spider's guns need no ammo: no gun HUD)."
  (if (and (bf-fighting?) (bf-avatar-alive?) (bf-guard-class? (-> *bf* class)))
      (-> *bf* weapon)
      -1
      )
  )

(define-perm *bf-stock-gun-update* (function hud-gun none)
             (method-of-type hud-gun update-values!)
             )

(defmethod update-values! ((this hud-gun))
  "Jak's gun HUD (hud-classes.gc), top right. During a fight it shows a guard's weapon in place of
   Jak's gun, which the battle puts away: the stock icon of the weapon (`*bf-hud-weapons*`); its
   ammo is drawn by the `draw` below. Otherwise the stock handling, which hides it while Jak has no
   gun out."
  (let ((weapon (bf-gun-hud-weapon)))
    (cond
      ((>= weapon 0)
       (set! (-> this values 0 target) (-> *bf-hud-weapons* weapon))
       (set! (-> this values 1 target) 1)
       (logclear! (-> this flags) (hud-flags disable))
       (logior! (-> this flags) (hud-flags show))
       ((method-of-type hud update-values!) this)
       )
      (else
        (*bf-stock-gun-update* this)
        )
      )
    )
  (none)
  )

(define-perm *bf-stock-gun-draw* (function hud-gun none)
             (method-of-type hud-gun draw)
             )

(define *bf-gun-text* (new 'global 'string 32 (the-as string #f)))

(defun bf-draw-gun-ammo ((this hud-gun) (weapon int))
  "Under the guard's weapon icon, in place of the stock count and shells: the rifle's magazine as 10
   shells, full or empty, and \"magazine/reserve\" (10/20); the grenades as 5 shells and their
   count; for the tazer no ammo, only the seconds left while it recharges, in red. Placed as the
   stock draw places its own (hud-classes.gc hud-gun draw: the shells from the icon's position, 5
   units apart upward; the text at the spot it gave its string)."
  (let* ((rifle? (= weapon BF_WEAPON_RIFLE))
         (slots (cond
                  (rifle? BF_MAG_RIFLE)
                  ((= weapon BF_WEAPON_GRENADE) (the int BF_GRENADES))
                  (else 0)
                  )
                )
         (full (cond
                 (rifle? (-> *bf* mag BF_WEAPON_RIFLE))
                 ((= weapon BF_WEAPON_GRENADE) (the int (-> *game-info* gun-ammo BF_AMMO_RED)))
                 (else 0)
                 )
               )
         (shell (-> this sprites 14))
         )
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id hud-draw-hud-alpha)
                                 )
      (when (> slots 0)
        ;; the stock offsets for these icons: rifle (yellow) 10 and 7, launcher (red) 23 and -2
        (set-as-offset-from! shell (-> this sprites 0 pos) (if rifle? -58 -45) (if rifle? 129 120))
        (set! (-> shell scale-x) 1.0)
        (dotimes (i slots)
          (set! (-> shell tid)
                (the-as texture-id (cond
                                     ((>= i full) (get-texture hud-gun-empty-shell-01 level-default-minimap))
                                     (rifle? (get-texture hud-gun-yellow-shell-01 level-default-minimap))
                                     (else (get-texture hud-gun-red-shell-01 level-default-minimap))
                                     )
                        )
                )
          (draw shell buf (-> this level) #f)
          (+! (-> shell pos y) -5)
          )
        (set! (-> shell scale-x) 0.0)
        )
      (clear *bf-gun-text*)
      (cond
        (rifle?
         (format *bf-gun-text* "~D/~D" full (the int (-> *game-info* gun-ammo BF_AMMO_YELLOW)))
         )
        ((= weapon BF_WEAPON_GRENADE)
         (format *bf-gun-text* "~D" full)
         )
        ((not (bf-tazer-ready?))
         (format *bf-gun-text* "~D" (+ 1 (/ (- BF_TAZER_RECHARGE (- (current-time) (-> *bf* tazer-time))) (seconds 1))))
         )
        )
      (when (nonzero? (length *bf-gun-text*))
        (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
          (set-vector! (-> font origin)
                       (the float (-> this strings 0 pos x))
                       (the float (-> this strings 0 pos y))
                       (the float (-> this strings 0 pos z))
                       1.0
                       )
          (set! (-> font scale) 0.4)
          (set! (-> font flags) (font-flags kerning middle large))
          (set! (-> font color) (if (or (zero? full) (= weapon BF_WEAPON_TAZER)) (font-color red) (font-color white)))
          (set-context! *font-work* font)
          (draw-string *bf-gun-text* buf font)
          )
        )
      )
    )
  (none)
  )

(defmethod draw ((this hud-gun))
  "Jak's gun HUD drawn. For a guard's weapon (`bf-gun-hud-weapon`): the stock icon, without its
   stock count and shells (scaled to nothing for the call: they show Jak's own ammo against its
   stock maximum), then the guard's ammo (`bf-draw-gun-ammo`). Otherwise the stock draw."
  (let ((weapon (bf-gun-hud-weapon)))
    (cond
      ((< weapon 0)
       (*bf-stock-gun-draw* this)
       )
      (else
        (let ((text-scale (-> this strings 0 scale))
              (shell-y (-> this sprites 14 scale-y))
              )
          (set! (-> this strings 0 scale) 0.0)
          (set! (-> this sprites 14 scale-y) 0.0)
          (*bf-stock-gun-draw* this)
          (set! (-> this strings 0 scale) text-scale)
          (set! (-> this sprites 14 scale-y) shell-y)
          )
        (if (not (hidden? this))
            (bf-draw-gun-ammo this weapon)
            )
        )
      )
    )
  (none)
  )

(defun bf-class-gauge ()
  "Level (0 to 1) of the class's gauge: the jetpack's boost, the spider's blue eco, or the
   robotguard's shield (draining while it is up, then refilling until it can go up again); -1.0
   for none."
  (let ((av (the-as bf-avatar (handle->process (-> *bf* avatar))))
        (class (-> *bf* class))
        )
    (cond
      ((not av) -1.0)
      ((or (= class BF_CLASS_BLUE_JETPACK) (= class BF_CLASS_RED_JETPACK)) (-> av fuel))
      ((= class BF_CLASS_SPYDROID) (-> av boost))
      ((= class BF_CLASS_ROBOGUARD)
       (let ((since (the float (- (current-time) (-> av shield-time)))))
         (cond
           ((-> av shield?) (fmax 0.0 (- 1.0 (/ since (the float BF_SHIELD_TIME)))))
           ((zero? (-> av shield-time)) 1.0)
           (else (fmin 1.0 (/ since (the float BF_SHIELD_RECHARGE))))
           )
         )
       )
      (else -1.0)
      )
    )
  )

;; The crosshair sprite: Jak's gun reticle texture (hud-gun).
(define *bf-reticle* (new 'static 'hud-sprite))

(defun bf-draw-reticle ()
  "The crosshair, fixed above the screen's center where the free aim's ray goes (`bf-free-aim`),
   red when the ray meets a foe. While the tazer locks a foe by itself (`bf-avatar-update-aim`), it
   moves onto that foe. A HUD sprite, so it goes in the HUD's sprite bucket."
  (bf-free-aim)
  (let ((av (the-as bf-avatar (handle->process (-> *bf* avatar))))
        (spr *bf-reticle*)
        (x BF_CROSS_X)
        (y BF_CROSS_Y)
        (foe? (if (handle->process (-> *bf* aim-foe)) #t #f))
        )
    (when (and av (-> av locked?))
      (let ((scr (new 'stack-no-clear 'vector)))
        ;; screen point in GS units: the screen's origin is at (1792, 1840) (bigmap.gc)
        (when (transform-point-vector! scr (-> av aim))
          (set! x (- (-> scr x) 1792.0))
          (set! y (- (-> scr y) 1840.0))
          (set! foe? #t)
          )
        )
      )
    (set! (-> spr tid) (the-as texture-id (get-texture hud-gun-reticle level-default-minimap)))
    (set! (-> spr flags) (hud-sprite-flags hsf3))
    (set! (-> spr scale-x) 1.0)
    (set! (-> spr scale-y) 1.0)
    (set! (-> spr angle) 0.0)
    (set-vector! (-> spr pos) (the int x) (the int y) #xffffff 0)
    (set-vector! (-> spr color) 128 (if foe? 32 128) (if foe? 32 128) 128)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id hud-draw-hud-alpha))
      (draw spr buf (-> *level* level-default) #f)
      )
    )
  (none)
  )

(defbehavior bf-hud-health-update bf-director ((on? symbol))
  "Jak's health HUD (hud-classes.gc hud-health) during the fight (ON?): asked to show every second,
   so it stays up. Its class gauge is `bf-hud-health-gauges`."
  (let ((hud (the-as hud (and *target* (process-by-name "hud-health" *target*)))))
    (when (and hud on? (time-elapsed? (-> self hud-time) (seconds 1)))
      (set-time! (-> self hud-time))
      (send-event hud 'show)
      )
    )
  (none)
  )

(defun bf-hud-health-gauges ((hud hud))
  "Called by hud-health's draw (hud-classes.gc) once it has set its eco gauges and before its
   sprites are drawn. During a fight, the class's gauge (`bf-class-gauge`) takes the place of one of
   them, its stock sprite at the stock scale, with the class's color: the jetpack's fuel in the dark
   eco gauge (sprite 2, the right half; its color, the bright one it takes when Jak has eco enough
   for a dark bomb), the spider's blue eco and the robotguard's roll in the light eco gauge (sprite
   1, the left half) in blue and in red. The battle keeps Jak's own light and dark eco at 0. Drawn
   before the ring, as the stock gauges, the ring's windows shape them; a sprite drawn after the
   ring was hidden behind it (seen in game)."
  (let ((level (if (bf-fighting?) (bf-class-gauge) -1.0)))
    (when (<= 0.0 level)
      (let ((dark? (or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK)))
            ;; the stock gauges' pulse (hud-health draw), here 0.5 to 1: the stock one, 0 to 1, made
            ;; the fuel vanish on the dark disc half the time
            (pulse (+ 0.75 (* 0.25 (sin (degrees (the float (mod (-> *display* game-clock frame-counter) 360)))))))
            )
        (cond
          (dark?
            (set! (-> hud sprites 2 scale-y) (* -9.7 level))
            (set-vector! (-> hud sprites 2 color)
                         (the int (* 0.35 255.0 pulse))
                         (the int (* 25.5 pulse))
                         (the int (* 0.8 255.0 pulse))
                         128
                         )
            )
          (else
            (set! (-> hud sprites 1 scale-y) (* -9.8 level))
            (if (= (-> *bf* class) BF_CLASS_SPYDROID)
                (set-vector! (-> hud sprites 1 color) (the int (* 20.0 pulse)) (the int (* 60.0 pulse)) (the int (* 128.0 pulse)) 128)
                (set-vector! (-> hud sprites 1 color) (the int (* 128.0 pulse)) (the int (* 16.0 pulse)) (the int (* 16.0 pulse)) 128)
                )
            )
          )
        )
      )
    )
  (none)
  )

(defconstant BF_BAR_HALF 76)  ;; length of a full reserve bar, out from the screen's middle

(defun bf-draw-reserves ((buf dma-buffer))
  "Top middle, after the reinforcement meter of Star Wars Battlefront (2004): in a dark panel, the
   player's side's bar runs left from the middle in green and the enemy's runs right in red, each as
   long as its reserve (BF_RESERVE fills it), with the two counts under them on either side of a
   divider. Narrow enough to stay clear of the stock gun HUD top right."
  (let* ((mine (-> *bf* team))
         (them (- 1 mine))
         (lm (the int (/ (* (the float BF_BAR_HALF) (the float (-> *bf* reserve mine))) (the float BF_RESERVE))))
         (lt (the int (/ (* (the float BF_BAR_HALF) (the float (-> *bf* reserve them))) (the float BF_RESERVE))))
         )
    (bf-draw-box buf (- 248 BF_BAR_HALF) 4 (+ (* 2 BF_BAR_HALF) 16) 36)
    (draw-sprite2d-xy buf (- 254 BF_BAR_HALF) 9 BF_BAR_HALF 5 (static-rgba 50 50 50 128) #x3fffff)
    (draw-sprite2d-xy buf 258 9 BF_BAR_HALF 5 (static-rgba 50 50 50 128) #x3fffff)
    (draw-sprite2d-xy buf (- 254 lm) 9 lm 5 (static-rgba 60 220 60 128) #x3fffff)
    (draw-sprite2d-xy buf 258 9 lt 5 (static-rgba 235 50 50 128) #x3fffff)
    (draw-sprite2d-xy buf 255 16 2 20 (static-rgba 255 255 255 75) #x3fffff)
    (clear *bf-text*)
    (format *bf-text* "~D" (-> *bf* reserve mine))
    (bf-draw-text buf *bf-text* 226.0 18.0 0.55 (font-color green) #t)
    (clear *bf-text*)
    (format *bf-text* "~D" (-> *bf* reserve them))
    (bf-draw-text buf *bf-text* 286.0 18.0 0.55 (font-color red) #t)
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Battle points: the sides' bases and the control points (`*bf*` points)
;; ---------------------------------------------------------------------------------------------

;; The points' beams, drawn each frame by `draw-beam` (gun-util.gc): the player's gun beam (gun-part.gc
;; part 231) lasting one frame, 150 m tall and 1.5 m wide, blue for the Freedom League, red for the
;; Krimzon Guard, white for a neutral point. Free ids above the stock 5154.
(defpart 5200
  :init-specs ((:texture (gun-blue-beam level-default-sprite))
    (:birth-func 'birth-func-setup-beam)
    (:num 1.0)
    (:scale-x (meters 1.5))
    (:scale-y (meters 150))
    (:r 40.0)
    (:g 90.0)
    (:b 255.0)
    (:a 80.0)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 left-multiply-quat))
    )
  )

(defpart 5201
  :init-specs ((:texture (gun-blue-beam level-default-sprite))
    (:birth-func 'birth-func-setup-beam)
    (:num 1.0)
    (:scale-x (meters 1.5))
    (:scale-y (meters 150))
    (:r 255.0)
    (:g 20.0)
    (:b 20.0)
    (:a 80.0)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 left-multiply-quat))
    )
  )

(defpart 5202
  :init-specs ((:texture (gun-blue-beam level-default-sprite))
    (:birth-func 'birth-func-setup-beam)
    (:num 1.0)
    (:scale-x (meters 1.5))
    (:scale-y (meters 150))
    (:r 255.0)
    (:g 255.0)
    (:b 255.0)
    (:a 64.0)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 left-multiply-quat))
    )
  )

(defun bf-points-setup ()
  "The battle's points as its fight starts: the two bases at the sides' spawns (`*bf*` spawn, point
   0 the Freedom League's, 1 the Krimzon Guard's), then a control point in each district, neutral,
   where `*bf-point-defs*` puts it."
  (set! (-> *bf* point-count) (+ 2 BF_CONTROL_POINTS))
  (set! (-> *bf* respawn-pick) -1)
  (set! (-> *bf* point-time) 0)
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (cond
        ((< i 2)
         (vector-copy! (-> pt pos) (-> *bf* spawn i))
         (set! (-> pt owner) i)
         (set! (-> pt base?) #t)
         )
        (else
          (let ((def (-> *bf-point-defs* i)))
            (set-vector! (-> pt pos) (meters (-> def x)) (meters (-> def y)) (meters (-> def z)) 1.0)
            )
          (set! (-> pt owner) BF_TEAM_NONE)
          (set! (-> pt base?) #f)
          )
        )
      (set! (-> pt prog-team) BF_TEAM_NONE)
      (set! (-> pt progress) 0.0)
      (set! (-> pt fight) 0.0)
      (set! (-> pt snapped?) #f)
      (set! (-> pt old-ship) (the-as handle #f))
      (set! (-> pt near 0) 0)
      (set! (-> pt near 1) 0)
      (set! (-> pt ship) (the-as handle #f))
      )
    )
  (none)
  )

(defun bf-point-name ((i int))
  "Name of point I in the game's language (`*bf-point-defs*`)."
  (bf-tr (-> *bf-point-defs* i name) (-> *bf-point-defs* i name-fr))
  )

(defun bf-point-letter ((i int))
  "Letter of control point I on the HUD: A, B, C, D (the bases are not lettered)."
  (case i
    ((2) "A")
    ((3) "B")
    ((4) "C")
    ((5) "D")
    (else "?")
    )
  )

(defun bf-point-live? ((pt bf-point))
  "#t when the section PT stands in is loaded with its streets: a nav mesh within 8 m (the game
   finds one in active levels only). Its fight is then the units' own (`bf-point-count`)."
  (if (find-nearest-nav-mesh (-> pt pos) (meters 8)) #t #f)
  )

(defun bf-point-pressure ((i int) (team int))
  "How many points next to point I (`*bf-point-links*`) side TEAM holds."
  (let ((n 0))
    (dotimes (k (-> *bf* point-count))
      (if (and (logtest? (-> *bf-point-links* i) (ash 1 k)) (= (-> *bf* points k owner) team))
          (+! n 1)
          )
      )
    n
    )
  )

(defconstant BF_FIGHT_LOSS 10.0) ;; seconds of a fight away from the player per unit each side loses

(defun bf-point-away ((i int) (dt float))
  "The fight for point I while its section is not loaded, DT seconds of it: no unit is there to
   count, so a side fights for it from the points next to it it holds (`bf-point-pressure`). A side
   alone at it captures it at the normal pace, at half pace when the holder holds a point next to
   it too; both sides at a neutral one, the one holding more neighbours; a tie holds it. Every
   BF_FIGHT_LOSS seconds of fight, each side there loses a unit (`bf-count-loss`)."
  (let* ((pt (-> *bf* points i))
         (owner (-> pt owner))
         (ff (if (= owner BF_TEAM_FF) 0 (bf-point-pressure i BF_TEAM_FF)))
         (kg (if (= owner BF_TEAM_KG) 0 (bf-point-pressure i BF_TEAM_KG)))
         (held (if (= owner BF_TEAM_NONE) 0 (bf-point-pressure i owner)))
         (major (cond
                  ((< kg ff) BF_TEAM_FF)
                  ((< ff kg) BF_TEAM_KG)
                  (else BF_TEAM_NONE)
                  )
                )
         (pace (if (< 0 held) 0.5 1.0))
         )
    (set! (-> pt near 0) 0)
    (set! (-> pt near 1) 0)
    (cond
      ((and (zero? ff) (zero? kg))
       ;; no one comes: a capture under way fades
       (set! (-> pt fight) 0.0)
       (set! (-> pt progress) (fmax 0.0 (- (-> pt progress) dt)))
       (if (= (-> pt progress) 0.0)
           (set! (-> pt prog-team) BF_TEAM_NONE)
           )
       )
      (else
        (+! (-> pt fight) dt)
        (when (>= (-> pt fight) BF_FIGHT_LOSS)
          (set! (-> pt fight) 0.0)
          (if (< 0 ff)
              (bf-count-loss BF_TEAM_FF)
              )
          (if (< 0 kg)
              (bf-count-loss BF_TEAM_KG)
              )
          (if (< 0 held)
              (bf-count-loss owner)
              )
          )
        (cond
          ((= major BF_TEAM_NONE)
           0
           )
          ((and (!= (-> pt prog-team) BF_TEAM_NONE) (!= (-> pt prog-team) major))
           (set! (-> pt progress) (fmax 0.0 (- (-> pt progress) dt)))
           (if (= (-> pt progress) 0.0)
               (set! (-> pt prog-team) major)
               )
           )
          (else
            (set! (-> pt prog-team) major)
            (+! (-> pt progress) (* pace dt))
            (when (>= (-> pt progress) BF_CAPTURE_TIME)
              (set! (-> pt owner) major)
              (set! (-> pt progress) 0.0)
              (set! (-> pt prog-team) BF_TEAM_NONE)
              (set! (-> pt fight) 0.0)
              (format 0 "battlefront: point ~S captured away from the player by side ~D~%" (bf-point-name i) major)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-point-count ((pt bf-point))
  "Units of each side within BF_POINT_RADIUS of PT now, into its near counts; the player counts with
   his side's, while his class model is up."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> pt pos)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        )
    (set! (-> pt near 0) 0)
    (set! (-> pt near 1) 0)
    (set! (-> probe w) BF_POINT_RADIUS)
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            ;; the actor hash can hold a process moved or gone since it was filled: its handle tells
            (when (and proc
                       (= (handle->process (process->handle proc)) proc)
                       (!= proc *target*)
                       (type? proc process-focusable)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (< (vector-vector-distance (-> (the-as process-focusable proc) root trans) (-> pt pos))
                          BF_POINT_RADIUS
                          )
                       )
              (let ((team (bf-unit-team proc)))
                (if (or (= team BF_TEAM_FF) (= team BF_TEAM_KG))
                    (+! (-> pt near team) 1)
                    )
                )
              )
            )
          )
        )
      )
    (when (and *target*
               (not (focus-test? *target* dead))
               (bf-avatar-alive?)
               (< (vector-vector-distance (-> *target* control trans) (-> pt pos)) BF_POINT_RADIUS)
               )
      (+! (-> pt near (-> *bf* team)) 1)
      )
    )
  (none)
  )

(defun bf-update-points ()
  "Four times a second during a fight: each control point's capture. In a loaded section
   (`bf-point-live?`) the side with more units within BF_POINT_RADIUS (`bf-point-count`) captures
   it: its progress grows by the time gone by, and at BF_CAPTURE_TIME seconds the point is its.
   Another side's capture under way is first taken back down to zero; a tie, or no one, holds it;
   the holder's majority takes a capture back down. Away from the player, `bf-point-away`."
  (when (or (zero? (-> *bf* point-time)) (time-elapsed? (-> *bf* point-time) (seconds 0.25)))
    (let ((dt (if (zero? (-> *bf* point-time))
                  0.0
                  (fmin 1.0 (* 0.0033333334 (the float (- (current-time) (-> *bf* point-time)))))
                  )
              )
          )
      (set-time! (-> *bf* point-time))
      (dotimes (i (-> *bf* point-count))
        (let ((pt (-> *bf* points i)))
          (cond
            ((-> pt base?)
             0
             )
            ((not (bf-point-live? pt))
             (bf-point-away i dt)
             )
            (else
          (bf-point-count pt)
          (set! (-> pt fight) 0.0)
            (let* ((ff (-> pt near BF_TEAM_FF))
                   (kg (-> pt near BF_TEAM_KG))
                   (major (cond
                            ((< kg ff) BF_TEAM_FF)
                            ((< ff kg) BF_TEAM_KG)
                            (else BF_TEAM_NONE)
                            )
                          )
                   )
              (cond
                ((= major BF_TEAM_NONE)
                 0
                 )
                ((or (= major (-> pt owner)) (and (!= (-> pt prog-team) BF_TEAM_NONE) (!= (-> pt prog-team) major)))
                 ;; the holder's majority, or another side's capture to undo first
                 (set! (-> pt progress) (fmax 0.0 (- (-> pt progress) dt)))
                 (when (= (-> pt progress) 0.0)
                   (set! (-> pt prog-team) (if (= major (-> pt owner)) BF_TEAM_NONE major))
                   )
                 )
                (else
                  (set! (-> pt prog-team) major)
                  (+! (-> pt progress) dt)
                  (when (>= (-> pt progress) BF_CAPTURE_TIME)
                    (set! (-> pt owner) major)
                    (set! (-> pt progress) 0.0)
                    (set! (-> pt prog-team) BF_TEAM_NONE)
                    (format 0 "battlefront: point ~S captured by side ~D~%" (bf-point-name i) major)
                    )
                  )
                )
              )
            )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-draw-points ()
  "Each frame of a fight: every point's beam from its ground up, in its holder's color, white while
   neutral (parts 5200 to 5202). draw-beam turns its part along the direction: straight up makes no
   rotation, so the beam leans 0.6 degrees."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (draw-beam (-> *part-id-table* (case (-> pt owner)
                                       ((BF_TEAM_FF) 5200)
                                       ((BF_TEAM_KG) 5201)
                                       (else 5202)
                                       )
                     )
                 (-> pt pos)
                 (new 'static 'vector :y 1.0 :z 0.01 :w 1.0)
                 #f
                 )
      )
    )
  (none)
  )

(defun bf-team-color ((team int))
  "Font color of side TEAM, white for none."
  (case team
    ((BF_TEAM_FF) (font-color cyan))
    ((BF_TEAM_KG) (font-color red))
    (else (font-color white))
    )
  )

(defun bf-draw-points-hud ((buf dma-buffer))
  "Under the reserves: each control point's letter in its holder's color (white neutral), and
   under it the share of a capture under way, in the capturing side's color."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (when (not (-> pt base?))
        (let ((x (+ 256.0 (* 36.0 (+ -3.5 (the float i))))))
          (bf-draw-text buf (bf-point-letter i) x 66.0 0.7 (bf-team-color (-> pt owner)) #t)
          (when (and (!= (-> pt prog-team) BF_TEAM_NONE) (< 0.0 (-> pt progress)))
            (clear *bf-text*)
            (format *bf-text* "~D%" (the int (* 100.0 (/ (-> pt progress) BF_CAPTURE_TIME))))
            (bf-draw-text buf *bf-text* x 90.0 0.4 (bf-team-color (-> pt prog-team)) #t)
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-point-held? ((i int) (team int))
  "#t when point I is in use and side TEAM holds it."
  (and (>= i 0) (< i (-> *bf* point-count)) (= (-> *bf* points i owner) team))
  )

(defun bf-next-held-point ((from int) (team int) (step int))
  "The point side TEAM holds after (STEP 1) or before (STEP -1) point FROM, around the list; FROM
   when it holds no other."
  (let ((n (-> *bf* point-count))
        (i from)
        )
    (dotimes (k n)
      (set! i (mod (+ i step n) n))
      (if (bf-point-held? i team)
          (return i)
          )
      )
    from
    )
  )

(defun bf-draw-respawn-pick ((buf dma-buffer))
  "The player's choice of respawn point at each death or redeploy (`bf-target-death`): the whole
   city's map in the right frame, each point a dot of its holder's color, the one picked large and
   blinking, and the units awake as small dots of their side's color, live; on the left its name
   and how to pick."
  (let ((zone (-> *bf* zone))
        (pick (-> *bf* respawn-pick))
        )
    (bf-draw-box buf 56 70 186 250)
    (bf-draw-text buf (bf-tr "RESPAWN POINT" "POINT DE RETOUR") 149.0 84.0 0.55 (font-color menu-parent) #t)
    (bf-draw-text-wrapped buf
                          (bf-tr "Your side's base and the control points it holds."
                                 "La base de votre camp et les points de contrôle qu'il tient."
                                 )
                          70.0 112.0 0.42 (font-color default) 26
                          )
    (clear *bf-text*)
    (format *bf-text* "~S" (if (< pick 2) (bf-tr "Base" "Base") (bf-point-name pick)))
    (bf-draw-text buf *bf-text* 149.0 190.0 (if (< pick 2) 0.9 0.6) (bf-team-color (-> *bf* team)) #t)
    (bf-draw-text buf (bf-tr "<PAD_DPAD_ANY> Choose" "<PAD_DPAD_ANY> Choisir") 70.0 250.0 0.45 (font-color default) #f)
    (bf-draw-text buf (bf-tr "<PAD_X> Deploy" "<PAD_X> Déployer") 70.0 276.0 0.45 (font-color default) #f)
    (bf-draw-zone-marks buf zone)
    (dotimes (i (-> *bf* point-count))
      (let* ((pt (-> *bf* points i))
             (rgba (case (-> pt owner)
                     ((BF_TEAM_FF) (static-rgba 40 110 255 128))
                     ((BF_TEAM_KG) (static-rgba 255 40 40 128))
                     (else (static-rgba 220 220 220 128))
                     )
                   )
             )
        (if (and (= i pick) (< (mod (current-time) (seconds 0.5)) (seconds 0.3)))
            (bf-zone-dot buf zone (-> pt pos) 15 (static-rgba 255 255 255 128))
            )
        (bf-zone-dot buf zone (-> pt pos) (if (= i pick) 11 7) rgba)
        )
      )
    ;; the units awake, live: small dots of their side's color (`*bf-unit-dots*`)
    (dotimes (i (-> *bf-unit-dots* count))
      (bf-zone-dot buf zone (-> *bf-unit-dots* pos i) 3 (if (= (-> *bf-unit-dots* team i) BF_TEAM_FF)
                                                         (static-rgba 90 160 255 128)
                                                         (static-rgba 255 90 90 128)
                                                         )
                   )
      )
    )
  (none)
  )

(defbehavior bf-draw-hud bf-director ()
  "The reserves (`bf-draw-reserves`), the player's kills on the left, the warnings of the fight, the
   countdown of a dead player, and the crosshair. The class's gun and ammo are in the stock gun HUD
   (hud-gun `update-values!` and `draw` above)."
  ;; the dead player picking his respawn point: the zone's map under the page (`bf-draw-respawn-pick`)
  (if (>= (-> *bf* respawn-pick) 0)
      (bf-draw-zone-minimap (-> *bf* zone))
      )
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf2))
    (bf-draw-reserves buf)
    (bf-draw-points-hud buf)
    (if (>= (-> *bf* respawn-pick) 0)
        (bf-draw-respawn-pick buf)
        )
    ;; the player's kills, small, on the left
    (clear *bf-text*)
    (format *bf-text* (bf-tr "Kills: ~D" "Éliminations : ~D") (-> *bf* kills))
    (bf-draw-text buf *bf-text* 14.0 52.0 0.45 (font-color default) #f)
    (if (not (time-elapsed? (-> self field-time) (seconds 1)))
        (bf-draw-text buf (bf-tr "CEILING" "PLAFOND") 0.0 150.0 0.6 (font-color red) #t)
        )
    ;; the player waits to respawn (`bf-target-death`)
    (when (and (nonzero? (-> *bf* respawn-time)) (< (-> *bf* respawn-pick) 0))
      (bf-draw-text buf (bf-tr "YOU WERE KILLED" "VOUS ÊTES MORT") 0.0 250.0 0.8 (font-color red) #t)
      (clear *bf-text*)
      (format *bf-text* (bf-tr "Back in ~D" "Retour dans ~D")
              (+ 1 (max 0 (/ (- (-> *bf* respawn-time) (current-time) 1) (seconds 1))))
              )
      (bf-draw-text buf *bf-text* 0.0 282.0 0.6 (font-color default) #t)
      )
    )
  (if (and *target* (not (focus-test? *target* dead)))
      (bf-draw-reticle)
      )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Battle life cycle (run inside the director's process)
;; ---------------------------------------------------------------------------------------------

(defun bf-city-call ((cmd int))
  "Run CMD on the Haven City side when ctywide is active (its hook then points into the current
   link of battlefront-city.gc)."
  (when (and *bf-city-hook* (= (level-status? *level* 'ctywide #f) 'active))
    (*bf-city-hook* cmd)
    )
  (none)
  )

(defun bf-zone-continue ((zone int) (team int))
  "Spawn continue point of TEAM in ZONE."
  (get-continue-by-name *game-info*
                        (if (= team BF_TEAM_FF) (-> *bf-zones* zone ff-continue) (-> *bf-zones* zone kg-continue))
                        )
  )

(defconstant BF_SPAWN_SHIELD (seconds 3)) ;; invulnerable this long after a deployment or a respawn

(defun bf-spawn-shield ()
  "The player just deployed or respawned: invulnerable for BF_SPAWN_SHIELD (`target-timed-invulnerable`),
   his class model blinking meanwhile (`*bf*` flicker-until, battlefront-player.gc
   `bf-avatar-blink`), then steady."
  (when *target*
    (target-timed-invulnerable BF_SPAWN_SHIELD *target* 1)
    (set! (-> *bf* flicker-until) (+ (-> *display* game-clock frame-counter) BF_SPAWN_SHIELD))
    )
  (none)
  )

(defun bf-refill-ammo ()
  "Loadout of a deployment (the first class page, a class change, a respawn, a restart): a full
   rifle magazine (BF_MAG_RIFLE) and its reserve (BF_RESERVE_RIFLE, Jak's yellow ammo), and the
   grenades (BF_GRENADES, his red ammo). The tazer needs none."
  (set! (-> *game-info* gun-ammo BF_AMMO_YELLOW) BF_RESERVE_RIFLE)
  (set! (-> *game-info* gun-ammo BF_AMMO_RED) BF_GRENADES)
  (bf-refill-mags)
  (none)
  )

(defun bf-spectate-end! ()
  "The dead player's wait (`bf-target-death`) is over or cut short: no countdown, the camera on Jak
   again. The stock death's reset does the same (game-info.gc, `initialize!`)."
  (when (nonzero? (-> *bf* respawn-time))
    (set! (-> *bf* respawn-time) 0)
    (set! (-> *bf* spectate) (the-as handle #f))
    (when *target*
      (send-event *camera* 'change-target *target*)
      (send-event *camera* 'teleport)
      )
    )
  (none)
  )

(defbehavior bf-start-battle! bf-director ((zone int) (team int) (class int))
  "Set up a battle in ZONE, the player on TEAM as CLASS, and send the player there."
  (let ((ff (bf-zone-continue zone BF_TEAM_FF))
        (kg (bf-zone-continue zone BF_TEAM_KG))
        )
    (cond
      ((not (and ff kg))
       (format 0 "battlefront: a continue point of zone ~D is missing~%" zone)
       )
      (else
        (set! (-> *bf* zone) zone)
        (set! (-> *bf* team) team)
        (set! (-> *bf* class) class)
        (set! (-> *bf* weapon) BF_WEAPON_RIFLE)
        (set! (-> *bf* redraw?) #f)
        (set! (-> *bf* shield?) #f)
        (set! (-> *bf* drop-count) 0)
        (set! (-> *bf* winner) BF_TEAM_NONE)
        (set! (-> *bf* kills) 0)
        (set! (-> *bf* combat-time) 0)
        (set! (-> *bf* respawn-at) -1)
        (set! (-> *bf* deaths) 0)
        (set! (-> *bf* redeploy-ok?) #f)
        (set! (-> *bf* tazer-time) 0)
        (dotimes (i BF_TEAM_COUNT)
          (set! (-> *bf* reserve i) BF_RESERVE)
          (set! (-> *bf* losses i) 0)
          )
        ;; the class weapons spend Jak's ammo, the shield's hits his light eco: given back at the end
        (dotimes (i 4)
          (set! (-> *bf* ammo-saved i) (-> *game-info* gun-ammo i))
          )
        (set! (-> *bf* light-saved) (-> *game-info* eco-pill-light))
        ;; dark eco picked up in the battle refills the jetpacks (battlefront-player.gc): none to start;
        ;; no light eco either, so the stock eco gauges of the health HUD stay empty
        (set! (-> *bf* dark-saved) (-> *game-info* eco-pill-dark))
        (set! (-> *game-info* eco-pill-dark) 0.0)
        (set! (-> *game-info* eco-pill-light) 0.0)
        ;; the endless dark eco secret refills Jak's every frame (powerups.gc target-eco-process):
        ;; it would keep the jetpacks full, so it is off during the battle
        (set! (-> *bf* endless-dark?) (logtest? (-> *game-info* secrets) (game-secrets endless-dark)))
        (logclear! (-> *game-info* secrets) (game-secrets endless-dark))
        ;; the endless light eco secret would keep the health HUD's light eco gauge full: off too
        (set! (-> *bf* endless-light?) (logtest? (-> *game-info* secrets) (game-secrets endless-light)))
        (logclear! (-> *game-info* secrets) (game-secrets endless-light))
        ;; every unit is spawned again by the respawn below: no look is taken yet
        (dotimes (i 5)
          (set! (-> *bf-looks* i) 0)
          )
        (vector-copy! (-> *bf* spawn BF_TEAM_FF) (-> ff trans))
        (vector-copy! (-> *bf* spawn BF_TEAM_KG) (-> kg trans))
        ;; the district's middle, and the radius around it that covers its map (battlefront-minimaps.gc):
        ;; the reinforcements search their lanes there
        (let ((texel (-> *bf-zone-minimap-corner* (+ (* 3 zone) 2)))
              (w (the float (-> *bf-zone-minimap-size* (+ (* 3 zone) 2))))
              (h (the float (-> *bf-zone-minimap-size* (+ (* 3 zone) 1))))
              )
          (set-vector! (-> *bf* center)
                       (+ (-> *bf-zone-minimap-corner* (* 3 zone)) (* 0.5 w texel))
                       (* 0.5 (+ (-> ff trans y) (-> kg trans y)))
                       (+ (-> *bf-zone-minimap-corner* (+ (* 3 zone) 1)) (* 0.5 h texel))
                       (* 0.5 texel (sqrtf (+ (* w w) (* h h))))
                       )
          )
        ;; the force field's first safe place: the player's spawn (`bf-keep-in-zone`)
        (let ((own (if (= team BF_TEAM_FF) ff kg)))
          (vector-copy! (-> *bf* safe) (-> own trans))
          (set! (-> *bf* safe-level) (-> own level))
          (set! (-> *bf* safe-time) 0)
          )
        (set! (-> *bf* ceiling) (+ (fmax (-> ff trans y) (-> kg trans y)) BF_CEILING))
        (set! (-> *bf* respawn-time) 0)
        ;; the battle camera looks where Jak faces at his spawn (battlefront-player.gc bf-cam-rig-spawn)
        (set! (-> *bf* view-set?) #f)
        (set! (-> self prepared?) #f)
        (set! (-> self leaving?) #f)
        (set! (-> self want-avatar?) #t)
        ;; the battle's settings, owned by the director
        (remove-setting! 'borrow)
        (remove-setting! 'faction-command)
        (remove-setting! 'exclusive-task)
        (remove-setting! 'pilot)
        (remove-setting! 'airlock)
        (remove-setting! 'disable-parking-spots?)
        (set-setting! 'borrow *bf-borrow* 0.0 0)
        (set-setting! 'faction-command *bf-faction-commands* 0.0 0)
        ;; outside the campaign: only the tasks this setting names stay open (task-control.gc
        ;; game-task-node-info-method-12), and no node has the task none, so no mission or
        ;; activity starts (NPC prompts, burning bushes, task managers, their minimap icons)
        (set-setting! 'exclusive-task #f 0.0 (game-task none))
        ;; no vehicle either: vehicle `check-player-get-on` (vehicle-util.gc) wants this setting on
        (set-setting! 'pilot #f 0.0 0)
        ;; the fight stays in the streets: no door, airlock, warp gate or air train opens
        ;; (airlock.gc want-cross-airlock?, warp-gate.gc), and the parking spots hold no vehicle
        ;; (ctywide-obs.gc parking-spot)
        (set-setting! 'airlock #f 0.0 0)
        (set-setting! 'disable-parking-spots? #t 0.0 0)
        (apply-settings *setting-control*)
        (bf-avatar-kill)
        (bf-set-phase! BF_PHASE_DEPLOY)
        ;; respawn the player at his side's spawn the way a death does (target-death-reset):
        ;; `initialize!` 'life resets every actor and runs each active level's activate function,
        ;; so Haven City's traffic is rebuilt and every unit pool spawned again, now with the
        ;; battle's skins. Rebuilding the traffic on its own in mid-game (ctywide-activate) left
        ;; process records broken: a later level change crashed the game deactivating an airlock.
        (set-continue! *game-info* (if (= team BF_TEAM_FF) ff kg) #f)
        ;; every street section at once (`bf-whole-city-update`): the stock ones out first
        (set! (-> *bf* city-load) BF_LOAD_DRAIN_IN)
        (bf-city-call BF_CITY_FREE_NAVS)
        (initialize! *game-info* 'life (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        )
      )
    )
  (none)
  )

(defun bf-restore-player! ()
  "Give Jak back what the battle set aside: his gun ammo, light and dark eco, and the endless dark
   and light eco secrets."
  (dotimes (i 4)
    (set! (-> *game-info* gun-ammo i) (-> *bf* ammo-saved i))
    )
  (set! (-> *game-info* eco-pill-light) (-> *bf* light-saved))
  (set! (-> *game-info* eco-pill-dark) (-> *bf* dark-saved))
  (if (-> *bf* endless-dark?)
      (logior! (-> *game-info* secrets) (game-secrets endless-dark))
      )
  (if (-> *bf* endless-light?)
      (logior! (-> *game-info* secrets) (game-secrets endless-light))
      )
  (set! (-> *bf* drop-count) 0)
  (none)
  )

(defbehavior bf-end-battle! bf-director ()
  "Undo everything the battle changed and go back to the stock game. While Jak drives, wait: the
   respawn that ends it would take the vehicle from under him."
  (when (and (bf-active?)
             *target*
             (focus-test? *target* pilot)
             (= (level-status? *level* 'ctywide #f) 'active)
             )
    (set! (-> self end-pending?) #t)
    (return #f)
    )
  (set! (-> self end-pending?) #f)
  (bf-spectate-end!)
  (bf-avatar-kill)
  (bf-hud-health-update #f)
  (let ((city? (and (bf-active?) (= (level-status? *level* 'ctywide #f) 'active))))
    (when (bf-active?)
      ;; phase off first: the pools spawned again by the respawn below get the stock skins
      (bf-set-phase! BF_PHASE_OFF)
      ;; the battle's sections out before the game loads its own (`bf-whole-city-update`)
      (if (!= (-> *bf* city-load) BF_LOAD_OFF)
          (set! (-> *bf* city-load) BF_LOAD_DRAIN_OUT)
          )
      (bf-city-call BF_CITY_RESET)
      (bf-restore-player!)
      )
    (remove-setting! 'borrow)
    (remove-setting! 'faction-command)
    (remove-setting! 'exclusive-task)
    (remove-setting! 'pilot)
    (remove-setting! 'airlock)
    (remove-setting! 'disable-parking-spots?)
    (apply-settings *setting-control*)
    ;; respawn at the current continue (the side's spawn) the way a death does: every unit of the
    ;; battle is replaced by a stock one
    (if city?
        (bf-city-call BF_CITY_FREE_NAVS)
        (initialize! *game-info* 'life (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        )
    )
  (bf-set-phase! BF_PHASE_OFF)
  (none)
  )

(defun bf-whole-city-section? ((name symbol))
  "#t when level NAME is one of the street sections a battle loads at once (`*bf-whole-city*`)."
  (let ((l *bf-whole-city*))
    (while (not (null? l))
      (if (= (car l) name)
          (return #t)
          )
      (set! l (cdr l))
      )
    )
  #f
  )

(defun bf-whole-city-chunk ((lev level))
  "`*bf-alloc-hook*` (level.gc `load-begin`): while the battle holds every street section
   (BF_LOAD_WHOLE), the first of the two chunks of the level heap section LEV takes: the first pair
   of 0-1, 2-3, 4-5, 12-13, 14-15 and 16-17 no other level uses (ctywide keeps 6 to 11, its
   borrowed levels inside it). -1 for the stock banks: another level, or no battle."
  (when (and (= (-> *bf* city-load) BF_LOAD_WHOLE) (bf-whole-city-section? (-> lev name)))
    (let ((starts (new 'static 'array int32 6 0 2 4 12 14 16)))
      (dotimes (k 6)
        (let ((mask (ash 3 (-> starts k)))
              (free? #t)
              )
          (dotimes (i 11)
            (let ((other (-> *level* level i)))
              (if (and (!= other lev) (logtest? (-> other memory-mask) mask))
                  (set! free? #f)
                  )
              )
            )
          (when free?
            (format 0 "battlefront: ~A in chunks ~D and ~D~%" (-> lev name) (-> starts k) (+ (-> starts k) 1))
            (return (-> starts k))
            )
          )
        )
      )
    )
  -1
  )

(defun bf-whole-city-set-want ((ls load-state) (i int) (name symbol) (display symbol))
  "Set slot I of the levels LS wants to level NAME, shown as DISPLAY (#f clears the slot)."
  (set! (-> ls want i name) name)
  (set! (-> ls want i display?) display)
  (set! (-> ls want i force-vis?) #f)
  (set! (-> ls want i force-inside?) #f)
  (none)
  )

(defun bf-whole-city-want ((ls load-state))
  "`*bf-want-hook*` (load-state.gc `add-borrow-levels`): while the battle holds the city's levels,
   the levels LS wants become ctywide and the two unit levels (ctypesa, ctypesc) and, once every
   other level is gone (BF_LOAD_WHOLE), every street section displayed: nine of the game's ten
   level slots. The game's own requests (its load boundaries, doors, continue points, ctywide's
   aliases and the cars and citizens they borrow) are left out: with a tenth level wanted,
   `level-get-for-use` (level.gc) evicts a loaded one, a borrowed level whose units still live,
   and the game crashes."
  (when (!= (-> *bf* city-load) BF_LOAD_OFF)
    (dotimes (i 10)
      (bf-whole-city-set-want ls i #f #f)
      )
    (bf-whole-city-set-want ls 0 'ctywide 'display)
    (bf-whole-city-set-want ls 1 'ctypesa 'special)
    (bf-whole-city-set-want ls 2 'ctypesc 'special)
    (when (= (-> *bf* city-load) BF_LOAD_WHOLE)
      (let ((i 3)
            (l *bf-whole-city*)
            )
        (while (not (null? l))
          (bf-whole-city-set-want ls i (the-as symbol (car l)) 'display)
          (+! i 1)
          (set! l (cdr l))
          )
        )
      )
    )
  (none)
  )

(defun bf-whole-city-drained? ()
  "#t when no level but ctywide and the levels it borrows holds a chunk the street sections take
   (0 to 5, 12 to 17)."
  (dotimes (i 10)
    (let ((lev (-> *level* level i)))
      (if (and (!= (-> lev status) 'inactive) (logtest? (-> lev memory-mask) #x3f03f))
          (return #f)
          )
      )
    )
  #t
  )

(defun bf-whole-city-foreign ()
  "The first loaded level a battle over the whole city does not want (ctywide, ctypesa and ctypesc
   are its own until the sections come): a stock section, or a car or citizen level the city
   borrow manager (cty-borrow-manager.gc) keeps until its last traffic object is gone. #f once
   every such level is out."
  (dotimes (i 10)
    (let ((lev (-> *level* level i)))
      (when (and (!= (-> lev status) 'inactive)
                 (not (or (= (-> lev name) 'ctywide) (= (-> lev name) 'ctypesa) (= (-> lev name) 'ctypesc)))
                 )
        (return lev)
        )
      )
    )
  (the-as level #f)
  )

(defun bf-whole-city-loaded? ()
  "#t when every street section (`*bf-whole-city*`) is active."
  (let ((l *bf-whole-city*))
    (while (not (null? l))
      (if (!= (level-status? *level* (the-as symbol (car l)) #f) 'active)
          (return #f)
          )
      (set! l (cdr l))
      )
    )
  #t
  )

(defun bf-whole-city-update ()
  "Every frame, battle or not: a battle's start empties every level but ctywide and the unit levels
   (BF_LOAD_DRAIN_IN, `bf-whole-city-foreign`), then loads every street section (BF_LOAD_WHOLE,
   `bf-whole-city-want`, `bf-whole-city-chunk`); its end empties them (BF_LOAD_DRAIN_OUT), then
   gives the game back its continue point's levels, as a respawn there does (target-death.gc
   target-continue), which it loads in its own banks (a section left in two chunks would leave the
   stock six nowhere: the game stops: level.gc, could not find free bank)."
  (cond
    ((= (-> *bf* city-load) BF_LOAD_DRAIN_IN)
     (let ((lev (bf-whole-city-foreign)))
       (cond
         (lev
           ;; what holds the battle back, every 2 s
           (if (zero? (mod (-> *display* real-clock integral-frame-counter) 120))
               (format 0 "battlefront: waiting for ~A (~A) to unload~%" (-> lev name) (-> lev status))
               )
           )
         (else
           (format 0 "battlefront: every other level gone, loading the whole city~%")
           (set! (-> *bf* city-load) BF_LOAD_WHOLE)
           (add-borrow-levels *load-state*)
           )
         )
       )
     )
    ((= (-> *bf* city-load) BF_LOAD_DRAIN_OUT)
     (when (bf-whole-city-drained?)
       (format 0 "battlefront: battle sections gone, the game's levels back~%")
       (set! (-> *bf* city-load) BF_LOAD_OFF)
       (let ((cont (-> *game-info* current-continue))
             (ls *load-state*)
             )
         (when cont
           (dotimes (i 10)
             (if (< i (-> cont want-count))
                 (bf-whole-city-set-want ls i (-> cont want i name) (-> cont want i display?))
                 (bf-whole-city-set-want ls i #f #f)
                 )
             )
           )
         (add-borrow-levels ls)
         )
       )
     )
    )
  (none)
  )

(set! *bf-alloc-hook* (the-as (function level int) bf-whole-city-chunk))
(set! *bf-want-hook* bf-whole-city-want)

(defbehavior bf-zone-ready? bf-director ()
  "#t once the player stands at his base with its levels (`bf-camp-loaded?`), every street section
   (`bf-whole-city-loaded?`) and the unit levels active. The battle's
   Haven City alias reloads ctywide and its collision: Jak must have stood on real ground (stance,
   not the stale on-surface flag of his continue state) after the first 2 seconds."
  (and *target*
       (let ((cont (bf-camp-continue)))
         (or (not cont) (bf-camp-loaded? cont))
         )
       (not (focus-test? *target* dead))
       (time-elapsed? (-> *bf* phase-time) (seconds 2))
       (logtest? (-> *target* control status) (collide-status on-surface))
       (= (-> *target* state name) 'target-stance)
       (< (-> *game-info* blackout-time) (current-time))
       (= (level-status? *level* 'ctywide #f) 'active)
       (= (level-status? *level* 'ctypesa #f) 'active)
       (= (level-status? *level* 'ctypesc #f) 'active)
       (= (-> *bf* city-load) BF_LOAD_WHOLE)
       (bf-whole-city-loaded?)
       )
  )

(defbehavior bf-force-field-spark bf-director ((pos vector))
  "Sparks of Light Jak's shield at POS, where Jak meets the force field (every 0.15 s at most), and
   its sound every 0.6 s."
  (when (time-elapsed? (-> self field-time) (seconds 0.15))
    (set-time! (-> self field-time))
    (vector-copy! (-> *launch-matrix* trans) pos)
    (if (logtest? (-> group-lightjak-shield-hit flags) (sp-group-flag sp13))
        (part-tracker-spawn part-tracker-subsampler :to self :group group-lightjak-shield-hit)
        (part-tracker-spawn part-tracker :to self :group group-lightjak-shield-hit)
        )
    (when (time-elapsed? (-> self field-sound) (seconds 0.6))
      (set-time! (-> self field-sound))
      (sound-play "shield-hit")
      )
    )
  (none)
  )

(defbehavior bf-keep-in-zone bf-director ()
  "The whole city is the battlefield: no force field holds the player (round 17). As he falls
   BF_FALL_DEPTH below the last place he stood (a hole, or a section that is not loaded), he is put
   back at that place (`*bf*` safe, taken every 0.5 s while he stands), his speed cancelled and the
   game's level of him set back. A jetpack class cannot climb past the ceiling: its thrust fades
   under it (battlefront-player.gc), and 2 m above it, which only a jump carries it to, its rise is
   turned into a fall, with Light Jak's shield sparks."
  (when (and *target* (not (focus-test? *target* dead)))
    (let ((pos (-> *target* control trans)))
      (cond
        ((< (- (-> *bf* safe y) BF_FALL_DEPTH) (-> pos y))
         (when (and (logtest? (-> *target* control status) (collide-status on-surface))
                    (time-elapsed? (-> *bf* safe-time) (seconds 0.5))
                    )
           (vector-copy! (-> *bf* safe) pos)
           (set! (-> *bf* safe-level) (-> *load-state* vis-nick))
           (set-time! (-> *bf* safe-time))
           )
         )
        (else
          (move-to-point! (-> *target* control) (-> *bf* safe))
          (vector-reset! (-> *target* control transv))
          (want-vis-level *load-state* (-> *bf* safe-level))
          )
        )
      (when (and (or (= (-> *bf* class) BF_CLASS_BLUE_JETPACK) (= (-> *bf* class) BF_CLASS_RED_JETPACK))
                 (< (+ (-> *bf* ceiling) (meters 2)) (-> pos y))
                 )
        (set! (-> *target* control transv y) (fmin (-> *target* control transv y) (meters -2)))
        (let ((top (vector-copy! (new 'stack-no-clear 'vector) pos)))
          (+! (-> top y) (meters 2.5))
          (bf-force-field-spark top)
          )
        )
      )
    )
  (none)
  )

(defun bf-want-level ((ls load-state) (name symbol))
  "Want level NAME displayed, in a free slot of LS, unless it is wanted already."
  (let ((wanted? #f))
    (dotimes (i 10)
      (if (= (-> ls want i name) name)
          (set! wanted? #t)
          )
      )
    (dotimes (i 10)
      (when (and (not wanted?) (not (-> ls want i name)))
        (set! wanted? #t)
        (set! (-> ls want i name) name)
        (set! (-> ls want i display?) 'display)
        (set! (-> ls want i force-vis?) #f)
        (set! (-> ls want i force-inside?) #f)
        )
      )
    )
  (none)
  )

(defbehavior bf-respawn-at-point bf-director ()
  "After a far respawn's reset (`bf-target-death`): once Jak stands at the point's continue point,
   its levels in, move him onto the point (`*bf*` respawn-at), with his class's full health, a fresh
   loadout, the spawn shield (`bf-spawn-shield`) and the camera on him; the point is the safe place of a
   fall. The director draws his class again on its own (`want-avatar?`)."
  (when (and (>= (-> *bf* respawn-at) 0)
             *target*
             (not (focus-test? *target* dead))
             (= (-> *target* state name) 'target-stance)
             (logtest? (-> *target* control status) (collide-status on-surface))
             (< (-> *game-info* blackout-time) (current-time))
             )
    (let ((at (-> *bf* points (-> *bf* respawn-at) pos)))
      (format 0 "battlefront: respawned at ~S after the reset~%" (bf-point-name (-> *bf* respawn-at)))
      (set! (-> *bf* respawn-at) -1)
      (move-to-point! (-> *target* control) at)
      (vector-reset! (-> *target* control transv))
      (vector-copy! (-> *bf* safe) at)
      (set! (-> *bf* safe-level) (-> *load-state* vis-nick))
      (set! (-> *bf* safe-time) 0)
      (set! (-> *target* fact health) (bf-class-health (-> *bf* class)))
      (bf-refill-ammo)
      (bf-spawn-shield)
      (send-event *camera* 'teleport)
      )
    )
  (none)
  )

(defbehavior bf-hold-at-spawn bf-director ()
  "During a deployment, keep Jak at his side's spawn until he stands on real ground: the battle's
   `start` drops him there before the collision of the ground is loaded (seen in game: he fell
   through the port and died)."
  (let* ((cont (bf-camp-continue))
         (at (if cont (-> cont trans) (-> *bf* spawn (-> *bf* team))))
         )
    (when (and *target*
               (not (focus-test? *target* dead))
               (not (logtest? (-> *target* control status) (collide-status on-surface)))
               (< (-> *target* control trans y) (+ (-> at y) (meters -1)))
               )
      (move-to-point! (-> *target* control) at)
      (vector-reset! (-> *target* control transv))
      )
    )
  (none)
  )

(defbehavior bf-spawn-drops bf-director ()
  "Spawn the pickups the dead units left (battlefront-h.gc `bf-queue-drop`): the stock ammo, health
   and dark eco pickups, which give Jak ammo and health the stock way. Dark eco comes as 3 pills (6
   units), a full jetpack's worth (battlefront-player.gc BF_DARK_FUEL)."
  (dotimes (i (-> *bf* drop-count))
    (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* drop-pos i))))
      (+! (-> pos y) (meters 1))
      (let ((kind (the-as pickup-type (-> *bf* drop-kind i))))
        (birth-pickup-at-point pos kind (if (= kind (pickup-type eco-pill-dark)) 6.0 1.0) #t *entity-pool* (the-as fact-info #f))
        )
      )
    )
  (set! (-> *bf* drop-count) 0)
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------------------------

;; Black pages: under the battle's pages only the class preview is drawn, on black. The world's
;; renderers are off (the vu1 mask the stock menus set, which drawable.gc copies every frame), and
;; every drawn model other than a `bf-icon` is hidden, its handle kept to show it again.
(deftype bf-black-work (structure)
  ((on?     symbol)
   (count   int32)
   (vu1     vu1-renderer-mask)  ;; the renderers on before
   (hidden  uint64 1024)        ;; handles of the hidden models
   )
  )

(define *bf-black* (new 'static 'bf-black-work))
(set! (-> *bf-black* on?) #f)

(defun bf-black-hide ((proc process))
  "`bf-black-set!` callback: hide PROC's model when it is drawn and not a `bf-icon`, keeping its
   handle. Jak stays drawn while a deployment loads the zone (the game runs under its class page): a
   hidden Jak's bones, and his collision with them, stay where they were, and moved by a respawn
   while hidden he fell through the ground (battlefront-player.gc `bf-target-bones!`). #t: go on
   into its children."
  (when (and (type? proc process-drawable)
             (not (type? proc bf-icon))
             (not (and (= proc *target*) (= (-> *bf* phase) BF_PHASE_DEPLOY)))
             (< (-> *bf-black* count) 1024)
             )
    (let ((draw (-> (the-as process-drawable proc) draw)))
      (when (and draw (nonzero? draw) (not (logtest? (-> draw status) (draw-control-status no-draw))))
        (logior! (-> draw status) (draw-control-status no-draw))
        (set! (-> *bf-black* hidden (-> *bf-black* count)) (the-as uint64 (process->handle proc)))
        (+! (-> *bf-black* count) 1)
        )
      )
    )
  #t
  )

(defun bf-black-set! ((on? symbol))
  "Black pages on (ON?) or off (`*bf-black*`). On: only the foreground renderers, which draw the
   preview, and the models hidden. Off: the renderers and the models back."
  (when (!= on? (-> *bf-black* on?))
    (set! (-> *bf-black* on?) on?)
    (cond
      (on?
        (set! (-> *bf-black* vu1) (-> *display* vu1-enable-user-menu))
        (set! (-> *display* vu1-enable-user-menu) (vu1-renderer-mask generic merc emerc))
        (set! (-> *bf-black* count) 0)
        (iterate-process-tree *active-pool* (the-as (function object object) bf-black-hide) *kernel-context*)
        )
      (else
        (set! (-> *display* vu1-enable-user-menu) (-> *bf-black* vu1))
        (dotimes (i (-> *bf-black* count))
          (let ((proc (handle->process (the-as handle (-> *bf-black* hidden i)))))
            (if proc
                (logclear! (-> (the-as process-drawable proc) draw status) (draw-control-status no-draw))
                )
            )
          )
        (set! (-> *bf-black* count) 0)
        )
      )
    )
  (none)
  )

(defbehavior bf-show-page bf-director ((page int))
  "Show PAGE, black under it (`bf-black-set!`), the game left running. Like popup-menu, the flag
   keeps the Mods menu from opening over the page; while the game runs, the director's settings
   keep the pause and START menus closed."
  (set! (-> self page) page)
  (set! (-> self cursor) 0)
  (bf-black-set! #t)
  (true! *popup-menu-open*)
  (when (not (-> self menu-mode?))
    (set-setting! 'allow-pause #f 0.0 0)
    (set-setting! 'allow-progress #f 0.0 0)
    )
  (none)
  )

(defbehavior bf-pause-page bf-director ()
  "Pause the game under the open page: the 'menu master mode, held by the director. With
   `*popup-menu-open*` the pause buttons (toggle-pause) leave 'menu alone."
  (when (not (-> self menu-mode?))
    (set-master-mode 'menu)
    (set! (-> self menu-mode?) #t)
    )
  (none)
  )

(defbehavior bf-open-page bf-director ((page int))
  "Show PAGE, black under it, and pause the game."
  (bf-show-page page)
  (bf-pause-page)
  (none)
  )

(defbehavior bf-close-page bf-director ()
  "Hide the menu, show the world again and resume the game."
  (set! (-> self page) BF_PAGE_NONE)
  (bf-preview-update)
  (bf-black-set! #f)
  (false! *popup-menu-open*)
  (remove-setting! 'allow-pause)
  (remove-setting! 'allow-progress)
  (when (-> self menu-mode?)
    (set-master-mode 'game)
    (set! (-> self menu-mode?) #f)
    )
  (none)
  )

(defbehavior bf-open-class-page bf-director ((refill? symbol) (pause? symbol))
  "The class page of the player's side, the cursor on his class; REFILL? when it deploys him.
   PAUSE? pauses the game under it; a deployment's page leaves it running while the zone loads,
   and `bf-deploy-update` pauses it once Jak stands there."
  (set! (-> self refill?) refill?)
  (set! (-> self pick-team) (-> *bf* team))
  ;; the preview shows the guards with their rifle, the weapon a class starts with
  (set! (-> *bf* weapon) BF_WEAPON_RIFLE)
  (bf-show-page BF_PAGE_CLASS)
  (if pause?
      (bf-pause-page)
      )
  (set! (-> self cursor) (- (-> *bf* class) (* 4 (-> *bf* team))))
  (none)
  )

(defbehavior bf-menu-confirm bf-director ()
  "X on the open page."
  (let ((page (-> self page))
        (i (-> self cursor))
        )
    (cond
      ((and (= page BF_PAGE_ZONE) (>= i BF_ZONE_COUNT))
       ;; Spargus, to come: refused
       (sound-play "menu-back")
       (return #f)
       )
      ((= page BF_PAGE_ZONE)
       (set! (-> self pick-zone) i)
       (bf-open-page BF_PAGE_TEAM)
       )
      ((= page BF_PAGE_TEAM)
       (set! (-> self pick-team) i)
       (bf-close-page)
       ;; the deployment starts, and the class page right away, the game running under it: the
       ;; class models (and their preview) are in the unit levels the deployment loads
       ;; (`bf-deploy-update`)
       (bf-start-battle! (-> self pick-zone) i (* i 4))
       (if (bf-active?)
           (bf-open-class-page #t #f)
           )
       )
      ((and (= page BF_PAGE_CLASS) (= (-> *bf* phase) BF_PHASE_DEPLOY))
       ;; the zone still loads: the choice waits for it (the page says so)
       (return #f)
       )
      ((= page BF_PAGE_CLASS)
       (bf-close-page)
       (set! (-> *bf* class) (+ (* (-> self pick-team) 4) i))
       (set! (-> *bf* weapon) BF_WEAPON_RIFLE)
       (if (-> self refill?)
           (bf-refill-ammo)
           )
       ;; the new class's full health on the battle's 24 point scale
       (if *target*
           (set! (-> *target* fact health) (bf-class-health (-> *bf* class)))
           )
       (set! (-> self refill?) #f)
       (set! (-> self want-avatar?) #t)
       (bf-avatar-kill)
       (bf-spawn-shield)
       )
      ((= page BF_PAGE_RESULT)
       (bf-close-page)
       (bf-end-battle!)
       )
      )
    )
  (sound-play "menu-pick")
  (none)
  )

(defbehavior bf-menu-back bf-director ()
  "Circle on the open page. The class page needs a class: the battle has started."
  (let ((page (-> self page)))
    (cond
      ((= page BF_PAGE_ZONE)
       (bf-close-page)
       )
      ((= page BF_PAGE_TEAM)
       (bf-open-page BF_PAGE_ZONE)
       (set! (-> self cursor) (-> self pick-zone))
       )
      )
    )
  (sound-play "menu-pick")
  (none)
  )

(defbehavior bf-menu-update bf-director ()
  "Input and drawing of the open page."
  (let ((count (bf-page-count (-> self page))))
    (cond
      ((cpad-pressed? 0 up)
       (set! (-> self cursor) (if (> (-> self cursor) 0) (+ (-> self cursor) -1) (+ count -1)))
       (sound-play "menu-pick")
       )
      ((cpad-pressed? 0 down)
       (set! (-> self cursor) (if (< (-> self cursor) (+ count -1)) (+ (-> self cursor) 1) 0))
       (sound-play "menu-pick")
       )
      ((cpad-pressed? 0 x)
       (bf-menu-confirm)
       )
      ((cpad-pressed? 0 circle triangle)
       (bf-menu-back)
       )
      )
    )
  (when (!= (-> self page) BF_PAGE_NONE)
    (bf-preview-update)
    (bf-draw-page)
    (if (or (and (= (-> self page) BF_PAGE_ZONE) (< (-> self cursor) BF_ZONE_COUNT)) (= (-> self page) BF_PAGE_TEAM))
        (bf-draw-zone-minimap (if (= (-> self page) BF_PAGE_ZONE) (-> self cursor) (-> self pick-zone)))
        )
    )
  (none)
  )

(defbehavior bf-deploy-update bf-director ()
  "One frame of a deployment: Jak held at his spawn (`bf-hold-at-spawn`), and once the zone is
   ready (`bf-zone-ready?`) the fight starts. Its class page opened at once, the game running under
   it: each frame the models the reset spawns meanwhile are hidden too, and once the fight starts
   the game pauses under the page, every model hidden, Jak with them. Past BF_DEPLOY_TIMEOUT the
   battle is cancelled."
  (bf-hold-at-spawn)
  (if (-> *bf-black* on?)
      (iterate-process-tree *active-pool* (the-as (function object object) bf-black-hide) *kernel-context*)
      )
  (cond
    ((bf-zone-ready?)
     (when (not (-> self prepared?))
       ;; the bases and the control points; the Haven City side moves the latter onto the streets
       (bf-points-setup)
       (bf-city-call BF_CITY_PREPARE)
       (set! (-> self prepared?) #t)
       )
     (bf-set-phase! BF_PHASE_FIGHT)
     (when (= (-> self page) BF_PAGE_CLASS)
       (iterate-process-tree *active-pool* (the-as (function object object) bf-black-hide) *kernel-context*)
       (bf-pause-page)
       )
     )
    ((time-elapsed? (-> *bf* phase-time) BF_DEPLOY_TIMEOUT)
     (format 0 "battlefront: the war zone did not load, battle cancelled~%")
     (if (!= (-> self page) BF_PAGE_NONE)
         (bf-close-page)
         )
     (bf-end-battle!)
     )
    )
  (none)
  )

(defbehavior bf-restart-battle! bf-director ()
  "START > Options > Gamemode > Battlefront > Restart the battle: the same zone, side and class from
   full reserves, at the side's spawn, with a fresh loadout. What the battle set aside goes back to
   Jak first, so that `bf-start-battle!` sets Jak's own aside again."
  (when (bf-active?)
    (let ((zone (-> *bf* zone))
          (team (-> *bf* team))
          (class (-> *bf* class))
          )
      (bf-close-page)
      (bf-spectate-end!)
      (bf-restore-player!)
      (bf-start-battle! zone team class)
      (when (bf-active?)
        (bf-refill-ammo)
        (if *target*
            (set! (-> *target* fact health) (bf-class-health class))
            )
        )
      )
    )
  (none)
  )

(defbehavior bf-leave-to-save! bf-director ()
  "The mode was switched off in the Mods menu during a battle: load the last save, the slot the game
   last loaded or saved (`*game-info*` auto-save-which, kept by the auto-save process's `done`,
   game-save.gc), as the START menu's Load Game does (progress.gc). The load's reset ends the battle
   (`initialize!` below). With no save loaded or made since the boot, end the battle at the side's
   spawn."
  (set! (-> self leaving?) #t)
  (cond
    ((-> *setting-control* user-default auto-save)
     (bf-spectate-end!)
     (auto-save-command 'restore 0 (-> *game-info* auto-save-which) self #f)
     )
    (else
      (bf-end-battle!)
      )
    )
  (none)
  )

(defun bf-can-open-menu? ()
  "No other menu is up and nothing is loading in a blackout."
  (and (not *popup-menu-open*)
       (< (-> *game-info* blackout-time) (current-time))
       (= *master-mode* 'game)
       )
  )

;; ---------------------------------------------------------------------------------------------
;; Director
;; ---------------------------------------------------------------------------------------------

(defbehavior bf-director-update bf-director ()
  "One frame of the battle."
  ;; requests of the START menu's battle page (`bf-menu-request`), run once that menu is closed
  (let ((req *bf-request*))
    (cond
      ((= req BF_REQ_END)
       (set! *bf-request* BF_REQ_NONE)
       (bf-close-page)
       (bf-end-battle!)
       )
      ((and (= req BF_REQ_LOBBY) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       (if (not (bf-active?))
           (bf-open-page BF_PAGE_ZONE)
           )
       )
      ((and (= req BF_REQ_RESTART) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       (bf-restart-battle!)
       )
      ((and (= req BF_REQ_CLASS) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       (if (bf-fighting?)
           (bf-open-class-page #f #t)
           )
       )
      ((and (= req BF_REQ_REDEPLOY) (bf-can-open-menu?))
       (set! *bf-request* BF_REQ_NONE)
       ;; the respawn page without a death (`bf-target-death`'s 'bf-redeploy mode)
       (when (bf-can-redeploy?)
         (format 0 "battlefront: redeploy~%")
         (send-event *target* 'change-state target-death 'bf-redeploy)
         )
       )
      )
    )
  ;; the mode switched off in the Mods menu during a battle: back to the last save, once that menu
  ;; is closed
  (when (and (not *mod-battlefront-enable*) (bf-active?) (not (-> self leaving?)))
    (if (!= (-> self page) BF_PAGE_NONE)
        (bf-close-page)
        )
    (if (bf-can-open-menu?)
        (bf-leave-to-save!)
        )
    )
  (when (and (-> self end-pending?) (not (and *target* (focus-test? *target* pilot))))
    (bf-end-battle!)
    )
  ;; the battle's hold on the city's sections, battle or not (its end drains them)
  (bf-whole-city-update)
  ;; the looks the pools give their new units follow the live counts (battlefront-h.gc)
  (if (bf-active?)
      (bf-count-looks!)
      )
  (cond
    ((!= (-> self page) BF_PAGE_NONE)
     ;; the open page owns the frame; a deployment's class page is up while the zone loads
     (bf-menu-update)
     (if (= (-> *bf* phase) BF_PHASE_DEPLOY)
         (bf-deploy-update)
         )
     )
    ((= (-> *bf* phase) BF_PHASE_DEPLOY)
     (bf-deploy-update)
     )
    ((= (-> *bf* phase) BF_PHASE_FIGHT)
     (cond
       ((!= (level-status? *level* 'ctywide #f) 'active)
        ;; Haven City is gone (a warp, a cutscene): the battle cannot go on
        (when (< (-> *game-info* blackout-time) (current-time))
          (format 0 "battlefront: Haven City unloaded, battle cancelled~%")
          (bf-end-battle!)
          )
        )
       (else
         (bf-city-call BF_CITY_UPDATE)
         (bf-update-points)
         (bf-draw-points)
         ;; a red guard changed between its two models (battlefront-player.gc bf-avatar-pick-weapon)
         (when (-> *bf* redraw?)
           (set! (-> *bf* redraw?) #f)
           (bf-avatar-kill)
           (set! (-> self want-avatar?) #t)
           )
         (when (and *target* (not (focus-test? *target* dead)) (< (-> *game-info* blackout-time) (current-time)))
           (cond
             ((and (-> self want-avatar?) (bf-avatar-spawn (-> *bf* class)))
              (set! (-> self want-avatar?) #f)
              )
             ((and (!= (-> *bf* class) BF_CLASS_JAK) (not (-> self want-avatar?)) (not (bf-avatar-alive?)))
              ;; the avatar went with its level or a reset: draw it again
              (set! (-> self want-avatar?) #t)
              )
             )
           (bf-respawn-at-point)
           (set! (-> *bf* redeploy-ok?) (bf-can-redeploy?))
           (bf-keep-in-zone)
           (bf-spawn-drops)
           )
         (bf-hud-health-update #t)
         (bf-draw-hud)
         )
       )
     )
    ((= (-> *bf* phase) BF_PHASE_OVER)
     (when (bf-can-open-menu?)
       (bf-avatar-kill)
       (bf-hud-health-update #f)
       (bf-open-page BF_PAGE_RESULT)
       )
     )
    )
  (none)
  )

(defstate idle (bf-director)
  :virtual #t
  :trans (behavior ()
    (bf-director-update)
    )
  :code sleep-code
  )

(defbehavior bf-director-init-by-other bf-director ()
  "The director runs while the game is paused under its menu (menu and pause masks cleared)."
  (process-mask-clear! (-> self mask) menu pause)
  (set! (-> self page) BF_PAGE_NONE)
  (set! (-> self cursor) 0)
  (set! (-> self pick-zone) 0)
  (set! (-> self pick-team) BF_TEAM_FF)
  (set! (-> self menu-mode?) #f)
  (set! (-> self want-avatar?) #f)
  (set! (-> self refill?) #f)
  (set! (-> self prepared?) #f)
  (set! (-> self end-pending?) #f)
  (set! (-> self leaving?) #f)
  (set! (-> self preview) (the-as handle #f))
  (set! (-> self hud-time) 0)
  (set! (-> self field-time) 0)
  (set! (-> self field-sound) 0)
  (go-virtual idle)
  )

(defun bf-director-ensure! ()
  "Spawn the director once."
  (when (not (handle->process (-> *bf* director)))
    (set! (-> *bf* director)
          (ppointer->handle (process-spawn bf-director :name "bf-director" :from *pc-dead-pool* :to *pc-pool*))
          )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Player death and hits
;; ---------------------------------------------------------------------------------------------

;; Stock attack handler of the player, kept the same way.
(define-perm *bf-stock-target-attacked*
             (function symbol attack-info process touching-shapes-entry (state symbol attack-info target) object :behavior target)
             target-attacked
             )

(defbehavior target-attacked target ((arg0 symbol)
                                     (arg1 attack-info)
                                     (arg2 process)
                                     (arg3 touching-shapes-entry)
                                     (arg4 (state symbol attack-info target))
                                     )
  "Every attack on the player goes through here. During a fight with the class model up: an attack
   from the player's own side is ignored (no damage, no hit reaction: returns #f); any other takes
   its points on the battle's 24 point scale (battlefront-h.gc `bf-attack-damage`, from its sender
   and its attacker) off Jak's health, his whole bar standing for 24 points (`bf-class-health`);
   one the battle does not know keeps its own damage (Jak's health-single-inc when it names none).
   While the robotguard's shield is up, Jak's shield level stops every attack, shot, blast or blow
   (set for each attack, then the stock handler runs)."
  (let ((ignore? #f))
    (when (and (bf-fighting?) (bf-avatar-alive?))
      (let* ((owner (find-offending-process-focusable arg2 arg1))
             (dmg (bf-attack-damage arg2 owner))
             )
        (cond
          ((and owner (!= owner self) (= (bf-unit-team owner) (-> *bf* team)))
           (set! ignore? #t)
           )
          ((<= 0.0 dmg)
           (set! (-> arg1 damage) (* dmg (/ (-> self fact health-max) 24.0)))
           (logior! (-> arg1 mask) (attack-mask damage))
           )
          )
        ;; a hit taken: in combat (redeploying waits BF_REDEPLOY_CALM)
        (if (not ignore?)
            (bf-combat!)
            )
        )
      )
    (set! (-> self fact shield-level) (if (-> *bf* shield?) 1.0 0.0))
    (if ignore?
        #f
        (*bf-stock-target-attacked* arg0 arg1 arg2 arg3 arg4)
        )
    )
  )

(defun bf-ally? ((proc process) (team int))
  "#t when PROC is a living unit of side TEAM other than the player."
  (and proc
       (!= proc *target*)
       (type? proc process-focusable)
       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
       (= (bf-unit-team proc) team)
       )
  )

(defun bf-spectate-pick ((from vector))
  "The living unit of the player's side nearest to FROM within 150 m, #f for none."
  (let ((probe (new 'stack-no-clear 'vector))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (best (the-as process-focusable #f))
        (best-dist (meters 150))
        )
    (vector-copy! probe from)
    (set! (-> probe w) (meters 150))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (bf-ally? proc (-> *bf* team))
              (let ((dist (vector-vector-distance (-> (the-as process-focusable proc) root trans) from)))
                (when (< dist best-dist)
                  (set! best-dist dist)
                  (set! best (the-as process-focusable proc))
                  )
                )
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-spectate-follow ((from vector))
  "While the player waits to respawn: keep the camera on a living unit of his side, the one it
   follows or, once that one dies or goes, the nearest to FROM (`bf-spectate-pick`). The camera's
   'change-target focuses it on any process-focusable (cam-master.gc, as camera-look-at does)."
  (when (not (bf-ally? (handle->process (-> *bf* spectate)) (-> *bf* team)))
    (let ((next (bf-spectate-pick from)))
      (when next
        (set! (-> *bf* spectate) (process->handle next))
        (send-event *camera* 'change-target next)
        (send-event *camera* 'teleport)
        )
      )
    )
  (none)
  )

(defun bf-camp-continue ()
  "The continue point the player deploys at: the one of the point a far respawn takes him to
   (`*bf*` respawn-at, `*bf-point-defs*`), else his camp's in the battle's zone (`*bf-zones*`); #f
   for none."
  (get-continue-by-name *game-info* (cond
                                      ((>= (-> *bf* respawn-at) 0)
                                       (-> *bf-point-defs* (-> *bf* respawn-at) continue)
                                       )
                                      ((= (-> *bf* team) BF_TEAM_FF)
                                       (-> *bf-zones* (-> *bf* zone) ff-continue)
                                       )
                                      (else
                                        (-> *bf-zones* (-> *bf* zone) kg-continue)
                                        )
                                      )
                        )
  )

(defun bf-camp-level? ((cont continue-point) (i int))
  "#t when entry I of continue point CONT's level list is a city section or an interior it shows
   (not the Haven City base: the battle loads its own alias of ctywide)."
  (let ((name (-> cont want i name)))
    (and name (-> cont want i display?) (not (string-prefix= "ctywide" (symbol->string name))))
    )
  )

(defun bf-want-camp-levels ((cont continue-point))
  "Want the levels continue point CONT lists, as a respawn there does (target-death.gc
   target-continue): its sections in place of the ones wanted now (Haven City holds two at most),
   the game's level of the player set to CONT's, then the borrowed levels added again. A camp at a
   district's edge stands on the next section's ground (the Port's war zone, on ctyinda's), which
   the game loads only near it."
  (let ((ls *load-state*))
    (dotimes (i 10)
      (let ((name (-> ls want i name)))
        (when (and name (not (string-prefix= "ctywide" (symbol->string name))))
          (set! (-> ls want i name) #f)
          (set! (-> ls want i display?) #f)
          (set! (-> ls want i force-vis?) #f)
          (set! (-> ls want i force-inside?) #f)
          )
        )
      )
    (dotimes (i (-> cont want-count))
      (if (bf-camp-level? cont i)
          (bf-want-level ls (-> cont want i name))
          )
      )
    (let ((info (lookup-level-info (-> cont vis-nick))))
      (if info
          (set! (-> ls vis-nick) (-> info name))
          )
      )
    (add-borrow-levels ls)
    )
  (none)
  )

(defun bf-camp-loaded? ((cont continue-point))
  "#t once every level continue point CONT lists (`bf-camp-level?`) is active."
  (let ((loaded? #t))
    (dotimes (i (-> cont want-count))
      (if (and (bf-camp-level? cont i) (!= (level-status? *level* (-> cont want i name) #f) 'active))
          (set! loaded? #f)
          )
      )
    loaded?
    )
  )

(defbehavior bf-target-death target ((mode symbol))
  "Jak's death during a fight, in place of the stock one (`target-death` below): his side loses a
   unit and his class model goes; for BF_RESPAWN_TIME the camera follows a living unit of his side
   (`bf-spectate-follow`) while the HUD counts down (`bf-draw-hud`); then he picks his respawn point
   on the city's map, his side's base or a control point it holds (`bf-draw-respawn-pick`), and is
   back there once its levels are loaded, facing the battlefield, alive, full health, with a fresh
   loadout and three seconds of invulnerability, his class model blinking (`bf-spawn-shield`), and the director draws his class again. MODE
   'bf-redeploy (the START menu's Redeploy, out of combat for BF_REDEPLOY_CALM): no loss and no
   wait, the respawn page at once. The world runs on meanwhile. The stock death freezes the
   enemies (a 'process-mask setting), may play a death movie, and its reset ('life, `initialize!`)
   spawned every unit of Haven City again: the battle's units vanished and came back at each death.
   First it sets what the stock death sets that the game reads: Jak dead (units leave him alone),
   his attacks off, his gun away."
  (set! (-> self neck flex-blend) 0.0)
  (target-timed-invulnerable-off self 0)
  (logior! (-> self focus-status) (focus-status dead))
  (logior! (-> self target-flags) (target-flags disable-attacks))
  (if (using-gun? self)
      (target-gun-end-mode #f)
      )
  (set! (-> self control mod-surface) *neutral-mods*)
  (vector-reset! (-> self control transv))
  (when (!= mode 'bf-redeploy)
    (bf-count-loss (-> *bf* team))
    (+! (-> *bf* deaths) 1)
    )
  (set! (-> *bf* redeploy-ok?) #f)
  (bf-avatar-kill)
  (set! (-> *bf* respawn-time) (+ (current-time) (if (= mode 'bf-redeploy) 0 BF_RESPAWN_TIME)))
  (set! (-> *bf* spectate) (the-as handle #f))
  (let ((dir (the-as bf-director (handle->process (-> *bf* director)))))
    (if dir
        (set! (-> dir want-avatar?) #t)
        )
    )
  ;; the camera further back and higher than behind Jak: the units stand up to twice his height,
  ;; and with the stock string a guard filled the screen (seen in game)
  (set-setting! 'string-min-length 'abs (meters 10) 0)
  (set-setting! 'string-max-length 'abs (meters 14) 0)
  (set-setting! 'string-min-height 'abs (meters 4) 0)
  (set-setting! 'string-max-height 'abs (meters 6) 0)
  ;; the wait; a death that ends the battle cuts it short, for the result page
  (while (and (bf-fighting?) (< (current-time) (-> *bf* respawn-time)))
    (logior! (-> self draw status) (draw-control-status no-draw))
    (bf-spectate-follow (-> self control trans))
    (suspend)
    )
  ;; the respawn point: his side's base, or a control point it holds, picked on the city's map at
  ;; every death (`bf-draw-respawn-pick`: D-pad, then X) while the battle goes on
  (set! (-> *bf* respawn-pick) (-> *bf* team))
  (when (bf-fighting?)
    (cpad-clear! 0 confirm)
    (until (or (not (bf-fighting?)) (cpad-pressed? 0 confirm))
      (logior! (-> self draw status) (draw-control-status no-draw))
      (bf-spectate-follow (-> self control trans))
      (cond
        ((or (cpad-pressed? 0 right) (cpad-pressed? 0 down))
         (set! (-> *bf* respawn-pick) (bf-next-held-point (-> *bf* respawn-pick) (-> *bf* team) 1))
         )
        ((or (cpad-pressed? 0 left) (cpad-pressed? 0 up))
         (set! (-> *bf* respawn-pick) (bf-next-held-point (-> *bf* respawn-pick) (-> *bf* team) -1))
         )
        )
      (suspend)
      )
    (cpad-clear! 0 confirm)
    )
  (let ((pick (-> *bf* respawn-pick)))
    (set! (-> *bf* respawn-pick) -1)
    ;; a point lost meanwhile: the base
    (if (not (bf-point-held? pick (-> *bf* team)))
        (set! pick (-> *bf* team))
        )
    (let ((at (-> *bf* points pick pos))
          (cont (get-continue-by-name *game-info* (-> *bf-point-defs* pick continue)))
          )
      (when (and cont (not (bf-camp-loaded? cont)))
        ;; far, its sections not loaded: the stock way, a reset at the point's continue point
        ;; (`initialize!` 'life, as the battle's start and the stock death do), then the director
        ;; brings him onto the point (`bf-respawn-at-point`). Moving him there and wanting its
        ;; levels instead unloaded the section that held the borrowed unit levels: every unit's
        ;; process went, the traffic spawned its pools again over them, the engine's default nav
        ;; mesh ran out of its 128 nav-controls and a new guard's setup crashed the game (nav-enemy
        ;; setup-enemy!).
        (remove-setting! 'string-min-length)
        (remove-setting! 'string-max-length)
        (remove-setting! 'string-min-height)
        (remove-setting! 'string-max-height)
        (bf-spectate-end!)
        (set! (-> *bf* respawn-at) pick)
        (format 0 "battlefront: respawn at ~S through a reset at ~S~%" (bf-point-name pick) (-> cont name))
        ;; as the battle's start does: its ships down and the stock hatred (the Haven City side's
        ;; reset), then the deployment, the traffic waking its units the stock way while Jak waits
        ;; for the levels (`bf-deploy-update`; its points kept: they are set up once a battle)
        (bf-city-call BF_CITY_RESET)
        (bf-set-phase! BF_PHASE_DEPLOY)
        (set-continue! *game-info* cont #f)
        (vector-reset! (-> self control transv))
        (bf-city-call BF_CITY_FREE_NAVS)
        (initialize! *game-info* 'life (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        (sleep-code)
        )
      ;; near, its sections loaded: there at once, the levels left as they are; the point is the
      ;; safe place of a fall (`bf-keep-in-zone`), not where he died
      (move-to-point! (-> self control) at)
      (vector-reset! (-> self control transv))
      (if cont
          (set! (-> *bf* safe-level) (-> cont level))
          )
      (vector-copy! (-> *bf* safe) at)
      (set! (-> *bf* safe-time) 0)
      (format 0 "battlefront: respawned at ~S~%" (bf-point-name pick))
      )
    )
  (remove-setting! 'string-min-length)
  (remove-setting! 'string-max-length)
  (remove-setting! 'string-min-height)
  (remove-setting! 'string-max-height)
  ;; the class's full health on the battle's 24 point scale (the spider robot half Jak's bar)
  (set! (-> self fact health) (bf-class-health (-> *bf* class)))
  (bf-refill-ammo)
  (bf-spectate-end!)
  ;; facing the battlefield's center, the camera 6 m behind him: it came back on him from wherever
  ;; it followed the unit, in front of him at times (seen in game)
  (let ((dir (vector-! (new 'stack-no-clear 'vector) (-> *bf* center) (-> self control trans)))
        (cam (new 'stack-no-clear 'vector))
        )
    (set! (-> dir y) 0.0)
    (when (< (meters 1) (vector-length dir))
      (vector-normalize! dir 1.0)
      ;; the battle camera, back with the class model, looks there too (battlefront-player.gc bf-cam-rig)
      (set! (-> *bf* view-yaw) (vector-y-angle dir))
      (set! (-> *bf* view-pitch) 0.0)
      (set! (-> *bf* view-set?) #t)
      (forward-up->quaternion (-> self control quat-for-control) dir *y-vector*)
      (quaternion-copy! (-> self control quat) (-> self control quat-for-control))
      (quaternion-copy! (-> self control dir-targ) (-> self control quat))
      (vector+float*! cam (-> self control trans) dir (meters -6))
      (+! (-> cam y) (meters 3))
      (send-event *camera* 'teleport-to-vector-start-string cam)
      )
    )
  (bf-spawn-shield)
  (go target-stance)
  (none)
  )

;; The stock death's code, kept across REPL reloads of this file (Lisp wiki jak3 4.10).
(define-perm *bf-stock-death-code* function (-> target-death code))

(defbehavior bf-target-death-code target ((mode symbol))
  "Code of Jak's `target-death` state (target-death.gc): `bf-target-death` during a fight, the stock
   death otherwise."
  (if (bf-fighting?)
      (bf-target-death mode)
      ((the-as (function symbol none :behavior target) *bf-stock-death-code*) mode)
      )
  (none)
  )

(set! (-> target-death code) bf-target-death-code)

;; ---------------------------------------------------------------------------------------------
;; Outside the campaign: no save during a battle, and a load ends it
;; ---------------------------------------------------------------------------------------------

(defun bf-locked-option? ((name text-id))
  "#t for the START menu ring's options a battle shuts: Save, Load Game (a load would end the battle
   in the middle of the menu) and Secrets (cheats that change the fight)."
  (or (= name (text-id progress-save-game)) (= name (text-id progress-load-save)) (= name (text-id progress-secrets)))
  )

(define-perm *bf-stock-main-respond* (function menu-main-menu-option progress symbol int)
             (method-of-type menu-main-menu-option respond-progress)
             )

(defmethod respond-progress ((this menu-main-menu-option) (arg0 progress) (arg1 symbol))
  "START menu ring, an option's input. During a battle, X on Save, Load Game or Secrets
   (`bf-locked-option?`) is refused with the stock refusal beep (progress.gc, a hero mode save on
   the autosave slot); the rest is the stock handling."
  (cond
    ((and (bf-active?) (bf-locked-option? (-> this name)) (cpad-pressed? 0 confirm))
     (cpad-clear! 0 confirm)
     (sound-play "generic-beep" :pitch -0.6)
     0
     )
    (else
      (*bf-stock-main-respond* this arg0 arg1)
      )
    )
  )

(define-perm *bf-stock-main-draw* (function menu-main-menu-option progress font-context int symbol none)
             (method-of-type menu-main-menu-option draw-option)
             )

(defmethod draw-option ((this menu-main-menu-option) (arg0 progress) (fnt font-context) (arg2 int) (arg3 symbol))
  "START menu ring, the selected option's name. During a battle Save, Load Game and Secrets
   (`bf-locked-option?`) are drawn grey, the color of the PC menus' disabled options (progress-generic-draw-pc.gc); the rest is the stock drawing. The
   grey label is the stock one (progress-draw-pc.gc), its color aside."
  (cond
    ((and (bf-active?)
          (bf-locked-option? (-> this name))
          (= arg2 (-> arg0 option-index))
          )
     (set-scale! fnt 0.75)
     (set-color! fnt (font-color font-color-44))
     (set-alpha! fnt (- 1.0 (-> arg0 menu-transition)))
     (set-flags! fnt (font-flags shadow kerning middle large))
     (set-width! fnt (if (= (get-aspect-ratio) 'aspect4x3) 235 175))
     (set-height! fnt 80)
     (set! (-> fnt origin x) (the float (if (= (get-aspect-ratio) 'aspect4x3) 140 170)))
     (set! (-> fnt origin y) (the float (if (= (get-aspect-ratio) 'aspect4x3) 180 175)))
     (when (not (-> *pc-settings* use-vis?))
       (set! (-> fnt origin x) (the float (adjust-game-x (-> fnt origin x))))
       (*! (-> fnt width) (-> *pc-settings* aspect-ratio-reciprocal))
       )
     (print-game-text (lookup-text! *common-text* (-> this name) #f) fnt #f 44 (bucket-id hud-draw-hud-alpha))
     )
    (else
      (*bf-stock-main-draw* this arg0 fnt arg2 arg3)
      )
    )
  (none)
  )

(defun bf-stop-now! ()
  "A loaded save, a new game or the title ends the battle at once, from inside the game's reset
   (`initialize!` below): the avatar and the Haven City side go, Jak gets back what the battle set
   aside, the mode is switched off, and the director goes with every setting it owns (the battle's
   alias levels, faction commands and closed tasks). The reset then sets the game from the save."
  (bf-avatar-kill)
  (when (bf-active?)
    (bf-set-phase! BF_PHASE_OFF)
    (bf-city-call BF_CITY_RESET)
    (bf-restore-player!)
    )
  (set! *mod-battlefront-enable* #f)
  (set! *bf-request* BF_REQ_NONE)
  (bf-black-set! #f)
  (let ((director (handle->process (-> *bf* director))))
    (if director
        (deactivate director)
        )
    )
  (set! (-> *bf* director) (the-as handle #f))
  (set! (-> *bf* respawn-time) 0)
  (set! (-> *bf* spectate) (the-as handle #f))
  (none)
  )

(define-perm *bf-stock-initialize* (function game-info symbol game-save string resetter-spec game-info)
             (method-of-type game-info initialize!)
             )

(defmethod initialize! ((this game-info) (arg0 symbol) (arg1 game-save) (arg2 string) (arg3 resetter-spec))
  "Every reset of the game goes through here. A 'game reset (a save loaded from the START menu, a
   new game, the title) or a 'boot ends a running battle first (`bf-stop-now!`), before the reset
   and the save's data: deaths and the battle's own respawns ('life) go on as before."
  (if (and (or (= arg0 'game) (= arg0 'boot)) (bf-active?))
      (bf-stop-now!)
      )
  (*bf-stock-initialize* this arg0 arg1 arg2 arg3)
  )

;; ---------------------------------------------------------------------------------------------
;; START > Options > Gamemode > Battlefront
;; ---------------------------------------------------------------------------------------------

;; Labels of these pages: text ids past the game's own (text-h.gc ends at #x136c), answered by the
;; `lookup-text!` wrapper below, so the game's text files stay as they are.
(defconstant BF_TEXT_BASE #x7f00)
(defconstant BF_TEXT_GAMEMODE #x7f00)
(defconstant BF_TEXT_BATTLEFRONT #x7f01)
(defconstant BF_TEXT_NEW #x7f02)
(defconstant BF_TEXT_CLASS #x7f03)
(defconstant BF_TEXT_RESTART #x7f04)
(defconstant BF_TEXT_QUIT #x7f05)
(defconstant BF_TEXT_REDEPLOY #x7f06)
(defconstant BF_TEXT_COUNT 7)

(define *bf-menu-text*
  (new 'static 'boxed-array :type string
    "Gamemode" "Battlefront" "New battle" "Change class" "Restart the battle" "Quit the battle" "Redeploy"
    )
  )

(define *bf-menu-text-fr*
  (new 'static 'boxed-array :type string
    "Mode de jeu" "Battlefront" "Nouvelle bataille" "Changer de classe" "Recommencer la bataille" "Quitter la bataille"
    "Se redéployer"
    )
  )

;; Each label encoded for the game's font, in its own string (two labels can be drawn at once).
(define *bf-menu-encoded* (new 'global 'boxed-array string BF_TEXT_COUNT))

(dotimes (i BF_TEXT_COUNT)
  (set! (-> *bf-menu-encoded* i) (new 'global 'string 64 (the-as string #f)))
  )

(define-perm *bf-stock-lookup-text* (function game-text-info text-id symbol string)
             (method-of-type game-text-info lookup-text!)
             )

(defmethod lookup-text! ((this game-text-info) (arg0 text-id) (arg1 symbol))
  "Every game text goes through here. The labels of the battle's START pages (BF_TEXT_*) come from
   `*bf-menu-text*`, in French when the game runs in French, encoded for the game's font; every
   other id is the stock lookup."
  (let ((i (- (the-as int arg0) BF_TEXT_BASE)))
    (cond
      ((and (>= i 0) (< i BF_TEXT_COUNT))
       (pc-encode-utf8-string (if (bf-fr?) (-> *bf-menu-text-fr* i) (-> *bf-menu-text* i)) (-> *bf-menu-encoded* i))
       (-> *bf-menu-encoded* i)
       )
      (else
        (*bf-stock-lookup-text* this arg0 arg1)
        )
      )
    )
  )

(defun bf-menu-request ((p progress) (req int))
  "A button of the Battlefront page: hand REQ to the director (spawned on demand), which runs it
   once the START menu is closed, and close the menu."
  (bf-director-ensure!)
  (set! *bf-request* req)
  (set-next-state p 'go-away 0)
  (none)
  )

;; START > Options > Gamemode: the game modes, Battlefront alone.
(define *bf-gamemode-page*
  (progress-new-generic-scrolling-page BF_TEXT_GAMEMODE
    (new 'static 'menu-generic-button-option
      :name BF_TEXT_BATTLEFRONT
      :on-confirm (lambda ((p progress)) (push-state p) (set-next-state p 'bf-battlefront 0) (none))
      )
    )
  )

(defun bf-can-redeploy? ()
  "#t when the player may redeploy: in a fight, alive with his class, and out of combat (no shot,
   blow or hit taken, `*bf*` combat-time) for BF_REDEPLOY_CALM."
  (if (and (bf-fighting?)
           *target*
           (not (focus-test? *target* dead))
           (bf-avatar-alive?)
           (< BF_REDEPLOY_CALM (- (-> *display* game-clock frame-counter) (-> *bf* combat-time)))
           )
      #t
      #f
      )
  )

;; START > Options > Gamemode > Battlefront: a new battle (its zone, side and class pages), or,
;; during one, a class change, a restart, the end, or a redeploy (last, out of combat only). The
;; entries that do not apply are grey.
(define *bf-battlefront-page*
  (progress-new-generic-scrolling-page BF_TEXT_BATTLEFRONT
    (new 'static 'menu-generic-button-option
      :name BF_TEXT_NEW
      :should-disable? (lambda () (bf-active?))
      :on-confirm (lambda ((p progress)) (bf-menu-request p BF_REQ_LOBBY) (none))
      )
    (new 'static 'menu-generic-button-option
      :name BF_TEXT_CLASS
      :should-disable? (lambda () (not (bf-fighting?)))
      :on-confirm (lambda ((p progress)) (bf-menu-request p BF_REQ_CLASS) (none))
      )
    (new 'static 'menu-generic-button-option
      :name BF_TEXT_RESTART
      :should-disable? (lambda () (not (bf-fighting?)))
      :on-confirm (lambda ((p progress)) (bf-menu-request p BF_REQ_RESTART) (none))
      )
    (new 'static 'menu-generic-button-option
      :name BF_TEXT_QUIT
      :should-disable? (lambda () (not (bf-active?)))
      :on-confirm (lambda ((p progress)) (bf-menu-request p BF_REQ_END) (none))
      )
    (new 'static 'menu-generic-button-option
      :name BF_TEXT_REDEPLOY
      ;; the director's answer: this page runs on the menu's clock, which `*bf*` combat-time is not on
      :should-disable? (lambda () (not (-> *bf* redeploy-ok?)))
      :on-confirm (lambda ((p progress)) (bf-menu-request p BF_REQ_REDEPLOY) (none))
      )
    )
  )

(define-perm *bf-stock-set-menu-options* (function progress symbol int)
             (the-as (function progress symbol int) (method-of-type progress set-menu-options))
             )

(defmethod set-menu-options ((this progress) (arg0 symbol))
  "The START menu's pages (pc/progress/progress-pc.gc), plus 'bf-gamemode and 'bf-battlefront, each
   opened with nothing chosen from a former visit."
  (case arg0
    (('bf-gamemode 'bf-battlefront)
     (let ((page (if (= arg0 'bf-gamemode) *bf-gamemode-page* *bf-battlefront-page*)))
       (set! (-> (the-as menu-generic-scrolling-page (-> page options 0)) selected-option-index) -1)
       (set! (-> this current-options) page)
       )
     0
     )
    (else
      (*bf-stock-set-menu-options* this arg0)
      )
    )
  )

;; The Gamemode entry of START > Options, shown while the mode is on. The page places its entries at
;; fractions of its height (offset-y): the entries are spread again to make room for it.
(define *bf-options-entry*
  (new 'static 'menu-sub-menu-option :name BF_TEXT_GAMEMODE :offset-y 0.8 :next-state 'bf-gamemode)
  )

(define-perm *bf-stock-options* (array menu-option) (-> *options-options-pc* options))

;; The stock entries' offsets, kept once (a REPL reload must not keep the spread ones).
(define-perm *bf-stock-offsets* (array float)
             (let ((offsets (new 'global 'boxed-array float (-> *bf-stock-options* length))))
               (dotimes (i (-> *bf-stock-options* length))
                 (set! (-> offsets i) (-> *bf-stock-options* i offset-y))
                 )
               offsets
               )
             )

(define *bf-options-with-entry* (new 'global 'boxed-array menu-option (+ (-> *bf-stock-options* length) 1)))

(dotimes (i (-> *bf-stock-options* length))
  (set! (-> *bf-options-with-entry* i) (-> *bf-stock-options* i))
  )

(set! (-> *bf-options-with-entry* (-> *bf-stock-options* length)) *bf-options-entry*)

(defun bf-update-options-entry ()
  "Show the Gamemode entry in START > Options only while the mode is on (`*mod-battlefront-enable*`),
   the n + 1 entries spread over the stock span; off, the stock list and offsets."
  (let ((n (-> *bf-stock-options* length)))
    (cond
      (*mod-battlefront-enable*
       (let* ((first (-> *bf-stock-offsets* 0))
              (step (/ (- (-> *bf-stock-offsets* (+ n -1)) first) (the float n)))
              )
         (dotimes (i (+ n 1))
           (set! (-> *bf-options-with-entry* i offset-y) (+ first (* step (the float i))))
           )
         )
       (set! (-> *options-options-pc* options) *bf-options-with-entry*)
       )
      (else
        (dotimes (i n)
          (set! (-> *bf-stock-options* i offset-y) (-> *bf-stock-offsets* i))
          )
        (set! (-> *options-options-pc* options) *bf-stock-options*)
        )
      )
    )
  (none)
  )

(bf-update-options-entry)

;; ---------------------------------------------------------------------------------------------
;; Mods menu (L3 + SELECT, the bind of every mod: mods-menu.gc) > battlefront
;; ---------------------------------------------------------------------------------------------

(define *mod-battlefront-menu*
  (new 'static 'popup-menu-submenu :label "battlefront"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      (new 'static 'popup-menu-flag :label "Battlefront mode"
           :is-toggled? (lambda () *mod-battlefront-enable*)
           :on-confirm (lambda ()
                         (set! *mod-battlefront-enable* (not *mod-battlefront-enable*))
                         (bf-update-options-entry)
                         ;; off during a battle: the director loads the last save once this menu
                         ;; is closed
                         (if (and (not *mod-battlefront-enable*) (bf-active?))
                             (mods-menu-close!)
                             )
                         (none)
                         )
           )
      )
    )
  )

(defun mod-battlefront-build-menu ()
  "Entry of the mod in the Mods menu: the mode's switch."
  (the-as popup-menu-entry *mod-battlefront-menu*)
  )

(mods-menu-register "battlefront" mod-battlefront-build-menu)
