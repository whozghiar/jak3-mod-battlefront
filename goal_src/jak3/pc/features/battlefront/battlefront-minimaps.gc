    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000 #x00000000
    )
  )

;; Where each zone's texels start in `*bf-zone-minimap-texels*`, in 64-bit words.
(define *bf-zone-minimap-offset* (new 'static 'array int32 4 0 4096 8192 12288))

;; Each zone's map: stored width, height, and the width the map fills (the rest is padding).
(define *bf-zone-minimap-size*
  (new 'static 'array int32 12
    256 128 256
    128 256 85
    128 256 128
    256 256 256
    )
  )

;; World x and z of each map's top left corner, and the world units a texel covers.
(define *bf-zone-minimap-corner*
  (new 'static 'array float 12
    -1572864.0 4718592.0 24576.0
    3145728.0 1572864.0 18432.0
    3145728.0 -1572864.0 12288.0
    1572864.0 -3145728.0 12288.0
    )
  )

;; GS TEX0 of each map as uploaded (tbp 8, its buffer width, mt8, its size, palette loaded).
(define *bf-zone-minimap-tex0*
  (new 'static 'array uint64 4 #x20000001e1310008 #x200000021d308008 #x200000021d308008 #x2000000221310008)
  )

;; The minimap cells of each zone's levels (bit row * 5 + column, their city-map-bits): the force
;; field's test of the district (battlefront.gc `bf-zone-cell?`).
(define *bf-zone-cells* (new 'static 'array uint64 4 #x3bc000000 #x21080000 #x4200 #x308))

;; The minimap textures each zone's map is made of, as engine/ui/minimap.gc names them.
(define *bf-zone-minimap-name* (new 'static 'boxed-array :type string "map-ctyporta map-ctyportb map-ctyportc map-ctyportd map-ctyporte map-ctyportf" "map-ctyindb map-ctyinda" "map-ctysluma" "map-ctyslumc map-ctyslumb"))
