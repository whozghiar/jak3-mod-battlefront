;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-artifact.gc
;; name in dgo: battlefront-artifact
;; dgos: GAME

;; Spargus's battle (round 54, the author's wish): the destruction of an objective. A precursor
;; artifact stands by Spargus's precursor game, in the west district: the Freedom League defends it,
;; the Krimzon Guard comes to destroy it. No control point is taken: the Freedom League comes down in
;; the west district, the Krimzon Guard in the east one (battlefront-city.gc `bf-city-spawn-tick`).
;; The artifact destroyed, the Krimzon Guard wins; the Krimzon Guard out of units, or the time up, the
;; Freedom League wins (battlefront.gc `bf-check-victory`).
;;
;; The artifact is Jak 3's precursor generator C (the precursor core's, PRECURB's
;; precur-generator-c-ag, which the Spargus level's DGO carries: custom_assets/jak3/ports/
;; battlefront-spargus/port.jsonc "traffic" "art"), drawn at BF_ARTIFACT_SCALE of its size: a dark egg
;; of blue crystals. It is a unit of the Freedom League in the attack controller
;; (battlefront-city.gc `bf-city-artifact-attacker!`): the Krimzon Guard's units hate it, and those
;; within 45 m go for it (`bf-city-artifact-pull!`). Destroyed, it bursts into its pieces (its own
;; exploded model, thrown by a joint-exploder) in a blast.

(defconstant BF_ARTIFACT_HP 800.0)        ;; on the 24 point scale of the units' hits
(defconstant BF_ARTIFACT_SCALE 0.4)       ;; of the generator's size: its egg 4 m tall (0.2 in the first test looked Jak's size)
(defconstant BF_ARTIFACT_LIFT (meters 5.8)) ;; its middle over its ground (its legs touch the ground)
(defconstant BF_ARTIFACT_POINT 2)         ;; its battle point in Spargus's table (battlefront-h.gc)
;; where it stands: by the precursor game's door (Jak 3's waspgame actor was-pre-game), on the nearest
;; nav poly (battlefront-city.gc `bf-city-nearest-poly`)
(define *bf-artifact-near* (new 'static 'vector :x (meters 1477.1) :y (meters 28.2) :z (meters -370.8) :w 1.0))

(defskelgroup skel-bf-artifact precur-generator-c precur-generator-c-lod0-jg precur-generator-c-idle-ja
              ((precur-generator-c-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 30)
              )

(defskelgroup skel-bf-artifact-explode precur-generator-c precur-generator-c-explode-lod0-jg precur-generator-c-explode-idle-ja
              ((precur-generator-c-explode-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 8)
              )

;; its pieces (the stock precur-generator-c's, precura-obs.gc, in a level the battle never loads)
(define *bf-artifact-exploder-params*
  (new 'static 'joint-exploder-static-params
    :joints (new 'static 'boxed-array :type joint-exploder-static-joint-params
      (new 'static 'joint-exploder-static-joint-params :joint-index 4 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 5 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 6 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 7 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 8 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 9 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 10 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 11 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 12 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 13 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 14 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 15 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 16 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 17 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 18 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 19 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 20 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 21 :parent-joint-index -1)
      )
    :collide-spec (collide-spec backgnd)
    )
  )

(deftype bf-artifact (process-focusable)
  "Spargus's precursor artifact (round 54): the Freedom League's objective, the Krimzon Guard's
   target."
  ((hp        float)
   (attacker  structure)  ;; its city-attacker-info, #f for none
   (last-id   uint32)     ;; the last attack taken: an attack hits once
   )
  (:state-methods
    idle
    die
    )
  )

;; The artifact's process (a handle: a global symbol holds 32 bits, a handle 64, Lisp wiki common
;; 1.4.17), its health for the HUD, and 1 once destroyed in this battle
(deftype bf-artifact-ref (structure)
  ((proc   handle)
   (hp     float)
   (done   int32)
   (hits   int32)   ;; for the tests: hits taken
   )
  )

(define *bf-artifact* (new 'static 'bf-artifact-ref))
(set! (-> *bf-artifact* proc) (the-as handle #f))

(define-extern bf-city-artifact-attacker! (function process structure structure))
(define-extern bf-city-nearest-poly (function vector vector symbol))

(defun bf-objective? ()
  "#t for a battle of the destruction of an objective: Spargus's (round 54, the author's wish)."
  (= (-> *bf* zone) BF_ZONE_SPARGUS)
  )

(defmethod deactivate ((this bf-artifact))
  "The artifact going (its end, the battle's): its place in the attack controller given back first,
   so no unit keeps a foe that is gone."
  (when (-> this attacker)
    (bf-city-artifact-attacker! this (-> this attacker))
    (set! (-> this attacker) #f)
    )
  (call-parent-method this)
  (none)
  )

(defbehavior bf-artifact-hit bf-artifact ((proc process) (info attack-info))
  "An attack on the artifact from PROC: once per attack, from an attacker of the Krimzon Guard
   (`find-offending-process-focusable`), its points on the 24 point scale (`bf-attack-damage`, 4 for
   an attack the battle does not know; the player's BF_PLAYER_DAMAGE times) off its health. At none
   left: destroyed (`die`). Returns #t for a hit taken."
  (when (and (< 0.0 (-> self hp)) (!= (-> info id) (-> self last-id)))
    (set! (-> self last-id) (-> info id))
    (let* ((owner (find-offending-process-focusable proc info))
           (dmg (bf-attack-damage proc owner))
           )
      (when (and owner (= (bf-unit-team owner) BF_TEAM_KG))
        (if (< dmg 0.0)
            (set! dmg 4.0)
            )
        (if (= owner *target*)
            (set! dmg (* BF_PLAYER_DAMAGE dmg))
            )
        (set! (-> self hp) (- (-> self hp) dmg))
        (set! (-> *bf-artifact* hp) (fmax 0.0 (-> self hp)))
        (+! (-> *bf-artifact* hits) 1)
        (when (>= 0.0 (-> self hp))
          (format 0 "battlefront: the precursor artifact is destroyed (~A)~%" (-> owner type symbol))
          (go-virtual die)
          )
        #t
        )
      )
    )
  )

(defstate idle (bf-artifact)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       (bf-artifact-hit proc (the-as attack-info (-> block param 1)))
       )
      )
    )
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post ja-post
  )

(defstate die (bf-artifact)
  :virtual #t
  :enter (behavior ()
    "Destroyed: a foe no more (its place in the attack controller given back), the Krimzon Guard's
     victory (`*bf*` winner, the battle over), a blast (the Krimzon Guard's explosions, the red gun
     3's burst, the common bank's explosion, a shake), its model gone."
    (logior! (-> self focus-status) (focus-status dead))
    (when (-> self attacker)
      (bf-city-artifact-attacker! self (-> self attacker))
      (set! (-> self attacker) #f)
      )
    (set! (-> *bf-artifact* done) 1)
    (when (bf-fighting?)
      (set! (-> *bf* winner) BF_TEAM_KG)
      (bf-set-phase! BF_PHASE_OVER)
      )
    (vector-copy! (-> *launch-matrix* trans) (-> self root trans))
    (part-tracker-spawn part-tracker :to *entity-pool* :group group-kg-explosion)
    (vector-copy! (-> *launch-matrix* trans) (-> self root trans))
    (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-gun-red3-shot-explode)
    (sound-play "explosion" :position (-> self root trans))
    (activate! *camera-smush-control* 1228.8 45 1275 1.0 0.9 (-> *display* camera-clock))
    (let ((prim (-> self root root-prim)))
      (set! (-> prim prim-core collide-as) (collide-spec))
      (set! (-> prim prim-core collide-with) (collide-spec))
      )
    )
  :code (behavior ()
    "Its pieces thrown (its exploded model, at its scale), then gone once they are."
    (let ((tune (new 'stack 'joint-exploder-tuning (the-as uint 0))))
      (set-vector! (-> tune fountain-rand-transv-lo) (meters -16) (meters 10) (meters -16) 1.0)
      (set-vector! (-> tune fountain-rand-transv-hi) (meters 16) (meters 20) (meters 16) 1.0)
      (process-spawn
        joint-exploder
        (art-group-get-by-name *level* "skel-bf-artifact-explode" (the-as (pointer level) #f))
        5
        tune
        *bf-artifact-exploder-params*
        :name "joint-exploder"
        :to self
        :unk 0
        )
      )
    (suspend)
    (logior! (-> self draw status) (draw-control-status no-draw))
    (while (-> self child)
      (suspend)
      )
    (deactivate self)
    )
  :post ja-post
  )

(defbehavior bf-artifact-init-by-other bf-artifact ((pos vector) (sg skeleton-group))
  "The artifact on its ground at POS, its model SG: a shape the units' shots and blows meet (the guards'
   collide-as, civilian, solid, a sphere around its body, in the hit-by-others list), its model at
   BF_ARTIFACT_SCALE playing its idle, its full health (BF_ARTIFACT_HP), a place in the attack
   controller as a unit of the Freedom League (`bf-city-artifact-attacker!`)."
  (let ((cshape (new 'process 'collide-shape self (collide-list-enum hit-by-others))))
    (let ((group (new 'process 'collide-shape-prim-group cshape (the-as uint 1) 0)))
      (set! (-> cshape total-prims) (the-as uint 2))
      (set! (-> group prim-core collide-as) (collide-spec civilian))
      (set! (-> group prim-core collide-with) (collide-spec))
      (set! (-> group prim-core action) (collide-action solid))
      (set-vector! (-> group local-sphere) 0.0 0.0 0.0 (meters 6.0))
      (set! (-> cshape root-prim) group)
      (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
        (set! (-> sphere prim-core collide-as) (collide-spec civilian))
        (set! (-> sphere prim-core collide-with) (collide-spec))
        (set! (-> sphere prim-core action) (collide-action solid))
        (set-vector! (-> sphere local-sphere) 0.0 0.0 0.0 (meters 5.0))
        )
      )
    (set! (-> cshape nav-radius) (meters 5.0))
    (set! (-> cshape backup-collide-as) (-> cshape root-prim prim-core collide-as))
    (set! (-> cshape backup-collide-with) (-> cshape root-prim prim-core collide-with))
    (set! (-> self root) cshape)
    )
  (vector-copy! (-> self root trans) pos)
  (+! (-> self root trans y) BF_ARTIFACT_LIFT)
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) BF_ARTIFACT_SCALE BF_ARTIFACT_SCALE BF_ARTIFACT_SCALE 1.0)
  ;; its model is in Spargus's level: a process of the entity pool belongs to no level, and the
  ;; draw control looked for its art group in the default level's (round 54's first tests:
  ;; process-drawable-art-error), as the champions set theirs (battlefront-baron.gc)
  (let ((lev (level-get *level* 'bf-spargus)))
    (if lev
        (set! (-> self level) lev)
        )
    )
  (initialize-skeleton self sg (the-as pair 0))
  (update-transforms (-> self root))
  (set! (-> self hp) BF_ARTIFACT_HP)
  (set! (-> self last-id) (the-as uint 0))
  (set! (-> self focus-status) (focus-status))
  (set! (-> self attacker) #f)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self attacker) (bf-city-artifact-attacker! self (the-as structure #f)))
  (format 0 "battlefront: the precursor artifact stands at ~M ~M ~M, attacker ~A~%" (-> pos x) (-> pos y) (-> pos z)
          (if (-> self attacker) #t #f)
          )
  (go-virtual idle)
  )

(defun bf-artifact-update ()
  "Every frame of a battle (battlefront.gc `bf-director-update`): in a battle of the destruction of an
   objective (`bf-objective?`), the artifact stands from the fight's start, once a battle
   (`*bf-artifact*` done, cleared out of a fight), when its model is loaded with Spargus's level: on
   the nav poly nearest `*bf-artifact-near*`, its battle point moved there (the Krimzon Guard's units
   march to it). It goes with the battle."
  (if (not (bf-active?))
      (set! (-> *bf-artifact* done) 0)
      )
  (when (and (bf-fighting?) (bf-objective?) (zero? (-> *bf-artifact* done))
             (not (handle->process (-> *bf-artifact* proc)))
             (art-group-get-by-name *level* "skel-bf-artifact" (the-as (pointer level) #f))
             )
    (let ((at (new 'stack-no-clear 'vector))
          (sg (the-as skeleton-group (art-group-get-by-name *level* "skel-bf-artifact" (the-as (pointer level) #f))))
          )
      (if (not (bf-city-nearest-poly *bf-artifact-near* at))
          (vector-copy! at *bf-artifact-near*)
          )
      (when (< BF_ARTIFACT_POINT (-> *bf* point-count))
        (vector-copy! (-> *bf* points BF_ARTIFACT_POINT pos) at)
        )
      (set! (-> *bf-artifact* hp) BF_ARTIFACT_HP)
      (set! (-> *bf-artifact* hits) 0)
      (set! (-> *bf-artifact* done) 1)
      ;; a stack as large as the champion's (battlefront-baron.gc `bf-boss-update`)
      (set! (-> *bf-artifact* proc)
            (ppointer->handle (process-spawn bf-artifact at sg :name "bf-artifact" :to *entity-pool* :stack-size #x8000))
            )
      )
    )
  (when (and (not (bf-active?)) (handle->process (-> *bf-artifact* proc)))
    (deactivate (handle->process (-> *bf-artifact* proc)))
    (set! (-> *bf-artifact* proc) (the-as handle #f))
    )
  (none)
  )
