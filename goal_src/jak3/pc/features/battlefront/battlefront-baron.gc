;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-baron.gc
;; name in dgo: battlefront-baron
;; dgos: GAME

;; Baron Praxis, the Krimzon Guard's special character (round 44, the author's wish). Jak 2's
;; Baron (his cutscene model, the sword in his hand) moving to motion captures the Jak Animation
;; Studio put on his skeleton (scripts/battlefront/make_baron_clips.py,
;; custom_assets/jak3/models/models.jsonc). He is a class of the avatar (battlefront-player.gc
;; `bf-avatar`, BF_CLASS_BARON), with controls of his own, not Jak's: the avatar moves itself (its
;; own collision against the scenery, its own gravity, jump, run and attacks), and Jak, hidden,
;; stands where the Baron stands, his pad's moves taken from him (battlefront.gc `bf-pad-lock!`):
;; the camera, the units' aim and the hits taken are Jak's, as for every class.
;;
;; Buttons: left stick runs (walks, pushed a little); X jumps as high as Jak's double jump; Square a
;; straight sword slash, as far as Jak's punch; Circle a spin of the sword, as far as Jak's spin
;; kick; L2 held raises a white barrier, no hit goes through, the foes inside are thrown out, and he
;; walks slowly; R2 throws a ball of Jak and Daxter's yellow eco toward the crosshair with a diagonal
;; cut, from his yellow eco gauge. Round 45: no crouch (the author's wish). Round 46, his combos in
;; the air: X then Square, he dives and plants his sword in the ground, a blow all around; X then
;; Circle, he spins a full turn with his sword, hanging in the air. His clips: battlefront-h.gc
;; BF_BARON_CLIP_*.

(defconstant BF_BARON_RUN (meters 16))       ;; his run, stick pushed all the way: the player's guard's (16.7 m/s; 9 until round 45)
(defconstant BF_BARON_SLOW (meters 2.5))     ;; behind his shield
(defconstant BF_BARON_JUMP (meters 6))       ;; the top of Jak's double jump (target-util.gc: 3.5 + 2.5 m)
(defconstant BF_BARON_ACCEL (meters 60))     ;; how fast he speeds up (a second): his full run in a quarter second
(defconstant BF_BARON_DECEL (meters 80))     ;; and slows down
(defconstant BF_BARON_YAW_RATE (degrees 720)) ;; how fast he turns toward the stick (a second)
(defconstant BF_BARON_LEAN (degrees 0.35))   ;; his lean into a turn for each m/s of speed and radian a second of turn
(defconstant BF_BARON_WALK_MAX (meters 4))   ;; slower than this he walks
;; The ground his run and walk clips cover a second at rate 1 (their captures, put on him moving:
;; make_baron_clips.py's Run With Sword and great sword walk), and the way his walk goes off the
;; way it faces (27.6 degrees to his left: its model turns that much the other way). Round 46: his
;; run's stride widened 1.6 times (make_baron_clips.py STRIDE), its feet 1.36 times as far a cycle
;; (6.24 against 4.59 m a second measured at the planted foot): 6.19 m before, now played 1.9 times
;; as fast at his full run rather than 2.6 times (it looked sped up, the author's report)
(defconstant BF_BARON_RUN_GROUND (meters 8.41))
(defconstant BF_BARON_WALK_GROUND (meters 1.91))
(defconstant BF_BARON_WALK_YAW (degrees 27.6))
;; His attacks play their clips BF_BARON_ATTACK_RATE times as fast, whole (round 44 cut them at a
;; fixed length: only their wind-up showed): a clip's length and when its blow lands, at that rate
(defconstant BF_BARON_ATTACK_RATE 1.3)
(defconstant BF_BARON_SLASH_REACH (meters 3.2)) ;; Jak's punch, for a taller man with a sword
(defconstant BF_BARON_SPIN_REACH (meters 3.4))  ;; Jak's spin kick (target-util.gc spin-radius 2.2 m), the same
(defconstant BF_BARON_SLASH_TIME (seconds 0.85)) ;; the overhead chop (1.1 s), it lands 0.57 s in
(defconstant BF_BARON_SLASH_AT (seconds 0.44))
(defconstant BF_BARON_SPIN_TIME (seconds 1.15)) ;; the spin (1.5 s), its two swings 0.55 s and 1.07 s in
(defconstant BF_BARON_SPIN_AT (seconds 0.42))
(defconstant BF_BARON_SPIN_AT2 (seconds 0.82))
(defconstant BF_BARON_CAST_TIME (seconds 0.77)) ;; the cast, a diagonal cut (1 s, round 46), the ball out at its blow, 0.68 s in
(defconstant BF_BARON_CAST_AT (seconds 0.52))
;; His combos in the air (round 46), Square or Circle pressed in the air or with X: he jumps then.
;; X then Square: the plant, its clip (1.62 s) held at its sword raised overhead (0.35 s in,
;; BF_BARON_PLANT_HOLD of it) while he rises, then dives once past the top of his jump, then played
;; on from his landing, its blow BF_BARON_PLANT_AFTER later. X then Circle: the spin's first full
;; turn (1.15 s), his fall slowed meanwhile; its two swings when the ground spin's land
;; (BF_BARON_SPIN_AT, AT2).
(defconstant BF_BARON_PLANT_HOLD 0.216)
(defconstant BF_BARON_PLANT_DIVE (meters 14))     ;; his fall's speed as he starts the plant
(defconstant BF_BARON_PLANT_AFTER (seconds 0.23)) ;; landed, the blade in the ground this much later
(defconstant BF_BARON_PLANT_TIME (seconds 0.98))  ;; landed, the rest of the clip
(defconstant BF_BARON_PLANT_REACH (meters 5))     ;; the blow's reach all around him
(defconstant BF_BARON_AIRSPIN_TIME (seconds 0.89))
(defconstant BF_BARON_AIRSPIN_FALL 0.3)           ;; his gravity's share while he spins in the air
(defconstant BF_BARON_AIRSPIN_BELOW (meters 6))   ;; the spin in the air reaches this far under his feet
(defconstant BF_BARON_TURN_RATE 1.6)            ;; his 180 degree turn's clip (0.77 s) this fast
(defconstant BF_BARON_TURN_TIME (seconds 0.48))
(defconstant BF_BARON_CAST_COST 0.25)           ;; of his yellow eco gauge
(defconstant BF_BARON_ECO_REFILL 20.0)          ;; seconds his empty gauge takes to fill
(defconstant BF_BARON_SHIELD_REACH (meters 4))  ;; Light Jak's shield: the foes this close are thrown out
(defconstant BF_BARON_FOLLOW (meters 3))        ;; Jak moved farther than this from him by the game (a respawn, a knock): he goes there

(defconstant BF_DMG_BARON_SLASH 16.0)
(defconstant BF_DMG_BARON_SPIN 14.0)
(defconstant BF_DMG_BARON_PLANT 20.0)

;; ---------------------------------------------------------------------------------------------
;; The champions (round 49: the Krimzon Guard's; round 53: the Freedom League's, Ashelin)
;; ---------------------------------------------------------------------------------------------

;; Once the Krimzon Guard has lost BF_BOSS_SHARE % of its units, once a battle, Baron Praxis comes
;; to fight for it (the author's wish): the Baron of the class, his moves, played by the game
;; (`bf-boss-think`, his pad), with a health bar shown near him (battlefront.gc `bf-draw-boss-bar`).
;; Two processes, as the player has: `bf-boss`, the Baron drawn and moving himself (a `bf-avatar` of
;; the Baron's class, its code shared with the player's Baron), and `bf-boss-body`, the body the units
;; aim at and hit (a process-focusable registered in the attack controller as a Krimzon Guard robot,
;; battlefront-city.gc `bf-city-boss-attacker!`), put where he stands each frame.
(defconstant BF_BOSS_SHARE 20)            ;; % of the Krimzon Guard's units lost before he comes
(defconstant BF_BOSS_UNLIMITED 100)       ;; losses before he comes when the units are unlimited
(defconstant BF_BOSS_HP 100.0)            ;; a champion's health on the 24 point scale, about four guards' (the author's wish, round 52; 480 in round 49), Ashelin's the same (round 53)
(defconstant BF_BOSS_SIGHT (meters 80))   ;; a foe this close is his; farther, he marches to a point
(defconstant BF_BOSS_CLOSE (meters 2.6))  ;; he stops this close to his foe and strikes
(defconstant BF_BOSS_CAST_MIN (meters 8)) ;; he throws his yellow eco ball at a foe this far
(defconstant BF_BOSS_CAST_MAX (meters 40))
(defconstant BF_BOSS_CAST_GAP (seconds 2.5))
(defconstant BF_BOSS_CHEST (meters 1.2))  ;; his body's origin over his feet: where the units aim

(deftype bf-boss (bf-avatar)
  "A side's champion: Baron Praxis for the Krimzon Guard (round 49), the class's Baron
   (`bf-baron-update`) driven by his own pad, which `bf-boss-think` presses; Ashelin for the Freedom
   League (round 53, battlefront-ashelin.gc `bf-ashelin-update`, `bf-ashelin-think`)."
  ((team         int32)          ;; the champion's side
   (pad          bf-baron-pad :inline) ;; his buttons this frame and the frame before
   (move         vector :inline) ;; his left stick: the level direction he runs, its length the push (0 to 1)
   (foe-pos      vector :inline) ;; his foe's place
   (goal-pos     vector :inline) ;; where he goes
   (last-pos     vector :inline) ;; where he stood at the last stuck check
   (wander-dir   vector :inline) ;; his way around an obstacle
   (body         handle)         ;; his `bf-boss-body`
   (foe-dist     float)          ;; to his foe across; BF_BOSS_SIGHT and more for none
   (foe-near     int32)          ;; foes within his spin's reach
   (think-time   time-frame)
   (stuck-time   time-frame)
   (stuck        int32)          ;; stuck checks in a row he barely moved
   (wander-until time-frame)
   (cast-time    time-frame)
   (blows        int32)          ;; close attacks so far: every third a jump and plant
   )
  )

(deftype bf-boss-body (process-focusable)
  "The body of the Krimzon Guard's champion (`bf-boss`): the shape the units aim at and hit, his
   health, his place in the attack controller."
  ((boss      handle)
   (team      int32)      ;; its champion's side (round 53)
   (hp        float)
   (attacker  structure)  ;; his city-attacker-info, #f for none
   (last-id   uint32)     ;; the last attack taken: an attack hits once
   )
  (:state-methods
    idle
    )
  )

;; Each side's champion, #f for none, indexed by side. Handles in a structure: a global symbol's
;; value is 32 bits in Jak 3, and a handle stored there lost its pid (handle->process gave #f at once).
(deftype bf-boss-ref (structure)
  ((champ  handle 2)
   )
  )

(define *bf-boss-ref* (new (quote static) (quote bf-boss-ref)))
(set! (-> *bf-boss-ref* champ 0) (the-as handle #f))
(set! (-> *bf-boss-ref* champ 1) (the-as handle #f))
(define *bf-boss-done* (new 'static 'array int32 2 0 0))  ;; 1: that side's champion came in this battle
(define *bf-boss-hps* (new 'static 'array float 2 0.0 0.0)) ;; each champion's health left, for the HUD
(define *bf-boss-pos* (new 'static 'inline-array vector 2)) ;; and where each stands
;; For the tests: attacks on his body, [0] all, [1] from his own side, [2] repeated, [3] taken
(define *bf-boss-hits* (new 'static 'array int32 4 0 0 0 0))

(define-extern bf-city-boss-attacker! (function process structure int structure))
;; Ashelin's moves and thinking (battlefront-ashelin.gc, linked after this file)
(define-extern bf-ashelin-update (function none :behavior bf-avatar))
(define-extern bf-ashelin-think (function none :behavior bf-boss))
(define-extern bf-boss-place-body (function none :behavior bf-boss))

(defun bf-boss? ((proc process))
  "#t when PROC is a side's champion (`bf-boss`)."
  (and proc (= (-> proc type) bf-boss))
  )

(defun bf-boss-team ((proc process))
  "The side of champion PROC (a `bf-boss`) or of its body (a `bf-boss-body`), BF_TEAM_NONE for
   anything else (battlefront-h.gc `bf-unit-team`, round 53)."
  (cond
    ((bf-boss? proc) (-> (the-as bf-boss proc) team))
    ((and proc (= (-> proc type) bf-boss-body)) (-> (the-as bf-boss-body proc) team))
    (else BF_TEAM_NONE)
    )
  )

;; ---------------------------------------------------------------------------------------------
;; His yellow eco ball: Jak and Daxter's yellow eco shot
;; ---------------------------------------------------------------------------------------------

;; Jak and Daxter's yellow eco fireball, its launch at the hand and its burst
;; (goal_src/jak1/engine/game/projectiles.gc, groups 102, 103 and 104), ported to Jak 3's particles
;; at free ids: Jak 1's effects page textures are Jak 3's level-default-sprite ones of the same
;; names; Jak 1's particle flags bit 2, 3 and 14 are Jak 3's sp-cpuinfo-flag-2, 3 and 14, and its
;; bit 7 is Jak 3's ready-to-launch (Jak 3's own port of Jak 1's blue eco, debug-part.gc, does so):
;; without it the fireball's orbiting particles never launched and the ball flew unseen (the
;; author's report, round 45). Its group items' bit1, start-dead and launch-asap are sp1, sp2 and sp3.
;; Jak 3 names a group by its id (engine/data/part-groups.gc)
(defconstant group-bf-yellow-eco-ball (-> *part-group-id-table* 1600))
(defconstant group-bf-yellow-eco-ball-hit (-> *part-group-id-table* 1601))
(defconstant group-bf-yellow-eco-launch (-> *part-group-id-table* 1602))

