    (:y (meters 0) (meters 16))
    (:z (meters 0.1) (meters 0.2))
    (:scale-x (meters 0.3) (meters 0.1))
    (:rot-z (degrees 0) (degrees 360))
    (:scale-y :copy scale-x)
    (:r 100.0 28.0)
    (:g 64.0 64.0)
    (:b 0.0)
    (:a 64.0 64.0)
    (:omega (degrees 0) (degrees 360))
    (:vel-x (meters 0.10666667))
    (:scalevel-x (meters -0.000909091))
    (:rotvel-z (degrees -0.3) 1 (degrees 0.6))
    (:scalevel-y :copy scalevel-x)
    (:fade-g -0.26666668)
    (:fade-a -0.19393939)
    (:timer (seconds 0.3) (seconds 0.797))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3 ready-to-launch))
    )
  )

(defun bf-part-spec! ((id int) (field sp-field-id) (value float))
  "Set the first value of particle ID's init spec of FIELD to VALUE (a launch's direction, as Jak 1's
   projectile-yellow sets its parts before a shot), when the particle has that spec in its first 24."
  (let ((specs (-> *part-id-table* id init-specs)))
    (dotimes (k 24)
      (when (= (-> specs k field) field)
        (set! (-> specs k initial-valuef) value)
        (return #f)
        )
      (if (= (-> specs k field) (sp-field-id spt-end))
          (return #f)
          )
      )
    )
  (none)
  )

(defpart 5219
  :init-specs ((:texture (hotdot level-default-sprite))
    (:num 3.0)
    (:scale-x (meters 0.2))
    (:rot-z (degrees 0) (degrees 180))
    (:scale-y (meters 8))
    (:r 255.0)
