;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-spargus-info.gc
;; name in dgo: battlefront-spargus-info
;; dgos: GAME

#|
  Battlefront mod -- the Spargus war zone's level-load-info (bf-spargus), in GAME so that it is
  known at boot (round 50).

  The level is made from the player's own Jak 3 disc by scripts/level_port
  (custom_assets/jak3/ports/battlefront-spargus/port.jsonc), which also writes its level-load-info
  and continue points into goal_src/jak3/levels/bf-spargus/bf-spargus-levels.gc (not in git).
  GAME's object list can't name a generated object, so this file takes the generated one's forms
  when it exists, at compile time, and *bfs-built* tells the battle whether the war zone exists
  (else it is greyed). After `task level-port` creates the file for the first time, compile this
  one again (`(make-group "iso" :force #t)` or touch it): the build doesn't see the generated file
  as its input.
|#

(defmacro bfs-include-levels (file)
  "The forms of FILE (the generated level-load-info), without its first (in-package goal), and
   *bfs-built* #t; or *bfs-built* #f alone when FILE doesn't exist (the port not run)."
  (if (file-exists? file)
      `(begin
         ,@(cdr (read-data-file file))
         (define *bfs-built* #t)
         )
      `(define *bfs-built* #f)
      )
  )

(bfs-include-levels "goal_src/jak3/levels/bf-spargus/bf-spargus-levels.gc")
