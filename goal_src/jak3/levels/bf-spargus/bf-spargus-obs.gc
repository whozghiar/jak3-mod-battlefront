;;-*-Lisp-*-
(in-package goal)

;; name: bf-spargus-obs.gc
;; name in dgo: bf-spargus-obs
;; dgos: BFS

#|
  Battlefront mod -- the level code of bf-spargus, Jak 3's Spargus as the battle's third war zone
  (custom_assets/jak3/ports/battlefront-spargus/port.jsonc, built by scripts/level_port from the
  player's Jak 3 disc). Its level callbacks are Jak 3's ctywide's (ctywide-init.o, in the same DGO);
  this file holds what Jak 3's city lacks: Spargus's mood.
|#

;; The background comes from Spargus's levels, whose time-of-day palettes are laid out like this
;; (update-mood-wascitya, goal_src/jak3/levels/wascity/waswide-mood.gc, in WASALL, which a battle
;; doesn't load):
;;   0     ambient            1-4   sun light          (both from the exterior mood)
;;   5     lights             6     flames             7     full (1.0)
(defbehavior update-mood-bf-spargus time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  "bf-spargus's mood, Spargus's (update-mood-wascitya): the exterior mood, and while the level is
   active (outside the special time-of-day modes from 9) its lights and flames animated, palette 7
   full. ARG0: the level's mood context; ARG1: the time of day; ARG2: the level's index."
  (copy-mood-exterior arg0)
  (when (and (= (-> *level* level arg2 status) 'active)
             (< (the-as uint (-> *time-of-day-context* mode)) (the-as uint 9))
             )
    (update-mood-light arg0 5 0 1.0 0.0 arg1 0.0 2.0)
    (update-mood-flames arg0 6 1 8 1.0 0.000390625 1.5)
    (set! (-> arg0 times 7 w) 1.0)
    )
  0
  (none)
  )
