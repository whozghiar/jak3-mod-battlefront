;;-*-Lisp-*-
(in-package goal)

;; name: bf-havenj2-obs.gc
;; name in dgo: bf-havenj2-obs
;; dgos: BFH

#|
  Battlefront mod -- the level code of bf-havenj2, Jak 2's Haven City as the battle's second war
  zone (custom_assets/jak3/ports/battlefront-havenj2/port.jsonc, built by scripts/level_port from
  the player's discs). Its level callbacks are Jak 3's ctywide's (ctywide-init.o, in the same DGO);
  this file holds what Jak 3's city lacks: its mood.
|#

;; The background comes from Jak 2's city levels, whose time-of-day palettes are laid out like this
;; (update-mood-ctysluma, goal_src/jak2/engine/gfx/mood/mood-funcs.gc):
;;   0     ambient            1-4   sun light          (both from the exterior mood)
;;   5     street lights      6     flames             7     neon signs
;; Jak 3's update-mood-ctywide leaves palette 7 at 0, which keeps Jak 2's neon signs and industrial
;; lights dark: this is Jak 2's slums mood, which drives all three light palettes (the state offsets
;; are ctysluma's: light 0, neon 8, flames 16). Haven City: New Dawn's update-mood-havenj2.
(defbehavior update-mood-bf-havenj2 time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  "bf-havenj2's mood: the exterior mood, and while the level is active (outside the special
   time-of-day modes above 8) the street lights, flames and neon signs animated as in Jak 2's city."
  (copy-mood-exterior arg0)
  (when (and (= (-> *level* level arg2 status) 'active)
             (>= (the-as uint 8) (the-as uint (-> *time-of-day-context* mode)))
             )
    (update-mood-flames arg0 6 1 16 0.5 0.001953125 2.0)
    (update-mood-light arg0 7 8 0.9 0.0 arg1 32.0 2.0)
    (update-mood-light arg0 5 0 1.0 0.0 arg1 0.0 2.0)
    )
  0
  (none)
  )
