;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-city.gc
;; name in dgo: battlefront-city
;; dgos: CWI

#|
  Battlefront mod -- the part of a battle that needs Haven City's own types (attack controller,
  faction manager, the guards' grenade). Linked with CWI, so it only exists while Haven City is
  loaded; the GAME code (pc/features/battlefront/) reaches it through `*bf-city-hook*` and
  `*bf-city-grenade*`, which this file sets at link time, and calls them only while ctywide is
  active (a fresh link of this file).

  Hatred: the attack controller (wascity/mission-squad-control.gc) gives each unit the target of
  best score, its hatred times a distance factor times a crowd factor, twice for the one it has, and
  looks again now and then. During a battle every pair of foes takes the battle's own hatreds
  (`bf-city-apply-hatred`): the nearest foe first (the score falls to 0 at 120 m), kept until it
  dies (no look again), the player twice as hated as a unit by the other side and not at all by his
  own. The changed entries are saved first and written back when the battle ends.

  Battle points: three control points on the zone's lanes between the two bases
  (`bf-city-place-points`); the units with no foe march on their side's nearest point it does not
  hold (`bf-city-steer`); each side's troop transports (bf-transport.gc) bring its units to the
  points it holds, the nearest the player first (`bf-city-transports`): during a fight the traffic
  wakes none of the battle's units by itself (battlefront-h.gc `bf-wake-count`). The force field is
  drawn as security walls across the streets leaving the zone (`bf-city-walls`).

  No Spargus citizen fights here: wastelanders brought into Haven City by the traffic engine froze
  or crashed the game within minutes (in the background collision query
  fill-bg-using-line-sphere-new, seen in two of two ten-minute battles; none in a battle without
  them). The Spargus Citizen class is gone too: nothing of the wastelanders loads in Haven City.
|#

;; ctywide-obs.gc, linked after this file in CWI: a force field wall (security-wall-child) between A
;; and B on the ground, HEIGHT tall, child of the process given
(define-extern spawn-security-wall (function process vector vector float symbol handle))

;; DECOMP BEGINS

;; attack-controller types (city-target-type) of a battle: the player (the controller's
;; target-attacker), the Freedom League's guards (3 to 5: tazer, rifle, grenade; the blue jetpacks
;; register as rifle guards), the Krimzon Guard's units (9 to 12: roboguard, turret, spydroid, giant;
;; the red guards register as roboguards)
(defconstant BF_CTT_JAK 0)
(define *bf-ctt* (new 'static 'array int32 8 0 3 4 5 9 10 11 12))

(defconstant BF_HATE_REACH (meters 120))   ;; a foe beyond this scores 0: never chosen
(defconstant BF_HATE_LOST (meters 150))    ;; a unit whose foe got this far looks again
(defconstant BF_HATE_PLAYER (meters 50))   ;; the other side turns onto the player this close

(deftype bf-city-saved (structure)
  "Stock hatred indices overwritten during a battle, to write back at its end, and the battle's
   two hatreds pushed into the controller's list."
  ((saved?         symbol)
   (hatred         uint8 64)   ;; entry (row i, column j) of *bf-ctt* at 8 i + j
   (unit-info      int32)      ;; index of the battle's hatred between units
   (player-info    int32)      ;; index of the battle's hatred of the player
   (vals-length    int32)      ;; the list's length once they were pushed, 0 none
   (faction-time   time-frame) ;; last re-application of the battle's faction commands
   (reinforce-time time-frame) ;; last look at the sides' troop transports (`bf-city-transports`)
   (retarget-time  time-frame) ;; last look at the units near the player (`bf-city-retarget`)
   (want-mesh      nav-mesh)   ;; the nav mesh `bf-city-point-segment` looks a segment on
   )
  )

(define *bf-city-saved* (new 'static 'bf-city-saved))

(defun bf-city-hatred-slot ((row int) (col int))
  "Index of the (attacker ROW, target COL) entry of the attack controller's hatred table."
  (+ (* row (-> *cty-attack-controller* max-num-object-types)) col)
  )

(defun bf-city-controller? ()
  "#t when Haven City's attack controller exists (it is built at ctywide login)."
  (and *cty-attack-controller* (nonzero? *cty-attack-controller*))
  )

(defun bf-ctt-team ((ctt int))
  "Side of attack-controller type CTT in a battle: BF_TEAM_FF, BF_TEAM_KG, the player's for 0,
   BF_TEAM_NONE for any other."
  (cond
    ((= ctt BF_CTT_JAK) (-> *bf* team))
    ((and (>= ctt 3) (<= ctt 5)) BF_TEAM_FF)
    ((and (>= ctt 9) (<= ctt 12)) BF_TEAM_KG)
    (else BF_TEAM_NONE)
    )
  )

(defun bf-city-push-hatreds ()
  "Push the battle's two hatreds into the controller's list when they are not there: at the first
   call, and after a death reset rebuilt the list (cty-attack-reset -> reset-hatred, then the stock
   init-attack-controller pushes its own again, 12 of 22). Both score the nearest foe first: 1 near,
   falling to 0 at BF_HATE_REACH (dist-scale 0), with no penalty for a crowd on it (attacker-scale 1),
   and keep it until it dies (chi1: no look again on the controller's timer). The player is twice
   as hated as a unit."
  (let ((ctrl *cty-attack-controller*)
        (saved *bf-city-saved*)
        )
    (when (or (zero? (-> saved vals-length)) (!= (-> ctrl hatred-vals length) (-> saved vals-length)))
      (when (>= (- (-> ctrl hatred-vals allocated-length) (-> ctrl hatred-vals length)) 2)
        (dotimes (i 2)
          (let ((info (push-back-hatred ctrl)))
            (set! (-> info hatred) (if (zero? i) 0.5 1.0))
            (set! (-> info hatred-dist) BF_HATE_REACH)
            (set! (-> info max-consider-dist) BF_HATE_REACH)
            (set! (-> info dist-scale) 0.0)
            (set! (-> info attacker-scale) 1.0)
            (set! (-> info flags) (city-hatred-info-flag chi1))
            (if (zero? i)
                (set! (-> saved unit-info) (the-as int (-> info index)))
                (set! (-> saved player-info) (the-as int (-> info index)))
                )
            )
          )
        (set! (-> saved vals-length) (-> ctrl hatred-vals length))
        )
      )
    )
  (none)
  )

(defun bf-city-apply-hatred ()
  "The battle's hatreds between every attacker and target type of *bf-ctt*: none between a side's
   own (the player's included), the battle's unit hatred between foes, its player hatred from the
   other side's units onto the player. The stock entries are saved the first time. Written on every
   call: a death reset rebuilds the stock table, and the writes are idempotent. Then no unit keeps
   the guards' anger at the player (a 'member-attacked from the player's shots gives a guard a
   hatred-map-callback onto him, guard.gc), so his own side never turns on him."
  (when (bf-city-controller?)
    (bf-city-push-hatreds)
    (let* ((ctrl *cty-attack-controller*)
           (saved *bf-city-saved*)
           (table (-> ctrl hatred-indices))
           )
      (when (not (-> saved saved?))
        (dotimes (i 8)
          (dotimes (j 8)
            (set! (-> saved hatred (+ (* 8 i) j)) (-> table (bf-city-hatred-slot (-> *bf-ctt* i) (-> *bf-ctt* j))))
            )
          )
        (set! (-> saved saved?) #t)
        )
      (when (nonzero? (-> saved vals-length))
        (dotimes (i 8)
          (dotimes (j 8)
            (let ((row (-> *bf-ctt* i))
                  (col (-> *bf-ctt* j))
                  )
              (when (!= row BF_CTT_JAK)
                (set! (-> table (bf-city-hatred-slot row col))
                      (cond
                        ((= (bf-ctt-team row) (bf-ctt-team col)) 0)
                        ((= col BF_CTT_JAK) (-> saved player-info))
                        (else (-> saved unit-info))
                        )
                      )
                )
              )
            )
          )
        )
      (dotimes (i (-> ctrl attackers length))
        (let ((info (-> ctrl attackers data i)))
          (if (>= (bf-ctt-team (-> info self-type)) 0)
              (set! (-> info hatred-map-callback) #f)
              )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-retarget ()
  "Twice a second: a unit of the other side within BF_HATE_PLAYER of the player, its foe farther
   than him, a unit whose foe got beyond BF_HATE_LOST, and a unit of the player's side that has him
   as its foe look again for a target now (mission-squad-control-method-13, the controller's own
   choice): the player's hatred makes the first turn onto him, the second takes the nearest foe
   again, the third any foe but him. Otherwise a unit keeps its foe until it dies."
  (when (and (bf-city-controller?) *target* (not (focus-test? *target* dead)))
    (let* ((ctrl *cty-attack-controller*)
           (jak (-> ctrl target-attacker self-index))
           (here (-> *target* control trans))
           )
      (dotimes (i (-> ctrl attackers length))
        (let ((info (-> ctrl attackers data i)))
          (when (and (logtest? (-> info flags) (city-attacker-info-flag cai0))
                     (!= i jak)
                     (>= (bf-ctt-team (-> info self-type)) 0)
                     )
            (let* ((pos (-> ctrl attacker-cache data i pos))
                   (foe (-> info enemy-index))
                   (foe-dist (if (>= foe 0)
                                 (vector-vector-xz-distance pos (-> ctrl attacker-cache data foe pos))
                                 BF_HATE_LOST
                                 )
                             )
                   (jak-dist (vector-vector-xz-distance pos here))
                   )
              (if (or (and (!= (bf-ctt-team (-> info self-type)) (-> *bf* team))
                           (!= foe jak)
                           (< jak-dist BF_HATE_PLAYER)
                           (< jak-dist foe-dist)
                           )
                      (and (>= foe 0) (< BF_HATE_LOST foe-dist))
                      ;; a unit of his own side on the player: a target taken before the battle's
                      ;; hatreds (the stock ones, while the zone loaded) is kept until it dies (seen in
                      ;; game: a red guard and a red jetpack aiming at a Krimzon Guard player)
                      (and (= foe jak) (= (bf-ctt-team (-> info self-type)) (-> *bf* team)))
                      )
                  (mission-squad-control-method-13 ctrl info)
                  )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-restore-hatred ()
  "Write back the entries `bf-city-apply-hatred` changed, and take the battle's two hatreds off the
   list when they are still its last."
  (when (and (bf-city-controller?) (-> *bf-city-saved* saved?))
    (let ((saved *bf-city-saved*)
          (table (-> *cty-attack-controller* hatred-indices))
          )
      (dotimes (i 8)
        (dotimes (j 8)
          (set! (-> table (bf-city-hatred-slot (-> *bf-ctt* i) (-> *bf-ctt* j))) (-> saved hatred (+ (* 8 i) j)))
          )
        )
      )
    )
  (when (and (bf-city-controller?)
             (nonzero? (-> *bf-city-saved* vals-length))
             (= (-> *cty-attack-controller* hatred-vals length) (-> *bf-city-saved* vals-length))
             )
    (+! (-> *cty-attack-controller* hatred-vals length) -2)
    )
  (set! (-> *bf-city-saved* vals-length) 0)
  (set! (-> *bf-city-saved* saved?) #f)
  (none)
  )

(defun bf-city-zone-branch? ((branch nav-branch))
  "#t when nav BRANCH (a lane of a segment, or the one a unit walks) belongs to a section of the
   battle's zone: it lies in that section's nav-graph branch array (the traffic engine patches
   each segment's branch to point there, traffic-engine.gc level-link). A lane of a section next
   to the zone, which the game loads at its edge, is not one. #f for a missing branch."
  (let ((addr (the-as uint branch))
        (found #f)
        )
    (when (and branch (nonzero? addr))
      (dotimes (i 2)
        (let* ((name (if (zero? i) (-> *bf-zones* (-> *bf* zone) level0) (-> *bf-zones* (-> *bf* zone) level1)))
               (lev (if name (level-get *level* name)))
               )
          (when (and lev (= (-> lev status) 'active) (nonzero? (-> lev bsp city-level-info)))
            (let ((graph (-> lev bsp city-level-info nav-graph)))
              (if (and (nonzero? graph)
                       (>= addr (the-as uint (-> graph branch-array 0)))
                       (< addr (the-as uint (-> graph branch-array (-> graph branch-count))))
                       )
                  (set! found #t)
                  )
              )
            )
          )
        )
      )
    found
    )
  )

(defun bf-keep-unit? ((unit process))
  "Called by the traffic engine (traffic-engine.gc, its per-frame check of the awake pedestrians)
   for UNIT outside the cells it keeps awake, the ones its camera's visibility marks: the stock
   sends such a unit back to its pool. During a fight, #t keeps it awake wherever the camera is
   while it walks a lane of the zone (`bf-city-zone-branch?`): units vanished out of the camera's
   view (the author's notes), and with them the fight the reserves count. One on a lane of the
   next section goes back to its pool as in the stock (no death: the reserves keep it), since that
   section unloads as the player walks away. One on no lane (a flying unit) stays awake."
  (and (bf-fighting?)
       (let ((branch (-> (the-as citizen unit) controller branch)))
         (or (not branch) (zero? (the-as uint branch)) (bf-city-zone-branch? branch))
         )
       )
  )

;; ---------------------------------------------------------------------------------------------
;; Battle points on the streets, the force field's walls
;; ---------------------------------------------------------------------------------------------

(defun bf-city-near-segment ((found traffic-find-segment-struct) (seg nav-segment))
  "Callback of `bf-city-snap`: keep the segment of the zone (`bf-city-zone-branch?`) whose line
   passes nearest the point `found` carries in `dir`, on the nav mesh `*bf-city-saved*` want-mesh
   when one is set."
  (when (and (nonzero? (-> seg nav-mesh-id))
             (bf-city-zone-branch? (-> seg branch))
             (or (not (-> *bf-city-saved* want-mesh))
                 (= (get-nav-mesh (the-as actor-id (-> seg nav-mesh-id))) (-> *bf-city-saved* want-mesh))
                 )
             )
    (let ((d (vector-segment-distance-point! (-> found dir) (-> seg vertex 0) (-> seg vertex 1) (the-as vector #f))))
      (when (< (-> found best-rating) (- d))
        (set! (-> found best-rating) (- d))
        (set! (-> found best-seg) seg)
        )
      )
    )
  (none)
  )

(defun bf-city-point-segment ((pos vector) (mesh nav-mesh) (radius float))
  "The segment of the zone's lanes nearest POS within RADIUS, on nav mesh MESH (#f: any), from the
   pedestrians' tracker; #f for none."
  (let ((te *traffic-engine*)
        (found (new 'stack-no-clear 'traffic-find-segment-struct))
        (sphere (vector-copy! (new 'stack-no-clear 'vector) pos))
        )
    (when (and te (nonzero? te))
      (set! (-> sphere w) radius)
      (vector-copy! (-> found dir) pos)
      (set! (-> found best-rating) -100000000.0)
      (set! (-> found best-seg) #f)
      (set! (-> *bf-city-saved* want-mesh) mesh)
      (callback-on-nav-segments-in-sphere te sphere 1 found bf-city-near-segment)
      (set! (-> *bf-city-saved* want-mesh) #f)
      (-> found best-seg)
      )
    )
  )

(deftype bf-point-pick (structure)
  "The best lane spot found so far for each control point (`bf-city-place-points`)."
  ((pos     vector 3 :inline)
   (rating  float 3)
   )
  )

(define *bf-point-pick* (new 'static 'bf-point-pick))

(defun bf-city-point-candidate ((found traffic-find-segment-struct) (seg nav-segment))
  "Callback of `bf-city-place-points`: the middle of a lane segment of the zone (pedestrians'
   tracker, `bf-city-zone-branch?`), 40 m or more from both spawns, is a candidate for the control
   point whose share of the way from the Freedom League's spawn to the Krimzon Guard's (its distance
   to the first over the sum of both) is within 0.08 of a quarter, a half, three quarters; of those,
   the one on the shortest way between the spawns (the least sum) wins."
  (when (and (nonzero? (-> seg nav-mesh-id)) (bf-city-zone-branch? (-> seg branch)))
    (let* ((mid (vector-lerp! (new 'stack-no-clear 'vector) (-> seg vertex 0) (-> seg vertex 1) 0.5))
           (d0 (vector-vector-xz-distance mid (-> *bf* spawn 0)))
           (d1 (vector-vector-xz-distance mid (-> *bf* spawn 1)))
           (share (/ d0 (fmax 1.0 (+ d0 d1))))
           (pick *bf-point-pick*)
           )
      (when (and (< (meters 40) d0) (< (meters 40) d1))
        (dotimes (k 3)
          (when (and (< (fabs (- share (* 0.25 (the float (+ k 1))))) 0.08) (< (-> pick rating k) (- (+ d0 d1))))
            (set! (-> pick rating k) (- (+ d0 d1)))
            (vector-copy! (-> pick pos k) mid)
            (set! (-> pick pos k w) 1.0)
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-place-points ()
  "The control points of a new fight on the zone's streets: each on a lane where units walk and
   transports find ground and a nav mesh, a quarter, half and three quarters of the way from the
   Freedom League's spawn to the Krimzon Guard's, on the shortest way between them
   (`bf-city-point-candidate`): a straight line between the spawns crossed the Port's water. A
   point with no lane found keeps the place `bf-points-setup` gave it."
  (let ((te *traffic-engine*)
        (found (new 'stack-no-clear 'traffic-find-segment-struct))
        (pick *bf-point-pick*)
        )
    (when (and te (nonzero? te))
      (dotimes (k 3)
        (set! (-> pick rating k) -100000000.0)
        )
      (callback-on-nav-segments-in-sphere te (-> *bf* center) 1 found bf-city-point-candidate)
      (dotimes (k 3)
        (when (and (< (+ 2 k) (-> *bf* point-count)) (< -100000000.0 (-> pick rating k)))
          (vector-copy! (-> *bf* points (+ 2 k) pos) (-> pick pos k))
          (format 0 "battlefront: point ~D at ~M ~M ~M~%" (+ 2 k) (-> pick pos k x) (-> pick pos k y) (-> pick pos k z))
          )
        )
      )
    )
  (none)
  )

(defconstant BF_WALL_WIDTH (meters 30))   ;; a force field wall across a street
(defconstant BF_WALL_HEIGHT (meters 40))
(defconstant BF_WALL_SINK (meters 10))    ;; the wall's foot below its exit node: a street sloping down into the zone
(defconstant BF_WALL_MERGE (meters 30))   ;; lane exits this close make one wall

(deftype bf-wall-exits (structure)
  "The zone's lane exits (`bf-city-walls`): for up to 16 streets, the sum of their exits' places and
   directions, and how many."
  ((count   int32)
   (pos     vector 16 :inline)
   (dir     vector 16 :inline)
   (n       int32 16)
   )
  )

(define *bf-wall-exits* (new 'static 'bf-wall-exits))

(defun bf-city-wall-exit ((p0 vector) (p1 vector))
  "One lane leaving the zone, from P0 (its last node in the zone) to P1 (the first of the next
   section): its exit, halfway between them (P1 alone stood in the next district: the Industrial
   Zone's wall stood in the Port), joins the street within BF_WALL_MERGE of it, or starts one, 16
   at most."
  (let ((w *bf-wall-exits*)
        (dir (vector-! (new 'stack-no-clear 'vector) p1 p0))
        (at (vector-lerp! (new 'stack-no-clear 'vector) p0 p1 0.5))
        (k -1)
        )
    (set! (-> dir y) 0.0)
    (when (< 409.6 (vector-length dir))
      (vector-normalize! dir 1.0)
      (dotimes (i (-> w count))
        (let ((avg (vector-float*! (new 'stack-no-clear 'vector) (-> w pos i) (/ 1.0 (the float (-> w n i))))))
          (if (and (< k 0) (< (vector-vector-xz-distance avg at) BF_WALL_MERGE))
              (set! k i)
              )
          )
        )
      (when (and (< k 0) (< (-> w count) 16))
        (set! k (-> w count))
        (+! (-> w count) 1)
        (vector-reset! (-> w pos k))
        (vector-reset! (-> w dir k))
        (set! (-> w n k) 0)
        )
      (when (>= k 0)
        ;; one direction for a street's lanes
        (if (< (vector-dot dir (-> w dir k)) 0.0)
            (vector-negate! dir dir)
            )
        (vector+! (-> w pos k) (-> w pos k) at)
        (vector+! (-> w dir k) (-> w dir k) dir)
        (+! (-> w n k) 1)
        )
      )
    )
  (none)
  )

(defun bf-city-zone-graph ((i int))
  "The nav graph of the zone's section I (0 or 1), #f when that section is none or not loaded."
  (let* ((name (if (zero? i) (-> *bf-zones* (-> *bf* zone) level0) (-> *bf-zones* (-> *bf* zone) level1)))
         (lev (if name (level-get *level* name)))
         )
    (if (and lev (= (-> lev status) 'active) (nonzero? (-> lev bsp city-level-info)) (nonzero? (-> lev bsp city-level-info nav-graph)))
        (-> lev bsp city-level-info nav-graph)
        (the-as nav-graph #f)
        )
    )
  )

(defun bf-city-walls ()
  "The force field made visible: a security wall (ctywide-obs.gc, Jak 2's force field between the
   districts, solid to Jak) across each street leaving the zone. A section's nav graph lists the
   lanes that leave it for another section (its links: the branch going out, and a copy of the node
   it reaches there); those to a section of the zone's own are not exits. The exits within
   BF_WALL_MERGE make one street (`bf-city-wall-exit`), and its wall stands at their mean exit,
   across their mean direction, BF_WALL_WIDTH wide and BF_WALL_HEIGHT tall from BF_WALL_SINK below
   that exit: at the Port the next section's node stands 13 m above the street 25 m inside. The walls are the
   battle's director's children; their handles in `*bf*` walls, taken down at the battle's end
   (`bf-city-walls-down`)."
  (let ((dir (the-as process (handle->process (-> *bf* director))))
        (w *bf-wall-exits*)
        )
    (set! (-> w count) 0)
    (when dir
      (dotimes (i 2)
        (let ((graph (bf-city-zone-graph i))
              (other (bf-city-zone-graph (- 1 i)))
              )
          (when graph
            (dotimes (k (-> graph link-count))
              (let ((link (-> graph link-array k)))
                (when (or (not other) (!= (-> link dest-graph-id) (-> other id)))
                  (bf-city-wall-exit (-> graph branch-array (-> link src-branch-id) src-node position)
                                     (-> link dummy-node position)
                                     )
                  )
                )
              )
            )
          )
        )
      (dotimes (k (-> w count))
        (when (< (-> *bf* wall-count) 16)
          (let ((c (vector-float*! (new 'stack-no-clear 'vector) (-> w pos k) (/ 1.0 (the float (-> w n k)))))
                (side (new 'stack-no-clear 'vector))
                (a (new 'stack-no-clear 'vector))
                (b (new 'stack-no-clear 'vector))
                )
            (set! (-> c w) 1.0)
            (set! (-> c y) (- (-> c y) BF_WALL_SINK))
            ;; across the street: its lanes' direction turned a quarter
            (vector-normalize! (-> w dir k) 1.0)
            (set-vector! side (- (-> w dir k z)) 0.0 (-> w dir k x) 1.0)
            (vector+float*! a c side (* -0.5 BF_WALL_WIDTH))
            (vector+float*! b c side (* 0.5 BF_WALL_WIDTH))
            (format 0 "battlefront: force field wall at ~M ~M ~M (~D lanes)~%" (-> c x) (-> c y) (-> c z) (-> w n k))
            (set! (-> *bf* walls (-> *bf* wall-count)) (spawn-security-wall dir a b BF_WALL_HEIGHT #f))
            (+! (-> *bf* wall-count) 1)
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-walls-down ()
  "Take the battle's force field walls down (`bf-city-walls`)."
  (dotimes (i (-> *bf* wall-count))
    (let ((wall (handle->process (-> *bf* walls i))))
      (if wall
          (deactivate wall)
          )
      )
    )
  (set! (-> *bf* wall-count) 0)
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; The sides' troop transports, and the units marching on the control points
;; ---------------------------------------------------------------------------------------------

(defconstant BF_SHIPS_PER_TEAM 2)   ;; troop transports one side has in the air at once at most
(defconstant BF_SHIP_SHORT 3)       ;; a side sends one when it lacks this many units at least

(define *bf-city-hatch* (new 'static 'vector))

(defun bf-city-hatch-dir ((pos vector))
  "The way a troop transport over POS opens its hatch: the first of 12 directions, from toward the
   player turning a twelfth either way in turn, whose landing is on the street (bf-transport.gc `bf-transport-landing?`).
   A guard leaves the hatch only onto free nav mesh behind it, pinned to the ship until then.
   Toward the player alone, the ship at the Freedom League's headquarters faced a building and its
   guards never left; along the nearest lane, or toward the zone's middle first, ships stuck at
   bases near the player too, where toward him they had not. Returns `*bf-city-hatch*`, or #f when
   none (the ship then faces the player)."
  (let ((dir *bf-city-hatch*)
        (base (vector-! (new 'stack-no-clear 'vector) (target-pos 0) pos))
        (mesh (find-nearest-nav-mesh pos 8192.0))
        (found #f)
        )
    (set! (-> base y) 0.0)
    ;; the player under the ship: the hatch to -z, as the ship faced before (bf-transport.gc)
    (if (< (vector-length base) 409.6)
        (set-vector! base 0.0 0.0 -1.0 1.0)
        )
    (vector-normalize! base 1.0)
    (dotimes (k 12)
      (when (and mesh (not found))
        ;; 0, +30, -30, +60, -60 ... degrees from the player
        (vector-rotate-around-y! dir base (* (degrees 30) (the float (if (logtest? k 1) (/ (+ k 1) 2) (- (/ k 2))))))
        (set! (-> dir w) 1.0)
        (if (bf-transport-landing? pos dir mesh)
            (set! found #t)
            )
        )
      )
    (if found dir)
    )
  )

(defun bf-city-transports ()
  "Twice a second: a side whose units awake (bf-transport.gc `bf-transport-team-count`), plus those
   its ships still carry, fall BF_SHIP_SHORT or more short of its caps (*bf-team-caps*) sends a troop
   transport to the point it holds (its base, or a control point) nearest the player with no ship
   over it yet, BF_SHIPS_PER_TEAM ships at most: units come in where the player fights. A point's
   ship handle is cleared once the ship is gone. The ships are the director's children."
  (let ((parent (the-as process (handle->process (-> *bf* director))))
        (counts (new 'stack-no-clear 'array 'int32 4))
        )
    (when (and parent *target* (bf-fighting?))
      (dotimes (team 2)
        (let ((ships 0)
              (carried 0)
              (cap 0)
              )
          (dotimes (i (-> *bf* point-count))
            (let ((ship (handle->process (-> *bf* points i ship))))
              (cond
                ((not ship)
                 (set! (-> *bf* points i ship) (the-as handle #f))
                 )
                ((= (-> (the-as bf-transport ship) team) team)
                 (+! ships 1)
                 (+! carried (the-as int (send-event ship 'units-left)))
                 )
                )
              )
            )
          (dotimes (k BF_KIND_COUNT)
            (+! cap (-> *bf-team-caps* (+ (* 4 team) k)))
            )
          (when (and (< ships BF_SHIPS_PER_TEAM)
                     (<= BF_SHIP_SHORT (- cap (bf-transport-team-count team counts) carried))
                     )
            (let ((best -1)
                  (best-d 0.0)
                  )
              (dotimes (i (-> *bf* point-count))
                (let ((pt (-> *bf* points i)))
                  (when (and (= (-> pt owner) team) (not (handle->process (-> pt ship))))
                    (let ((d (vector-vector-xz-distance (-> pt pos) (-> *target* control trans))))
                      (when (or (< best 0) (< d best-d))
                        (set! best i)
                        (set! best-d d)
                        )
                      )
                    )
                  )
                )
              (when (>= best 0)
                (let* ((hatch (bf-city-hatch-dir (-> *bf* points best pos)))
                       (ship (bf-transport-spawn parent (-> *bf* points best pos) team best hatch))
                       )
                  (when ship
                    (set! (-> *bf* points best ship) (process->handle ship))
                    (format 0 "battlefront: side ~D transport to point ~D, hatch ~A~%" team best
                            (if hatch 'onto-the-street 'toward-the-player))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-ships-down ()
  "Every troop transport of the battle gone at once (the battle's end)."
  (dotimes (i BF_POINT_MAX)
    (let ((ship (handle->process (-> *bf* points i ship))))
      (if ship
          (deactivate ship)
          )
      (set! (-> *bf* points i ship) (the-as handle #f))
      )
    )
  (none)
  )

(defun bf-city-goal-point ((team int) (from vector))
  "The control point nearest FROM that side TEAM does not hold: its units' objective (battlefront.gc
   `bf-update-points` captures it once they hold it). -1 when TEAM holds every one."
  (let ((best -1)
        (best-d 0.0)
        )
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?)) (!= (-> pt owner) team))
          (let ((d (vector-vector-xz-distance (-> pt pos) from)))
            (when (or (< best 0) (< d best-d))
              (set! best i)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-city-steer ()
  "Twice a second: each unit of the battle with no foe to fight (in its active or wait state: the
   attack controller sends a unit into its hostile state as soon as a foe is within 120 m, then
   back) heads for its side's objective (`bf-city-goal-point`): farther than BF_POINT_RADIUS from it
   and walking elsewhere, it is put on the lane nearest the point on its own nav mesh
   (citizen-method-199, the lane its active state walks), and fights what it meets on the way.
   Once there, it wanders around the point while its side captures it."
  (let ((te *traffic-engine*))
    (when (and te (nonzero? te))
      (dotimes (ti 2)
        (let ((tr (-> te tracker-array ti)))
          (dotimes (i (-> tr active-object-count))
            (let ((proc (handle->process (-> tr active-object-list i))))
              (when (and proc (type? proc citizen) (-> proc next-state))
                (let ((u (the-as citizen proc))
                      (team (bf-unit-team proc))
                      (state (-> proc next-state name))
                      )
                  (when (and (>= team 0) (or (= state 'active) (= state 'wait)) (nonzero? (-> u nav)))
                    (let ((goal (bf-city-goal-point team (-> u root trans))))
                      (when (>= goal 0)
                        (let ((gp (-> *bf* points goal pos)))
                          (when (and (< BF_POINT_RADIUS (vector-vector-xz-distance (-> u root trans) gp))
                                     (< (meters 20) (vector-vector-xz-distance (-> u dest-point) gp))
                                     )
                            (let ((seg (bf-city-point-segment gp (-> u nav state mesh) (meters 60))))
                              (if seg
                                  (citizen-method-199 u seg)
                                  )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-command ((cmd int))
  "`*bf-city-hook*`. CMD: BF_CITY_PREPARE once the zone is loaded, BF_CITY_UPDATE every frame of
   the fight, BF_CITY_RESET when the battle ends. The unit pools are not rebuilt here: the director
   respawns the player with `initialize!` 'life at both ends of a battle (battlefront.gc), which
   rebuilds them the way a death does."
  (cond
    ((= cmd BF_CITY_PREPARE)
     (bf-city-restore-hatred)
     (bf-city-ships-down)
     (bf-city-walls-down)
     (bf-city-place-points)
     (bf-city-walls)
     )
    ((= cmd BF_CITY_UPDATE)
     (bf-city-apply-hatred)
     (when (time-elapsed? (-> *bf-city-saved* retarget-time) (seconds 0.5))
       (set-time! (-> *bf-city-saved* retarget-time))
       (bf-city-retarget)
       (bf-city-steer)
       )
     ;; a death reset (ctywide activates again) or a task change restores the stock faction
     ;; state: apply the battle's every 2 seconds
     (when (and *cty-faction-manager*
                (nonzero? *cty-faction-manager*)
                (time-elapsed? (-> *bf-city-saved* faction-time) (seconds 2))
                )
       (set-time! (-> *bf-city-saved* faction-time))
       (cty-faction-evaluate-commands *bf-faction-commands*)
       ;; the lift to the Freedom League's headquarters stays still (elevator.gc 'go-dormant: only
       ;; a 'trigger wakes it); a death reset spawns it again, so sent each time
       (let ((lift (process-by-ename "cty-elevator-2")))
         (if lift
             (send-event lift 'go-dormant)
             )
         )
       )
     ;; the troop transports, a look twice a second
     (when (time-elapsed? (-> *bf-city-saved* reinforce-time) (seconds 0.5))
       (set-time! (-> *bf-city-saved* reinforce-time))
       (bf-city-transports)
       )
     )
    ((= cmd BF_CITY_RESET)
     (bf-city-restore-hatred)
     (bf-city-ships-down)
     (bf-city-walls-down)
     )
    )
  (none)
  )

(defun bf-city-throw-grenade ((from vector) (to vector))
  "`*bf-city-grenade*`: the player throws a guard grenade from FROM onto TO, the projectile and arc
   of the grenade guards (guard-grenade.gc crimson-guard-method-264). Jak owns it and it skips him;
   with no charge it bursts where it lands."
  (let ((traj (new 'stack-no-clear 'traj3d-params)))
    (vector-copy! (-> traj src) from)
    (vector-copy! (-> traj dest) to)
    (set! (-> traj initial-tilt) 8192.0)
    (set! (-> traj gravity) 184320.0)
    (when (traj3d-calc-initial-velocity-using-tilt traj)
      (let ((params (new 'stack-no-clear 'projectile-init-by-other-params)))
        (set! (-> params ent) (-> *target* entity))
        (set! (-> params charge) 0.0)
        (set! (-> params options) (projectile-options))
        (vector-copy! (-> params pos) from)
        (vector-copy! (-> params vel) (-> traj initial-velocity))
        (set! (-> params notify-handle) (the-as handle #f))
        (set! (-> params owner-handle) (process->handle *target*))
        (set! (-> params target-handle) (the-as handle #f))
        (set! (-> params target-pos quad) (the-as uint128 0))
        (set! (-> params ignore-handle) (process->handle *target*))
        (let* ((info *game-info*)
               (id (+ (-> info attack-id) 1))
               )
          (set! (-> info attack-id) id)
          (set! (-> params attack-id) id)
          )
        (set! (-> params timeout) (seconds 4))
        (spawn-projectile vehicle-grenade-deflect params *target* *default-dead-pool*)
        )
      )
    )
  (none)
  )

;; install the hooks at every link of CWI (the previous values pointed into the previous link)
(set! *bf-city-hook* bf-city-command)
(set! *bf-city-grenade* bf-city-throw-grenade)
