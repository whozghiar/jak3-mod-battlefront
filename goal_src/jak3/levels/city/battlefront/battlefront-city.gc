;;-*-Lisp-*-
(in-package goal)

;; name: battlefront-city.gc
;; name in dgo: battlefront-city
;; dgos: CWI

#|
  Battlefront mod -- the part of a battle that needs Haven City's own types (attack controller,
  faction manager, the guards' grenade). Linked with CWI, so it only exists while Haven City is
  loaded; the GAME code (pc/features/battlefront/) reaches it through `*bf-city-hook*` and
  `*bf-city-grenade*`, which this file sets at link time, and calls them only while ctywide is
  active (a fresh link of this file).

  Hatred: the attack controller (wascity/mission-squad-control.gc) gives each unit the target of
  best score, its hatred times a distance factor times a crowd factor, twice for the one it has, and
  looks again now and then. During a battle every pair of foes takes the battle's own hatreds
  (`bf-city-apply-hatred`): the nearest foe first (the score falls to 0 at 120 m), kept until it
  dies (no look again), the player twice as hated as a unit by the other side and not at all by his
  own. The changed entries are saved first and written back when the battle ends.

  Battle points: the bases and a control point in each district (battlefront-h.gc
  `*bf-point-defs*`); the units take their lanes toward the nearest point their side holds, to
  defend it, or toward the nearest it does not (`bf-city-steer`, `bf-city-choose-branch`); each side's troop transports (bf-transport.gc) bring
  its units to the points it holds in the sections loaded, the nearest the player first
  (`bf-city-transports`): during a fight the traffic wakes none of the battle's units by itself
  (battlefront-h.gc `bf-wake-count`). The battlefield is the whole city: no force field.

  No Spargus citizen fights here: wastelanders brought into Haven City by the traffic engine froze
  or crashed the game within minutes (in the background collision query
  fill-bg-using-line-sphere-new, seen in two of two ten-minute battles; none in a battle without
  them). The Spargus Citizen class is gone too: nothing of the wastelanders loads in Haven City.
|#

;; DECOMP BEGINS

;; attack-controller types (city-target-type) of a battle: the player (the controller's
;; target-attacker), the Freedom League's guards (3 to 5: tazer, rifle, grenade; the blue jetpacks
;; register as rifle guards), the Krimzon Guard's units (9 to 12: roboguard, turret, spydroid, giant;
;; the red guards register as roboguards)
(defconstant BF_CTT_JAK 0)
(define *bf-ctt* (new 'static 'array int32 8 0 3 4 5 9 10 11 12))

(defconstant BF_HATE_REACH (meters 50))    ;; a foe beyond this scores 0: never chosen (120 m kept 40 guards
                                           ;; at their base shooting two jetpacks, none marching)
(defconstant BF_HATE_LOST (meters 150))    ;; a unit whose foe got this far looks again
(defconstant BF_HATE_PLAYER (meters 50))   ;; the other side turns onto the player this close
(defconstant BF_GUARD_RUN (* 1.5 (meters 12))) ;; a guard's run during a battle: 1.5 times the stock 12 m/s
(defconstant BF_CONTEST_REACH (meters 250)) ;; a unit this close to a contested point goes to clear it

(deftype bf-city-saved (structure)
  "Stock hatred indices overwritten during a battle, to write back at its end, and the battle's
   two hatreds pushed into the controller's list."
  ((saved?         symbol)
   (hatred         uint8 64)   ;; entry (row i, column j) of *bf-ctt* at 8 i + j
   (unit-info      int32)      ;; index of the battle's hatred between units
   (player-info    int32)      ;; index of the battle's hatred of the player
   (vals-length    int32)      ;; the list's length once they were pushed, 0 none
   (faction-time   time-frame) ;; last re-application of the battle's faction commands
   (reinforce-time time-frame) ;; last look at the sides' troop transports (`bf-city-transports`)
   (retarget-time  time-frame) ;; last look at the units near the player (`bf-city-retarget`)
   )
  )

(define *bf-city-saved* (new 'static 'bf-city-saved))

(defun bf-city-hatred-slot ((row int) (col int))
  "Index of the (attacker ROW, target COL) entry of the attack controller's hatred table."
  (+ (* row (-> *cty-attack-controller* max-num-object-types)) col)
  )

(defun bf-city-controller? ()
  "#t when Haven City's attack controller exists (it is built at ctywide login)."
  (and *cty-attack-controller* (nonzero? *cty-attack-controller*))
  )

(defun bf-ctt-team ((ctt int))
  "Side of attack-controller type CTT in a battle: BF_TEAM_FF, BF_TEAM_KG, the player's for 0,
   BF_TEAM_NONE for any other."
  (cond
    ((= ctt BF_CTT_JAK) (-> *bf* team))
    ((and (>= ctt 3) (<= ctt 5)) BF_TEAM_FF)
    ((and (>= ctt 9) (<= ctt 12)) BF_TEAM_KG)
    (else BF_TEAM_NONE)
    )
  )

(defun bf-city-push-hatreds ()
  "Push the battle's two hatreds into the controller's list when they are not there: at the first
   call, and after a death reset rebuilt the list (cty-attack-reset -> reset-hatred, then the stock
   init-attack-controller pushes its own again, 12 of 22). Both score the nearest foe first: 1 near,
   falling to 0 at BF_HATE_REACH (dist-scale 0), with no penalty for a crowd on it (attacker-scale 1),
   and keep it until it dies (chi1: no look again on the controller's timer). The player is twice
   as hated as a unit."
  (let ((ctrl *cty-attack-controller*)
        (saved *bf-city-saved*)
        )
    (when (or (zero? (-> saved vals-length)) (!= (-> ctrl hatred-vals length) (-> saved vals-length)))
      (when (>= (- (-> ctrl hatred-vals allocated-length) (-> ctrl hatred-vals length)) 2)
        (dotimes (i 2)
          (let ((info (push-back-hatred ctrl)))
            (set! (-> info hatred) (if (zero? i) 0.5 1.0))
            (set! (-> info hatred-dist) BF_HATE_REACH)
            (set! (-> info max-consider-dist) BF_HATE_REACH)
            (set! (-> info dist-scale) 0.0)
            (set! (-> info attacker-scale) 1.0)
            (set! (-> info flags) (city-hatred-info-flag chi1))
            (if (zero? i)
                (set! (-> saved unit-info) (the-as int (-> info index)))
                (set! (-> saved player-info) (the-as int (-> info index)))
                )
            )
          )
        (set! (-> saved vals-length) (-> ctrl hatred-vals length))
        )
      )
    )
  (none)
  )

(defun bf-city-apply-hatred ()
  "The battle's hatreds between every attacker and target type of *bf-ctt*: none between a side's
   own (the player's included), the battle's unit hatred between foes, its player hatred from the
   other side's units onto the player. The stock entries are saved the first time. Written on every
   call: a death reset rebuilds the stock table, and the writes are idempotent. Then no unit keeps
   the guards' anger at the player (a 'member-attacked from the player's shots gives a guard a
   hatred-map-callback onto him, guard.gc), so his own side never turns on him."
  (when (bf-city-controller?)
    (bf-city-push-hatreds)
    (let* ((ctrl *cty-attack-controller*)
           (saved *bf-city-saved*)
           (table (-> ctrl hatred-indices))
           )
      (when (not (-> saved saved?))
        (dotimes (i 8)
          (dotimes (j 8)
            (set! (-> saved hatred (+ (* 8 i) j)) (-> table (bf-city-hatred-slot (-> *bf-ctt* i) (-> *bf-ctt* j))))
            )
          )
        (set! (-> saved saved?) #t)
        )
      (when (nonzero? (-> saved vals-length))
        (dotimes (i 8)
          (dotimes (j 8)
            (let ((row (-> *bf-ctt* i))
                  (col (-> *bf-ctt* j))
                  )
              (when (!= row BF_CTT_JAK)
                (set! (-> table (bf-city-hatred-slot row col))
                      (cond
                        ((= (bf-ctt-team row) (bf-ctt-team col)) 0)
                        ((= col BF_CTT_JAK) (-> saved player-info))
                        (else (-> saved unit-info))
                        )
                      )
                )
              )
            )
          )
        )
      (dotimes (i (-> ctrl attackers length))
        (let ((info (-> ctrl attackers data i)))
          (if (>= (bf-ctt-team (-> info self-type)) 0)
              (set! (-> info hatred-map-callback) #f)
              )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-retarget ()
  "Twice a second every unit of the battle looks again for a target (mission-squad-control-method-13,
   the controller's own choice: the battle's hatred scores a foe by its distance, 0 beyond
   BF_HATE_REACH, and its current foe twice): the units attack what they see, a foe near enough
   instead of one far away, and a unit with no foe that near goes on to its point. A unit of the other side within BF_HATE_PLAYER of the player, its foe
   farther than him, turns onto him (the player's hatred); a unit of the player's side never keeps
   him as its foe."
  (when (and (bf-city-controller?) *target* (not (focus-test? *target* dead)))
    (let* ((ctrl *cty-attack-controller*)
           (jak (-> ctrl target-attacker self-index))
           (here (-> *target* control trans))
           )
      (dotimes (i (-> ctrl attackers length))
        (let ((info (-> ctrl attackers data i)))
          (when (and (logtest? (-> info flags) (city-attacker-info-flag cai0))
                     (!= i jak)
                     (>= (bf-ctt-team (-> info self-type)) 0)
                     )
            (let* ((pos (-> ctrl attacker-cache data i pos))
                   (foe (-> info enemy-index))
                   (foe-dist (if (>= foe 0)
                                 (vector-vector-xz-distance pos (-> ctrl attacker-cache data foe pos))
                                 BF_HATE_LOST
                                 )
                             )
                   (jak-dist (vector-vector-xz-distance pos here))
                   )
              (if (or (and (!= (bf-ctt-team (-> info self-type)) (-> *bf* team))
                           (!= foe jak)
                           (< jak-dist BF_HATE_PLAYER)
                           (< jak-dist foe-dist)
                           )
                      ;; the others too, unless on the player: each takes the foe it sees best now
                      (!= foe jak)
                      (and (>= foe 0) (< BF_HATE_LOST foe-dist))
                      ;; a unit of his own side on the player: a target taken before the battle's
                      ;; hatreds (the stock ones, while the zone loaded) is kept until it dies (seen in
                      ;; game: a red guard and a red jetpack aiming at a Krimzon Guard player)
                      (and (= foe jak) (= (bf-ctt-team (-> info self-type)) (-> *bf* team)))
                      )
                  (mission-squad-control-method-13 ctrl info)
                  )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-restore-hatred ()
  "Write back the entries `bf-city-apply-hatred` changed, and take the battle's two hatreds off the
   list when they are still its last."
  (when (and (bf-city-controller?) (-> *bf-city-saved* saved?))
    (let ((saved *bf-city-saved*)
          (table (-> *cty-attack-controller* hatred-indices))
          )
      (dotimes (i 8)
        (dotimes (j 8)
          (set! (-> table (bf-city-hatred-slot (-> *bf-ctt* i) (-> *bf-ctt* j))) (-> saved hatred (+ (* 8 i) j)))
          )
        )
      )
    )
  (when (and (bf-city-controller?)
             (nonzero? (-> *bf-city-saved* vals-length))
             (= (-> *cty-attack-controller* hatred-vals length) (-> *bf-city-saved* vals-length))
             )
    (+! (-> *cty-attack-controller* hatred-vals length) -2)
    )
  (set! (-> *bf-city-saved* vals-length) 0)
  (set! (-> *bf-city-saved* saved?) #f)
  (none)
  )

(defun bf-city-zone-branch? ((branch nav-branch))
  "#t when nav BRANCH (a lane of a segment, or the one a unit walks) belongs to a city section
   loaded now: it lies in that section's nav-graph branch array (the traffic engine patches each
   segment's branch to point there, traffic-engine.gc level-link). The whole city is the
   battlefield. #f for a missing branch."
  (let ((addr (the-as uint branch))
        (found #f)
        )
    (when (and branch (nonzero? addr))
      (dotimes (i (-> *level* length))
        (let ((lev (-> *level* level i)))
          (when (and (= (-> lev status) 'active) (nonzero? (-> lev bsp)) (nonzero? (-> lev bsp city-level-info)))
            (let ((graph (-> lev bsp city-level-info nav-graph)))
              (if (and (nonzero? graph)
                       (>= addr (the-as uint (-> graph branch-array 0)))
                       (< addr (the-as uint (-> graph branch-array (-> graph branch-count))))
                       )
                  (set! found #t)
                  )
              )
            )
          )
        )
      )
    found
    )
  )

(defun bf-keep-unit? ((unit process))
  "Called by the traffic engine (traffic-engine.gc, its per-frame check of the awake pedestrians)
   for UNIT outside the cells it keeps awake, the ones its camera's visibility marks: the stock
   sends such a unit back to its pool. During a fight, #t keeps it awake wherever the camera is
   while it walks a lane of a loaded section (`bf-city-zone-branch?`): units vanished out of the
   camera's view (the author's notes), and with them the fight the reserves count. One on no lane
   (a flying unit) stays awake."
  (and (bf-fighting?)
       (let ((branch (-> (the-as citizen unit) controller branch)))
         (or (not branch) (zero? (the-as uint branch)) (bf-city-zone-branch? branch))
         )
       )
  )

;; ---------------------------------------------------------------------------------------------
;; Battle points on the streets
;; ---------------------------------------------------------------------------------------------

(define *bf-city-hatch* (new 'static 'vector))

(defun bf-city-hatch-dir ((pos vector))
  "The way a troop transport over POS opens its hatch: the first of 12 directions, from toward the
   player turning a twelfth either way in turn, whose landing is on the street (bf-transport.gc `bf-transport-landing?`).
   A guard leaves the hatch only onto free nav mesh behind it, pinned to the ship until then.
   Toward the player alone, the ship at the Freedom League's headquarters faced a building and its
   guards never left; along the nearest lane, or toward the zone's middle first, ships stuck at
   bases near the player too, where toward him they had not. Returns `*bf-city-hatch*`, or #f when
   none (the ship then faces the player)."
  (let ((dir *bf-city-hatch*)
        (base (vector-! (new 'stack-no-clear 'vector) (target-pos 0) pos))
        (mesh (find-nearest-nav-mesh pos 8192.0))
        (found #f)
        )
    (set! (-> base y) 0.0)
    ;; the player under the ship: the hatch to -z, as the ship faced before (bf-transport.gc)
    (if (< (vector-length base) 409.6)
        (set-vector! base 0.0 0.0 -1.0 1.0)
        )
    (vector-normalize! base 1.0)
    (dotimes (k 12)
      (when (and mesh (not found))
        ;; 0, +30, -30, +60, -60 ... degrees from the player
        (vector-rotate-around-y! dir base (* (degrees 30) (the float (if (logtest? k 1) (/ (+ k 1) 2) (- (/ k 2))))))
        (set! (-> dir w) 1.0)
        (if (bf-transport-landing? pos dir mesh)
            (set! found #t)
            )
        )
      )
    (if found dir)
    )
  )

(define *bf-city-spot* (new 'static 'vector))

(defun bf-city-transports ()
  "Twice a second, for each battle point in a loaded section (battlefront.gc `bf-point-live?`):
   - not moved yet: onto the open ground nearest it (bf-transport.gc `bf-transport-spot`: ground,
     a nav mesh, nothing above up to 60 m), so the point stands in the open and its ship hovers
     right over it, through no roof or bridge;
   - held: a troop transport of its holder stationed over it, its side's place to bring units
     (bf-transport.gc: it drops them while the side lacks some, and stays);
   - taken by the other side: its ship leaves (`'leave`), and the new holder's comes once it has
     gone (`old-ship`).
   A point's ship leaves too when its section unloads. The ships are the director's children."
  (let ((parent (the-as process (handle->process (-> *bf* director)))))
    (when (and parent *target* (bf-fighting?))
      (dotimes (i (-> *bf* point-count))
        (let* ((pt (-> *bf* points i))
               (live? (bf-point-live? pt))
               (ship (handle->process (-> pt ship)))
               )
          (when (and live? (not (-> pt snapped?)))
            (set! (-> pt snapped?) #t)
            (when (bf-transport-spot (-> pt pos) *bf-city-spot*)
              (format 0 "battlefront: point ~D moved ~M onto open ground~%" i (vector-vector-distance (-> pt pos) *bf-city-spot*))
              (vector-copy! (-> pt pos) *bf-city-spot*)
              )
            )
          (cond
            ((and ship (or (not live?) (!= (-> (the-as bf-transport ship) team) (-> pt owner))))
             (send-event ship 'leave)
             (set! (-> pt old-ship) (-> pt ship))
             (set! (-> pt ship) (the-as handle #f))
             (format 0 "battlefront: the ship over point ~D leaves~%" i)
             )
            ((and (not ship) live? (>= (-> pt owner) 0) (not (handle->process (-> pt old-ship))))
             (when (bf-transport-spot (-> pt pos) *bf-city-spot*)
               (let* ((hatch (bf-city-hatch-dir *bf-city-spot*))
                      (new-ship (bf-transport-spawn parent *bf-city-spot* (-> pt owner) i hatch))
                      )
                 (when new-ship
                   (set! (-> pt ship) (process->handle new-ship))
                   (format 0 "battlefront: side ~D ship over point ~D, ~M from it~%" (-> pt owner) i
                           (vector-vector-xz-distance *bf-city-spot* (-> pt pos)))
                   )
                 )
               )
             )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-ships-down ()
  "Every troop transport of the battle gone at once (the battle's end, a regroup)."
  (dotimes (i BF_POINT_MAX)
    (let ((ship (handle->process (-> *bf* points i ship)))
          (old (handle->process (-> *bf* points i old-ship)))
          )
      (if ship
          (deactivate ship)
          )
      (if old
          (deactivate old)
          )
      (set! (-> *bf* points i ship) (the-as handle #f))
      (set! (-> *bf* points i old-ship) (the-as handle #f))
      )
    )
  (none)
  )

(defun bf-city-goal-point ((team int) (from vector))
  "The control point nearest FROM that side TEAM does not hold: its units' objective (battlefront.gc
   `bf-update-points` captures it once they hold it). -1 when TEAM holds every one."
  (let ((best -1)
        (best-d 0.0)
        )
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?)) (!= (-> pt owner) team))
          (let ((d (vector-vector-xz-distance (-> pt pos) from)))
            (when (or (< best 0) (< d best-d))
              (set! best i)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-city-guard-point ((team int) (from vector))
  "The control point nearest FROM that side TEAM holds in a loaded section (battlefront.gc
   `bf-point-live?`): the one its defenders keep. -1 for none."
  (let ((best -1)
        (best-d 0.0)
        )
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?)) (= (-> pt owner) team) (bf-point-live? pt))
          (let ((d (vector-vector-xz-distance (-> pt pos) from)))
            (when (or (< best 0) (< d best-d))
              (set! best i)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-city-contested-point ((team int) (from vector))
  "The contested control point nearest FROM within BF_CONTEST_REACH for side TEAM: units of the other
   side stand in its capture radius (`*bf*` points near, counted four times a second) while TEAM's
   units stand there too or TEAM holds it. -1 for none."
  (let ((best -1)
        (best-d 0.0)
        (foe (bf-other-team team))
        )
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?))
                   (> (-> pt near foe) 0)
                   (or (> (-> pt near team) 0) (= (-> pt owner) team))
                   )
          (let ((d (vector-vector-xz-distance (-> pt pos) from)))
            (when (and (< d BF_CONTEST_REACH) (or (< best 0) (< d best-d)))
              (set! best i)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-city-unit-goal ((proc process) (team int))
  "The point unit PROC of side TEAM heads for, as Star Wars Battlefront's units take the command
   posts: a contested point near it first (`bf-city-contested-point`), to clear it of the other
   side's units so the capture can go on; else the control point it guards, while its side holds it
   (bf-transport.gc `bf-post-point`: one unit in four a transport drops there); else the nearest
   point its side does not hold (`bf-city-goal-point`), to conquer it; with every control point
   held, the one nearest it (`bf-city-guard-point`). -1 for none."
  (let* ((pos (-> (the-as process-drawable proc) root trans))
         (contest (bf-city-contested-point team pos))
         (post (bf-post-point proc))
         )
    (cond
      ((>= contest 0) contest)
      ((and (>= post 0) (= (-> *bf* points post owner) team)) post)
      (else
        (let ((goal (bf-city-goal-point team pos)))
          (if (>= goal 0)
              goal
              (bf-city-guard-point team pos)
              )
          )
        )
      )
    )
  )

(defconstant BF_ROUTE_NODES 256) ;; lane nodes a route search looks at, at most

(deftype bf-route-work (structure)
  "The lane nodes a route search reached (`bf-city-route`), each with the first lane of its way."
  ((node   nav-node   BF_ROUTE_NODES)
   (first  nav-branch BF_ROUTE_NODES)
   )
  )

(define *bf-route-work* (new 'static 'bf-route-work))

(defun bf-city-route ((from nav-node) (goal vector))
  "The lane out of lane node FROM on the way to GOAL: a search breadth first over the lanes a
   faction may walk (dest-node-id-at-max?), BF_ROUTE_NODES nodes at most, through every loaded
   section (a section's links lead into the next one's graph), keeping the node reached nearest
   GOAL; the first lane of the way to it. A choice at each junction of the lane ending nearest the
   goal left the units in dead ends and detours, 140 to 200 m from a point next door. #f when no
   lane leaves FROM."
  (let ((w *bf-route-work*)
        (n 0)
        (head 0)
        (best -1)
        (best-d 0.0)
        )
    (dotimes (i (-> from branch-count))
      (let ((b (-> from branch-array i)))
        (when (and (< n BF_ROUTE_NODES) (dest-node-id-at-max? b))
          (set! (-> w node n) (-> b dest-node))
          (set! (-> w first n) b)
          (+! n 1)
          )
        )
      )
    (while (< head n)
      (let* ((node (-> w node head))
             (d (vector-vector-xz-distance (-> node position) goal))
             )
        (when (or (< best 0) (< d best-d))
          (set! best head)
          (set! best-d d)
          )
        (dotimes (i (-> node branch-count))
          (let ((b (-> node branch-array i)))
            (when (and (< n BF_ROUTE_NODES) (dest-node-id-at-max? b))
              (let* ((next (-> b dest-node))
                     (seen? (= next from))
                     )
                (dotimes (k n)
                  (if (= (-> w node k) next)
                      (set! seen? #t)
                      )
                  )
                (when (not seen?)
                  (set! (-> w node n) next)
                  (set! (-> w first n) (-> w first head))
                  (+! n 1)
                  )
                )
              )
            )
          )
        )
      (+! head 1)
      )
    (if (>= best 0)
        (-> w first best)
        )
    )
  )

;; The units' march to their point over the nav meshes (`bf-city-steer`, `bf-march-apply`). The
;; city's walking lanes are loops within a section: the Freedom League's base, in ctyslumc, has 138
;; lane nodes and no lane out of the section, and 173 of ctyslumb's 177 nodes have one lane out or
;; none; a citizen at a lane's dead end jumps to any lane 20 to 120 m behind it (citizen-method-208).
;; The lanes alone kept the units 140 to 290 m from a point next door. The meshes join the sections:
;; a nav-enemy standing on a mesh's link poly moves onto the next mesh (nav-enemy-method-188).
(defconstant BF_MARCH_MAX 128)          ;; units marching at once, at most (40 a side)
(defconstant BF_MARCH_NEAR (meters 12)) ;; a unit this close to its point walks the lanes around it
(defconstant BF_WAY_MESHES 768)         ;; nav meshes of the active levels the ways know, at most

(deftype bf-march (structure)
  "The units marching to their point, each with where it runs now (just past the link poly into its
   next mesh, or the point) and the mesh it was on then."
  ((count  int32)
   (unit   handle   BF_MARCH_MAX)
   (from   nav-mesh BF_MARCH_MAX)
   (to     vector   BF_MARCH_MAX :inline)
   (hop    int16    BF_MARCH_MAX)     ;; the bridge it crosses at `to` (100 + 2 k + side), -1 none
   (goal   nav-mesh BF_POINT_MAX)     ;; each point's mesh this tick, #f for none loaded
   )
  )

(defconstant BF_BRIDGE_MAX 8)           ;; bridges between meshes the ways know, at most
(defconstant BF_BRIDGE_GAP (meters 6))  ;; two meshes this close, with no link, get a bridge
(defconstant BF_BRIDGE_HOP (meters 2.5)) ;; a unit this close to a bridge's end crosses it

(deftype bf-ways (structure)
  "The way to each battle point from every nav mesh of the active levels (`bf-ways-build`): for
   point i and mesh k of `mesh`, `next` (at BF_WAY_MESHES i + k) holds the link of mesh k a unit
   takes toward the point, 100 + 2 b + s to cross bridge b from its side s (0 its mesh-a, 1 its
   mesh-b), -2 on the point's own mesh, -1 for no way. A bridge joins two meshes that touch with no
   link between them (`bf-ways-bridges`): a unit at one end (`end-a`, `end-b`, each 1.5 m inside
   its mesh) moves to the other (`bf-march-apply`)."
  ((count         int32)
   (time          time-frame)                     ;; last build
   (mesh          nav-mesh BF_WAY_MESHES)
   (next          int16    4608)                  ;; BF_POINT_MAX (6) times BF_WAY_MESHES
   (queue         int16    BF_WAY_MESHES)
   (prev          nav-mesh BF_WAY_MESHES)         ;; the meshes listed when the bridges were made
   (prev-count    int32)
   (bridge-count  int32)
   (mesh-a        int16    BF_BRIDGE_MAX)
   (mesh-b        int16    BF_BRIDGE_MAX)
   (end-a         vector   BF_BRIDGE_MAX :inline)
   (end-b         vector   BF_BRIDGE_MAX :inline)
   )
  )

(define *bf-ways* (new 'static 'bf-ways))

(define *bf-march* (new 'static 'bf-march))

(defun bf-march-link-poly ((m nav-mesh) (link int) (out vector))
  "OUT gets the centroid of mesh M's poly for LINK (pat 4, its link field LINK): a nav-enemy standing
   on it moves onto the mesh beyond (nav-enemy-method-188). #f when M has none."
  (dotimes (i (-> m poly-count))
    (let ((poly (-> m poly-array i)))
      (when (and (logtest? (-> poly pat) 4) (= (-> poly link) link))
        (poly-centroid m poly out)
        (return #t)
        )
      )
    )
  #f
  )

(defun bf-march-through ((m nav-mesh) (link int) (out vector))
  "OUT gets a spot 2 m past mesh M's poly for LINK toward the next mesh's own link poly: a unit sent
   there walks onto the link poly and across, where its own centroid would stop it short of it (the
   units crowded there). #f when M has no poly for LINK."
  (when (bf-march-link-poly m link out)
    (let* ((lk (-> m link-array link))
           (dest (-> lk dest-mesh))
           (there (new 'stack-no-clear 'vector))
           )
      (when (and dest (< (-> lk dest-link-poly-id) (-> dest poly-count)))
        (poly-centroid dest (-> dest poly-array (-> lk dest-link-poly-id)) there)
        (let ((dir (vector-! (new 'stack-no-clear 'vector) there out)))
          (set! (-> dir y) 0.0)
          (when (< (meters 0.1) (vector-length dir))
            (vector-normalize! dir (meters 2))
            (vector+! out out dir)
            )
          )
        )
      )
    #t
    )
  )

(defun bf-ways-index ((m nav-mesh))
  "Index of nav mesh M in `*bf-ways*` mesh, -1 when it is not listed."
  (let ((w *bf-ways*))
    (dotimes (k (-> w count))
      (if (= (-> w mesh k) m)
          (return k)
          )
      )
    )
  -1
  )

(defun bf-ways-linked? ((a nav-mesh) (b nav-mesh))
  "#t when one of mesh A's links leads to mesh B."
  (dotimes (l (-> a link-count))
    (if (= (-> a link-array l dest-mesh) b)
        (return #t)
        )
    )
  #f
  )

(defun bf-ways-bridges ()
  "The bridges of `*bf-ways*`: each pair of listed meshes with no link either way whose polys come
   within BF_BRIDGE_GAP of each other (a corner of one poly from a corner of the other, among the
   pair of polys whose centers are nearest), its ends 1.5 m inside each poly from those corners.
   The streets of Freedom HQ (ctyslumb) and the Slums (ctysluma) meet there with no link: the
   south's two meshes linked to the rest of the city only through the unloaded ruins, and its
   units could never reach a point of the north, nor the north's units one of the south."
  (let ((w *bf-ways*)
        (pa (new 'stack-no-clear 'vector))
        (pb (new 'stack-no-clear 'vector))
        (ca (new 'stack-no-clear 'vector))
        (cb (new 'stack-no-clear 'vector))
        (va (new 'stack-no-clear 'vector))
        (vb (new 'stack-no-clear 'vector))
        )
    (set! (-> w bridge-count) 0)
    (dotimes (i (-> w count))
      (dotimes (j (-> w count))
        (let ((ma (-> w mesh i))
              (mb (-> w mesh j))
              )
          (when (and (< i j)
                     (< (-> w bridge-count) BF_BRIDGE_MAX)
                     (not (bf-ways-linked? ma mb))
                     (not (bf-ways-linked? mb ma))
                     ;; their bounding spheres overlap or nearly
                     (< (vector-vector-distance (the-as vector (-> ma bounds)) (the-as vector (-> mb bounds)))
                        (+ (-> ma bounds r) (-> mb bounds r) BF_BRIDGE_GAP)
                        )
                     )
            (let ((best -1.0)
                  (best-a -1)
                  (best-b -1)
                  )
              ;; the polys whose centers are nearest
              (dotimes (x (-> ma poly-count))
                (poly-centroid ma (-> ma poly-array x) pa)
                (dotimes (y (-> mb poly-count))
                  (poly-centroid mb (-> mb poly-array y) pb)
                  (let ((d (vector-vector-distance pa pb)))
                    (when (or (< best 0.0) (< d best))
                      (set! best d)
                      (set! best-a x)
                      (set! best-b y)
                      )
                    )
                  )
                )
              (when (>= best-a 0)
                (let ((polya (-> ma poly-array best-a))
                      (polyb (-> mb poly-array best-b))
                      (gap -1.0)
                      )
                  (poly-centroid ma polya ca)
                  (poly-centroid mb polyb cb)
                  ;; their nearest corners
                  (dotimes (x (the-as int (-> polya vertex-count)))
                    (dotimes (y (the-as int (-> polyb vertex-count)))
                      (vector+! pa (-> polya vertex x) (the-as vector (-> ma bounds)))
                      (vector+! pb (-> polyb vertex y) (the-as vector (-> mb bounds)))
                      (let ((d (vector-vector-distance pa pb)))
                        (when (or (< gap 0.0) (< d gap))
                          (set! gap d)
                          (vector-copy! va pa)
                          (vector-copy! vb pb)
                          )
                        )
                      )
                    )
                  (when (and (>= gap 0.0) (< gap BF_BRIDGE_GAP))
                    (let ((k (-> w bridge-count)))
                      (set! (-> w mesh-a k) i)
                      (set! (-> w mesh-b k) j)
                      ;; 1.5 m inside each poly from its corner, toward its center
                      (vector+! (-> w end-a k) va (vector-normalize! (vector-! (new 'stack-no-clear 'vector) ca va) (meters 1.5)))
                      (vector+! (-> w end-b k) vb (vector-normalize! (vector-! (new 'stack-no-clear 'vector) cb vb) (meters 1.5)))
                      (format 0 "battlefront: bridge ~D between meshes ~D and ~D, corners ~M apart~%" k i j gap)
                      (+! (-> w bridge-count) 1)
                      )
                    )
                  (if (and (>= gap BF_BRIDGE_GAP) (< best (meters 40)))
                      (format 0 "battlefront: no bridge between meshes ~D and ~D, corners ~M apart~%" i j gap)
                      )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-ways-build ()
  "Every 10 s of a fight: list the nav meshes of the active levels (their bsp nav-meshes), then for
   each battle point a search breadth first from its own mesh (`*bf-march*` goal) over the meshes'
   links, unbounded: each mesh reached keeps its own link back toward the mesh it was reached from
   (the links join two meshes both ways). A unit then finds the first link of its way to any point
   in its own mesh's entry (`bf-march-waypoint`). A search from each unit's mesh, 96 then 160
   meshes at most, found no way from the Freedom League's base once the whole city was loaded: its
   guards stayed between their base and Freedom HQ, no one of them marching."
  (let ((w *bf-ways*)
        (march *bf-march*)
        )
    (set! (-> w count) 0)
    (dotimes (li (-> *level* length))
      (let ((lev (-> *level* level li)))
        (when (= (-> lev status) 'active)
          (let ((meshes (-> lev bsp nav-meshes)))
            (when (nonzero? meshes)
              (dotimes (i (-> meshes length))
                (let ((m (-> meshes i nav-mesh)))
                  (when (and m (< (-> w count) BF_WAY_MESHES))
                    (set! (-> w mesh (-> w count)) m)
                    (+! (-> w count) 1)
                    )
                  )
                )
              )
            )
          )
        )
      )
    ;; the bridges again when the meshes listed changed (a search over every pair of polys)
    (let ((same? (= (-> w count) (-> w prev-count))))
      (dotimes (k (-> w count))
        (if (!= (-> w mesh k) (-> w prev k))
            (set! same? #f)
            )
        )
      (when (not same?)
        (dotimes (k (-> w count))
          (set! (-> w prev k) (-> w mesh k))
          )
        (set! (-> w prev-count) (-> w count))
        (bf-ways-bridges)
        )
      )
    (dotimes (pt (-> *bf* point-count))
      (let ((base (* pt BF_WAY_MESHES))
            (g (bf-ways-index (-> march goal pt)))
            (head 0)
            (tail 0)
            )
        (dotimes (k (-> w count))
          (set! (-> w next (+ base k)) -1)
          )
        (when (>= g 0)
          (set! (-> w next (+ base g)) -2)
          (set! (-> w queue 0) g)
          (set! tail 1)
          (while (< head tail)
            (let ((cur (-> w mesh (-> w queue head))))
              (dotimes (l (-> cur link-count))
                (let* ((nb (-> cur link-array l dest-mesh))
                       (nbi (if nb (bf-ways-index nb) -1))
                       )
                  (when (and (>= nbi 0) (= (-> w next (+ base nbi)) -1))
                    ;; the neighbour's own link back to this mesh
                    (dotimes (b (-> nb link-count))
                      (when (= (-> nb link-array b dest-mesh) cur)
                        (set! (-> w next (+ base nbi)) b)
                        (set! (-> w queue tail) nbi)
                        (+! tail 1)
                        (set! b (the-as int (-> nb link-count)))
                        )
                      )
                    )
                  )
                )
              ;; and over the bridges: the mesh at the other end crosses back to this one
              (let ((ci (-> w queue head)))
                (dotimes (k (-> w bridge-count))
                  (let ((other (cond
                                 ((= (-> w mesh-a k) ci) (-> w mesh-b k))
                                 ((= (-> w mesh-b k) ci) (-> w mesh-a k))
                                 (else -1)
                                 )
                               )
                        )
                    (when (and (>= other 0) (= (-> w next (+ base other)) -1))
                      ;; from the other end's side: 0 when it is the bridge's mesh-a
                      (set! (-> w next (+ base other)) (+ 100 (* 2 k) (if (= (-> w mesh-a k) other) 0 1)))
                      (set! (-> w queue tail) other)
                      (+! tail 1)
                      )
                    )
                  )
                )
              )
            (+! head 1)
            )
          )
        )
      )
    (set-time! (-> w time))
    )
  (none)
  )

(defun bf-march-waypoint ((unit nav-enemy) (goal int) (pos vector) (out vector))
  "Where UNIT runs now on its way to point GOAL at POS: POS itself on the point's mesh; else just
   past the link poly of its own mesh that starts its way there (`*bf-ways*`, `bf-march-through`),
   or the end of a bridge on its mesh (`bf-ways-bridges`). #f when no way."
  (let* ((m (-> unit nav state mesh))
         (k (if m (bf-ways-index m) -1))
         (nx (if (>= k 0) (-> *bf-ways* next (+ (* goal BF_WAY_MESHES) k)) -1))
         )
    (cond
      ((= nx -2)
       (vector-copy! out pos)
       #t
       )
      ((>= nx 100)
       (let ((b (/ (- nx 100) 2)))
         (vector-copy! out (if (zero? (logand (- nx 100) 1)) (-> *bf-ways* end-a b) (-> *bf-ways* end-b b)))
         )
       #t
       )
      ((>= nx 0)
       (bf-march-through m nx out)
       )
      (else
        #f
        )
      )
    )
  )

(defun bf-marching? ((unit process))
  "#t when UNIT marches now (`*bf-march*`)."
  (let ((h (process->handle unit))
        (w *bf-march*)
        )
    (dotimes (i (-> w count))
      (if (= (-> w unit i) h)
          (return #t)
          )
      )
    )
  #f
  )

(defun bf-march-plan ((unit citizen) (team int))
  "In `bf-city-steer`: UNIT of side TEAM, walking its lanes ('active) more than BF_MARCH_NEAR from
   its point (`bf-city-unit-goal`) in a loaded section, marches there: `*bf-march*` gets it with its
   waypoint (`bf-march-waypoint`) and its mesh now. A unit walking its lanes near its point walks
   again (its walking speed: a march runs)."
  (let ((w *bf-march*)
        (goal (bf-city-unit-goal unit team))
        )
    (when (and (-> unit nav) (= (-> unit next-state name) 'active))
      (cond
        ((and (>= goal 0) (< (-> w count) BF_MARCH_MAX) (-> w goal goal)
              (< BF_MARCH_NEAR (vector-vector-xz-distance (-> unit root trans) (-> *bf* points goal pos)))
              (bf-march-waypoint unit goal (-> *bf* points goal pos) (-> w to (-> w count)))
              )
         (set! (-> w unit (-> w count)) (process->handle unit))
         (set! (-> w from (-> w count)) (-> unit nav state mesh))
         ;; a bridge to cross at the waypoint: its code from the ways
         (let* ((k (bf-ways-index (-> unit nav state mesh)))
                (nx (if (>= k 0) (-> *bf-ways* next (+ (* goal BF_WAY_MESHES) k)) -1))
                )
           (set! (-> w hop (-> w count)) (if (>= nx 100) nx -1))
           )
         (+! (-> w count) 1)
         )
        (else
          (set! (-> unit nav target-speed) (* (-> unit speed-scale) (-> unit speed-walk)))
          )
        )
      )
    )
  (none)
  )

(defun bf-march-apply ()
  "Every frame of the fight: each marching unit (`*bf-march*`), still walking its lanes ('active),
   runs to its waypoint: its controller's dest-point, which the citizen's 'active post gives its nav
   control as target each frame (citizen.gc), the nav control finding the way across the mesh. The
   lanes set it again at a lane's end; this puts it back the next frame. No idle stop on the way
   (wait-time: the 'active trans stops the unit once it is over). A unit that moved onto its next
   mesh is left to its lanes until the next plan, which sends it on."
  (let ((w *bf-march*))
    (dotimes (i (-> w count))
      (let ((unit (the-as citizen (handle->process (-> w unit i)))))
        (when (and unit (= (-> unit next-state name) 'active) (-> unit nav))
          (cond
            ((!= (-> unit nav state mesh) (-> w from i))
             (set! (-> w unit i) (the-as handle #f))
             )
            ;; at a bridge's end: onto the other mesh, just across the seam
            ((and (>= (-> w hop i) 100)
                  (< (vector-vector-xz-distance (-> unit root trans) (-> w to i)) BF_BRIDGE_HOP)
                  )
             (let* ((code (- (-> w hop i) 100))
                    (b (/ code 2))
                    (from-a? (zero? (logand code 1)))
                    (dest (-> *bf-ways* mesh (if from-a? (-> *bf-ways* mesh-b b) (-> *bf-ways* mesh-a b))))
                    )
               (change-to dest unit)
               (move-to-point! (-> unit root) (if from-a? (-> *bf-ways* end-b b) (-> *bf-ways* end-a b)))
               (set! (-> w unit i) (the-as handle #f))
               )
             )
            (else
              (vector-copy! (-> unit dest-point) (-> w to i))
              (set! (-> unit wait-time) (seconds 3600))
              (set! (-> unit nav target-speed) (* (-> unit speed-scale) (-> unit speed-run)))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-choose-branch ((ctrl vehicle-controller) (unit vehicle))
  "The lane a unit of the battle takes at the end of its lane (its controller's
   choose-branch-callback, `bf-city-steer`): the first lane of its way to its point
   (`bf-city-unit-goal`, `bf-city-route`). The lane graph joins every loaded section, so the unit
   finds its way across them; at its point it keeps turning back across it, where a capture counts
   it (within 20 m it used to wander at random, and its point's 15 m seldom held a defender). With
   no point, or marching over the meshes (`bf-marching?`: its waypoint, not a lane, leads it; the
   post asks for a lane every frame near it), the stock random lane (vehicle-controller method 15)."
  (let* ((proc (the-as process unit))
         (team (bf-unit-team proc))
         (goal (if (and (bf-fighting?) (>= team 0) (not (bf-marching? proc))) (bf-city-unit-goal proc team) -1))
         )
    (if (< goal 0)
        (vehicle-controller-method-15 ctrl)
        (let ((first (bf-city-route (-> ctrl branch dest-node) (-> *bf* points goal pos))))
          (if first
              first
              (vehicle-controller-method-15 ctrl)
              )
          )
        )
    )
  )

(defun bf-city-unit-minimap ((proc process))
  "The game's minimap mark of unit PROC: a crimson-guard's, or a kg-squad-member's (flying turret,
   roboguard, spider robot). #f for none."
  (cond
    ((type? proc crimson-guard) (-> (the-as crimson-guard proc) minimap))
    ((type? proc kg-squad-member) (-> (the-as kg-squad-member proc) minimap))
    (else (the-as connection-minimap #f))
    )
  )

(defun bf-city-steer ()
  "Twice a second, each unit of the battle: a guard's run at
   BF_GUARD_RUN (its run clip plays by the ground it covers, citizen-travel-anim, so its legs keep
   pace); away from its point it marches there over the nav meshes (`bf-march-plan`), and near it
   takes its lanes with `bf-city-choose-branch` (its controller's choose-branch-callback, the stock
   random pick otherwise), and fights what it meets on the way (the attack controller). The unit
   pools are rebuilt with the stock callbacks and speeds at each end of a battle (`initialize!`
   'life)."
  (let ((te *traffic-engine*)
        (w *bf-march*)
        )
    (set! (-> w count) 0)
    (dotimes (i (-> *bf* point-count))
      (set! (-> w goal i) (find-nearest-nav-mesh (-> *bf* points i pos) (meters 2)))
      )
    ;; the ways to the points over every loaded mesh, built again every 10 s
    (if (or (zero? (-> *bf-ways* count)) (time-elapsed? (-> *bf-ways* time) (seconds 10)))
        (bf-ways-build)
        )
    (when (and te (nonzero? te))
      (dotimes (ti 2)
        (let ((tr (-> te tracker-array ti)))
          (dotimes (i (-> tr active-object-count))
            (let ((proc (handle->process (-> tr active-object-list i))))
              (when (and proc (>= (bf-unit-team proc) 0))
                (if (type? proc crimson-guard)
                    (set! (-> (the-as crimson-guard proc) speed-run) BF_GUARD_RUN)
                    )
                )
              (when (and proc (type? proc citizen) (>= (bf-unit-team proc) 0))
                (let ((ctrl (-> (the-as citizen proc) controller)))
                  (if (!= (-> ctrl choose-branch-callback) bf-city-choose-branch)
                      (set! (-> ctrl choose-branch-callback) bf-city-choose-branch)
                      )
                  )
                (bf-march-plan (the-as citizen proc) (bf-unit-team proc))
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-sleep-all ()
  "As the fight starts: every unit of the battle awake goes back to its pool (`bf-transport-sleep`),
   so each side's units all come from its own ships, at its base first."
  (let ((te *traffic-engine*)
        (n 0)
        )
    (when (and te (nonzero? te))
      (dotimes (ti 2)
        (let ((tr (-> te tracker-array ti)))
          ;; from the end: a unit put to sleep leaves the list
          (countdown (i (-> tr active-object-count))
            (let ((proc (handle->process (-> tr active-object-list i))))
              (when (and proc (>= (bf-unit-team proc) 0))
                (deactivate-object tr (the-as int i) #t)
                (+! n 1)
                )
              )
            )
          )
        )
      )
    (format 0 "battlefront: ~D units of the battle put back to sleep as the fight starts~%" n)
    )
  (none)
  )

(defun bf-city-dots ()
  "Every frame of the fight: the units awake into `*bf-unit-dots*`, their places, headings and sides,
   for the maps (battlefront.gc `bf-draw-city-map`: the respawn page, R3, the START page), and each
   one's mark on the game's minimap in its side's color."
  (let ((te *traffic-engine*)
        (dots *bf-unit-dots*)
        )
    (set! (-> dots count) 0)
    (when (and te (nonzero? te))
      (dotimes (ti 2)
        (let ((tr (-> te tracker-array ti)))
          (dotimes (i (-> tr active-object-count))
            (let ((proc (the-as process-drawable (handle->process (-> tr active-object-list i)))))
              (when (and proc (>= (bf-unit-team proc) 0) (< (-> dots count) BF_DOT_MAX))
                ;; its minimap mark in its side's color: the stock guard's blue one for the Freedom
                ;; League (class 25, guard-frustum), the stock robot's red one for the Krimzon Guard
                ;; (139, robot-frustum), where the stock gives the guard's to every crimson-guard
                ;; (the red guards too) and the robot's to every flying turret (the blue jetpacks
                ;; too); every frame, from the first one it is awake
                (let ((mm (bf-city-unit-minimap proc)))
                  (if mm
                      (set! (-> mm class) (-> *minimap-class-list* (if (= (bf-unit-team proc) BF_TEAM_FF) 25 139)))
                      )
                  )
                (let ((k (-> dots count)))
                  (vector-copy! (-> dots pos k) (-> proc root trans))
                  (set! (-> dots yaw k) (vector-y-angle (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> proc root quat))))
                  (set! (-> dots team k) (bf-unit-team proc))
                  (+! (-> dots count) 1)
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-ways-reach ((pt int))
  "Nav meshes with a way to point PT (`*bf-ways*`), for the tests; the meshes listed when PT is -1."
  (let ((w *bf-ways*)
        (n 0)
        )
    (if (< pt 0)
        (return (the-as int (-> w count)))
        )
    (dotimes (k (-> w count))
      (if (!= (-> w next (+ (* pt BF_WAY_MESHES) k)) -1)
          (+! n 1)
          )
      )
    n
    )
  )

(defun bf-ways-dump ()
  "Print every nav mesh the ways know: its level, center, radius and links (the index of each
   link's mesh, -1 for a mesh not loaded), for the tests."
  (let ((w *bf-ways*))
    (dotimes (k (-> w count))
      (let ((m (-> w mesh k))
            (lev-name #f)
            )
        (dotimes (li (-> *level* length))
          (let ((lev (-> *level* level li)))
            (when (= (-> lev status) 'active)
              (let ((meshes (-> lev bsp nav-meshes)))
                (when (nonzero? meshes)
                  (dotimes (i (-> meshes length))
                    (if (= (-> meshes i nav-mesh) m)
                        (set! lev-name (-> lev name))
                        )
                    )
                  )
                )
              )
            )
          )
        (format 0 "SMOKE mesh ~D ~A at ~M ~M r ~M polys ~D links:" k lev-name (-> m bounds x) (-> m bounds z) (-> m bounds r) (-> m poly-count))
        (dotimes (l (-> m link-count))
          (let ((d (-> m link-array l dest-mesh)))
            (format 0 " ~D" (if d (bf-ways-index d) -1))
            )
          )
        (format 0 "~%")
        )
      )
    )
  (none)
  )

(defun bf-ways-gap ((a int) (b int))
  "Print the two polys of meshes A and B (`*bf-ways*` indices) whose centroids are nearest, and
   their distance, for the tests."
  (let ((ma (-> *bf-ways* mesh a))
        (mb (-> *bf-ways* mesh b))
        (pa (new 'stack-no-clear 'vector))
        (pb (new 'stack-no-clear 'vector))
        (best-a (new 'stack-no-clear 'vector))
        (best-b (new 'stack-no-clear 'vector))
        (best -1.0)
        )
    (dotimes (i (-> ma poly-count))
      (poly-centroid ma (-> ma poly-array i) pa)
      (dotimes (j (-> mb poly-count))
        (poly-centroid mb (-> mb poly-array j) pb)
        (let ((d (vector-vector-distance pa pb)))
          (when (or (< best 0.0) (< d best))
            (set! best d)
            (vector-copy! best-a pa)
            (vector-copy! best-b pb)
            )
          )
        )
      )
    (format 0 "SMOKE gap ~D-~D: ~M between ~M ~M ~M" a b best (-> best-a x) (-> best-a y) (-> best-a z))
    (format 0 " and ~M ~M ~M~%" (-> best-b x) (-> best-b y) (-> best-b z))
    )
  (none)
  )

(defun bf-city-march-count ((team int))
  "Units of side TEAM marching now (`*bf-march*`), for the tests."
  (let ((n 0)
        (w *bf-march*)
        )
    (dotimes (i (-> w count))
      (let ((p (handle->process (-> w unit i))))
        (if (and p (= (bf-unit-team p) team))
            (+! n 1)
            )
        )
      )
    n
    )
  )

(defun bf-city-guard-speed ()
  "The fastest awake guard of the battle now, its nav speed (units a second), for the tests: a run
   at BF_GUARD_RUN reaches 18 m/s."
  (let ((te *traffic-engine*)
        (best 0.0)
        )
    (when (and te (nonzero? te))
      (dotimes (ti 2)
        (let ((tr (-> te tracker-array ti)))
          (dotimes (i (-> tr active-object-count))
            (let ((proc (handle->process (-> tr active-object-list i))))
              (when (and proc (type? proc crimson-guard) (-> (the-as crimson-guard proc) nav))
                (set! best (fmax best (-> (the-as crimson-guard proc) nav state speed)))
                )
              )
            )
          )
        )
      )
    best
    )
  )

(defun bf-city-free-navs ()
  "Just before an `initialize!` 'life (a battle's start or end, a far respawn): every unit of the
   traffic's pools, asleep or awake, that holds a nav-control on the engine's `*default-nav-mesh*`
   gives it back (remove-process-drawable). A new unit takes one there (citizen.gc, its enemy
   info's nav mesh) until it is first woken onto a street's mesh, and the reset left the old pools'
   ones taken while the new pools took theirs: 41 of the 128 before a far respawn's reset, 115 a
   second after it, and a new guard's setup crashed the game on the next (nav-enemy setup-enemy!).
   The units go in the reset."
  (let ((te *traffic-engine*)
        (n 0)
        )
    (when (and te (nonzero? te))
      (dotimes (ty 29)
        (let ((info (-> te object-type-info-array ty)))
          (dotimes (i (-> info inactive-count))
            (let ((proc (the-as process-drawable (handle->process (-> info array i)))))
              (when (and proc (nonzero? (-> proc nav)) (-> proc nav) (= (-> proc nav state mesh) *default-nav-mesh*))
                (remove-process-drawable *default-nav-mesh* proc)
                (+! n 1)
                )
              )
            )
          )
        )
      (dotimes (ti 2)
        (let ((tr (-> te tracker-array ti)))
          (dotimes (i (-> tr active-object-count))
            (let ((proc (the-as process-drawable (handle->process (-> tr active-object-list i)))))
              (when (and proc (nonzero? (-> proc nav)) (-> proc nav) (= (-> proc nav state mesh) *default-nav-mesh*))
                (remove-process-drawable *default-nav-mesh* proc)
                (+! n 1)
                )
              )
            )
          )
        )
      (format 0 "battlefront: ~D units gave back the default nav mesh (~D of ~D now taken)~%" n
              (-> *default-nav-mesh* nav-control-count) (-> *default-nav-mesh* max-nav-control-count))
      )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Force fields: the ruins of the old town and the Metal Head nest closed (round 19)
;; ---------------------------------------------------------------------------------------------

;; ctywide-obs.o comes after this file in CWI
(define-extern spawn-security-wall (function process vector vector float symbol handle))

(defconstant BF_FIELD_COUNT 2)

;; Each force field's ends, world x, y and z in meters, and its height. The ruins' is the game's own
;; security-wall-12 (ctyslumb), the street from Freedom HQ's district into the ruins (ctygenb), which
;; the game drops after its first task; the nest's crosses the street from the Port to the Metal
;; Head nest (mhcitya), just short of its dark eco door (mhcity-dark-eco-door-1, -381 m, 1199 m),
;; read off the START menu's map.
(define *bf-field-ends* (new 'static 'array float 14
                          389.75 7.94 -18.44 389.75 7.94 -70.72 40.0
                          -410.0 7.0 1212.0 -335.0 7.0 1212.0 40.0
                          )
        )

(deftype bf-city-fields (structure)
  "The force fields' walls (security-wall-child processes, children of the director)."
  ((wall  handle BF_FIELD_COUNT)
   )
  )

(define *bf-city-fields* (new 'static 'bf-city-fields))

(dotimes (i BF_FIELD_COUNT)
  (set! (-> *bf-city-fields* wall i) (the-as handle #f))
  )

(defun bf-city-fields-up ()
  "Twice a second in a fight: each force field's wall (`*bf-field-ends*`) spawned again when it is
   gone (a battle's start, a far respawn's reset): `spawn-security-wall` (ctywide-obs.gc), solid to
   Jak and drawn red wherever ctywide is loaded."
  (let ((parent (handle->process (-> *bf* director)))
        (a (new 'stack-no-clear 'vector))
        (b (new 'stack-no-clear 'vector))
        )
    (when parent
      (dotimes (i BF_FIELD_COUNT)
        (when (not (handle->process (-> *bf-city-fields* wall i)))
          (let ((e (* i 7)))
            (set-vector! a (meters (-> *bf-field-ends* e)) (meters (-> *bf-field-ends* (+ e 1)))
                         (meters (-> *bf-field-ends* (+ e 2))) 1.0)
            (set-vector! b (meters (-> *bf-field-ends* (+ e 3))) (meters (-> *bf-field-ends* (+ e 4)))
                         (meters (-> *bf-field-ends* (+ e 5))) 1.0)
            (set! (-> *bf-city-fields* wall i)
                  (spawn-security-wall parent a b (meters (-> *bf-field-ends* (+ e 6))) #f)
                  )
            (format 0 "battlefront: force field ~D up~%" i)
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-fields-down ()
  "Every force field's wall gone (the battle's end, a far respawn's reset)."
  (dotimes (i BF_FIELD_COUNT)
    (let ((wall (handle->process (-> *bf-city-fields* wall i))))
      (if wall
          (deactivate wall)
          )
      (set! (-> *bf-city-fields* wall i) (the-as handle #f))
      )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; Reinforcements from the edge, as Star Wars Battlefront's command posts (round 19)
;; ---------------------------------------------------------------------------------------------

(defconstant BF_EDGE_MIN (meters 60)) ;; an edge spawn stands at least this far from the player
(defconstant BF_EDGE_MAX (meters 220)) ;; and at most this far: its street's nav mesh and ground loaded
(define *bf-edge-min* BF_EDGE_MIN)     ;; the distance the current search asks for

(defun bf-city-branch-level ((branch nav-branch))
  "The active city section whose nav graph holds BRANCH (`bf-city-zone-branch?`), #f for none."
  (let ((addr (the-as uint branch)))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (and (= (-> lev status) 'active) (nonzero? (-> lev bsp)) (nonzero? (-> lev bsp city-level-info)))
          (let ((graph (-> lev bsp city-level-info nav-graph)))
            (if (and (nonzero? graph)
                     (>= addr (the-as uint (-> graph branch-array 0)))
                     (< addr (the-as uint (-> graph branch-array (-> graph branch-count))))
                     )
                (return lev)
                )
            )
          )
        )
      )
    )
  (the-as level #f)
  )

(defun bf-city-edge-segment ((found traffic-find-segment-struct) (seg nav-segment))
  "Callback of `bf-city-edge-spawn`'s search: keep the pedestrian segment the traffic could fill now
   (the stock spawn's tests, as the old reinforcements), in a loaded section other than the closed
   ruins and nest (ctygenb, mhcitya, mhcityb), its nav mesh loaded, `*bf-edge-min*` to BF_EDGE_MAX
   from the player: the one furthest along `found` dir (the way to the side's territory), give or
   take 20 m at random. A segment 540 m off had no nav mesh loaded: the traffic woke its unit
   without one (traffic-engine.gc activate-by-type, `get-nav-mesh` #f), the unit found no ground and
   kept its default nav mesh's nav-control, and the next reset overflowed that mesh (a crash)."
  (let ((lev (bf-city-branch-level (-> seg branch))))
    (when (and lev *target*
               (nonzero? (-> seg nav-mesh-id))
               (not (or (= (-> lev name) 'ctygenb) (= (-> lev name) 'mhcitya) (= (-> lev name) 'mhcityb)))
               (< (-> seg branch density) (the-as uint 128))
               (not (can-dest-be-used? *traffic-engine* (-> seg branch)))
               (< *bf-edge-min* (vector-vector-xz-distance (-> seg vertex 0) (-> *target* control trans)))
               (< (vector-vector-xz-distance (-> seg vertex 0) (-> *target* control trans)) BF_EDGE_MAX)
               (get-nav-mesh (the-as actor-id (-> seg nav-mesh-id)))
               )
      (let* ((d (vector-! (new 'stack-no-clear 'vector) (-> seg vertex 0) (-> *target* control trans)))
             (rating (+ (vector-dot d (-> found dir)) (* (rand-vu) (meters 20))))
             )
        (when (or (not (-> found best-seg)) (< (-> found best-rating) rating))
          (set! (-> found best-rating) rating)
          (set! (-> found best-seg) seg)
          )
        )
      )
    )
  (none)
  )

(defun bf-city-team-live? ((team int))
  "#t when side TEAM holds a point in a loaded section (battlefront.gc `bf-point-live?`): its ship
   stationed there brings its units (bf-transport.gc)."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (if (and (= (-> pt owner) team) (bf-point-live? pt))
          (return #t)
          )
      )
    )
  #f
  )

(defun bf-city-edge-spawn ()
  "Twice a second in a fight: a side that holds no point in the loaded sections still fights here,
   as Star Wars Battlefront's armies come from every command post: one of its units a tick, of the
   kind it lacks most against its caps (bf-transport.gc `bf-transport-next-kind`, which puts one
   of its side's sleeping units first in the pool), comes in on a street of the loaded area's edge
   toward its nearest held point, 60 to 220 m from the player (from 30 m when none is that far),
   and marches on its point. A side with a point here gets its units from its ship there."
  (let ((te *traffic-engine*))
    (when (and te (nonzero? te) *target* (bf-fighting?))
      (dotimes (team 2)
        (when (not (bf-city-team-live? team))
          (let ((kind (bf-transport-next-kind team)))
            (when (>= kind 0)
              (let ((found (new 'stack-no-clear 'traffic-find-segment-struct))
                    (near -1)
                    (near-d 0.0)
                    (info (-> te object-type-info-array kind))
                    )
                ;; the way to its territory: its held point nearest the player
                (dotimes (i (-> *bf* point-count))
                  (when (= (-> *bf* points i owner) team)
                    (let ((d (vector-vector-xz-distance (-> *bf* points i pos) (-> *target* control trans))))
                      (when (or (< near 0) (< d near-d))
                        (set! near i)
                        (set! near-d d)
                        )
                      )
                    )
                  )
                (when (>= near 0)
                  (vector-! (-> found dir) (-> *bf* points near pos) (-> *target* control trans))
                  (set! (-> found dir y) 0.0)
                  (vector-normalize! (-> found dir) 1.0)
                  (let ((before (-> info active-count)))
                    (dotimes (pass 2)
                      (when (= (-> info active-count) before)
                        (set! *bf-edge-min* (if (zero? pass) BF_EDGE_MIN (meters 30)))
                        (set! (-> found best-seg) #f)
                        (set! (-> found best-rating) 0.0)
                        (let ((sphere (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
                          (set! (-> sphere w) (meters 600))
                          (callback-on-nav-segments-in-sphere te sphere 1 found bf-city-edge-segment)
                          )
                        (if (-> found best-seg)
                            (activate-by-type (-> te tracker1) (the-as traffic-type kind) (-> found best-seg) 0.0)
                            )
                        )
                      )
                    (if (!= (-> info active-count) before)
                        (format 0 "battlefront: side ~D unit came in at the edge, ~M from the player~%" team
                                (vector-vector-xz-distance (-> found best-seg vertex 0) (-> *target* control trans)))
                        )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun bf-city-command ((cmd int))
  "`*bf-city-hook*`. CMD: BF_CITY_PREPARE once the zone is loaded, BF_CITY_UPDATE every frame of
   the fight, BF_CITY_RESET when the battle ends. The unit pools are not rebuilt here: the director
   respawns the player with `initialize!` 'life at both ends of a battle (battlefront.gc), which
   rebuilds them the way a death does."
  (cond
    ((= cmd BF_CITY_PREPARE)
     (bf-city-restore-hatred)
     (bf-city-ships-down)
     (bf-city-sleep-all)
     )
    ((= cmd BF_CITY_UPDATE)
     (bf-city-apply-hatred)
     (when (time-elapsed? (-> *bf-city-saved* retarget-time) (seconds 0.5))
       (set-time! (-> *bf-city-saved* retarget-time))
       (bf-city-retarget)
       (bf-city-steer)
       )
     (bf-march-apply)
     (bf-city-dots)
     ;; a death reset (ctywide activates again) or a task change restores the stock faction
     ;; state: apply the battle's every 2 seconds
     (when (and *cty-faction-manager*
                (nonzero? *cty-faction-manager*)
                (time-elapsed? (-> *bf-city-saved* faction-time) (seconds 2))
                )
       (set-time! (-> *bf-city-saved* faction-time))
       (cty-faction-evaluate-commands *bf-faction-commands*)
       ;; the lift to the Freedom League's headquarters stays still (elevator.gc 'go-dormant: only
       ;; a 'trigger wakes it); a death reset spawns it again, so sent each time
       (let ((lift (process-by-ename "cty-elevator-2")))
         (if lift
             (send-event lift 'go-dormant)
             )
         )
       )
     ;; the troop transports, the units from the edge, the force fields: a look twice a second
     (when (time-elapsed? (-> *bf-city-saved* reinforce-time) (seconds 0.5))
       (set-time! (-> *bf-city-saved* reinforce-time))
       (bf-city-transports)
       (bf-city-edge-spawn)
       (bf-city-fields-up)
       )
     )
    ((= cmd BF_CITY_FREE_NAVS)
     (bf-city-free-navs)
     )
    ((= cmd BF_CITY_RESET)
     (bf-city-restore-hatred)
     (bf-city-ships-down)
     (bf-city-fields-down)
     )
    )
  (none)
  )

(defun bf-city-throw-grenade ((from vector) (to vector))
  "`*bf-city-grenade*`: the player throws a guard grenade from FROM onto TO, the projectile and arc
   of the grenade guards (guard-grenade.gc crimson-guard-method-264). Jak owns it and it skips him;
   with no charge it bursts where it lands."
  (let ((traj (new 'stack-no-clear 'traj3d-params)))
    (vector-copy! (-> traj src) from)
    (vector-copy! (-> traj dest) to)
    (set! (-> traj initial-tilt) 8192.0)
    (set! (-> traj gravity) 184320.0)
    (when (traj3d-calc-initial-velocity-using-tilt traj)
      (let ((params (new 'stack-no-clear 'projectile-init-by-other-params)))
        (set! (-> params ent) (-> *target* entity))
        (set! (-> params charge) 0.0)
        (set! (-> params options) (projectile-options))
        (vector-copy! (-> params pos) from)
        (vector-copy! (-> params vel) (-> traj initial-velocity))
        (set! (-> params notify-handle) (the-as handle #f))
        (set! (-> params owner-handle) (process->handle *target*))
        (set! (-> params target-handle) (the-as handle #f))
        (set! (-> params target-pos quad) (the-as uint128 0))
        (set! (-> params ignore-handle) (process->handle *target*))
        (let* ((info *game-info*)
               (id (+ (-> info attack-id) 1))
               )
          (set! (-> info attack-id) id)
          (set! (-> params attack-id) id)
          )
        (set! (-> params timeout) (seconds 4))
        (spawn-projectile vehicle-grenade-deflect params *target* *default-dead-pool*)
        )
      )
    )
  (none)
  )

;; install the hooks at every link of CWI (the previous values pointed into the previous link)
(set! *bf-city-hook* bf-city-command)
(set! *bf-city-grenade* bf-city-throw-grenade)
