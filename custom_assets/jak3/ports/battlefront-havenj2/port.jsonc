// The Battlefront mod's second war zone: Jak 2's Haven City, ported into Jak 3 by scripts/level_port
// (its README describes every key) from the player's own Jak 2 and Jak 3 discs. Nothing of Jak 2 is
// in git: `task level-port -- custom_assets/jak3/ports/battlefront-havenj2/port.jsonc` writes the
// level files, and a launcher install's extractor runs it before the compile.
//
// One level, bf-havenj2: the city-wide level and the 15 districts merged, so that a battle has the
// whole city loaded at once (Jak 3 has 10 level slots and a heap for one large level and one small
// one: Haven City: New Dawn's hub and 15 districts can't all be loaded together). It hosts the borrow
// heaps of Jak 3's ctywide, where the battle's units' levels load (ctypesa, ctypesc).
{
  "name": "battlefront-havenj2",
  "source_game": "jak2",
  "target_game": "jak3",
  // the mod plays without Jak 2: at install, the extractor skips this port when Jak 2 isn't
  // installed (decompiler/extractor/main.cpp run_level_ports), and the war zone is greyed
  "optional": true,
  "tag": "og:battlefront-havenj2",
  "ignore_outputs": ".gitignore",
  "prefix": "bfh-",
  "paths": {
    "levels": "custom_assets/jak3/levels",
    "models": "custom_assets/jak3/models/custom_levels",
    "code": "goal_src/jak3/levels/bf-havenj2"
  },
  // the city at the end of Jak 2 (the palace plaza's statue broken...)
  "story": {"state": "end"},
  "build": {
    "file": "goal_src/jak3/levels/bf-havenj2/bf-havenj2.gp",
    "default_deps": [],
    "code_deps": {
      "bf-havenj2-obs": ["ctywide-init"],
      "bf-havenj2-height-map": ["height-map-h"]
    }
  },
  // The city's map for the battle's menus and its L3 map (battlefront.gc bf-draw-zone-minimap):
  // Jak 2's minimap textures, where its minimap.gc lays them out, as one picture (steps/citymap.py),
  // read by GAME's battlefront-havenj2-info.gc. Generated from the player's Jak 2: kept out of git
  "city_map": {
    "file": "goal_src/jak3/levels/bf-havenj2/bf-havenj2-map.gc",
    "var": "bf-zone-jak2-map",
    "minimap": "goal_src/jak2/engine/ui/minimap.gc",
    "textures": [["ctypal-minimap", ["map-ctypala", "map-ctypalb"]], ["ctygena-minimap", ["map-ctygena"]],
                 ["ctygenb-minimap", ["map-ctygenb"]], ["ctygenc-minimap", ["map-ctygenc", "map-ctyfarma"]],
                 ["ctyinda-minimap", ["map-ctyinda"]], ["ctyindb-minimap", ["map-ctyindb"]],
                 ["stadium-minimap", ["map-stadium"]], ["ctymarka-minimap", ["map-ctymarka", "map-ctyfarmb"]],
                 ["ctymarkb-minimap", ["map-ctymarkb"]],
                 ["ctyport-minimap", ["map-ctyporta", "map-ctyportb", "map-ctyportc", "map-ctyportd", "map-ctyporte", "map-ctyportf"]],
                 ["ctysluma-minimap", ["map-ctysluma"]], ["ctyslumb-minimap", ["map-ctyslumb"]],
                 ["ctyslumc-minimap", ["map-ctyslumc"]]],
    "max_size": [256, 384]
  },
  "level_info": {
    // not compiled by itself: GAME's goal_src/jak3/pc/features/battlefront/battlefront-havenj2-info.gc
    // takes its forms when it exists (a player without Jak 2 has none)
    "file": "goal_src/jak3/levels/bf-havenj2/bf-havenj2-levels.gc",
    "comment": [
      "The level-load-info of bf-havenj2, Jak 2's Haven City as the Battlefront mod's second war",
      "zone, with its continue point. Compiled into GAME by battlefront-havenj2-info.gc, which",
      "includes these forms. Its mood: goal_src/jak3/levels/bf-havenj2/bf-havenj2-obs.gc."
    ],
    "levels_var": "*bfh-levels*",
    "levels_var_comment": "every level of the Jak 2 city war zone"
  },
  "level_defaults": {"level_info": {"draw_priority": "10.0"}},
  "continues": {
    "prefix": "bfh-",
    "names": {"ctysluma-start": "bf-havenj2-start"}
  },
  "levels": [
    {
      "name": "bf-havenj2",
      "nick": "bfh",
      "iso": "BFHAVEN",
      "index": "0x129",
      "base_id": 21000,
      "what": "Jak 2's Haven City, its city-wide level and its 15 districts as one level: the Battlefront's Jak 2 war zone",
      "sources": ["ctywide", "ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb",
                  "ctyinda", "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb",
                  "ctypal", "stadium"],
      "memory": "large",
      "sky": true,
      "ocean": "*ocean-map-bf-havenj2*",
      "ocean_source": {"file": "goal_src/jak2/engine/gfx/ocean/ocean-tables.gc", "name": "city"},
      // no Jak 2 actor: no doors, crates or props as actors (the props are baked into the mesh)
      "ported_actors": false,
      // its ocean map (bf-havenj2-ocean.gc, the ocean step), defined each time it loads
      "code": ["bf-havenj2-ocean.o"],
      // the playable city with a margin: the kilometers of backdrop mountains would blow the
      // collide hash grid up (Haven City: New Dawn's bounds)
      "collision_bounds": [-700, -200, -1000, 1400, 470, 2150],
      // the bases (the Freedom League's by the hideout, the Krimzon Guard's at the palace's foot)
      // and a continue point in each district, the control points' respawn places
      "continues": ["ctysluma-alley", "ctypal-shaft",
                    "ctysluma-start", "ctyslumb-start", "ctyslumc-slums", "stadium-start",
                    "ctygena-start", "ctygenb-start", "ctygenc-start", "ctyfarma-start",
                    "ctyfarmb-start", "ctymarka-brutter", "ctymarkb-tanker", "ctypal-tomb",
                    "ctyport-warp", "ctyinda-consite", "ctyindb-start"],
      "water": {"ocean_region": {"center": [350.0, 0.0, 575.0], "radius": 1950.0}, "below": 3.0, "above": 2.0, "pools": []},
      // no particles: a texture page of its own for Jak 2's minimap textures alone (their names
      // as Jak 2's minimap.gc gives them), which the game's minimap finds by name
      // (battlefront-havenj2-info.gc bfh-map-pages-on)
      "particles": {
        "files": [],
        "textures_from": ["ctypal", "ctygena", "ctygenb", "ctygenc", "ctyinda", "ctyindb", "stadium",
                          "ctymarka", "ctymarkb", "ctyport", "ctysluma", "ctyslumb", "ctyslumc"],
        "page": "auto", "parts": "auto", "groups": "auto",
        "source_textures": [["ctypal-minimap", ["map-ctypala", "map-ctypalb"]], ["ctygena-minimap", ["map-ctygena"]],
                            ["ctygenb-minimap", ["map-ctygenb"]], ["ctygenc-minimap", ["map-ctygenc", "map-ctyfarma"]],
                            ["ctyinda-minimap", ["map-ctyinda"]], ["ctyindb-minimap", ["map-ctyindb"]],
                            ["stadium-minimap", ["map-stadium"]], ["ctymarka-minimap", ["map-ctymarka", "map-ctyfarmb"]],
                            ["ctymarkb-minimap", ["map-ctymarkb"]],
                            ["ctyport-minimap", ["map-ctyporta", "map-ctyportb", "map-ctyportc", "map-ctyportd", "map-ctyporte", "map-ctyportf"]],
                            ["ctysluma-minimap", ["map-ctysluma"]], ["ctyslumb-minimap", ["map-ctyslumb"]],
                            ["ctyslumc-minimap", ["map-ctyslumc"]]]
      },
      "mesh": {
        // Jak 2's doors to the places the war zone leaves out (the palace's gate, Mar's tomb's and
        // the other airlocks, the Hip Hog's, the hideout's, the oracle's, Vin's, the fortress's
        // gates, the stadium's garage doors): background in their closed pose, with a collision
        // box, so they never open (round 41: the doorways stood open on nothing)
        "props": {
          "palace-door": ["box", 16],
          "com-airlock-outer": ["box", 16],
          "com-airlock-inner": ["box", 16],
          "hip-door-a": ["box", 16],
          "hide-door-a": ["box", 16],
          "oracle-door": ["box", 16],
          "vin-door-ctyinda": ["box", 16],
          "fort-entry-gate": ["box", 16],
          "gar-door": ["box", 16],
          "lurker-pipe-lid": [null, null],
          "barons-ship-lores": [null, null],
          "ctypal-baron-statue-broken": [null, null],
          "ctypal-broke-wall": [null, null]
        },
        "post_width": 0.6,
        "palette": {"ambient": 110.0, "sun": 100.0}
      },
      // the traffic navigation of the 15 districts, merged into one city-level-info
      "nav": {
        // one 50 m grid over the districts' own (25, 40 or 50 m, aligned on 50 m)
        "cell": 50.0,
        "outside_depth": 10000.0,
        "height_map": {"source": "goal_src/jak2/levels/city/traffic/traffic-height-map.gc"},
        "sources": ["ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb", "ctyinda",
                    "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb", "ctypal",
                    "stadium"]
      },
      // Jak 3's city code (its ctywide's DGO, with the battle's level code) but its own city's
      // props, particles, missions and scenes; the units' art comes in the borrow levels
      "traffic": {
        "code_from": "goal_src/jak3/dgos/cwi.gd",
        "skip": ["ctyport-obs", "ctywide-obs", "ctywide-part", "ctywide-scenes", "ctywide-tasks",
                 "krimson-wall", "mhcity-obs", "mhcity-obs2", "mhcity-part", "traffic-height-map",
                 "trail", "trail-graph"],
        "replace": {"traffic-height-map": "bf-havenj2-height-map"},
        "code": ["bf-havenj2-obs.o"],
        "art": []
      },
      "level_info": {
        // Jak 3's ctywide's own callbacks (ctywide-init.o, in the city code above): the traffic
        // engine, the squads, the faction and borrow managers and the attack controller, as the
        // battle's code expects them
        // (34 and 35 wrapped in bf-havenj2-obs.gc to bring Jak 2's minimap textures in)
        "callbacks": [[33, "ctywide-login"], [34, "bf-havenj2-logout"],
                      [35, "bf-havenj2-activate"], [36, "ctywide-deactivate"]],
        // the minimap's squares (bit 5 * row + column of the 5x7 city grid, Jak 2's and Jak 3's)
        // that have a Jak 2 map: all of them, in its texture page (particles source_textures)
        "city_map_bits": "0x39d6f59cc",
        "draw_priority": "9.0",
        // Jak 3's ctywide's borrow heaps (KB), where ctypesa and ctypesc load
        "borrow_sizes": [420, 420, 420, 780, 810],
        "comment": [
          "Jak 2's Haven City, the whole city as one level (custom_assets/jak3/levels/bf-havenj2), the",
          "Battlefront's Jak 2 war zone. Kept at Jak 2's world coordinates: never loaded together with",
          "Jak 3's own city levels. Its borrow heaps are Jak 3's ctywide's (the units' levels)."
        ]
      }
    }
  ]
}
