(defbehavior smoke-s101 process ()
  "Scenario 101 (`smoke-scenario-late`), trailer v3: the red jetpack at a front (the North Farms
   against the Palace Plaza): rockets chased by the camera from launch to burst (every frame, slow
   motion), its abilities from their angles, three point-of-view takes; battle clips there. No check
   of its own."
  (smoke-trl-v2-start BF_TEAM_KG 1 "deploy red jetpack")
  (smoke-trl-park-at 3)
  (smoke-trl-front2 11 14)
  (smoke-step "front north farms / palace plaza")
  (smoke-wait 70.0)
