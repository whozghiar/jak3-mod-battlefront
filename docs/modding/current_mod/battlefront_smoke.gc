  )

(defbehavior smoke-s37 process ()
  "Scenario 37 (`smoke-scenario-late`)."
  ;; Round 26: the grenade throw, the rifle on the run, the tazer's stab (the red guard); START,
  ;; its Options entry and the war music; a redeploy in combat
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r26-weapons)
  ;; two minutes of battle: the robotguards and spiders falling at once, none walking in the air;
  ;; the guards on the Industrial Zone's walkways; the posted units with no foe coming
  (smoke-step "falls, decks, posts")
  (set! (-> *smoke-fall* count) 0)
  (set! (-> *smoke-fall* air-count) 0)
  (let ((t0 (smoke-now))
        (next (smoke-now))
        (deck-max 0)
        (idle-max 0)
        (idle-sum 0)
        (samples 0)
        )
    (while (< (- (smoke-now) t0) (seconds 120))
      (smoke-fall-tick)
      (when (< next (smoke-now))
        (set! next (+ (smoke-now) (seconds 5)))
        (bf-city-test-counts)
        (format 0 "SMOKE decks ~D on, ~D have been; posted ~D, ~D idle at a point with no foe coming~%"
                (-> *bf-test-counts* 0) (-> *bf-test-counts* 1) (-> *bf-test-counts* 3) (-> *bf-test-counts* 2))
        (set! deck-max (max deck-max (-> *bf-test-counts* 1)))
        (set! idle-max (max idle-max (-> *bf-test-counts* 2)))
        (+! idle-sum (-> *bf-test-counts* 2))
        (+! samples 1)
        ;; every 15 s the Krimzon Guard loses two robotguards and two spiders: its next ones come
        (when (zero? (mod samples 3))
          (smoke-kill-units BF_TEAM_KG 'roboguard-city 2 #t)
          (smoke-kill-units BF_TEAM_KG 'spydroid 2 #t)
          )
        )
      (suspend)
      )
    (smoke-check "the robotguards and spiders fall at once and none walks in the air" (smoke-fall-report))
    ;; the average as a sum over the looks (an integer division here failed the register allocator)
    (format 0 "SMOKE decks: ~D guards have been on an upper deck; posts idle with no foe coming: ~D at most, ~D in ~D looks~%"
            deck-max idle-max idle-sum samples)
    (smoke-check "guards go by the Industrial Zone's walkways" (< 0 deck-max))
    (smoke-check "posted units do not stand at a point no foe comes to (1 on average at most)" (< idle-sum (* 2 (max 1 samples))))
    )
  (smoke-r26-pause)
  (smoke-start-locks)
  (smoke-quit)
  0
  )

(defbehavior smoke-s36 process ()
  "Scenario 36 (`smoke-scenario-late`)."
  ;; Round 26 diagnosis: the nav meshes cut into islands (the Industrial Zone's platforms), the
  ;; points, then 4 minutes of battle with every awake unit reported every 10 s (its goal, the way
  ;; from its mesh, its state, its height over its nav poly): the units that stand around a point
