  (smoke-v4-battles 16 7 2)
  (smoke-v4-battles 15 9 2)
  (smoke-v4-battles 6 11 2)
  (smoke-trl-front-off)
  (set! *smoke-los-watch* #f)
  0
  )

;; trailer v4, retakes: points of view from a fight's flank, attack cameras with nothing beside the
;; lens, the spider's run from behind the enemy lines

(define *smoke-v4-ca* (new 'static 'vector))
(define *smoke-v4-ce* (new 'static 'vector))

(defun smoke-v4-sides-at ((at vector) (radius float))
  "The middles of the player's side (`*smoke-v4-ca*`) and of the enemies (`*smoke-v4-ce*`) among
   the units within RADIUS of AT. Returns the smaller side's count."
  (let ((na 0)
        (ne 0)
        (team (-> *bf* team))
        )
    (vector-reset! *smoke-v4-ca*)
    (vector-reset! *smoke-v4-ce*)
    (dotimes (i (smoke-trl-gather))
      (let ((q (the-as process-drawable (handle->process (-> *smoke-trl-h* i)))))
        (when (and q (< (vector-vector-distance (-> q root trans) at) radius))
          (cond
            ((= (bf-unit-team q) team)
             (vector+! *smoke-v4-ca* *smoke-v4-ca* (-> q root trans))
             (+! na 1)
             )
            (else
              (vector+! *smoke-v4-ce* *smoke-v4-ce* (-> q root trans))
              (+! ne 1)
              )
            )
          )
        )
      )
    (if (> na 0)
        (vector-float*! *smoke-v4-ca* *smoke-v4-ca* (/ 1.0 (the float na)))
        (vector-copy! *smoke-v4-ca* at)
        )
    (if (> ne 0)
        (vector-float*! *smoke-v4-ce* *smoke-v4-ce* (/ 1.0 (the float ne)))
        (vector-copy! *smoke-v4-ce* at)
        )
    (set! (-> *smoke-v4-ca* w) 1.0)
    (set! (-> *smoke-v4-ce* w) 1.0)
    (min na ne)
    )
  )

(defun smoke-v4-side-clear? ((eye vector) (look vector) (len float))
  "#t when nothing stands beside the lens: probes (a 0.8 m sphere) LEN long from EYE, 25 degrees
   left and right of its level view toward LOOK (a pillar at the frame's edge filled a third of
   scenario 115's jetpack shot)."
  (let ((fwd (vector-! (new 'stack-no-clear 'vector) look eye))
        (dir (new 'stack-no-clear 'vector))
        (p (new 'stack-no-clear 'vector))
        )
    (set! (-> fwd y) 0.0)
    (vector-normalize! fwd 1.0)
    (vector-rotate-around-y! dir fwd (degrees 25))
    (vector+float*! p eye dir len)
    (and (smoke-trl-los-r? eye p (meters 0.8))
         (begin
           (vector-rotate-around-y! dir fwd (degrees -25))
           (vector+float*! p eye dir len)
           (smoke-trl-los-r? eye p (meters 0.8))
           )
         )
    )
  )

(defbehavior smoke-v4-pov-flank process ()
  "Jak on a flank of a dense fight (`smoke-trl-wait-mix`, 8 of each side, 30 s at most), so the shots
   cross the frame between the two sides with no ally in front: the line from his side's middle to
   the enemies' (`smoke-v4-sides-at`) is the front's axis; on either side of it, 22, 18 then 26 m
   from the fight and 5 m back toward his side, the first spot with ground under it, a clear line to
   the fight and to the enemies' middle, room behind it for the camera (9 m back, 3 m up) that sees
   the fight, and nothing beside the camera. Faces the fight. Returns #t when one was found."
  (let ((at (new 'stack-no-clear 'vector))
        (u (new 'stack-no-clear 'vector))
        (v (new 'stack-no-clear 'vector))
        (p (new 'stack-no-clear 'vector))
        (c (new 'stack-no-clear 'vector))
        (low (new 'stack-no-clear 'vector))
        (ce (new 'stack-no-clear 'vector))
        (dists (new 'static 'array float 3 22.0 18.0 26.0))
        )
    (when (> (smoke-trl-wait-mix at 8 30.0) 0)
      (+! (-> at y) (meters 1.5))
      (smoke-v4-sides-at at (meters 40))
      (vector-copy! ce *smoke-v4-ce*)
      (+! (-> ce y) (meters 1.5))
      (vector-! u *smoke-v4-ce* *smoke-v4-ca*)
      (set! (-> u y) 0.0)
      (vector-normalize! u 1.0)
      (set-vector! v (-> u z) 0.0 (- (-> u x)) 1.0)
      (dotimes (r 3)
        (dotimes (sd 2)
          (vector+float*! p at v (* (if (zero? sd) 1.0 -1.0) (meters (-> dists r))))
          (vector+float*! p p u (meters -5))
          (vector-! c p at)
          (set! (-> c y) 0.0)
          (vector-normalize! c (meters 9))
          (vector+! c c p)
          (+! (-> c y) (meters 3))
          (vector-copy! low p)
          (+! (-> low y) (meters -6))
          (when (and (not (smoke-trl-los-r? p low (meters 0.3)))
                     (smoke-trl-los-r? p at (meters 0.8))
                     (smoke-trl-los-r? p ce (meters 0.5))
                     (smoke-trl-los-r? p c (meters 0.6))
                     (smoke-trl-los-r? c at (meters 0.5))
                     (smoke-v4-side-clear? c at (meters 7))
                     )
            (format 0 "SMOKE trailer pov flank spot ~M m off the fight, side ~D~%" (meters (-> dists r)) sd)
            (+! (-> p y) (meters 1))
            (move-to-point! (-> *target* control) p)
            (smoke-wait 0.4)
            (smoke-face at)
            (return #t)
            )
          )
        )
      )
    )
  (format 0 "SMOKE trailer: no flank spot, the open spot instead~%")
  (smoke-v4-pov-spot)
  )

(defbehavior smoke-v4-pov2 process ((class int) (clip string))
  "`smoke-v4-pov` from a fight's flank (`smoke-v4-pov-flank`) instead of its open side."
  (set! *smoke-v4-flank?* #t)
  (smoke-v4-pov class clip)
  (set! *smoke-v4-flank?* #f)
  0
  )

(defbehavior smoke-v4-spider-run process ((clip string) (wide float) (high float))
  "The spider's last run, charged (waited for), from behind the enemy lines: the biggest group of
   enemies (7 within 10 m wanted, 30 s at most), the spider set 26 m from it on the side away from
   its own army (`smoke-v4-sides-at`; the clearest line when that one is blocked), so it sprints (R2)
   into the enemies with its allies far beyond; the camera beside and behind it, higher and farther
   than scenario 115's (4.5 m back, 3.5 m to the side, 2.2 m up: allies passing filled that frame);
   within 6 m of the group (or 3 s in) the cut to a still spot WIDE off and HIGH up and its blast
   (L1); 6 s on the blast. Every game frame recorded (CLIP at half speed). Returns #t when filmed;
   the spider is dead after it."
  (smoke-wait-for 40.0 (lambda () (and (smoke-av) (>= (bf-nova-charge (smoke-av)) 1.0))))
  (let ((g (the-as handle #f))
        (gn 0)
        (t0 (smoke-now))
        )
    ;; a group of 7
    (until (or (>= gn 7) (< (seconds 30) (- (smoke-now) t0)))
      (set! g (smoke-trl-group-foe (-> *target* control trans) (meters 200)))
      (set! gn 0)
      (let ((gp (the-as process-drawable (handle->process g))))
        (when gp
          (dotimes (i (smoke-trl-gather))
            (let ((q (the-as process-drawable (handle->process (-> *smoke-trl-h* i)))))
              (if (and q (bf-foe? q (-> *bf* team)) (< (vector-vector-distance (-> q root trans) (-> gp root trans)) (meters 10)))
                  (+! gn 1)
                  )
              )
            )
          )
        )
      (if (< gn 7)
          (smoke-wait 2.0)
          )
      )
    (format 0 "SMOKE trailer spider run: a group of ~D enemies~%" gn)
    (let ((gp (the-as process-drawable (handle->process g))))
      (when gp
        (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> gp root trans)))
              (s (new 'stack-no-clear 'vector))
              (u (new 'stack-no-clear 'vector))
              (fwd (new 'stack-no-clear 'vector))
              (side (new 'stack-no-clear 'vector))
              (eye (new 'stack-no-clear 'vector))
              (look (new 'stack-no-clear 'vector))
              (up (new 'stack-no-clear 'vector))
              )
          ;; behind the enemy lines: from the allies' middle through the group, 26 m on
          (smoke-v4-sides-at at (meters 60))
          (vector-! u at *smoke-v4-ca*)
          (set! (-> u y) 0.0)
          (vector-normalize! u 1.0)
          (vector+float*! s at u (meters 26))
          (+! (-> s y) (meters 2))
          (vector-copy! up at)
          (+! (-> up y) (meters 2))
          (when (not (smoke-trl-los-r? up s (meters 1)))
            (let ((ang (smoke-trl-clear-dir at (meters 26) (meters 2))))
              (set-vector! s (+ (-> at x) (* (meters 26) (sin ang))) (+ (-> at y) (meters 2)) (+ (-> at z) (* (meters 26) (cos ang))) 1.0)
              )
            (format 0 "SMOKE trailer spider run: behind the lines blocked, the clearest line instead~%")
            )
          (move-to-point! (-> *target* control) s)
          (smoke-wait 0.5)
          (smoke-neutral)
          (smoke-face at)
          (smoke-aim-on! #t)
          (set! (-> *smoke-aim* foe) g)
          (vector-! fwd at s)
          (set! (-> fwd y) 0.0)
          (vector-normalize! fwd 1.0)
          (set-vector! side (-> fwd z) 0.0 (- (-> fwd x)) 1.0)
          (vector+float*! eye s side (meters 3.5))
          (if (not (smoke-trl-los-r? s eye (meters 0.5)))
              (vector-negate! side side)
              )
          (set! *smoke-los-jak?* #t)
          (set! (-> *smoke-cine* nohud?) #t)
          (vector+float*! eye s fwd (meters -4.5))
          (vector+float*! eye eye side (meters 3.5))
          (+! (-> eye y) (meters 2.2))
          (vector+float*! look s fwd (meters 8))
          (smoke-cine-line eye eye look 1.0)
          (smoke-wait 0.1)
          (smoke-hd-start clip 1)
          (smoke-stick 128 0 128 128)
          (set! (-> *smoke-aim* base) (the-as int (pad-buttons r2)))
          (set! t0 (smoke-now))
          (while (and (< (- (smoke-now) t0) (seconds 3))
                      (let ((q (the-as process-drawable (handle->process g))))
                        (or (not q) (< (meters 6) (vector-vector-xz-distance (-> q root trans) (-> *target* control trans))))
                        )
                      )
            (vector+float*! eye (-> *target* control trans) fwd (meters -4.5))
            (vector+float*! eye eye side (meters 3.5))
            (+! (-> eye y) (meters 2.2))
            (vector+float*! look (-> *target* control trans) fwd (meters 8))
            (+! (-> look y) (meters 0.5))
            (smoke-cine-line eye eye look 1.0)
            (suspend)
            )
          (smoke-stick 128 128 128 128)
          (set! (-> *smoke-aim* base) 0)
          (vector-copy! at (-> *target* control trans))
          (+! (-> at y) (meters 1))
          (let ((found #f))
            (dotimes (r 3)
              (when (not found)
                (let* ((d (* wide (-> (new 'static 'array float 3 1.0 0.85 1.15) r)))
                       (h (* high (-> (new 'static 'array float 3 1.0 0.8 1.2) r)))
                       (a2 (smoke-trl-clear-dir at d h))
                       )
                  (set-vector! eye (+ (-> at x) (* d (sin a2))) (+ (-> at y) h) (+ (-> at z) (* d (cos a2))) 1.0)
                  (when (smoke-trl-los-r? eye at (meters 0.5))
                    (set! found #t)
                    (format 0 "SMOKE trailer blast spot ~M m off, ~M m up~%" d h)
                    )
                  )
                )
              )
            )
          (vector-copy! look at)
          (+! (-> look y) (meters 4))
          (smoke-cine-line eye eye look 1.0)
          (smoke-wait 0.25)
          (smoke-hold (pad-buttons l1))
          (smoke-wait 0.3)
          (smoke-hold (the-as pad-buttons 0))
          (smoke-wait 6.0)
          (smoke-hd-stop)
          (smoke-aim-off!)
          (smoke-cine-off)
          (set! *smoke-los-jak?* #f)
          (return #t)
          )
        )
      )
    )
  #f
  )

(defbehavior smoke-s116 process ()
  "Scenario 116 (`smoke-scenario-late`), trailer v4 retakes, the Freedom League (scenario 115's new
   battle never started: its Freedom League part ran as the robotguard): the drops of both sides as
   the battle starts (`smoke-v4-drops-again`); at the Palace Plaza (both
   armies sent there), the blue guard firing crouched, then its rifle, grenade launcher and tazer
   from still open cameras (over the shoulder first), three points of view from the fight's flank
   (`smoke-v4-pov-flank`); the blue jetpack's gun and two points of view from the flank; battle
   clips at fronts in six districts (`smoke-v4-battles`). The line of sight watched. No check of its
   own."
  (set! *smoke-trl-hour* 12)
  (smoke-trl-v2-start BF_TEAM_FF 0 "deploy blue guard")
  (smoke-trl-park-at 2)
  (set! *smoke-los-watch* #t)
  ;; the drops first, as the battle starts (`smoke-v4-drops-again`)
  (smoke-v4-drops-again)
  (smoke-trl-park-at 2)
  (smoke-trl-front3 14 9 11)
  (smoke-step "front palace plaza")
  (smoke-wait 70.0)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-crouch-attack "blue-guard")
  (smoke-trl-front3 14 9 11)
  (set! *smoke-v4-side-start* 6)
  (smoke-v4-guard-attacks "blue-guard")
  (set! *smoke-v4-side-start* 0)
  (dotimes (k 3)
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "pov-blue-guard-~D" (+ k 1))
    (smoke-v4-pov2 BF_CLASS_BLUE_GUARD *smoke-name*)
    )
  (smoke-change-class 1 "blue jetpack")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-jetpack-attack "blue-jetpack")
  (set! *smoke-aim-pitch-min* (degrees -20))
  (dotimes (k 2)
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "pov-blue-jetpack-~D" (+ k 1))
    (smoke-v4-pov2 BF_CLASS_BLUE_JETPACK *smoke-name*)
    )
  (set! *smoke-aim-pitch-min* BF_PITCH_DOWN)
  ;; battle clips in six more districts (scenario 115's found no front pair)
  (smoke-change-class 0 "blue guard")
  (smoke-trl-park-at 2)
  (set! *smoke-battle-secs* 8.0)
  (smoke-v4-battles 11 1 2)
  (smoke-v4-battles 10 3 2)
  (smoke-v4-battles 9 5 2)
  (smoke-v4-battles 16 7 2)
  (smoke-v4-battles 15 9 2)
  (smoke-v4-battles 13 11 2)
  (smoke-trl-front-off)
  (set! *smoke-los-watch* #f)
  0
  )

