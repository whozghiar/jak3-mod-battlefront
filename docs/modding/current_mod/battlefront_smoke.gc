  (smoke-trl-v2-place 13 (meters 16))
  (smoke-trl-pov BF_CLASS_SPYDROID "pov-spider-1")
  (smoke-trl-v2-place 13 (meters 12))
  (smoke-trl-wplayer BF_CLASS_SPYDROID "wide-player-spider-2")
  (smoke-trl-v2-place 13 (meters 16))
  (smoke-trl-pov BF_CLASS_SPYDROID "pov-spider-2")
  (smoke-trl-v2-place 13 (meters 16))
  (smoke-trl-pov BF_CLASS_SPYDROID "pov-spider-3")
  (smoke-trl-park-at 3)
  (smoke-trl-v2-wides 10 "west-farms" 55.0)
