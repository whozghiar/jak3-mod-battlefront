  (smoke-trl-v2-place 10 (meters 14))
  (smoke-trl-pov-blast "pov-spider-blast")
  (smoke-goal-force! -1)
  0
  )

(defbehavior smoke-s96 process ()
  "Scenario 96 (`smoke-scenario-late`), trailer v2: the blue guard and the blue jetpack in the dense
   fight every unit is sent to (the Central Quarter): three point-of-view takes of the blue guard and
   one of the blue jetpack (HUD on, shots only at enemies), two cinematic takes of the blue guard and
   one of the blue jetpack in the battle; then wide shots of the Palace Plaza and the South
   Quarter. No check of its own."
  (smoke-trl-v2-start BF_TEAM_FF 0 "deploy blue guard")
  (smoke-trl-park-at 2)
  (smoke-goal-force! 9)
  (smoke-step "front central quarter")
  (smoke-wait 75.0)
  (smoke-trl-v2-place 9 (meters 22))
  (smoke-trl-pov BF_CLASS_BLUE_GUARD "pov-blue-guard-1")
  (smoke-trl-v2-place 9 (meters 22))
  (smoke-trl-pov BF_CLASS_BLUE_GUARD "pov-blue-guard-2")
  (smoke-trl-v2-place 9 (meters 16))
  (smoke-trl-wplayer BF_CLASS_BLUE_GUARD "wide-player-blue-guard-1")
  (smoke-trl-v2-place 9 (meters 22))
  (smoke-trl-pov BF_CLASS_BLUE_GUARD "pov-blue-guard-3")
  (smoke-trl-v2-place 9 (meters 16))
  (smoke-trl-wplayer BF_CLASS_BLUE_GUARD "wide-player-blue-guard-2")
  (smoke-change-class 1 "blue jetpack")
  (smoke-trl-v2-place 9 (meters 25))
  (smoke-trl-pov BF_CLASS_BLUE_JETPACK "pov-jetpack-blue-1")
  (smoke-trl-v2-place 9 (meters 18))
  (smoke-trl-wplayer BF_CLASS_BLUE_JETPACK "wide-player-jetpack-blue-1")
  (smoke-trl-park-at 2)
  (smoke-trl-v2-wides 14 "palace-plaza" 55.0)
  (smoke-trl-v2-wides 8 "south-quarter" 50.0)
  (smoke-goal-force! -1)
  0
  )

(defbehavior smoke-s97 process ()
  "Scenario 97 (`smoke-scenario-late`), trailer v2: the red jetpack and the spider's blast again, in
   the open North Farms where every unit is sent: three jetpack point-of-view takes (a shorter
   climb, the view never tilted more than 20 degrees down) and two cinematic takes (higher, farther);
   wide shots of the Palace Plaza and the South Quarter (scenario 96 ran out of time); then the
   spider's blast in the biggest group once charged. No check of its own."
