  (smoke-trl-v2-place 11 (meters 22))
  (smoke-trl-pov BF_CLASS_BLUE_GUARD "pov-blue-guard-5")
  (smoke-trl-v2-place 11 (meters 22))
  (smoke-trl-pov BF_CLASS_BLUE_GUARD "pov-blue-guard-6")
