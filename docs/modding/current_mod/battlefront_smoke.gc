  ;; to Freedom HQ, then on foot near the place the author saw (742, 8, 74)
  (let ((at (new 'static 'vector :x (meters 742.0) :y (meters 14.0) :z (meters 60.0) :w 1.0)))
    (move-to-point! (-> *target* control) at)
    (vector-copy! (-> *bf* safe) at)
    )
  (smoke-wait 15.0)
  (format 0 "SMOKE Jak at ~M ~M ~M level ~A~%" (-> *target* control trans x) (-> *target* control trans y) (-> *target* control trans z) (-> *load-state* vis-nick))
  (bf-ways-dump)
