  (smoke-wait 1.2)
  (smoke-step "walk back")
  (smoke-stick 128 255 128 128)
  (smoke-wait 1.2)
  (smoke-step "look up and down")
  (smoke-stick 128 128 128 30)
  (smoke-wait 0.5)
