(defbehavior smoke-s39 process ()
  "Scenario 39 (`smoke-scenario-late`)."
  ;; Round 26: robotguards and spiders brought down from the sky at the Industrial Zone's point
  ;; (its walkways 27 m up among the polys drawn), watched one by one as they fall
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (set! (-> *smoke-fall* count) 0)
  (set! (-> *smoke-fall* air-count) 0)
  (let ((t0 (smoke-now))
        (next (smoke-now))
        )
    (while (< (- (smoke-now) t0) (seconds 120))
      (smoke-fall-tick)
      (when (< next (smoke-now))
        (set! next (+ (smoke-now) (seconds 4)))
        ;; the Krimzon Guard loses robotguards and spiders far off, and its next ones are brought
        ;; down at the Industrial Zone's point at once
        (smoke-kill-units BF_TEAM_KG 'roboguard-city 2 #t)
        (smoke-kill-units BF_TEAM_KG 'spydroid 2 #t)
        (bf-city-spawn-near BF_TEAM_KG 3)
        )
      (suspend)
      )
    )
  (smoke-check "the robotguards and spiders fall at once and none walks in the air" (smoke-fall-report))
