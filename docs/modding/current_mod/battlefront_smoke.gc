    ((46) (smoke-s46))
    ((45) (smoke-s45))
    ((44) (smoke-s44))
    ((43) (smoke-s43))
    ((42) (smoke-s42))
    ((41) (smoke-s41))
    ((40) (smoke-s40))
    ((39) (smoke-s39))
    ((38) (smoke-s38))
    ((37) (smoke-s37))
    ((36) (smoke-s36))
    )
  0
  )

(defbehavior smoke-scenario process ()
  (format 0 "SMOKE start scenario ~D~%" SMOKE_SCENARIO)
  (smoke-boot)
  (if (>= SMOKE_SCENARIO 36)
      (smoke-scenario-late)
      )
  (case SMOKE_SCENARIO
    ((1)
     ;; T1: the Mods menu opens with L3 + SELECT, as every mod's; the mode on, START opens the
     ;; battle's pause page, whose Options entry opens the game's menu, its Options page the stock one
     ;; (no Gamemode entry since round 26); switched off, START is the game's
     (format 0 "SMOKE bind ~X (L3 + SELECT is ~X)~%" *mods-menu-bind* (pad-buttons l3 select))
     (smoke-check "the Mods menu bind is L3 + SELECT" (= *mods-menu-bind* (pad-buttons l3 select)))
     (let ((n (-> *options-options-pc* options length)))
       (smoke-mods-toggle "mods-menu-on")
       (smoke-check "Battlefront mode on" *mod-battlefront-enable*)
       (smoke-start-page 'main)
       (smoke-wait-for 5.0 (lambda () (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE))))
       (smoke-shot "start-pause-page")
       (smoke-check "START opens the battle's pause page" (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE)))
       (set! (-> (smoke-dir) cursor) 6)
       (smoke-wait 0.5)
       (smoke-press (pad-buttons x) 2.0)
       (smoke-wait-for 5.0 (lambda () (if *progress-process* #t #f)))
       (smoke-wait 1.5)
       (smoke-shot "start-options-ring")
       (smoke-check "its Options entry opens the game's START menu" (if *progress-process* #t #f))
       (smoke-check "the game's Options page is the stock one (no Gamemode)" (= (-> *options-options-pc* options length) n))
       (when *progress-process*
         (set-next-state (-> *progress-process* 0) 'go-away 0)
         )
       (smoke-wait 2.0)
       (smoke-mods-toggle "mods-menu-off")
       (smoke-check "Battlefront mode off" (not *mod-battlefront-enable*))
       (smoke-check "no battle director while the mode is off" (not (bf-active?)))
       )
     )
    ((2)
     ;; T2 to T5, Freedom League at the Port: the page order, the camera, the blue classes played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-camera-checks)
     (smoke-play BF_CLASS_BLUE_GUARD "blue-guard")
     (smoke-change-class 1 "blue jetpack")
     (smoke-play BF_CLASS_BLUE_JETPACK "blue-jetpack")
     (smoke-quit)
     )
    ((3)
     ;; T4 and T5, Krimzon Guard in the Industrial Zone: every red class played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_KG)
     (smoke-deploy 0 "deploy red guard")
     (smoke-camera-checks)
     (smoke-play BF_CLASS_RED_GUARD "red-guard")
     (smoke-change-class 1 "red jetpack")
     (smoke-play BF_CLASS_RED_JETPACK "red-jetpack")
     (smoke-change-class 2 "robotguard")
     (smoke-play BF_CLASS_ROBOGUARD "robotguard")
     (smoke-change-class 3 "spider")
     (smoke-play BF_CLASS_SPYDROID "spider")
     (smoke-quit)
     )
    ((7)
     ;; T6 on film: a jetpack left alone at the clip pace before the fix and at the fixed one, on the
     ;; ground then hovering, in the same place
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 1 "deploy blue jetpack")
     (smoke-invulnerable #t)
     (smoke-step "jetpack on the ground, both paces")
     (let ((g-old (smoke-pose-watch "jet-ground-old" 3.0 #t))
           (g-new (smoke-pose-watch "jet-ground-new" 3.0 #f))
           )
       (smoke-step "jetpack up")
       (smoke-hold (pad-buttons x))
       (smoke-wait 1.5)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-wait 1.0)
       (smoke-step "jetpack hovering, both paces")
       (let ((h-old (smoke-pose-watch "jet-hover-old" 3.0 #t))
             (h-new (smoke-pose-watch "jet-hover-new" 3.0 #f))
             )
         (format 0 "SMOKE legs: ground ~f cm before, ~f after; hovering ~f before, ~f after~%" g-old g-new h-old h-new)
         (smoke-check "the jetpack's joints move at least three times less than before the fix, on the ground and hovering"
                      (and (< (* 3.0 g-new) g-old) (< (* 3.0 h-new) h-old))
                      )
         )
       )
     (smoke-quit)
     )
    ((5)
     ;; T7, Freedom League at the Freedom HQ: each class in a long fight, the player's death, a restart
     (smoke-endurance 3 BF_TEAM_FF 75.0)
     )
    ((6)
     ;; T7, Krimzon Guard in the Slums
     (smoke-endurance 2 BF_TEAM_KG 60.0)
     )
    ((4)
     ;; T6: a jetpack left alone, on the ground then in the air; T3 again on film: the camera turned
     ;; by the right stick, a strafe, a guard's rolls
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 1 "deploy blue jetpack")
     (smoke-invulnerable #t)
     (smoke-step "jetpack on the ground")
     (let ((g (smoke-hover-watch "jet-ground" 3.0)))
       (smoke-step "jetpack up")
       (smoke-hold (pad-buttons x))
       (smoke-jet-log "climb" 1.5)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-jet-log "let go" 1.0)
       (smoke-step "jetpack hovering")
       (let ((h (smoke-hover-watch "jet-hover" 3.0)))
         (smoke-check "a jetpack left alone keeps its clip, on the ground and in the air" (and (zero? g) (zero? h)))
         )
       )
     (smoke-change-class 0 "blue guard")
     (smoke-step "film the camera")
     (smoke-rec-start "tps" 2)
     (smoke-stick 128 128 255 128)
     (smoke-wait 1.0)
     (smoke-stick 128 128 0 128)
     (smoke-wait 1.0)
     (smoke-stick 0 128 128 128)
     (smoke-wait 1.0)
     (smoke-stick 128 0 128 128)
     (smoke-wait 1.5)
     (smoke-neutral)
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (smoke-rec-start "roll" 2)
     (smoke-roll 255 128)
     (smoke-wait 0.5)
     (smoke-roll 0 128)
     (smoke-rec-stop)
     (smoke-quit)
     )
    ((8)
     ;; T8 to T12, Freedom League at the Port: class help, health, the guard's ammo, tazer, rolls and
     ;; strafes, its close attack's delay, the START ring's locks, damage on the 24 point scale and
     ;; the kill counter, who aims at whom; the jetpack's health and boost
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-help-shots 2)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-hp-check BF_CLASS_BLUE_GUARD)
     (smoke-start-locks)
     (smoke-invulnerable #t)
     (smoke-guard-ammo)
     (smoke-weapon-shots)
     (smoke-tazer)
     (smoke-guard-moves)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-invulnerable #f)
     (smoke-player-hits #f)
     (smoke-unit-damage)
     (smoke-hatred-check)
     ;; the jetpack's boost from the base, in the open (25 m off a control point it met a wall)
     (smoke-go-near (-> *bf* team))
     (smoke-change-class 1 "blue jetpack")
     (smoke-hp-check BF_CLASS_BLUE_JETPACK)
     (smoke-invulnerable #t)
     (smoke-jet-boost)
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((10)
     ;; The author's play (round 15): Freedom League in the Industrial Zone, the blue guard deployed at
     ;; once; the red guards' armor, the tazer's stab while walking, the roll and the strafe on film,
     ;; a jetpack guard's flames, then a long fight
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-status "blue guard deployed")
     (smoke-invulnerable #t)
     (smoke-check "no guard has both armors hidden" (zero? (smoke-guard-masks)))
     (smoke-tazer-walk)
     (smoke-step "film the rolls")
     (smoke-rec-start "roll" 2)
     (smoke-roll 255 128)
     (smoke-wait 0.5)
     (smoke-roll 128 0)
     (smoke-rec-stop)
     (smoke-step "film the strafe")
     (smoke-rec-start "strafe" 2)
     (smoke-strafe 255)
     (smoke-rec-stop)
     (smoke-guard-moves)
     (smoke-check "a jetpack guard near to look at" (smoke-look-at-jetpack))
     (smoke-invulnerable #f)
     (smoke-free-fight BF_CLASS_BLUE_GUARD 40.0)
     (smoke-check "no guard has both armors hidden after the fight" (zero? (smoke-guard-masks)))
     (smoke-status "blue guard after the fight")
     (smoke-check "still in the battle after the long fight" (and *target* (bf-fighting?)))
     (smoke-quit)
     )
    ((18)
     ;; Round 18, Freedom League: the units conquer and defend the points on foot, the player out of
     ;; them, at Freedom HQ's point (`smoke-conquer-defend`)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-conquer-defend BF_TEAM_FF 5 "base-leave" "conquest" "defense")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((23)
     ;; Round 20: START opens the battle's own pause page; a battle with 40 units a side brought by
     ;; their ships at random held points; the minimap's marks by side and the points' black discs;
     ;; guards 1.5 times faster; the first fight between the Slums and the Industrial Zone; the
     ;; overlay (L3 since round 22); the deploy with no frame of Jak; the class model facing the crosshair as it fires
     (smoke-mods-toggle "mods-menu-on")
     (smoke-step "start page")
     (smoke-press (pad-buttons start) 1.5)
     (format 0 "SMOKE start: page ~D mode ~A progress ~A~%" (if (smoke-dir) (-> (smoke-dir) page) -1) *master-mode*
             (if *progress-process* #t #f))
     (smoke-check "START opens the battle's pause page, the game paused, no game menu"
                  (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE) (= *master-mode* 'menu) (not *progress-process*))
                  )
     (smoke-shot "pause-page-lobby")
     (smoke-press (pad-buttons circle) 1.0)
     (smoke-check "Circle closes it, the game runs" (and (= (-> (smoke-dir) page) BF_PAGE_NONE) (= *master-mode* 'game)))
     (smoke-press (pad-buttons start) 1.5)
     (set! (-> (smoke-dir) cursor) 1)
     (smoke-wait 0.3)
     (smoke-press (pad-buttons x) 2.0)
     (smoke-check "New battle on the pause page opens the war zone page" (= (-> (smoke-dir) page) BF_PAGE_ZONE))
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 0.5)
     (smoke-press (pad-buttons x) 1.0)
     (set! (-> (smoke-dir) cursor) BF_TEAM_FF)
     (smoke-tap (pad-buttons x) 4)
     (let ((t0 (smoke-now)))
       (until (or (= (-> *bf* phase) BF_PHASE_FIGHT) (< (seconds 150) (- (smoke-now) t0)))
         (smoke-default-mesh "loading")
         (smoke-wait 0.5)
         )
       )
     (dotimes (k 4)
       (smoke-default-mesh "fight")
       (smoke-wait 0.5)
       )
     ;; the deploy: no frame with Jak drawn and his class model not there yet
     (smoke-step "deploy")
     (dotimes (k 20)
       (set! (-> *bf-drops-at* k) 0)
       )
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 0.5)
     (smoke-rec-start "deploy" 2)
     (smoke-tap (pad-buttons x) 4)
     (let ((shown 0))
       (dotimes (f 240)
         (if (zero? (mod f 30))
             (smoke-default-mesh "deploy")
             )
         (if (and *target*
                  (= (-> (smoke-dir) page) BF_PAGE_NONE)
                  (not (logtest? (-> *target* draw status) (draw-control-status no-draw)))
                  (not (bf-avatar-alive?))
                  )
             (+! shown 1)
             )
         (suspend)
         )
       (smoke-rec-stop)
       (format 0 "SMOKE deploy: Jak drawn without his class model in ~D frames of 240~%" shown)
       (smoke-check "no frame shows Jak at the deploy" (and (zero? shown) (bf-avatar-alive?)))
       )
     ;; each side starts at its own base: in the fight's first 10 s every unit awake stands within
     ;; 200 m of its side's base (point 0 the Freedom League's, 1 the Krimzon Guard's)
     (let ((far 0)
           (seen-ff 0)
           (seen-kg 0)
           )
       (dotimes (k 10)
         (smoke-wait 1.0)
         (dotimes (d (-> *bf-unit-dots* count))
           (let* ((team (-> *bf-unit-dots* team d))
                  (dist (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points team pos)))
                  )
             (if (< (meters 200) dist)
                 (+! far 1)
                 )
             (if (= team BF_TEAM_FF)
                 (set! seen-ff (max seen-ff 1))
                 (set! seen-kg (max seen-kg 1))
                 )
             )
           )
         (if (zero? (mod k 3))
             (smoke-dots-line "start")
             )
         )
       (smoke-drops-line "start")
       (format 0 "SMOKE start: ~D unit samples over 200 m from their base in the first 10 s~%" far)
       (smoke-check "each side's first units stand at its own base (none over 200 m from it)"
                    (and (zero? far) (= seen-ff 1) (= seen-kg 1))
                    )
       )
     (smoke-invulnerable #t)
     (smoke-wait 3.0)
     (format 0 "SMOKE guard class speed ~f~%" (-> *setting-control* user-default speed-mult))
     (smoke-check "the guard class runs 1.5 times as fast (speed 1.425)"
                  (and (< 1.4 (-> *setting-control* user-default speed-mult)) (< (-> *setting-control* user-default speed-mult) 1.45))
                  )
     ;; the armies, four minutes
     (smoke-step "armies")
     (let ((c (new 'stack-no-clear 'array 'int32 4))
           (most-ff 0)
           (most-kg 0)
           (fast 0.0)
           (first-fight -1)
           (fight-time 0)
           (first-battle -1)
           (battle-time 0)
           )
       (dotimes (k 360)
         (smoke-wait 1.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         (set! fast (fmax fast (bf-city-guard-speed)))
         (when (< first-fight 0)
           (dotimes (i (-> *bf* point-count))
             (let ((pt (-> *bf* points i)))
               (when (and (< first-fight 0) (not (-> pt base?)) (> (-> pt near 0) 0) (> (-> pt near 1) 0))
                 (set! first-fight i)
                 (set! fight-time k)
                 )
               )
             )
           )
         ;; the first place the two armies meet: 5 units of each side or more within 250 m of a
         ;; control point (a lone jetpack flying over one is not a fight)
         (when (< first-battle 0)
           (dotimes (i (-> *bf* point-count))
             (when (and (< first-battle 0) (not (-> *bf* points i base?)))
               (let ((ff 0)
                     (kg 0)
                     )
                 (dotimes (d (-> *bf-unit-dots* count))
                   (when (< (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points i pos)) (meters 250))
                     (if (= (-> *bf-unit-dots* team d) BF_TEAM_FF)
                         (+! ff 1)
                         (+! kg 1)
                         )
                     )
                   )
                 (when (and (<= 5 ff) (<= 5 kg))
                   (set! first-battle i)
                   (set! battle-time k)
                   ;; the whole map at that moment, live (the L3 overlay), filmed
                   (set! (-> *bf* overlay?) #t)
                   (smoke-wait 0.5)
                   (smoke-shot "first-battle-map")
                   (smoke-rec-start "first-battle-map" 6)
                   (smoke-wait 6.0)
                   (smoke-rec-stop)
                   (set! (-> *bf* overlay?) #f)
                   )
                 )
               )
             )
           )
         (when (zero? (mod k 20))
           (smoke-team-line "armies")
           (format 0 "SMOKE marching at ~D s: Freedom League ~D, Krimzon Guard ~D; ways over ~D meshes, to each point" k
                   (bf-city-march-count BF_TEAM_FF) (bf-city-march-count BF_TEAM_KG) (bf-ways-reach -1))
           (dotimes (i (-> *bf* point-count))
             (format 0 " ~D" (bf-ways-reach i))
             )
           (format 0 "~%")
           (smoke-dots-line "armies")
           (smoke-points-line "armies")
           (smoke-drops-line "armies")
           (smoke-minimap-marks "armies")
           )
         (if (= k 60)
             (smoke-shot "armies-minimap")
             )
         )
       (format 0 "SMOKE armies: at most Freedom League ~D, Krimzon Guard ~D awake; fastest guard ~M/s; first contact on a point ~D (~S) after ~D s~%"
               most-ff most-kg fast first-fight (if (>= first-fight 0) (bf-point-name first-fight) "none") fight-time)
       (format 0 "SMOKE armies: the two armies first meet at point ~D (~S) after ~D s~%"
               first-battle (if (>= first-battle 0) (bf-point-name first-battle) "none") battle-time)
       (smoke-check "both armies about 40 strong (32 or more awake each)" (and (<= 32 most-ff) (<= 32 most-kg)))
       (smoke-check "the guards run 1.5 times as fast (over 16 m/s)" (< (meters 16) fast))
       (smoke-check "the armies first meet at the Slums' or the Industrial Zone's point (5 a side within 250 m)"
                    (or (= first-battle 3) (= first-battle 4))
                    )
       (smoke-check "a side's units come down at several of its points" (<= 2 (smoke-drops-line "end")))
       (smoke-check "every unit's minimap mark in its side's color, every point marked" (and (zero? (smoke-minimap-marks "end"))
                                                                                          (= (-> *smoke-marks* 2) (-> *bf* point-count))
                                                                                          (< 10 (-> *smoke-marks* 0))
                                                                                          )
                    )
       )
     ;; L3 (R3 until round 22): the kills, the deaths and the whole map
     (smoke-step "r3")
     (smoke-press (pad-buttons l3) 1.0)
     (smoke-check "L3 shows the kills, the deaths and the whole map, not the first-person view"
                  (and (-> *bf* overlay?) (= (-> *target* cam-user-mode) 'normal))
                  )
     (smoke-shot "r3-overlay")
     (smoke-rec-start "r3-overlay" 6)
     (smoke-wait 4.0)
     (smoke-rec-stop)
     (smoke-press (pad-buttons l3) 1.0)
     (smoke-check "L3 again hides it" (not (-> *bf* overlay?)))
     ;; START in the battle: the pause page and the city's live map
     (smoke-step "pause map")
     (smoke-press (pad-buttons start) 1.5)
     (smoke-check "START in the battle opens the pause page over the city's map"
                  (and (= (-> (smoke-dir) page) BF_PAGE_PAUSE) (= *master-mode* 'menu) (< 10 (-> *bf-unit-dots* count)))
                  )
     (smoke-shot "pause-map")
     (smoke-press (pad-buttons start) 1.5)
     (smoke-check "START again: back to the battle" (and (= (-> (smoke-dir) page) BF_PAGE_NONE) (= *master-mode* 'game)))
     ;; the Krimzon Guard's marks on the minimap, at the Port's point
     (smoke-step "port minimap")
     (smoke-film-point 2)
     (smoke-wait 2.0)
     (smoke-minimap-marks "port")
     (smoke-shot "port-minimap")
     ;; the class model faces the crosshair as it fires, walking sideways, the crosshair 70 degrees
     ;; off the walk
     (smoke-step "shoot")
     (set! (-> *bf* view-yaw) (+ (-> *bf* view-yaw) (degrees 70)))
     (smoke-wait 1.0)
     (set! *smoke-lx* 255)
     (smoke-hold (pad-buttons r1))
     (smoke-rec-start "shoot" 2)
     (let ((worst 0.0)
           (shots 0)
           (good 0)
           )
       (dotimes (f 240)
         (let ((av (smoke-av)))
           ;; the frames drawn after a shot: the model is placed after every process has run (its
           ;; camera post), so the frame of the shot itself reads last frame's facing here
           (when (and av
                      (time-elapsed? (-> av fire-time) (seconds 0.02))
                      (not (time-elapsed? (-> av fire-time) (seconds 0.1)))
                      )
             (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> av root quat)))
                   (dir (vector-! (new 'stack-no-clear 'vector) (-> av aim) (-> av root trans)))
                   )
               (set! (-> fwd y) 0.0)
               (set! (-> dir y) 0.0)
               (when (< (meters 1) (vector-length dir))
                 (vector-normalize! fwd 1.0)
                 (vector-normalize! dir 1.0)
                 (+! shots 1)
                 (let ((off (acos (fmax -1.0 (fmin 1.0 (vector-dot fwd dir))))))
                   (set! worst (fmax worst off))
                   (if (< off (degrees 12))
                       (+! good 1)
                       )
                   )
                 )
               )
             )
           )
         (suspend)
         )
       (smoke-rec-stop)
       (smoke-hold (the-as pad-buttons 0))
       (set! *smoke-lx* 128)
       ;; the frames drawn after a shot are read here a frame late: when the crosshair jumps from a
       ;; unit near the camera to the far scenery, that frame compares two aims
       (format 0 "SMOKE shoot: ~D shot frames, ~D within 12 degrees of the crosshair's line, at most ~f degrees off~%"
               shots good (/ worst 182.04445))
       (smoke-check "the class model faces the crosshair as it fires (9 shot frames in 10 within 12 degrees)"
                    (and (< 0 shots) (<= (* 9 shots) (* 10 good)))
                    )
       )
     (smoke-invulnerable #f)
     (smoke-quit)
     (smoke-wait-for 60.0 (lambda () (= (-> *bf* city-load) BF_LOAD_OFF)))
     (smoke-wait 5.0)
     (smoke-check "after the battle Jak is drawn again, standing"
                  (and *target* (not (logtest? (-> *target* draw status) (draw-control-status no-draw))))
                  )
     )
    ((29)
     ;; Round 22: L3 shows the kills, the deaths and the whole map (R3 no more); the tazer's stab on
     ;; the whole body; the dead units' pickups, gone 10 s after they appear; every unit 1.5 times
     ;; as fast with the AI guards' legs at the player's guard's pace; the robotguards and spider
     ;; robots march to their points; each side's units come down at the front and at its points
     ;; under attack; a fallen unit's place waits 5 s
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 2.0)
     ;; L3, R3, L3 + SELECT
     (smoke-step "l3")
     (smoke-press (pad-buttons l3) 1.5)
     (smoke-check "L3: the kills, the deaths and the whole map, the game's minimap off"
                  (and (-> *bf* overlay?) (not (logtest? (-> *setting-control* user-current minimap) (minimap-flag minimap))))
                  )
     (smoke-shot "l3-overlay")
     (smoke-press (pad-buttons r3) 1.0)
     (smoke-check "R3 no longer closes it" (-> *bf* overlay?))
     (smoke-press (pad-buttons l3) 1.5)
     (smoke-check "L3 again closes it, the minimap back"
                  (and (not (-> *bf* overlay?)) (logtest? (-> *setting-control* user-current minimap) (minimap-flag minimap)))
                  )
     (smoke-tap (pad-buttons l3 select) 6)
     (smoke-wait 1.5)
     (smoke-check "L3 + SELECT opens the Mods menu and leaves the map closed" (and *popup-menu-open* (not (-> *bf* overlay?))))
     (smoke-tap (pad-buttons l3 select) 6)
     (smoke-wait 1.5)
     (smoke-check "L3 + SELECT again closes the Mods menu, the map still closed" (and (not *popup-menu-open*) (not (-> *bf* overlay?))))
     ;; the tazer's stab
     (smoke-step "tazer")
     (smoke-press (pad-buttons left) 1.0)
     (set! (-> *bf* tazer-time) 0)
     (smoke-rec-start "tazer" 2)
     (smoke-wait 0.3)
     (smoke-tap (pad-buttons r1) 4)
     ;; frame by frame for 2 s: the stab's three clips on the whole body (the thrust, the zap, the
     ;; arm back), and when it is over
     (let ((start -1)
           (end -1)
           (clips 0)
           )
       (dotimes (f 120)
         (suspend)
         (when (smoke-av)
           (let ((on? (and (nonzero? (-> (smoke-av) stab-until)) (= (-> (smoke-av) anim) (-> (smoke-av) stab-clip)))))
             (if (and on? (< start 0))
                 (set! start f)
                 )
             (when on?
               (case (-> (smoke-av) anim)
                 ((BF_CLIP_STAB_IN) (set! clips (logior clips 1)))
                 ((BF_CLIP_TAZER) (set! clips (logior clips 2)))
                 ((BF_CLIP_STAB_OUT) (set! clips (logior clips 4)))
                 )
               )
             (if (= f (+ start 12))
                 (smoke-shot "tazer-stab")
                 )
             (if (and (>= start 0) (< end 0) (zero? (-> (smoke-av) stab-until)))
                 (set! end f)
                 )
             )
           )
         )
       (smoke-rec-stop)
       (format 0 "SMOKE tazer: the stab on the whole body from frame ~D to ~D after R1, clips seen ~D (7: thrust, zap, arm back)~%"
               start end clips)
       (smoke-check "R1 with the tazer plays the guard's whole stab: the thrust, the zap, the arm back"
                    (and (>= start 0) (< start 30) (< (+ start 30) end) (= clips 7))
                    )
       )
     (smoke-press (pad-buttons down) 1.0)
     ;; a dead unit's pickup, 15 m ahead: there after 8 s, gone after 11 s
     (smoke-step "pickup")
     (vector-copy! *smoke-ammo-at* (-> *target* control trans))
     (let ((fwd (bf-view-forward (new 'stack-no-clear 'vector))))
       (vector+*! *smoke-ammo-at* *smoke-ammo-at* fwd (meters 15))
       )
     (let ((k (-> *bf* drop-count)))
       (when (< k BF_DROP_MAX)
         (set! (-> *bf* drop-kind k) (the-as int (pickup-type ammo-yellow)))
         (vector-copy! (-> *bf* drop-pos k) *smoke-ammo-at*)
         (+! (-> *bf* drop-count) 1)
         )
       )
     (smoke-wait 1.0)
     (let ((n1 (smoke-ammo-near)))
       (smoke-shot "pickup-there")
       (smoke-wait 8.0)
       (let ((n9 (smoke-ammo-near)))
         ;; at 10 s it fades out, in 1 s (collectables.gc fade)
         (smoke-wait 3.5)
         (let ((n12 (smoke-ammo-near)))
           (smoke-shot "pickup-gone")
           (format 0 "SMOKE pickup 15 m ahead: ~D after 1 s, ~D after 9 s, ~D after 12.5 s~%" n1 n9 n12)
           (smoke-check "a dead unit's pickup goes 10 s after it appears (gone by 12.5 s), Jak 15 m away" (and (> n1 0) (> n9 0) (zero? n12)))
           )
         )
       )
     ;; speeds, the AI guards' pace
     (smoke-wait 30.0)
     (smoke-step "speeds")
     (smoke-unit-speeds 10.0)
     (format 0 "SMOKE speeds: fastest guard ~M/s, jetpack ~M/s, robotguard ~M/s, spider ~M/s~%"
             (-> *smoke-top* 0) (-> *smoke-top* 1) (-> *smoke-top* 2) (-> *smoke-top* 3))
     (smoke-check "units 1.5 times as fast: guards over 16 m/s (stock 12), spider robots over 9.6 m/s (8), jetpacks over 30 m/s (25)"
                  (and (< (meters 16) (-> *smoke-top* 0)) (< (meters 9.6) (-> *smoke-top* 3)) (< (meters 30) (-> *smoke-top* 1))))
     (smoke-guard-pace "pace")
     ;; the front, the robotguards' and spiders' march
     (smoke-step "front")
     (dotimes (k 20)
       (set! (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
       )
     (dotimes (k 8)
       (set! (-> *smoke-front* k) 0)
       )
     (smoke-bots-line "march start")
     (format 0 "SMOKE bots noted: ~D away from their point, no foe near~%" (smoke-bots-snap))
     (let ((t0 (smoke-now))
           (marched? #f)
           )
       (while (< (- (smoke-now) t0) (seconds 150))
         (smoke-wait 0.5)
         (smoke-front-tick)
         (when (and (not marched?) (< (seconds 25) (- (smoke-now) t0)))
           (set! marched? #t)
           (let* ((r (smoke-bots-closer))
                  (closer (/ r 1000))
                  (alive (mod r 1000))
                  )
             (format 0 "SMOKE bots after 25 s: ~D of ~D still awake on the same point came 10 m closer to it or reached it~%" closer alive)
             (smoke-check "the robotguards and spider robots march to their points (2 in 3 came 10 m closer in 25 s)"
                          (and (> alive 0) (<= (* 2 alive) (* 3 closer))))
             )
           )
         ;; every 15 s two guards of each side fall far from their base: their places come down again
         (when (zero? (mod (/ (- (smoke-now) t0) 150) 30))
           (smoke-kill-units BF_TEAM_FF 'crimson-guard 2 #t)
           (smoke-kill-units BF_TEAM_KG 'crimson-guard 2 #t)
           (smoke-points-line "front")
           )
         )
       )
     (dotimes (team 2)
       (format 0 "SMOKE front side ~D: ~D drops with another point to come down at, ~D at the front, ~D at a point under attack"
               team (-> *smoke-front* (* 4 team)) (-> *smoke-front* (+ (* 4 team) 1)) (-> *smoke-front* (+ (* 4 team) 2)))
       (format 0 ", ~D at either~%" (-> *smoke-front* (+ (* 4 team) 3)))
       )
     (let ((all (+ (-> *smoke-front* 0) (-> *smoke-front* 4)))
           (good (+ (-> *smoke-front* 3) (-> *smoke-front* 7)))
           )
       (smoke-check "units come down at the point nearest the foe or under attack (4 in 5 of the drops with a choice)"
                    (and (> all 3) (<= (* 4 all) (* 5 good))))
       )
     ;; a fallen unit's place waits 5 s
     (smoke-step "respawn")
     (let ((t0 (smoke-now)))
       (while (and (< (smoke-awake-of BF_TEAM_KG 0) 16) (< (- (smoke-now) t0) (seconds 90)))
         (smoke-wait 0.5)
         )
       (format 0 "SMOKE respawn: ~D Krimzon Guard guards awake after ~D s~%" (smoke-awake-of BF_TEAM_KG 0) (/ (- (smoke-now) t0) 300))
       )
     (let* ((killed (smoke-kill-units BF_TEAM_KG 'crimson-guard 4 #f))
            (tk (smoke-now))
            (low (smoke-awake-of BF_TEAM_KG 0))
            (first -1)
            )
       (while (and (< first 0) (< (- (smoke-now) tk) (seconds 15)))
         (smoke-wait 0.25)
         (let ((c (smoke-awake-of BF_TEAM_KG 0)))
           (if (< c low)
               (set! low c)
               )
           (if (< low c)
               (set! first (- (smoke-now) tk))
               )
           )
         )
       (format 0 "SMOKE respawn: ~D guards killed, down to ~D awake, the first back after ~f s~%" killed low (/ (the float first) 300.0))
       (smoke-check "a fallen unit's place waits 5 s: the first new guard comes 5 to 10 s after the kills"
                    (and (> killed 0) (<= (seconds 4.8) first) (< first (seconds 10))))
       )
     ;; an attacked point: 6 Krimzon Guard guards put on the Freedom League's base
     (smoke-step "defense")
     (let ((base -1))
       (dotimes (i (-> *bf* point-count))
         (if (and (-> *bf* points i base?) (= (-> *bf* points i owner) BF_TEAM_FF))
             (set! base i)
             )
         )
       (when (>= base 0)
         (format 0 "SMOKE defense: ~D Krimzon Guard guards put on ~S; ~D Freedom League guards fall elsewhere~%"
                 (bf-city-send BF_TEAM_KG base 6) (bf-point-name base) (smoke-kill-units BF_TEAM_FF 'crimson-guard 6 #t))
         (let ((before (-> *bf-drops-at* base))
               (all0 0)
               )
           (dotimes (i 10)
             (+! all0 (-> *bf-drops-at* i))
             )
           (smoke-wait 30.0)
           (let ((all1 0))
             (dotimes (i 10)
               (+! all1 (-> *bf-drops-at* i))
               )
             (format 0 "SMOKE defense: ~D Freedom League units came down in 30 s, ~D at its attacked base~%" (- all1 all0)
                     (- (-> *bf-drops-at* base) before))
             (smoke-check "a point under attack gets a share of its side's new units (2 in 5 or more)"
                          (and (> (- all1 all0) 0) (<= (* 2 (- all1 all0)) (* 5 (- (-> *bf-drops-at* base) before)))))
             )
           )
         )
       )
     (smoke-quit)
     )
    ((30)
     ;; Round 22, filmed: an AI guard of the player's side running its march, the camera on it, and
     ;; the player's guard running beside it, to compare their legs' pace
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 20.0)
     (let ((h (the-as handle #f))
           (t0 (smoke-now))
           )
       ;; a marching guard of the player's side 10 to 40 m away
       (while (and (not (handle->process h)) (< (- (smoke-now) t0) (seconds 60)))
         (dotimes (i (smoke-collect 'crimson-guard 'crimson-guard))
           (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
             (when (and p (not (handle->process h)) (= (bf-unit-team p) BF_TEAM_FF) (bf-marching? p)
                        (< (meters 10) (vector-vector-xz-distance (-> p root trans) (-> *target* control trans)))
                        (< (vector-vector-xz-distance (-> p root trans) (-> *target* control trans)) (meters 40)))
               (set! h (-> *smoke-handles* i))
               )
             )
           )
         (smoke-wait 0.5)
         )
       (format 0 "SMOKE film: a marching guard ~A~%" (if (handle->process h) #t #f))
       (when (handle->process h)
         (smoke-rec-start "ai-run" 2)
         ;; Jak kept 7 m behind it and 4 m to its right, the camera on it
         (dotimes (f 150)
           (let ((p (the-as process-drawable (handle->process h))))
             (when p
               (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> p root quat)))
                     (at (vector-copy! (new 'stack-no-clear 'vector) (-> p root trans)))
                     )
                 (set! (-> fwd y) 0.0)
                 (vector-normalize! fwd 1.0)
                 (vector+*! at at fwd (meters -7))
                 (+! (-> at x) (* (meters 4) (-> fwd z)))
                 (+! (-> at z) (* (meters -4) (-> fwd x)))
                 (move-to-point! (-> *target* control) at)
                 (smoke-look-at (-> p root trans) 0.0)
                 )
               )
             )
           (suspend)
           )
         (smoke-rec-stop)
         ;; the same guard's clip pace with the stock stride (as before round 22: 18 m/s, its legs
         ;; as fast) and with the round's, against the player's guard running
         (let ((new0 (smoke-clip-pace h #f 20))
               (old (smoke-clip-pace h #t 20))
               (new1 (smoke-clip-pace h #f 20))
               )
           (smoke-stick 128 0 128 128)
           (smoke-wait 1.0)
           (let ((f0 (-> (smoke-av) skel root-channel 0 frame-num)))
             (suspend)
             (let ((mine (- (-> (smoke-av) skel root-channel 0 frame-num) f0)))
               (smoke-stick 128 128 128 128)
               (format 0 "SMOKE pace: the AI guard ~f (round 22) and ~f (stock stride), the player's guard ~f clip frames a frame~%"
                       (* 0.5 (+ new0 new1)) old mine)
               (smoke-check "an AI guard's legs at the player's guard's pace (within 20 %), 1.5 times faster with the stock stride"
                            (and (< 0.0 mine)
                                 (< (fabs (- (* 0.5 (+ new0 new1)) mine)) (* 0.2 mine))
                                 (< (* 1.3 mine) old)
                                 )
                            )
               )
             )
           )
         )
       ;; the player's guard running the street the guard ran, filmed from behind
       (let ((p (the-as process-drawable (handle->process h))))
         (if p
             (set! (-> *bf* view-yaw) (vector-y-angle (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> p root quat))))
             )
         )
       )
     (smoke-wait 0.5)
     (smoke-stick 128 0 128 128)
     (smoke-wait 0.5)
     (smoke-rec-start "player-run" 2)
     (smoke-wait 2.5)
     (smoke-rec-stop)
     (smoke-stick 128 128 128 128)
     (smoke-quit)
     )
    ((31)
     ;; Round 23: the class page (help lines, previews); bursts of 3 from the ships, ships seen over
     ;; the bases only, the Port swapped, the drops where the crowd is, goals spread; no guard with
     ;; its legs only; a hit leaving an empty ring kills, each class's own death; the robotguard
     ;; fires behind its shield, stands still, its gauge refills; the spider's sprint, its headbutt
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_KG)
     ;; the class page: the red guard's help, its preview on the blue guard's clips, the previews' pace
     (smoke-step "class page")
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 2.0)
     (smoke-shot "class-guard")
     ;; round 30: the class page shows a picture, no turning model to check any more
     (set! (-> (smoke-dir) cursor) 3)
     (smoke-wait 2.0)
     (smoke-shot "class-spider")
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 1.0)
     (smoke-deploy 0 "deploy red guard")
     (smoke-invulnerable #t)
     ;; the Port swapped: the Krimzon Guard's base at the Port's middle, the Port's point on the docks
     (format 0 "SMOKE port: base at ~M ~M, the Port's point at ~M ~M~%" (-> *bf* points 1 pos x) (-> *bf* points 1 pos z)
             (-> *bf* points 2 pos x) (-> *bf* points 2 pos z))
     (smoke-check "the Krimzon Guard's base in the Port's middle, its control point on the east docks"
                  (and (< (fabs (- (-> *bf* points 1 pos x) (meters 303))) (meters 40))
                       (< (fabs (- (-> *bf* points 2 pos x) (meters 620))) (meters 40))
                       )
                  )
     ;; 150 s of battle: bursts, the drops' points, the guards' armor
     (smoke-step "battle")
     (dotimes (k 20)
       (set! (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
       )
     (dotimes (k 4)
       (set! (-> *smoke-crowd* k) 0)
       )
     (set! *smoke-armor-bad* 0)
     (let ((t0 (smoke-now)))
       (while (< (- (smoke-now) t0) (seconds 180))
         (smoke-wait 0.5)
         (smoke-crowd-tick)
         (when (zero? (mod (/ (- (smoke-now) t0) 150) 30))
           (smoke-armor-scan "battle")
           (smoke-kill-units BF_TEAM_FF 'crimson-guard 2 #t)
           (smoke-kill-units BF_TEAM_KG 'crimson-guard 2 #t)
           )
         )
       )
     (format 0 "SMOKE burst: at most ~D units in one try~%" (-> *bf-burst-max* 0))
     (smoke-check "a ship drops up to 3 units at once (2 or more seen)" (<= 2 (-> *bf-burst-max* 0)))
     (format 0 "SMOKE crowd: ~D drops with a choice, ~D at the crowd's point, ~D at a point under attack, ~D at either~%"
             (-> *smoke-crowd* 0) (-> *smoke-crowd* 1) (-> *smoke-crowd* 2) (-> *smoke-crowd* 3))
     (smoke-check "most units come down where the crowd is or at an attacked point (3 in 5 of the drops with a choice)"
                  (and (> (-> *smoke-crowd* 0) 3) (<= (* 3 (-> *smoke-crowd* 0)) (* 5 (-> *smoke-crowd* 3)))))
     (let ((r (smoke-ships-line)))
       (smoke-check "a ship drawn over the bases only, ghosts over the control points" (and (< r 100) (> r 0)))
       )
     (let* ((r0 (smoke-goal-spread BF_TEAM_FF))
            (r1 (smoke-goal-spread BF_TEAM_KG))
            )
       (format 0 "SMOKE goals: Freedom League ~D of ~D, Krimzon Guard ~D of ~D for another point than the most wanted~%"
               (/ r0 1000) (mod r0 1000) (/ r1 1000) (mod r1 1000))
       (smoke-check "the units do not all go for the same point" (or (> (/ r0 1000) 0) (> (/ r1 1000) 0)))
       )
     (smoke-check "no guard drawn with its legs only" (zero? *smoke-armor-bad*))
     ;; a hit leaving an empty ring kills; the red guard's death
     (smoke-step "empty ring")
     (smoke-invulnerable #f)
     (let ((foe (smoke-nearest-foe-unit BF_TEAM_FF 'crimson-guard))
           (invuln? (logtest? (-> *game-info* secrets) (game-secrets invulnerable)))
           )
       ;; the test save keeps the invulnerable secret on: lifted for the blow
       (logclear! (-> *game-info* secrets) (game-secrets invulnerable))
       (set! (-> *target* fact health) 3.6)
       (smoke-wait 0.2)
       (smoke-rec-start "death-guard" 2)
       (if foe
           (smoke-hit-from foe *target*)
           )
       (smoke-wait 0.5)
       (if invuln?
           (logior! (-> *game-info* secrets) (game-secrets invulnerable))
           )
       (format 0 "SMOKE empty ring: a unit's blow at 3.6 of 8: dead ~A, health ~f~%" (focus-test? *target* dead) (-> *target* fact health))
       (smoke-check "a blow that leaves less than one segment of the ring kills" (and foe (focus-test? *target* dead)))
       (smoke-wait 1.0)
       (let ((dying? (and (smoke-av) (-> (smoke-av) dying?)))
             (spect? (if (handle->process (-> *bf* spectate)) #t #f))
             )
         (smoke-wait 2.0)
         (smoke-rec-stop)
         (smoke-wait 1.0)
         (format 0 "SMOKE red guard death: dying ~A, spectating ~A, gone ~A~%" dying? spect? (not (bf-avatar-alive?)))
         (smoke-check "the guard plays its death, watched, then goes in sparks" (and dying? (not spect?) (not (bf-avatar-alive?))))
         )
       )
     (smoke-respawn-page 20.0)
     (smoke-press (pad-buttons x) 1.0)
     (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)))))
     (smoke-wait 4.0)
     (smoke-invulnerable #t)
     ;; the robotguard: still, its shots behind its shield, its gauge
     (smoke-change-class 2 "robotguard")
     (smoke-step "robot still")
     (smoke-neutral)
     (smoke-wait 1.5)
     (let ((f0 (-> (smoke-av) skel root-channel 0 frame-num)))
       (smoke-wait 1.0)
       (format 0 "SMOKE robot still: clip ~D, frame ~f then ~f~%" (-> (smoke-av) anim) f0 (-> (smoke-av) skel root-channel 0 frame-num))
       (smoke-check "the robotguard standing still holds its pose (no idle loop)"
                    (and (= (-> (smoke-av) anim) 3) (= f0 (-> (smoke-av) skel root-channel 0 frame-num))))
       )
     (smoke-step "robot shield")
     (smoke-press (pad-buttons circle) 0.5)
     (let ((far 0.0))
       (smoke-rec-start "robot-shield" 2)
       (smoke-hold (pad-buttons r1))
       (dotimes (f 60)
         (dotimes (i (smoke-collect 'guard-shot 'roboguard-shot))
           (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
             (if (and p (= (ppointer->process (-> p parent)) *target*))
                 (set! far (fmax far (vector-vector-distance (-> p root trans) (-> *target* control trans))))
                 )
             )
           )
         (suspend)
         )
       (smoke-hold (the-as pad-buttons 0))
       (smoke-rec-stop)
       (format 0 "SMOKE robot shield: up ~A, its shots as far as ~M from it~%" (-> (smoke-av) shield?) far)
       (smoke-check "the robotguard fires behind its shield, the shots go out" (and (-> (smoke-av) shield?) (< (meters 10) far)))
       )
     (smoke-wait 10.0)
     (let ((g (bf-class-gauge)))
       (format 0 "SMOKE robot gauge: ~f, 5 s into its 25 s recharge~%" g)
       (smoke-check "the shield's gauge refills over its recharge (about 0.2 after 5 s)" (and (< 0.1 g) (< g 0.35)))
       )
     (smoke-invulnerable #f)
     (smoke-death-film "robot death" "death-robot")
     (smoke-invulnerable #t)
     ;; the jetpack's death
     (smoke-change-class 1 "red jetpack")
     ;; past the spawn shield's 3 s of invulnerability
     (smoke-wait 4.0)
     (smoke-invulnerable #f)
     (smoke-death-film "jetpack death" "death-jetpack")
     (smoke-invulnerable #t)
     ;; the spider: its sprint, its headbutt
     (smoke-change-class 3 "spider")
     (smoke-step "spider sprint")
     (let ((jump 0)
           (frames 0)
           )
       (smoke-stick 128 0 128 128)
       (smoke-hold (pad-buttons r2))
       (smoke-rec-start "spider-sprint" 2)
       (dotimes (f 180)
         (suspend)
         (+! frames 1)
         (if (and (smoke-av) (= (-> (smoke-av) anim) 6))
             (+! jump 1)
             )
         )
       (smoke-rec-stop)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-stick 128 128 128 128)
       (format 0 "SMOKE spider sprint: ~D frames of ~D on its leap clip~%" jump frames)
       (smoke-check "the spider's sprint plays no headbutt leap (under 5 % of its frames)" (< (* 20 jump) frames))
       )
     (smoke-headbutt-check)
     (smoke-armor-scan "end")
     (smoke-quit)
     )
    ((32)
     ;; Round 23, the spider's headbutt alone: a Krimzon Guard spider, a minute of battle, then its
     ;; headbutt on the nearest Freedom League guard
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_KG)
     (smoke-deploy 3 "deploy spider")
     (smoke-invulnerable #t)
     (smoke-wait 60.0)
     (smoke-headbutt-check)
     (smoke-quit)
     )
    ((33)
     ;; Round 23, diagnosis: the blue guards drawn with their legs only (both armor segments hidden)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (set! *smoke-armor-bad* 0)
     (set! *smoke-armor-seen?* #f)
     (dotimes (k 40)
       (smoke-wait 5.0)
       (smoke-armor-scan "diag")
       (when *smoke-armor-seen?*
         (set! *smoke-armor-seen?* #f)
         (smoke-look-at *smoke-armor-at* 0.0)
         (smoke-wait 0.3)
         (smoke-shot "armor")
         )
       )
     (format 0 "SMOKE armor: ~D sightings in 40 scans~%" *smoke-armor-bad*)
     (smoke-quit)
     )
    ((35)
     ;; Round 25: the red jetpack's flames, longer under R2; the player's ball 1.5 times as fast; the
     ;; units of the control points brought down from the sky (guards jumping, robotguards as a
     ;; ball, spiders tumbling, jetpacks flying down); the robotguards rolling on their long marches,
     ;; the stock roll 1.5 times as fast; the player's respawn from the sky, his controls off until
     ;; he lands, his class model's fall and landing
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_KG)
     (smoke-deploy 1 "deploy red jetpack")
     (smoke-invulnerable #t)
     (smoke-wait 2.0)
     ;; the flames: hovering, then boosting
     (smoke-step "flames")
     (smoke-hold (pad-buttons x))
     (smoke-wait 0.8)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-wait 1.5)
     (let ((idle (-> (smoke-av) flame)))
       (smoke-shot "flames-hover")
       (smoke-rec-start "flames-boost" 2)
       (smoke-hold (pad-buttons r2))
       (smoke-wait 2.0)
       (let ((boost (-> (smoke-av) flame)))
         (smoke-rec-stop)
         (smoke-hold (the-as pad-buttons 0))
         (format 0 "SMOKE flames: size ~f hovering, ~f boosting; drawn from the turbines ~A~%" idle boost (bf-hover-art? (smoke-av)))
         (smoke-check "the jetpack's flames burn from its turbines, longer under R2"
                      (and (bf-hover-art? (smoke-av)) (< 0.2 idle) (< (* 1.5 idle) boost)))
         )
       )
     ;; the battle as the red guard: a small model, the films' view clear
     (smoke-change-class 0 "red guard")
     ;; two minutes of battle: the units from the sky, the robotguards' rolls
     (smoke-step "battle")
     (smoke-sky-reset)
     (dotimes (k 5)
       (set! (-> *bf-roll-sample* k) 0)
       )
     (let ((t0 (smoke-now))
           (next (smoke-now))
           )
       (while (< (- (smoke-now) t0) (seconds 120))
         (smoke-sky-tick)
         (when (< next (smoke-now))
           (set! next (+ (smoke-now) (seconds 0.5)))
           (bf-city-roll-sample)
           ;; every 10 s three Krimzon Guard robotguards and two spiders fall: the side lacks them, and
           ;; its next ones come down at its point (its ships kept their counts full)
           (when (zero? (mod (/ (- (smoke-now) t0) 150) 20))
             (smoke-kill-units BF_TEAM_KG 'roboguard-city 3 #t)
             (smoke-kill-units BF_TEAM_KG 'spydroid 2 #t)
             )
           )
         (suspend)
         )
       )
     ;; the last ones counted
     (let ((t1 (smoke-now)))
       (while (< (- (smoke-now) t1) (seconds 8.5))
         (smoke-sky-tick)
         (suspend)
         )
       )
     ;; filmed: the next unit coming down where the last one came, then the next robotguard where the
     ;; Krimzon Guard's last robotguard or spider came
     (let ((pt (smoke-last-drop-point #f)))
       (when (>= pt 0)
         (smoke-film-drop pt -1 "sky-drop")
         (smoke-shot "sky-drop")
         )
       )
     (let ((pt (smoke-last-drop-point #t)))
       (if (>= pt 0)
           (smoke-film-drop pt 14 "robot-drop")
           )
       )
     (smoke-sky-line)
     (let* ((t (-> *smoke-sky* tally))
            (n (+ (-> t 0) (-> t 10) (-> t 15)))
            (high (+ (-> t 1) (-> t 11) (-> t 16)))
            (fall (+ (-> t 2) (-> t 12) (-> t 17)))
            (land (+ (-> t 3) (-> t 13) (-> t 18)))
            (gone (+ (-> t 4) (-> t 14) (-> t 19)))
            )
       (smoke-check "the units of the control points come down from the sky (4 in 5 seen 3 m up or more)"
                    (and (< 10 n) (<= (* 4 n) (* 5 high))))
       (smoke-check "guards in their jump, robotguards and spiders in their fall out of a ship (4 in 5)"
                    (and (< 10 n) (<= (* 4 n) (* 5 fall))))
       (smoke-check "they land on their nav poly (4 in 5 of those not killed first, under 4 m over it after a 30 m fall)"
                    (and (< 10 (- n gone)) (<= (* 4 (- n gone)) (* 5 land))))
       (smoke-check "robotguards and spiders come down too (1 or more of each)"
                    (and (<= 1 (-> t 10)) (<= 1 (-> t 15))))
       (smoke-check "the spiders land too (4 in 5 of those not killed first)"
                    (<= (* 4 (- (-> t 15) (-> t 19))) (* 5 (-> t 18))))
       (smoke-check "the jetpacks come down from 10 m or more (4 in 5), flying lower"
                    (or (zero? (-> t 5)) (and (<= (* 4 (-> t 5)) (* 5 (-> t 6))) (<= (* 4 (-> t 5)) (* 5 (-> t 7))))))
       )
     (let ((r *bf-roll-sample*))
       (format 0 "SMOKE robotguard rolls: ~D marching far, ~D of them as a ball, ~D over 24 m/s; ~D in the stock roll, ~D of them over 28 m/s~%"
               (-> r 0) (-> r 1) (-> r 2) (-> r 3) (-> r 4))
       (smoke-check "the robotguards roll as a ball on their long marches (4 in 5)"
                    (and (< 5 (-> r 0)) (<= (* 4 (-> r 0)) (* 5 (-> r 1)))))
       (smoke-check "their ball goes over 24 m/s (1 in 2; the stock walk 18, the stock roll 20)"
                    (<= (-> r 0) (* 2 (-> r 2))))
       (smoke-check "the stock roll aims at 30 m/s (every one seen)"
                    (= (-> r 3) (-> r 4)))
       )
     ;; the player's ball: robotguard, its walk then its ball, top speeds
     (smoke-change-class 2 "robotguard")
     (smoke-step "ball")
     (smoke-wait 1.0)
     (smoke-stick 128 0 128 128)
     (smoke-wait 0.5)
     (let ((walk (smoke-top-speed 2.5)))
       (smoke-stick 128 128 128 128)
       (dotimes (k 3)
         (if (not (-> (smoke-av) rolling?))
             (smoke-press (pad-buttons r2) 0.5)
             )
         )
       (format 0 "SMOKE player's robotguard rolling: ~A~%" (-> (smoke-av) rolling?))
       (smoke-stick 128 0 128 128)
       (smoke-wait 0.3)
       (let ((ball (smoke-top-speed 2.5)))
         (smoke-stick 128 128 128 128)
         (dotimes (k 3)
           (if (-> (smoke-av) rolling?)
               (smoke-press (pad-buttons r2) 0.5)
               )
           )
         (format 0 "SMOKE player's robotguard: walk ~M/s, ball ~M/s, ball ~f times the walk (2.4 / 1.05 = 2.29 at most before)~%"
                 walk ball (/ ball (fmax 1.0 walk)))
         (smoke-check "the player's ball faster than before (over 2.5 times its walk, 2.29 at most with the old 2.4)"
                      (and (< (* 2.5 walk) ball) (< ball (* 4.0 walk))))
         )
       )
     ;; the player's respawn from the sky, as the red guard
     (smoke-change-class 0 "red guard")
     (smoke-step "respawn")
     (smoke-wait 2.0)
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-wait 1.0)
     (let ((want (smoke-ahead-point BF_TEAM_KG)))
       (if (< want 0)
           (set! want BF_TEAM_KG)
           )
       (dotimes (k 8)
         (if (!= (-> *bf* respawn-pick) want)
             (smoke-press (pad-buttons right) 0.5)
             )
         )
       (format 0 "SMOKE respawn pick ~D (want ~D)~%" (-> *bf* respawn-pick) want)
       (smoke-tap (pad-buttons x) 2)
       (smoke-wait-for 3.0 (lambda () (-> *bf* dropping?)))
       ;; X held and the stick forward through the fall: the lock keeps them out
       (smoke-hold (pad-buttons x))
       (smoke-stick 128 0 128 128)
       (smoke-rec-start "respawn-fall" 2)
       (let ((start (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
             (ground (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* sky-ground)))
             (point (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points want pos)))
             (rise 0.0)
             (rise-frame 0)
             (rise-state 'none)
             (drift 0.0)
             (frames 0)
             (fall-clip 0)
             (land-clip? #f)
             )
         (while (and (-> *bf* dropping?) (< frames 600))
           (+! frames 1)
           ;; a jump: Jak going up in the air (his placement's first frames and his touchdown aside)
           (when (and (< 3 frames) (< (meters 1.5) (- (-> *target* control trans y) (-> ground y)))
                      (< rise (-> *target* control transv y))
                      )
             (set! rise (-> *target* control transv y))
             (set! rise-frame frames)
             (set! rise-state (-> *target* state name))
             )
           (set! drift (fmax drift (vector-vector-xz-distance (-> *target* control trans) start)))
           (if (and (smoke-av) (= (-> (smoke-av) anim) (bf-class-fall-clip BF_CLASS_RED_GUARD)))
               (+! fall-clip 1)
               )
           (suspend)
           )
         (smoke-hold (the-as pad-buttons 0))
         (smoke-stick 128 128 128 128)
         (dotimes (k 30)
           (if (and (smoke-av) (= (-> (smoke-av) anim) (bf-class-land-clip BF_CLASS_RED_GUARD)))
               (set! land-clip? #t)
               )
           (suspend)
           )
         (smoke-rec-stop)
         (smoke-shot "respawn-landed")
         (format 0 "SMOKE respawn fall: from ~M above its poly, the poly ~M from the point; ~D frames falling, ~D on the fall clip; "
                 (- (-> start y) (-> ground y)) (vector-vector-xz-distance ground point) frames fall-clip)
         (format 0 "rising ~M/s at most, drifted ~M with X held and the stick forward; landing clip ~A; landed ~M from the poly~%"
                 rise drift land-clip? (vector-vector-distance (-> *target* control trans) ground))
         (smoke-check "the player respawns in the sky (10 m or more) over a nav poly within 45 m of the point"
                      (and (< (meters 10) (- (-> start y) (-> ground y))) (< (vector-vector-xz-distance ground point) (meters 46))))
         (format 0 "SMOKE respawn fall: rising fastest at frame ~D, Jak in ~A~%" rise-frame rise-state)
         (smoke-check "no jump and no move while he falls (X and the stick held: never rising, drifted under 1 m)"
                      (and (< 10 frames) (< rise (meters 1)) (< drift (meters 1))))
         (smoke-check "the red guard falls on its jump clip, then lands on its landing clip"
                      (and (<= frames (* 2 fall-clip)) land-clip?))
         (smoke-check "he lands on the poly (within 2 m)" (< (vector-vector-distance (-> *target* control trans) ground) (meters 2)))
         )
       ;; his controls back
       (smoke-wait 1.0)
       (let ((p0 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
         (smoke-stick 128 0 128 128)
         (smoke-wait 1.0)
         (smoke-stick 128 128 128 128)
         (let ((d (vector-vector-xz-distance (-> *target* control trans) p0)))
           (format 0 "SMOKE after landing: ~M walked in 1 s~%" d)
           (smoke-check "his controls are back once he landed" (< (meters 2) d))
           )
         )
       )
     (smoke-invulnerable #t)
     (smoke-quit)
     )
    ((34)
     ;; Round 24: the rifle's 20/100, blue ammo recharging the tazer, a blue pickup kept blue; the
     ;; units appearing on the meshes around the most advanced point, no ship there; no foe behind a
     ;; wall; the pickups' shares; the jetpack's controls and its 10 s boost
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 1.0)
     ;; the rifle
     (smoke-step "rifle")
     (format 0 "SMOKE rifle: magazine ~D, reserve ~f~%" (-> *bf* mag BF_WEAPON_RIFLE) (-> *game-info* gun-ammo BF_AMMO_YELLOW))
     (smoke-check "the rifle holds 20 rounds, 5 magazines more carried (20/100)"
                  (and (= (-> *bf* mag BF_WEAPON_RIFLE) 20) (= (-> *game-info* gun-ammo BF_AMMO_YELLOW) 100.0)))
     (smoke-shot "rifle-hud")
     ;; blue ammo: the tazer recharged at once
     (smoke-step "blue ammo")
     (set-time! (-> *bf* tazer-time))
     (smoke-wait 0.5)
     (let ((before (bf-tazer-ready?)))
       (set! (-> *game-info* gun-ammo BF_AMMO_BLUE) 5.0)
       (smoke-wait 0.3)
       (format 0 "SMOKE blue ammo: tazer ready before ~A, after ~A, blue ammo left ~f~%" before (bf-tazer-ready?) (-> *game-info* gun-ammo BF_AMMO_BLUE))
       (smoke-check "blue ammo recharges the tazer at once" (and (not before) (bf-tazer-ready?)))
       )
     ;; a blue pickup stays blue, whatever guns the save has
     (vector-copy! *smoke-ammo-at* (-> *target* control trans))
     (let ((fwd (bf-view-forward (new 'stack-no-clear 'vector))))
       (vector+*! *smoke-ammo-at* *smoke-ammo-at* fwd (meters 12))
       )
     (let ((k (-> *bf* drop-count)))
       (when (< k BF_DROP_MAX)
         (set! (-> *bf* drop-kind k) (the-as int (pickup-type ammo-blue)))
         (vector-copy! (-> *bf* drop-pos k) *smoke-ammo-at*)
         (+! (-> *bf* drop-count) 1)
         )
       )
     (smoke-wait 1.0)
     (let ((blue? #f))
       (dotimes (i (smoke-collect 'ammo-collectable 'ammo-collectable))
         (let ((p (the-as collectable (handle->process (-> *smoke-handles* i)))))
           (if (and p (< (vector-vector-xz-distance (-> p root trans) *smoke-ammo-at*) (meters 4))
                    (= (-> p fact pickup-type) (pickup-type ammo-blue))
                    )
               (set! blue? #t)
               )
           )
         )
       (smoke-shot "blue-pickup")
       (smoke-check "a blue ammo pickup comes down blue" blue?)
       )
     ;; three minutes of battle: where the units come down, the foes in sight, the pickups
     (smoke-step "battle")
     (dotimes (k 20)
       (set! (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
       )
     (dotimes (k 4)
       (set! (-> *smoke-ahead* k) 0)
       )
     (dotimes (k 5)
       (set! (-> *bf-drop-kinds* k) 0)
       )
     (set! (-> *bf-sight-count* 0) 0)
     (let ((t0 (smoke-now))
           (hidden 0)
           (pairs 0)
           (filmed? #f)
           )
       (while (< (- (smoke-now) t0) (seconds 180))
         (smoke-wait 0.5)
         (smoke-ahead-tick)
         (when (zero? (mod (/ (- (smoke-now) t0) 150) 20))
           (let ((r (bf-city-hidden-foes)))
             (+! hidden (/ r 1000))
             (+! pairs (mod r 1000))
             )
           (smoke-kill-units BF_TEAM_FF 'crimson-guard 2 #t)
           (smoke-kill-units BF_TEAM_KG 'crimson-guard 2 #t)
           )
         ;; filmed once: the Freedom League's most advanced point, its units appearing there
         (let ((pt (smoke-ahead-point BF_TEAM_FF)))
           (when (and (not filmed?) (>= pt 0) (< (seconds 60) (- (smoke-now) t0)))
             (set! filmed? #t)
             (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points pt pos))))
               (+! (-> at x) (meters 25))
               (+! (-> at y) (meters 2))
               (move-to-point! (-> *target* control) at)
               (smoke-wait 0.5)
               (smoke-look-at (-> *bf* points pt pos) 0.0)
               (smoke-kill-units BF_TEAM_FF 'crimson-guard 6 #t)
               (smoke-wait 5.0)
               (smoke-rec-start "spawn-point" 3)
               (smoke-wait 6.0)
               (smoke-rec-stop)
               (smoke-shot "spawn-point")
               )
             )
           )
         )
       (format 0 "SMOKE spawns: ~D at control points, ~D at the side's most advanced, ~D at an attacked one, ~D at either~%"
               (-> *smoke-ahead* 0) (-> *smoke-ahead* 1) (-> *smoke-ahead* 2) (-> *smoke-ahead* 3))
       (smoke-check "units appear at the most advanced point or an attacked one (4 in 5)"
                    (and (> (-> *smoke-ahead* 0) 3) (<= (* 4 (-> *smoke-ahead* 0)) (* 5 (-> *smoke-ahead* 3)))))
       (let ((ships 0))
         (dotimes (i (-> *bf* point-count))
           (if (and (not (-> *bf* points i base?)) (handle->process (-> *bf* points i ship)))
               (+! ships 1)
               )
           )
         (format 0 "SMOKE ships over control points: ~D~%" ships)
         (smoke-check "no ship over a control point, seen or not" (zero? ships))
         )
       (format 0 "SMOKE sight: ~D foes a wall hid in 3 min; with a foe now: ~D unit samples, ~D behind a wall~%"
               (-> *bf-sight-count* 0) pairs hidden)
       ;; 1 in 6 to 1 in 5 without the blind look (a unit passing over its first hidden foes only)
       (smoke-check "few units keep a foe behind a wall (1 in 8 at most: units in an attack and the stock's own picks)"
                    (and (> pairs 20) (<= (* 8 hidden) pairs)))
       )
     (let ((all (+ (-> *bf-drop-kinds* 0) (-> *bf-drop-kinds* 1) (-> *bf-drop-kinds* 2) (-> *bf-drop-kinds* 3) (-> *bf-drop-kinds* 4))))
       (format 0 "SMOKE pickups: ~D in all: dark eco ~D, yellow ~D, red ~D" all (-> *bf-drop-kinds* 0) (-> *bf-drop-kinds* 1) (-> *bf-drop-kinds* 2))
       (format 0 ", blue ~D, health ~D~%" (-> *bf-drop-kinds* 3) (-> *bf-drop-kinds* 4))
       )
     ;; the pickups' shares: 100 draws from empty bags (a battle's 30 to 40 pickups are too few)
     (let ((n (new 'static 'array int32 5)))
       (dotimes (k 5)
         (set! (-> n k) 0)
         )
       (dotimes (k 3)
         (set! (-> *bf-drop-bags* kind k) 0)
         (set! (-> *bf-drop-bags* ammo k) 0)
         )
       (dotimes (j 100)
         (let ((k (bf-drop-roll)))
           (+! (-> n k) 1)
           )
         )
       (format 0 "SMOKE pickup kinds in 100 draws: dark eco ~D, yellow ~D, red ~D, blue ~D, health ~D~%"
               (-> n 0) (-> n 1) (-> n 2) (-> n 3) (-> n 4))
       (smoke-check "the pickups: eco 30 %, ammo 40 % (yellow 60, red 30, blue 10 % of it), health 30 %"
                    (and (= (-> n 0) 30) (= (-> n 1) 24) (= (-> n 2) 12) (= (-> n 3) 4) (= (-> n 4) 30)))
       )
     ;; the jetpack: X up, Circle down, R2 boost for 10 s of gauge
     (smoke-change-class 1 "blue jetpack")
     (smoke-step "jetpack")
     (smoke-wait 1.0)
     (let ((y0 (-> *target* control trans y)))
       (smoke-hold (pad-buttons x))
       (smoke-wait 1.0)
       (smoke-hold (the-as pad-buttons 0))
       (let ((y1 (-> *target* control trans y)))
         (smoke-wait 0.5)
         (smoke-hold (pad-buttons circle))
         (smoke-wait 0.6)
         (smoke-hold (the-as pad-buttons 0))
         (let ((y2 (-> *target* control trans y)))
           (format 0 "SMOKE jetpack: ~M up with X in 1 s, ~M down with Circle in 0.6 s~%" (- y1 y0) (- y1 y2))
           (smoke-check "X climbs, Circle comes down" (and (< (meters 3) (- y1 y0)) (< (meters 1.5) (- y1 y2))))
           )
         )
       )
     (smoke-rec-start "jetpack-boost" 2)
     (let ((f0 (-> (smoke-av) fuel))
           (p0 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
           )
       (smoke-hold (pad-buttons r2))
       (smoke-wait 3.0)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-rec-stop)
       (let ((f1 (-> (smoke-av) fuel))
             (d (vector-vector-xz-distance (-> *target* control trans) p0))
             )
         (format 0 "SMOKE jetpack boost: gauge ~f then ~f after 3 s of R2, ~M covered~%" f0 f1 d)
         (smoke-check "R2 boosts, a full gauge lasting 10 s (0.7 left after 3 s)"
                      (and (< (meters 40) d) (< 0.65 f1) (< f1 0.75)))
         )
       )
     (smoke-quit)
     )
    ((28)
     ;; Round 21: R3 hides the game's minimap behind the whole map; the guard's crouch (L1: kneeling,
     ;; put, steadier aim, a smaller crosshair), dodge (L2 + stick: a jump to that side, still facing
     ;; the crosshair) and roll (R2 + stick: head over heels that way)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 2.0)
     ;; L3 (R3 until round 22)
     (smoke-step "r3 minimap")
     (smoke-press (pad-buttons l3) 1.5)
     (smoke-check "L3: the whole map up, the game's minimap off"
                  (and (-> *bf* overlay?) (not (logtest? (-> *setting-control* user-current minimap) (minimap-flag minimap))))
                  )
     (smoke-shot "r3-no-minimap")
     (smoke-press (pad-buttons l3) 1.5)
     (smoke-check "L3 again: the map off, the minimap back"
                  (and (not (-> *bf* overlay?)) (logtest? (-> *setting-control* user-current minimap) (minimap-flag minimap)))
                  )
     ;; standing still, then on the move: the spread
     (smoke-step "spread")
     ;; the avatar read again at each use: its process moves in memory (the dead pool heap's compaction)
     (let ((av 0))
       (smoke-wait 0.5)
       (format 0 "SMOKE spread standing: ~f degrees~%" (/ (-> (smoke-av) spread) 182.04445))
       (smoke-check "standing: the rifle's spread 1.5 degrees" (< (degrees 1.4) (-> (smoke-av) spread) ))
       (smoke-shot "reticle-stand")
       (set! *smoke-ly* 0)
       (smoke-wait 1.0)
       (format 0 "SMOKE spread moving: ~f degrees~%" (/ (-> (smoke-av) spread) 182.04445))
       (smoke-check "on the move: a wider spread" (< (degrees 3.0) (-> (smoke-av) spread)))
       (smoke-shot "reticle-move")
       (set! *smoke-ly* 128)
       (smoke-wait 1.0)
       ;; L1: kneeling, put even with the stick pushed, the steadier aim
       (smoke-step "crouch")
       (smoke-rec-start "crouch" 3)
       (smoke-hold (pad-buttons l1))
       (smoke-wait 1.0)
       (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
         (set! *smoke-ly* 0)
         (smoke-wait 1.5)
         (let ((moved (vector-vector-xz-distance at (-> *target* control trans))))
           (format 0 "SMOKE crouch: crouch? ~A clip ~D spread ~f degrees, moved ~M with the stick pushed~%"
                   (-> (smoke-av) crouch?) (-> (smoke-av) anim) (/ (-> (smoke-av) spread) 182.04445) moved)
           (smoke-check "L1: the guard kneels (its kneeling clip), stays put, aims steadier"
                        (and (-> (smoke-av) crouch?) (= (-> (smoke-av) anim) BF_CLIP_KNEEL) (< moved (meters 0.5)) (< (-> (smoke-av) spread) (degrees 0.5)))
                        )
           )
         )
       (smoke-shot "crouch")
       (smoke-tap (pad-buttons r1) 4)
       (smoke-wait 1.0)
       (set! *smoke-ly* 128)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-wait 1.0)
       (smoke-rec-stop)
       (smoke-check "L1 let go: standing again" (not (-> (smoke-av) crouch?)))
       ;; R2 + stick left: a roll to the left, head over heels
       (smoke-step "roll")
       (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
             (right (bf-view-right (new 'stack-no-clear 'vector)))
             (rolled? #f)
             (clip -1)
             )
         (smoke-rec-start "roll" 2)
         (set! *smoke-lx* 0)
         (smoke-tap (pad-buttons r2) 4)
         (dotimes (f 60)
           (when (< (current-time) (-> (smoke-av) dodge-until))
             (set! rolled? #t)
             (set! clip (-> (smoke-av) anim))
             )
           (suspend)
           )
         (set! *smoke-lx* 128)
         (smoke-wait 0.5)
         (smoke-rec-stop)
         (let* ((d (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) at))
                (side (+ (* (-> d x) (-> right x)) (* (-> d z) (-> right z))))
                )
           (format 0 "SMOKE roll: ~A roll? ~A clip ~D, ~M to the right~%" rolled? (-> (smoke-av) roll?) clip side)
           (smoke-check "R2 + stick left: a roll to the left (head over heels, its tucked clip)"
                        (and rolled? (-> (smoke-av) roll?) (= clip BF_CLIP_ROLL) (< side (meters -3)))
                        )
           )
         )
       (smoke-wait 1.0)
       ;; L2 + stick right: a dodge to the right, still facing the crosshair
       (smoke-step "dodge")
       (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
             (right (bf-view-right (new 'stack-no-clear 'vector)))
             (yaw0 (-> *bf* view-yaw))
             (dodged? #f)
             (clip -1)
             (worst 0.0)
             )
         (smoke-rec-start "dodge" 2)
         (set! *smoke-lx* 255)
         (smoke-tap (pad-buttons l2) 4)
         (dotimes (f 60)
           (when (< (current-time) (-> (smoke-av) dodge-until))
             (set! dodged? #t)
             (set! clip (-> (smoke-av) anim))
             (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> (smoke-av) root quat))))
               (set! worst (fmax worst (fabs (deg- (vector-y-angle fwd) yaw0))))
               )
             )
           (suspend)
           )
         (set! *smoke-lx* 128)
         (smoke-wait 0.5)
         (smoke-rec-stop)
         (let* ((d (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) at))
                (side (+ (* (-> d x) (-> right x)) (* (-> d z) (-> right z))))
                )
           (format 0 "SMOKE dodge: ~A roll? ~A clip ~D, ~M to the right, the model at most ~f degrees off the view~%"
                   dodged? (-> (smoke-av) roll?) clip side (/ worst 182.04445))
           (smoke-check "L2 + stick right: a dodge to the right (its jump-right clip), still facing the crosshair"
                        (and dodged? (not (-> (smoke-av) roll?)) (= clip BF_CLIP_DODGE_RIGHT) (< (meters 3) side) (< worst (degrees 55)))
                        )
           )
         )
       )
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((27)
     ;; Round 20: a battle left alone, 15 minutes at most: at 90 s each side's units have left their
     ;; base; then the first point fought over in its capture radius, with no unit placed by the test,
     ;; watched 30 s (the L3 map filmed)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 90.0)
     (let ((out-ff 0)
           (all-ff 0)
           (out-kg 0)
           (all-kg 0)
           )
       (dotimes (d (-> *bf-unit-dots* count))
         (let* ((team (-> *bf-unit-dots* team d))
                (out? (< (meters 250) (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points team pos))))
                )
           (cond
             ((= team BF_TEAM_FF)
              (+! all-ff 1)
              (if out? (+! out-ff 1))
              )
             (else
               (+! all-kg 1)
               (if out? (+! out-kg 1))
               )
             )
           )
         )
       (smoke-dots-line "90 s")
       (smoke-points-line "90 s")
       (format 0 "SMOKE left their base at 90 s: Freedom League ~D of ~D, Krimzon Guard ~D of ~D (over 250 m from it)~%"
               out-ff all-ff out-kg all-kg)
       (smoke-check "at 90 s more than half of each side's units have left their base (over 250 m)"
                    (and (< (* 2 out-ff) (* 2 all-ff)) (< all-ff (* 2 out-ff)) (< all-kg (* 2 out-kg)))
                    )
       )
     (let ((pt -1)
           (t0 (smoke-now))
           )
       (while (and (< pt 0) (< (- (smoke-now) t0) (seconds 810)))
         (smoke-wait 0.5)
         (when (zero? (mod (/ (- (smoke-now) t0) 150) 120))
           (smoke-team-line "waiting")
           (smoke-dots-line "waiting")
           )
         (dotimes (i (-> *bf* point-count))
           (let ((p (-> *bf* points i)))
             (if (and (< pt 0) (not (-> p base?)) (> (-> p near 0) 0) (> (-> p near 1) 0))
                 (set! pt i)
                 )
             )
           )
         )
       (format 0 "SMOKE natural contest: point ~D (~S) after ~D s more~%" pt (if (>= pt 0) (bf-point-name pt) "none")
               (/ (- (smoke-now) t0) 300))
       (smoke-check "left alone, the armies fight over a point in its capture radius" (>= pt 0))
       (when (>= pt 0)
         (let ((p (-> *bf* points pt)))
           (set! (-> *bf* overlay?) #t)
           (smoke-rec-start "natural-contest" 6)
           (dotimes (k 30)
             (if (zero? (mod k 3))
                 (begin
                   (format 0 "SMOKE natural contest ~D s: in its radius ~D/~D, owner ~D," k (-> p near 0) (-> p near 1) (-> p owner))
                   (format 0 " capture ~D ~f~%" (-> p prog-team) (-> p progress))
                   )
                 )
             (if (= k 6)
                 (smoke-rec-stop)
                 )
             (smoke-wait 1.0)
             )
           (set! (-> *bf* overlay?) #f)
           )
         )
       )
     (smoke-points-line "end")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((26)
     ;; Round 20: a contested point. The battle runs, the player at his base, until units of both sides
     ;; stand in a control point's capture radius (10 min at most); then for 40 s: each side's units in
     ;; its radius and within 250 m, its holder and capture; the L3 map filmed. The units near a
     ;; contested point go to it first (battlefront-city.gc `bf-city-contested-point`) and the side
     ;; with more units in the radius takes it or keeps it.
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     ;; the battle runs 200 s; then a squad of 6 Krimzon Guard guards is put by the test on a control
     ;; point the Freedom League holds (the armies, at each other's points, stall for minutes)
     (smoke-wait 200.0)
     (smoke-team-line "before")
     (smoke-points-line "before")
     (let ((own -1))
       (dotimes (i (-> *bf* point-count))
         (if (and (< own 0) (not (-> *bf* points i base?)) (= (-> *bf* points i owner) BF_TEAM_FF))
             (set! own i)
             )
         )
       (when (>= own 0)
         (format 0 "SMOKE contest: ~D Krimzon Guard guards put on ~S, held by the Freedom League~%"
                 (bf-city-send BF_TEAM_KG own 6) (bf-point-name own))
         )
       (set! *smoke-sent* own)
       )
     (smoke-wait 0.5)
     (let ((pt *smoke-sent*)
           (t0 (smoke-now))
           )
       (while (and (< pt 0) (< (- (smoke-now) t0) (seconds 600)))
         (smoke-wait 0.5)
         (when (zero? (mod (/ (- (smoke-now) t0) 150) 120))
           (smoke-team-line "waiting")
           (smoke-dots-line "waiting")
           )
         (dotimes (i (-> *bf* point-count))
           (let ((p (-> *bf* points i)))
             (if (and (< pt 0) (not (-> p base?)) (> (-> p near 0) 0) (> (-> p near 1) 0))
                 (set! pt i)
                 )
             )
           )
         )
       (format 0 "SMOKE contest: point ~D (~S) after ~D s~%" pt (if (>= pt 0) (bf-point-name pt) "none")
               (/ (- (smoke-now) t0) 300))
       (smoke-check "units of both sides meet in a control point's capture radius" (>= pt 0))
       (when (>= pt 0)
         (let ((p (-> *bf* points pt))
               (holder0 (-> *bf* points pt owner))
               (first-in 0)
               (most-in 0)
               (first-near 0)
               (most-near 0)
               (last-owner -2)
               (ff-in0 (-> *bf* points pt near 0))
               (kg-in0 (-> *bf* points pt near 1))
               )
           (set! (-> *bf* overlay?) #t)
           (smoke-rec-start "contest-map" 6)
           (dotimes (k 40)
             (let ((ff 0)
                   (kg 0)
                   (ff-zone 0)
                   )
               (dotimes (d (-> *bf-unit-dots* count))
                 (let ((dist (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> p pos))))
                   (when (< dist (meters 250))
                     (if (= (-> *bf-unit-dots* team d) BF_TEAM_FF)
                         (+! ff 1)
                         (+! kg 1)
                         )
                     )
                   (if (and (< dist (meters 60)) (= (-> *bf-unit-dots* team d) BF_TEAM_FF))
                       (+! ff-zone 1)
                       )
                   )
                 )
               (if (zero? k)
                   (set! *smoke-zone0* ff-zone)
                   )
               (set! *smoke-zone-max* (max *smoke-zone-max* ff-zone))
               (if (zero? k)
                   (begin
                     (set! first-in (+ (-> p near 0) (-> p near 1)))
                     (set! first-near (+ ff kg))
                     )
                   )
               (set! most-in (max most-in (+ (-> p near 0) (-> p near 1))))
               (set! most-near (max most-near (+ ff kg)))
               (if (zero? (mod k 4))
                   (begin
                     (format 0 "SMOKE contest ~D s: in its radius ~D/~D, within 250 m ~D/~D," k (-> p near 0) (-> p near 1) ff kg)
                     (format 0 " owner ~D, capture ~D ~f~%" (-> p owner) (-> p prog-team) (-> p progress))
                     )
                   )
               (if (= k 6)
                   (smoke-rec-stop)
                   )
               (set! last-owner (-> p owner))
               )
             (smoke-wait 1.0)
             )
           (set! (-> *bf* overlay?) #f)
           (format 0 "SMOKE contest end: held by ~D at the start, ~D after 40 s;" holder0 last-owner)
           (format 0 " in its radius ~D at first, ~D at most; within 250 m ~D at first, ~D at most~%"
                   first-in most-in first-near most-near)
           (format 0 "SMOKE contest: Freedom League in its radius ~D at first, ~D at the end; Krimzon Guard ~D at first, ~D at the end~%"
                   ff-in0 (-> p near 0) kg-in0 (-> p near 1))
           (format 0 "SMOKE contest: Freedom League units within 60 m of the point ~D at first, ~D at most~%"
                   *smoke-zone0* *smoke-zone-max*)
           (smoke-check "the contested point draws its side's units into its zone (60 m)" (< *smoke-zone0* *smoke-zone-max*))
           (smoke-check "they clear it: no Krimzon Guard unit left in its radius, the point still the Freedom League's"
                        (and (zero? (-> p near 1)) (= (-> p owner) BF_TEAM_FF))
                        )
           (smoke-check "the point stays with or goes to a side, not neutral for good"
                        (or (>= last-owner 0) (!= (-> p prog-team) BF_TEAM_NONE))
                        )
           )
         )
       )
     (smoke-points-line "end")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((25)
     ;; the nav meshes of the whole city and their links
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-wait 12.0)
     (bf-ways-dump)
     ;; the south (ctyslumb 1, ctyslumc 2) against the north (ctysluma 0, ctyindb 4, the Port 5 to 8)
     (bf-ways-gap 1 0)
     (bf-ways-gap 2 0)
     (bf-ways-gap 1 4)
     (bf-ways-gap 1 5)
     (bf-ways-gap 1 7)
     (smoke-quit)
     )
    ((24)
     ;; Round 20 frame rate: 20 units a side, then 40 (in a first run 40 froze the game at 4 frames a
     ;; second: the city's attack controller held 64 attackers; the city code's parts, switched off
     ;; in turn, cost nothing measurable)
     (smoke-mods-toggle "mods-menu-on")
     (let ((caps (new 'static 'array int32 8 14 6 0 0 8 4 4 4)))
       (dotimes (i 8)
         (set! (-> caps i) (-> *bf-team-caps* i))
         )
       (set! (-> *bf-team-caps* 0) 14)
       (set! (-> *bf-team-caps* 1) 6)
       (set! (-> *bf-team-caps* 4) 8)
       (set! (-> *bf-team-caps* 5) 4)
       (set! (-> *bf-team-caps* 6) 2)
       (set! (-> *bf-team-caps* 7) 2)
       (smoke-battle-start 0 BF_TEAM_FF)
       (smoke-deploy 0 "deploy blue guard")
       (smoke-invulnerable #t)
       (smoke-wait-wall 60)
       (smoke-team-line "caps 20")
       (smoke-fps "caps 20")
       (dotimes (i 8)
         (set! (-> *bf-team-caps* i) (-> caps i))
         )
       )
     (smoke-wait-wall 90)
     (smoke-team-line "caps 40")
     (smoke-fps "caps 40")
     (smoke-check "40 units a side at 50 frames a second or more"
                  (let ((c (new 'stack-no-clear 'array 'int32 4)))
                    (and (<= 36 (bf-transport-team-count BF_TEAM_FF c)) (<= 36 (bf-transport-team-count BF_TEAM_KG c)))
                    )
                  )
     (smoke-check "the frame rate holds with 40 a side" (<= 500 (smoke-fps "caps 40 again")))
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((22)
     ;; Round 19, every street section of Haven City loaded at once: the slots and the level heap's
     ;; chunks, every point live, both armies from their own bases across the city, the map; then
     ;; the stock levels back after the battle
     (smoke-mods-toggle "mods-menu-on")
     (smoke-levels-line "before")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-step "whole city")
     (smoke-levels-line "battle")
     (let ((live 0))
       (dotimes (i (-> *bf* point-count))
         (if (bf-point-live? (-> *bf* points i))
             (+! live 1)
             )
         )
       (format 0 "SMOKE ~D of ~D points live~%" live (-> *bf* point-count))
       (smoke-check "every street section is loaded during the battle" (bf-whole-city-loaded?))
       (smoke-check "every battle point lies in a loaded section" (= live (-> *bf* point-count)))
       )
     (let ((c (new 'stack-no-clear 'array 'int32 4))
           (most-ff 0)
           (most-kg 0)
           (most-points 0)
           )
       (dotimes (k 18)
         (smoke-wait 10.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         ;; the points with units of either side within 250 m, at once
         (let ((manned 0))
           (dotimes (i (-> *bf* point-count))
             (let ((near? #f))
               (dotimes (d (-> *bf-unit-dots* count))
                 (if (< (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points i pos)) (meters 250))
                     (set! near? #t)
                     )
                 )
               (if near?
                   (+! manned 1)
                   )
               )
             )
           (set! most-points (max most-points manned))
           )
         (smoke-team-line "whole city")
         (smoke-dots-line "whole city")
         (smoke-points-line "whole city")
         )
       (format 0 "SMOKE whole city: at most Freedom League ~D, Krimzon Guard ~D awake, units at ~D points at once~%"
               most-ff most-kg most-points)
       (smoke-check "both armies field about 20 across the city (15 or more awake each)" (and (<= 15 most-ff) (<= 15 most-kg)))
       (smoke-check "units stand at 3 points or more at once, across the city" (<= 3 most-points))
       )
     (smoke-shot "whole-city")
     ;; the Port's point, the Krimzon Guard's, 1.9 km from the Freedom League's base: no load, its
     ;; units already there
     (smoke-step "far point")
     (smoke-film-point 2)
     (smoke-rec-start "whole-city-port" 4)
     (smoke-wait 6.0)
     (smoke-rec-stop)
     (smoke-shot "whole-city-port")
     (smoke-levels-line "far point")
     (smoke-dots-line "far point")
     (smoke-check "the far point needed no load: every street section still in"
                  (and (= (-> *bf* city-load) BF_LOAD_WHOLE) (bf-whole-city-loaded?))
                  )
     (smoke-step "map")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-wait 1.0)
     (smoke-shot "whole-city-map")
     (smoke-rec-start "whole-city-map" 6)
     (smoke-wait 5.0)
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-pick-point 0)
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-levels-line "after a respawn")
     (smoke-check "the sections stay loaded after a respawn" (bf-whole-city-loaded?))
     (smoke-quit)
     (smoke-wait-for 60.0 (lambda () (= (-> *bf* city-load) BF_LOAD_OFF)))
     (smoke-wait 10.0)
     (smoke-levels-line "after the battle")
     (smoke-check "after the battle the game's own levels are back, Jak standing"
                  (and (= (-> *bf* city-load) BF_LOAD_OFF)
                       (= (level-status? *level* 'ctywide #f) 'active)
                       *target*
                       (logtest? (-> *target* control status) (collide-status on-surface))
                       )
                  )
     )
    ((21)
     ;; Round 19, Freedom League at its base by the headquarters: the Krimzon Guard, which holds no
     ;; point here, brings its units in from the edge of the loaded area (Star Wars Battlefront's
     ;; armies come from every command post); both armies about 20 strong meet at Freedom HQ's point;
     ;; the force fields at the ruins and at the Metal Head nest, seen and run into; the doors shut
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-step "armies")
     (let ((c (new 'stack-no-clear 'array 'int32 4))
           (most-ff 0)
           (most-kg 0)
           (met 0)
           )
       (dotimes (k 6)
         (smoke-wait 5.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         (smoke-team-line "armies")
         )
       ;; Jak where he sees Freedom HQ's point, filmed every half second while the armies meet there
       (let ((at (new 'stack-no-clear 'vector))
             (aim (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 5 pos)))
             )
         (+! (-> aim y) (meters 1.5))
         (when (smoke-viewpoint 5 aim at)
           (+! (-> at y) (meters 2))
           (move-to-point! (-> *target* control) at)
           )
         (smoke-wait 1.5)
         (smoke-face aim)
         )
       (smoke-rec-start "armies" 30)
       (dotimes (k 18)
         (smoke-wait 5.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         (let ((ff (smoke-count-near BF_TEAM_FF (-> *bf* points 5 pos) (meters 60)))
               (kg (smoke-count-near BF_TEAM_KG (-> *bf* points 5 pos) (meters 60)))
               )
           (if (and (< 0 ff) (< 0 kg))
               (+! met 1)
               )
           (format 0 "SMOKE ~D s at Freedom HQ's point: Freedom League ~D, Krimzon Guard ~D within 60 m, owner ~D~%"
                   (* (+ k 1) 5) ff kg (-> *bf* points 5 owner))
           )
         (smoke-team-line "armies")
         )
       (smoke-rec-stop)
       (smoke-wait 1.0)
       (smoke-shot "armies")
       (format 0 "SMOKE armies: at most Freedom League ~D, Krimzon Guard ~D awake; both at Freedom HQ's point in ~D of 18 counts~%"
               most-ff most-kg met)
       (smoke-check "the Krimzon Guard, with no point here, comes in from the edge (15 or more awake)" (<= 15 most-kg))
       (smoke-check "the Freedom League fields about 20 here too (15 or more awake)" (<= 15 most-ff))
       (smoke-check "both armies meet at a point (both within 60 m of it in 3 counts or more)" (<= 3 met))
       )
     ;; the respawn page's map: both armies, live
     (smoke-step "both armies on the map")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-wait 1.0)
     (let ((n-ff 0)
           (n-kg 0)
           )
       (dotimes (i (-> *bf-unit-dots* count))
         (if (= (-> *bf-unit-dots* team i) BF_TEAM_FF)
             (+! n-ff 1)
             (+! n-kg 1)
             )
         )
       (format 0 "SMOKE respawn map: ~D Freedom League and ~D Krimzon Guard dots~%" n-ff n-kg)
       (smoke-check "the respawn page shows both armies" (and (< 0 n-ff) (< 0 n-kg)))
       )
     (smoke-shot "armies-map")
     (smoke-wait 1.0)
     (smoke-rec-start "armies-map" 6)
     (smoke-wait 5.0)
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-pick-point 0)
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-invulnerable #t)
     ;; the doors by the headquarters
     (smoke-step "doors by the headquarters")
     (dotimes (k 3)
       (let ((name (-> (new 'static 'boxed-array :type string "cty-door-1" "cty-door-3" "cty-door-2") k)))
         (let ((ok (smoke-door-check name)))
           (smoke-check "a door to an interior stays shut with Jak in front of it" (and ok (!= ok 'none)))
           (if (= k 0)
               (smoke-shot "door-fhq")
               )
           )
         )
       )
     ;; the ruins' force field, by Freedom HQ's district
     (smoke-step "ruins force field")
     (let ((past (smoke-field-walk 412.0 30.0 -45.0 367.0 -45.0 "field-ruins")))
       (smoke-check "the ruins' force field stands, and Jak running at it stays out" (< past 1.0))
       )
     ;; the Port: a respawn there, the nest's force field, the Port's doors
     (smoke-step "to the Port")
     (set! (-> *bf* points 2 owner) BF_TEAM_FF)
     (smoke-wait 1.0)
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-pick-point 2)
     (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-wait 2.0)
     (smoke-invulnerable #t)
     (smoke-step "nest force field")
     (let ((past (smoke-field-walk -372.0 30.0 1238.0 -372.0 1186.0 "field-nest")))
       (smoke-check "the Metal Head nest's force field stands, and Jak running at it stays out" (< past 1.0))
       )
     (smoke-step "doors at the Port")
     (dotimes (k 3)
       (let ((name (-> (new 'static 'boxed-array :type string "hip-door-a-10" "hip-door-a-6" "com-airlock-outer-59") k)))
         (let ((ok (smoke-door-check name)))
           (smoke-check "a door to an interior stays shut with Jak in front of it" (and ok (!= ok 'none)))
           (if (= k 0)
               (smoke-shot "door-port")
               )
           )
         )
       )
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((20)
     ;; Round 18, Krimzon Guard: the same at the Port's point, the Freedom League defending it
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_KG)
     (smoke-deploy 0 "deploy red guard")
     (smoke-invulnerable #t)
     (smoke-conquer-defend BF_TEAM_KG 2 "kg-base-leave" "kg-conquest" "ff-defense")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((19)
     ;; Round 18, Freedom League: every district's point on open ground, its holder's ship right over
     ;; it, swapped when it changes hands: redeploys to the Slums, the Industrial Zone and the Port in
     ;; turn (each given to the player's side for the test), and the Krimzon Guard's base at the Port
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 10.0)
     (smoke-tour-point 4 "slums" "slums-swapped")
     (smoke-tour-point 3 "industrial" "industrial-swapped")
     (smoke-tour-point 2 "port" "port-swapped")
     (smoke-step "Krimzon Guard base")
     (smoke-wait-for 30.0 (lambda () (and (-> *bf* points 1 snapped?) (<= 0.0 (smoke-ship-over 1)))))
     (smoke-check "the Krimzon Guard's base on open ground, its ship right over it" (smoke-point-open 1))
     (smoke-film-point 1)
     (smoke-shot "kg-base")
     (smoke-points-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((17)
     ;; Round 18, Freedom League: the war zone page (Spargus grey and refused, Haven City's whole map),
     ;; the spawn shield, a ship stationed over each held point and swapped at a capture, every class
     ;; aiming, the respawn page's live units
     (smoke-mods-toggle "mods-menu-on")
     (smoke-step "war zone page")
     (smoke-bf-pause 1)
     (smoke-wait 1.0)
     (set! (-> (smoke-dir) cursor) 1)
     (smoke-wait 0.6)
     (smoke-shot "zone-spargus")
     (smoke-press (pad-buttons x) 1.0)
     (smoke-check "Spargus is listed and refused (the war zone page stays)"
                  (and (= (-> (smoke-dir) page) BF_PAGE_ZONE) (= (bf-page-count BF_PAGE_ZONE) 2)))
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 0.6)
     (smoke-shot "zone-haven-city")
     ;; a clip of the page: Haven City, Spargus (grey, X refused), Haven City again
     (smoke-wait 1.0)
     (smoke-rec-start "zone-page" 4)
     (smoke-wait 1.0)
     (set! (-> (smoke-dir) cursor) 1)
     (smoke-wait 1.5)
     (smoke-press (pad-buttons x) 1.0)
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 1.5)
     (smoke-rec-stop)
     (smoke-press (pad-buttons circle) 1.0)
     (smoke-wait 1.0)
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-wait 1.0)
     (smoke-rec-start "spawn-shield" 2)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-check "the spawn shield: 3 s invulnerable, the class model blinking, then steady" (smoke-shield-check))
     (smoke-rec-stop)
     (smoke-invulnerable #t)
     ;; the ship stationed over the base, right over it, and staying
     (smoke-wait 12.0)
     (format 0 "SMOKE base ship ~M m off its point~%" (smoke-ship-over 0))
     (smoke-check "a ship hovers right over the base (within 1 m)" (and (<= 0.0 (smoke-ship-over 0)) (< (smoke-ship-over 0) 1.0)))
     (smoke-wait 20.0)
     (smoke-team-line "32 s")
     (smoke-check "the base's ship stays over it" (<= 0.0 (smoke-ship-over 0)))
     (smoke-check "the ship comes down where nothing stands above it" (smoke-ships-sky))
     ;; Freedom HQ's point taken: its side's ship comes and stays over it
     (smoke-step "capture Freedom HQ")
     (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 5 pos))))
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       )
     (smoke-wait-for 45.0 (lambda () (= (-> *bf* points 5 owner) BF_TEAM_FF)))
     (smoke-check "Jak's side captures the Freedom HQ point" (= (-> *bf* points 5 owner) BF_TEAM_FF))
     (smoke-wait-for 20.0 (lambda () (<= 0.0 (smoke-ship-over 5))))
     (smoke-wait 6.0)
     (format 0 "SMOKE Freedom HQ ship ~M m off its point, ~A~%" (smoke-ship-over 5)
             (let ((sh (handle->process (-> *bf* points 5 ship)))) (if sh (-> sh type symbol) (quote none))))
     (smoke-check "a ship of its side hovers right over the captured point" (and (<= 0.0 (smoke-ship-over 5)) (< (smoke-ship-over 5) 1.0)))
     (smoke-film-point 5)
     (smoke-shot "point-ship")
     ;; the point taken by the other side: the ship leaves, the other side's comes in its place
     (smoke-step "point taken by the Krimzon Guard")
     (smoke-wait 1.0)
     (smoke-rec-start "ship-swap" 6)
     (let ((before (-> *bf* points 5 ship)))
       (set! (-> *bf* points 5 owner) BF_TEAM_KG)
       (smoke-wait 2.0)
       (let ((old (handle->process before)))
         (format 0 "SMOKE the old ship: ~A~%" (if old (-> old next-state name) 'gone))
         ;; it climbs away a few seconds before it goes
         (smoke-check "the losing side's ship leaves the point"
                      (and (!= (-> *bf* points 5 ship) before)
                           (or (not old) (= (-> old next-state name) 'leave) (= (-> old next-state name) 'die-fast))
                           )
                      )
         )
       )
     (smoke-wait-for 30.0 (lambda () (<= 0.0 (smoke-ship-over 5))))
     (smoke-wait 6.0)
     (format 0 "SMOKE new ship over Freedom HQ ~M m off, ~A~%" (smoke-ship-over 5)
             (let ((sh (handle->process (-> *bf* points 5 ship)))) (if sh (-> (the-as process-drawable sh) type symbol) 'none)))
     (smoke-check "the new holder's ship takes its place" (<= 0.0 (smoke-ship-over 5)))
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-film-point 5)
     (smoke-shot "point-ship-swapped")
     ;; every class aims: the jetpack's upper body toward a shot 30 degrees up
     (smoke-step "guard aim")
     (move-to-point! (-> *target* control) (-> *bf* points 0 pos))
     (smoke-wait 2.0)
     (set! (-> *bf* view-pitch) (degrees 30))
     (smoke-wait 0.5)
     (smoke-rec-start "aim-guard" 2)
     (smoke-hold (pad-buttons r1))
     (smoke-wait 2.0)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (set! (-> *bf* view-pitch) 0.0)
     (smoke-step "jetpack aim")
     (smoke-change-class 1 "blue jetpack")
     (smoke-wait 4.0)
     (set! (-> *bf* view-pitch) (degrees 30))
     (smoke-rec-start "aim-jetpack" 2)
     (smoke-hold (pad-buttons r1))
     (smoke-wait 1.0)
     (let ((av (smoke-av)))
       (when (and av (-> av aim-jm))
         (format 0 "SMOKE jetpack torso quat w ~f~%" (-> av aim-jm quat w))
         )
       (smoke-check "the jetpack turns its upper body toward the aim while firing up"
                    (and av (-> av aim-jm) (< (-> av aim-jm quat w) 0.995)))
       )
     (smoke-wait 1.0)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (set! (-> *bf* view-pitch) 0.0)
     ;; a death: the respawn page, the units on the city's map, live
     (smoke-step "respawn page")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-wait 1.0)
     (format 0 "SMOKE respawn page: ~D units on the map~%" (-> *bf-unit-dots* count))
     (smoke-check "the respawn page shows the units awake on the map" (< 0 (-> *bf-unit-dots* count)))
     (smoke-shot "respawn-live-units")
     (smoke-wait 1.0)
     (smoke-rec-start "respawn-map" 6)
     (smoke-wait 6.0)
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-pick-point 0)
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-check "the spawn shield again after the respawn" (smoke-shield-check))
     (smoke-quit)
     )
    ((16)
     ;; Round 17, the whole of Haven City, Freedom League: six points; the base at the HQ's entrance;
     ;; the transports; a capture and its defenders; the respawn page at a death, on the city's map;
     ;; the redeploy, refused in combat, then to the Slums, out of any force field; the fight away
     ;; from the player
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (format 0 "SMOKE zone ~S, ~D points~%" (bf-zone-name 0) (-> *bf* point-count))
     (smoke-check "six battle points, a control point in each district, neutral"
                  (and (= (-> *bf* point-count) 6)
                       (= (-> *bf* points 2 owner) BF_TEAM_NONE) (= (-> *bf* points 5 owner) BF_TEAM_NONE)
                       )
                  )
     (smoke-points-line "start")
     (let ((cont (get-continue-by-name *game-info* "ctyslumc-freehq-exit")))
       (smoke-check "the Freedom League's base is the headquarters' entrance (ctyslumc-freehq-exit)"
                    (and cont (< (vector-vector-distance (-> cont trans) (-> *bf* points 0 pos)) (meters 3))
                         (< (vector-vector-distance (-> cont trans) (-> *target* control trans)) (meters 5))
                         )
                    )
       )
     (smoke-step "transports")
     (smoke-wait 10.0)
     (smoke-team-line "10 s")
     (smoke-check "each troop transport comes down where nothing stands above it" (smoke-ships-sky))
     (smoke-check "a transport over a point" (smoke-look-at-ship))
     ;; Freedom HQ's control point: Jak takes it; his side, six guards short (sent back to their
     ;; pool here), sends a transport there, and every other unit it drops guards the point
     (smoke-step "capture Freedom HQ")
     (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 5 pos))))
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       )
     (smoke-wait-for 45.0 (lambda () (= (-> *bf* points 5 owner) BF_TEAM_FF)))
     (smoke-points-line "Freedom HQ")
     (smoke-check "Jak's side captures the Freedom HQ point" (= (-> *bf* points 5 owner) BF_TEAM_FF))
     ;; six of his side's guards back to their pool (at his base, where they are), then Jak 40 m off
     ;; the point toward his base (out of its 15 m) at once: the side's next ship comes to the held
     ;; point nearest him, and every other unit it drops guards it
     (move-to-point! (-> *target* control) (-> *bf* points 0 pos))
     (dotimes (k 6)
       (let ((u (smoke-near-unit BF_TEAM_FF (the-as process #f) 'crimson-guard)))
         (if u
             (bf-transport-sleep u)
             )
         )
       )
     (smoke-team-line "six guards sent back")
     (let ((at (vector-! (new 'stack-no-clear 'vector) (-> *bf* points 0 pos) (-> *bf* points 5 pos))))
       (set! (-> at y) 0.0)
       (vector-normalize! at (meters 40))
       (vector+! at at (-> *bf* points 5 pos))
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       )
     (let ((most 0)
           (most30 0)
           )
       (dotimes (k 12)
         (smoke-wait 5.0)
         (let ((n30 (smoke-count-near BF_TEAM_FF (-> *bf* points 5 pos) (meters 30))))
           (set! most (max most (-> *bf* points 5 near BF_TEAM_FF)))
           (set! most30 (max most30 n30))
           (format 0 "SMOKE Freedom HQ point, Jak 40 m off: ~D Freedom League units within 15 m, ~D within 30 m, ship ~A~%"
                   (-> *bf* points 5 near BF_TEAM_FF) n30 (if (handle->process (-> *bf* points 5 ship)) #t #f))
           )
         )
       (format 0 "SMOKE defenders: at most ~D within 15 m, ~D within 30 m~%" most most30)
       (smoke-check "units of the side patrol the point it holds (defenders: 2 or more within 30 m)" (<= 2 most30))
       )
     ;; a death: the respawn page on the whole city's map, at every death
     (smoke-step "respawn page")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-check "the respawn page opens at a death" (>= (-> *bf* respawn-pick) 0))
     (smoke-wait 1.0)
     (smoke-shot "respawn-city-map")
     (smoke-team-line "before the respawn")
     (smoke-pick-point 5)
     (dotimes (k 6)
       (smoke-wait 1.0)
       (smoke-team-line "after the respawn")
       )
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-wait 1.0)
     (format 0 "SMOKE respawned ~M from the Freedom HQ point~%" (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 5 pos)))
     (smoke-check "respawned at the point picked" (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 5 pos)) (meters 3)))
     (smoke-invulnerable #t)
     ;; the redeploy: refused right after a shot, open 30 s out of combat
     (smoke-step "redeploy")
     (smoke-hold (pad-buttons r1))
     (smoke-wait 0.6)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-check "a shot makes the redeploy cost a unit (open, not free)" (and (bf-can-redeploy?) (not (bf-out-of-combat?))))
     ;; the class model's shot lasts past the trigger (its shoot-until): out of it before the clock is set back
     (smoke-wait 3.0)
     (set! (-> *bf* combat-time) (- (-> *display* game-clock frame-counter) (seconds 31)))
     (smoke-check "30 s out of combat, the redeploy is free" (and (bf-can-redeploy?) (bf-out-of-combat?)))
     ;; the Slums' point given to the player's side for the test: a district out of any force field
     (set! (-> *bf* points 4 owner) BF_TEAM_FF)
     (smoke-wait 0.5)
     (format 0 "SMOKE redeploy flag ~A, test ~A, calm ~D s, avatar ~A, fighting ~A, Jak dead ~A~%" (-> *bf* redeploy-ok?)
             (bf-can-redeploy?) (/ (- (-> *display* game-clock frame-counter) (-> *bf* combat-time)) 300)
             (bf-avatar-alive?) (bf-fighting?) (focus-test? *target* dead))
     (let ((lost (-> *bf* deaths)))
       (smoke-start-page 'main)
       (smoke-wait-for 5.0 (lambda () (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE))))
       (set! (-> (smoke-dir) cursor) 3)
       (smoke-wait 0.5)
       (smoke-shot "redeploy-entry")
       (smoke-press (pad-buttons x) 2.0)
       (smoke-respawn-page 10.0)
       (smoke-check "Redeploy opens the respawn page" (>= (-> *bf* respawn-pick) 0))
       (smoke-team-line "before the redeploy")
       (smoke-pick-point 4)
       (dotimes (k 20)
         (smoke-wait 0.5)
         (smoke-team-line "after the redeploy")
         )
       (smoke-wait-for 50.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
       (smoke-wait 5.0)
       (format 0 "SMOKE redeployed: ~M from the Slums point, deaths ~D (were ~D), level ~A~%"
               (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 4 pos))
               (-> *bf* deaths) lost (-> *load-state* vis-nick))
       (smoke-check "redeployed in the Slums, standing, with no death counted"
                    (and (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 4 pos)) (meters 10))
                         (= (-> *bf* deaths) lost)
                         (logtest? (-> *target* control status) (collide-status on-surface))
                         )
                    )
       (smoke-shot "slums")
       )
     ;; a second far respawn: a death in the Slums, back at the base by the headquarters
     (smoke-step "second far respawn")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-respawn-page 12.0)
     (smoke-pick-point 0)
     (smoke-wait-for 50.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-wait 2.0)
     (smoke-team-line "after the second far respawn")
     (format 0 "SMOKE back ~M from the base~%" (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 0 pos)))
     (smoke-check "a second far respawn: back at the base"
                  (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 0 pos)) (meters 5)))
     (smoke-invulnerable #t)
     ;; away from the player: the Krimzon Guard, next to the Port and the Industrial Zone from its
     ;; base, fights for them where no unit is
     (smoke-step "away")
     (dotimes (k 6)
       (smoke-wait 10.0)
       (smoke-points-line "away")
       )
     (smoke-team-line "end")
     (smoke-check "the fight goes on away from the player (a district's point taken)"
                  (or (!= (-> *bf* points 2 owner) BF_TEAM_NONE) (!= (-> *bf* points 3 owner) BF_TEAM_NONE))
                  )
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((9)
     ;; T8 to T12, Krimzon Guard in the Industrial Zone: class help; the spider's health, leap and
     ;; sprint; the robotguard's health, shield and ball; the close attacks' delays; the red guard's
     ;; tazer; no tazer among the battle's guards; who aims at whom
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_KG)
     (smoke-help-shots 4)
     ;; the spider first, at the spawn: its leap needs open sky (under the Industrial Zone's pipes it
     ;; stopped at 6.8 m)
     (smoke-deploy 3 "deploy spider")
     (smoke-hp-check BF_CLASS_SPYDROID)
     (smoke-invulnerable #t)
     (smoke-spider-r14)
     (smoke-melee-delay (pad-buttons circle) 1.0)
     (smoke-change-class 2 "robotguard")
     (smoke-hp-check BF_CLASS_ROBOGUARD)
     (smoke-robot-r14)
     (smoke-invulnerable #t)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-change-class 0 "red guard")
     (smoke-hp-check BF_CLASS_RED_GUARD)
     (smoke-weapon-shots)
     (smoke-tazer)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-go-near BF_TEAM_FF)
     (smoke-bot-weapons #f)
     (smoke-go-near BF_TEAM_KG)
     (smoke-bot-weapons #t)
     (smoke-hatred-check)
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    )
  (format 0 "SMOKE DONE~%")
  0
  )

(defun smoke-start ()
  "Spawn the scenario's process in *pc-pool*, which outlives the resets of a deployment, and let it
   run under the menus."
  (process-spawn-function
    process
    (lambda :behavior process ()
      ;; the main thread keeps 256 bytes of stack across a suspend unless told more: the scenario's
      ;; stack vectors outgrew it ("suspend called without enough stack", then the game stopped)
      (stack-size-set! (-> self main-thread) 4096)
      (process-mask-clear! (-> self mask) menu pause progress freeze)
      (smoke-scenario)
      (sleep-code)
      )
    :name "smoke-test"
    :from *default-dead-pool*
    :to *pc-pool*
    :stack-size #x8000
    )
  0
  )
