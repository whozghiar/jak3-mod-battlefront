  (smoke-trl-pov BF_CLASS_ROBOGUARD "pov-robotguard-2")
  (smoke-trl-v2-place 9 (meters 16))
  (smoke-trl-wplayer BF_CLASS_ROBOGUARD "wide-player-robotguard-1")
  (smoke-trl-v2-place 9 (meters 20))
  (smoke-trl-pov BF_CLASS_ROBOGUARD "pov-robotguard-3")
  (smoke-trl-v2-place 9 (meters 16))
  (smoke-trl-wplayer BF_CLASS_ROBOGUARD "wide-player-robotguard-2")
  (smoke-trl-park-at 3)
  (smoke-trl-v2-wides 11 "north-farms" 60.0)
  (smoke-goal-force! -1)
  0
  )

(defbehavior smoke-s95 process ()
  "Scenario 95 (`smoke-scenario-late`), trailer v2: the red jetpack and the spider in the dense fight
   every unit is sent to (the East Market): three point-of-view takes each (HUD on, shots only at
   enemies; the spider's last ends in its blast) and two cinematic takes of the class in the battle,
