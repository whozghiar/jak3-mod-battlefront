(defbehavior smoke-play process ((class int) (tag string))
  "Play CLASS for some twenty seconds with its own moves."
  (case class
    ((BF_CLASS_BLUE_GUARD BF_CLASS_RED_GUARD) (smoke-guard tag))
    ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) (smoke-jetpack tag))
    ((BF_CLASS_ROBOGUARD) (smoke-robot tag))
    ((BF_CLASS_SPYDROID) (smoke-spider tag))
    )
  (smoke-neutral)
  (smoke-check "still in the battle after the class's moves" (and *target* (bf-fighting?)))
  0
  )

;; ----------------------------------------------------------------------------
;; Jetpack hover: what the model does when the player lets go of everything
;; ----------------------------------------------------------------------------

(defbehavior smoke-hover-watch process ((tag string) (secs float))
  "For SECS, nothing pressed: count the model's clip changes, the frames Jak's on-surface flag
   changes, and the model's and Jak's height range, then print them; record it as a GIF (TAG)."
  (smoke-neutral)
  (smoke-rec-start tag 2)
  (let ((t0 (smoke-now))
        (av (smoke-av))
        (clips 0)
        (flips 0)
        (last-anim -2)
        (last-ground? #f)
        (lo 1000000000.0)
        (hi -1000000000.0)
        (jlo 1000000000.0)
        (jhi -1000000000.0)
        (frames 0)
        (last-frame -1.0)
        (advance 0.0)
        )
    (when av
      (set! last-anim (-> av anim))
      (set! last-ground? (logtest? (-> *target* control status) (collide-status on-surface)))
      (format 0 "SMOKE ~S start: clip ~D speed ~f frames ~D," tag (-> av anim)
              (-> av skel root-channel 0 frame-group speed) (-> av skel root-channel 0 frame-group frames num-frames))
      (format 0 " Jak ~M above his ground, state ~A, fuel ~f~%"
              (- (-> *target* control trans y) (-> *target* control gspot-pos y)) (-> *target* state name) (-> av fuel))
      )
    (while (and (smoke-av) (< (- (smoke-now) t0) (the int (* secs 300.0))))
      (let ((av (smoke-av)))
        (when (!= (-> av anim) last-anim)
          (+! clips 1)
          (set! last-anim (-> av anim))
          )
        ;; how far the clip moves each game frame (a loop wraps back by its length minus one)
        (let ((f (-> av skel root-channel 0 frame-num))
              (n (the float (+ (-> av skel root-channel 0 frame-group frames num-frames) -1)))
              )
          (when (<= 0.0 last-frame)
            (let ((d (- f last-frame)))
              (if (< d (* -0.5 n))
                  (+! d n)
                  )
              (+! advance (fabs d))
              )
            )
          (set! last-frame f)
          )
        (let ((g? (logtest? (-> *target* control status) (collide-status on-surface))))
          (when (!= g? last-ground?)
            (+! flips 1)
            (set! last-ground? g?)
            )
          )
        (set! lo (fmin lo (-> av root trans y)))
        (set! hi (fmax hi (-> av root trans y)))
        (set! jlo (fmin jlo (-> *target* control trans y)))
        (set! jhi (fmax jhi (-> *target* control trans y)))
        (+! frames 1)
        )
      (suspend)
      )
    (smoke-rec-stop)
    (format 0 "SMOKE hover ~S: ~D frames, ~D clip changes (now ~D), ~D on-surface flips," tag frames clips last-anim flips)
    (format 0 " model y range ~M, Jak y range ~M, state ~A, clip frames per game frame ~f~%" (- hi lo) (- jhi jlo)
            (if *target* (-> *target* state name) 'none) (/ advance (the float (max 1 frames))))
    ;; the Jak 2 rip's frames, 15 a second: a quarter of a clip frame each game frame
    (let ((pace (/ advance (the float (max 1 frames)))))
      (smoke-check "the jetpack's clip plays at the rip's pace (15 frames a second)" (and (< 0.2 pace) (< pace 0.3)))
      )
    clips
    )
  )

;; The model's joints against its root, the frame before (`smoke-pose-watch`).
(define *smoke-joints* (new 'global 'inline-array 'vector 64))

(defun smoke-pose-step ((av bf-avatar) (first? symbol))
  "How far, in meters, the model's joints moved against its root since the last call, summed over
   its joints (0 on the FIRST? call); the joints kept for the next call."
  (let ((sum 0.0)
        (p (new 'stack-no-clear 'vector))
        )
    (dotimes (i (min 64 (-> av node-list length)))
      (vector<-cspace! p (-> av node-list data i))
      (vector-! p p (-> av root trans))
      (if (not first?)
          (+! sum (vector-vector-distance p (-> *smoke-joints* i)))
          )
      (vector-copy! (-> *smoke-joints* i) p)
      )
    sum
    )
  )

(defbehavior smoke-pose-watch process ((tag string) (secs float) (old-pace? symbol))
  "For SECS, nothing pressed: the mean motion of the model's joints against its root each game
   frame, in centimeters, recorded as a GIF (TAG). OLD-PACE? plays the clip at the build's own speed,
   a clip frame each game frame, as before the fix: each frame this adds 0.75 to the frame the
   class code advanced by 0.25 (the joints are computed again after it, `bf-avatar-cam-post`)."
  (smoke-neutral)
  (smoke-rec-start tag 2)
  (let ((t0 (smoke-now))
        (frames 0)
        (total 0.0)
        )
    (when (smoke-av)
      (smoke-pose-step (smoke-av) #t)
      )
    (while (and (smoke-av) (< (- (smoke-now) t0) (the int (* secs 300.0))))
      (let* ((av (smoke-av))
             (ch (-> av skel root-channel 0))
             )
        (when old-pace?
          (let ((n (the float (+ (-> ch frame-group frames num-frames) -1)))
                (f (+ (-> ch frame-num) 0.75))
                )
            (set! (-> ch frame-num) (if (>= f n) (- f n) f))
            )
          )
        (+! total (smoke-pose-step av #f))
        (+! frames 1)
        )
      (suspend)
      )
    (smoke-rec-stop)
    (let ((cm (/ (* 100.0 (/ total (meters 1))) (the float (max 1 frames)))))
      (format 0 "SMOKE pose ~S: ~D frames, joints moved ~f cm a game frame (summed over the joints), clip ~D~%"
              tag frames cm (if (smoke-av) (-> (smoke-av) anim) -1))
      cm
      )
    )
  )

(defbehavior smoke-jet-log process ((tag string) (secs float))
  "For SECS, every 0.25 s: Jak's height over his ground, his state, the jetpack's fuel and clip."
  (let ((t0 (smoke-now)))
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (let ((av (smoke-av)))
        (format 0 "SMOKE ~S: Jak ~M above his ground, state ~A, fuel ~f, clip ~D~%" tag
                (- (-> *target* control trans y) (-> *target* control gspot-pos y)) (-> *target* state name)
                (if av (-> av fuel) -1.0) (if av (-> av anim) -1))
        )
      (smoke-wait 0.25)
      )
    )
  0
  )

;; ----------------------------------------------------------------------------
;; Endurance: long fights, the player's death and respawn, a restart
;; ----------------------------------------------------------------------------

;; Pickup rate: every real unit death goes through `bf-queue-drop` (battlefront-h.gc, called by
;; bf-unit-killed); this copy of it counts the deaths it saw with room in the queue and the drops
;; they left.
(define *smoke-deaths* 0)
(define *smoke-drops* 0)
(define-perm *smoke-stock-queue-drop* (function process none) bf-queue-drop)

(defun bf-queue-drop ((proc process))
  "The stock `bf-queue-drop`, counted (`*smoke-deaths*`, `*smoke-drops*`)."
  (let ((n (-> *bf* drop-count)))
    (*smoke-stock-queue-drop* proc)
    (when (and (type? proc process-drawable) (< n BF_DROP_MAX))
      (+! *smoke-deaths* 1)
      (if (< n (-> *bf* drop-count))
          (+! *smoke-drops* 1)
          )
      )
    )
  (none)
  )

(defbehavior smoke-free-fight process ((class int) (secs float))
  "SECS of fighting as CLASS: strafing left and right and turning, R1 held, then one of the class's
   own moves in turn (guards: a dodge, a weapon change, the rifle butt; jetpacks: a climb, a way
   down, a dive kick; robotguard: a roll, the shield, a punch; spider: a bite, a sprint, a high
   jump)."
  (let ((t0 (smoke-now))
        (n 0)
        )
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (smoke-step "free fight: strafe, turn and fire")
      (smoke-stick (if (zero? (logand n 1)) 30 225) 90 (if (zero? (logand n 2)) 190 70) 128)
      (smoke-hold (pad-buttons r1))
      (smoke-wait 1.5)
      (smoke-hold (the-as pad-buttons 0))
      (smoke-stick 128 128 128 128)
      (case class
        ((BF_CLASS_BLUE_GUARD BF_CLASS_RED_GUARD)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: dodge")
            (smoke-press (if (zero? (logand n 1)) (pad-buttons l2) (pad-buttons r2)) 1.0)
            )
           ((1)
            (smoke-step "free fight: weapon change")
            (smoke-press (case (mod n 9) ((1) (pad-buttons left)) ((4) (pad-buttons up)) (else (pad-buttons down))) 0.6)
            )
           (else
             (smoke-step "free fight: rifle butt")
             (smoke-press (pad-buttons square) 1.0)
             )
           )
         )
        ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: jetpack climb")
            (smoke-hold (pad-buttons x))
            (smoke-wait 0.8)
            (smoke-hold (the-as pad-buttons 0))
            )
           ((1)
            (smoke-step "free fight: jetpack down")
            (smoke-hold (pad-buttons circle))
            (smoke-wait 0.8)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: dive kick")
             (smoke-press (pad-buttons square) 1.2)
             )
           )
         )
        ((BF_CLASS_ROBOGUARD)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: roll")
            (smoke-press (pad-buttons r2) 1.4)
            )
           ((1)
            (smoke-step "free fight: shield")
            (smoke-hold (pad-buttons circle))
            (smoke-wait 1.2)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: punch")
             (smoke-press (pad-buttons square) 1.2)
             )
           )
         )
        ((BF_CLASS_SPYDROID)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: bite")
            (smoke-press (pad-buttons circle) 0.8)
            )
           ((1)
            (smoke-step "free fight: sprint")
            (smoke-stick 128 0 128 128)
            (smoke-hold (pad-buttons r2))
            (smoke-wait 1.0)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: high jump")
             (smoke-hold (pad-buttons x))
             (smoke-wait 0.8)
             (smoke-hold (the-as pad-buttons 0))
             )
           )
         )
        )
      (+! n 1)
      )
    )
  (smoke-neutral)
  0
  )

(defbehavior smoke-kill-player process ()
  "A deadly generic attack on the player from this process (the invulnerable secret lifted for
   it, then put back as it was)."
  (let ((invuln? (logtest? (-> *game-info* secrets) (game-secrets invulnerable)))
        (id (+ (-> *game-info* attack-id) 1))
        (msg (new 'stack-no-clear 'event-message-block))
        )
    (logclear! (-> *game-info* secrets) (game-secrets invulnerable))
    (set! (-> *game-info* attack-id) id)
    (set! (-> msg from) (process->ppointer self))
    (set! (-> msg num-params) 2)
    (set! (-> msg message) 'attack)
    (set! (-> msg param 0) (the-as uint #f))
    (set! (-> msg param 1)
          (the-as uint (static-attack-info :mask (vehicle-impulse-factor) ((id id)
                                                                           (damage 100.0)
                                                                           (vehicle-damage-factor 1.0)
                                                                           (vehicle-impulse-factor 1.0)
                                                                           (mode 'generic)
                                                                           )
                                  )
                   )
          )
    (send-event-function *target* msg)
    (if invuln?
        (logior! (-> *game-info* secrets) (game-secrets invulnerable))
        )
    )
  0
  )

(defbehavior smoke-death-check process ((tag string))
  "The player killed: his side loses one, the camera watches an ally while the class model is
   gone, then he is back at the spawn as the same class, the battle camera on him again."
  (smoke-step "player death")
  (smoke-neutral)
  (let ((class (-> *bf* class))
        (lost (-> *bf* losses (-> *bf* team)))
        )
    (smoke-kill-player)
    ;; the class model plays its own death first (round 23)
    (smoke-wait 3.5)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE ~S dead: respawn pending ~A, avatar ~A, camera ~A~%" tag (nonzero? (-> *bf* respawn-time))
              (bf-avatar-alive?) (if slave (-> slave 0 state name) 'none))
      )
    (smoke-check "the killed player waits to respawn, his class model gone"
                 (and (nonzero? (-> *bf* respawn-time)) (not (bf-avatar-alive?)))
                 )
    (smoke-wait-for 15.0 (lambda () (and (zero? (-> *bf* respawn-time)) (bf-avatar-alive?))))
    (smoke-wait 1.5)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE ~S respawned: class ~D (was ~D), losses ~D (were ~D)," tag (-> *bf* class) class
              (-> *bf* losses (-> *bf* team)) lost)
      (format 0 " camera ~A, state ~A~%" (if slave (-> slave 0 state name) 'none) (-> *target* state name))
      (smoke-check "back at the spawn as the same class, one more loss, the battle camera on him"
                   (and (bf-avatar-alive?)
                        (= (-> *bf* class) class)
                        (< lost (-> *bf* losses (-> *bf* team)))
                        slave
                        (= (-> slave 0 state name) 'cam-pov)
                        (not (focus-test? *target* dead))
                        )
                   )
      )
    )
  0
  )

(defbehavior smoke-restart process ()
  "START > Restart the battle: both reserves full again, the same class, the battle camera."
  (smoke-step "restart the battle")
  (smoke-neutral)
  (let ((class (-> *bf* class)))
    (smoke-bf-pause 4)
    (smoke-wait 1.0)
    (smoke-wait-for 90.0 (lambda () (and (bf-fighting?) (bf-avatar-alive?))))
    (smoke-wait 2.0)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE restart: reserves ~D ~D, class ~D (was ~D), camera ~A~%" (-> *bf* reserve 0) (-> *bf* reserve 1)
              (-> *bf* class) class (if slave (-> slave 0 state name) 'none))
      (smoke-check "Restart the battle: the same class at the spawn, the battle camera"
                   (and (bf-avatar-alive?) (= (-> *bf* class) class) slave (= (-> slave 0 state name) 'cam-pov))
                   )
      )
    )
  0
  )

(defbehavior smoke-endurance process ((zone int) (team int) (secs float))
  "A battle in ZONE on side TEAM: each class of the side fights SECS (`smoke-free-fight`), then the
   player is killed and respawns (`smoke-death-check`); a restart at the end, then Quit."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start zone team)
  (smoke-deploy 0 "endurance first class")
  (dotimes (i (if (= team BF_TEAM_FF) 2 4))
    (when (> i 0)
      (smoke-change-class i "endurance next class")
      )
    (format 0 "SMOKE endurance class ~D for ~D s~%" (-> *bf* class) (the int secs))
    (smoke-free-fight (-> *bf* class) secs)
    (smoke-status "endurance")
    (smoke-check "still in the battle after the long fight" (and *target* (bf-fighting?)))
    (smoke-death-check "endurance")
    )
  (smoke-restart)
  (smoke-free-fight (-> *bf* class) 10.0)
  (let ((rate (/ (the float *smoke-drops*) (the float (max 1 *smoke-deaths*)))))
    (format 0 "SMOKE pickups: ~D of ~D unit deaths left one (~f)~%" *smoke-drops* *smoke-deaths* rate)
    (smoke-check "3 of every 10 fallen units leave a pickup" (and (< 100 *smoke-deaths*) (< 0.28 rate) (< rate 0.32)))
    )
  (smoke-quit)
  0
  )

;; ----------------------------------------------------------------------------
;; The scenarios
;; ----------------------------------------------------------------------------

(defun smoke-guard-masks ()
  "The guards of the battle near the player and their hidden mesh segments (draw-control seg-mask:
   a set bit hides that segment; a blue guard's 1 and 2 are its two armors, normal and dark guard,
   so both set leave its legs alone). Prints each such guard. Returns how many."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        (bare 0)
        )
    (set! (-> probe w) (meters 150))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and (= (handle->process (process->handle proc)) proc) (= (-> proc type symbol) 'crimson-guard))
              (+! n 1)
              (let ((draw (-> (the-as process-drawable proc) draw)))
                (when (= (logand (-> draw seg-mask) 6) 6)
                  (+! bare 1)
                  (format 0 "SMOKE guard with both armors hidden: pid ~D ~S seg-mask ~X effect-mask ~X state ~A~%"
                          (-> proc pid) (bf-art-name proc) (-> draw seg-mask) (-> draw effect-mask) (-> proc state name))
                  )
                )
              )
            )
          )
        )
      )
    (format 0 "SMOKE guards near: ~D, ~D with both armors hidden~%" n bare)
    bare
    )
  )

(defbehavior smoke-tazer-walk process ()
  "The tazer struck while walking ahead, filmed (smoke-rec-tazer-*): the stab plays on the upper
   body (its clip is the upper body's 0.2 s after R1) and Jak keeps walking (his move in the 1.2 s
   after the strike against the 1.2 s before)."
  (smoke-step "tazer while walking")
  (smoke-press (pad-buttons left) 1.0)
  (set! (-> *bf* tazer-time) 0)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.8)
  (let ((p0 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
    (smoke-rec-start "tazer" 2)
    (smoke-wait 1.2)
    (let ((before (/ (vector-vector-xz-distance (-> *target* control trans) p0) (meters 1)))
          (p1 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
          (stab? #f)
          )
      (smoke-tap (pad-buttons r1) 4)
      (smoke-wait 0.2)
      (when (smoke-av)
        (let ((top (-> (smoke-av) skel top-anim))
              (clip (-> (smoke-av) draw art-group data BF_CLIP_TAZER))
              )
          (if top
              (set! stab? (or (= (-> top frame-group) clip) (= (-> top frame-targ) clip)))
              )
          )
        )
      (smoke-wait 1.0)
      (smoke-rec-stop)
      (smoke-stick 128 128 128 128)
      (let ((after (/ (vector-vector-xz-distance (-> *target* control trans) p1) (meters 1))))
        (format 0 "SMOKE tazer while walking: stab on the upper body ~A, ~f m in the 1.2 s before the strike, ~f m in the 1.2 s after~%"
                stab? before after)
        (smoke-check "the tazer's stab plays on the upper body" stab?)
        (smoke-check "the guard walks on while it strikes" (< (* 0.6 before) after))
        )
      )
    )
  (smoke-press (pad-buttons down) 1.0)
  0
  )

(defbehavior smoke-look-at-jetpack process ()
  "The nearest jetpack guard within 80 m: Jak brought 8 m from it, the camera turned and tilted
   toward it, two screenshots of its flames (smoke-jet-flames, -2). Returns #t when one was found."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (best (the-as process-drawable #f))
        (best-dist (meters 80))
        )
    (set! (-> probe w) (meters 80))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and (= (handle->process (process->handle proc)) proc) (bf-hover-art? proc))
              (let ((d (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe)))
                (when (< d best-dist)
                  (set! best-dist d)
                  (set! best (the-as process-drawable proc))
                  )
                )
              )
            )
          )
        )
      )
    (when best
      ;; Jak brought 8 m from it, at his own height, for a close look
      (let ((d (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (-> best root trans))))
        (set! (-> d y) 0.0)
        (vector-normalize! d (meters 8))
        (vector+! d d (-> best root trans))
        (set! (-> d y) (-> *target* control trans y))
        (move-to-point! (-> *target* control) d)
        )
      (let ((h (process->handle best)))
        (dotimes (i 3)
          (let ((p (the-as process-drawable (handle->process h))))
            (when p
              (let ((d (vector-! (new 'stack-no-clear 'vector) (-> p root trans) (-> *target* control trans))))
                (set! (-> *bf* view-yaw) (vector-y-angle d))
                (set! (-> *bf* view-pitch) (fmax (degrees -30) (fmin (degrees 35) (atan (-> d y) (vector-xz-length d)))))
                )
              )
            )
          (smoke-wait 0.4)
          )
        )
      (format 0 "SMOKE jetpack guard ~M away~%" best-dist)
      (smoke-shot "jet-flames")
      (smoke-wait 0.3)
      (smoke-shot "jet-flames-2")
      (smoke-wait 0.5)
      (set! (-> *bf* view-pitch) 0.0)
      )
    (if best #t #f)
    )
  )

;; the transports' count of each side's units awake (CWI, linked after GAME)
(define-extern bf-transport-team-count (function int (pointer int32) int))

(defun smoke-points-line ((tag string))
  "One line per battle point: its holder, capture, units of each side near it, its ship."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (format 0 "SMOKE point ~S ~D: owner ~D prog ~D" tag i (-> pt owner) (-> pt prog-team))
      (format 0 " ~f near ~D/~D ship ~A" (-> pt progress) (-> pt near 0) (-> pt near 1) (if (handle->process (-> pt ship)) #t #f))
      (format 0 " at ~M ~M ~M~%" (-> pt pos x) (-> pt pos y) (-> pt pos z))
      )
    )
  0
  )

(defun smoke-team-line ((tag string))
  "Units awake of each side (bf-transport.gc counts) and ships up."
  (let ((c (new 'stack-no-clear 'array 'int32 4))
        (ships 0)
        )
    (dotimes (i (-> *bf* point-count))
      (if (handle->process (-> *bf* points i ship))
          (+! ships 1)
          )
      )
    (format 0 "SMOKE units ~S: FF ~D (" tag (bf-transport-team-count BF_TEAM_FF c))
    (format 0 "~D guards ~D jets) KG ~D (" (-> c 0) (-> c 1) (bf-transport-team-count BF_TEAM_KG c))
    (format 0 "~D guards ~D jets ~D robots ~D spiders), ships ~D" (-> c 0) (-> c 1) (-> c 2) (-> c 3) ships)
    (format 0 ", losses ~D/~D, default nav mesh ~D of ~D~%" (-> *bf* losses 0) (-> *bf* losses 1)
            (-> *default-nav-mesh* nav-control-count) (-> *default-nav-mesh* max-nav-control-count))
    )
  0
  )

(defbehavior smoke-look-at process ((pos vector) (up float))
  "Turn the battle camera toward POS, from 2 m above Jak's feet, tilted UP rotation units more."
  (let ((d (vector-! (new 'stack-no-clear 'vector) pos (-> *target* control trans))))
    (set! (-> *bf* view-yaw) (vector-y-angle d))
    (set! (-> *bf* view-pitch) (+ up (atan (- (-> d y) (meters 2)) (vector-xz-length d))))
    )
  0
  )

(defbehavior smoke-look-at-ship process ()
  "The camera on the nearest troop transport within 150 m: a screenshot (smoke-ship). #t when one."
  (let ((best -1)
        (best-d (meters 150))
        )
    (dotimes (i (-> *bf* point-count))
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
        (when ship
          (let ((d (vector-vector-distance (-> ship root trans) (-> *target* control trans))))
            (when (< d best-d)
              (set! best-d d)
              (set! best i)
              )
            )
          )
        )
      )
    (when (>= best 0)
      ;; the ship looked up again after the wait: a process pointer kept across it can go stale
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points best ship)))))
        (if ship
            (smoke-look-at (-> ship root trans) 0.0)
            )
        )
      (smoke-wait 1.0)
      (smoke-shot "ship")
      (let ((ship (handle->process (-> *bf* points best ship))))
        (format 0 "SMOKE ship of point ~D, ~M away, state ~A~%" best best-d (if ship (-> ship next-state name) 'gone))
        )
      )
    (set! (-> *bf* view-pitch) 0.0)
    (>= best 0)
    )
  )

;; the troop transports' ground probe and sky test, a unit back to its pool (bf-transport.gc, CWI)
(define-extern bf-transport-sleep (function process symbol))
(define-extern bf-transport-ground (function vector symbol))
(define-extern bf-transport-sky? (function vector symbol))

(defun smoke-ships-sky ()
  "Each troop transport up: nothing above the ground under it (`bf-transport-sky?`). #t when every
   one is clear, and at least one is up."
  (let ((ok #t)
        (n 0)
        (at (new 'stack-no-clear 'vector))
        )
    (dotimes (i (-> *bf* point-count))
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
        (when ship
          (+! n 1)
          (vector-copy! at (-> ship root trans))
          (let ((ground? (bf-transport-ground at))
                (clear? (bf-transport-sky? at))
                )
            (format 0 "SMOKE ship of point ~D at ~M ~M ~M, ~M from its point, sky clear ~A~%" i (-> at x) (-> at y) (-> at z)
                    (vector-vector-xz-distance at (-> *bf* points i pos)) clear?)
            (if (not (and ground? clear?))
                (set! ok #f)
                )
            )
          )
        )
      )
    (and ok (< 0 n))
    )
  )

(defun smoke-count-near ((team int) (pos vector) (radius float))
  "Living units of side TEAM within RADIUS of POS (the actor hash), the player aside."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) pos))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        )
    (set! (-> probe w) radius)
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and proc (= (handle->process (process->handle proc)) proc) (!= proc *target*)
                       (type? proc process-focusable)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (= (bf-unit-team proc) team)
                       (< (vector-vector-distance (-> (the-as process-focusable proc) root trans) pos) radius)
                       )
              (+! n 1)
              )
            )
          )
        )
      )
    n
    )
  )

(defbehavior smoke-respawn-page process ((secs float))
  "After a death or a redeploy, until the respawn page is open (SECS at most): X on the class page
   (a redeploy's, the class kept), X once the dead player may choose (round 28: he watches the
   battle until X, or Triangle for the class page)."
  (let ((t0 (smoke-now)))
    (until (or (>= (-> *bf* respawn-pick) 0) (< (the int (* 300.0 secs)) (- (smoke-now) t0)))
      (cond
        ((and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_CLASS))
         (smoke-press (pad-buttons x) 1.0)
         )
        ((and *target* (focus-test? *target* dead) (nonzero? (-> *bf* respawn-time)))
         ;; X once a second: before the choice opens (BF_RESPAWN_TIME) it does nothing
         (smoke-press (pad-buttons x) 1.0)
         )
        (else
          (suspend)
          )
        )
      )
    )
  0
  )

(defbehavior smoke-pick-point process ((want int))
  "On the open respawn page: D-pad right until point WANT is picked (8 presses at most), then X."
  (dotimes (k 8)
    (if (!= (-> *bf* respawn-pick) want)
        (smoke-press (pad-buttons right) 0.5)
        )
    )
  (format 0 "SMOKE respawn pick ~D (want ~D)~%" (-> *bf* respawn-pick) want)
  (smoke-press (pad-buttons x) 1.0)
  0
  )

(defbehavior smoke-shield-check process ()
  "Right after a deployment or a respawn: Jak invulnerable and his class model blinking for 3 s,
   then steady and vulnerable. #t when so."
  (let ((shown 0)
        (hidden 0)
        (invuln? (logtest? (-> *target* target-flags) (target-flags tinvuln1 tinvuln2)))
        )
    (dotimes (k 40)
      (let ((av (smoke-av)))
        (if (and av (logtest? (-> av draw status) (draw-control-status no-draw)))
            (+! hidden 1)
            (+! shown 1)
            )
        )
      (suspend)
      )
    (smoke-wait 3.5)
    (let ((av (smoke-av)))
      (format 0 "SMOKE spawn shield: invulnerable ~A, blink ~D hidden ~D shown in 40 frames; after: hidden ~A, invulnerable ~A~%"
              invuln? hidden shown (if av (logtest? (-> av draw status) (draw-control-status no-draw)) 'none)
              (logtest? (-> *target* target-flags) (target-flags tinvuln1 tinvuln2)))
      (and invuln? (< 3 hidden) (< 3 shown) av (not (logtest? (-> av draw status) (draw-control-status no-draw)))
           (not (logtest? (-> *target* target-flags) (target-flags tinvuln1 tinvuln2)))
           )
      )
    )
  )

(defun smoke-ship-over ((i int))
  "The distance (m) from point I to the ship over it on the ground plane, -1.0 for none."
  (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
    (if ship
        (/ (vector-vector-xz-distance (-> ship root trans) (-> *bf* points i pos)) (meters 1))
        -1.0
        )
    )
  )

(define-extern bf-post-point (function process integer))
(define *smoke-point* 0)

(defun smoke-point-open ((i int))
  "Point I on open ground: moved there once its section loaded (`snapped?`), the ground right under
   it, a nav mesh within 2 m, nothing above it up to 60 m, its ship within 1 m over it. #t when so."
  (let* ((pt (-> *bf* points i))
         (at (vector-copy! (new 'stack-no-clear 'vector) (-> pt pos)))
         (ground? (bf-transport-ground at))
         (off (fabs (- (-> at y) (-> pt pos y))))
         (mesh? (if (find-nearest-nav-mesh (-> pt pos) 8192.0) #t #f))
         (sky? (bf-transport-sky? (-> pt pos)))
         (ship (smoke-ship-over i))
         )
    (format 0 "SMOKE point ~D ~S: owner ~D, snapped ~A, " i (bf-point-name i) (-> pt owner) (-> pt snapped?))
    (format 0 "ground ~A ~M off, nav mesh ~A, sky clear ~A, ship ~f m off~%" ground? off mesh? sky? ship)
    (and (-> pt snapped?) ground? (< off (meters 1)) mesh? sky? (<= 0.0 ship) (< ship 1.0))
    )
  )

(defun smoke-walkers ((i int) (team int))
  "Guards of side TEAM within 15 m of point I that walked there: crimson guards (no jetpack, robot or
   spider) out of their ship (not in exit-transport), on the ground (within 4 m of the point's
   height), not posted on it by a ship over it (bf-transport.gc `bf-post-point`)."
  (let ((pos (-> *bf* points i pos))
        (probe (new 'stack-no-clear 'vector))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        )
    (vector-copy! probe pos)
    (set! (-> probe w) BF_POINT_RADIUS)
    (countdown (k (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes k) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and proc (= (handle->process (process->handle proc)) proc)
                       (= (-> proc type symbol) 'crimson-guard)
                       (= (bf-unit-team proc) team)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (!= (-> proc next-state name) 'exit-transport)
                       (< (vector-vector-xz-distance (-> (the-as process-drawable proc) root trans) pos) BF_POINT_RADIUS)
                       (< (fabs (- (-> (the-as process-drawable proc) root trans y) (-> pos y))) (meters 4))
                       (!= (bf-post-point proc) i)
                       )
              (+! n 1)
              )
            )
          )
        )
      )
    n
    )
  )

(defun smoke-posted ((i int) (team int))
  "Units of side TEAM posted on point I (`*bf-posts*`) and within 30 m of it, alive."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        )
    (set! (-> probe w) (meters 30))
    (countdown (k (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes k) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and proc (= (handle->process (process->handle proc)) proc) (!= proc *target*)
                       (type? proc process-focusable)
                       (= (bf-unit-team proc) team)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (= (bf-post-point proc) i)
                       (< (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe) (meters 30))
                       )
              (+! n 1)
              )
            )
          )
        )
      )
    n
    )
  )

(defun smoke-clear-point ((i int) (team int))
  "Every unit of side TEAM within 40 m of point I back to its pool (bf-transport.gc
   `bf-transport-sleep`): the side's units come back from elsewhere. Returns how many."
  (let ((n 0))
    (dotimes (pass 4)
      (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
            (shapes (new 'stack-no-clear 'array 'collide-shape 64))
            )
        (set! (-> probe w) (meters 40))
        (countdown (k (fill-actor-list-for-box *actor-hash* probe shapes 64))
          (let ((shape (as-type (-> shapes k) collide-shape)))
            (when shape
              (let ((proc (-> shape process)))
                (when (and proc (= (handle->process (process->handle proc)) proc) (!= proc *target*)
                           (type? proc process-focusable)
                           (= (bf-unit-team proc) team)
                           (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                           (< (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe) (meters 40))
                           (bf-transport-sleep proc)
                           )
                  (+! n 1)
                  )
                )
              )
            )
          )
        )
      (suspend)
      )
    n
    )
  )

(defun smoke-clear-line? ((a vector) (b vector))
  "#t when no scenery stands between A and B (a 0.5 m sphere swept from A to B)."
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (vector-copy! (-> cq start-pos) a)
    (vector-! (-> cq move-dist) b a)
    (set! (-> cq radius) (meters 0.5))
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (< (fill-and-probe-using-line-sphere *collide-cache* cq) 0.0)
    )
  )

(defun smoke-viewpoint ((i int) (aim vector) (out vector))
  "OUT gets where to film AIM (on or over point I) from: a spot 20, 25, 16 or 30 m from the point,
   of the 16 ways round it the first on the point's own nav mesh (the same open space: a sweep test
   against the scenery let a dock wall at the Port through), with ground within 2 m of the point's
   height and a clear view of AIM from 2 m above the spot (Jak) and from 4 m behind it, 3 m up (the
   camera). #f when none."
  (let ((pt (-> *bf* points i pos))
        (dir (new 'stack-no-clear 'vector))
        (head (new 'stack-no-clear 'vector))
        (cam (new 'stack-no-clear 'vector))
        (dists (new 'static 'array float 4 (meters 20) (meters 25) (meters 16) (meters 30)))
        (mesh (find-nearest-nav-mesh (-> *bf* points i pos) (meters 2)))
        )
    (dotimes (d 4)
      (dotimes (k 16)
        (set-vector! dir 0.0 0.0 (-> dists d) 1.0)
        (vector-rotate-around-y! dir dir (* (degrees 22.5) (the float k)))
        (vector+! out pt dir)
        (set! (-> out w) 1.0)
        (when (and (bf-transport-ground out) (< (fabs (- (-> out y) (-> pt y))) (meters 2))
                   (= (find-nearest-nav-mesh out (meters 2)) mesh)
                   )
          (vector-copy! head out)
          (+! (-> head y) (meters 2))
          (vector-normalize-copy! cam dir (meters 4))
          (vector+! cam cam out)
          (+! (-> cam y) (meters 3))
          (if (and (smoke-clear-line? head aim) (smoke-clear-line? cam aim))
              (return #t)
              )
          )
        )
      )
    )
  #f
  )

(defbehavior smoke-face process ((aim vector))
  "Jak turned toward AIM, as the director turns him at a respawn (battlefront.gc `bf-target-death`),
   and the battle camera too (`smoke-look-at`): after a far respawn the camera follows Jak's facing.
   Logs how far the camera's own heading is from AIM."
  (let ((dir (vector-! (new 'stack-no-clear 'vector) aim (-> *target* control trans))))
    (set! (-> dir y) 0.0)
    (when (< (meters 0.5) (vector-length dir))
      (vector-normalize! dir 1.0)
      (forward-up->quaternion (-> *target* control quat-for-control) dir *y-vector*)
      (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))
      (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
      )
    )
  (smoke-look-at aim 0.0)
  (smoke-wait 1.5)
  (let ((fwd (vector-copy! (new 'stack-no-clear 'vector) (-> *math-camera* inv-camera-rot fvec)))
        (want (vector-! (new 'stack-no-clear 'vector) aim (-> *math-camera* trans)))
        )
    (set! (-> fwd y) 0.0)
    (set! (-> want y) 0.0)
    (vector-normalize! fwd 1.0)
    (vector-normalize! want 1.0)
    (format 0 "SMOKE camera heading ~f from the aim's (1 = straight at it)~%" (vector-dot fwd want))
    )
  0
  )

(defbehavior smoke-film-point process ((i int))
  "Jak where nothing hides point I's ship (10 m over the point without one) from him or the camera
   (`smoke-viewpoint`), the camera on it: the ship and the point in view."
  (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship))))
        (aim (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
        (at (new 'stack-no-clear 'vector))
        )
    (if ship
        (vector-copy! aim (-> ship root trans))
        (+! (-> aim y) (meters 10))
        )
    (cond
      ((smoke-viewpoint i aim at)
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       (smoke-wait 1.5)
       (smoke-face aim)
       (format 0 "SMOKE film point ~D: Jak ~M from it, aim ~M above it, camera ~M from Jak, " i
               (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos))
               (- (-> aim y) (-> *bf* points i pos y)) (vector-vector-distance (-> *math-camera* trans) (-> *target* control trans)))
       (format 0 "~M above him, its view of the aim clear ~A~%" (- (-> *math-camera* trans y) (-> *target* control trans y))
               (smoke-clear-line? (-> *math-camera* trans) aim))
       )
      (else
        (format 0 "SMOKE no viewpoint on point ~D's ship~%" i)
        )
      )
    )
  (smoke-wait 1.0)
  0
  )

(defbehavior smoke-tour-point process ((i int) (tag string) (swapped string))
  "Point I given to the player's side, then a respawn there (a death, the respawn page): on open
   ground with its ship right over it (`smoke-point-open`); given to the other
   side, its ship leaves and the other side's takes its place."
  (smoke-step tag)
  (set! (-> *bf* points i owner) BF_TEAM_FF)
  (smoke-wait 1.0)
  ;; there through a death and the respawn page (the redeploy, T18, waits 30 s out of combat: the
  ;; other side's units filmed 20 m off keep hitting the invulnerable player)
  (smoke-invulnerable #f)
  (smoke-kill-player)
  (smoke-respawn-page 12.0)
  (smoke-check "a death opens the respawn page" (>= (-> *bf* respawn-pick) 0))
  (smoke-pick-point i)
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
  (smoke-wait 2.0)
  (format 0 "SMOKE redeployed ~M from point ~D, level ~A~%"
          (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) i (-> *load-state* vis-nick))
  (smoke-check "redeployed on the point" (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) (meters 10)))
  (smoke-invulnerable #t)
  (set! *smoke-point* i)
  (smoke-wait-for 30.0 (lambda () (and (-> *bf* points *smoke-point* snapped?) (<= 0.0 (smoke-ship-over *smoke-point*)))))
  (smoke-wait 8.0)
  (smoke-check "the point on open ground, a ship of its holder right over it" (smoke-point-open i))
  (smoke-check "the ship comes down where nothing stands above it" (smoke-ships-sky))
  (smoke-film-point i)
  (smoke-shot tag)
  (let ((before (-> *bf* points i ship)))
    (set! (-> *bf* points i owner) BF_TEAM_KG)
    (smoke-wait 2.0)
    (let ((old (handle->process before)))
      (format 0 "SMOKE the old ship: ~A~%" (if old (-> old next-state name) 'gone))
      (smoke-check "taken by the other side, the losing side's ship leaves"
                   (and (!= (-> *bf* points i ship) before)
                        (or (not old) (= (-> old next-state name) 'leave) (= (-> old next-state name) 'die-fast))
                        )
                   )
      )
    )
  (smoke-wait-for 30.0 (lambda () (<= 0.0 (smoke-ship-over *smoke-point*))))
  (smoke-wait 8.0)
  (smoke-check "the new holder's ship takes its place, right over the point" (smoke-point-open i))
  (smoke-film-point i)
  (smoke-shot swapped)
  (smoke-team-line tag)
  0
  )

(defbehavior smoke-conquer-defend process ((team int) (i int) (leave string) (conquest string) (defense string))
  "Side TEAM just deployed at its base: its guards walk from their base's ship to control point I,
   neutral, and take it alone, Jak 16 to 30 m off it where nothing hides it (`smoke-viewpoint`);
   then I is given to the other side, TEAM's units around it sent back: the other side's ship comes
   over it, its units posted there hold it, and TEAM's guards walk back from their base to retake
   it. Clips LEAVE (at the base), CONQUEST and DEFENSE (every half second), shots CONQUEST and
   DEFENSE."
  (let ((foe (- 1 team))
        (aim (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
        )
    (+! (-> aim y) (meters 1.5))
    (smoke-step "conquest on foot")
    (smoke-wait 1.0)
    (smoke-rec-start leave 4)
    (smoke-wait 8.0)
    (smoke-rec-stop)
    (smoke-wait 22.0)
    (let ((at (new 'stack-no-clear 'vector)))
      (when (not (smoke-viewpoint i aim at))
        (vector-! at (-> *bf* points team pos) (-> *bf* points i pos))
        (set! (-> at y) 0.0)
        (vector-normalize! at (meters 25))
        (vector+! at at (-> *bf* points i pos))
        )
      (+! (-> at y) (meters 2))
      (move-to-point! (-> *target* control) at)
      )
    (smoke-wait 2.0)
    (smoke-face aim)
    (format 0 "SMOKE Jak ~M from point ~D ~S (a unit counts within 15 m), its side's base ~M from it~%"
            (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) i (bf-point-name i)
            (vector-vector-xz-distance (-> *bf* points team pos) (-> *bf* points i pos)))
    (smoke-rec-start conquest 30)
    (let ((k 0)
          (walkers 0)
          (jak-in 0)
          )
      (until (or (= (-> *bf* points i owner) team) (>= k 48))
        (smoke-wait 5.0)
        (+! k 1)
        (let ((w (smoke-walkers i team)))
          (set! walkers (max walkers w))
          (if (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) BF_POINT_RADIUS)
              (+! jak-in 1)
              )
          (format 0 "SMOKE ~D s: point ~D owner ~D, capture by ~D ~f s, " (* k 5) i (-> *bf* points i owner)
                  (-> *bf* points i prog-team) (-> *bf* points i progress))
          (format 0 "side ~D: ~D within 15 m, ~D guards walked there~%" team (-> *bf* points i near team) w)
          )
        )
      (smoke-rec-stop)
      (smoke-wait 1.0)
      (smoke-check "the side's guards walk to the neutral point from their base's ship" (< 0 walkers))
      (smoke-check "they take it alone, the player never within its 15 m"
                   (and (= (-> *bf* points i owner) team) (zero? jak-in)))
      )
    (smoke-face aim)
    (smoke-shot conquest)
    (smoke-step "defense")
    (format 0 "SMOKE side ~D's units sent back from the point: ~D~%" team (smoke-clear-point i team))
    (set! (-> *bf* points i owner) foe)
    (smoke-face aim)
    (smoke-rec-start defense 30)
    (let ((k 0)
          (posted 0)
          (held 0)
          (kept 0)
          (both 0)
          (attackers 0)
          (lost-us (-> *bf* losses team))
          (lost-foe (-> *bf* losses foe))
          )
      (while (< k 36)
        (smoke-wait 5.0)
        (+! k 1)
        (let ((d (smoke-count-near foe (-> *bf* points i pos) BF_POINT_RADIUS))
              (a (smoke-count-near team (-> *bf* points i pos) BF_POINT_RADIUS))
              (p (smoke-posted i foe))
              (w (smoke-walkers i team))
              )
          (set! posted (max posted p))
          (set! attackers (max attackers w))
          ;; its defenders counted once the first of them is down from the ship
          (when (and (= (-> *bf* points i owner) foe) (< 0 posted))
            (+! held 1)
            (if (< 0 d)
                (+! kept 1)
                )
            )
          (if (and (< 0 d) (< 0 a))
              (+! both 1)
              )
          (format 0 "SMOKE ~D s: point ~D owner ~D, capture by ~D ~f s, " (* k 5) i (-> *bf* points i owner)
                  (-> *bf* points i prog-team) (-> *bf* points i progress))
          (format 0 "defenders (side ~D) ~D within 15 m (~D posted within 30 m), attackers ~D (~D guards walked there), ship ~A~%"
                  foe d p a w (if (handle->process (-> *bf* points i ship)) #t #f))
          )
        )
      (smoke-rec-stop)
      (smoke-wait 1.0)
      (smoke-shot defense)
      (format 0 "SMOKE defense: held ~D counts, defenders on it in ~D; both sides on it in ~D; losses attackers ~D, defenders ~D; owner at the end ~D~%"
              held kept both (- (-> *bf* losses team) lost-us) (- (-> *bf* losses foe) lost-foe) (-> *bf* points i owner))
      (smoke-check "the holder's ship drops units posted on its point" (< 0 posted))
      (smoke-check "the holder's units stay on the point it holds (on it in 4 counts of 5 or more)"
                   (and (< 0 held) (<= (* 4 held) (* 5 kept))))
      (smoke-check "the other side's guards walk back from their base to retake it" (< 0 attackers))
      (smoke-check "the sides fight on the point" (< 0 both))
      )
    )
  0
  )

(defun smoke-levels-line ((tag string))
  "Each level slot: its level, status and chunks of the level heap; the battle's hold on the city."
  (format 0 "SMOKE levels ~S (city-load ~D):~%" tag (-> *bf* city-load))
  (dotimes (i 10)
    (let ((lev (-> *level* level i)))
      (if (!= (-> lev status) 'inactive)
          (format 0 "SMOKE   slot ~D ~A ~A chunks #x~X~%" i (-> lev name) (-> lev status) (-> lev memory-mask))
          )
      )
    )
  ;; the trees the background drew last frame (background-h.gc: 32 of each kind at most)
  (format 0 "SMOKE   trees: tfrag ~D trans ~D water ~D shrub ~D tie ~D~%"
          (-> *background-work* tfrag-tree-count)
          (-> *background-work* tfrag-trans-tree-count)
          (-> *background-work* tfrag-water-tree-count)
          (-> *background-work* shrub-tree-count)
          (-> *background-work* tie-tree-count)
          )
  0
  )

(defun smoke-dots-line ((tag string))
  "The units awake (`*bf-unit-dots*`) of each side, and how many stand within 250 m of each point."
  (format 0 "SMOKE dots ~S:" tag)
  (dotimes (i (-> *bf* point-count))
    (let ((ff 0)
          (kg 0)
          )
      (dotimes (k (-> *bf-unit-dots* count))
        (when (< (vector-vector-xz-distance (-> *bf-unit-dots* pos k) (-> *bf* points i pos)) (meters 250))
          (if (= (-> *bf-unit-dots* team k) BF_TEAM_FF)
              (+! ff 1)
              (+! kg 1)
              )
          )
        )
      (format 0 " p~D ~D/~D" i ff kg)
      )
    )
  (format 0 "~%")
  0
  )

(defbehavior smoke-field-walk process ((x float) (y float) (z float) (to-x float) (to-z float) (tag string))
  "Jak set on the ground at X, Z (meters, Y a height to probe down from), turned toward TO-X, TO-Z
   (a force field between), filmed (TAG, a shot then a clip) while he runs at it 5 s, the stick held
   forward. Returns how far past the field's line he got toward TO, in meters: 0 or less when it
   held him."
  (let ((at (new 'stack-no-clear 'vector))
        (to (new 'stack-no-clear 'vector))
        )
    (set-vector! at (meters x) (meters y) (meters z) 1.0)
    (bf-transport-ground at)
    (+! (-> at y) (meters 1))
    (move-to-point! (-> *target* control) at)
    (set-vector! to (meters to-x) (+ (-> at y) (meters 3)) (meters to-z) 1.0)
    (smoke-wait 1.5)
    (smoke-face to)
    (smoke-shot tag)
    (smoke-wait 1.0)
    (smoke-rec-start tag 4)
    (smoke-stick 128 0 128 128)
    (smoke-wait 5.0)
    (smoke-neutral)
    (smoke-wait 0.5)
    (smoke-rec-stop)
    ;; the field's line is halfway between the start and TO: how far past it, toward TO
    (let* ((dir (vector-! (new 'stack-no-clear 'vector) to at))
           (len (vector-xz-length dir))
           (moved (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) at))
           )
      (set! (-> dir y) 0.0)
      (vector-normalize! dir 1.0)
      (set! (-> moved y) 0.0)
      (let ((along (/ (- (vector-dot moved dir) (* 0.5 len)) (meters 1))))
        (format 0 "SMOKE field ~S: Jak ran ~M toward it, ~f m past its line~%" tag (vector-dot moved dir) along)
        along
        )
      )
    )
  )

(defbehavior smoke-door-check process ((name string))
  "Jak 3 m in front of door NAME (a com-airlock, its front along its local z), facing it, 3 s: the
   door stays shut ('close). Jak goes to its entity first and waits for it, 6 s at most: the game
   starts an actor only near it. #t when so; #f when it opens, 'none when it never starts."
  (let ((e (the-as entity-actor (entity-by-name name))))
    (when e
      (let ((front (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> e quat)))
            (at (new 'stack-no-clear 'vector))
            )
        (set! (-> front y) 0.0)
        (vector-normalize! front (meters 3))
        (vector+! at (-> e trans) front)
        (+! (-> at y) (meters 1))
        (move-to-point! (-> *target* control) at)
        (let ((n 0))
          (until (or (process-by-ename name) (>= n 12))
            (smoke-wait 0.5)
            (+! n 1)
            )
          )
        )
      )
    )
  (let ((door (the-as process-drawable (process-by-ename name))))
    (cond
      ((not door)
       (format 0 "SMOKE door ~S not loaded~%" name)
       'none
       )
      (else
        (let ((front (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> door root quat)))
              (at (new 'stack-no-clear 'vector))
              (aim (vector-copy! (new 'stack-no-clear 'vector) (-> door root trans)))
              )
          (set! (-> front y) 0.0)
          (vector-normalize! front (meters 3))
          (vector+! at (-> door root trans) front)
          (+! (-> at y) (meters 1))
          (move-to-point! (-> *target* control) at)
          (+! (-> aim y) (meters 2))
          (smoke-wait 1.0)
          (smoke-face aim)
          (smoke-wait 3.0)
          (let ((door2 (the-as process-drawable (process-by-ename name))))
            (format 0 "SMOKE door ~S: Jak ~M from it, its state ~A~%" name
                    (vector-vector-xz-distance (-> *target* control trans) (-> door2 root trans))
                    (if door2 (-> door2 next-state name) 'gone))
            (and door2 (!= (-> door2 next-state name) 'open))
            )
          )
        )
      )
    )
  )

;; ----------------------------------------------------------------------------
;; Round 20: the minimap's marks, the drops' points
;; ----------------------------------------------------------------------------

(define-extern bf-city-unit-minimap (function process connection-minimap))
(define-extern bf-city-guard-speed (function float))
(define-extern bf-city-march-count (function int int))
(define-extern bf-ways-reach (function int int))
(define-extern bf-ways-dump (function none))
(define-extern bf-ways-islands (function none))
(define-extern bf-ways-pats (function int none))
(define-extern bf-city-test-counts (function none))
(define-extern bf-city-spawn-near (function int int int))
(define-extern *bf-test-counts* (pointer int32))
(define-extern bf-city-unit-report (function none))
(define-extern bf-city-send (function int int int int))
(define *smoke-sent* -1)
(define *smoke-zone0* 0)
(define *smoke-zone-max* 0)
(define-extern bf-ways-gap (function int int none))
(define-extern bf-ways-near (function vector float none))
(define-extern bf-ways-bridge-report (function none))
(define-extern *bf-drops-at* (pointer int32))

(define *smoke-marks* (new 'static 'array int32 3 0 0 0))

(defun smoke-minimap-marks ((tag string))
  "The units awake whose mark on the game's minimap has their side's class (25 the guard's blue one
   for the Freedom League, 139 the robot's red one for the Krimzon Guard), those that do not, and
   the battle points marked with the black disc. Returns the wrong ones."
  (dotimes (i 3)
    (set! (-> *smoke-marks* i) 0)
    )
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (!= p *target*) (>= (bf-unit-team p) 0))
        (let ((mm (bf-city-unit-minimap p)))
          (when mm
            (if (= (-> mm class) (-> *minimap-class-list* (if (= (bf-unit-team p) BF_TEAM_FF) 25 139)))
                (+! (-> *smoke-marks* 0) 1)
                (+! (-> *smoke-marks* 1) 1)
                )
            )
          )
        )
      #t
      )
    *null-kernel-context*
    )
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (if (and (-> pt icon) (or (= (-> pt icon class) *bf-point-minimap-class*) (= (-> pt icon class) *bf-base-minimap-class*)))
          (+! (-> *smoke-marks* 2) 1)
          )
      )
    )
  (format 0 "SMOKE marks ~S: ~D units in their side's color, ~D not, ~D of ~D points marked~%" tag
          (-> *smoke-marks* 0) (-> *smoke-marks* 1) (-> *smoke-marks* 2) (-> *bf* point-count))
  (-> *smoke-marks* 1)
  )

(defun smoke-default-mesh ((tag string))
  "Who holds the engine's default nav mesh's nav-controls: each battle kind, the others (the first
   three other types named)."
  (let ((m *default-nav-mesh*)
        (g 0)
        (tu 0)
        (ro 0)
        (sp 0)
        (o 0)
        )
    (format 0 "SMOKE default mesh ~S: ~D of ~D, others:" tag (-> m nav-control-count) (-> m max-nav-control-count))
    (dotimes (i (-> m nav-control-count))
      (let ((p (-> m nav-control-array i process)))
        (when p
          (case (-> p type symbol)
            (('crimson-guard) (+! g 1))
            (('flying-turret) (+! tu 1))
            (('roboguard-city) (+! ro 1))
            (('spydroid) (+! sp 1))
            (else
              (if (< o 3)
                  (format 0 " ~A" (-> p type symbol))
                  )
              (+! o 1)
              )
            )
          )
        )
      )
    (format 0 "; guards ~D turrets ~D robots ~D spiders ~D others ~D~%" g tu ro sp o)
    )
  0
  )

(defbehavior smoke-fps process ((tag string))
  "Frames the game draws in 10 s of wall time (pc-get-unix-timestamp), printed."
  (let ((t0 (pc-get-unix-timestamp))
        (n 0)
        )
    (while (= (pc-get-unix-timestamp) t0)
      (suspend)
      )
    (set! t0 (pc-get-unix-timestamp))
    (while (< (- (pc-get-unix-timestamp) t0) 10)
      (+! n 1)
      (suspend)
      )
    (format 0 "SMOKE fps ~S: ~D frames in 10 s (~D a second)~%" tag n (/ n 10))
    n
    )
  )

(defbehavior smoke-wait-wall process ((secs int))
  "Suspend for SECS seconds of wall time."
  (let ((t0 (pc-get-unix-timestamp)))
    (while (< (- (pc-get-unix-timestamp) t0) secs)
      (suspend)
      )
    )
  0
  )

(defun smoke-drops-line ((tag string))
  "Units each side's ships dropped at each point since the counts were cleared; returns how many
   points a side dropped at, the most of the two."
  (let ((most 0))
    (dotimes (team 2)
      (let ((n 0))
        (format 0 "SMOKE drops ~S ~S:" tag (bf-team-name team))
        (dotimes (i (-> *bf* point-count))
          (format 0 " p~D ~D" i (-> *bf-drops-at* (+ (* BF_POINT_MAX team) i)))
          (if (> (-> *bf-drops-at* (+ (* BF_POINT_MAX team) i)) 0)
              (+! n 1)
              )
          )
        (format 0 "~%")
        (set! most (max most n))
        )
      )
    most
    )
  )

(define-extern bf-city-unit-goal (function process int int))
(define-extern bf-marching? (function process symbol))
(define-extern bf-city-engaged? (function process symbol))

(define *smoke-handles* (new 'static 'array handle 96))
(define *smoke-handle-count* 0)

(define *smoke-want-a* 'none)
(define *smoke-want-b* 'none)

(defun smoke-collect ((a symbol) (b symbol))
  "Handles of the processes of type A or B in the active pool into `*smoke-handles*` (96 at most);
   returns their count. The walk's lambda is no closure: it reads A and B from globals."
  (set! *smoke-handle-count* 0)
  (set! *smoke-want-a* a)
  (set! *smoke-want-b* b)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (< *smoke-handle-count* 96) (or (= (-> p type symbol) *smoke-want-a*) (= (-> p type symbol) *smoke-want-b*)))
        (set! (-> *smoke-handles* *smoke-handle-count*) (process->handle p))
        (+! *smoke-handle-count* 1)
        )
      #t
      )
    *null-kernel-context*
    )
  *smoke-handle-count*
  )

(defun smoke-bots-line ((tag string))
  "Each awake robotguard and spider robot: its state, its goal point, how far it is from it, and
   whether it marches or fights (round 22's check that they head for their point)."
  (dotimes (i (smoke-collect 'roboguard-city 'spydroid))
    (let ((proc (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
      (when (and proc (>= (bf-unit-team proc) 0) (-> proc next-state) (!= (-> proc next-state name) 'inactive))
        (let* ((team (bf-unit-team proc))
               (goal (bf-city-unit-goal proc team))
               )
          (format 0 "SMOKE bots ~S: ~A ~A goal ~D at ~M" tag (-> proc type symbol)
                  (-> proc next-state name) goal
                  (if (>= goal 0) (vector-vector-xz-distance (-> proc root trans) (-> *bf* points goal pos)) -1.0)
                  )
          (format 0 " march ~A fight ~A~%" (bf-marching? proc) (bf-city-engaged? proc))
          )
        )
      )
    )
  0
  )

(defbehavior smoke-guard-pace process ((tag string))
  "The run clip's pace of the awake guards running their lanes ('active) against the player's guard
   running: each one's frames a game frame, over one frame, with its speed over the ground."
  (let ((n 0))
    (dotimes (i (smoke-collect 'crimson-guard 'crimson-guard))
      (let ((proc (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (when (and proc (< n 6) (-> proc next-state) (= (-> proc next-state name) 'active))
          (let ((f0 (-> proc skel root-channel 0 frame-num))
                (p0 (vector-copy! (new 'stack-no-clear 'vector) (-> proc root trans)))
                (h (-> *smoke-handles* i))
                )
            (suspend)
            (let ((q (the-as process-drawable (handle->process h))))
              (when q
                (format 0 "SMOKE pace ~S: AI guard clip ~S ~f frames a frame at ~M a second~%" tag
                        (-> q skel root-channel 0 frame-group name) (- (-> q skel root-channel 0 frame-num) f0)
                        (* 60.0 (vector-vector-xz-distance (-> q root trans) p0)))
                (+! n 1)
                )
              )
            )
          )
        )
      )
    )
  (smoke-stick 128 0 128 128)
  (smoke-wait 1.5)
  (dotimes (k 3)
    (let ((f0 (-> (smoke-av) skel root-channel 0 frame-num))
          (p0 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
          )
      (suspend)
      (format 0 "SMOKE pace ~S: player guard clip ~S ~f frames a frame at ~M a second~%" tag
              (-> (smoke-av) skel root-channel 0 frame-group name) (- (-> (smoke-av) skel root-channel 0 frame-num) f0)
              (* 60.0 (vector-vector-xz-distance (-> *target* control trans) p0)))
      )
    )
  (smoke-stick 128 128 128 128)
  0
  )

(defun smoke-point-foe-dist ((team int) (i int))
  "Distance from point I to the nearest foe of side TEAM: a unit (`*bf-unit-dots*`) or the player."
  (let ((near (meters 100000))
        (pos (-> *bf* points i pos))
        (dots *bf-unit-dots*)
        )
    (dotimes (d (-> dots count))
      (if (!= (-> dots team d) team)
          (set! near (fmin near (vector-vector-xz-distance (-> dots pos d) pos)))
          )
      )
    (if (and *target* (!= (-> *bf* team) team))
        (set! near (fmin near (vector-vector-xz-distance (-> *target* control trans) pos)))
        )
    near
    )
  )

(defun smoke-ship-point? ((team int) (i int))
  "#t when side TEAM holds point I with its ship over it: a point where its units come down."
  (and (= (-> *bf* points i owner) team) (handle->process (-> *bf* points i ship)))
  )

(define *smoke-drops-was* (new 'static 'array int32 20))
(define *smoke-front* (new 'static 'array int32 8)) ;; per side: drops with a choice, at the front, under attack, either

(defun smoke-front-tick ()
  "Every half second: each new unit come down since the last tick (`*bf-drops-at*`), counted by
   side (`*smoke-front*`): with another point of its side to come down at, at the point nearest a
   foe (the front), at a point a foe is within 60 m of."
  (dotimes (team 2)
    (dotimes (i (-> *bf* point-count))
      (let ((k (+ (* BF_POINT_MAX team) i)))
        (when (< (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
          (let ((n (- (-> *bf-drops-at* k) (-> *smoke-drops-was* k)))
                (others 0)
                (front? #t)
                (mine (smoke-point-foe-dist team i))
                )
            (dotimes (j (-> *bf* point-count))
              (when (and (!= j i) (smoke-ship-point? team j))
                (+! others 1)
                (if (< (smoke-point-foe-dist team j) mine)
                    (set! front? #f)
                    )
                )
              )
            (when (> others 0)
              (+! (-> *smoke-front* (* 4 team)) n)
              (if front?
                  (+! (-> *smoke-front* (+ (* 4 team) 1)) n)
                  )
              (if (< mine (meters 60))
                  (+! (-> *smoke-front* (+ (* 4 team) 2)) n)
                  )
              (if (or front? (< mine (meters 60)))
                  (+! (-> *smoke-front* (+ (* 4 team) 3)) n)
                  )
              )
            (format 0 "SMOKE drop side ~D at ~S: ~D, nearest foe ~M, front ~A, other points ~D~%" team (bf-point-name i) n mine front? others)
            )
          )
        (set! (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
        )
      )
    )
  0
  )

(defun smoke-kill-units ((team int) (sym symbol) (n int) (far symbol))
  "Kill N awake units of side TEAM of type SYM (`bf-send-attack`, 100 points); FAR: only ones over
   80 m from the side's base. Returns how many."
  (let ((done 0)
        (base -1)
        )
    (dotimes (i (-> *bf* point-count))
      (if (and (-> *bf* points i base?) (= (-> *bf* points i owner) team))
          (set! base i)
          )
      )
    (dotimes (i (smoke-collect sym sym))
      (let ((proc (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (when (and proc (< done n) (= (bf-unit-team proc) team)
                   (not (focus-test? (the-as process-focusable proc) dead inactive disable))
                   (-> proc next-state) (!= (-> proc next-state name) 'exit-transport)
                   (or (not far) (< base 0) (< (meters 80) (vector-vector-xz-distance (-> proc root trans) (-> *bf* points base pos))))
                   )
          (bf-send-attack proc 100.0)
          (+! done 1)
          )
        )
      )
    done
    )
  )

(defun smoke-awake-of ((team int) (kind int))
  "Units of side TEAM of kind KIND (`*bf-kinds*` index) awake now."
  (let ((n (new 'stack-no-clear 'array 'int32 4)))
    (bf-transport-team-count team n)
    (-> n kind)
    )
  )

(define *smoke-ammo-at* (new 'static 'vector))

(defun smoke-ammo-near ()
  "Ammo pickups within 4 m of `*smoke-ammo-at*`."
  (let ((n 0))
    (dotimes (i (smoke-collect 'ammo-collectable 'ammo-collectable))
      (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (if (and p (< (vector-vector-xz-distance (-> p root trans) *smoke-ammo-at*) (meters 4)))
            (+! n 1)
            )
        )
      )
    n
    )
  )

(define *smoke-top* (new 'static 'array float 4)) ;; per kind: the fastest ground speed seen

(defbehavior smoke-unit-speeds process ((secs float))
  "For SECS: twice a second, each awake unit's speed over one frame, the fastest of each kind into
   `*smoke-top*`."
  (let ((t0 (smoke-now)))
    (dotimes (k 4)
      (set! (-> *smoke-top* k) 0.0)
      )
    (while (< (- (smoke-now) t0) (the int (* 300.0 secs)))
      (dotimes (pair 2)
        (let ((n (if (zero? pair) (smoke-collect 'crimson-guard 'flying-turret) (smoke-collect 'roboguard-city 'spydroid)))
              (pos (new 'stack-no-clear 'inline-array 'vector 96))
              )
          (dotimes (i n)
            (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
              (if p
                  (vector-copy! (-> pos i) (-> p root trans))
                  )
              )
            )
          (suspend)
          (dotimes (i n)
            (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
              (when (and p (>= (bf-unit-team p) 0) (-> p next-state) (!= (-> p next-state name) 'inactive))
                (let ((k (bf-unit-kind p))
                      (v (* 60.0 (vector-vector-xz-distance (-> p root trans) (-> pos i))))
                      )
                  (if (and (>= k 0) (< v (meters 60)))
                      (set! (-> *smoke-top* k) (fmax (-> *smoke-top* k) v))
                      )
                  )
                )
              )
            )
          )
        )
      (smoke-wait 0.5)
      )
    0
    )
  )

(define *smoke-bot-h* (new 'static 'array handle 24))
(define *smoke-bot-g* (new 'static 'array int32 24))
(define *smoke-bot-d* (new 'static 'array float 24))
(define *smoke-bot-n* 0)

(defun smoke-bots-snap ()
  "Note each awake robotguard and spider robot over 30 m from its goal point, with no foe near,
   and its distance (`*smoke-bot-h*`, `*smoke-bot-d*`). Returns how many."
  (set! *smoke-bot-n* 0)
  (dotimes (i (smoke-collect 'roboguard-city 'spydroid))
    (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
      (when (and p (< *smoke-bot-n* 24) (>= (bf-unit-team p) 0) (-> p next-state) (!= (-> p next-state name) 'inactive)
                 (not (bf-city-engaged? p)))
        (let ((goal (bf-city-unit-goal p (bf-unit-team p))))
          (when (and (>= goal 0) (< (meters 30) (vector-vector-xz-distance (-> p root trans) (-> *bf* points goal pos))))
            (set! (-> *smoke-bot-h* *smoke-bot-n*) (-> *smoke-handles* i))
            (set! (-> *smoke-bot-g* *smoke-bot-n*) goal)
            (set! (-> *smoke-bot-d* *smoke-bot-n*) (vector-vector-xz-distance (-> p root trans) (-> *bf* points goal pos)))
            (+! *smoke-bot-n* 1)
            )
          )
        )
      )
    )
  *smoke-bot-n*
  )

(defun smoke-bots-closer ()
  "Of the units noted by `smoke-bots-snap` still awake with the same goal point: how many came 10 m
   closer to it or reached it (within 20 m), times 1000, plus how many they are."
  (let ((closer 0)
        (alive 0)
        )
    (dotimes (i *smoke-bot-n*)
      (let ((p (the-as process-drawable (handle->process (-> *smoke-bot-h* i)))))
        (when (and p (-> p next-state) (!= (-> p next-state name) 'inactive)
                   (= (bf-city-unit-goal p (bf-unit-team p)) (-> *smoke-bot-g* i)))
          (+! alive 1)
          (let* ((goal (-> *smoke-bot-g* i))
                 (d (vector-vector-xz-distance (-> p root trans) (-> *bf* points goal pos)))
                 )
            (format 0 "SMOKE bot ~A ~A: ~M from its point, ~M before~%" (-> p type symbol) (-> p next-state name) d (-> *smoke-bot-d* i))
            (if (or (< d (meters 20)) (< (+ d (meters 10)) (-> *smoke-bot-d* i)))
                (+! closer 1)
                )
            )
          )
        )
      )
    (+ (* closer 1000) alive)
    )
  )


(define-extern bf-city-unit-stock-stride (function process none))
(define-extern bf-city-unit-pace (function process none))

(defbehavior smoke-clip-pace process ((h handle) (old? symbol) (frames int))
  "Unit H's walk/run clip pace over FRAMES frames: its frames a game frame on average (the frames
   where the loop wrapped left out), with its speed over the ground. OLD?: its stride set back to
   the stock one before each frame (`bf-city-unit-stock-stride`). Printed; returns the pace."
  (let ((sum 0.0)
        (n 0)
        (dist 0.0)
        )
    (dotimes (f frames)
      (let ((p (the-as process-drawable (handle->process h))))
        (when p
          (if old?
              (bf-city-unit-stock-stride p)
              (bf-city-unit-pace p)
              )
          (let ((f0 (-> p skel root-channel 0 frame-num))
                (p0 (vector-copy! (new 'stack-no-clear 'vector) (-> p root trans)))
                )
            (suspend)
            (let ((q (the-as process-drawable (handle->process h))))
              (when q
                (let ((d (- (-> q skel root-channel 0 frame-num) f0)))
                  (when (< 0.0 d)
                    (+! sum d)
                    (+! n 1)
                    (+! dist (vector-vector-xz-distance (-> q root trans) p0))
                    )
                  )
                )
              )
            )
          )
        )
      )
    (let ((pace (if (> n 0) (/ sum (the float n)) 0.0)))
      (format 0 "SMOKE pace ~S stride: ~f clip frames a frame over ~D frames, at ~M a second~%" (if old? "stock" "round 22") pace n
              (if (> n 0) (/ (* 60.0 dist) (the float n)) 0.0))
      pace
      )
    )
  )

(define-extern *bf-burst-max* (pointer int32))

(define *smoke-crowd* (new 'static 'array int32 4)) ;; drops with a choice, at the crowd's point, at an attacked point, either

(defun smoke-crowd-tick ()
  "Every half second: each new unit come down since the last tick (`*bf-drops-at*`), counted by
   side: with another point of its side to come down at, at the point with the most units of both
   sides within 120 m (the crowd's), at a point a foe is within 60 m of (`*smoke-crowd*`)."
  (dotimes (team 2)
    (dotimes (i (-> *bf* point-count))
      (let ((k (+ (* BF_POINT_MAX team) i)))
        (when (< (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
          (let ((n (- (-> *bf-drops-at* k) (-> *smoke-drops-was* k)))
                (others 0)
                (top? #t)
                (mine 0)
                )
            (dotimes (d (-> *bf-unit-dots* count))
              (if (< (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points i pos)) (meters 120))
                  (+! mine 1)
                  )
              )
            (dotimes (j (-> *bf* point-count))
              (when (and (!= j i) (smoke-ship-point? team j))
                (+! others 1)
                (let ((theirs 0))
                  (dotimes (d (-> *bf-unit-dots* count))
                    (if (< (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points j pos)) (meters 120))
                        (+! theirs 1)
                        )
                    )
                  (if (< mine theirs)
                      (set! top? #f)
                      )
                  )
                )
              )
            (when (> others 0)
              (let ((attacked? (< (smoke-point-foe-dist team i) (meters 60))))
                (+! (-> *smoke-crowd* 0) n)
                (if top?
                    (+! (-> *smoke-crowd* 1) n)
                    )
                (if attacked?
                    (+! (-> *smoke-crowd* 2) n)
                    )
                (if (or top? attacked?)
                    (+! (-> *smoke-crowd* 3) n)
                    )
                )
              )
            (format 0 "SMOKE crowd drop side ~D at ~S: ~D, ~D units within 120 m, the largest crowd ~A~%" team (bf-point-name i) n mine top?)
            )
          )
        (set! (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
        )
      )
    )
  0
  )

(define *smoke-armor-bad* 0)
(define *smoke-armor-at* (new 'static 'vector))
(define *smoke-armor-seen?* #f)

(defun smoke-armor-scan ((tag string))
  "Each awake guard of the battle with neither armor segment shown: a set draw-control seg-mask bit
   hides its segment (Lisp wiki jak3 4.35), and guard.gc crimson-guard-method-267 shows the normal
   armor (segment 1) or the dark guard's (2), never both hidden: only its legs drawn (the author's
   image). Printed with its distance to Jak (the model past 20 m, lod2); counted in
   `*smoke-armor-bad*`; the camera turned onto the first one."
  (let ((n 0)
        (bad 0)
        )
    (dotimes (i (smoke-collect 'crimson-guard 'crimson-guard))
      (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (when (and p (-> p next-state) (!= (-> p next-state name) 'inactive) (nonzero? (-> p draw)))
          (+! n 1)
          (when (= (logand (-> p draw seg-mask) 6) 6)
            (+! bad 1)
            (format 0 "SMOKE armor ~S: ~S team ~D state ~A seg-mask #x~X at ~M~%" tag (bf-art-name p) (bf-unit-team p)
                    (-> p next-state name) (-> p draw seg-mask) (vector-vector-distance (-> p root trans) (-> *target* control trans)))
            (when (= bad 1)
              (vector-copy! *smoke-armor-at* (-> p root trans))
              (set! *smoke-armor-seen?* #t)
              )
            )
          )
        )
      )
    (+! *smoke-armor-bad* bad)
    (format 0 "SMOKE armor ~S: ~D guards awake, ~D with no armor drawn~%" tag n bad)
    )
  0
  )

(defun smoke-goal-spread ((team int))
  "Units of side TEAM marching or on their lanes, by goal point: printed; returns how many go for
   another point than the most wanted one, times 1000, plus how many have a goal."
  (let ((per (new 'stack-no-clear 'array 'int32 8))
        (all 0)
        (top 0)
        )
    (dotimes (k 8)
      (set! (-> per k) 0)
      )
    (dotimes (pair 2)
      (dotimes (i (if (zero? pair) (smoke-collect 'crimson-guard 'flying-turret) (smoke-collect 'roboguard-city 'spydroid)))
        (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
          (when (and p (= (bf-unit-team p) team) (-> p next-state) (!= (-> p next-state name) 'inactive) (not (bf-city-engaged? p)))
            (let ((g (bf-city-unit-goal p team)))
              (when (and (>= g 0) (< g 8))
                (+! (-> per g) 1)
                (+! all 1)
                )
              )
            )
          )
        )
      )
    (dotimes (k 8)
      (set! top (max top (-> per k)))
      )
    (format 0 "SMOKE goals side ~D: ~D ~D ~D" team (-> per 0) (-> per 1) (-> per 2))
    (format 0 " ~D ~D ~D (points 0 to 5)~%" (-> per 3) (-> per 4) (-> per 5))
    (+ (* 1000 (- all top)) all)
    )
  )

(defun smoke-ships-line ()
  "Each held point's ship: drawn or not (a ghost over a control point). Returns how many are wrong:
   a base's ship not drawn, or a control point's drawn, times 100, plus how many ghosts there are."
  (let ((wrong 0)
        (ghosts 0)
        )
    (dotimes (i (-> *bf* point-count))
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
        (when ship
          (let ((hidden? (logtest? (-> ship draw status) (draw-control-status no-draw))))
            (format 0 "SMOKE ship over ~S (base ~A): ~A~%" (bf-point-name i) (-> *bf* points i base?) (if hidden? "a ghost" "drawn"))
            (if (!= hidden? (not (-> *bf* points i base?)))
                (+! wrong 1)
                )
            (if hidden?
                (+! ghosts 1)
                )
            )
          )
        )
      )
    (+ (* 100 wrong) ghosts)
    )
  )

(defbehavior smoke-nearest-foe-unit process ((team int) (sym symbol))
  "The nearest awake unit of type SYM of side TEAM, standing (not asleep, at a ship's hatch, knocked
   down or dying), or #f."
  (let ((best (the-as process-drawable #f))
        (best-d 0.0)
        )
    (dotimes (i (smoke-collect sym sym))
      (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (when (and p (= (bf-unit-team p) team) (-> p next-state)
                   (let ((st (-> p next-state name)))
                     (not (or (= st 'inactive) (= st 'exit-transport) (= st 'knocked) (= st 'knocked-recover)
                              (= st 'die) (= st 'die-falling) (= st 'die-fast)
                              )
                          )
                     )
                   (not (focus-test? (the-as process-focusable p) dead inactive))
                   )
          (let ((d (vector-vector-xz-distance (-> p root trans) (-> *target* control trans))))
            (when (or (not best) (< d best-d))
              (set! best p)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defbehavior smoke-death-film process ((tag string) (clip string))
  "The player killed (`smoke-kill-player`), filmed 3.5 s (CLIP): the class model plays its own death
   while the camera stays on it (no unit spectated), and is gone after. Then the respawn page, X
   (his base), and back."
  (smoke-step tag)
  (smoke-neutral)
  (smoke-rec-start clip 2)
  (smoke-kill-player)
  (smoke-wait 1.0)
  (let ((dying? (and (smoke-av) (-> (smoke-av) dying?)))
        (spect? (if (handle->process (-> *bf* spectate)) #t #f))
        )
    (smoke-wait 2.5)
    (smoke-rec-stop)
    (smoke-wait 1.0)
    (format 0 "SMOKE ~S: dying 1 s after the death ~A, a unit spectated then ~A, the model gone at 4.5 s ~A~%" tag dying? spect?
            (not (bf-avatar-alive?)))
    (smoke-check "the class model plays its own death, watched, then goes" (and dying? (not spect?) (not (bf-avatar-alive?))))
    )
  (smoke-respawn-page 20.0)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)))))
  (smoke-wait 4.0)
  0
  )

(defbehavior smoke-headbutt-try process ()
  "One headbutt: Jak 2.5 m from the nearest standing Freedom League guard, the camera on it each
   frame until Square. Returns 1 when the guard took the shock (the electrocuted knock, the arcs)
   and died within 2 s, 0 when the headbutt missed, -1 for no guard."
  (let ((foe (smoke-nearest-foe-unit BF_TEAM_FF 'crimson-guard)))
    (cond
      ((not foe)
       -1
       )
      (else
        (let ((h (process->handle foe)))
          (dotimes (f 20)
            (let ((p (the-as process-drawable (handle->process h))))
              (when p
                (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> p root trans))))
                  (+! (-> at x) (meters 2.5))
                  (+! (-> at y) (meters 0.5))
                  (move-to-point! (-> *target* control) at)
                  (smoke-look-at (-> p root trans) 0.0)
                  )
                )
              )
            (suspend)
            )
          (smoke-tap (pad-buttons square) 4)
          (smoke-wait 0.3)
          (let* ((f (the-as enemy (handle->process h)))
                 (shocked? (and f (= (-> f incoming knocked-type) (knocked-type blue-shot))))
                 (zap? (and (smoke-av) (nonzero? (-> (smoke-av) zap-time))))
                 )
            (smoke-wait 2.0)
            (let ((dead? (or (not (handle->process h)) (focus-test? (the-as process-focusable (handle->process h)) dead inactive))))
              (format 0 "SMOKE headbutt: the guard shocked (blue-shot knock) ~A, arcs ~A, dead 2 s later ~A~%" shocked? zap? dead?)
              (if (and shocked? zap? dead?) 1 0)
              )
            )
          )
        )
      )
    )
  )

(defbehavior smoke-headbutt-check process ()
  "The spider's headbutt on Square (`smoke-headbutt-try`), filmed, on up to three guards: a guard on
   the move out of the lunge's reach is no failure of the headbutt."
  (smoke-step "spider headbutt")
  (smoke-wait 1.0)
  (smoke-rec-start "headbutt" 2)
  (let ((r 0)
        (tries 0)
        )
    (while (and (< r 1) (< tries 3))
      (set! r (smoke-headbutt-try))
      (+! tries 1)
      (if (< r 0)
          (set! tries 3)
          )
      (if (< r 1)
          (smoke-wait 1.5)
          )
      )
    (smoke-rec-stop)
    (format 0 "SMOKE headbutt: ~D tries~%" tries)
    (smoke-check "Square: the spider's headbutt shocks as the tazer (the electrocuted knock, arcs, the kill)" (= r 1))
    )
  0
  )

(define-extern bf-city-hidden-foes (function int))
(define-extern *bf-sight-count* (pointer int32))

(define *smoke-ahead* (new 'static 'array int32 4)) ;; control point drops, at the side's most advanced point, at an attacked point, either

(defun smoke-ahead-point ((team int))
  "Side TEAM's most advanced control point it holds: the nearest the other side's base. -1 for none."
  (let ((best -1)
        (best-d 0.0)
        (their (-> *bf* points (bf-other-team team) pos))
        )
    (dotimes (i (-> *bf* point-count))
      (let ((pt (-> *bf* points i)))
        (when (and (not (-> pt base?)) (= (-> pt owner) team))
          (let ((d (vector-vector-xz-distance (-> pt pos) their)))
            (when (or (< best 0) (< d best-d))
              (set! best i)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defun smoke-ahead-tick ()
  "Every half second: each new unit come down at a control point since the last tick
   (`*bf-drops-at*`), counted (`*smoke-ahead*`): at its side's most advanced point, at a point a foe
   is within 60 m of."
  (dotimes (team 2)
    (dotimes (i (-> *bf* point-count))
      (let ((k (+ (* BF_POINT_MAX team) i)))
        (when (< (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
          (let ((n (- (-> *bf-drops-at* k) (-> *smoke-drops-was* k))))
            (when (not (-> *bf* points i base?))
              (let ((ahead? (= i (smoke-ahead-point team)))
                    (attacked? (< (smoke-point-foe-dist team i) (meters 60)))
                    )
                (+! (-> *smoke-ahead* 0) n)
                (if ahead?
                    (+! (-> *smoke-ahead* 1) n)
                    )
                (if attacked?
                    (+! (-> *smoke-ahead* 2) n)
                    )
                (if (or ahead? attacked?)
                    (+! (-> *smoke-ahead* 3) n)
                    )
                (format 0 "SMOKE spawn side ~D at ~S: ~D, the most advanced ~A, attacked ~A~%" team (bf-point-name i) n ahead? attacked?)
                )
              )
            )
          )
        (set! (-> *smoke-drops-was* k) (-> *bf-drops-at* k))
        )
      )
    )
  0
  )


;; ----------------------------------------------------------------------------
;; Round 25: the units the control points bring down from the sky, the robotguards' roll
;; ----------------------------------------------------------------------------

(define-extern bf-city-roll-sample (function int))
(define-extern *bf-roll-sample* (pointer int32))

(deftype smoke-sky (structure)
  "Each unit of `*bf-sky-log*` followed for 8 s from its first sample: seen 3 m or more above its
   poly (a jetpack 10 m), seen in its fall's state ('jump for a guard, 'exit-transport for a
   robotguard or a spider; a jetpack 3 m lower than its highest), seen less than 4 m over its poly
   (the ground lies up to 1.4 m over a poly's middle, and the spider stands high on its legs); then counted by kind (0 guard, 1 jetpack, 2 robotguard, 3 spider) in TALLY: logged, high,
   in its fall, landed, killed before it landed (the test kills robotguards and spiders: dead, or
   asleep again in the traffic's pool)."
  ((seen    int32)
   (start   time-frame 64)
   (first-y float 64)
   (high?   symbol 64)
   (fall?   symbol 64)
   (landed? symbol 64)
   (gone?   symbol 64)
   (low     float 64)           ;; the lowest it was over its poly
   (tally   int32 20)
   (lowest  float 4)            ;; by kind, the sum of those lowest heights (their mean over the count logged)
   )
  )

(define *smoke-sky* (new 'static 'smoke-sky))

(defun smoke-sky-kind ((tt int))
  "Index of traffic type TT among the battle's kinds: 0 guard, 1 jetpack, 2 robotguard, 3 spider."
  (case tt
    ((6) 0)
    ((16) 1)
    ((14) 2)
    (else 3)
    )
  )

(defun smoke-sky-reset ()
  "Follow the units logged from now on."
  (let ((w *smoke-sky*))
    (set! (-> w seen) (-> *bf-sky-log* count))
    (dotimes (i 20)
      (set! (-> w tally i) 0)
      )
    (dotimes (i 4)
      (set! (-> w lowest i) 0.0)
      )
    (dotimes (i BF_SKY_LOG)
      (set! (-> w start i) 0)
      )
    )
  0
  )

(defun smoke-sky-tick ()
  "Every frame: take in the units newly logged, update those followed, count those 8 s old."
  (let ((w *smoke-sky*)
        (now (smoke-now))
        )
    ;; newly logged: followed from now
    (while (< (-> w seen) (-> *bf-sky-log* count))
      (let ((n (mod (-> w seen) BF_SKY_LOG)))
        (set! (-> w start n) now)
        (set! (-> w first-y n) -1.0)
        (set! (-> w high? n) #f)
        (set! (-> w fall? n) #f)
        (set! (-> w landed? n) #f)
        (set! (-> w gone? n) #f)
        (set! (-> w low n) (meters 100))
        )
      (+! (-> w seen) 1)
      )
    (dotimes (n BF_SKY_LOG)
      (when (nonzero? (-> w start n))
        (let ((p (the-as process-drawable (handle->process (-> *bf-sky-log* unit n))))
              (k (smoke-sky-kind (-> *bf-sky-log* kind n)))
              )
          (cond
            ((< (seconds 8) (- now (-> w start n)))
             ;; followed long enough: counted
             (+! (-> w tally (* 5 k)) 1)
             (if (-> w high? n) (+! (-> w tally (+ (* 5 k) 1)) 1))
             (if (-> w fall? n) (+! (-> w tally (+ (* 5 k) 2)) 1))
             (if (-> w landed? n) (+! (-> w tally (+ (* 5 k) 3)) 1))
             (if (and (-> w gone? n) (not (-> w landed? n))) (+! (-> w tally (+ (* 5 k) 4)) 1))
             (+! (-> w lowest k) (-> w low n))
             (set! (-> w start n) 0)
             )
            ;; killed (the test kills robotguards and spiders): gone, or back asleep in the pool
            ((or (not p)
                 (and (-> p next-state)
                      (let ((st (-> p next-state name)))
                        (or (= st 'inactive) (= st 'die) (= st 'explode) (= st 'die-falling))
                        )
                      )
                 )
             (set! (-> w gone? n) #t)
             )
            ((and p (type? p process-drawable))
             (let ((dy (- (-> p root trans y) (-> *bf-sky-log* ground n y)))
                   (st (if (-> p next-state) (-> p next-state name) 'none))
                   )
               (set! (-> w first-y n) (fmax (-> w first-y n) dy))
               (set! (-> w low n) (fmin (-> w low n) dy))
               (if (< (if (= k 1) (meters 10) (meters 3)) dy)
                   (set! (-> w high? n) #t)
                   )
               (if (case k
                     ((0) (= st 'jump))
                     ((1) (< dy (- (-> w first-y n) (meters 3))))
                     (else (= st 'exit-transport))
                     )
                   (set! (-> w fall? n) #t)
                   )
               (if (and (!= k 1) (< dy (meters 4)))
                   (set! (-> w landed? n) #t)
                   )
               )
             )
            )
          )
        )
      )
    )
  0
  )

(defun smoke-sky-line ()
  "The tally, kind by kind."
  (let ((t (-> *smoke-sky* tally)))
    (format 0 "SMOKE sky drops (logged, high, falling, landed, killed before): guards ~D ~D ~D ~D ~D, " (-> t 0) (-> t 1) (-> t 2) (-> t 3) (-> t 4))
    (format 0 "jetpacks ~D ~D ~D, " (-> t 5) (-> t 6) (-> t 7))
    (format 0 "robotguards ~D ~D ~D ~D ~D, " (-> t 10) (-> t 11) (-> t 12) (-> t 13) (-> t 14))
    (format 0 "spiders ~D ~D ~D ~D ~D~%" (-> t 15) (-> t 16) (-> t 17) (-> t 18) (-> t 19))
    (format 0 "SMOKE sky drops, the lowest over their poly on average: guards ~M, robotguards ~M, spiders ~M~%"
            (/ (-> *smoke-sky* lowest 0) (the float (max 1 (-> t 0))))
            (/ (-> *smoke-sky* lowest 2) (the float (max 1 (-> t 10))))
            (/ (-> *smoke-sky* lowest 3) (the float (max 1 (-> t 15)))))
    )
  0
  )

(defun smoke-last-drop-point ((krimzon? symbol))
  "The battle point nearest the last unit brought down from the sky (a robotguard's or a spider's,
   the Krimzon Guard's own kinds, with KRIMZON?); -1 for none."
  (let ((best -1)
        (n -1)
        )
    (dotimes (k BF_SKY_LOG)
      (let ((i (mod (- (-> *bf-sky-log* count) 1 k) BF_SKY_LOG)))
        (when (and (< n 0) (< k (-> *bf-sky-log* count))
                   (or (not krimzon?) (= (-> *bf-sky-log* kind i) 14) (= (-> *bf-sky-log* kind i) 15))
                   )
          (set! n i)
          )
        )
      )
    (when (>= n 0)
      (let ((d (meters 100000)))
        (dotimes (i (-> *bf* point-count))
          (let ((di (vector-vector-xz-distance (-> *bf* points i pos) (-> *bf-sky-log* ground n))))
            (when (< di d)
              (set! d di)
              (set! best i)
              )
            )
          )
        )
      )
    best
    )
  )

(defbehavior smoke-film-drop process ((pt int) (kind int) (clip string))
  "From where the scenery hides nothing over point PT (`smoke-film-point`), the next unit brought
   down from the sky within 50 m of it (traffic type KIND, -1 for any; 40 s at most, two Krimzon
   Guard robotguards and spiders killed every 10 s meanwhile for the side to lack some), filmed
   (CLIP) 4 s from its first frame, the camera following it. #t when one came."
  (smoke-film-point pt)
  (let ((t0 (smoke-now))
        (seen (-> *bf-sky-log* count))
        (got -1)
        )
    (while (and (< got 0) (< (- (smoke-now) t0) (seconds 40)))
      (smoke-sky-tick)
      (when (zero? (mod (- (smoke-now) t0) (seconds 10)))
        (smoke-kill-units BF_TEAM_KG 'roboguard-city 2 #t)
        (smoke-kill-units BF_TEAM_KG 'spydroid 2 #t)
        )
      (while (and (< got 0) (< seen (-> *bf-sky-log* count)))
        (let ((n (mod seen BF_SKY_LOG)))
          (if (and (or (< kind 0) (= kind (-> *bf-sky-log* kind n)))
                   (< (vector-vector-xz-distance (-> *bf-sky-log* ground n) (-> *bf* points pt pos)) (meters 50))
                   )
              (set! got n)
              )
          )
        (+! seen 1)
        )
      (suspend)
      )
    (format 0 "SMOKE film ~S: a drop ~A after ~D s~%" clip (>= got 0) (/ (- (smoke-now) t0) 300))
    (when (>= got 0)
      (smoke-rec-start clip 3)
      (dotimes (f 240)
        (smoke-sky-tick)
        (let ((u (the-as process-drawable (handle->process (-> *bf-sky-log* unit got)))))
          (if u
              (smoke-look-at (-> u root trans) 0.0)
              )
          )
        (suspend)
        )
      (smoke-rec-stop)
      )
    (>= got 0)
    )
  )

(defbehavior smoke-top-speed process ((secs float))
  "The highest speed of Jak across the ground (units a second) over SECS."
  (let ((t0 (smoke-now))
        (top 0.0)
        )
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (let ((v (-> *target* control transv)))
        (set! top (fmax top (sqrtf (+ (* (-> v x) (-> v x)) (* (-> v z) (-> v z))))))
        )
      (suspend)
      )
    top
    )
  )

(defconstant SMOKE_FALL_MAX 64)

(deftype smoke-fall (structure)
  "Each robotguard or spider seen falling (exit-transport): its handle, when first seen, its height
   then, when it had fallen 1 m (0 not yet); and the units seen over their nav poly in the air."
  ((unit   handle     SMOKE_FALL_MAX)
   (t0     time-frame SMOKE_FALL_MAX)
   (y0     float      SMOKE_FALL_MAX)
   (fell   time-frame SMOKE_FALL_MAX)
   (count  int32)
   (air    handle     SMOKE_FALL_MAX)
   (air-n  int32      SMOKE_FALL_MAX)
   (air-count int32)
   )
  )

(define *smoke-fall* (new 'static 'smoke-fall))

(defun smoke-fall-tick ()
  "Every frame: each robotguard or spider falling (exit-transport) watched from its first frame (how
   long before it has fallen 1 m); each one walking (any other state) more than 2.5 m over its nav
   poly's middle counted a frame in the air."
  (let ((f *smoke-fall*))
    (dotimes (i (smoke-collect 'spydroid 'roboguard-city))
      (let ((p (the-as nav-enemy (handle->process (-> *smoke-handles* i)))))
        (when (and p (>= (bf-unit-team p) 0) (-> p next-state))
          (cond
            ((= (-> p next-state name) 'exit-transport)
             (let ((slot -1))
               (dotimes (k (-> f count))
                 (if (= (-> f unit k) (process->handle p))
                     (set! slot k)
                     )
                 )
               (when (and (< slot 0) (< (-> f count) SMOKE_FALL_MAX))
                 (set! slot (-> f count))
                 (set! (-> f unit slot) (process->handle p))
                 (set! (-> f t0 slot) (smoke-now))
                 (set! (-> f y0 slot) (-> p root trans y))
                 (set! (-> f fell slot) 0)
                 (+! (-> f count) 1)
                 (format 0 "SMOKE fall start ~A ~D at ~M ~M ~M collide-with ~X~%" (-> p type symbol) (-> p pid)
                         (-> p root trans x) (-> p root trans y) (-> p root trans z)
                         (-> (the-as collide-shape (-> p root)) root-prim prim-core collide-with))
                 )
               (if (and (>= slot 0) (zero? (-> f fell slot)) (< (-> p root trans y) (- (-> f y0 slot) (meters 1))))
                   (set! (-> f fell slot) (smoke-now))
                   )
               ;; slow to fall: how it stands, every second
               (when (and (>= slot 0) (zero? (-> f fell slot)) (< (seconds 1) (- (smoke-now) (-> f t0 slot)))
                          (zero? (mod (- (smoke-now) (-> f t0 slot)) 300))
                          )
                 (format 0 "SMOKE stuck ~A ~D y ~M vy ~M collide-with ~X status ~X" (-> p type symbol) (-> p pid)
                         (-> p root trans y) (-> p root transv y)
                         (-> (the-as collide-shape (-> p root)) root-prim prim-core collide-with) (-> p root status))
                 (format 0 " pause ~A clock ~D draw ~X~%" (logtest? (-> p mask) (process-mask actor-pause))
                         (-> p clock frame-counter) (-> p draw status))
                 )
               )
             )
            ((and (= (-> p type symbol) 'spydroid) (nonzero? (-> p nav)) (-> p nav state mesh) (-> p nav state current-poly))
             ;; over the poly's highest corner (a stair poly's middle lies meters under its top end);
             ;; the spiders only: a robotguard's ball rolls over the curbs and crates
             (let ((top (+ (-> p nav state current-poly max-y) (-> p nav state mesh bounds y))))
               (when (< (meters 2.5) (- (-> p root trans y) top))
                 (let ((slot -1))
                   (dotimes (k (-> f air-count))
                     (if (= (-> f air k) (process->handle p))
                         (set! slot k)
                         )
                     )
                   (when (and (< slot 0) (< (-> f air-count) SMOKE_FALL_MAX))
                     (set! slot (-> f air-count))
                     (set! (-> f air slot) (process->handle p))
                     (set! (-> f air-n slot) 0)
                     (+! (-> f air-count) 1)
                     )
                   (when (>= slot 0)
                     (+! (-> f air-n slot) 1)
                     (if (= (-> f air-n slot) 30)
                         (format 0 "SMOKE air ~A ~D ~A over its poly's top ~M" (-> p type symbol) (-> p pid)
                                 (-> p next-state name) (- (-> p root trans y) top))
                         )
                     (if (= (-> f air-n slot) 30)
                         (format 0 " at ~M ~M ~M~%" (-> p root trans x) (-> p root trans y) (-> p root trans z))
                         )
                     )
                   )
                 )
               )
             )
            )
          )
        )
      )
    )
  0
  )

(defun smoke-fall-report ()
  "The fall watch's results: how many fell, the slowest to start falling, how many walked in the air
   half a second or more. Returns #t when every one fell within 0.5 s and none walked in the air."
  (let ((f *smoke-fall*)
        (slow 0)
        (worst 0)
        (air 0)
        )
    (dotimes (k (-> f count))
      ;; one still falling at the report, seen less than 0.5 s ago, is not judged
      (let ((d (if (zero? (-> f fell k)) (- (smoke-now) (-> f t0 k)) (- (-> f fell k) (-> f t0 k))))
            (p (the-as process-drawable (handle->process (-> f unit k))))
            )
        (if (< worst d)
            (set! worst d)
            )
        (when (< (seconds 0.5) d)
          (+! slow 1)
          (format 0 "SMOKE slow fall: ~A from ~M high, ~D ms" (if p (-> p type symbol) 'gone) (-> f y0 k) (/ (* d 1000) 300))
          (if p
              (format 0 " now ~A at ~M ~M ~M" (-> p next-state name) (-> p root trans x) (-> p root trans y) (-> p root trans z))
              )
          (format 0 "~%")
          )
        )
      )
    (dotimes (k (-> f air-count))
      (if (<= 30 (-> f air-n k))
          (+! air 1)
          )
      )
    (format 0 "SMOKE falls: ~D watched, ~D slow to fall (> 0.5 s), the slowest ~D ms; ~D in the air 0.5 s or more (~D seen over 2.5 m)~%"
            (-> f count) slow (/ (* worst 1000) 300) air (-> f air-count))
    (and (< 0 (-> f count)) (zero? slow) (zero? air))
    )
  )

(defun smoke-facing-aim ()
  "How well the class model faces its aim across: the dot of its heading with the way to the aim
   point, 1 straight at it."
  (let ((av (smoke-av)))
    (if (not av)
        -2.0
        (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> av root quat)))
              (dir (vector-! (new 'stack-no-clear 'vector) (-> av aim) (-> av root trans)))
              )
          (set! (-> fwd y) 0.0)
          (set! (-> dir y) 0.0)
          (vector-normalize! fwd 1.0)
          (vector-normalize! dir 1.0)
          (vector-dot fwd dir)
          )
        )
    )
  )

(defbehavior smoke-r26-weapons process ()
  "Round 26, a guard: the grenade launcher throws as the stock grenade guard does, the player still
   with the left stick pushed, facing the crosshair, on the whole body's grenade clip, one grenade
   spent; the rifle fires on the run; the tazer's stab holds the player still."
  (smoke-step "grenade throw")
  (smoke-neutral)
  (smoke-press (pad-buttons up) 1.0)
  (set! (-> (smoke-av) grenade-time) 0)
  (let ((red (-> *game-info* gun-ammo BF_AMMO_RED))
        (p0 (new 'stack-no-clear 'vector))
        )
    (smoke-stick 128 0 128 128)
    (smoke-wait 1.0)
    (smoke-tap (pad-buttons r1) 4)
    (smoke-wait 0.25)
    (let ((step (-> (smoke-av) throw-step))
          (clip (-> (smoke-av) anim))
          )
      (vector-copy! p0 (-> *target* control trans))
      (smoke-wait 0.5)
      (let ((moved (vector-vector-xz-distance p0 (-> *target* control trans)))
            (face (smoke-facing-aim))
            )
        (smoke-shot "r26-grenade-throw")
        (format 0 "SMOKE throw: step ~D clip ~D (grenade ~D) moved ~M in 0.5 s with the stick pushed, facing ~f~%"
                step clip BF_CLIP_GRENADE moved face)
        (smoke-check "the grenade throw plays the whole body's grenade clip, the player still, facing the crosshair"
                     (and (> step 0) (= clip BF_CLIP_GRENADE) (< moved (meters 0.3)) (< 0.97 face))
                     )
        )
      )
    (smoke-wait 1.5)
    (smoke-neutral)
    (format 0 "SMOKE throw: red ammo ~f, was ~f; step now ~D~%" (-> *game-info* gun-ammo BF_AMMO_RED) red (-> (smoke-av) throw-step))
    (smoke-check "one grenade thrown, the throw over" (and (= (-> *game-info* gun-ammo BF_AMMO_RED) (+ red -1.0)) (zero? (-> (smoke-av) throw-step))))
    )
  (smoke-step "rifle on the run")
  (smoke-press (pad-buttons down) 1.0)
  (let ((p0 (new 'stack-no-clear 'vector))
        (shots (-> *bf* mag BF_WEAPON_RIFLE))
        )
    (smoke-stick 128 0 128 128)
    (smoke-wait 0.8)
    (vector-copy! p0 (-> *target* control trans))
    (smoke-hold (pad-buttons r1))
    (smoke-wait 1.2)
    (smoke-hold (the-as pad-buttons 0))
    (let ((moved (vector-vector-xz-distance p0 (-> *target* control trans))))
      (smoke-neutral)
      (format 0 "SMOKE rifle on the run: ~M in 1.2 s firing, magazine ~D then ~D~%" moved shots (-> *bf* mag BF_WEAPON_RIFLE))
      (smoke-check "the rifle fires on the run" (and (< (meters 3) moved) (< (-> *bf* mag BF_WEAPON_RIFLE) shots)))
      )
    )
  (smoke-step "tazer still")
  (smoke-press (pad-buttons left) 1.0)
  (set! (-> *bf* tazer-time) 0)
  (let ((p0 (new 'stack-no-clear 'vector)))
    (smoke-stick 128 0 128 128)
    (smoke-wait 0.8)
    (smoke-tap (pad-buttons r1) 4)
    (smoke-wait 0.2)
    (vector-copy! p0 (-> *target* control trans))
    (smoke-wait 0.4)
    (let ((moved (vector-vector-xz-distance p0 (-> *target* control trans))))
      (format 0 "SMOKE tazer stab: ~M in 0.4 s with the stick pushed~%" moved)
      (smoke-check "the tazer's stab holds the player still" (< moved (meters 0.3)))
      )
    )
  (smoke-wait 1.5)
  (smoke-neutral)
  (smoke-press (pad-buttons down) 1.0)
  0
  )

(defbehavior smoke-r26-pause process ()
  "Round 26, START during a fight: the battle's page, its last entry Options; the war music on;
   Redeploy open in combat, costing a unit, straight to the respawn page."
  (smoke-step "pause page")
  (smoke-neutral)
  (format 0 "SMOKE music ~A~%" (-> *setting-control* user-current music))
  (smoke-check "the city's war music plays" (= (-> *setting-control* user-current music) 'portattk))
  ;; in combat: a shot just fired
  (smoke-hold (pad-buttons r1))
  (smoke-wait 0.6)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-wait 0.5)
  (smoke-start-page 'main)
  (smoke-wait-for 5.0 (lambda () (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE))))
  (smoke-shot "r26-pause-page")
  (format 0 "SMOKE pause: entry 6 ~S, entry 3 ~S open ~A, free ~A~%" (bf-pause-label 6) (bf-pause-label 3) (bf-pause-ok? 3) (bf-out-of-combat?))
  (smoke-check "START: the battle's page, its last entry Options" (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE) (string= (bf-pause-label 6) "Options")))
  (smoke-check "Redeploy open in combat, not free" (and (bf-pause-ok? 3) (not (bf-out-of-combat?))))
  (let ((lost (-> *bf* deaths))
        (units (-> *bf* reserve (-> *bf* team)))
        )
    (set! (-> (smoke-dir) cursor) 3)
    (smoke-wait 0.5)
    (smoke-press (pad-buttons x) 2.0)
    (smoke-respawn-page 10.0)
    (format 0 "SMOKE hot redeploy: respawn page ~A, deaths ~D (were ~D), reserve ~D (was ~D)~%" (>= (-> *bf* respawn-pick) 0)
            (-> *bf* deaths) lost (-> *bf* reserve (-> *bf* team)) units)
    (smoke-check "Redeploy in combat: the respawn page at once, a unit lost"
                 (and (>= (-> *bf* respawn-pick) 0) (= (-> *bf* deaths) (+ lost 1)) (< (-> *bf* reserve (-> *bf* team)) units))
                 )
    (smoke-pick-point (-> *bf* respawn-pick))
    (smoke-wait-for 50.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0) (not (-> *bf* dropping?)))))
    (smoke-wait 2.0)
    )
  0
  )

;; ----------------------------------------------------------------------------
;; Round 27: Triangle reloads, the jetpack guards' height, the posts, the goals, eight control points
;; ----------------------------------------------------------------------------

(defbehavior smoke-r27-reload process ()
  "Round 27: a few rifle shots, then Triangle: the magazine full again, only the rounds spent taken
   from the reserve; Triangle with a full magazine does nothing."
  (smoke-step "triangle reload")
  (smoke-neutral)
  (smoke-ammo-line "deployed")
  (dotimes (i 3)
    (smoke-press (pad-buttons r1) 0.6)
    )
  (smoke-wait 1.0)
  (smoke-ammo-line "three shots")
  (let ((mag (-> *bf* mag BF_WEAPON_RIFLE))
        (reserve (-> *game-info* gun-ammo BF_AMMO_YELLOW))
        )
    (smoke-press (pad-buttons triangle) 0.8)
    (smoke-shot "r27-reload")
    (smoke-wait 3.5)
    (smoke-ammo-line "after Triangle")
    (smoke-check "Triangle reloads the rifle: the magazine full, the rounds spent taken from the reserve"
                 (and (< mag BF_MAG_RIFLE)
                      (= (-> *bf* mag BF_WEAPON_RIFLE) BF_MAG_RIFLE)
                      (= (-> *game-info* gun-ammo BF_AMMO_YELLOW) (- reserve (the float (- BF_MAG_RIFLE mag))))
                      )
                 )
    )
  (let ((reserve (-> *game-info* gun-ammo BF_AMMO_YELLOW)))
    (smoke-press (pad-buttons triangle) 1.0)
    (format 0 "SMOKE full magazine, Triangle: top-step ~D reload ~A~%" (-> (smoke-av) top-step) (-> (smoke-av) reload?))
    (smoke-check "Triangle with a full magazine does nothing"
                 (and (= (-> *bf* mag BF_WEAPON_RIFLE) BF_MAG_RIFLE)
                      (= (-> *game-info* gun-ammo BF_AMMO_YELLOW) reserve)
                      (zero? (-> (smoke-av) top-step))
                      )
                 )
    )
  0
  )

(deftype smoke-r27-stats (structure)
  ((jet-max    float)
   (jet-over   int32)
   (jet-n      int32)
   (idle-max   int32)
   (idle-pt    int32)
   (post-max   int32)
   (samples    int32)
   (kinds      int32)          ;; goals told apart, both sides, summed over the samples
   (goals      int32 10)       ;; units with each point as their goal, summed over the samples
   )
  )

(define *smoke-r27* (new 'static 'smoke-r27-stats))
(define *smoke-r27-idle* (new 'static 'array int32 20))
(define *smoke-r27-post* (new 'static 'array int32 20))
(define *smoke-r27-bits* (new 'static 'array int32 2))
(define *smoke-r27-tag* (new 'global 'string 32 (the-as string #f)))

(defun smoke-r27-sample ((tag string))
  "One look at every unit of the battle awake: a jetpack guard's height over its nav poly's middle;
   its goal (`bf-city-unit-goal`); the units standing (no march, no fight) within 20 m of a point
   their side holds (the stack), and the posted ones, by side and point. Keeps the worst in
   `*smoke-r27*` and prints this look's."
  (let ((st *smoke-r27*))
    (dotimes (k 20)
      (set! (-> *smoke-r27-idle* k) 0)
      (set! (-> *smoke-r27-post* k) 0)
      )
    (set! (-> *smoke-r27-bits* 0) 0)
    (set! (-> *smoke-r27-bits* 1) 0)
    (iterate-process-tree
      *active-pool*
      (lambda ((p process))
        (when (and (type? p nav-enemy) (>= (bf-unit-team p) 0) (-> p next-state) (!= (-> p next-state name) 'inactive))
          (let* ((u (the-as nav-enemy p))
                 (st *smoke-r27*)
                 (team (bf-unit-team p))
                 (goal (bf-city-unit-goal p team))
                 (post (bf-post-point p))
                 )
            (when (and (= (-> p type symbol) 'flying-turret) (nonzero? (-> u nav)) (-> u nav state mesh) (-> u nav state current-poly))
              (let ((h (- (-> u root trans y) (-> (poly-centroid (-> u nav state mesh) (-> u nav state current-poly) (new 'stack-no-clear 'vector)) y))))
                (+! (-> st jet-n) 1)
                (if (< (-> st jet-max) h)
                    (set! (-> st jet-max) h)
                    )
                (when (< (+ BF_HOVER_CEILING (meters 0.5)) h)
                  (+! (-> st jet-over) 1)
                  (format 0 "SMOKE jetpack ~D ~A ~M over its poly at ~M ~M ~M~%" (-> p pid) (-> p next-state name) h
                          (-> u root trans x) (-> u root trans y) (-> u root trans z))
                  )
                )
              )
            (when (>= goal 0)
              (+! (-> st goals goal) 1)
              (logior! (-> *smoke-r27-bits* team) (ash 1 goal))
              )
            (dotimes (i (-> *bf* point-count))
              (if (and (= (-> *bf* points i owner) team)
                       (< (vector-vector-xz-distance (-> u root trans) (-> *bf* points i pos)) (meters 20))
                       (not (bf-marching? p))
                       (not (bf-city-engaged? p))
                       )
                  (+! (-> *smoke-r27-idle* (+ (* BF_POINT_MAX team) i)) 1)
                  )
              )
            (if (>= post 0)
                (+! (-> *smoke-r27-post* (+ (* BF_POINT_MAX team) post)) 1)
                )
            )
          )
        #t
        )
      *null-kernel-context*
      )
    (+! (-> st samples) 1)
    (dotimes (team 2)
      (dotimes (i 10)
        (if (logtest? (-> *smoke-r27-bits* team) (ash 1 i))
            (+! (-> st kinds) 1)
            )
        )
      )
    (format 0 "SMOKE r27 ~S: goals FF #x~X KG #x~X; standing at held points:" tag (-> *smoke-r27-bits* 0) (-> *smoke-r27-bits* 1))
    (dotimes (k 20)
      (when (> (-> *smoke-r27-idle* k) 0)
        (format 0 " ~D/~D ~D" (/ k BF_POINT_MAX) (mod k BF_POINT_MAX) (-> *smoke-r27-idle* k))
        )
      (when (< (-> st idle-max) (-> *smoke-r27-idle* k))
        (set! (-> st idle-max) (-> *smoke-r27-idle* k))
        (set! (-> st idle-pt) k)
        )
      (if (< (-> st post-max) (-> *smoke-r27-post* k))
          (set! (-> st post-max) (-> *smoke-r27-post* k))
          )
      )
    (format 0 "; posted:")
    (dotimes (k 20)
      (if (> (-> *smoke-r27-post* k) 0)
          (format 0 " ~D/~D ~D" (/ k BF_POINT_MAX) (mod k BF_POINT_MAX) (-> *smoke-r27-post* k))
          )
      )
    (format 0 "~%")
    ;; a stack: who holds it there, the other side's units within 60 m of the point
    (dotimes (k 20)
      (when (>= (-> *smoke-r27-idle* k) 6)
        (set! *smoke-point* (mod k BF_POINT_MAX))
        (iterate-process-tree
          *active-pool*
          (lambda ((p process))
            (when (and (type? p nav-enemy) (>= (bf-unit-team p) 0) (-> p next-state)
                       (!= (bf-unit-team p) (-> *bf* points *smoke-point* owner))
                       (< (vector-vector-xz-distance (-> (the-as nav-enemy p) root trans) (-> *bf* points *smoke-point* pos)) (meters 60))
                       )
              (format 0 "SMOKE r27 foe at point ~D: ~A ~D ~A ~M away, ~M up~%" *smoke-point* (-> p type symbol) (-> p pid)
                      (-> p next-state name)
                      (vector-vector-xz-distance (-> (the-as nav-enemy p) root trans) (-> *bf* points *smoke-point* pos))
                      (- (-> (the-as nav-enemy p) root trans y) (-> *bf* points *smoke-point* pos y)))
              )
            #t
            )
          *null-kernel-context*
          )
        )
      )
    )
  0
  )

(defbehavior smoke-r27-visit process ((i int))
  "Control point I given to the player's side, then a death and a respawn there (its continue
   point, its section loaded): the point live, on open ground, a nav mesh within 2 m (the units'
   march to it), ways to it from the meshes around; a shot of the minimap there."
  (smoke-step (bf-point-name i))
  (set! (-> *bf* points i owner) (-> *bf* team))
  (smoke-wait 1.0)
  (smoke-invulnerable #f)
  (smoke-kill-player)
  (smoke-respawn-page 12.0)
  (smoke-pick-point i)
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0) (not (-> *bf* dropping?)))))
  (smoke-invulnerable #t)
  (set! *smoke-point* i)
  (smoke-wait-for 30.0 (lambda () (-> *bf* points *smoke-point* snapped?)))
  (smoke-wait 11.0)
  (let ((pt (-> *bf* points i)))
    (format 0 "SMOKE point ~D ~S (~S): Jak ~M from it, live ~A, snapped ~A" i (bf-point-name i) (bf-point-letter i)
            (vector-vector-xz-distance (-> *target* control trans) (-> pt pos)) (bf-point-live? pt) (-> pt snapped?))
    (format 0 " at ~M ~M ~M, mesh within 2 m ~A" (-> pt pos x) (-> pt pos y) (-> pt pos z)
            (if (find-nearest-nav-mesh (-> pt pos) (meters 2)) #t #f))
    (format 0 ", meshes with a way ~D of ~D~%" (bf-ways-reach i) (bf-ways-reach -1))
    (format 0 "SMOKE minimap mark of ~D drawn ~A at ~f ~f~%" i
            (>= (-> *bf-icon-spots* frame i) (+ (-> *display* base-clock integral-frame-counter) -2))
            (-> *bf-icon-spots* x i) (-> *bf-icon-spots* y i))
    ;; the respawn drops the player from the sky onto a nav poly within 90 m of the point (round 25)
    (smoke-check "the point: a respawn there, live, a nav mesh within 2 m, ways to it"
                 (and (< (vector-vector-xz-distance (-> *target* control trans) (-> pt pos)) (meters 90))
                      (bf-point-live? pt)
                      (find-nearest-nav-mesh (-> pt pos) (meters 2))
                      (> (bf-ways-reach i) 0)
                      )
                 )
    (smoke-check "its red minimap mark drawn, its letter over it"
                 (and (-> pt icon) (= (-> pt icon class) *bf-point-minimap-class*)
                      (>= (-> *bf-icon-spots* frame i) (+ (-> *display* base-clock integral-frame-counter) -2))
                      )
                 )
    )
  (format (clear *smoke-r27-tag*) "r27-minimap-~D" i)
  (smoke-shot *smoke-r27-tag*)
  (smoke-wait 1.0)
  0
  )

(defbehavior smoke-r27-battle process ()
  "Round 27: 6 minutes of battle, the player at his base, every unit looked at every 10 s
   (`smoke-r27-sample`): the jetpack guards' height, the units standing at their side's points, the
   posts, the goals spread; the checks."
  (smoke-step "battle")
  (let ((st *smoke-r27*)
        (t0 (smoke-now))
        (next (smoke-now))
        )
    (set! (-> st jet-max) 0.0)
    (set! (-> st jet-over) 0)
    (set! (-> st jet-n) 0)
    (set! (-> st idle-max) 0)
    (set! (-> st post-max) 0)
    (set! (-> st samples) 0)
    (set! (-> st kinds) 0)
    (dotimes (i 10)
      (set! (-> st goals i) 0)
      )
    (while (< (- (smoke-now) t0) (seconds 360))
      (when (< next (smoke-now))
        (set! next (+ (smoke-now) (seconds 10)))
        (format (clear *smoke-r27-tag*) "~D s" (/ (- (smoke-now) t0) 300))
        (smoke-r27-sample *smoke-r27-tag*)
        (smoke-points-line *smoke-r27-tag*)
        )
      (suspend)
      )
    (format 0 "SMOKE r27 jetpacks: ~D looks, highest ~M over its poly, ~D over the ceiling~%" (-> st jet-n) (-> st jet-max) (-> st jet-over))
    (let ((side (/ (-> st idle-pt) BF_POINT_MAX))
          (pt (mod (-> st idle-pt) BF_POINT_MAX))
          )
      (format 0 "SMOKE r27 stack: most units standing at one held point ~D (side/point ~D/~D), most posted ~D~%"
              (-> st idle-max) side pt (-> st post-max))
      )
    (format 0 "SMOKE r27 goals per side and look ~f; units by goal:" (/ (the float (-> st kinds)) (the float (* 2 (-> st samples)))))
    (dotimes (i 10)
      (format 0 " ~D:~D" i (-> st goals i))
      )
    (format 0 "~%")
    (smoke-check "the jetpack guards fly no higher than a ship over the street (15 m over their poly)"
                 (and (> (-> st jet-n) 0) (zero? (-> st jet-over))))
    (smoke-check "at most 3 units posted on one point" (<= (-> st post-max) 3))
    (smoke-check "no stack: at most 6 units of one side standing at one of its points" (<= (-> st idle-max) 6))
    (smoke-check "the units spread their goals: more than 2 points a side on average, the new points among them"
                 (and (< (* 2.0 (the float (* 2 (-> st samples)))) (the float (-> st kinds)))
                      (> (+ (-> st goals 6) (-> st goals 7) (-> st goals 8) (-> st goals 9)) 0)
                      )
                 )
    )
  0
  )

(defbehavior smoke-r27-run process ()
  "Scenario 40, round 27: Triangle reloads; the eight control points and their letters; 6 minutes of
   battle (`smoke-r27-battle`); a respawn at each new point (`smoke-r27-visit`). Kept out of
   `smoke-scenario`, whose size the register allocator no longer took."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r27-reload)
  (smoke-shot "r27-hud")
  (dotimes (i (-> *bf* point-count))
    (format 0 "SMOKE point ~D ~S letter ~S owner ~D" i (bf-point-name i) (bf-point-letter i) (-> *bf* points i owner))
    (format 0 " at ~M ~M ~M~%" (-> *bf* points i pos x) (-> *bf* points i pos y) (-> *bf* points i pos z))
    )
  (smoke-check "eight control points lettered A to H, besides the two bases"
              (and (= (-> *bf* point-count) 10) (string= (bf-point-letter 2) "A") (string= (bf-point-letter 5) "H")
                   (string= (bf-point-letter 6) "B") (string= (bf-point-letter 9) "G")
                   )
              )
  (smoke-r27-battle)
  (smoke-r27-visit 6)
  (smoke-r27-visit 7)
  (smoke-r27-visit 8)
  (smoke-r27-visit 9)
  0
  )

;; ----------------------------------------------------------------------------
;; Round 28: the rifle on the whole body, the red guards' dissolve, the death's choice, the redeploy's
;; class page, the spawns' reach
;; ----------------------------------------------------------------------------

(defbehavior smoke-r28-rifle process ()
  "Round 28: running, R1 once: the rifle's shot on the whole body (the stock gun-attack), the player
   still, the model facing the crosshair, a round spent."
  (smoke-step "rifle on the whole body")
  (smoke-neutral)
  (smoke-stick 128 0 128 128)
  (smoke-wait 1.0)
  (let ((mag (-> *bf* mag BF_WEAPON_RIFLE))
        (run (vector-xz-length (-> *target* control transv)))
        (looks 0)
        (still 0)
        (whole 0)
        (facing 0)
        )
    (smoke-rec-start "r28-rifle" 2)
    (smoke-tap (pad-buttons r1) 4)
    (dotimes (k 20)
      (suspend)
      (let ((av (smoke-av)))
        (when av
          (let ((ch (-> av skel root-channel 0)))
            (format 0 "SMOKE rifle frame ~D: step ~D anim ~D chans ~D group ~A frame ~f seek ~A target ~f" k (-> av rifle-step) (-> av anim)
                    (-> av skel active-channels) (if (-> ch frame-group) (-> ch frame-group name) "none") (-> ch frame-num))
            (format 0 " ~A ~f speed ~M~%" (= (-> ch num-func) num-func-seek!) (-> ch param 0) (vector-xz-length (-> *target* control transv)))
            )
          )
        (when (and av (> (-> av rifle-step) 0))
          (+! looks 1)
          (if (< (vector-xz-length (-> *target* control transv)) (meters 1))
              (+! still 1)
              )
          (if (= (-> av anim) (the-as int (-> (bf-class-art-of (-> *bf* class)) shoot)))
              (+! whole 1)
              )
          (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> av root quat)))
                (want (vector-! (new 'stack-no-clear 'vector) (-> av aim) (-> av root trans)))
                )
            (set! (-> fwd y) 0.0)
            (set! (-> want y) 0.0)
            (vector-normalize! fwd 1.0)
            (vector-normalize! want 1.0)
            (if (< 0.9 (vector-dot fwd want))
                (+! facing 1)
                )
            )
          )
        )
      )
    (smoke-wait 0.5)
    (smoke-rec-stop)
    (smoke-neutral)
    (format 0 "SMOKE rifle: running at ~M/s, magazine ~D then ~D;" run mag (-> *bf* mag BF_WEAPON_RIFLE))
    (format 0 " ~D frames of the shot: ~D still, ~D on the whole-body clip, ~D facing the crosshair~%" looks still whole facing)
    (smoke-check "the rifle's shot on the whole body, the player still and facing the crosshair"
                 (and (< (meters 3) run) (= (-> *bf* mag BF_WEAPON_RIFLE) (+ mag -1)) (< 3 looks)
                      (= still looks) (= whole looks) (<= (- looks 1) facing)
                      )
                 )
    )
  (smoke-wait 1.0)
  0
  )

(defun smoke-fizz? ((h handle))
  "#t when the unit of H dissolves (battlefront-h.gc `*bf-fizz*`)."
  (dotimes (i BF_FIZZ_MAX)
    (if (= (-> *bf-fizz* unit i) h)
        (return #t)
        )
    )
  #f
  )

(defun smoke-near-red-guard ()
  "The Krimzon Guard's red guard awake and alive nearest Jak, #f for none."
  (let ((best (the-as process-drawable #f))
        (best-d (meters 150))
        )
    (dotimes (i (smoke-collect 'crimson-guard 'crimson-guard))
      (let ((p (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (when (and p (bf-red-guard? p) (= (bf-unit-team p) BF_TEAM_KG)
                   (not (focus-test? (the-as process-focusable p) dead inactive disable))
                   (-> p next-state) (= (-> p next-state name) 'active)
                   )
          (let ((d (vector-vector-xz-distance (-> p root trans) (-> *target* control trans))))
            (when (< d best-d)
              (set! best p)
              (set! best-d d)
              )
            )
          )
        )
      )
    best
    )
  )

(defbehavior smoke-r28-red-death process ()
  "Round 28: a red guard of the Krimzon Guard killed in front of the camera: it dissolves in the
   blue guards' sparks (`*bf-fizz*`), then its body goes."
  (smoke-step "red guard dissolves")
  (let ((foe (smoke-near-red-guard)))
    (cond
      ((not foe)
       (smoke-check "a red guard killed dissolves in the blue guards' sparks, then goes" #f)
       )
      (else
        (let ((h (process->handle foe))
              (at (vector-copy! (new 'stack-no-clear 'vector) (-> foe root trans)))
              )
          (+! (-> at x) (meters 8))
          (+! (-> at y) (meters 1))
          (move-to-point! (-> *target* control) at)
          (smoke-wait 0.5)
          (smoke-face (-> (the-as process-drawable (handle->process h)) root trans))
          (smoke-rec-start "r28-red-death" 2)
          ;; the blow comes from Jak (`bf-send-attack`): his side the other one for it, or it deals
          ;; nothing to his own side's guard
          (let ((team (-> *bf* team)))
            (set! (-> *bf* team) BF_TEAM_FF)
            (bf-send-attack (the-as process-drawable (handle->process h)) 100.0)
            (set! (-> *bf* team) team)
            )
          (let ((t0 (smoke-now))
                (fizz? #f)
                (hidden? #f)
                )
            (while (< (- (smoke-now) t0) (seconds 5))
              (if (smoke-fizz? h)
                  (set! fizz? #t)
                  )
              (let ((p (the-as process-drawable (handle->process h))))
                (if (and p fizz? (logtest? (-> p draw status) (draw-control-status no-draw)))
                    (set! hidden? #t)
                    )
                )
              (suspend)
              )
            (smoke-rec-stop)
            (format 0 "SMOKE red guard death: dissolving ~A, hidden ~A~%" fizz? hidden?)
            (smoke-check "a red guard killed dissolves in the blue guards' sparks, then goes" (and fizz? hidden?))
            )
          )
        )
      )
    )
  0
  )

(defbehavior smoke-r28-death process ()
  "Round 28: the player killed: the camera looks down at his dying class model; he watches the
   battle until he chooses (no respawn page by itself); Triangle opens the class page, the red
   jetpack picked there, then the respawn page, his base, and back as a red jetpack."
  (smoke-step "death, then Triangle")
  (smoke-neutral)
  (smoke-invulnerable #f)
  (smoke-rec-start "r28-death" 2)
  (smoke-kill-player)
  (smoke-wait 1.5)
  (let ((down (-> *math-camera* inv-camera-rot fvec y)))
    (smoke-wait 2.5)
    (smoke-rec-stop)
    (format 0 "SMOKE dying: the camera's forward y ~f (below 0: looking down)~%" down)
    (smoke-check "the camera looks down at the dying class model" (< down -0.3))
    )
  (smoke-wait 3.0)
  (format 0 "SMOKE 7 s after the death: dead ~A, respawn page ~A, page ~D~%" (focus-test? *target* dead) (>= (-> *bf* respawn-pick) 0) (-> (smoke-dir) page))
  (smoke-check "the dead player watches the battle until he chooses: no respawn page by itself"
               (and (focus-test? *target* dead) (< (-> *bf* respawn-pick) 0) (= (-> (smoke-dir) page) BF_PAGE_NONE))
               )
  (smoke-shot "r28-choice")
  (smoke-press (pad-buttons triangle) 1.5)
  (smoke-check "Triangle opens the class page" (= (-> (smoke-dir) page) BF_PAGE_CLASS))
  (set! (-> (smoke-dir) cursor) 1)
  (smoke-wait 0.5)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 5.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
  (smoke-check "the class picked, then the respawn page" (and (>= (-> *bf* respawn-pick) 0) (= (-> *bf* class) BF_CLASS_RED_JETPACK)))
  (smoke-pick-point (-> *bf* team))
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)) (< (-> *bf* respawn-at) 0) (not (-> *bf* dropping?)))))
  (smoke-invulnerable #t)
  (smoke-wait 2.0)
  (smoke-check "back as the class picked" (and (bf-avatar-alive?) (= (-> (smoke-av) class) BF_CLASS_RED_JETPACK)))
  0
  )

(defbehavior smoke-r28-redeploy process ()
  "Round 28: START, Redeploy: the class page first (the red guard picked), then the respawn page,
   his base, and back as a red guard."
  (smoke-step "redeploy: the class, then the point")
  (smoke-wait 2.0)
  (smoke-bf-pause 3)
  (smoke-wait-for 5.0 (lambda () (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_CLASS))))
  (smoke-check "Redeploy opens the class page first" (= (-> (smoke-dir) page) BF_PAGE_CLASS))
  (set! (-> (smoke-dir) cursor) 0)
  (smoke-wait 0.5)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 5.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
  (smoke-check "then the respawn page" (and (>= (-> *bf* respawn-pick) 0) (= (-> *bf* class) BF_CLASS_RED_GUARD)))
  (smoke-pick-point (-> *bf* team))
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)) (< (-> *bf* respawn-at) 0) (not (-> *bf* dropping?)))))
  (smoke-wait 2.0)
  (smoke-check "back as the class picked: the red guard" (and (bf-avatar-alive?) (= (-> (smoke-av) class) BF_CLASS_RED_GUARD)))
  0
  )

(deftype smoke-r28-spawn-stats (structure)
  ((seen      int32)
   (count     int32)
   (far       int32)     ;; more than 90 m from the nearest point of the unit's side
   (max-d     float)
   (jets      int32)
   (jets-high int32)     ;; jetpacks brought down over a poly 20 m up or more (the walkways)
   (high      int32)     ;; any unit brought down 20 m up or more
   )
  )

(define *smoke-r28-spawns* (new 'static 'smoke-r28-spawn-stats))

(defun smoke-r28-spawn-tick ()
  "Every frame: each unit newly brought down from the sky (`*bf-sky-log*`): how far from the
   nearest point its side holds, and how high a jetpack's poly is."
  (let ((w *smoke-r28-spawns*))
    (while (< (-> w seen) (-> *bf-sky-log* count))
      (let* ((n (mod (-> w seen) BF_SKY_LOG))
             (p (handle->process (-> *bf-sky-log* unit n)))
             (team (if p (bf-unit-team p) -1))
             (best -1.0)
             )
        (when (>= team 0)
          (dotimes (i (-> *bf* point-count))
            (when (= (-> *bf* points i owner) team)
              (let ((d (vector-vector-xz-distance (-> *bf-sky-log* ground n) (-> *bf* points i pos))))
                (if (or (< best 0.0) (< d best))
                    (set! best d)
                    )
                )
              )
            )
          (when (>= best 0.0)
            (+! (-> w count) 1)
            (if (< (meters 90) best)
                (+! (-> w far) 1)
                )
            (if (< (-> w max-d) best)
                (set! (-> w max-d) best)
                )
            (if (< (meters 20) (-> *bf-sky-log* ground n y))
                (+! (-> w high) 1)
                )
            (when (= (-> *bf-sky-log* kind n) (-> *bf-kinds* 1))
              (+! (-> w jets) 1)
              (if (< (meters 20) (-> *bf-sky-log* ground n y))
                  (+! (-> w jets-high) 1)
                  )
              )
            )
          )
        )
      (+! (-> w seen) 1)
      )
    )
  0
  )

(defbehavior smoke-r28-spawns process ((secs float))
  "Round 28: SECS of battle: the units brought down within 250 m of their side's points, some beyond
   the old 90 m; no jetpack over the walkways."
  (smoke-step "spawns")
  (let ((w *smoke-r28-spawns*)
        (t0 (smoke-now))
        )
    (set! (-> w seen) (-> *bf-sky-log* count))
    (set! (-> w count) 0)
    (set! (-> w far) 0)
    (set! (-> w max-d) 0.0)
    (set! (-> w jets) 0)
    (set! (-> w jets-high) 0)
    (set! (-> w high) 0)
    (while (< (- (smoke-now) t0) (the int (* 300.0 secs)))
      (smoke-r28-spawn-tick)
      (suspend)
      )
    (format 0 "SMOKE spawns: ~D units, ~D beyond 90 m of their side's nearest point, the farthest ~M;" (-> w count) (-> w far) (-> w max-d))
    (format 0 " ~D jetpacks, ~D of them 20 m up or more; ~D units 20 m up or more~%" (-> w jets) (-> w jets-high) (-> w high))
    (smoke-check "the units come down up to 250 m from their side's points, many beyond 90 m"
                 (and (< 10 (-> w count)) (< 0 (-> w far)) (< (-> w max-d) (meters 255)))
                 )
    (smoke-check "no jetpack comes down over the Industrial Zone's walkways" (and (< 0 (-> w jets)) (zero? (-> w jets-high))))
    )
  0
  )

