    ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) (smoke-jetpack tag))
    ((BF_CLASS_ROBOGUARD) (smoke-robot tag))
    ((BF_CLASS_SPYDROID) (smoke-spider tag))
    )
