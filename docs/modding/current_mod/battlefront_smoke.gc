  (dotimes (k 2)
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "pov-hud-blue-guard-~D" (+ k 1))
    (smoke-v4-pov-hud BF_CLASS_BLUE_GUARD *smoke-name*)
    )
  (smoke-change-class 1 "blue jetpack")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-jetpack-attack "blue-jetpack")
  (set! *smoke-aim-pitch-min* (degrees -20))
  (dotimes (k 2)
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "pov-hud-blue-jetpack-~D" (+ k 1))
    (smoke-v4-pov-hud BF_CLASS_BLUE_JETPACK *smoke-name*)
    )
  (set! *smoke-aim-pitch-min* BF_PITCH_DOWN)
  (smoke-trl-front-off)
  (set! *smoke-los-watch* #f)
  0
  )

(defbehavior smoke-thumb-take process ((clip string) (dist float) (up float))
  "A thumbnail burst: a dense fight (`smoke-trl-wait-mix`: 14 of each side, 40 s at most) from DIST
   off and UP high on its side away from the palace (151 m, 724 m: the palace behind the fight), or
   30 then 60 degrees either way, or the clearest heading, when scenery blocks the line; the look
   following the mix, 5 s recorded as CLIP (`smoke-trl-battle-take`), no HUD."
  (let ((at (new 'stack-no-clear 'vector))
        (eye (new 'stack-no-clear 'vector))
        (look (new 'stack-no-clear 'vector))
        )
    (when (> (smoke-trl-wait-mix at 14 40.0) 0)
      (vector-copy! look at)
      (+! (-> look y) (meters 1.5))
      (let ((base (atan (- (-> at x) (meters 151)) (- (-> at z) (meters 724))))
            (ang 0.0)
            (found #f)
            )
        (dotimes (k 5)
          (when (not found)
            (set! ang (+ base (degrees (-> (new 'static 'array float 5 0.0 30.0 -30.0 60.0 -60.0) k))))
            (set-vector! eye (+ (-> at x) (* dist (sin ang))) (+ (-> at y) up) (+ (-> at z) (* dist (cos ang))) 1.0)
            (set! found (smoke-trl-los-r? eye look (meters 0.5)))
            )
          )
        (when (not found)
          (set! ang (smoke-trl-clear-dir at dist up))
          (set-vector! eye (+ (-> at x) (* dist (sin ang))) (+ (-> at y) up) (+ (-> at z) (* dist (cos ang))) 1.0)
          )
        (format 0 "SMOKE thumb ~S heading ~R, palace behind ~A~%" clip ang found)
        )
      (smoke-cine-line eye eye look 1.0)
      (smoke-wait 0.3)
      (smoke-trl-battle-take clip 5.0 at)
      (smoke-cine-off)
      )
    )
  0
  )

(defbehavior smoke-s121 process ()
  "Scenario 121 (`smoke-scenario-late`), the mod's thumbnail: 1920 x 1080 bursts (a frame every 3
   game frames), no HUD, 12:00, the Krimzon Guard at the Palace Plaza (both armies sent there): the
   spider's run and blast (`smoke-v4-spider-run`), the red jetpack's rocket on a group
   (`smoke-trl-rocket`), then a dense fight from low and close and from 30 m, the palace behind it,
   twice each (`smoke-thumb-take`). No check of its own."
  (set! *smoke-trl-hour* 12)
  (set! *smoke-hd-w* 1920)
  (set! *smoke-hd-h* 1080)
  (set! *smoke-hd-every-min* 3)
  (smoke-trl-v2-start BF_TEAM_KG 3 "deploy spider")
  (smoke-trl-park-at 3)
  (set! *smoke-los-watch* #t)
  (smoke-trl-front3 14 9 11)
  (smoke-step "front palace plaza")
  (smoke-wait 60.0)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-spider-run "thumb-spider" (meters 40) (meters 12))
  (smoke-v4-respawn)
  (smoke-change-class 1 "red jetpack")
  (smoke-trl-front3 14 9 11)
  (smoke-trl-rocket "thumb-rocket")
  (smoke-trl-park-at 3)
  (dotimes (k 2)
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "thumb-low-~D" (+ k 1))
    (smoke-thumb-take *smoke-name* (meters 13) (meters 2))
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "thumb-wide-~D" (+ k 1))
    (smoke-thumb-take *smoke-name* (meters 30) (meters 9))
    )
  (smoke-trl-front-off)
  (set! *smoke-los-watch* #f)
  0
  )

(defbehavior smoke-s58 process ()
  "Scenario 58 (`smoke-scenario-late`), round 32: four pickups queued 15 m up, 8 m in front of the
   player (`bf-spawn-drops`, as a jetpack guard's): dark eco, yellow ammo, red ammo, health. They
   must fall and rest on the ground under them."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
    (vector+float*! at at (-> *target* control c-R-w fvec) (meters 8))
    (+! (-> at y) (meters 15))
    (dotimes (k 4)
      (let ((i (-> *bf* drop-count)))
        (set! (-> *bf* drop-kind i) (the-as int (-> *bf-drop-types* (-> (new 'static 'array int32 4 0 1 2 4) k))))
        (vector-copy! (-> *bf* drop-pos i) at)
        (+! (-> *bf* drop-pos i x) (* (meters 1.5) (the float k)))
        (+! (-> *bf* drop-count) 1)
        )
      )
    (smoke-wait 0.3)
    (smoke-check "the pickups were born up there" (= (smoke-r32-drops-report "born" at) 0))
    (smoke-shot "r32-drops-falling")
    (smoke-wait 4.0)
    (let ((n (smoke-r32-drops-report "landed" at)))
      (format 0 "SMOKE drops on the ground: ~D~%" n)
      (smoke-check "the pickups rest on the ground under them" (>= n 4))
      )
    (smoke-shot "r32-drops-landed")
    )
  0
  )

(define *smoke-r32-sky* (new 'static 'array int32 1 0))
(define-extern bf-transport-asleep-count (function int (pointer int32) int))
(define-extern *bf-nan-sleeps* (pointer int32))
(define-extern *bf-bone-fixes* (pointer int32))
(define-extern bf-ways-index (function nav-mesh int))
(define-extern bf-unit-kind-name (function process symbol))

(defun smoke-r32-sides ()
  "Round 32 diagnosis, one line a side: its units awake, asleep in the traffic's pools and fallen
   less than BF_UNIT_RESPAWN ago, by kind (*bf-kinds* order); then the units the control points
   brought down since the last look (`*bf-sky-log*`): their kind and the poly they fall onto."
  (dotimes (team 2)
    (let ((now (new 'stack-no-clear 'array 'int32 4))
          (sleep (new 'stack-no-clear 'array 'int32 4))
          )
      (bf-transport-team-count team now)
      (bf-transport-asleep-count team sleep)
      (format 0 "SMOKE side ~D awake ~D ~D ~D ~D" team (-> now 0) (-> now 1) (-> now 2) (-> now 3))
      (format 0 " asleep ~D ~D ~D ~D" (-> sleep 0) (-> sleep 1) (-> sleep 2) (-> sleep 3))
      (format 0 " fallen ~D ~D ~D ~D~%" (bf-fallen-count team 0) (bf-fallen-count team 1) (bf-fallen-count team 2)
              (bf-fallen-count team 3))
      )
    )
  (let ((from (max (-> *smoke-r32-sky* 0) (- (-> *bf-sky-log* count) BF_SKY_LOG))))
    (while (< from (-> *bf-sky-log* count))
      (let* ((n (mod from BF_SKY_LOG))
             (u (handle->process (-> *bf-sky-log* unit n)))
             )
        (format 0 "SMOKE sky ~D kind ~D pid ~D" from (-> *bf-sky-log* kind n) (if u (-> u pid) -1))
        (format 0 " ground ~M ~M ~M height ~M~%" (-> *bf-sky-log* ground n x) (-> *bf-sky-log* ground n y)
                (-> *bf-sky-log* ground n z) (-> *bf-sky-log* height n))
        )
      (+! from 1)
      )
    (set! (-> *smoke-r32-sky* 0) (-> *bf-sky-log* count))
    )
  (none)
  )

(defun smoke-r32-units ()
  "Round 32 diagnosis: each unit of the battle awake: its process id, kind, side, state, place; its
   focus (the stock's own target, the one a guard's 'rifle-hostile and 'rifle-reload read): its kind,
   state and whether it is gone, dead, disabled or ignored ('bad); its nav mesh (none, default, or its
   `*bf-ways*` index) and whether it stands in it within 1 m (nav-control is-in-mesh?); its march
   and fight."
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (type? p nav-enemy) (>= (bf-unit-team p) 0) (-> p next-state) (!= (-> p next-state name) 'inactive))
        (let* ((u (the-as nav-enemy p))
               (f (handle->process (-> u focus handle)))
               (nav? (and (nonzero? (-> u nav)) (-> u nav)))
               (m (if nav? (-> u nav state mesh)))
               )
          (format 0 "SMOKE u ~D ~A ~D ~A" (-> p pid) (bf-unit-kind-name p) (bf-unit-team p) (-> p next-state name))
          (format 0 " at ~M ~M ~M" (-> u root trans x) (-> u root trans y) (-> u root trans z))
          (format 0 " focus ~A ~A ~A" (if f (bf-unit-kind-name f) '-) (if (and f (-> f next-state)) (-> f next-state name) '-)
                  (if (and f (type? f process-focusable)
                           (not (logtest? (-> (the-as process-focusable f) focus-status) (focus-status disable dead ignore grabbed inactive)))
                           )
                      'ok
                      'bad
                      )
                  )
          (format 0 " mesh ~A in ~A march ~A fight ~A~%"
                  (cond
                    ((not m) 'none)
                    ((= m *default-nav-mesh*) 'default)
                    (else (bf-ways-index m))
                    )
                  (if m (is-in-mesh? (-> u nav) (-> u root trans) (meters 1)) #f)
                  (bf-marching? p)
                  (bf-city-engaged? p)
                  )
          )
        )
      #t
      )
    *null-kernel-context*
    )
  (none)
  )

(defbehavior smoke-s59 process ()
  "Scenario 59 (`smoke-scenario-late`), round 32 diagnosis: a battle watched 7 minutes from the
   South Industrial Zone's point (E), the player invulnerable: every 10 s each side's units awake,
   asleep and fallen, the units brought down since (`smoke-r32-sides`), every unit's state, focus,
   nav mesh, march and fight (`smoke-r32-units`). For the author's play: the guards stopped coming
   down at the points after a while, most stood reloading, some appeared off the map and walked
   through walls."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (move-to-point! (-> *target* control) (-> *bf* points 8 pos))
  (set! (-> *smoke-r32-sky* 0) (-> *bf-sky-log* count))
  (smoke-wait 5.0)
  (dotimes (n 42)
    (format 0 "SMOKE look ~D~%" n)
    (smoke-r32-sides)
    (smoke-r32-units)
    (if (zero? (mod n 7))
        (smoke-shot (if (zero? n) "r32-watch-0" "r32-watch"))
        )
    (smoke-wait 10.0)
    )
  (smoke-check "the diagnosis ran" #t)
  0
  )

(defun smoke-nan? ((f float))
  "#t when F is a NaN or an infinity: its exponent bits all set."
  (= (logand (the-as int f) #x7f800000) #x7f800000)
  )

(deftype smoke-trap (structure)
  "Round 32: each unit's last frame, by process id modulo 512: its state, place, velocity, its focus's
   state and place; SEEN once its NaN was reported."
  ((pid    int32  512)
   (seen   int32  512)
   (state  symbol 512)
   (fstate symbol 512)
   (pos    vector 512 :inline)
   (vel    vector 512 :inline)
   (fpos   vector 512 :inline)
   )
  )

(define *smoke-trap* (new 'static 'smoke-trap))

(defun smoke-r32-trap ()
  "Round 32, every frame: each unit of the battle whose place or velocity turned NaN (`smoke-nan?`)
   is reported once, with its last frame before (`*smoke-trap*`) and this one."
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (type? p nav-enemy) (>= (bf-unit-team p) 0) (-> p next-state))
        (let* ((u (the-as nav-enemy p))
               (t *smoke-trap*)
               (k (logand (-> p pid) 511))
               (f (handle->process (-> u focus handle)))
               (bad? (or (smoke-nan? (-> u root trans x)) (smoke-nan? (-> u root trans z))
                         (smoke-nan? (-> u root transv x)) (smoke-nan? (-> u root transv z))
                         )
                     )
               )
          (when (!= (-> t pid k) (-> p pid))
            (set! (-> t seen k) 0)
            (set! (-> t state k) #f)
            )
          (when (and bad? (zero? (-> t seen k)))
            (set! (-> t seen k) 1)
            (format 0 "SMOKE NaN ~D ~A ~D now ~A before ~A~%" (-> p pid) (bf-unit-kind-name p) (bf-unit-team p)
                    (-> p next-state name) (-> t state k))
            (format 0 "SMOKE NaN  before at ~M ~M ~M" (-> t pos k x) (-> t pos k y) (-> t pos k z))
            (format 0 " vel ~M ~M ~M~%" (-> t vel k x) (-> t vel k y) (-> t vel k z))
            (format 0 "SMOKE NaN  now at ~M ~M ~M" (-> u root trans x) (-> u root trans y) (-> u root trans z))
            (format 0 " vel ~M ~M ~M~%" (-> u root transv x) (-> u root transv y) (-> u root transv z))
            (format 0 "SMOKE NaN  focus ~A ~A before ~A at ~M ~M" (if f (bf-unit-kind-name f) '-)
                    (if (and f (-> f next-state)) (-> f next-state name) '-) (-> t fstate k) (-> t fpos k x) (-> t fpos k z))
            (if (and f (type? f process-drawable))
                (format 0 " now ~M ~M ~M~%" (-> (the-as process-drawable f) root trans x) (-> (the-as process-drawable f) root trans y)
                        (-> (the-as process-drawable f) root trans z))
                (format 0 "~%")
                )
            (when (and (nonzero? (-> u nav)) (-> u nav))
              (format 0 "SMOKE NaN  nav vel ~M ~M target ~M ~M" (-> u nav state velocity x) (-> u nav state velocity z)
                      (-> u nav state target-pos x) (-> u nav state target-pos z))
              (format 0 " travel ~M ~M~%" (-> u nav state travel x) (-> u nav state travel z))
              )
            (format 0 "SMOKE NaN  hit-points ~f flags ~X~%" (-> u hit-points) (-> u enemy-flags))
            (when (and f (type? f process-focusable))
              (let ((b (get-trans (the-as process-focusable f) 3)))
                (format 0 "SMOKE NaN  focus pid ~D bullseye ~M ~M ~M~%" (-> f pid) (-> b x) (-> b y) (-> b z))
                )
              )
            )
          (set! (-> t pid k) (-> p pid))
          (when (not bad?)
            (set! (-> t state k) (-> p next-state name))
            (vector-copy! (-> t pos k) (-> u root trans))
            (vector-copy! (-> t vel k) (-> u root transv))
            (set! (-> t fstate k) (if (and f (-> f next-state)) (-> f next-state name) '-))
            (if (and f (type? f process-drawable))
                (vector-copy! (-> t fpos k) (-> (the-as process-drawable f) root trans))
                (vector-reset! (-> t fpos k))
                )
            )
          )
        )
      #t
      )
    *null-kernel-context*
    )
  (none)
  )

(defbehavior smoke-s60 process ()
  "Scenario 60 (`smoke-scenario-late`), round 32 diagnosis: the battle of scenario 59 watched 7
   minutes with a trap on every frame (`smoke-r32-trap`): the first frame each unit's place or
   velocity turns NaN, with the frame before; each side's units every 30 s (`smoke-r32-sides`)."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (move-to-point! (-> *target* control) (-> *bf* points 8 pos))
  (set! (-> *smoke-r32-sky* 0) (-> *bf-sky-log* count))
  (dotimes (n 14)
    (format 0 "SMOKE look ~D~%" n)
    (smoke-r32-sides)
    (dotimes (fr 1800)
      (smoke-r32-trap)
      (suspend)
      )
    )
  (smoke-r32-units)
  (format 0 "SMOKE units put to sleep at NaN: ~D, bones put back: ~D~%" (-> *bf-nan-sleeps* 0) (-> *bf-bone-fixes* 0))
  (smoke-check "the diagnosis ran" #t)
  0
  )

(defbehavior smoke-s57 process ()
  "Scenario 57 (`smoke-scenario-late`), round 31 diagnosis: a battle watched 150 s from the South
   Industrial Zone's point (E), every unit's place, goal, foe and the nearest foe every 5 s
   (`bf-city-target-report`): where units stand still on their way (the passage to the Slums), and
   whether the Freedom League's take the robotguards and the spiders near them."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (move-to-point! (-> *target* control) (-> *bf* points 8 pos))
  (smoke-wait 5.0)
  (dotimes (n 30)
    (format 0 "SMOKE look ~D~%" n)
    (bf-city-target-report)
    (if (zero? (mod n 6))
        (smoke-shot (if (zero? n) "r31-e-0" "r31-e"))
        )
    (smoke-wait 5.0)
    )
  (smoke-check "the diagnosis ran" #t)
  0
  )

(defbehavior smoke-s56 process ()
  "Scenario 56 (`smoke-scenario-late`), round 31 diagnosis: the player of the Krimzon Guard as a red
   guard, the robotguard, then the spider, at the Freedom League's base 8 s each: each unit's foe
   (`bf-city-target-report`: the Freedom League's on the player, 'target'); the bridges between the
   meshes (`bf-ways-bridge-report`, and the gaps with none in the log)."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (bf-ways-bridge-report)
  (move-to-point! (-> *target* control) (-> *bf* points 0 pos))
  (smoke-wait 3.0)
  (dotimes (k 3)
    (let ((idx (-> (new 'static 'array int32 3 0 2 3) k)))
      ;; the class changed on the spot, as Change class did until round 30: the avatar again
      (when (> k 0)
        (set! (-> *bf* class) (+ (* 4 (-> *bf* team)) idx))
        (bf-avatar-kill)
        (set! (-> (smoke-dir) want-avatar?) #t)
        (smoke-wait 2.0)
        )
      (smoke-invulnerable #t)
      (smoke-wait 1.0)
      (dotimes (n 4)
        (format 0 "SMOKE targets class ~D look ~D~%" (-> *bf* class) n)
        (bf-city-target-report)
        (smoke-wait 2.0)
        )
      )
    )
  (smoke-check "the diagnosis ran" #t)
  0
  )

(defbehavior smoke-s55 process ()
  "Scenario 55 (`smoke-scenario-late`), round 31 diagnosis: the scrolling on the pause page under the
   running battle (Down held 1 s); the music; a redeploy as the robotguard, then the spider, then a
   death and a respawn as the robotguard: the camera, Jak, the rig, the class model, the health."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r31-watch "deployed" 1.0)
  ;; the scrolling
  (smoke-step "scrolling")
  (smoke-start-page 'main)
  (smoke-wait-for 8.0 (lambda () (smoke-page-up? BF_PAGE_PAUSE)))
  (smoke-wait 0.5)
  (let ((moves 0)
        (last (-> (smoke-dir) cursor))
        )
    (smoke-hold (pad-buttons down))
    (dotimes (f 60)
      (suspend)
      (when (!= (-> (smoke-dir) cursor) last)
        (+! moves 1)
        (set! last (-> (smoke-dir) cursor))
        )
      )
    (smoke-neutral)
    (format 0 "SMOKE scrolling: Down held 60 frames moved the cursor ~D times~%" moves)
    (smoke-check "Down held once moves the cursor once" (= moves 1))
    )
  (smoke-r31-watch "pause" 1.0)
  ;; the redeploy as the robotguard
  (smoke-step "redeploy robotguard")
  (set! (-> (smoke-dir) cursor) 2)
  (smoke-wait 0.6)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 6.0 (lambda () (smoke-page-up? BF_PAGE_CLASS)))
  (set! (-> (smoke-dir) cursor) 2)
  (smoke-wait 0.6)
  (smoke-press (pad-buttons x) 0.6)
  (smoke-press (pad-buttons x) 0.1)
  (smoke-r31-watch "robot" 6.0)
  (smoke-shot "r31-robot")
  ;; the spider
  (smoke-step "redeploy spider")
  (smoke-wait 2.0)
  (smoke-start-page 'main)
  (smoke-wait-for 8.0 (lambda () (smoke-page-up? BF_PAGE_PAUSE)))
  (set! (-> (smoke-dir) cursor) 2)
  (smoke-wait 0.6)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 6.0 (lambda () (smoke-page-up? BF_PAGE_CLASS)))
  (set! (-> (smoke-dir) cursor) 3)
  (smoke-wait 0.6)
  (smoke-invulnerable #f)
  (smoke-press (pad-buttons x) 0.6)
  (smoke-press (pad-buttons x) 0.1)
  (smoke-r31-watch "spider" 7.0)
  (smoke-shot "r31-spider")
  ;; a death as the spider, the robotguard again
  (smoke-step "death spider, respawn robotguard")
  (smoke-wait 3.0)
  (smoke-kill-player)
  (smoke-respawn-page 20.0)
  (set! (-> (smoke-dir) cursor) 2)
  (smoke-wait 0.6)
  (smoke-press (pad-buttons x) 0.6)
  (smoke-press (pad-buttons x) 0.1)
  (smoke-r31-watch "respawn-robot" 8.0)
  (smoke-shot "r31-respawn-robot")
  (smoke-check "the diagnosis ran" #t)
  0
  )

(define *smoke-portrait-classes* (new 'static 'array int32 6 0 1 4 5 6 7))

(defbehavior smoke-s53 process ()
  "Scenario 53 (`smoke-scenario-late`), round 30: the class portraits' captures. In a battle, each
   class model alone on black (`bf-black-set!`, the game in the 'menu master mode, an empty page:
   no HUD), turned three quarters, a screenshot each (`smoke-portrait-<class>`); the script
   scripts/battlefront/make_portraits.py makes the class page's pictures from them."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (set! (-> (smoke-dir) page) 9)
  (bf-black-set! #t)
  (set-master-mode 'menu)
  (smoke-wait 1.5)
  (dotimes (k 6)
    (let* ((class (-> *smoke-portrait-classes* k))
           (icon (bf-icon-spawn class 0.0 25.0 (smoke-dir)))
           )
      (format 0 "SMOKE portrait ~D model ~A~%" class (if icon #t #f))
      (when icon
        (bf-icon-place icon 256.0 208.0 300.0 (meters 3))
        (smoke-wait 1.5)
        (format (clear *smoke-name*) "portrait-~D" class)
        (smoke-shot *smoke-name*)
        (smoke-wait 1.0)
        (deactivate icon)
        )
      )
    )
  (set-master-mode 'game)
  (bf-black-set! #f)
  (set! (-> (smoke-dir) page) BF_PAGE_NONE)
  (smoke-check "every class model shown alone on black" #t)
  0
  )

(defbehavior smoke-s52 process ()
  "Scenario 52 (`smoke-scenario-late`), round 29: the class page in three columns from the title;
   a death: X opens the class page with the respawn point and the radar, the base picked, Spawn;
   a redeploy: the same page, the red jetpack picked, Spawn."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-step "death: the class page with the point")
  (smoke-invulnerable #f)
  (smoke-kill-player)
  (smoke-respawn-page 15.0)
  (smoke-wait 1.0)
  (format 0 "SMOKE after the death: page ~D respawn ~A pick ~D rows ~D~%" (-> (smoke-dir) page) (-> (smoke-dir) respawn?)
          (-> (smoke-dir) pick-point) (bf-page-count BF_PAGE_CLASS))
  (smoke-check "a death: Triangle opens the class page with the respawn point"
               (and (= (-> (smoke-dir) page) BF_PAGE_CLASS) (-> (smoke-dir) respawn?) (= (bf-page-count BF_PAGE_CLASS) (+ (bf-class-count) 2)))
               )
  (set! (-> (smoke-dir) cursor) (bf-class-count))
  (smoke-wait 0.6)
  (smoke-shot "r29-respawn-page")
  (smoke-pick-point (-> *bf* team))
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)) (< (-> *bf* respawn-at) 0) (not (-> *bf* dropping?)))))
  (smoke-invulnerable #t)
  (smoke-wait 2.0)
  (smoke-check "Spawn: back at the point picked, the class kept" (and (bf-avatar-alive?) (= (-> *bf* class) BF_CLASS_RED_GUARD)))
  (smoke-step "redeploy: the class page, the red jetpack")
  (smoke-bf-pause 2)
  (smoke-wait-for 12.0 (lambda () (smoke-page-up? BF_PAGE_CLASS)))
  (smoke-check "Redeploy opens the class page with the respawn point" (and (= (-> (smoke-dir) page) BF_PAGE_CLASS) (-> (smoke-dir) respawn?)))
  (set! (-> (smoke-dir) cursor) 1)
  (smoke-wait 0.6)
  (smoke-pick-point (-> *bf* team))
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)) (< (-> *bf* respawn-at) 0) (not (-> *bf* dropping?)))))
  (smoke-wait 2.0)
  (smoke-check "the class picked on the page: back as a red jetpack" (and (bf-avatar-alive?) (= (-> *bf* class) BF_CLASS_RED_JETPACK)))
  0
  )

(defbehavior smoke-s51 process ()
  "Scenario 51 (`smoke-scenario-late`), round 29: the title page, the configuration (units 600, a side
   swapped and back), the battle from the title, its reserves; every control point held 20 s wins;
   then a new battle from the pause page, ended by its time limit."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-shot "title-page")
  ;; the configuration's settings
  (set! (-> *bf-config* units) 500)
  (smoke-step "configuration")
  (set! (-> *progress-process* 0 option-index) 0)
  (smoke-wait 0.3)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 6.0 (lambda () (smoke-page-up? BF_PAGE_ZONE)))
  (set! (-> (smoke-dir) cursor) 0)
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 6.0 (lambda () (smoke-page-up? BF_PAGE_CONFIG)))
  (set! (-> (smoke-dir) cursor) 1)
  (smoke-press (pad-buttons right) 0.5)
  (smoke-press (pad-buttons right) 0.5)
  (format 0 "SMOKE config: units ~D minutes ~D victory ~D sides ~D ~D~%" (-> *bf-config* units) (-> *bf-config* minutes)
          (-> *bf-config* victory) (-> *bf-config* team-a) (-> *bf-config* team-b))
  (smoke-check "Right raises the units per side by 50" (= (-> *bf-config* units) 600))
  (set! (-> (smoke-dir) cursor) 5)
  (smoke-press (pad-buttons right) 0.5)
  (smoke-check "a side changed changes the other: never the same" (and (= (-> *bf-config* team-a) BF_TEAM_FF) (= (-> *bf-config* team-b) BF_TEAM_KG)))
  (smoke-press (pad-buttons left) 0.5)
  (smoke-press (pad-buttons triangle) 1.0)
  (smoke-wait-for 6.0 (lambda () (smoke-page-up? BF_PAGE_ZONE)))
  (smoke-press (pad-buttons triangle) 1.0)
  (smoke-wait-for 6.0 (lambda () (smoke-title-up?)))
  (smoke-check "Triangle back to the title menu" (smoke-title-up?))
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (format 0 "SMOKE battle: reserves ~D ~D of ~D~%" (-> *bf* reserve 0) (-> *bf* reserve 1) (-> *bf* reserve-max))
  (smoke-check "the battle's reserves are the configuration's units" (and (= (-> *bf* reserve-max) 600) (<= 590 (-> *bf* reserve 0))))
  (smoke-shot "r29-battle-hud")
  ;; every control point to the Krimzon Guard: it wins 20 s later
  (smoke-step "points victory")
  (dotimes (i (-> *bf* point-count))
    (if (not (-> *bf* points i base?))
        (set! (-> *bf* points i owner) BF_TEAM_KG)
        )
    )
  (smoke-wait-for 40.0 (lambda () (= (-> *bf* phase) BF_PHASE_OVER)))
  ;; the result page takes X once the START menu shows it
  (smoke-wait-for 10.0 (lambda () (smoke-page-up? BF_PAGE_RESULT)))
  (smoke-wait 0.5)
  (format 0 "SMOKE points victory: phase ~D winner ~D page ~D~%" (-> *bf* phase) (-> *bf* winner) (-> (smoke-dir) page))
  (smoke-check "every control point held 20 s wins the battle" (and (= (-> *bf* winner) BF_TEAM_KG) (= (-> (smoke-dir) page) BF_PAGE_RESULT)))
  (smoke-shot "r29-result")
  (smoke-press (pad-buttons x) 3.0)
  (smoke-wait-stand 60.0)
  (smoke-wait 3.0)
  ;; a new battle from the pause page, its time limit 1 minute, nearly over
  (smoke-step "time limit")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (set! (-> *bf* time-limit) 1)
  (set! (-> *bf* phase-time) (- (-> (smoke-dir) clock frame-counter) (seconds 55)))
  (smoke-wait 2.0)
  (smoke-shot "r29-timer")
  (smoke-wait-for 20.0 (lambda () (= (-> *bf* phase) BF_PHASE_OVER)))
  (format 0 "SMOKE time limit: phase ~D winner ~D~%" (-> *bf* phase) (-> *bf* winner))
  (smoke-check "the time limit ends the battle" (= (-> *bf* phase) BF_PHASE_OVER))
  0
  )

(defbehavior smoke-s50 process ()
  "Scenario 50 (`smoke-scenario-late`), round 29: the reserve meter; 3 minutes of battle, every unit
   looked at every 5 s (`bf-city-target-report`: its goal kept, none stuck); a respawn at the Port
   Gate: the minimap's marks; Jak in a point's capture zone: its letter and its share."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-shot "r29-hud")
  (let ((t0 (smoke-now)))
    (while (< (- (smoke-now) t0) (seconds 180))
      (format 0 "SMOKE look at ~D s~%" (/ (- (smoke-now) t0) 300))
      (bf-city-target-report)
      (smoke-points-line "look")
      (smoke-wait 5.0)
      )
    )
  (smoke-r27-visit 6)
  ;; Jak in the Port Gate's capture zone
  (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 6 pos))))
    (+! (-> at x) (meters 4))
    (+! (-> at y) (meters 1))
    (move-to-point! (-> *target* control) at)
    )
  (smoke-wait 2.0)
  (smoke-shot "r29-in-zone")
  (smoke-check "the diagnosis ran" #t)
  0
  )

(defbehavior smoke-s48 process ()
  "Scenario 48 (`smoke-scenario-late`), round 29: a blue guard and a red guard shot dead with the
   player's rifle (the stock dissolve, the battle's sparks), his damage (2 shots for a guard); the
   health pack; one jump for a guard, none for the robotguard."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r29-moves)
  ;; the player's damage: one rifle shot's 8 points from him, twice, on a guard of the other side
  (smoke-step "the player's damage")
  (set! (-> *bf* team) BF_TEAM_FF)
  (let ((foe (the-as nav-enemy (smoke-near-guard BF_TEAM_KG #t))))
    (when foe
      (let ((before (-> foe hit-points))
            (full (-> foe enemy-info default-hit-points))
            )
        (bf-send-attack foe 8.0)
        (smoke-wait 0.2)
        (format 0 "SMOKE player's damage: 8 points from him took ~f of 24 (hit points ~f then ~f of ~f)~%"
                (* 24.0 (/ (- (fmin before full) (-> foe hit-points)) full)) before (-> foe hit-points) full)
        (smoke-check "the player deals twice a unit's damage (8 points take 16 of 24)"
                     ;; the damage step caps the hit points to the stock full ones first
                     (< (fabs (- (* 24.0 (/ (- (fmin before full) (-> foe hit-points)) full)) (fmin 16.0 (* 24.0 (/ (fmin before full) full))))) 0.3))
        )
      )
    )
  (smoke-step "a red guard shot dead")
  ;; the player of the other side for it: the red guards his foes
  (let ((red (smoke-r29-shoot-dead BF_TEAM_KG #t "r29-red-death")))
    (set! (-> *bf* team) BF_TEAM_KG)
    (smoke-check "a red guard shot dead dissolves in the sparks and goes, as a blue one" (and (> red 0) *smoke-r29-red?*))
    )
  (smoke-change-class 2 "robotguard")
  (smoke-wait 2.0)
  (smoke-r29-robot-jump)
  0
  )

