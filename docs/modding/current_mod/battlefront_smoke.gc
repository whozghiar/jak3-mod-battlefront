(defbehavior smoke-play process ((class int) (tag string))
  "Play CLASS for some twenty seconds with its own moves."
  (case class
    ((BF_CLASS_BLUE_GUARD BF_CLASS_RED_GUARD) (smoke-guard tag))
    ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK) (smoke-jetpack tag))
    ((BF_CLASS_ROBOGUARD) (smoke-robot tag))
    ((BF_CLASS_SPYDROID) (smoke-spider tag))
    )
  (smoke-neutral)
  (smoke-check "still in the battle after the class's moves" (and *target* (bf-fighting?)))
  0
  )

;; ----------------------------------------------------------------------------
;; Jetpack hover: what the model does when the player lets go of everything
;; ----------------------------------------------------------------------------

(defbehavior smoke-hover-watch process ((tag string) (secs float))
  "For SECS, nothing pressed: count the model's clip changes, the frames Jak's on-surface flag
   changes, and the model's and Jak's height range, then print them; record it as a GIF (TAG)."
  (smoke-neutral)
  (smoke-rec-start tag 2)
  (let ((t0 (smoke-now))
        (av (smoke-av))
        (clips 0)
        (flips 0)
        (last-anim -2)
        (last-ground? #f)
        (lo 1000000000.0)
        (hi -1000000000.0)
        (jlo 1000000000.0)
        (jhi -1000000000.0)
        (frames 0)
        (last-frame -1.0)
        (advance 0.0)
        )
    (when av
      (set! last-anim (-> av anim))
      (set! last-ground? (logtest? (-> *target* control status) (collide-status on-surface)))
      (format 0 "SMOKE ~S start: clip ~D speed ~f frames ~D," tag (-> av anim)
              (-> av skel root-channel 0 frame-group speed) (-> av skel root-channel 0 frame-group frames num-frames))
      (format 0 " Jak ~M above his ground, state ~A, fuel ~f~%"
              (- (-> *target* control trans y) (-> *target* control gspot-pos y)) (-> *target* state name) (-> av fuel))
      )
    (while (and (smoke-av) (< (- (smoke-now) t0) (the int (* secs 300.0))))
      (let ((av (smoke-av)))
        (when (!= (-> av anim) last-anim)
          (+! clips 1)
          (set! last-anim (-> av anim))
          )
        ;; how far the clip moves each game frame (a loop wraps back by its length minus one)
        (let ((f (-> av skel root-channel 0 frame-num))
              (n (the float (+ (-> av skel root-channel 0 frame-group frames num-frames) -1)))
              )
          (when (<= 0.0 last-frame)
            (let ((d (- f last-frame)))
              (if (< d (* -0.5 n))
                  (+! d n)
                  )
              (+! advance (fabs d))
              )
            )
          (set! last-frame f)
          )
        (let ((g? (logtest? (-> *target* control status) (collide-status on-surface))))
          (when (!= g? last-ground?)
            (+! flips 1)
            (set! last-ground? g?)
            )
          )
        (set! lo (fmin lo (-> av root trans y)))
        (set! hi (fmax hi (-> av root trans y)))
        (set! jlo (fmin jlo (-> *target* control trans y)))
        (set! jhi (fmax jhi (-> *target* control trans y)))
        (+! frames 1)
        )
      (suspend)
      )
    (smoke-rec-stop)
    (format 0 "SMOKE hover ~S: ~D frames, ~D clip changes (now ~D), ~D on-surface flips," tag frames clips last-anim flips)
    (format 0 " model y range ~M, Jak y range ~M, state ~A, clip frames per game frame ~f~%" (- hi lo) (- jhi jlo)
            (if *target* (-> *target* state name) 'none) (/ advance (the float (max 1 frames))))
    ;; the Jak 2 rip's frames, 15 a second: a quarter of a clip frame each game frame
    (let ((pace (/ advance (the float (max 1 frames)))))
      (smoke-check "the jetpack's clip plays at the rip's pace (15 frames a second)" (and (< 0.2 pace) (< pace 0.3)))
      )
    clips
    )
  )

;; The model's joints against its root, the frame before (`smoke-pose-watch`).
(define *smoke-joints* (new 'global 'inline-array 'vector 64))

(defun smoke-pose-step ((av bf-avatar) (first? symbol))
  "How far, in meters, the model's joints moved against its root since the last call, summed over
   its joints (0 on the FIRST? call); the joints kept for the next call."
  (let ((sum 0.0)
        (p (new 'stack-no-clear 'vector))
        )
    (dotimes (i (min 64 (-> av node-list length)))
      (vector<-cspace! p (-> av node-list data i))
      (vector-! p p (-> av root trans))
      (if (not first?)
          (+! sum (vector-vector-distance p (-> *smoke-joints* i)))
          )
      (vector-copy! (-> *smoke-joints* i) p)
      )
    sum
    )
  )

(defbehavior smoke-pose-watch process ((tag string) (secs float) (old-pace? symbol))
  "For SECS, nothing pressed: the mean motion of the model's joints against its root each game
   frame, in centimeters, recorded as a GIF (TAG). OLD-PACE? plays the clip at the build's own speed,
   a clip frame each game frame, as before the fix: each frame this adds 0.75 to the frame the
   class code advanced by 0.25 (the joints are computed again after it, `bf-avatar-cam-post`)."
  (smoke-neutral)
  (smoke-rec-start tag 2)
  (let ((t0 (smoke-now))
        (frames 0)
        (total 0.0)
        )
    (when (smoke-av)
      (smoke-pose-step (smoke-av) #t)
      )
    (while (and (smoke-av) (< (- (smoke-now) t0) (the int (* secs 300.0))))
      (let* ((av (smoke-av))
             (ch (-> av skel root-channel 0))
             )
        (when old-pace?
          (let ((n (the float (+ (-> ch frame-group frames num-frames) -1)))
                (f (+ (-> ch frame-num) 0.75))
                )
            (set! (-> ch frame-num) (if (>= f n) (- f n) f))
            )
          )
        (+! total (smoke-pose-step av #f))
        (+! frames 1)
        )
      (suspend)
      )
    (smoke-rec-stop)
    (let ((cm (/ (* 100.0 (/ total (meters 1))) (the float (max 1 frames)))))
      (format 0 "SMOKE pose ~S: ~D frames, joints moved ~f cm a game frame (summed over the joints), clip ~D~%"
              tag frames cm (if (smoke-av) (-> (smoke-av) anim) -1))
      cm
      )
    )
  )

(defbehavior smoke-jet-log process ((tag string) (secs float))
  "For SECS, every 0.25 s: Jak's height over his ground, his state, the jetpack's fuel and clip."
  (let ((t0 (smoke-now)))
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (let ((av (smoke-av)))
        (format 0 "SMOKE ~S: Jak ~M above his ground, state ~A, fuel ~f, clip ~D~%" tag
                (- (-> *target* control trans y) (-> *target* control gspot-pos y)) (-> *target* state name)
                (if av (-> av fuel) -1.0) (if av (-> av anim) -1))
        )
      (smoke-wait 0.25)
      )
    )
  0
  )

;; ----------------------------------------------------------------------------
;; Endurance: long fights, the player's death and respawn, a restart
;; ----------------------------------------------------------------------------

;; Pickup rate: every real unit death goes through `bf-queue-drop` (battlefront-h.gc, called by
;; bf-unit-killed); this copy of it counts the deaths it saw with room in the queue and the drops
;; they left.
(define *smoke-deaths* 0)
(define *smoke-drops* 0)
(define-perm *smoke-stock-queue-drop* (function process none) bf-queue-drop)

(defun bf-queue-drop ((proc process))
  "The stock `bf-queue-drop`, counted (`*smoke-deaths*`, `*smoke-drops*`)."
  (let ((n (-> *bf* drop-count)))
    (*smoke-stock-queue-drop* proc)
    (when (and (type? proc process-drawable) (< n BF_DROP_MAX))
      (+! *smoke-deaths* 1)
      (if (< n (-> *bf* drop-count))
          (+! *smoke-drops* 1)
          )
      )
    )
  (none)
  )

(defbehavior smoke-free-fight process ((class int) (secs float))
  "SECS of fighting as CLASS: strafing left and right and turning, R1 held, then one of the class's
   own moves in turn (guards: a dodge, a weapon change, the rifle butt; jetpacks: a climb, a way
   down, a dive kick; robotguard: a roll, the shield, a punch; spider: a bite, a sprint, a high
   jump)."
  (let ((t0 (smoke-now))
        (n 0)
        )
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (smoke-step "free fight: strafe, turn and fire")
      (smoke-stick (if (zero? (logand n 1)) 30 225) 90 (if (zero? (logand n 2)) 190 70) 128)
      (smoke-hold (pad-buttons r1))
      (smoke-wait 1.5)
      (smoke-hold (the-as pad-buttons 0))
      (smoke-stick 128 128 128 128)
      (case class
        ((BF_CLASS_BLUE_GUARD BF_CLASS_RED_GUARD)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: dodge")
            (smoke-press (if (zero? (logand n 1)) (pad-buttons l2) (pad-buttons r2)) 1.0)
            )
           ((1)
            (smoke-step "free fight: weapon change")
            (smoke-press (case (mod n 9) ((1) (pad-buttons left)) ((4) (pad-buttons up)) (else (pad-buttons down))) 0.6)
            )
           (else
             (smoke-step "free fight: rifle butt")
             (smoke-press (pad-buttons square) 1.0)
             )
           )
         )
        ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: jetpack climb")
            (smoke-hold (pad-buttons x))
            (smoke-wait 0.8)
            (smoke-hold (the-as pad-buttons 0))
            )
           ((1)
            (smoke-step "free fight: jetpack down")
            (smoke-hold (pad-buttons circle))
            (smoke-wait 0.8)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: dive kick")
             (smoke-press (pad-buttons square) 1.2)
             )
           )
         )
        ((BF_CLASS_ROBOGUARD)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: roll")
            (smoke-press (pad-buttons r2) 1.4)
            )
           ((1)
            (smoke-step "free fight: shield")
            (smoke-hold (pad-buttons circle))
            (smoke-wait 1.2)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: punch")
             (smoke-press (pad-buttons square) 1.2)
             )
           )
         )
        ((BF_CLASS_SPYDROID)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: bite")
            (smoke-press (pad-buttons circle) 0.8)
            )
           ((1)
            (smoke-step "free fight: sprint")
            (smoke-stick 128 0 128 128)
            (smoke-hold (pad-buttons r2))
            (smoke-wait 1.0)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: high jump")
             (smoke-hold (pad-buttons x))
             (smoke-wait 0.8)
             (smoke-hold (the-as pad-buttons 0))
             )
           )
         )
        )
      (+! n 1)
      )
    )
  (smoke-neutral)
  0
  )

(defbehavior smoke-kill-player process ()
  "A deadly generic attack on the player from this process (the invulnerable secret lifted for
   it, then put back as it was)."
  (let ((invuln? (logtest? (-> *game-info* secrets) (game-secrets invulnerable)))
        (id (+ (-> *game-info* attack-id) 1))
        (msg (new 'stack-no-clear 'event-message-block))
        )
    (logclear! (-> *game-info* secrets) (game-secrets invulnerable))
    (set! (-> *game-info* attack-id) id)
    (set! (-> msg from) (process->ppointer self))
    (set! (-> msg num-params) 2)
    (set! (-> msg message) 'attack)
    (set! (-> msg param 0) (the-as uint #f))
    (set! (-> msg param 1)
          (the-as uint (static-attack-info :mask (vehicle-impulse-factor) ((id id)
                                                                           (damage 100.0)
                                                                           (vehicle-damage-factor 1.0)
                                                                           (vehicle-impulse-factor 1.0)
                                                                           (mode 'generic)
                                                                           )
                                  )
                   )
          )
    (send-event-function *target* msg)
    (if invuln?
        (logior! (-> *game-info* secrets) (game-secrets invulnerable))
        )
    )
  0
  )

(defbehavior smoke-death-check process ((tag string))
  "The player killed: his side loses one, the camera watches an ally while the class model is
   gone, then he is back at the spawn as the same class, the battle camera on him again."
  (smoke-step "player death")
  (smoke-neutral)
  (let ((class (-> *bf* class))
        (lost (-> *bf* losses (-> *bf* team)))
        )
    (smoke-kill-player)
    (smoke-wait 1.0)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE ~S dead: respawn pending ~A, avatar ~A, camera ~A~%" tag (nonzero? (-> *bf* respawn-time))
              (bf-avatar-alive?) (if slave (-> slave 0 state name) 'none))
      )
    (smoke-check "the killed player waits to respawn, his class model gone"
                 (and (nonzero? (-> *bf* respawn-time)) (not (bf-avatar-alive?)))
                 )
    (smoke-wait-for 15.0 (lambda () (and (zero? (-> *bf* respawn-time)) (bf-avatar-alive?))))
    (smoke-wait 1.5)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE ~S respawned: class ~D (was ~D), losses ~D (were ~D)," tag (-> *bf* class) class
              (-> *bf* losses (-> *bf* team)) lost)
      (format 0 " camera ~A, state ~A~%" (if slave (-> slave 0 state name) 'none) (-> *target* state name))
      (smoke-check "back at the spawn as the same class, one more loss, the battle camera on him"
                   (and (bf-avatar-alive?)
                        (= (-> *bf* class) class)
                        (< lost (-> *bf* losses (-> *bf* team)))
                        slave
                        (= (-> slave 0 state name) 'cam-pov)
                        (not (focus-test? *target* dead))
                        )
                   )
      )
    )
  0
  )

(defbehavior smoke-restart process ()
  "START > Gamemode > Battlefront > Restart the battle: both reserves full again, the same class,
   the battle camera."
  (smoke-step "restart the battle")
  (smoke-neutral)
  (let ((class (-> *bf* class)))
    (smoke-start-page 'bf-battlefront)
    (smoke-menu-goto 2)
    (smoke-press (pad-buttons x) 3.0)
    (smoke-wait-for 90.0 (lambda () (and (bf-fighting?) (bf-avatar-alive?))))
    (smoke-wait 2.0)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE restart: reserves ~D ~D, class ~D (was ~D), camera ~A~%" (-> *bf* reserve 0) (-> *bf* reserve 1)
              (-> *bf* class) class (if slave (-> slave 0 state name) 'none))
      (smoke-check "Restart the battle: the same class at the spawn, the battle camera"
                   (and (bf-avatar-alive?) (= (-> *bf* class) class) slave (= (-> slave 0 state name) 'cam-pov))
                   )
      )
    )
  0
  )

(defbehavior smoke-endurance process ((zone int) (team int) (secs float))
  "A battle in ZONE on side TEAM: each class of the side fights SECS (`smoke-free-fight`), then the
   player is killed and respawns (`smoke-death-check`); a restart at the end, then Quit."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start zone team)
  (smoke-deploy 0 "endurance first class")
  (dotimes (i (if (= team BF_TEAM_FF) 2 4))
    (when (> i 0)
      (smoke-change-class i "endurance next class")
      )
    (format 0 "SMOKE endurance class ~D for ~D s~%" (-> *bf* class) (the int secs))
    (smoke-free-fight (-> *bf* class) secs)
    (smoke-status "endurance")
    (smoke-check "still in the battle after the long fight" (and *target* (bf-fighting?)))
    (smoke-death-check "endurance")
    )
  (smoke-restart)
  (smoke-free-fight (-> *bf* class) 10.0)
  (let ((rate (/ (the float *smoke-drops*) (the float (max 1 *smoke-deaths*)))))
    (format 0 "SMOKE pickups: ~D of ~D unit deaths left one (~f)~%" *smoke-drops* *smoke-deaths* rate)
    (smoke-check "3 of every 10 fallen units leave a pickup" (and (< 100 *smoke-deaths*) (< 0.28 rate) (< rate 0.32)))
    )
  (smoke-quit)
  0
  )

;; ----------------------------------------------------------------------------
;; The scenarios
;; ----------------------------------------------------------------------------

(defun smoke-guard-masks ()
  "The guards of the battle near the player and their hidden mesh segments (draw-control seg-mask:
   a set bit hides that segment; a blue guard's 1 and 2 are its two armors, normal and dark guard,
   so both set leave its legs alone). Prints each such guard. Returns how many."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        (bare 0)
        )
    (set! (-> probe w) (meters 150))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and (= (handle->process (process->handle proc)) proc) (= (-> proc type symbol) 'crimson-guard))
              (+! n 1)
              (let ((draw (-> (the-as process-drawable proc) draw)))
                (when (= (logand (-> draw seg-mask) 6) 6)
                  (+! bare 1)
                  (format 0 "SMOKE guard with both armors hidden: pid ~D ~S seg-mask ~X effect-mask ~X state ~A~%"
                          (-> proc pid) (bf-art-name proc) (-> draw seg-mask) (-> draw effect-mask) (-> proc state name))
                  )
                )
              )
            )
          )
        )
      )
    (format 0 "SMOKE guards near: ~D, ~D with both armors hidden~%" n bare)
    bare
    )
  )

(defbehavior smoke-tazer-walk process ()
  "The tazer struck while walking ahead, filmed (smoke-rec-tazer-*): the stab plays on the upper
   body (its clip is the upper body's 0.2 s after R1) and Jak keeps walking (his move in the 1.2 s
   after the strike against the 1.2 s before)."
  (smoke-step "tazer while walking")
  (smoke-press (pad-buttons left) 1.0)
  (set! (-> *bf* tazer-time) 0)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.8)
  (let ((p0 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
    (smoke-rec-start "tazer" 2)
    (smoke-wait 1.2)
    (let ((before (/ (vector-vector-xz-distance (-> *target* control trans) p0) (meters 1)))
          (p1 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
          (stab? #f)
          )
      (smoke-tap (pad-buttons r1) 4)
      (smoke-wait 0.2)
      (when (smoke-av)
        (let ((top (-> (smoke-av) skel top-anim))
              (clip (-> (smoke-av) draw art-group data BF_CLIP_TAZER))
              )
          (if top
              (set! stab? (or (= (-> top frame-group) clip) (= (-> top frame-targ) clip)))
              )
          )
        )
      (smoke-wait 1.0)
      (smoke-rec-stop)
      (smoke-stick 128 128 128 128)
      (let ((after (/ (vector-vector-xz-distance (-> *target* control trans) p1) (meters 1))))
        (format 0 "SMOKE tazer while walking: stab on the upper body ~A, ~f m in the 1.2 s before the strike, ~f m in the 1.2 s after~%"
                stab? before after)
        (smoke-check "the tazer's stab plays on the upper body" stab?)
        (smoke-check "the guard walks on while it strikes" (< (* 0.6 before) after))
        )
      )
    )
  (smoke-press (pad-buttons down) 1.0)
  0
  )

(defbehavior smoke-look-at-jetpack process ()
  "The nearest jetpack guard within 80 m: Jak brought 8 m from it, the camera turned and tilted
   toward it, two screenshots of its flames (smoke-jet-flames, -2). Returns #t when one was found."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (best (the-as process-drawable #f))
        (best-dist (meters 80))
        )
    (set! (-> probe w) (meters 80))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and (= (handle->process (process->handle proc)) proc) (bf-hover-art? proc))
              (let ((d (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe)))
                (when (< d best-dist)
                  (set! best-dist d)
                  (set! best (the-as process-drawable proc))
                  )
                )
              )
            )
          )
        )
      )
    (when best
      ;; Jak brought 8 m from it, at his own height, for a close look
      (let ((d (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (-> best root trans))))
        (set! (-> d y) 0.0)
        (vector-normalize! d (meters 8))
        (vector+! d d (-> best root trans))
        (set! (-> d y) (-> *target* control trans y))
        (move-to-point! (-> *target* control) d)
        )
      (let ((h (process->handle best)))
        (dotimes (i 3)
          (let ((p (the-as process-drawable (handle->process h))))
            (when p
              (let ((d (vector-! (new 'stack-no-clear 'vector) (-> p root trans) (-> *target* control trans))))
                (set! (-> *bf* view-yaw) (vector-y-angle d))
                (set! (-> *bf* view-pitch) (fmax (degrees -30) (fmin (degrees 35) (atan (-> d y) (vector-xz-length d)))))
                )
              )
            )
          (smoke-wait 0.4)
          )
        )
      (format 0 "SMOKE jetpack guard ~M away~%" best-dist)
      (smoke-shot "jet-flames")
      (smoke-wait 0.3)
      (smoke-shot "jet-flames-2")
      (smoke-wait 0.5)
      (set! (-> *bf* view-pitch) 0.0)
      )
    (if best #t #f)
    )
  )

;; the transports' count of each side's units awake (CWI, linked after GAME)
(define-extern bf-transport-team-count (function int (pointer int32) int))

(defun smoke-points-line ((tag string))
  "One line per battle point: its holder, capture, units of each side near it, its ship."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (format 0 "SMOKE point ~S ~D: owner ~D prog ~D" tag i (-> pt owner) (-> pt prog-team))
      (format 0 " ~f near ~D/~D ship ~A" (-> pt progress) (-> pt near 0) (-> pt near 1) (if (handle->process (-> pt ship)) #t #f))
      (format 0 " at ~M ~M ~M~%" (-> pt pos x) (-> pt pos y) (-> pt pos z))
      )
    )
  0
  )

(defun smoke-team-line ((tag string))
  "Units awake of each side (bf-transport.gc counts) and ships up."
  (let ((c (new 'stack-no-clear 'array 'int32 4))
        (ships 0)
        )
    (dotimes (i (-> *bf* point-count))
      (if (handle->process (-> *bf* points i ship))
          (+! ships 1)
          )
      )
    (format 0 "SMOKE units ~S: FF ~D (" tag (bf-transport-team-count BF_TEAM_FF c))
    (format 0 "~D guards ~D jets) KG ~D (" (-> c 0) (-> c 1) (bf-transport-team-count BF_TEAM_KG c))
    (format 0 "~D guards ~D jets ~D robots ~D spiders), ships ~D" (-> c 0) (-> c 1) (-> c 2) (-> c 3) ships)
    (format 0 ", losses ~D/~D, default nav mesh ~D of ~D~%" (-> *bf* losses 0) (-> *bf* losses 1)
            (-> *default-nav-mesh* nav-control-count) (-> *default-nav-mesh* max-nav-control-count))
    )
  0
  )

(defbehavior smoke-look-at process ((pos vector) (up float))
  "Turn the battle camera toward POS, from 2 m above Jak's feet, tilted UP rotation units more."
  (let ((d (vector-! (new 'stack-no-clear 'vector) pos (-> *target* control trans))))
    (set! (-> *bf* view-yaw) (vector-y-angle d))
    (set! (-> *bf* view-pitch) (+ up (atan (- (-> d y) (meters 2)) (vector-xz-length d))))
    )
  0
  )

(defbehavior smoke-look-at-ship process ()
  "The camera on the nearest troop transport within 150 m: a screenshot (smoke-ship). #t when one."
  (let ((best -1)
        (best-d (meters 150))
        )
    (dotimes (i (-> *bf* point-count))
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
        (when ship
          (let ((d (vector-vector-distance (-> ship root trans) (-> *target* control trans))))
            (when (< d best-d)
              (set! best-d d)
              (set! best i)
              )
            )
          )
        )
      )
    (when (>= best 0)
      ;; the ship looked up again after the wait: a process pointer kept across it can go stale
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points best ship)))))
        (if ship
            (smoke-look-at (-> ship root trans) 0.0)
            )
        )
      (smoke-wait 1.0)
      (smoke-shot "ship")
      (let ((ship (handle->process (-> *bf* points best ship))))
        (format 0 "SMOKE ship of point ~D, ~M away, state ~A~%" best best-d (if ship (-> ship next-state name) 'gone))
        )
      )
    (set! (-> *bf* view-pitch) 0.0)
    (>= best 0)
    )
  )

;; the troop transports' ground probe and sky test, a unit back to its pool (bf-transport.gc, CWI)
(define-extern bf-transport-sleep (function process symbol))
(define-extern bf-transport-ground (function vector symbol))
(define-extern bf-transport-sky? (function vector symbol))

(defun smoke-ships-sky ()
  "Each troop transport up: nothing above the ground under it (`bf-transport-sky?`). #t when every
   one is clear, and at least one is up."
  (let ((ok #t)
        (n 0)
        (at (new 'stack-no-clear 'vector))
        )
    (dotimes (i (-> *bf* point-count))
      (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
        (when ship
          (+! n 1)
          (vector-copy! at (-> ship root trans))
          (let ((ground? (bf-transport-ground at))
                (clear? (bf-transport-sky? at))
                )
            (format 0 "SMOKE ship of point ~D at ~M ~M ~M, ~M from its point, sky clear ~A~%" i (-> at x) (-> at y) (-> at z)
                    (vector-vector-xz-distance at (-> *bf* points i pos)) clear?)
            (if (not (and ground? clear?))
                (set! ok #f)
                )
            )
          )
        )
      )
    (and ok (< 0 n))
    )
  )

(defun smoke-count-near ((team int) (pos vector) (radius float))
  "Living units of side TEAM within RADIUS of POS (the actor hash), the player aside."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) pos))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        )
    (set! (-> probe w) radius)
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and proc (= (handle->process (process->handle proc)) proc) (!= proc *target*)
                       (type? proc process-focusable)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (= (bf-unit-team proc) team)
                       (< (vector-vector-distance (-> (the-as process-focusable proc) root trans) pos) radius)
                       )
              (+! n 1)
              )
            )
          )
        )
      )
    n
    )
  )

(defbehavior smoke-pick-point process ((want int))
  "On the open respawn page: D-pad right until point WANT is picked (8 presses at most), then X."
  (dotimes (k 8)
    (if (!= (-> *bf* respawn-pick) want)
        (smoke-press (pad-buttons right) 0.5)
        )
    )
  (format 0 "SMOKE respawn pick ~D (want ~D)~%" (-> *bf* respawn-pick) want)
  (smoke-press (pad-buttons x) 1.0)
  0
  )

(defbehavior smoke-shield-check process ()
  "Right after a deployment or a respawn: Jak invulnerable and his class model blinking for 3 s,
   then steady and vulnerable. #t when so."
  (let ((shown 0)
        (hidden 0)
        (invuln? (logtest? (-> *target* target-flags) (target-flags tinvuln1 tinvuln2)))
        )
    (dotimes (k 40)
      (let ((av (smoke-av)))
        (if (and av (logtest? (-> av draw status) (draw-control-status no-draw)))
            (+! hidden 1)
            (+! shown 1)
            )
        )
      (suspend)
      )
    (smoke-wait 3.5)
    (let ((av (smoke-av)))
      (format 0 "SMOKE spawn shield: invulnerable ~A, blink ~D hidden ~D shown in 40 frames; after: hidden ~A, invulnerable ~A~%"
              invuln? hidden shown (if av (logtest? (-> av draw status) (draw-control-status no-draw)) 'none)
              (logtest? (-> *target* target-flags) (target-flags tinvuln1 tinvuln2)))
      (and invuln? (< 3 hidden) (< 3 shown) av (not (logtest? (-> av draw status) (draw-control-status no-draw)))
           (not (logtest? (-> *target* target-flags) (target-flags tinvuln1 tinvuln2)))
           )
      )
    )
  )

(defun smoke-ship-over ((i int))
  "The distance (m) from point I to the ship over it on the ground plane, -1.0 for none."
  (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship)))))
    (if ship
        (/ (vector-vector-xz-distance (-> ship root trans) (-> *bf* points i pos)) (meters 1))
        -1.0
        )
    )
  )

(define-extern bf-post-point (function process integer))
(define *smoke-point* 0)

(defun smoke-point-open ((i int))
  "Point I on open ground: moved there once its section loaded (`snapped?`), the ground right under
   it, a nav mesh within 2 m, nothing above it up to 60 m, its ship within 1 m over it. #t when so."
  (let* ((pt (-> *bf* points i))
         (at (vector-copy! (new 'stack-no-clear 'vector) (-> pt pos)))
         (ground? (bf-transport-ground at))
         (off (fabs (- (-> at y) (-> pt pos y))))
         (mesh? (if (find-nearest-nav-mesh (-> pt pos) 8192.0) #t #f))
         (sky? (bf-transport-sky? (-> pt pos)))
         (ship (smoke-ship-over i))
         )
    (format 0 "SMOKE point ~D ~S: owner ~D, snapped ~A, " i (bf-point-name i) (-> pt owner) (-> pt snapped?))
    (format 0 "ground ~A ~M off, nav mesh ~A, sky clear ~A, ship ~f m off~%" ground? off mesh? sky? ship)
    (and (-> pt snapped?) ground? (< off (meters 1)) mesh? sky? (<= 0.0 ship) (< ship 1.0))
    )
  )

(defun smoke-walkers ((i int) (team int))
  "Guards of side TEAM within 15 m of point I that walked there: crimson guards (no jetpack, robot or
   spider) out of their ship (not in exit-transport), on the ground (within 4 m of the point's
   height), not posted on it by a ship over it (bf-transport.gc `bf-post-point`)."
  (let ((pos (-> *bf* points i pos))
        (probe (new 'stack-no-clear 'vector))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        )
    (vector-copy! probe pos)
    (set! (-> probe w) BF_POINT_RADIUS)
    (countdown (k (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes k) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and proc (= (handle->process (process->handle proc)) proc)
                       (= (-> proc type symbol) 'crimson-guard)
                       (= (bf-unit-team proc) team)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (!= (-> proc next-state name) 'exit-transport)
                       (< (vector-vector-xz-distance (-> (the-as process-drawable proc) root trans) pos) BF_POINT_RADIUS)
                       (< (fabs (- (-> (the-as process-drawable proc) root trans y) (-> pos y))) (meters 4))
                       (!= (bf-post-point proc) i)
                       )
              (+! n 1)
              )
            )
          )
        )
      )
    n
    )
  )

(defun smoke-posted ((i int) (team int))
  "Units of side TEAM posted on point I (`*bf-posts*`) and within 30 m of it, alive."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        )
    (set! (-> probe w) (meters 30))
    (countdown (k (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes k) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and proc (= (handle->process (process->handle proc)) proc) (!= proc *target*)
                       (type? proc process-focusable)
                       (= (bf-unit-team proc) team)
                       (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                       (= (bf-post-point proc) i)
                       (< (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe) (meters 30))
                       )
              (+! n 1)
              )
            )
          )
        )
      )
    n
    )
  )

(defun smoke-clear-point ((i int) (team int))
  "Every unit of side TEAM within 40 m of point I back to its pool (bf-transport.gc
   `bf-transport-sleep`): the side's units come back from elsewhere. Returns how many."
  (let ((n 0))
    (dotimes (pass 4)
      (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
            (shapes (new 'stack-no-clear 'array 'collide-shape 64))
            )
        (set! (-> probe w) (meters 40))
        (countdown (k (fill-actor-list-for-box *actor-hash* probe shapes 64))
          (let ((shape (as-type (-> shapes k) collide-shape)))
            (when shape
              (let ((proc (-> shape process)))
                (when (and proc (= (handle->process (process->handle proc)) proc) (!= proc *target*)
                           (type? proc process-focusable)
                           (= (bf-unit-team proc) team)
                           (not (focus-test? (the-as process-focusable proc) inactive disable dead))
                           (< (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe) (meters 40))
                           (bf-transport-sleep proc)
                           )
                  (+! n 1)
                  )
                )
              )
            )
          )
        )
      (suspend)
      )
    n
    )
  )

(defun smoke-clear-line? ((a vector) (b vector))
  "#t when no scenery stands between A and B (a 0.5 m sphere swept from A to B)."
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (vector-copy! (-> cq start-pos) a)
    (vector-! (-> cq move-dist) b a)
    (set! (-> cq radius) (meters 0.5))
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (< (fill-and-probe-using-line-sphere *collide-cache* cq) 0.0)
    )
  )

(defun smoke-viewpoint ((i int) (aim vector) (out vector))
  "OUT gets where to film AIM (on or over point I) from: a spot 20, 25, 16 or 30 m from the point,
   of the 16 ways round it the first on the point's own nav mesh (the same open space: a sweep test
   against the scenery let a dock wall at the Port through), with ground within 2 m of the point's
   height and a clear view of AIM from 2 m above the spot (Jak) and from 4 m behind it, 3 m up (the
   camera). #f when none."
  (let ((pt (-> *bf* points i pos))
        (dir (new 'stack-no-clear 'vector))
        (head (new 'stack-no-clear 'vector))
        (cam (new 'stack-no-clear 'vector))
        (dists (new 'static 'array float 4 (meters 20) (meters 25) (meters 16) (meters 30)))
        (mesh (find-nearest-nav-mesh (-> *bf* points i pos) (meters 2)))
        )
    (dotimes (d 4)
      (dotimes (k 16)
        (set-vector! dir 0.0 0.0 (-> dists d) 1.0)
        (vector-rotate-around-y! dir dir (* (degrees 22.5) (the float k)))
        (vector+! out pt dir)
        (set! (-> out w) 1.0)
        (when (and (bf-transport-ground out) (< (fabs (- (-> out y) (-> pt y))) (meters 2))
                   (= (find-nearest-nav-mesh out (meters 2)) mesh)
                   )
          (vector-copy! head out)
          (+! (-> head y) (meters 2))
          (vector-normalize-copy! cam dir (meters 4))
          (vector+! cam cam out)
          (+! (-> cam y) (meters 3))
          (if (and (smoke-clear-line? head aim) (smoke-clear-line? cam aim))
              (return #t)
              )
          )
        )
      )
    )
  #f
  )

(defbehavior smoke-face process ((aim vector))
  "Jak turned toward AIM, as the director turns him at a respawn (battlefront.gc `bf-target-death`),
   and the battle camera too (`smoke-look-at`): after a far respawn the camera follows Jak's facing.
   Logs how far the camera's own heading is from AIM."
  (let ((dir (vector-! (new 'stack-no-clear 'vector) aim (-> *target* control trans))))
    (set! (-> dir y) 0.0)
    (when (< (meters 0.5) (vector-length dir))
      (vector-normalize! dir 1.0)
      (forward-up->quaternion (-> *target* control quat-for-control) dir *y-vector*)
      (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))
      (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
      )
    )
  (smoke-look-at aim 0.0)
  (smoke-wait 1.5)
  (let ((fwd (vector-copy! (new 'stack-no-clear 'vector) (-> *math-camera* inv-camera-rot fvec)))
        (want (vector-! (new 'stack-no-clear 'vector) aim (-> *math-camera* trans)))
        )
    (set! (-> fwd y) 0.0)
    (set! (-> want y) 0.0)
    (vector-normalize! fwd 1.0)
    (vector-normalize! want 1.0)
    (format 0 "SMOKE camera heading ~f from the aim's (1 = straight at it)~%" (vector-dot fwd want))
    )
  0
  )

(defbehavior smoke-film-point process ((i int))
  "Jak where nothing hides point I's ship (10 m over the point without one) from him or the camera
   (`smoke-viewpoint`), the camera on it: the ship and the point in view."
  (let ((ship (the-as process-drawable (handle->process (-> *bf* points i ship))))
        (aim (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
        (at (new 'stack-no-clear 'vector))
        )
    (if ship
        (vector-copy! aim (-> ship root trans))
        (+! (-> aim y) (meters 10))
        )
    (cond
      ((smoke-viewpoint i aim at)
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       (smoke-wait 1.5)
       (smoke-face aim)
       (format 0 "SMOKE film point ~D: Jak ~M from it, aim ~M above it, camera ~M from Jak, " i
               (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos))
               (- (-> aim y) (-> *bf* points i pos y)) (vector-vector-distance (-> *math-camera* trans) (-> *target* control trans)))
       (format 0 "~M above him, its view of the aim clear ~A~%" (- (-> *math-camera* trans y) (-> *target* control trans y))
               (smoke-clear-line? (-> *math-camera* trans) aim))
       )
      (else
        (format 0 "SMOKE no viewpoint on point ~D's ship~%" i)
        )
      )
    )
  (smoke-wait 1.0)
  0
  )

(defbehavior smoke-tour-point process ((i int) (tag string) (swapped string))
  "Point I given to the player's side, then a respawn there (a death, the respawn page): on open
   ground with its ship right over it (`smoke-point-open`); given to the other
   side, its ship leaves and the other side's takes its place."
  (smoke-step tag)
  (set! (-> *bf* points i owner) BF_TEAM_FF)
  (smoke-wait 1.0)
  ;; there through a death and the respawn page (the redeploy, T18, waits 30 s out of combat: the
  ;; other side's units filmed 20 m off keep hitting the invulnerable player)
  (smoke-invulnerable #f)
  (smoke-kill-player)
  (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
  (smoke-check "a death opens the respawn page" (>= (-> *bf* respawn-pick) 0))
  (smoke-pick-point i)
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
  (smoke-wait 2.0)
  (format 0 "SMOKE redeployed ~M from point ~D, level ~A~%"
          (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) i (-> *load-state* vis-nick))
  (smoke-check "redeployed on the point" (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) (meters 10)))
  (smoke-invulnerable #t)
  (set! *smoke-point* i)
  (smoke-wait-for 30.0 (lambda () (and (-> *bf* points *smoke-point* snapped?) (<= 0.0 (smoke-ship-over *smoke-point*)))))
  (smoke-wait 8.0)
  (smoke-check "the point on open ground, a ship of its holder right over it" (smoke-point-open i))
  (smoke-check "the ship comes down where nothing stands above it" (smoke-ships-sky))
  (smoke-film-point i)
  (smoke-shot tag)
  (let ((before (-> *bf* points i ship)))
    (set! (-> *bf* points i owner) BF_TEAM_KG)
    (smoke-wait 2.0)
    (let ((old (handle->process before)))
      (format 0 "SMOKE the old ship: ~A~%" (if old (-> old next-state name) 'gone))
      (smoke-check "taken by the other side, the losing side's ship leaves"
                   (and (!= (-> *bf* points i ship) before)
                        (or (not old) (= (-> old next-state name) 'leave) (= (-> old next-state name) 'die-fast))
                        )
                   )
      )
    )
  (smoke-wait-for 30.0 (lambda () (<= 0.0 (smoke-ship-over *smoke-point*))))
  (smoke-wait 8.0)
  (smoke-check "the new holder's ship takes its place, right over the point" (smoke-point-open i))
  (smoke-film-point i)
  (smoke-shot swapped)
  (smoke-team-line tag)
  0
  )

(defbehavior smoke-conquer-defend process ((team int) (i int) (leave string) (conquest string) (defense string))
  "Side TEAM just deployed at its base: its guards walk from their base's ship to control point I,
   neutral, and take it alone, Jak 16 to 30 m off it where nothing hides it (`smoke-viewpoint`);
   then I is given to the other side, TEAM's units around it sent back: the other side's ship comes
   over it, its units posted there hold it, and TEAM's guards walk back from their base to retake
   it. Clips LEAVE (at the base), CONQUEST and DEFENSE (every half second), shots CONQUEST and
   DEFENSE."
  (let ((foe (- 1 team))
        (aim (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points i pos)))
        )
    (+! (-> aim y) (meters 1.5))
    (smoke-step "conquest on foot")
    (smoke-wait 1.0)
    (smoke-rec-start leave 4)
    (smoke-wait 8.0)
    (smoke-rec-stop)
    (smoke-wait 22.0)
    (let ((at (new 'stack-no-clear 'vector)))
      (when (not (smoke-viewpoint i aim at))
        (vector-! at (-> *bf* points team pos) (-> *bf* points i pos))
        (set! (-> at y) 0.0)
        (vector-normalize! at (meters 25))
        (vector+! at at (-> *bf* points i pos))
        )
      (+! (-> at y) (meters 2))
      (move-to-point! (-> *target* control) at)
      )
    (smoke-wait 2.0)
    (smoke-face aim)
    (format 0 "SMOKE Jak ~M from point ~D ~S (a unit counts within 15 m), its side's base ~M from it~%"
            (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) i (bf-point-name i)
            (vector-vector-xz-distance (-> *bf* points team pos) (-> *bf* points i pos)))
    (smoke-rec-start conquest 30)
    (let ((k 0)
          (walkers 0)
          (jak-in 0)
          )
      (until (or (= (-> *bf* points i owner) team) (>= k 48))
        (smoke-wait 5.0)
        (+! k 1)
        (let ((w (smoke-walkers i team)))
          (set! walkers (max walkers w))
          (if (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points i pos)) BF_POINT_RADIUS)
              (+! jak-in 1)
              )
          (format 0 "SMOKE ~D s: point ~D owner ~D, capture by ~D ~f s, " (* k 5) i (-> *bf* points i owner)
                  (-> *bf* points i prog-team) (-> *bf* points i progress))
          (format 0 "side ~D: ~D within 15 m, ~D guards walked there~%" team (-> *bf* points i near team) w)
          )
        )
      (smoke-rec-stop)
      (smoke-wait 1.0)
      (smoke-check "the side's guards walk to the neutral point from their base's ship" (< 0 walkers))
      (smoke-check "they take it alone, the player never within its 15 m"
                   (and (= (-> *bf* points i owner) team) (zero? jak-in)))
      )
    (smoke-face aim)
    (smoke-shot conquest)
    (smoke-step "defense")
    (format 0 "SMOKE side ~D's units sent back from the point: ~D~%" team (smoke-clear-point i team))
    (set! (-> *bf* points i owner) foe)
    (smoke-face aim)
    (smoke-rec-start defense 30)
    (let ((k 0)
          (posted 0)
          (held 0)
          (kept 0)
          (both 0)
          (attackers 0)
          (lost-us (-> *bf* losses team))
          (lost-foe (-> *bf* losses foe))
          )
      (while (< k 36)
        (smoke-wait 5.0)
        (+! k 1)
        (let ((d (smoke-count-near foe (-> *bf* points i pos) BF_POINT_RADIUS))
              (a (smoke-count-near team (-> *bf* points i pos) BF_POINT_RADIUS))
              (p (smoke-posted i foe))
              (w (smoke-walkers i team))
              )
          (set! posted (max posted p))
          (set! attackers (max attackers w))
          ;; its defenders counted once the first of them is down from the ship
          (when (and (= (-> *bf* points i owner) foe) (< 0 posted))
            (+! held 1)
            (if (< 0 d)
                (+! kept 1)
                )
            )
          (if (and (< 0 d) (< 0 a))
              (+! both 1)
              )
          (format 0 "SMOKE ~D s: point ~D owner ~D, capture by ~D ~f s, " (* k 5) i (-> *bf* points i owner)
                  (-> *bf* points i prog-team) (-> *bf* points i progress))
          (format 0 "defenders (side ~D) ~D within 15 m (~D posted within 30 m), attackers ~D (~D guards walked there), ship ~A~%"
                  foe d p a w (if (handle->process (-> *bf* points i ship)) #t #f))
          )
        )
      (smoke-rec-stop)
      (smoke-wait 1.0)
      (smoke-shot defense)
      (format 0 "SMOKE defense: held ~D counts, defenders on it in ~D; both sides on it in ~D; losses attackers ~D, defenders ~D; owner at the end ~D~%"
              held kept both (- (-> *bf* losses team) lost-us) (- (-> *bf* losses foe) lost-foe) (-> *bf* points i owner))
      (smoke-check "the holder's ship drops units posted on its point" (< 0 posted))
      (smoke-check "the holder's units stay on the point it holds (on it in 4 counts of 5 or more)"
                   (and (< 0 held) (<= (* 4 held) (* 5 kept))))
      (smoke-check "the other side's guards walk back from their base to retake it" (< 0 attackers))
      (smoke-check "the sides fight on the point" (< 0 both))
      )
    )
  0
  )

(defun smoke-levels-line ((tag string))
  "Each level slot: its level, status and chunks of the level heap; the battle's hold on the city."
  (format 0 "SMOKE levels ~S (city-load ~D):~%" tag (-> *bf* city-load))
  (dotimes (i 10)
    (let ((lev (-> *level* level i)))
      (if (!= (-> lev status) 'inactive)
          (format 0 "SMOKE   slot ~D ~A ~A chunks #x~X~%" i (-> lev name) (-> lev status) (-> lev memory-mask))
          )
      )
    )
  ;; the trees the background drew last frame (background-h.gc: 32 of each kind at most)
  (format 0 "SMOKE   trees: tfrag ~D trans ~D water ~D shrub ~D tie ~D~%"
          (-> *background-work* tfrag-tree-count)
          (-> *background-work* tfrag-trans-tree-count)
          (-> *background-work* tfrag-water-tree-count)
          (-> *background-work* shrub-tree-count)
          (-> *background-work* tie-tree-count)
          )
  0
  )

(defun smoke-dots-line ((tag string))
  "The units awake (`*bf-unit-dots*`) of each side, and how many stand within 250 m of each point."
  (format 0 "SMOKE dots ~S:" tag)
  (dotimes (i (-> *bf* point-count))
    (let ((ff 0)
          (kg 0)
          )
      (dotimes (k (-> *bf-unit-dots* count))
        (when (< (vector-vector-xz-distance (-> *bf-unit-dots* pos k) (-> *bf* points i pos)) (meters 250))
          (if (= (-> *bf-unit-dots* team k) BF_TEAM_FF)
              (+! ff 1)
              (+! kg 1)
              )
          )
        )
      (format 0 " p~D ~D/~D" i ff kg)
      )
    )
  (format 0 "~%")
  0
  )

(defbehavior smoke-field-walk process ((x float) (y float) (z float) (to-x float) (to-z float) (tag string))
  "Jak set on the ground at X, Z (meters, Y a height to probe down from), turned toward TO-X, TO-Z
   (a force field between), filmed (TAG, a shot then a clip) while he runs at it 5 s, the stick held
   forward. Returns how far past the field's line he got toward TO, in meters: 0 or less when it
   held him."
  (let ((at (new 'stack-no-clear 'vector))
        (to (new 'stack-no-clear 'vector))
        )
    (set-vector! at (meters x) (meters y) (meters z) 1.0)
    (bf-transport-ground at)
    (+! (-> at y) (meters 1))
    (move-to-point! (-> *target* control) at)
    (set-vector! to (meters to-x) (+ (-> at y) (meters 3)) (meters to-z) 1.0)
    (smoke-wait 1.5)
    (smoke-face to)
    (smoke-shot tag)
    (smoke-wait 1.0)
    (smoke-rec-start tag 4)
    (smoke-stick 128 0 128 128)
    (smoke-wait 5.0)
    (smoke-neutral)
    (smoke-wait 0.5)
    (smoke-rec-stop)
    ;; the field's line is halfway between the start and TO: how far past it, toward TO
    (let* ((dir (vector-! (new 'stack-no-clear 'vector) to at))
           (len (vector-xz-length dir))
           (moved (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) at))
           )
      (set! (-> dir y) 0.0)
      (vector-normalize! dir 1.0)
      (set! (-> moved y) 0.0)
      (let ((along (/ (- (vector-dot moved dir) (* 0.5 len)) (meters 1))))
        (format 0 "SMOKE field ~S: Jak ran ~M toward it, ~f m past its line~%" tag (vector-dot moved dir) along)
        along
        )
      )
    )
  )

(defbehavior smoke-door-check process ((name string))
  "Jak 3 m in front of door NAME (a com-airlock, its front along its local z), facing it, 3 s: the
   door stays shut ('close). Jak goes to its entity first and waits for it, 6 s at most: the game
   starts an actor only near it. #t when so; #f when it opens, 'none when it never starts."
  (let ((e (the-as entity-actor (entity-by-name name))))
    (when e
      (let ((front (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> e quat)))
            (at (new 'stack-no-clear 'vector))
            )
        (set! (-> front y) 0.0)
        (vector-normalize! front (meters 3))
        (vector+! at (-> e trans) front)
        (+! (-> at y) (meters 1))
        (move-to-point! (-> *target* control) at)
        (let ((n 0))
          (until (or (process-by-ename name) (>= n 12))
            (smoke-wait 0.5)
            (+! n 1)
            )
          )
        )
      )
    )
  (let ((door (the-as process-drawable (process-by-ename name))))
    (cond
      ((not door)
       (format 0 "SMOKE door ~S not loaded~%" name)
       'none
       )
      (else
        (let ((front (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> door root quat)))
              (at (new 'stack-no-clear 'vector))
              (aim (vector-copy! (new 'stack-no-clear 'vector) (-> door root trans)))
              )
          (set! (-> front y) 0.0)
          (vector-normalize! front (meters 3))
          (vector+! at (-> door root trans) front)
          (+! (-> at y) (meters 1))
          (move-to-point! (-> *target* control) at)
          (+! (-> aim y) (meters 2))
          (smoke-wait 1.0)
          (smoke-face aim)
          (smoke-wait 3.0)
          (let ((door2 (the-as process-drawable (process-by-ename name))))
            (format 0 "SMOKE door ~S: Jak ~M from it, its state ~A~%" name
                    (vector-vector-xz-distance (-> *target* control trans) (-> door2 root trans))
                    (if door2 (-> door2 next-state name) 'gone))
            (and door2 (!= (-> door2 next-state name) 'open))
            )
          )
        )
      )
    )
  )

;; ----------------------------------------------------------------------------
;; Round 20: the minimap's marks, the drops' points
;; ----------------------------------------------------------------------------

(define-extern bf-city-unit-minimap (function process connection-minimap))
(define-extern bf-city-guard-speed (function float))
(define-extern bf-city-march-count (function int int))
(define-extern bf-ways-reach (function int int))
(define-extern bf-ways-dump (function none))
(define-extern bf-city-send (function int int int int))
(define *smoke-sent* -1)
(define *smoke-zone0* 0)
(define *smoke-zone-max* 0)
(define-extern bf-ways-gap (function int int none))
(define-extern *bf-drops-at* (pointer int32))

(define *smoke-marks* (new 'static 'array int32 3 0 0 0))

(defun smoke-minimap-marks ((tag string))
  "The units awake whose mark on the game's minimap has their side's class (25 the guard's blue one
   for the Freedom League, 139 the robot's red one for the Krimzon Guard), those that do not, and
   the battle points marked with the black disc. Returns the wrong ones."
  (dotimes (i 3)
    (set! (-> *smoke-marks* i) 0)
    )
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (!= p *target*) (>= (bf-unit-team p) 0))
        (let ((mm (bf-city-unit-minimap p)))
          (when mm
            (if (= (-> mm class) (-> *minimap-class-list* (if (= (bf-unit-team p) BF_TEAM_FF) 25 139)))
                (+! (-> *smoke-marks* 0) 1)
                (+! (-> *smoke-marks* 1) 1)
                )
            )
          )
        )
      #t
      )
    *null-kernel-context*
    )
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (if (and (-> pt icon) (= (-> pt icon class) *bf-point-minimap-class*))
          (+! (-> *smoke-marks* 2) 1)
          )
      )
    )
  (format 0 "SMOKE marks ~S: ~D units in their side's color, ~D not, ~D of ~D points marked~%" tag
          (-> *smoke-marks* 0) (-> *smoke-marks* 1) (-> *smoke-marks* 2) (-> *bf* point-count))
  (-> *smoke-marks* 1)
  )

(defun smoke-default-mesh ((tag string))
  "Who holds the engine's default nav mesh's nav-controls: each battle kind, the others (the first
   three other types named)."
  (let ((m *default-nav-mesh*)
        (g 0)
        (tu 0)
        (ro 0)
        (sp 0)
        (o 0)
        )
    (format 0 "SMOKE default mesh ~S: ~D of ~D, others:" tag (-> m nav-control-count) (-> m max-nav-control-count))
    (dotimes (i (-> m nav-control-count))
      (let ((p (-> m nav-control-array i process)))
        (when p
          (case (-> p type symbol)
            (('crimson-guard) (+! g 1))
            (('flying-turret) (+! tu 1))
            (('roboguard-city) (+! ro 1))
            (('spydroid) (+! sp 1))
            (else
              (if (< o 3)
                  (format 0 " ~A" (-> p type symbol))
                  )
              (+! o 1)
              )
            )
          )
        )
      )
    (format 0 "; guards ~D turrets ~D robots ~D spiders ~D others ~D~%" g tu ro sp o)
    )
  0
  )

(defbehavior smoke-fps process ((tag string))
  "Frames the game draws in 10 s of wall time (pc-get-unix-timestamp), printed."
  (let ((t0 (pc-get-unix-timestamp))
        (n 0)
        )
    (while (= (pc-get-unix-timestamp) t0)
      (suspend)
      )
    (set! t0 (pc-get-unix-timestamp))
    (while (< (- (pc-get-unix-timestamp) t0) 10)
      (+! n 1)
      (suspend)
      )
    (format 0 "SMOKE fps ~S: ~D frames in 10 s (~D a second)~%" tag n (/ n 10))
    n
    )
  )

(defbehavior smoke-wait-wall process ((secs int))
  "Suspend for SECS seconds of wall time."
  (let ((t0 (pc-get-unix-timestamp)))
    (while (< (- (pc-get-unix-timestamp) t0) secs)
      (suspend)
      )
    )
  0
  )

(defun smoke-drops-line ((tag string))
  "Units each side's ships dropped at each point since the counts were cleared; returns how many
   points a side dropped at, the most of the two."
  (let ((most 0))
    (dotimes (team 2)
      (let ((n 0))
        (format 0 "SMOKE drops ~S ~S:" tag (bf-team-name team))
        (dotimes (i (-> *bf* point-count))
          (format 0 " p~D ~D" i (-> *bf-drops-at* (+ (* 8 team) i)))
          (if (> (-> *bf-drops-at* (+ (* 8 team) i)) 0)
              (+! n 1)
              )
          )
        (format 0 "~%")
        (set! most (max most n))
        )
      )
    most
    )
  )

(defbehavior smoke-scenario process ()
  (format 0 "SMOKE start scenario ~D~%" SMOKE_SCENARIO)
  (smoke-boot)
  (case SMOKE_SCENARIO
    ((1)
     ;; T1: the Mods menu opens with L3 + SELECT, as every mod's; the mode's switch adds START >
     ;; Options > Gamemode; switched off, the stock Options page is back
     (format 0 "SMOKE bind ~X (L3 + SELECT is ~X)~%" *mods-menu-bind* (pad-buttons l3 select))
     (smoke-check "the Mods menu bind is L3 + SELECT" (= *mods-menu-bind* (pad-buttons l3 select)))
     (let ((n (-> *options-options-pc* options length)))
       (smoke-mods-toggle "mods-menu-on")
       (smoke-check "Battlefront mode on" *mod-battlefront-enable*)
       (smoke-check "START > Options gains Gamemode" (= (-> *options-options-pc* options length) (+ n 1)))
       (smoke-start-page 'options)
       (smoke-shot "options-gamemode")
       (when *progress-process*
         (set-next-state (-> *progress-process* 0) 'go-away 0)
         )
       (smoke-wait 2.0)
       (smoke-mods-toggle "mods-menu-off")
       (smoke-check "Battlefront mode off" (not *mod-battlefront-enable*))
       (smoke-check "START > Options back to the stock page" (= (-> *options-options-pc* options length) n))
       (smoke-check "no battle director while the mode is off" (not (bf-active?)))
       )
     )
    ((2)
     ;; T2 to T5, Freedom League at the Port: the page order, the camera, the blue classes played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-camera-checks)
     (smoke-play BF_CLASS_BLUE_GUARD "blue-guard")
     (smoke-change-class 1 "blue jetpack")
     (smoke-play BF_CLASS_BLUE_JETPACK "blue-jetpack")
     (smoke-quit)
     )
    ((3)
     ;; T4 and T5, Krimzon Guard in the Industrial Zone: every red class played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_KG)
     (smoke-deploy 0 "deploy red guard")
     (smoke-camera-checks)
     (smoke-play BF_CLASS_RED_GUARD "red-guard")
     (smoke-change-class 1 "red jetpack")
     (smoke-play BF_CLASS_RED_JETPACK "red-jetpack")
     (smoke-change-class 2 "robotguard")
     (smoke-play BF_CLASS_ROBOGUARD "robotguard")
     (smoke-change-class 3 "spider")
     (smoke-play BF_CLASS_SPYDROID "spider")
     (smoke-quit)
     )
    ((7)
     ;; T6 on film: a jetpack left alone at the clip pace before the fix and at the fixed one, on the
     ;; ground then hovering, in the same place
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 1 "deploy blue jetpack")
     (smoke-invulnerable #t)
     (smoke-step "jetpack on the ground, both paces")
     (let ((g-old (smoke-pose-watch "jet-ground-old" 3.0 #t))
           (g-new (smoke-pose-watch "jet-ground-new" 3.0 #f))
           )
       (smoke-step "jetpack up")
       (smoke-hold (pad-buttons x))
       (smoke-wait 1.5)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-wait 1.0)
       (smoke-step "jetpack hovering, both paces")
       (let ((h-old (smoke-pose-watch "jet-hover-old" 3.0 #t))
             (h-new (smoke-pose-watch "jet-hover-new" 3.0 #f))
             )
         (format 0 "SMOKE legs: ground ~f cm before, ~f after; hovering ~f before, ~f after~%" g-old g-new h-old h-new)
         (smoke-check "the jetpack's joints move at least three times less than before the fix, on the ground and hovering"
                      (and (< (* 3.0 g-new) g-old) (< (* 3.0 h-new) h-old))
                      )
         )
       )
     (smoke-quit)
     )
    ((5)
     ;; T7, Freedom League at the Freedom HQ: each class in a long fight, the player's death, a restart
     (smoke-endurance 3 BF_TEAM_FF 75.0)
     )
    ((6)
     ;; T7, Krimzon Guard in the Slums
     (smoke-endurance 2 BF_TEAM_KG 60.0)
     )
    ((4)
     ;; T6: a jetpack left alone, on the ground then in the air; T3 again on film: the camera turned
     ;; by the right stick, a strafe, a guard's rolls
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 1 "deploy blue jetpack")
     (smoke-invulnerable #t)
     (smoke-step "jetpack on the ground")
     (let ((g (smoke-hover-watch "jet-ground" 3.0)))
       (smoke-step "jetpack up")
       (smoke-hold (pad-buttons x))
       (smoke-jet-log "climb" 1.5)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-jet-log "let go" 1.0)
       (smoke-step "jetpack hovering")
       (let ((h (smoke-hover-watch "jet-hover" 3.0)))
         (smoke-check "a jetpack left alone keeps its clip, on the ground and in the air" (and (zero? g) (zero? h)))
         )
       )
     (smoke-change-class 0 "blue guard")
     (smoke-step "film the camera")
     (smoke-rec-start "tps" 2)
     (smoke-stick 128 128 255 128)
     (smoke-wait 1.0)
     (smoke-stick 128 128 0 128)
     (smoke-wait 1.0)
     (smoke-stick 0 128 128 128)
     (smoke-wait 1.0)
     (smoke-stick 128 0 128 128)
     (smoke-wait 1.5)
     (smoke-neutral)
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (smoke-rec-start "roll" 2)
     (smoke-roll 255 128)
     (smoke-wait 0.5)
     (smoke-roll 0 128)
     (smoke-rec-stop)
     (smoke-quit)
     )
    ((8)
     ;; T8 to T12, Freedom League at the Port: class help, health, the guard's ammo, tazer, rolls and
     ;; strafes, its close attack's delay, the START ring's locks, damage on the 24 point scale and
     ;; the kill counter, who aims at whom; the jetpack's health and boost
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-help-shots 2)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-hp-check BF_CLASS_BLUE_GUARD)
     (smoke-start-locks)
     (smoke-invulnerable #t)
     (smoke-guard-ammo)
     (smoke-weapon-shots)
     (smoke-tazer)
     (smoke-guard-moves)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-invulnerable #f)
     (smoke-player-hits #f)
     (smoke-unit-damage)
     (smoke-hatred-check)
     ;; the jetpack's boost from the base, in the open (25 m off a control point it met a wall)
     (smoke-go-near (-> *bf* team))
     (smoke-change-class 1 "blue jetpack")
     (smoke-hp-check BF_CLASS_BLUE_JETPACK)
     (smoke-invulnerable #t)
     (smoke-jet-boost)
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((10)
     ;; The author's play (round 15): Freedom League in the Industrial Zone, the blue guard deployed at
     ;; once; the red guards' armor, the tazer's stab while walking, the roll and the strafe on film,
     ;; a jetpack guard's flames, then a long fight
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-status "blue guard deployed")
     (smoke-invulnerable #t)
     (smoke-check "no guard has both armors hidden" (zero? (smoke-guard-masks)))
     (smoke-tazer-walk)
     (smoke-step "film the rolls")
     (smoke-rec-start "roll" 2)
     (smoke-roll 255 128)
     (smoke-wait 0.5)
     (smoke-roll 128 0)
     (smoke-rec-stop)
     (smoke-step "film the strafe")
     (smoke-rec-start "strafe" 2)
     (smoke-strafe 255)
     (smoke-rec-stop)
     (smoke-guard-moves)
     (smoke-check "a jetpack guard near to look at" (smoke-look-at-jetpack))
     (smoke-invulnerable #f)
     (smoke-free-fight BF_CLASS_BLUE_GUARD 40.0)
     (smoke-check "no guard has both armors hidden after the fight" (zero? (smoke-guard-masks)))
     (smoke-status "blue guard after the fight")
     (smoke-check "still in the battle after the long fight" (and *target* (bf-fighting?)))
     (smoke-quit)
     )
    ((18)
     ;; Round 18, Freedom League: the units conquer and defend the points on foot, the player out of
     ;; them, at Freedom HQ's point (`smoke-conquer-defend`)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-conquer-defend BF_TEAM_FF 5 "base-leave" "conquest" "defense")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((23)
     ;; Round 20: START opens the battle's own pause page; a battle with 40 units a side brought by
     ;; their ships at random held points; the minimap's marks by side and the points' black discs;
     ;; guards 1.5 times faster; the first fight between the Slums and the Industrial Zone; R3's
     ;; overlay; the deploy with no frame of Jak; the class model facing the crosshair as it fires
     (smoke-mods-toggle "mods-menu-on")
     (smoke-step "start page")
     (smoke-press (pad-buttons start) 1.5)
     (format 0 "SMOKE start: page ~D mode ~A progress ~A~%" (if (smoke-dir) (-> (smoke-dir) page) -1) *master-mode*
             (if *progress-process* #t #f))
     (smoke-check "START opens the battle's pause page, the game paused, no game menu"
                  (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE) (= *master-mode* 'menu) (not *progress-process*))
                  )
     (smoke-shot "pause-page-lobby")
     (smoke-press (pad-buttons circle) 1.0)
     (smoke-check "Circle closes it, the game runs" (and (= (-> (smoke-dir) page) BF_PAGE_NONE) (= *master-mode* 'game)))
     (smoke-press (pad-buttons start) 1.5)
     (set! (-> (smoke-dir) cursor) 1)
     (smoke-wait 0.3)
     (smoke-press (pad-buttons x) 2.0)
     (smoke-check "New battle on the pause page opens the war zone page" (= (-> (smoke-dir) page) BF_PAGE_ZONE))
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 0.5)
     (smoke-press (pad-buttons x) 1.0)
     (set! (-> (smoke-dir) cursor) BF_TEAM_FF)
     (smoke-tap (pad-buttons x) 4)
     (let ((t0 (smoke-now)))
       (until (or (= (-> *bf* phase) BF_PHASE_FIGHT) (< (seconds 150) (- (smoke-now) t0)))
         (smoke-default-mesh "loading")
         (smoke-wait 0.5)
         )
       )
     (dotimes (k 4)
       (smoke-default-mesh "fight")
       (smoke-wait 0.5)
       )
     ;; the deploy: no frame with Jak drawn and his class model not there yet
     (smoke-step "deploy")
     (dotimes (k 16)
       (set! (-> *bf-drops-at* k) 0)
       )
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 0.5)
     (smoke-rec-start "deploy" 2)
     (smoke-tap (pad-buttons x) 4)
     (let ((shown 0))
       (dotimes (f 240)
         (if (zero? (mod f 30))
             (smoke-default-mesh "deploy")
             )
         (if (and *target*
                  (= (-> (smoke-dir) page) BF_PAGE_NONE)
                  (not (logtest? (-> *target* draw status) (draw-control-status no-draw)))
                  (not (bf-avatar-alive?))
                  )
             (+! shown 1)
             )
         (suspend)
         )
       (smoke-rec-stop)
       (format 0 "SMOKE deploy: Jak drawn without his class model in ~D frames of 240~%" shown)
       (smoke-check "no frame shows Jak at the deploy" (and (zero? shown) (bf-avatar-alive?)))
       )
     ;; each side starts at its own base: in the fight's first 10 s every unit awake stands within
     ;; 200 m of its side's base (point 0 the Freedom League's, 1 the Krimzon Guard's)
     (let ((far 0)
           (seen-ff 0)
           (seen-kg 0)
           )
       (dotimes (k 10)
         (smoke-wait 1.0)
         (dotimes (d (-> *bf-unit-dots* count))
           (let* ((team (-> *bf-unit-dots* team d))
                  (dist (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points team pos)))
                  )
             (if (< (meters 200) dist)
                 (+! far 1)
                 )
             (if (= team BF_TEAM_FF)
                 (set! seen-ff (max seen-ff 1))
                 (set! seen-kg (max seen-kg 1))
                 )
             )
           )
         (if (zero? (mod k 3))
             (smoke-dots-line "start")
             )
         )
       (smoke-drops-line "start")
       (format 0 "SMOKE start: ~D unit samples over 200 m from their base in the first 10 s~%" far)
       (smoke-check "each side's first units stand at its own base (none over 200 m from it)"
                    (and (zero? far) (= seen-ff 1) (= seen-kg 1))
                    )
       )
     (smoke-invulnerable #t)
     (smoke-wait 3.0)
     (format 0 "SMOKE guard class speed ~f~%" (-> *setting-control* user-default speed-mult))
     (smoke-check "the guard class runs 1.5 times as fast (speed 1.425)"
                  (and (< 1.4 (-> *setting-control* user-default speed-mult)) (< (-> *setting-control* user-default speed-mult) 1.45))
                  )
     ;; the armies, four minutes
     (smoke-step "armies")
     (let ((c (new 'stack-no-clear 'array 'int32 4))
           (most-ff 0)
           (most-kg 0)
           (fast 0.0)
           (first-fight -1)
           (fight-time 0)
           (first-battle -1)
           (battle-time 0)
           )
       (dotimes (k 360)
         (smoke-wait 1.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         (set! fast (fmax fast (bf-city-guard-speed)))
         (when (< first-fight 0)
           (dotimes (i (-> *bf* point-count))
             (let ((pt (-> *bf* points i)))
               (when (and (< first-fight 0) (not (-> pt base?)) (> (-> pt near 0) 0) (> (-> pt near 1) 0))
                 (set! first-fight i)
                 (set! fight-time k)
                 )
               )
             )
           )
         ;; the first place the two armies meet: 5 units of each side or more within 250 m of a
         ;; control point (a lone jetpack flying over one is not a fight)
         (when (< first-battle 0)
           (dotimes (i (-> *bf* point-count))
             (when (and (< first-battle 0) (not (-> *bf* points i base?)))
               (let ((ff 0)
                     (kg 0)
                     )
                 (dotimes (d (-> *bf-unit-dots* count))
                   (when (< (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points i pos)) (meters 250))
                     (if (= (-> *bf-unit-dots* team d) BF_TEAM_FF)
                         (+! ff 1)
                         (+! kg 1)
                         )
                     )
                   )
                 (when (and (<= 5 ff) (<= 5 kg))
                   (set! first-battle i)
                   (set! battle-time k)
                   ;; the whole map at that moment, live (R3's overlay), filmed
                   (set! (-> *bf* overlay?) #t)
                   (smoke-wait 0.5)
                   (smoke-shot "first-battle-map")
                   (smoke-rec-start "first-battle-map" 6)
                   (smoke-wait 6.0)
                   (smoke-rec-stop)
                   (set! (-> *bf* overlay?) #f)
                   )
                 )
               )
             )
           )
         (when (zero? (mod k 20))
           (smoke-team-line "armies")
           (format 0 "SMOKE marching at ~D s: Freedom League ~D, Krimzon Guard ~D; ways over ~D meshes, to each point" k
                   (bf-city-march-count BF_TEAM_FF) (bf-city-march-count BF_TEAM_KG) (bf-ways-reach -1))
           (dotimes (i (-> *bf* point-count))
             (format 0 " ~D" (bf-ways-reach i))
             )
           (format 0 "~%")
           (smoke-dots-line "armies")
           (smoke-points-line "armies")
           (smoke-drops-line "armies")
           (smoke-minimap-marks "armies")
           )
         (if (= k 60)
             (smoke-shot "armies-minimap")
             )
         )
       (format 0 "SMOKE armies: at most Freedom League ~D, Krimzon Guard ~D awake; fastest guard ~M/s; first contact on a point ~D (~S) after ~D s~%"
               most-ff most-kg fast first-fight (if (>= first-fight 0) (bf-point-name first-fight) "none") fight-time)
       (format 0 "SMOKE armies: the two armies first meet at point ~D (~S) after ~D s~%"
               first-battle (if (>= first-battle 0) (bf-point-name first-battle) "none") battle-time)
       (smoke-check "both armies about 40 strong (32 or more awake each)" (and (<= 32 most-ff) (<= 32 most-kg)))
       (smoke-check "the guards run 1.5 times as fast (over 16 m/s)" (< (meters 16) fast))
       (smoke-check "the armies first meet at the Slums' or the Industrial Zone's point (5 a side within 250 m)"
                    (or (= first-battle 3) (= first-battle 4))
                    )
       (smoke-check "a side's units come down at several of its points" (<= 2 (smoke-drops-line "end")))
       (smoke-check "every unit's minimap mark in its side's color, every point marked" (and (zero? (smoke-minimap-marks "end"))
                                                                                          (= (-> *smoke-marks* 2) (-> *bf* point-count))
                                                                                          (< 10 (-> *smoke-marks* 0))
                                                                                          )
                    )
       )
     ;; R3: the kills, the deaths and the whole map
     (smoke-step "r3")
     (smoke-press (pad-buttons r3) 1.0)
     (smoke-check "R3 shows the kills, the deaths and the whole map, not the first-person view"
                  (and (-> *bf* overlay?) (= (-> *target* cam-user-mode) 'normal))
                  )
     (smoke-shot "r3-overlay")
     (smoke-rec-start "r3-overlay" 6)
     (smoke-wait 4.0)
     (smoke-rec-stop)
     (smoke-press (pad-buttons r3) 1.0)
     (smoke-check "R3 again hides it" (not (-> *bf* overlay?)))
     ;; START in the battle: the pause page and the city's live map
     (smoke-step "pause map")
     (smoke-press (pad-buttons start) 1.5)
     (smoke-check "START in the battle opens the pause page over the city's map"
                  (and (= (-> (smoke-dir) page) BF_PAGE_PAUSE) (= *master-mode* 'menu) (< 10 (-> *bf-unit-dots* count)))
                  )
     (smoke-shot "pause-map")
     (smoke-press (pad-buttons start) 1.5)
     (smoke-check "START again: back to the battle" (and (= (-> (smoke-dir) page) BF_PAGE_NONE) (= *master-mode* 'game)))
     ;; the Krimzon Guard's marks on the minimap, at the Port's point
     (smoke-step "port minimap")
     (smoke-film-point 2)
     (smoke-wait 2.0)
     (smoke-minimap-marks "port")
     (smoke-shot "port-minimap")
     ;; the class model faces the crosshair as it fires, walking sideways, the crosshair 70 degrees
     ;; off the walk
     (smoke-step "shoot")
     (set! (-> *bf* view-yaw) (+ (-> *bf* view-yaw) (degrees 70)))
     (smoke-wait 1.0)
     (set! *smoke-lx* 255)
     (smoke-hold (pad-buttons r1))
     (smoke-rec-start "shoot" 2)
     (let ((worst 0.0)
           (shots 0)
           (good 0)
           )
       (dotimes (f 240)
         (let ((av (smoke-av)))
           ;; the frames drawn after a shot: the model is placed after every process has run (its
           ;; camera post), so the frame of the shot itself reads last frame's facing here
           (when (and av
                      (time-elapsed? (-> av fire-time) (seconds 0.02))
                      (not (time-elapsed? (-> av fire-time) (seconds 0.1)))
                      )
             (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> av root quat)))
                   (dir (vector-! (new 'stack-no-clear 'vector) (-> av aim) (-> av root trans)))
                   )
               (set! (-> fwd y) 0.0)
               (set! (-> dir y) 0.0)
               (when (< (meters 1) (vector-length dir))
                 (vector-normalize! fwd 1.0)
                 (vector-normalize! dir 1.0)
                 (+! shots 1)
                 (let ((off (acos (fmax -1.0 (fmin 1.0 (vector-dot fwd dir))))))
                   (set! worst (fmax worst off))
                   (if (< off (degrees 12))
                       (+! good 1)
                       )
                   )
                 )
               )
             )
           )
         (suspend)
         )
       (smoke-rec-stop)
       (smoke-hold (the-as pad-buttons 0))
       (set! *smoke-lx* 128)
       ;; the frames drawn after a shot are read here a frame late: when the crosshair jumps from a
       ;; unit near the camera to the far scenery, that frame compares two aims
       (format 0 "SMOKE shoot: ~D shot frames, ~D within 12 degrees of the crosshair's line, at most ~f degrees off~%"
               shots good (/ worst 182.04445))
       (smoke-check "the class model faces the crosshair as it fires (9 shot frames in 10 within 12 degrees)"
                    (and (< 0 shots) (<= (* 9 shots) (* 10 good)))
                    )
       )
     (smoke-invulnerable #f)
     (smoke-quit)
     (smoke-wait-for 60.0 (lambda () (= (-> *bf* city-load) BF_LOAD_OFF)))
     (smoke-wait 5.0)
     (smoke-check "after the battle Jak is drawn again, standing"
                  (and *target* (not (logtest? (-> *target* draw status) (draw-control-status no-draw))))
                  )
     )
    ((26)
     ;; Round 20: a contested point. The battle runs, the player at his base, until units of both sides
     ;; stand in a control point's capture radius (10 min at most); then for 40 s: each side's units in
     ;; its radius and within 250 m, its holder and capture; R3's map filmed. The units near a
     ;; contested point go to it first (battlefront-city.gc `bf-city-contested-point`) and the side
     ;; with more units in the radius takes it or keeps it.
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     ;; the battle runs 200 s; then a squad of 6 Krimzon Guard guards is put by the test on a control
     ;; point the Freedom League holds (the armies, at each other's points, stall for minutes)
     (smoke-wait 200.0)
     (smoke-team-line "before")
     (smoke-points-line "before")
     (let ((own -1))
       (dotimes (i (-> *bf* point-count))
         (if (and (< own 0) (not (-> *bf* points i base?)) (= (-> *bf* points i owner) BF_TEAM_FF))
             (set! own i)
             )
         )
       (when (>= own 0)
         (format 0 "SMOKE contest: ~D Krimzon Guard guards put on ~S, held by the Freedom League~%"
                 (bf-city-send BF_TEAM_KG own 6) (bf-point-name own))
         )
       (set! *smoke-sent* own)
       )
     (smoke-wait 0.5)
     (let ((pt *smoke-sent*)
           (t0 (smoke-now))
           )
       (while (and (< pt 0) (< (- (smoke-now) t0) (seconds 600)))
         (smoke-wait 0.5)
         (when (zero? (mod (/ (- (smoke-now) t0) 150) 120))
           (smoke-team-line "waiting")
           (smoke-dots-line "waiting")
           )
         (dotimes (i (-> *bf* point-count))
           (let ((p (-> *bf* points i)))
             (if (and (< pt 0) (not (-> p base?)) (> (-> p near 0) 0) (> (-> p near 1) 0))
                 (set! pt i)
                 )
             )
           )
         )
       (format 0 "SMOKE contest: point ~D (~S) after ~D s~%" pt (if (>= pt 0) (bf-point-name pt) "none")
               (/ (- (smoke-now) t0) 300))
       (smoke-check "units of both sides meet in a control point's capture radius" (>= pt 0))
       (when (>= pt 0)
         (let ((p (-> *bf* points pt))
               (holder0 (-> *bf* points pt owner))
               (first-in 0)
               (most-in 0)
               (first-near 0)
               (most-near 0)
               (last-owner -2)
               (ff-in0 (-> *bf* points pt near 0))
               (kg-in0 (-> *bf* points pt near 1))
               )
           (set! (-> *bf* overlay?) #t)
           (smoke-rec-start "contest-map" 6)
           (dotimes (k 40)
             (let ((ff 0)
                   (kg 0)
                   (ff-zone 0)
                   )
               (dotimes (d (-> *bf-unit-dots* count))
                 (let ((dist (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> p pos))))
                   (when (< dist (meters 250))
                     (if (= (-> *bf-unit-dots* team d) BF_TEAM_FF)
                         (+! ff 1)
                         (+! kg 1)
                         )
                     )
                   (if (and (< dist (meters 60)) (= (-> *bf-unit-dots* team d) BF_TEAM_FF))
                       (+! ff-zone 1)
                       )
                   )
                 )
               (if (zero? k)
                   (set! *smoke-zone0* ff-zone)
                   )
               (set! *smoke-zone-max* (max *smoke-zone-max* ff-zone))
               (if (zero? k)
                   (begin
                     (set! first-in (+ (-> p near 0) (-> p near 1)))
                     (set! first-near (+ ff kg))
                     )
                   )
               (set! most-in (max most-in (+ (-> p near 0) (-> p near 1))))
               (set! most-near (max most-near (+ ff kg)))
               (if (zero? (mod k 4))
                   (begin
                     (format 0 "SMOKE contest ~D s: in its radius ~D/~D, within 250 m ~D/~D," k (-> p near 0) (-> p near 1) ff kg)
                     (format 0 " owner ~D, capture ~D ~f~%" (-> p owner) (-> p prog-team) (-> p progress))
                     )
                   )
               (if (= k 6)
                   (smoke-rec-stop)
                   )
               (set! last-owner (-> p owner))
               )
             (smoke-wait 1.0)
             )
           (set! (-> *bf* overlay?) #f)
           (format 0 "SMOKE contest end: held by ~D at the start, ~D after 40 s;" holder0 last-owner)
           (format 0 " in its radius ~D at first, ~D at most; within 250 m ~D at first, ~D at most~%"
                   first-in most-in first-near most-near)
           (format 0 "SMOKE contest: Freedom League in its radius ~D at first, ~D at the end; Krimzon Guard ~D at first, ~D at the end~%"
                   ff-in0 (-> p near 0) kg-in0 (-> p near 1))
           (format 0 "SMOKE contest: Freedom League units within 60 m of the point ~D at first, ~D at most~%"
                   *smoke-zone0* *smoke-zone-max*)
           (smoke-check "the contested point draws its side's units into its zone (60 m)" (< *smoke-zone0* *smoke-zone-max*))
           (smoke-check "they clear it: no Krimzon Guard unit left in its radius, the point still the Freedom League's"
                        (and (zero? (-> p near 1)) (= (-> p owner) BF_TEAM_FF))
                        )
           (smoke-check "the point stays with or goes to a side, not neutral for good"
                        (or (>= last-owner 0) (!= (-> p prog-team) BF_TEAM_NONE))
                        )
           )
         )
       )
     (smoke-points-line "end")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((25)
     ;; the nav meshes of the whole city and their links
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-wait 12.0)
     (bf-ways-dump)
     ;; the south (ctyslumb 1, ctyslumc 2) against the north (ctysluma 0, ctyindb 4, the Port 5 to 8)
     (bf-ways-gap 1 0)
     (bf-ways-gap 2 0)
     (bf-ways-gap 1 4)
     (bf-ways-gap 1 5)
     (bf-ways-gap 1 7)
     (smoke-quit)
     )
    ((24)
     ;; Round 20 frame rate: 20 units a side, then 40 (in a first run 40 froze the game at 4 frames a
     ;; second: the city's attack controller held 64 attackers; the city code's parts, switched off
     ;; in turn, cost nothing measurable)
     (smoke-mods-toggle "mods-menu-on")
     (let ((caps (new 'static 'array int32 8 14 6 0 0 8 4 4 4)))
       (dotimes (i 8)
         (set! (-> caps i) (-> *bf-team-caps* i))
         )
       (set! (-> *bf-team-caps* 0) 14)
       (set! (-> *bf-team-caps* 1) 6)
       (set! (-> *bf-team-caps* 4) 8)
       (set! (-> *bf-team-caps* 5) 4)
       (set! (-> *bf-team-caps* 6) 2)
       (set! (-> *bf-team-caps* 7) 2)
       (smoke-battle-start 0 BF_TEAM_FF)
       (smoke-deploy 0 "deploy blue guard")
       (smoke-invulnerable #t)
       (smoke-wait-wall 60)
       (smoke-team-line "caps 20")
       (smoke-fps "caps 20")
       (dotimes (i 8)
         (set! (-> *bf-team-caps* i) (-> caps i))
         )
       )
     (smoke-wait-wall 90)
     (smoke-team-line "caps 40")
     (smoke-fps "caps 40")
     (smoke-check "40 units a side at 50 frames a second or more"
                  (let ((c (new 'stack-no-clear 'array 'int32 4)))
                    (and (<= 36 (bf-transport-team-count BF_TEAM_FF c)) (<= 36 (bf-transport-team-count BF_TEAM_KG c)))
                    )
                  )
     (smoke-check "the frame rate holds with 40 a side" (<= 500 (smoke-fps "caps 40 again")))
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((22)
     ;; Round 19, every street section of Haven City loaded at once: the slots and the level heap's
     ;; chunks, every point live, both armies from their own bases across the city, the map; then
     ;; the stock levels back after the battle
     (smoke-mods-toggle "mods-menu-on")
     (smoke-levels-line "before")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-step "whole city")
     (smoke-levels-line "battle")
     (let ((live 0))
       (dotimes (i (-> *bf* point-count))
         (if (bf-point-live? (-> *bf* points i))
             (+! live 1)
             )
         )
       (format 0 "SMOKE ~D of ~D points live~%" live (-> *bf* point-count))
       (smoke-check "every street section is loaded during the battle" (bf-whole-city-loaded?))
       (smoke-check "every battle point lies in a loaded section" (= live (-> *bf* point-count)))
       )
     (let ((c (new 'stack-no-clear 'array 'int32 4))
           (most-ff 0)
           (most-kg 0)
           (most-points 0)
           )
       (dotimes (k 18)
         (smoke-wait 10.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         ;; the points with units of either side within 250 m, at once
         (let ((manned 0))
           (dotimes (i (-> *bf* point-count))
             (let ((near? #f))
               (dotimes (d (-> *bf-unit-dots* count))
                 (if (< (vector-vector-xz-distance (-> *bf-unit-dots* pos d) (-> *bf* points i pos)) (meters 250))
                     (set! near? #t)
                     )
                 )
               (if near?
                   (+! manned 1)
                   )
               )
             )
           (set! most-points (max most-points manned))
           )
         (smoke-team-line "whole city")
         (smoke-dots-line "whole city")
         (smoke-points-line "whole city")
         )
       (format 0 "SMOKE whole city: at most Freedom League ~D, Krimzon Guard ~D awake, units at ~D points at once~%"
               most-ff most-kg most-points)
       (smoke-check "both armies field about 20 across the city (15 or more awake each)" (and (<= 15 most-ff) (<= 15 most-kg)))
       (smoke-check "units stand at 3 points or more at once, across the city" (<= 3 most-points))
       )
     (smoke-shot "whole-city")
     ;; the Port's point, the Krimzon Guard's, 1.9 km from the Freedom League's base: no load, its
     ;; units already there
     (smoke-step "far point")
     (smoke-film-point 2)
     (smoke-rec-start "whole-city-port" 4)
     (smoke-wait 6.0)
     (smoke-rec-stop)
     (smoke-shot "whole-city-port")
     (smoke-levels-line "far point")
     (smoke-dots-line "far point")
     (smoke-check "the far point needed no load: every street section still in"
                  (and (= (-> *bf* city-load) BF_LOAD_WHOLE) (bf-whole-city-loaded?))
                  )
     (smoke-step "map")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
     (smoke-wait 1.0)
     (smoke-shot "whole-city-map")
     (smoke-rec-start "whole-city-map" 6)
     (smoke-wait 5.0)
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-pick-point 0)
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-levels-line "after a respawn")
     (smoke-check "the sections stay loaded after a respawn" (bf-whole-city-loaded?))
     (smoke-quit)
     (smoke-wait-for 60.0 (lambda () (= (-> *bf* city-load) BF_LOAD_OFF)))
     (smoke-wait 10.0)
     (smoke-levels-line "after the battle")
     (smoke-check "after the battle the game's own levels are back, Jak standing"
                  (and (= (-> *bf* city-load) BF_LOAD_OFF)
                       (= (level-status? *level* 'ctywide #f) 'active)
                       *target*
                       (logtest? (-> *target* control status) (collide-status on-surface))
                       )
                  )
     )
    ((21)
     ;; Round 19, Freedom League at its base by the headquarters: the Krimzon Guard, which holds no
     ;; point here, brings its units in from the edge of the loaded area (Star Wars Battlefront's
     ;; armies come from every command post); both armies about 20 strong meet at Freedom HQ's point;
     ;; the force fields at the ruins and at the Metal Head nest, seen and run into; the doors shut
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-step "armies")
     (let ((c (new 'stack-no-clear 'array 'int32 4))
           (most-ff 0)
           (most-kg 0)
           (met 0)
           )
       (dotimes (k 6)
         (smoke-wait 5.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         (smoke-team-line "armies")
         )
       ;; Jak where he sees Freedom HQ's point, filmed every half second while the armies meet there
       (let ((at (new 'stack-no-clear 'vector))
             (aim (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 5 pos)))
             )
         (+! (-> aim y) (meters 1.5))
         (when (smoke-viewpoint 5 aim at)
           (+! (-> at y) (meters 2))
           (move-to-point! (-> *target* control) at)
           )
         (smoke-wait 1.5)
         (smoke-face aim)
         )
       (smoke-rec-start "armies" 30)
       (dotimes (k 18)
         (smoke-wait 5.0)
         (set! most-ff (max most-ff (bf-transport-team-count BF_TEAM_FF c)))
         (set! most-kg (max most-kg (bf-transport-team-count BF_TEAM_KG c)))
         (let ((ff (smoke-count-near BF_TEAM_FF (-> *bf* points 5 pos) (meters 60)))
               (kg (smoke-count-near BF_TEAM_KG (-> *bf* points 5 pos) (meters 60)))
               )
           (if (and (< 0 ff) (< 0 kg))
               (+! met 1)
               )
           (format 0 "SMOKE ~D s at Freedom HQ's point: Freedom League ~D, Krimzon Guard ~D within 60 m, owner ~D~%"
                   (* (+ k 1) 5) ff kg (-> *bf* points 5 owner))
           )
         (smoke-team-line "armies")
         )
       (smoke-rec-stop)
       (smoke-wait 1.0)
       (smoke-shot "armies")
       (format 0 "SMOKE armies: at most Freedom League ~D, Krimzon Guard ~D awake; both at Freedom HQ's point in ~D of 18 counts~%"
               most-ff most-kg met)
       (smoke-check "the Krimzon Guard, with no point here, comes in from the edge (15 or more awake)" (<= 15 most-kg))
       (smoke-check "the Freedom League fields about 20 here too (15 or more awake)" (<= 15 most-ff))
       (smoke-check "both armies meet at a point (both within 60 m of it in 3 counts or more)" (<= 3 met))
       )
     ;; the respawn page's map: both armies, live
     (smoke-step "both armies on the map")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
     (smoke-wait 1.0)
     (let ((n-ff 0)
           (n-kg 0)
           )
       (dotimes (i (-> *bf-unit-dots* count))
         (if (= (-> *bf-unit-dots* team i) BF_TEAM_FF)
             (+! n-ff 1)
             (+! n-kg 1)
             )
         )
       (format 0 "SMOKE respawn map: ~D Freedom League and ~D Krimzon Guard dots~%" n-ff n-kg)
       (smoke-check "the respawn page shows both armies" (and (< 0 n-ff) (< 0 n-kg)))
       )
     (smoke-shot "armies-map")
     (smoke-wait 1.0)
     (smoke-rec-start "armies-map" 6)
     (smoke-wait 5.0)
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-pick-point 0)
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-invulnerable #t)
     ;; the doors by the headquarters
     (smoke-step "doors by the headquarters")
     (dotimes (k 3)
       (let ((name (-> (new 'static 'boxed-array :type string "cty-door-1" "cty-door-3" "cty-door-2") k)))
         (let ((ok (smoke-door-check name)))
           (smoke-check "a door to an interior stays shut with Jak in front of it" (and ok (!= ok 'none)))
           (if (= k 0)
               (smoke-shot "door-fhq")
               )
           )
         )
       )
     ;; the ruins' force field, by Freedom HQ's district
     (smoke-step "ruins force field")
     (let ((past (smoke-field-walk 412.0 30.0 -45.0 367.0 -45.0 "field-ruins")))
       (smoke-check "the ruins' force field stands, and Jak running at it stays out" (< past 1.0))
       )
     ;; the Port: a respawn there, the nest's force field, the Port's doors
     (smoke-step "to the Port")
     (set! (-> *bf* points 2 owner) BF_TEAM_FF)
     (smoke-wait 1.0)
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
     (smoke-pick-point 2)
     (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-wait 2.0)
     (smoke-invulnerable #t)
     (smoke-step "nest force field")
     (let ((past (smoke-field-walk -372.0 30.0 1238.0 -372.0 1186.0 "field-nest")))
       (smoke-check "the Metal Head nest's force field stands, and Jak running at it stays out" (< past 1.0))
       )
     (smoke-step "doors at the Port")
     (dotimes (k 3)
       (let ((name (-> (new 'static 'boxed-array :type string "hip-door-a-10" "hip-door-a-6" "com-airlock-outer-59") k)))
         (let ((ok (smoke-door-check name)))
           (smoke-check "a door to an interior stays shut with Jak in front of it" (and ok (!= ok 'none)))
           (if (= k 0)
               (smoke-shot "door-port")
               )
           )
         )
       )
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((20)
     ;; Round 18, Krimzon Guard: the same at the Port's point, the Freedom League defending it
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_KG)
     (smoke-deploy 0 "deploy red guard")
     (smoke-invulnerable #t)
     (smoke-conquer-defend BF_TEAM_KG 2 "kg-base-leave" "kg-conquest" "ff-defense")
     (smoke-team-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((19)
     ;; Round 18, Freedom League: every district's point on open ground, its holder's ship right over
     ;; it, swapped when it changes hands: redeploys to the Slums, the Industrial Zone and the Port in
     ;; turn (each given to the player's side for the test), and the Krimzon Guard's base at the Port
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-wait 10.0)
     (smoke-tour-point 4 "slums" "slums-swapped")
     (smoke-tour-point 3 "industrial" "industrial-swapped")
     (smoke-tour-point 2 "port" "port-swapped")
     (smoke-step "Krimzon Guard base")
     (smoke-wait-for 30.0 (lambda () (and (-> *bf* points 1 snapped?) (<= 0.0 (smoke-ship-over 1)))))
     (smoke-check "the Krimzon Guard's base on open ground, its ship right over it" (smoke-point-open 1))
     (smoke-film-point 1)
     (smoke-shot "kg-base")
     (smoke-points-line "end")
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((17)
     ;; Round 18, Freedom League: the war zone page (Spargus grey and refused, Haven City's whole map),
     ;; the spawn shield, a ship stationed over each held point and swapped at a capture, every class
     ;; aiming, the respawn page's live units
     (smoke-mods-toggle "mods-menu-on")
     (smoke-step "war zone page")
     (smoke-start-page 'bf-battlefront)
     (smoke-menu-goto 0)
     (smoke-press (pad-buttons x) 3.0)
     (set! (-> (smoke-dir) cursor) 1)
     (smoke-wait 0.6)
     (smoke-shot "zone-spargus")
     (smoke-press (pad-buttons x) 1.0)
     (smoke-check "Spargus is listed and refused (the war zone page stays)"
                  (and (= (-> (smoke-dir) page) BF_PAGE_ZONE) (= (bf-page-count BF_PAGE_ZONE) 2)))
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 0.6)
     (smoke-shot "zone-haven-city")
     ;; a clip of the page: Haven City, Spargus (grey, X refused), Haven City again
     (smoke-wait 1.0)
     (smoke-rec-start "zone-page" 4)
     (smoke-wait 1.0)
     (set! (-> (smoke-dir) cursor) 1)
     (smoke-wait 1.5)
     (smoke-press (pad-buttons x) 1.0)
     (set! (-> (smoke-dir) cursor) 0)
     (smoke-wait 1.5)
     (smoke-rec-stop)
     (smoke-press (pad-buttons circle) 1.0)
     (smoke-wait 1.0)
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-wait 1.0)
     (smoke-rec-start "spawn-shield" 2)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-check "the spawn shield: 3 s invulnerable, the class model blinking, then steady" (smoke-shield-check))
     (smoke-rec-stop)
     (smoke-invulnerable #t)
     ;; the ship stationed over the base, right over it, and staying
     (smoke-wait 12.0)
     (format 0 "SMOKE base ship ~M m off its point~%" (smoke-ship-over 0))
     (smoke-check "a ship hovers right over the base (within 1 m)" (and (<= 0.0 (smoke-ship-over 0)) (< (smoke-ship-over 0) 1.0)))
     (smoke-wait 20.0)
     (smoke-team-line "32 s")
     (smoke-check "the base's ship stays over it" (<= 0.0 (smoke-ship-over 0)))
     (smoke-check "the ship comes down where nothing stands above it" (smoke-ships-sky))
     ;; Freedom HQ's point taken: its side's ship comes and stays over it
     (smoke-step "capture Freedom HQ")
     (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 5 pos))))
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       )
     (smoke-wait-for 45.0 (lambda () (= (-> *bf* points 5 owner) BF_TEAM_FF)))
     (smoke-check "Jak's side captures the Freedom HQ point" (= (-> *bf* points 5 owner) BF_TEAM_FF))
     (smoke-wait-for 20.0 (lambda () (<= 0.0 (smoke-ship-over 5))))
     (smoke-wait 6.0)
     (format 0 "SMOKE Freedom HQ ship ~M m off its point, ~A~%" (smoke-ship-over 5)
             (let ((sh (handle->process (-> *bf* points 5 ship)))) (if sh (-> sh type symbol) (quote none))))
     (smoke-check "a ship of its side hovers right over the captured point" (and (<= 0.0 (smoke-ship-over 5)) (< (smoke-ship-over 5) 1.0)))
     (smoke-film-point 5)
     (smoke-shot "point-ship")
     ;; the point taken by the other side: the ship leaves, the other side's comes in its place
     (smoke-step "point taken by the Krimzon Guard")
     (smoke-wait 1.0)
     (smoke-rec-start "ship-swap" 6)
     (let ((before (-> *bf* points 5 ship)))
       (set! (-> *bf* points 5 owner) BF_TEAM_KG)
       (smoke-wait 2.0)
       (let ((old (handle->process before)))
         (format 0 "SMOKE the old ship: ~A~%" (if old (-> old next-state name) 'gone))
         ;; it climbs away a few seconds before it goes
         (smoke-check "the losing side's ship leaves the point"
                      (and (!= (-> *bf* points 5 ship) before)
                           (or (not old) (= (-> old next-state name) 'leave) (= (-> old next-state name) 'die-fast))
                           )
                      )
         )
       )
     (smoke-wait-for 30.0 (lambda () (<= 0.0 (smoke-ship-over 5))))
     (smoke-wait 6.0)
     (format 0 "SMOKE new ship over Freedom HQ ~M m off, ~A~%" (smoke-ship-over 5)
             (let ((sh (handle->process (-> *bf* points 5 ship)))) (if sh (-> (the-as process-drawable sh) type symbol) 'none)))
     (smoke-check "the new holder's ship takes its place" (<= 0.0 (smoke-ship-over 5)))
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-film-point 5)
     (smoke-shot "point-ship-swapped")
     ;; every class aims: the jetpack's upper body toward a shot 30 degrees up
     (smoke-step "guard aim")
     (move-to-point! (-> *target* control) (-> *bf* points 0 pos))
     (smoke-wait 2.0)
     (set! (-> *bf* view-pitch) (degrees 30))
     (smoke-wait 0.5)
     (smoke-rec-start "aim-guard" 2)
     (smoke-hold (pad-buttons r1))
     (smoke-wait 2.0)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (set! (-> *bf* view-pitch) 0.0)
     (smoke-step "jetpack aim")
     (smoke-change-class 1 "blue jetpack")
     (smoke-wait 4.0)
     (set! (-> *bf* view-pitch) (degrees 30))
     (smoke-rec-start "aim-jetpack" 2)
     (smoke-hold (pad-buttons r1))
     (smoke-wait 1.0)
     (let ((av (smoke-av)))
       (when (and av (-> av aim-jm))
         (format 0 "SMOKE jetpack torso quat w ~f~%" (-> av aim-jm quat w))
         )
       (smoke-check "the jetpack turns its upper body toward the aim while firing up"
                    (and av (-> av aim-jm) (< (-> av aim-jm quat w) 0.995)))
       )
     (smoke-wait 1.0)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (set! (-> *bf* view-pitch) 0.0)
     ;; a death: the respawn page, the units on the city's map, live
     (smoke-step "respawn page")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
     (smoke-wait 1.0)
     (format 0 "SMOKE respawn page: ~D units on the map~%" (-> *bf-unit-dots* count))
     (smoke-check "the respawn page shows the units awake on the map" (< 0 (-> *bf-unit-dots* count)))
     (smoke-shot "respawn-live-units")
     (smoke-wait 1.0)
     (smoke-rec-start "respawn-map" 6)
     (smoke-wait 6.0)
     (smoke-rec-stop)
     (smoke-wait 0.5)
     (smoke-pick-point 0)
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-check "the spawn shield again after the respawn" (smoke-shield-check))
     (smoke-quit)
     )
    ((16)
     ;; Round 17, the whole of Haven City, Freedom League: six points; the base at the HQ's entrance;
     ;; the transports; a capture and its defenders; the respawn page at a death, on the city's map;
     ;; the redeploy, refused in combat, then to the Slums, out of any force field; the fight away
     ;; from the player
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (format 0 "SMOKE zone ~S, ~D points~%" (bf-zone-name 0) (-> *bf* point-count))
     (smoke-check "six battle points, a control point in each district, neutral"
                  (and (= (-> *bf* point-count) 6)
                       (= (-> *bf* points 2 owner) BF_TEAM_NONE) (= (-> *bf* points 5 owner) BF_TEAM_NONE)
                       )
                  )
     (smoke-points-line "start")
     (let ((cont (get-continue-by-name *game-info* "ctyslumc-freehq-exit")))
       (smoke-check "the Freedom League's base is the headquarters' entrance (ctyslumc-freehq-exit)"
                    (and cont (< (vector-vector-distance (-> cont trans) (-> *bf* points 0 pos)) (meters 3))
                         (< (vector-vector-distance (-> cont trans) (-> *target* control trans)) (meters 5))
                         )
                    )
       )
     (smoke-step "transports")
     (smoke-wait 10.0)
     (smoke-team-line "10 s")
     (smoke-check "each troop transport comes down where nothing stands above it" (smoke-ships-sky))
     (smoke-check "a transport over a point" (smoke-look-at-ship))
     ;; Freedom HQ's control point: Jak takes it; his side, six guards short (sent back to their
     ;; pool here), sends a transport there, and every other unit it drops guards the point
     (smoke-step "capture Freedom HQ")
     (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points 5 pos))))
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       )
     (smoke-wait-for 45.0 (lambda () (= (-> *bf* points 5 owner) BF_TEAM_FF)))
     (smoke-points-line "Freedom HQ")
     (smoke-check "Jak's side captures the Freedom HQ point" (= (-> *bf* points 5 owner) BF_TEAM_FF))
     ;; six of his side's guards back to their pool (at his base, where they are), then Jak 40 m off
     ;; the point toward his base (out of its 15 m) at once: the side's next ship comes to the held
     ;; point nearest him, and every other unit it drops guards it
     (move-to-point! (-> *target* control) (-> *bf* points 0 pos))
     (dotimes (k 6)
       (let ((u (smoke-near-unit BF_TEAM_FF (the-as process #f) 'crimson-guard)))
         (if u
             (bf-transport-sleep u)
             )
         )
       )
     (smoke-team-line "six guards sent back")
     (let ((at (vector-! (new 'stack-no-clear 'vector) (-> *bf* points 0 pos) (-> *bf* points 5 pos))))
       (set! (-> at y) 0.0)
       (vector-normalize! at (meters 40))
       (vector+! at at (-> *bf* points 5 pos))
       (+! (-> at y) (meters 2))
       (move-to-point! (-> *target* control) at)
       )
     (let ((most 0)
           (most30 0)
           )
       (dotimes (k 12)
         (smoke-wait 5.0)
         (let ((n30 (smoke-count-near BF_TEAM_FF (-> *bf* points 5 pos) (meters 30))))
           (set! most (max most (-> *bf* points 5 near BF_TEAM_FF)))
           (set! most30 (max most30 n30))
           (format 0 "SMOKE Freedom HQ point, Jak 40 m off: ~D Freedom League units within 15 m, ~D within 30 m, ship ~A~%"
                   (-> *bf* points 5 near BF_TEAM_FF) n30 (if (handle->process (-> *bf* points 5 ship)) #t #f))
           )
         )
       (format 0 "SMOKE defenders: at most ~D within 15 m, ~D within 30 m~%" most most30)
       (smoke-check "units of the side patrol the point it holds (defenders: 2 or more within 30 m)" (<= 2 most30))
       )
     ;; a death: the respawn page on the whole city's map, at every death
     (smoke-step "respawn page")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
     (smoke-check "the respawn page opens at a death" (>= (-> *bf* respawn-pick) 0))
     (smoke-wait 1.0)
     (smoke-shot "respawn-city-map")
     (smoke-team-line "before the respawn")
     (smoke-pick-point 5)
     (dotimes (k 6)
       (smoke-wait 1.0)
       (smoke-team-line "after the respawn")
       )
     (smoke-wait-for 40.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-wait 1.0)
     (format 0 "SMOKE respawned ~M from the Freedom HQ point~%" (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 5 pos)))
     (smoke-check "respawned at the point picked" (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 5 pos)) (meters 3)))
     (smoke-invulnerable #t)
     ;; the redeploy: refused right after a shot, open 30 s out of combat
     (smoke-step "redeploy")
     (smoke-hold (pad-buttons r1))
     (smoke-wait 0.6)
     (smoke-hold (the-as pad-buttons 0))
     (smoke-check "a shot blocks the redeploy for 30 s" (not (bf-can-redeploy?)))
     ;; the class model's shot lasts past the trigger (its shoot-until): out of it before the clock is set back
     (smoke-wait 3.0)
     (set! (-> *bf* combat-time) (- (-> *display* game-clock frame-counter) (seconds 31)))
     (smoke-check "30 s out of combat, the redeploy is open" (bf-can-redeploy?))
     ;; the Slums' point given to the player's side for the test: a district out of any force field
     (set! (-> *bf* points 4 owner) BF_TEAM_FF)
     (smoke-wait 0.5)
     (format 0 "SMOKE redeploy flag ~A, test ~A, calm ~D s, avatar ~A, fighting ~A, Jak dead ~A~%" (-> *bf* redeploy-ok?)
             (bf-can-redeploy?) (/ (- (-> *display* game-clock frame-counter) (-> *bf* combat-time)) 300)
             (bf-avatar-alive?) (bf-fighting?) (focus-test? *target* dead))
     (let ((lost (-> *bf* deaths)))
       (smoke-start-page 'bf-battlefront)
       (smoke-menu-goto 4)
       (smoke-shot "redeploy-entry")
       (smoke-press (pad-buttons x) 2.0)
       (smoke-wait-for 10.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
       (smoke-check "Redeploy opens the respawn page" (>= (-> *bf* respawn-pick) 0))
       (smoke-team-line "before the redeploy")
       (smoke-pick-point 4)
       (dotimes (k 20)
         (smoke-wait 0.5)
         (smoke-team-line "after the redeploy")
         )
       (smoke-wait-for 50.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
       (smoke-wait 5.0)
       (format 0 "SMOKE redeployed: ~M from the Slums point, deaths ~D (were ~D), level ~A~%"
               (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 4 pos))
               (-> *bf* deaths) lost (-> *load-state* vis-nick))
       (smoke-check "redeployed in the Slums, standing, with no death counted"
                    (and (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 4 pos)) (meters 10))
                         (= (-> *bf* deaths) lost)
                         (logtest? (-> *target* control status) (collide-status on-surface))
                         )
                    )
       (smoke-shot "slums")
       )
     ;; a second far respawn: a death in the Slums, back at the base by the headquarters
     (smoke-step "second far respawn")
     (smoke-invulnerable #f)
     (smoke-kill-player)
     (smoke-wait-for 12.0 (lambda () (>= (-> *bf* respawn-pick) 0)))
     (smoke-pick-point 0)
     (smoke-wait-for 50.0 (lambda () (and (bf-avatar-alive?) (< (-> *bf* respawn-at) 0))))
     (smoke-wait 2.0)
     (smoke-team-line "after the second far respawn")
     (format 0 "SMOKE back ~M from the base~%" (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 0 pos)))
     (smoke-check "a second far respawn: back at the base"
                  (< (vector-vector-xz-distance (-> *target* control trans) (-> *bf* points 0 pos)) (meters 5)))
     (smoke-invulnerable #t)
     ;; away from the player: the Krimzon Guard, next to the Port and the Industrial Zone from its
     ;; base, fights for them where no unit is
     (smoke-step "away")
     (dotimes (k 6)
       (smoke-wait 10.0)
       (smoke-points-line "away")
       )
     (smoke-team-line "end")
     (smoke-check "the fight goes on away from the player (a district's point taken)"
                  (or (!= (-> *bf* points 2 owner) BF_TEAM_NONE) (!= (-> *bf* points 3 owner) BF_TEAM_NONE))
                  )
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((9)
     ;; T8 to T12, Krimzon Guard in the Industrial Zone: class help; the spider's health, leap and
     ;; sprint; the robotguard's health, shield and ball; the close attacks' delays; the red guard's
     ;; tazer; no tazer among the battle's guards; who aims at whom
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_KG)
     (smoke-help-shots 4)
     ;; the spider first, at the spawn: its leap needs open sky (under the Industrial Zone's pipes it
     ;; stopped at 6.8 m)
     (smoke-deploy 3 "deploy spider")
     (smoke-hp-check BF_CLASS_SPYDROID)
     (smoke-invulnerable #t)
     (smoke-spider-r14)
     (smoke-melee-delay (pad-buttons circle) 1.0)
     (smoke-change-class 2 "robotguard")
     (smoke-hp-check BF_CLASS_ROBOGUARD)
     (smoke-robot-r14)
     (smoke-invulnerable #t)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-change-class 0 "red guard")
     (smoke-hp-check BF_CLASS_RED_GUARD)
     (smoke-weapon-shots)
     (smoke-tazer)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-go-near BF_TEAM_FF)
     (smoke-bot-weapons #f)
     (smoke-go-near BF_TEAM_KG)
     (smoke-bot-weapons #t)
     (smoke-hatred-check)
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    )
  (format 0 "SMOKE DONE~%")
  0
  )

(defun smoke-start ()
  "Spawn the scenario's process in *pc-pool*, which outlives the resets of a deployment, and let it
   run under the menus."
  (process-spawn-function
    process
    (lambda :behavior process ()
      ;; the main thread keeps 256 bytes of stack across a suspend unless told more: the scenario's
      ;; stack vectors outgrew it ("suspend called without enough stack", then the game stopped)
      (stack-size-set! (-> self main-thread) 4096)
      (process-mask-clear! (-> self mask) menu pause progress freeze)
      (smoke-scenario)
      (sleep-code)
      )
    :name "smoke-test"
    :from *default-dead-pool*
    :to *pc-pool*
    :stack-size #x8000
    )
  0
  )
