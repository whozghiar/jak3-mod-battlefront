(defun smoke-r50-probe-old ((x0 float) (z0 float) (x1 float) (z1 float) (step float))
  "Every STEP meters from X0, Z0 to X1, Z1: where a troop transport can land (ground, a nav mesh
   within 2 m, open sky), with its openness, one line each."
  (let ((at (new 'stack-no-clear 'vector))
        (n 0)
        )
    (let ((x x0))
      (while (<= x x1)
        (let ((z z0))
          (while (<= z z1)
            (set-vector! at (meters x) (meters 200) (meters z) 1.0)
            (when (and (bf-transport-ground at) (find-nearest-nav-mesh at 8192.0) (bf-transport-sky? at))
              (format 0 "SMOKE spot ~f ~f ~f open ~f~%" x (/ (-> at y) 4096.0) z (bf-transport-openness at))
              (+! n 1)
              )
            (+! z step)
            )
          )
        (+! x step)
        )
      )
    (format 0 "SMOKE spots found ~D~%" n)
    )
  0
  )

(defun smoke-r50-probe-polys ()
  "Each nav poly middle of Spargus's two street meshes (`*smoke-r50-polys*`): where a troop
   transport can land (ground, a nav mesh, open sky), with its openness."
  (let ((at (new 'stack-no-clear 'vector))
        (n 0)
        )
    (dotimes (i 305)
      (set-vector! at (meters (-> *smoke-r50-polys* (* 3 i))) (meters (+ 1.0 (-> *smoke-r50-polys* (+ (* 3 i) 1))))
                   (meters (-> *smoke-r50-polys* (+ (* 3 i) 2))) 1.0)
      (when (and (bf-transport-ground at) (find-nearest-nav-mesh at 8192.0) (bf-transport-sky? at))
        (format 0 "SMOKE spot ~f ~f ~f open ~f~%" (/ (-> at x) 4096.0) (/ (-> at y) 4096.0) (/ (-> at z) 4096.0) (bf-transport-openness at))
        (+! n 1)
        )
      )
    (format 0 "SMOKE spots found ~D of ~D~%" n 305)
    )
  0
  )

(defun smoke-r50-trace ((tag int))
  "One line of the Spargus crash trace: the default nav mesh's users, each nav mesh of bf-spargus
   (users / most), the units awake, the losses, Jak's place and the ships."
  (format 0 "SMOKE trace ~D: default ~D/~D" tag (-> *default-nav-mesh* nav-control-count) (-> *default-nav-mesh* max-nav-control-count))
  (let ((lev (level-get *level* 'bf-spargus)))
    (when (and lev (-> lev bsp) (nonzero? (-> lev bsp nav-meshes)) (-> lev bsp nav-meshes))
      (dotimes (i (-> lev bsp nav-meshes length))
        (let ((m (-> lev bsp nav-meshes i nav-mesh)))
          (if m
              (format 0 " m~D ~D/~D" i (-> m nav-control-count) (-> m max-nav-control-count))
              )
          )
        )
      )
    )
  (format 0 " dots ~D losses ~D/~D" (-> *bf-unit-dots* count) (-> *bf* losses 0) (-> *bf* losses 1))
  (format 0 " jak ~M ~M ~M ships ~A ~A~%" (-> *target* control trans x) (-> *target* control trans y) (-> *target* control trans z)
          (handle->process (-> *bf* points 0 ship)) (handle->process (-> *bf* points 1 ship)))
  0
  )

(defbehavior smoke-s137 process ()
  "Scenario 137 (`smoke-scenario-late`), round 50, a trace of the Spargus battle's first 60 s, 4
   lines a second (`smoke-r50-trace`): where it crashed in scenario 136."
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 0 "deploy blue guard in Spargus")
  (smoke-invulnerable #t)
  (smoke-r50-probe-polys)
  (dotimes (s 240)
    (smoke-r50-trace s)
    (smoke-wait 0.25)
    )
  (smoke-check "60 s of battle in Spargus without a crash" #t)
  (smoke-invulnerable #f)
  (smoke-quit)
  0
  )

;; ----------------------------------------------------------------------------
;; Round 52: Spargus's drops anywhere, no blows, the guards' drill, the robots' shine
;; ----------------------------------------------------------------------------

;; [0] drops seen in wascityb (x below 1990 m), [1] in wascitya (x above 2000 m), [2] Freedom
;; League drops, [3] Krimzon Guard drops, [4] unit samples in a blow (close-attack,
;; close-attack-active), [5] guard samples awake (for the shots a guard a second), [6] the sky log's
;; count read, [7] Freedom League drops in wascitya, [8] Krimzon Guard drops in wascityb
(define *smoke-r52* (new 'static 'array int32 9 0 0 0 0 0 0 0 0 0))

(defun smoke-r52-sample ()
  "One look at the battle into `*smoke-r52*`: the units dropped since the last look (`*bf-sky-log*`),
   by district and side; the units dealing a blow; the guards awake."
  (let ((log *bf-sky-log*))
    (while (< (-> *smoke-r52* 6) (-> log count))
      (let* ((n (mod (-> *smoke-r52* 6) BF_SKY_LOG))
             (x (-> log ground n x))
             (p (handle->process (-> log unit n)))
             (team (if p (bf-unit-team p) -1))
             )
        (when (< (- (-> log count) (-> *smoke-r52* 6)) BF_SKY_LOG)
          (if (< x (meters 1990)) (+! (-> *smoke-r52* 0) 1))
          (if (< (meters 2000) x) (+! (-> *smoke-r52* 1) 1))
          (if (= team BF_TEAM_FF) (+! (-> *smoke-r52* 2) 1))
          (if (= team BF_TEAM_KG) (+! (-> *smoke-r52* 3) 1))
          (if (and (= team BF_TEAM_FF) (< (meters 2000) x)) (+! (-> *smoke-r52* 7) 1))
          (if (and (= team BF_TEAM_KG) (< x (meters 1990))) (+! (-> *smoke-r52* 8) 1))
          )
        )
      (+! (-> *smoke-r52* 6) 1)
      )
    )
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (type? p nav-enemy) (>= (bf-unit-team p) 0) (-> p next-state))
        (let ((st (-> p next-state name)))
          (when (or (= st 'close-attack) (= st 'close-attack-active))
            (+! (-> *smoke-r52* 4) 1)
            (format 0 "SMOKE blow: ~A ~D in ~A~%" (-> p type symbol) (-> p pid) st)
            )
          (if (and (= (-> p type symbol) 'crimson-guard) (!= st 'inactive))
              (+! (-> *smoke-r52* 5) 1)
              )
          )
        )
      #f
      )
    *null-kernel-context*
    )
  0
  )

(defun smoke-r52-tint ((name string))
  "Prints the envmap tints of art group NAME's models (each merc-ctrl's effects): the robots' shine."
  (let ((ag (art-group-get-by-name *level* name (the-as (pointer level) #f))))
    (format 0 "SMOKE tints of ~S (~A):" name (if ag 'loaded 'missing))
    (when ag
      (dotimes (k (-> ag length))
        (let ((geo (the-as merc-ctrl (-> ag data k))))
          (when (and geo (= (-> geo type) merc-ctrl))
            (format 0 " [~D:" k)
            (dotimes (e (the-as int (-> geo header effect-count)))
              (let ((ei (-> geo effect e extra-info)))
                (if (and ei (nonzero? ei) (nonzero? (-> ei envmap-tint-offset)))
                    (format 0 " ~X" (-> (the-as mei-envmap-tint (+ (the-as uint ei) (* (-> ei envmap-tint-offset) 16))) tint))
                    (format 0 " -")
                    )
                )
              )
            (format 0 "]")
            )
          )
        )
      )
    (format 0 "~%")
    )
  0
  )

(define *smoke-r52-seen* (new 'static 'array int32 2 0 0))

(defun smoke-r52-looks ()
  "Prints the draw colors (color-mult, color-emissive) of one awake robotguard of each side."
  (set! (-> *smoke-r52-seen* 0) 0)
  (set! (-> *smoke-r52-seen* 1) 0)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (= (-> p type symbol) 'roboguard-city) (-> p next-state) (!= (-> p next-state name) 'inactive))
        (let ((team (bf-unit-team p))
              (d (-> (the-as process-drawable p) draw))
              )
          (when (and (>= team 0) (zero? (-> *smoke-r52-seen* team)))
            (set! (-> *smoke-r52-seen* team) 1)
            (format 0 "SMOKE robotguard side ~D art ~S mult ~f ~f ~f" team (bf-art-name p)
                    (-> d color-mult x) (-> d color-mult y) (-> d color-mult z))
            (format 0 " emissive ~f ~f ~f~%" (-> d color-emissive x) (-> d color-emissive y) (-> d color-emissive z))
            )
          )
        )
      #f
      )
    *null-kernel-context*
    )
  0
  )

(defbehavior smoke-s138 process ()
  "Scenario 138 (`smoke-scenario-late`), round 52, a battle in Spargus: the units of both sides come
   down anywhere on the map, in both districts, the ships bringing none; no unit deals a blow; the
   guards' shots a second, with the stock fire (`*bf-guard-stock-fire*`) for 60 s then the
   battle's drill for 60 s, and the shots fired off their foe's way; the robots' shine tints; the
   champion's health."
  (dotimes (k 9)
    (set! (-> *smoke-r52* k) 0)
    )
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 0 "deploy blue guard in Spargus")
  (smoke-invulnerable #t)
  (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
  (format 0 "SMOKE the champion's health ~f~%" BF_BOSS_HP)
  (smoke-check "Baron Praxis has 100 points of health" (= BF_BOSS_HP 100.0))
  (smoke-step "stock fire")
  (set! *bf-guard-stock-fire* #t)
  (let ((s0 (-> *bf-guard-shots* 0))
        (g0 (-> *smoke-r52* 5))
        )
    (set! (-> *bf-guard-shots* 1) 0)
    (dotimes (s 240)
      (smoke-wait 0.25)
      (smoke-r52-sample)
      )
    (let ((shots (- (-> *bf-guard-shots* 0) s0))
          (guard-s (* 0.25 (the float (- (-> *smoke-r52* 5) g0))))
          )
      (format 0 "SMOKE stock fire: ~D shots, ~D off their foe's way, ~f guard-seconds: ~f shots a guard a minute~%"
              shots (-> *bf-guard-shots* 1) guard-s (/ (* 60.0 (the float shots)) (fmax 1.0 guard-s)))
      )
    )
  (smoke-r52-tint "roboguard-city")
  (smoke-r52-tint (-> skel-bf-robot-blue art-group-name))
  (smoke-r52-tint "spydroid")
  (smoke-r52-tint (-> skel-bf-spider-blue art-group-name))
  (smoke-r52-looks)
  (smoke-check "the blue robotguard shines as the red one, a dim grey" (= (smoke-r49-tint skel-bf-robot-blue) (the-as uint *bf-robot-shine*)))
  (smoke-shot "r52-stock")
  (smoke-step "the battle's drill")
  (set! *bf-guard-stock-fire* #f)
  (let ((s0 (-> *bf-guard-shots* 0))
        (g0 (-> *smoke-r52* 5))
        )
    (set! (-> *bf-guard-shots* 1) 0)
    (dotimes (s 240)
      (smoke-wait 0.25)
      (smoke-r52-sample)
      )
    (let ((shots (- (-> *bf-guard-shots* 0) s0))
          (guard-s (* 0.25 (the float (- (-> *smoke-r52* 5) g0))))
          )
      (format 0 "SMOKE drill: ~D shots, ~D off their foe's way, ~f guard-seconds: ~f shots a guard a minute~%"
              shots (-> *bf-guard-shots* 1) guard-s (/ (* 60.0 (the float shots)) (fmax 1.0 guard-s)))
      (smoke-check "the guards fire" (> shots 0))
      (smoke-check "no shot more than 20 degrees off the foe's way" (zero? (-> *bf-guard-shots* 1)))
      )
    )
  (smoke-shot "r52-drill")
  (smoke-dots-line "120 s")
  (format 0 "SMOKE drops: wascityb ~D, wascitya ~D; blows ~D~%" (-> *smoke-r52* 0) (-> *smoke-r52* 1) (-> *smoke-r52* 4))
  (format 0 "SMOKE drops: Freedom League ~D (~D in wascitya), Krimzon Guard ~D (~D in wascityb)~%"
          (-> *smoke-r52* 2) (-> *smoke-r52* 7) (-> *smoke-r52* 3) (-> *smoke-r52* 8))
  (smoke-check "both sides' units come down" (and (< 10 (-> *smoke-r52* 2)) (< 10 (-> *smoke-r52* 3))))
  (smoke-check "each side comes down in the other's district too" (and (> (-> *smoke-r52* 7) 0) (> (-> *smoke-r52* 8) 0)))
  (smoke-check "no unit deals a blow" (zero? (-> *smoke-r52* 4)))
  (smoke-check "both sides lose units" (and (> (-> *bf* losses 0) 0) (> (-> *bf* losses 1) 0)))
  (smoke-invulnerable #f)
  (smoke-quit)
  0
  )

;; ----------------------------------------------------------------------------
;; Round 53: Ashelin, the Freedom League's special character and champion
;; ----------------------------------------------------------------------------

;; Clips seen during a move (`smoke-r53-watch`): a bit for each of Ashelin's clips (2 to 12)
(define *smoke-r53-clips* (new 'static 'array int32 1 0))
;; [0] highest over the start, [1] across along the camera's right, [2] across along its heading
(define *smoke-r53-move* (new 'static 'array float 3 0.0 0.0 0.0))

(defbehavior smoke-r53-watch process ((secs float))
  "SECS seconds of the player's Ashelin: the clips she plays into `*smoke-r53-clips*`, her highest
   point over where she stood and her travel across the camera's right and heading into
   `*smoke-r53-move*`. Her process is taken again each frame (`smoke-av`, by its handle): a heap
   compaction moves it, and a pointer kept across frames read another place (round 55: 1.1 km
   away, a stab-clip of 0)."
  (set! (-> *smoke-r53-clips* 0) 0)
  (let ((av (smoke-av)))
    (when av
      (let ((p0 (vector-copy! (new 'stack-no-clear 'vector) (-> av root trans)))
            (right (bf-view-right (new 'stack-no-clear 'vector)))
            (ahead (bf-view-forward (new 'stack-no-clear 'vector)))
            (t0 (smoke-now))
            )
        (set! (-> *smoke-r53-move* 0) 0.0)
        (while (and (< (- (smoke-now) t0) (the int (* 300.0 secs))) (smoke-av))
          (set! av (smoke-av))
          (let ((a (-> av anim)))
            (if (and (>= a 0) (< a 32))
                (logior! (-> *smoke-r53-clips* 0) (ash 1 a))
                )
            )
          (set! (-> *smoke-r53-move* 0) (fmax (-> *smoke-r53-move* 0) (- (-> av root trans y) (-> p0 y))))
          (suspend)
          )
        (if (smoke-av)
            (set! av (smoke-av))
            )
        (let ((d (vector-! (new 'stack-no-clear 'vector) (-> av root trans) p0)))
          (set! (-> *smoke-r53-move* 1) (vector-dot d right))
          (set! (-> *smoke-r53-move* 2) (vector-dot d ahead))
          )
        )
      )
    )
  0
  )

(defun smoke-r53-seen? ((clip int))
  "#t when the last watch saw Ashelin's clip CLIP."
  (logtest? (-> *smoke-r53-clips* 0) (ash 1 clip))
  )

(defun smoke-r53-line ((tag string))
  "One line of the last watch: TAG, the clips seen, the highest point and the travel."
  (format 0 "SMOKE ~S: clips #x~X, up ~M, right ~M, ahead ~M~%" tag (-> *smoke-r53-clips* 0) (-> *smoke-r53-move* 0)
          (-> *smoke-r53-move* 1) (-> *smoke-r53-move* 2))
  0
  )

(define *smoke-r53-lob* (the-as process #f))

(defun smoke-r55-firing? ((av bf-avatar))
  "#t when AV's arms play her firing clip over her legs' (`top-anim`, round 55)."
  (let ((top (-> av skel top-anim)))
    (and top (< 0.0 (-> top interp)) (= (-> top frame-group) (-> av draw art-group data BF_ASHELIN_CLIP_FIRE)))
    )
  )

(defun smoke-r53-lob ()
  "The first `bf-lob` flying, #f for none."
  (set! *smoke-r53-lob* #f)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process)) (if (and (not *smoke-r53-lob*) (= (-> p type symbol) 'bf-lob)) (set! *smoke-r53-lob* p)) #f)
    *null-kernel-context*
    )
  *smoke-r53-lob*
  )

(defbehavior smoke-s139 process ()
  "Scenario 139 (`smoke-scenario-late`), round 53, Ashelin in Jak 2's city, special characters on:
   her picture for the class page (`smoke-portrait-9`); the Freedom League player as Ashelin (the
   class page's fifth row), round 54's buttons and round 55's Jak moves: her run (its clip at the
   rate her speed asks: no sliding), her jump and her second jump in the air (a flip), her side
   flips (R2 and the stick), her crouch (L1), her roll (L1 and the stick) and its far flip (X during
   it), her two pistols firing in turn (R1 held, her firing clip on her arms) until her
   magazine is empty, her reload and on (10 rounds, 150 carried), Triangle's reload, her strafe and
   walk backward while she fires, her kick (Circle), her grenade thrown in an arc (L2, one of her
   10); then the Freedom League's losses set to its share: Ashelin comes as its
   champion, put near the Krimzon Guard's units, 60 s watched: she moves, fires, flips, throws and
   reloads, the Krimzon Guard's units hurt her, her health bar shows."
  (set! (-> *bf-config* special) 1)
  (smoke-battle-start BF_ZONE_JAK2 BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-shot "r53-ashelin")
  ;; her picture, as scenario 128 took the Baron's
  (smoke-step "her picture")
  (set! (-> (smoke-dir) page) 9)
  (bf-black-set! #t)
  (set-master-mode 'menu)
  (smoke-wait 1.5)
  (let ((icon (bf-icon-spawn BF_CLASS_ASHELIN 0.0 25.0 (smoke-dir))))
    (format 0 "SMOKE portrait 9 model ~A~%" (if icon #t #f))
    (when icon
      (bf-icon-place icon 256.0 208.0 300.0 (meters 3))
      (smoke-wait 1.5)
      (smoke-shot "portrait-9")
      (smoke-wait 1.0)
      (deactivate icon)
      )
    (smoke-check "Ashelin's model shown alone on black" icon)
    )
  (set-master-mode 'game)
  (bf-black-set! #f)
  (set! (-> (smoke-dir) page) BF_PAGE_NONE)
  (smoke-wait 1.0)
  ;; her moves (round 54: Mixamo's pistol motions, the author's buttons)
  (smoke-step "her run")
  (smoke-stick 128 0 128 128)
  (smoke-r53-watch 1.5)
  (let* ((av (smoke-av))
         (speed (if av (vector-xz-length (-> (the-as collide-shape-moving (-> av root)) transv)) 0.0))
         (rate (if av (-> av skel root-channel 0 param 0) 0.0))
         )
    (format 0 "SMOKE run speed ~M/s, clip rate ~f, her feet's ~f~%" speed rate (/ speed BF_ASH_RUN_GROUND))
    (smoke-check "her run clip at the rate her speed asks (no sliding, round 55)"
                 (< (fabs (- rate (/ speed BF_ASH_RUN_GROUND))) 0.05)
                 )
    )
  (smoke-neutral)
  (smoke-r53-line "run")
  (smoke-check "she runs (9 m in 1.5 s, her run clip)" (and (< (meters 9) (-> *smoke-r53-move* 2)) (smoke-r53-seen? BF_ASHELIN_CLIP_RUN)))
  (smoke-wait 1.0)
  (smoke-step "her jumps")
  (smoke-tap (pad-buttons x) 3)
  (smoke-r53-watch 1.6)
  (smoke-r53-line "one jump")
  (let ((one (-> *smoke-r53-move* 0))
        (av (smoke-av))
        (top 0.0)
        (flip? #f)
        )
    (smoke-wait 0.8)
    (when av
      (let ((y0 (-> av root trans y))
            (t0 (smoke-now))
            )
        (smoke-tap (pad-buttons x) 3)
        (while (and (< (- (smoke-now) t0) (the int (* 300.0 2.2))) (smoke-av))
          (set! av (smoke-av))
          ;; X again 0.4 s after the first, in the air
          (if (= (- (smoke-now) t0) 120)
              (smoke-tap (pad-buttons x) 3)
              )
          (if (= (- (smoke-now) t0) 150)
              (smoke-shot "r54-flip")
              )
          (if (= (-> av anim) BF_ASHELIN_CLIP_FLIP)
              (set! flip? #t)
              )
          (set! top (fmax top (- (-> av root trans y) y0)))
          (suspend)
          )
        )
      )
    (format 0 "SMOKE two jumps: up ~M (one jump ~M), flip ~A~%" top one flip?)
    (smoke-check "X: she jumps 3.5 m or more, her jump clip" (and (< (meters 3.5) one) (smoke-r53-seen? BF_ASHELIN_CLIP_JUMP)))
    (smoke-check "one jump alone: no flip" (not (smoke-r53-seen? BF_ASHELIN_CLIP_FLIP)))
    (smoke-check "X again in the air goes higher, a flip" (and (< (+ one (meters 1.5)) top) flip?))
    )
  (smoke-wait 1.0)
  (smoke-step "her side flips")
  ;; each flip stays within 15 m (round 55: a watch keeping her process's pointer across frames read
  ;; her 1.1 km away once a heap compaction moved her; `smoke-r53-watch` takes her again each frame)
  (smoke-hold (pad-buttons r2))
  (smoke-stick 0 128 128 128)
  (smoke-wait 0.15)
  (smoke-shot "r54-flip-left")
  (smoke-r53-watch 1.0)
  (smoke-neutral)
  (smoke-r53-line "flip left")
  (smoke-check "R2 and the stick left: a flip to the left, 6 to 15 m"
               (and (< (meters -15) (-> *smoke-r53-move* 1)) (< (-> *smoke-r53-move* 1) (meters -6)) (smoke-r53-seen? BF_ASHELIN_CLIP_FLIP_LEFT))
               )
  (smoke-wait 0.6)
  (smoke-hold (pad-buttons r2))
  (smoke-stick 255 128 128 128)
  (smoke-wait 0.15)
  (smoke-shot "r54-flip-right")
  (smoke-r53-watch 1.0)
  (smoke-neutral)
  (smoke-r53-line "flip right")
  (smoke-check "R2 and the stick right: a flip to the right, 6 to 15 m"
               (and (< (meters 6) (-> *smoke-r53-move* 1)) (< (-> *smoke-r53-move* 1) (meters 15)) (smoke-r53-seen? BF_ASHELIN_CLIP_FLIP_RIGHT))
               )
  (smoke-wait 0.6)
  (smoke-step "she kneels")
  (smoke-hold (pad-buttons l1))
  (smoke-wait 0.2)
  (smoke-r53-watch 1.6)
  (smoke-shot "r54-kneel")
  (smoke-r53-line "kneel")
  (smoke-check "L1 held: she kneels, then stays kneeling" (and (smoke-r53-seen? BF_ASHELIN_CLIP_KNEEL) (smoke-r53-seen? BF_ASHELIN_CLIP_KNEEL_IDLE)))
  (smoke-hold (pad-buttons))
  (smoke-r53-watch 1.0)
  (smoke-r53-line "stand up")
  (smoke-check "L1 let go: she stands up" (smoke-r53-seen? BF_ASHELIN_CLIP_UNKNEEL))
  (smoke-wait 0.5)
  ;; round 55: Jak's roll on Jak's buttons
  (smoke-step "her roll")
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (smoke-tap (pad-buttons l1) 3)
  (smoke-wait 0.1)
  (smoke-shot "r55-roll")
  (smoke-r53-watch 0.7)
  (smoke-neutral)
  (smoke-r53-line "roll")
  (smoke-check "L1 and the stick: her roll, 4 m or more ahead" (and (smoke-r53-seen? BF_ASHELIN_CLIP_ROLL) (< (meters 4) (-> *smoke-r53-move* 2))))
  (smoke-wait 1.0)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (smoke-tap (pad-buttons l1) 3)
  (smoke-wait 0.15)
  (smoke-tap (pad-buttons x) 3)
  (smoke-r53-watch 1.2)
  (smoke-shot "r55-roll-flip")
  (smoke-neutral)
  (smoke-r53-line "roll and X")
  (smoke-check "X during her roll: a flip, 2.5 m up and 10 m ahead or more"
               (and (smoke-r53-seen? BF_ASHELIN_CLIP_FLIP) (< (meters 2.5) (-> *smoke-r53-move* 0)) (< (meters 10) (-> *smoke-r53-move* 2)))
               )
  (smoke-wait 1.0)
  (smoke-step "her pistols")
  (let ((av (smoke-av))
        (shots 0)
        (sides 0)
        (yellow0 (-> *game-info* gun-ammo BF_AMMO_YELLOW))
        (mag0 (-> *bf* mag BF_WEAPON_PISTOL))
        (reload? #f)
        (arms? #f)
        )
    (when av
      (let ((last (-> av fire-time))
            (t0 (smoke-now))
            )
        (smoke-hold (pad-buttons r1))
        (while (and (< (- (smoke-now) t0) (the int (* 300.0 4.0))) (smoke-av))
          (set! av (smoke-av))
          (when (!= last (-> av fire-time))
            (set! last (-> av fire-time))
            (+! shots 1)
            (if (zero? (-> av fire-side))
                (+! sides 1)
                )
            )
          (if (= (-> av anim) BF_ASHELIN_CLIP_RELOAD)
              (set! reload? #t)
              )
          (if (smoke-r55-firing? av)
              (set! arms? #t)
              )
          (if (= (- (smoke-now) t0) 150)
              (smoke-shot "r54-fire")
              )
          (if (= (- (smoke-now) t0) 160)
              (smoke-shot "r55-recoil")
              )
          (if (= (- (smoke-now) t0) 630)
              (smoke-shot "r54-reload")
              )
          (suspend)
          )
        (smoke-hold (pad-buttons))
        )
      )
    (format 0 "SMOKE pistols: ~D shots in 4 s, ~D from the left one, magazine ~D then ~D~%"
            shots sides mag0 (-> *bf* mag BF_WEAPON_PISTOL)
            )
    (format 0 "SMOKE carried ~f then ~f, reload seen ~A~%" yellow0 (-> *game-info* gun-ammo BF_AMMO_YELLOW) reload?)
    (smoke-check "R1 held: both pistols in turn" (and (< 1 sides) (< sides shots)))
    (smoke-check "her firing clip and its recoil on her arms (round 55)" arms?)
    (smoke-check "10 rounds, then a reload, then she fires on" (and (= mag0 10) (< 10 shots) reload?))
    (smoke-check "150 rounds carried, the reload took 10" (and (= yellow0 150.0) (= (-> *game-info* gun-ammo BF_AMMO_YELLOW) 140.0)))
    )
  (smoke-wait 0.5)
  (smoke-step "Triangle reloads")
  (let ((mag0 (-> *bf* mag BF_WEAPON_PISTOL)))
    (smoke-tap (pad-buttons triangle) 3)
    (smoke-r53-watch 1.5)
    (format 0 "SMOKE Triangle: magazine ~D then ~D~%" mag0 (-> *bf* mag BF_WEAPON_PISTOL))
    (smoke-check "Triangle: her reload, a full magazine" (and (smoke-r53-seen? BF_ASHELIN_CLIP_RELOAD) (= (-> *bf* mag BF_WEAPON_PISTOL) 10)))
    )
  (smoke-step "she fires walking")
  (smoke-hold (pad-buttons r1))
  (smoke-stick 0 128 128 128)
  (smoke-r53-watch 1.0)
  (smoke-r53-line "strafe left")
  (smoke-shot "r55-strafe-fire")
  (smoke-check "firing while she walks aside: her arms fire over her legs' clip"
               (and (smoke-av) (smoke-r55-firing? (the-as bf-avatar (smoke-av))))
               )
  (smoke-check "R1 and the stick left: her strafe to the left, facing ahead" (and (smoke-r53-seen? BF_ASHELIN_CLIP_STRAFE_LEFT) (< (-> *smoke-r53-move* 1) (meters -1.5))))
  (set! (-> *bf* mag BF_WEAPON_PISTOL) 10)
  (smoke-stick 128 255 128 128)
  (smoke-r53-watch 1.0)
  (smoke-r53-line "walk back")
  (smoke-check "R1 and the stick back: her walk backward" (and (smoke-r53-seen? BF_ASHELIN_CLIP_WALK_BACK) (< (-> *smoke-r53-move* 2) (meters -1.5))))
  (smoke-neutral)
  (smoke-wait 0.8)
  (smoke-step "her kick")
  (smoke-tap (pad-buttons circle) 3)
  (smoke-wait 0.5)
  (smoke-shot "r54-kick")
  (smoke-r53-watch 1.0)
  (smoke-r53-line "kick")
  (smoke-check "Circle: her spinning kick" (smoke-r53-seen? BF_ASHELIN_CLIP_KICK))
  (smoke-wait 0.5)
  (smoke-step "her grenade")
  (let ((n0 (-> *bf* rockets))
        (top 0.0)
        (y0 0.0)
        (seen? #f)
        )
    (smoke-tap (pad-buttons l2) 3)
    (let ((t0 (smoke-now)))
      (while (< (- (smoke-now) t0) (the int (* 300.0 2.5)))
        (if (= (- (smoke-now) t0) 90)
            (smoke-shot "r54-throw")
            )
        (let ((lob (the-as process-drawable (smoke-r53-lob))))
          (when lob
            (when (not seen?)
              (set! seen? #t)
              (set! y0 (-> lob root trans y))
              (set! top y0)
              (smoke-shot "r54-lob")
              )
            (set! top (fmax top (-> lob root trans y)))
            )
          )
        (suspend)
        )
      )
    (format 0 "SMOKE grenade: ~D then ~D, its arc ~M over its start~%" n0 (-> *bf* rockets) (- top y0))
    (smoke-check "L2: a grenade thrown overhand, one of hers" (and seen? (= (-> *bf* rockets) (+ n0 -1))))
    ;; its arc lower for a nearer aim (round 55: she stands 25 m farther down the street by then)
    (smoke-check "it flies in an arc (1 m over its start or more)" (< (meters 1.0) (- top y0)))
    )
  (format 0 "SMOKE her health ~f of ~f~%" (-> *target* fact health) (bf-class-health BF_CLASS_ASHELIN))
  ;; the Freedom League's champion
  (smoke-step "the Freedom League's champion")
  (set! (-> *bf* losses BF_TEAM_FF) (bf-boss-need))
  (smoke-wait-for 15.0 (lambda () (handle->process (-> *bf-boss-ref* champ BF_TEAM_FF))))
  (smoke-check "Ashelin comes once the Freedom League lost its share" (handle->process (-> *bf-boss-ref* champ BF_TEAM_FF)))
  (when (handle->process (-> *bf-boss-ref* champ BF_TEAM_FF))
    (let* ((boss (the-as bf-boss (handle->process (-> *bf-boss-ref* champ BF_TEAM_FF))))
           (dots *bf-unit-dots*)
           (clips 0)
          (shots 0)
          (last 0)
          (rolls 0)
          (lobs 0)
          (kg0 (-> *bf* losses BF_TEAM_KG))
          (class (-> boss class))
          (team (-> boss team))
          (p0 (new 'stack-no-clear 'vector))
          (most 0.0)
          )
      (format 0 "SMOKE champion class ~D team ~D body ~A~%" (-> boss class) (-> boss team) (handle->process (-> boss body)))
      ;; among the Krimzon Guard's units
      (dotimes (d (-> dots count))
        (when (and (= (-> dots team d) BF_TEAM_KG) (< (fabs (- (-> dots pos d y) (-> *target* control trans y))) (meters 30)))
          (vector-copy! (-> boss root trans) (-> dots pos d))
          (+! (-> boss root trans x) (meters 15))
          (+! (-> boss root trans y) (meters 1))
          (vector-copy! (-> boss last-pos) (-> boss root trans))
          (set! d (-> dots count))
          )
        )
      (vector-copy! p0 (-> boss root trans))
      ;; the player beside her, for her bar
      (vector-copy! (-> *bf* safe) (-> boss root trans))
      (move-to-point! (-> *target* control) (vector+! (new 'stack-no-clear 'vector) (-> boss root trans) (new 'static 'vector :x 20480.0 :y 4096.0)))
      (let ((t0 (smoke-now)))
        (while (and (< (- (smoke-now) t0) (the int (* 300.0 60.0))) (handle->process (-> *bf-boss-ref* champ BF_TEAM_FF)))
          ;; her process again each frame: a heap's compaction moves it (a pointer kept crashed the test)
          (let ((boss (the-as bf-boss (handle->process (-> *bf-boss-ref* champ BF_TEAM_FF)))))
            (let ((a (-> boss anim)))
              (if (and (>= a 0) (< a 32))
                  (logior! clips (ash 1 a))
                  )
              )
            (when (!= last (-> boss fire-time))
              (set! last (-> boss fire-time))
              (+! shots 1)
              )
            (set! most (fmax most (vector-vector-xz-distance p0 (-> boss root trans))))
            (when (= (mod (- (smoke-now) t0) 3000) 0)
              (format 0 "SMOKE champion ~Ds: hp ~f foe ~M anim ~D moved ~M~%" (/ (- (smoke-now) t0) 300) (-> *bf-boss-hps* BF_TEAM_FF)
                      (-> boss foe-dist) (-> boss anim) most)
              )
            )
          (if (= (- (smoke-now) t0) 1500)
              (smoke-shot "r53-champion")
              )
          (suspend)
          )
        )
      (if (logtest? clips (ash 1 BF_ASHELIN_CLIP_FLIP_LEFT)) (+! rolls 1))
      (if (logtest? clips (ash 1 BF_ASHELIN_CLIP_FLIP_RIGHT)) (+! rolls 1))
      (if (logtest? clips (ash 1 BF_ASHELIN_CLIP_THROW)) (+! lobs 1))
      (format 0 "SMOKE champion: clips #x~X shots ~D moved ~M, hp ~f" clips shots most (-> *bf-boss-hps* BF_TEAM_FF))
      (format 0 ", Krimzon Guard lost ~D meanwhile, attacks on her ~D (own side ~D)~%" (- (-> *bf* losses BF_TEAM_KG) kg0)
              (-> *bf-boss-hits* 0) (-> *bf-boss-hits* 1))
      (smoke-check "the champion is Ashelin, of the Freedom League" (and (= class BF_CLASS_ASHELIN) (= team BF_TEAM_FF)))
      (smoke-check "she fires her pistols" (< 10 shots))
      (smoke-check "she flips aside and throws grenades" (and (> rolls 0) (> lobs 0)))
      (smoke-check "she reloads" (logtest? clips (ash 1 BF_ASHELIN_CLIP_RELOAD)))
      (smoke-check "the Krimzon Guard's units hurt her" (< (-> *bf-boss-hps* BF_TEAM_FF) BF_BOSS_HP))
      (smoke-check "she moves" (< (meters 5) most))
      )
    )
  (smoke-invulnerable #f)
  (smoke-quit)
  (set! (-> *bf-config* special) 0)
  0
  )

;; ----------------------------------------------------------------------------
;; Round 54: Spargus, the destruction of an objective
;; ----------------------------------------------------------------------------

(defun smoke-r54-front ()
  "Prints where the sides stand against the artifact: the Krimzon Guard's unit nearest it, its units
   within 100 m and their westmost x; the Freedom League's units within 60 m of it."
  (let ((dots *bf-unit-dots*)
        (near -1.0)
        (kg100 0)
        (ff60 0)
        (west 1000000000.0)
        (at (-> *bf* points 2 pos))
        )
    (dotimes (d (-> dots count))
      (let ((dist (vector-vector-xz-distance (-> dots pos d) at)))
        (cond
          ((= (-> dots team d) BF_TEAM_KG)
           (if (or (< near 0.0) (< dist near)) (set! near dist))
           (if (< dist (meters 100)) (+! kg100 1))
           (set! west (fmin west (-> dots pos d x)))
           )
          ((= (-> dots team d) BF_TEAM_FF)
           (if (< dist (meters 60)) (+! ff60 1))
           )
          )
        )
      )
    (format 0 "SMOKE front: nearest Krimzon Guard ~M from the artifact, ~D within 100 m, westmost x ~M; Freedom League within 60 m ~D~%"
            near kg100 west ff60
            )
    )
  0
  )

;; round 55: the Freedom League's units within 60 m of the artifact, its units, both summed over the
;; looks, and the most of them east of the pass in one look
(define *smoke-r55* (new 'static 'array int32 3 0 0 0))

(defun smoke-r55-tally ()
  "Adds one look at the Freedom League's units to `*smoke-r55*`: those within 60 m of the artifact,
   all of them, and the most east of the pass (`bf-city-hunt`'s BF_HUNT_WEST)."
  (let ((dots *bf-unit-dots*)
        (east 0)
        )
    (dotimes (d (-> dots count))
      (when (= (-> dots team d) BF_TEAM_FF)
        (+! (-> *smoke-r55* 1) 1)
        (if (< (vector-vector-xz-distance (-> dots pos d) (-> *bf* points 2 pos)) (meters 60))
            (+! (-> *smoke-r55* 0) 1)
            )
        (if (< (meters 1968) (-> dots pos d x))
            (+! east 1)
            )
        )
      )
    (set! (-> *smoke-r55* 2) (max (-> *smoke-r55* 2) east))
    )
  0
  )

;; the unit found, a handle (a process kept in a global symbol came back with an invalid type)
(define *smoke-r54-ref* (new 'static 'bf-boss-ref))

(defun smoke-r54-kg-unit ()
  "An awake unit of the Krimzon Guard (a nav-enemy of that side, not dead), #f for none."
  (set! (-> *smoke-r54-ref* champ 0) (the-as handle #f))
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (if (and (not (handle->process (-> *smoke-r54-ref* champ 0))) (type? p nav-enemy) (= (bf-unit-team p) BF_TEAM_KG)
               (-> p next-state) (!= (-> p next-state name) 'inactive) (not (focus-test? (the-as process-focusable p) dead))
               )
          (set! (-> *smoke-r54-ref* champ 0) (process->handle p))
          )
      #f
      )
    *null-kernel-context*
    )
  (handle->process (-> *smoke-r54-ref* champ 0))
  )

;; Round 56: Ashelin's moves in the game, one after the other, recorded for the author's GIF
(define *smoke-r56-home* (new 'static 'vector))  ;; where each move starts (an open street)
(define *smoke-r56-home?* #f)

(defbehavior smoke-r56-rec process ((tag string))
  "Ashelin (and Jak, hidden, under her) put back where the first move started, still, 0.6 s for the
   camera; a full magazine; then the recording of one move: smoke-rec-TAG-<n>.png, a frame every 4
   game frames (15 a second). The moves drifted her into a dark alley against a wall, a side flip
   cut short."
  (let ((av (smoke-av)))
    (when av
      (cond
        (*smoke-r56-home?*
         (vector-copy! (-> av root trans) *smoke-r56-home*)
         (vector-copy! (-> *target* control trans) *smoke-r56-home*)
         (vector-reset! (-> (the-as collide-shape-moving (-> av root)) transv))
         )
        (else
          (vector-copy! *smoke-r56-home* (-> av root trans))
          (set! *smoke-r56-home?* #t)
          )
        )
      )
    )
  (smoke-wait 0.6)
  (set! (-> *bf* mag BF_WEAPON_PISTOL) 10)
  (smoke-rec-start tag 4)
  0
  )

(defbehavior smoke-r56-end process ()
  "The move's recording stopped, the pad let go, a short pause."
  (smoke-rec-stop)
  (smoke-neutral)
  (smoke-wait 0.6)
  0
  )

(defbehavior smoke-s141 process ()
  "Scenario 141 (`smoke-scenario-late`), round 56, the Freedom League player as Ashelin in Jak 2's
   city, special characters on: each of her moves recorded in turn (`smoke-r56-rec`) for one GIF of
   them in the game: her idle, walk and run; her firing (R1) standing, walking, running, aside to
   the left and right, backward; her reload (Triangle); her two jumps (X twice); her jump kick (X
   then Circle); her spinning kick (Circle); her pistol whip (Square); her grenade (L2); her crouch
   (L1 held); her roll (L1 and the stick) and its far flip (X during it); her side flips (R2 and the
   stick aside). Checks nothing but that she stays deployed."
  (set! (-> *bf-config* special) 1)
  (smoke-battle-start BF_ZONE_JAK2 BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r56-rec "01-idle") (smoke-wait 1.2) (smoke-r56-end)
  (smoke-stick 128 83 128 128) (smoke-r56-rec "02-walk") (smoke-wait 1.6) (smoke-r56-end)
  (smoke-stick 128 0 128 128) (smoke-r56-rec "03-run") (smoke-wait 1.6) (smoke-r56-end)
  (smoke-hold (pad-buttons r1)) (smoke-r56-rec "04-fire") (smoke-wait 1.4) (smoke-r56-end)
  (smoke-hold (pad-buttons r1)) (smoke-stick 128 83 128 128) (smoke-r56-rec "05-fire-walk") (smoke-wait 1.6) (smoke-r56-end)
  (smoke-hold (pad-buttons r1)) (smoke-stick 128 0 128 128) (smoke-r56-rec "06-fire-run") (smoke-wait 1.6) (smoke-r56-end)
  (smoke-hold (pad-buttons r1)) (smoke-stick 0 128 128 128) (smoke-r56-rec "07-strafe-left") (smoke-wait 1.4) (smoke-r56-end)
  (smoke-hold (pad-buttons r1)) (smoke-stick 255 128 128 128) (smoke-r56-rec "08-strafe-right") (smoke-wait 1.4) (smoke-r56-end)
  (smoke-hold (pad-buttons r1)) (smoke-stick 128 255 128 128) (smoke-r56-rec "09-walk-back") (smoke-wait 1.4) (smoke-r56-end)
  (smoke-r56-rec "10-reload")
  (set! (-> *bf* mag BF_WEAPON_PISTOL) 4)
  (smoke-press (pad-buttons triangle) 2.5)
  (smoke-r56-end)
  (smoke-r56-rec "11-jumps")
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 0.45)
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 1.9)
  (smoke-r56-end)
  (smoke-r56-rec "12-jumpkick")
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 0.4)
  (smoke-tap (pad-buttons circle) 3)
  (smoke-wait 1.7)
  (smoke-r56-end)
  (smoke-r56-rec "13-kick") (smoke-press (pad-buttons circle) 1.4) (smoke-r56-end)
  (smoke-r56-rec "14-butt") (smoke-press (pad-buttons square) 1.3) (smoke-r56-end)
  (smoke-r56-rec "15-throw") (smoke-press (pad-buttons l2) 1.7) (smoke-r56-end)
  (smoke-r56-rec "16-crouch")
  (smoke-hold (pad-buttons l1))
  (smoke-wait 1.3)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-wait 0.5)
  (smoke-r56-end)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (smoke-r56-rec "17-roll")
  (smoke-tap (pad-buttons l1) 4)
  (smoke-wait 1.0)
  (smoke-r56-end)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (smoke-r56-rec "18-roll-flip")
  (smoke-tap (pad-buttons l1) 4)
  (smoke-wait 0.15)
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 1.9)
  (smoke-r56-end)
  (smoke-r56-rec "19-flip-left")
  (smoke-stick 0 128 128 128)
  (smoke-hold (pad-buttons r2))
  (smoke-wait 1.2)
  (smoke-r56-end)
  (smoke-r56-rec "20-flip-right")
  (smoke-stick 255 128 128 128)
  (smoke-hold (pad-buttons r2))
  (smoke-wait 1.2)
  (smoke-r56-end)
  (smoke-check "she is still deployed, as Ashelin" (smoke-av))
  )

;; Round 57: Ashelin's moves fixed after the author's play, and Spargus walled at its pass
(define *smoke-r57-pos* (new 'static 'vector))

(defun smoke-r57-mark ()
  "Ashelin's place now kept (`*smoke-r57-pos*`)."
  (let ((av (smoke-av)))
    (if av
        (vector-copy! *smoke-r57-pos* (-> av root trans))
        )
    )
  0
  )

(defun smoke-r57-moved ()
  "How far across Ashelin went since `smoke-r57-mark`, meters."
  (let ((av (smoke-av)))
    (if av
        (/ (vector-vector-xz-distance *smoke-r57-pos* (-> av root trans)) (meters 1))
        -1.0
        )
    )
  )

(define *smoke-r57-lob* (new 'static 'array float 4))

(defun smoke-r57-lob-look ()
  "Her grenade in flight, if any: its height kept, the highest and the last (`*smoke-r57-lob*` 0 the
   first, 1 the highest, 2 the last, 3 the looks)."
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (= (-> p type symbol) 'bf-lob)
        (let ((y (-> (the-as process-drawable p) root trans y)))
          (if (zero? (-> *smoke-r57-lob* 3))
              (set! (-> *smoke-r57-lob* 0) y)
              )
          (set! (-> *smoke-r57-lob* 1) (fmax (-> *smoke-r57-lob* 1) y))
          (set! (-> *smoke-r57-lob* 2) y)
          (+! (-> *smoke-r57-lob* 3) 1.0)
          )
        )
      #f
      )
    *null-kernel-context*
    )
  0
  )

(defbehavior smoke-s142 process ()
  "Scenario 142 (`smoke-scenario-late`), round 57, the Freedom League player as Ashelin in Jak 2's
   city, special characters on: her moves the author found wrong, recorded for a GIF (`smoke-r56-rec`):
   her firing; her reload standing, running, and her run after it (she could not move on after a
   reload); her grenade's arc; her side flips (she slid on after them); her far flip out of a roll
   and her jump kick, ending where she lands; her pistol whip twice in a row."
  (set! (-> *bf-config* special) 1)
  (set! *smoke-r56-home?* #f)
  (smoke-battle-start BF_ZONE_JAK2 BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-hold (pad-buttons r1)) (smoke-r56-rec "01-fire") (smoke-wait 1.6) (smoke-r56-end)
  ;; her reload standing, then her run: she moves on
  (smoke-r56-rec "02-reload")
  (set! (-> *bf* mag BF_WEAPON_PISTOL) 4)
  (smoke-tap (pad-buttons triangle) 3)
  (smoke-wait 2.5)
  (smoke-r57-mark)
  (smoke-stick 128 0 128 128)
  (smoke-wait 1.0)
  (format 0 "SMOKE run after a reload: ~f m in 1 s, magazine ~D~%" (smoke-r57-moved) (-> *bf* mag BF_WEAPON_PISTOL))
  (smoke-check "after her reload she runs on (over 5 m in 1 s)" (< 5.0 (smoke-r57-moved)))
  (smoke-check "her magazine full again" (= (-> *bf* mag BF_WEAPON_PISTOL) 10))
  (smoke-r56-end)
  ;; her reload while she runs
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.5)
  (smoke-r56-rec "03-reload-run")
  (set! (-> *bf* mag BF_WEAPON_PISTOL) 2)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.4)
  (smoke-r57-mark)
  (smoke-tap (pad-buttons triangle) 3)
  (smoke-wait 0.2)
  (let ((av (the-as bf-avatar (smoke-av))))
    (smoke-check "her reload plays on her arms (her legs' clip her run)"
                 (and av (= (-> av reload-step) 1) (= (-> av anim) BF_ASHELIN_CLIP_RUN))
                 )
    )
  (smoke-wait 2.3)
  (format 0 "SMOKE reload on the run: ~f m in 2.5 s, magazine ~D~%" (smoke-r57-moved) (-> *bf* mag BF_WEAPON_PISTOL))
  (smoke-check "she runs on while she reloads (over 15 m in 2.5 s)" (< 15.0 (smoke-r57-moved)))
  (smoke-check "her magazine full again on the run" (= (-> *bf* mag BF_WEAPON_PISTOL) 10))
  (smoke-r56-end)
  ;; R1 on an empty magazine: the reload, then her run with R1 let go
  (set! (-> *bf* mag BF_WEAPON_PISTOL) 0)
  (smoke-hold (pad-buttons r1))
  (smoke-wait 0.3)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-wait 2.4)
  (smoke-r57-mark)
  (smoke-stick 128 0 128 128)
  (smoke-wait 1.0)
  (format 0 "SMOKE run after an empty magazine's reload: ~f m in 1 s~%" (smoke-r57-moved))
  (smoke-check "after the reload of an empty magazine she runs on" (< 5.0 (smoke-r57-moved)))
  (smoke-neutral)
  (smoke-wait 0.6)
  ;; her grenade's arc
  (dotimes (k 4)
    (set! (-> *smoke-r57-lob* k) 0.0)
    )
  (smoke-r56-rec "04-throw")
  (smoke-tap (pad-buttons l2) 3)
  (dotimes (k 40)
    (smoke-wait 0.05)
    (smoke-r57-lob-look)
    )
  (format 0 "SMOKE grenade: first ~M high, highest ~M, last ~M, ~D looks~%" (-> *smoke-r57-lob* 0) (-> *smoke-r57-lob* 1)
          (-> *smoke-r57-lob* 2) (the int (-> *smoke-r57-lob* 3))
          )
  (smoke-check "her grenade flies in an arc: up at least 1 m, then down at least 1 m"
               (and (< (meters 1) (- (-> *smoke-r57-lob* 1) (-> *smoke-r57-lob* 0)))
                    (< (meters 1) (- (-> *smoke-r57-lob* 1) (-> *smoke-r57-lob* 2)))
                    )
               )
  (smoke-r56-end)
  ;; her side flips: across while in the air, then she stands
  (smoke-r56-rec "05-flip-left")
  (smoke-r57-mark)
  (smoke-stick 0 128 128 128)
  (smoke-hold (pad-buttons r2))
  (smoke-wait 0.15)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-stick 128 128 128 128)
  (smoke-wait 0.85)
  (let ((mid (smoke-r57-moved)))
    (smoke-wait 0.8)
    (format 0 "SMOKE side flip: ~f m at its landing, ~f m at its end~%" mid (smoke-r57-moved))
    (smoke-check "her side flip covers 8 to 11 m" (and (< 8.0 (smoke-r57-moved)) (< (smoke-r57-moved) 11.0)))
    (smoke-check "she stands where she lands (under 0.5 m more)" (< (- (smoke-r57-moved) mid) 0.5))
    )
  (smoke-r56-end)
  (smoke-r56-rec "06-flip-right")
  (smoke-stick 255 128 128 128)
  (smoke-hold (pad-buttons r2))
  (smoke-wait 0.15)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-stick 128 128 128 128)
  (smoke-wait 1.6)
  (smoke-r56-end)
  ;; her far flip out of a roll, landing into her run
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (smoke-r56-rec "07-roll-flip")
  (smoke-tap (pad-buttons l1) 4)
  (smoke-wait 0.15)
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 1.0)
  (let ((av (smoke-av)))
    (format 0 "SMOKE far flip landed: speed ~M, clip ~D~%" (vector-xz-length (-> (the-as collide-shape-moving (-> av root)) transv))
            (-> (the-as bf-avatar av) anim)
            )
    (smoke-check "her far flip lands into her run (9 to 10 m/s)"
                 (let ((v (vector-xz-length (-> (the-as collide-shape-moving (-> av root)) transv))))
                   (and (< (meters 8.5) v) (< v (meters 10)))
                   )
                 )
    )
  (smoke-wait 0.6)
  (smoke-r56-end)
  (smoke-r56-rec "08-jumpkick")
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 0.4)
  (smoke-tap (pad-buttons circle) 3)
  (smoke-wait 1.7)
  (smoke-r56-end)
  (smoke-r56-rec "09-butt-twice")
  (smoke-tap (pad-buttons square) 3)
  (smoke-wait 1.1)
  (smoke-tap (pad-buttons square) 3)
  (smoke-wait 1.3)
  (smoke-r56-end)
  (smoke-check "she is still deployed, as Ashelin" (smoke-av))
  )

(defbehavior smoke-s143 process ()
  "Scenario 143 (`smoke-scenario-late`), round 57, a battle in Spargus as Ashelin of the Freedom
   League: the precursor artifact at the foot of the arena's stairs, the Freedom League's camp beside
   it, its small bar top left; the force field at the pass, drawn, and she cannot cross it; 150 s of
   the fight: every unit comes down east of the pass, the Freedom League's around the artifact, the
   Krimzon Guard's far from it, the Krimzon Guard's units turn onto it."
  (dotimes (k 9)
    (set! (-> *smoke-r52* k) 0)
    )
  (set! (-> *bf-config* special) 1)
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin in Spargus")
  (smoke-invulnerable #t)
  (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
  (smoke-wait 4.0)
  (smoke-step "the artifact")
  (let ((art (the-as bf-artifact (handle->process (-> *bf-artifact* proc)))))
    (format 0 "SMOKE artifact ~A at ~M ~M ~M~%" art (-> *bf* points 2 pos x) (-> *bf* points 2 pos y) (-> *bf* points 2 pos z))
    (format 0 "SMOKE camps ~M ~M ~M and ~M ~M ~M~%" (-> *bf* points 0 pos x) (-> *bf* points 0 pos y) (-> *bf* points 0 pos z)
            (-> *bf* points 1 pos x) (-> *bf* points 1 pos y) (-> *bf* points 1 pos z)
            )
    (format 0 "SMOKE player at ~M ~M ~M~%" (-> *target* control trans x) (-> *target* control trans y) (-> *target* control trans z))
    (smoke-check "the precursor artifact stands at the foot of the stairs"
                 (and art (< (vector-vector-xz-distance (-> *bf* points 2 pos) *bf-artifact-near*) (meters 1)))
                 )
    (smoke-check "both camps and the player east of the pass"
                 (and (< (meters 2000) (-> *bf* points 0 pos x)) (< (meters 2000) (-> *bf* points 1 pos x))
                      (< (meters 2000) (-> *target* control trans x))
                      )
                 )
    (when art
      ;; from the south, 18 m off, facing it and the stairs behind it
      (let ((at (vector-copy! (new 'stack-no-clear 'vector) *bf-artifact-near*)))
        (+! (-> at z) (meters 18))
        (move-to-point! (-> *target* control) at)
        (set! (-> *bf* view-yaw) (atan (- (-> *bf-artifact-near* x) (-> at x)) (- (-> *bf-artifact-near* z) (-> at z))))
        )
      (smoke-wait 2.0)
      (smoke-shot "r57-artifact")
      (let ((at (vector-copy! (new 'stack-no-clear 'vector) *bf-artifact-near*)))
        (+! (-> at z) (meters 40))
        (move-to-point! (-> *target* control) at)
        )
      (smoke-wait 2.0)
      (smoke-shot "r57-stairs")
      )
    )
  (smoke-step "the force field")
  (let ((at (set-vector! (new 'stack-no-clear 'vector) (meters 1990.0) (meters 37.5) (meters -345.0) 1.0)))
    (move-to-point! (-> *target* control) at)
    (set! (-> *bf* view-yaw) 0.0)
    (smoke-wait 2.5)
    (smoke-shot "r57-field")
    (smoke-stick 128 0 128 128)
    (smoke-wait 3.0)
    (let ((av (smoke-av)))
      (format 0 "SMOKE at the field: Ashelin at ~M ~M ~M, Jak at z ~M~%" (-> av root trans x) (-> av root trans y) (-> av root trans z)
              (-> *target* control trans z)
              )
      (smoke-shot "r57-field-push")
      (smoke-check "she cannot cross the force field (z under -316 m)" (< (-> av root trans z) (meters -316.5)))
      )
    (smoke-neutral)
    )
  (smoke-step "the fight, 150 s")
  (let ((ff-near 0)
        (ff-all 0)
        (kg-far 0)
        (kg-all 0)
        (west 0)
        (most-pulled 0)
        )
    (dotimes (s 600)
      (smoke-wait 0.25)
      (let ((log *bf-sky-log*))
        (while (< (-> *smoke-r52* 6) (-> log count))
          (let* ((n (mod (-> *smoke-r52* 6) BF_SKY_LOG))
                 (g (-> log ground n))
                 (p (handle->process (-> log unit n)))
                 (team (if p (bf-unit-team p) -1))
                 (d (vector-vector-xz-distance g *bf-artifact-near*))
                 )
            (if (< (-> g x) (meters 2000)) (+! west 1))
            (when (= team BF_TEAM_FF)
              (+! ff-all 1)
              (if (< d (meters 91)) (+! ff-near 1))
              )
            (when (= team BF_TEAM_KG)
              (+! kg-all 1)
              (if (< (meters 169) d) (+! kg-far 1))
              )
            )
          (+! (-> *smoke-r52* 6) 1)
          )
        )
      (when (handle->process (-> *bf-artifact* proc))
        (set! most-pulled (max most-pulled (bf-city-foes-of (handle->process (-> *bf-artifact* proc)))))
        )
      (when (zero? (mod s 120))
        (format 0 "SMOKE ~Ds: artifact hp ~f, west ~D, most on it ~D" (/ s 4) (-> *bf-artifact* hp) west most-pulled)
        (format 0 ", drops FF ~D (~D near) KG ~D (~D far)~%" ff-all ff-near kg-all kg-far)
        )
      (if (= s 400)
          (smoke-shot "r57-fight")
          )
      )
    (smoke-check "both sides' units come down" (and (< 10 ff-all) (< 10 kg-all)))
    (smoke-check "no unit comes down west of the pass" (zero? west))
    (smoke-check "the Freedom League's come down around the artifact" (= ff-near ff-all))
    (smoke-check "the Krimzon Guard's come down far from it" (= kg-far kg-all))
    (smoke-check "the Krimzon Guard's units turn onto the artifact" (> most-pulled 0))
    (smoke-check "no early end (the battle still on)" (= (-> *bf* phase) BF_PHASE_FIGHT))
    )
  )

;; Round 58: Ashelin's rhythm (moves cut short, her landings, her throw on the run, a faster run),
;; the death screen's X for her, and Spargus's attackers, minimap and mode line
(defun smoke-r58-speed ()
  "Ashelin's speed across now, meters a second."
  (let ((av (smoke-av)))
    (if av
        (/ (vector-xz-length (-> (the-as collide-shape-moving (-> av root)) transv)) (meters 1))
        -1.0
        )
    )
  )

(defun smoke-r58-anim ()
  "Ashelin's clip now, -1 none."
  (let ((av (the-as bf-avatar (smoke-av))))
    (if av (-> av anim) -1)
    )
  )

(defbehavior smoke-r58-cut process ((tag string) (b pad-buttons) (after float))
  "Move B pressed, the stick pushed AFTER seconds into it: Ashelin's move cut short, she runs. A
   check that she is running 0.4 s later (over 4 m/s, her move ended)."
  (smoke-r56-rec tag)
  (smoke-tap b 3)
  (smoke-wait after)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.4)
  (let ((av (the-as bf-avatar (smoke-av))))
    (format 0 "SMOKE ~S cut at ~f s: speed ~f m/s, clip ~D, busy ~A~%" tag after (smoke-r58-speed) (-> av anim)
            (< (current-time) (-> av melee-until))
            )
    (smoke-check "the stick cuts her move short: she runs (over 4 m/s)"
                 (and (< 4.0 (smoke-r58-speed)) (>= (current-time) (-> av melee-until)))
                 )
    )
  (smoke-r56-end)
  (smoke-wait 0.4)
  0
  )

(defbehavior smoke-s144 process ()
  "Scenario 144 (`smoke-scenario-late`), round 58, the Freedom League player as Ashelin in Jak 2's
   city, special characters on: her run 1.5 times as fast; her grenade thrown on the run, her legs
   running on; her kick, pistol whip and side flip cut short by the stick; her landing out of a jump
   and out of her far flip; then killed, X on the death screen brings her back."
  (set! (-> *bf-config* special) 1)
  (set! *smoke-r56-home?* #f)
  (smoke-battle-start BF_ZONE_JAK2 BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r56-rec "01-run")
  (smoke-stick 128 0 128 128)
  (smoke-wait 1.5)
  (format 0 "SMOKE run: ~f m/s, clip ~D~%" (smoke-r58-speed) (smoke-r58-anim))
  (smoke-check "she runs at 13 to 14 m/s, her run clip"
               (and (< 13.0 (smoke-r58-speed)) (< (smoke-r58-speed) 14.0) (= (smoke-r58-anim) BF_ASHELIN_CLIP_RUN))
               )
  (smoke-r56-end)
  ;; her grenade on the run
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.5)
  (smoke-r56-rec "02-run-throw")
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (let ((rockets (-> *bf* rockets)))
    (smoke-tap (pad-buttons l2) 3)
    (smoke-wait 0.3)
    (let ((av (the-as bf-avatar (smoke-av))))
      (format 0 "SMOKE run throw: lob-at ~A, clip ~D, speed ~f~%" (nonzero? (-> av lob-at)) (-> av anim) (smoke-r58-speed))
      (smoke-check "her throw on her arms, her legs running on"
                   (and (nonzero? (-> av lob-at)) (= (-> av anim) BF_ASHELIN_CLIP_RUN) (< 10.0 (smoke-r58-speed)))
                   )
      )
    (smoke-wait 1.0)
    (format 0 "SMOKE run throw: grenades ~D (were ~D), speed ~f~%" (-> *bf* rockets) rockets (smoke-r58-speed))
    (smoke-check "the grenade leaves her hand on the run" (= (-> *bf* rockets) (+ rockets -1)))
    (smoke-check "she ran through it (over 10 m/s)" (< 10.0 (smoke-r58-speed)))
    )
  (smoke-r56-end)
  (smoke-wait 0.6)
  ;; her moves cut short
  (smoke-r58-cut "03-kick-cut" (pad-buttons circle) 0.9)
  (smoke-r58-cut "04-butt-cut" (pad-buttons square) 0.75)
  (smoke-r56-rec "05-flip-cut")
  (smoke-stick 0 128 128 128)
  (smoke-hold (pad-buttons r2))
  (smoke-wait 0.15)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-stick 128 128 128 128)
  (smoke-wait 0.8)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.4)
  (format 0 "SMOKE side flip cut: speed ~f, clip ~D~%" (smoke-r58-speed) (smoke-r58-anim))
  (smoke-check "the stick ends her side flip once she landed: she runs" (< 4.0 (smoke-r58-speed)))
  (smoke-r56-end)
  (smoke-wait 0.4)
  ;; her landings
  (smoke-r56-rec "06-land")
  (smoke-tap (pad-buttons x) 3)
  (let ((seen 0))
    (dotimes (k 40)
      (smoke-wait 0.05)
      (if (= (smoke-r58-anim) BF_ASHELIN_CLIP_LAND)
          (+! seen 1)
          )
      )
    (format 0 "SMOKE jump landing: clip seen ~D looks of 40~%" seen)
    (smoke-check "her landing out of a jump plays" (< 0 seen))
    )
  (smoke-wait 0.5)
  (smoke-r56-end)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.3)
  (smoke-r56-rec "07-flip-land")
  (smoke-tap (pad-buttons l1) 4)
  (smoke-wait 0.15)
  (smoke-tap (pad-buttons x) 3)
  (smoke-wait 0.2)
  (smoke-neutral)
  (let ((seen 0))
    (dotimes (k 30)
      (smoke-wait 0.05)
      (if (= (smoke-r58-anim) BF_ASHELIN_CLIP_FLIP_LAND)
          (+! seen 1)
          )
      )
    (format 0 "SMOKE far flip landing: clip seen ~D looks of 30~%" seen)
    (smoke-check "her landing out of her far flip plays" (< 0 seen))
    )
  (smoke-wait 0.5)
  (smoke-r56-end)
  ;; killed: X brings her back
  (smoke-step "her death, then X")
  (smoke-neutral)
  (smoke-kill-player)
  (smoke-wait 4.0)
  (smoke-check "dead, the death screen waits" (nonzero? (-> *bf* respawn-time)))
  (smoke-shot "r58-death")
  (smoke-tap (pad-buttons x) 4)
  (smoke-wait-for 12.0 (lambda () (and (zero? (-> *bf* respawn-time)) (bf-avatar-alive?))))
  (smoke-wait 1.0)
  (format 0 "SMOKE after X: respawn pending ~A, avatar ~A, class ~D~%" (nonzero? (-> *bf* respawn-time)) (bf-avatar-alive?) (-> *bf* class))
  (smoke-check "X on the death screen brings Ashelin back"
               (and (zero? (-> *bf* respawn-time)) (bf-avatar-alive?) (= (-> *bf* class) BF_CLASS_ASHELIN))
               )
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-r58-cut "08-run-after-respawn" (pad-buttons square) 0.75)
  )

(define *smoke-r58-kg* 0)

(defun smoke-r58-kg-units ()
  "The Krimzon Guard's units alive now (crimson guards, jetpack guards, robotguards, spiders), counted
   in `*smoke-r58-kg*` (a lambda reads no local of its function)."
  (set! *smoke-r58-kg* 0)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (let ((sym (-> p type symbol)))
        (when (and (or (= sym 'crimson-guard) (= sym 'flying-turret) (= sym 'roboguard-city) (= sym 'spydroid))
                   (= (bf-unit-team p) BF_TEAM_KG)
                   (not (logtest? (-> (the-as process-focusable p) focus-status) (focus-status dead)))
                   )
          (+! *smoke-r58-kg* 1)
          )
        )
      #t
      )
    *null-kernel-context*
    )
  *smoke-r58-kg*
  )

(defbehavior smoke-s145 process ()
  "Scenario 145 (`smoke-scenario-late`), round 58, a battle in Spargus as Ashelin of the Freedom
   League: the minimap marks the artifact alone; the Krimzon Guard's units all on the artifact over
   90 s; Baron Praxis comes with 300 points; the war zone page's mode line."
  (set! (-> *bf-config* special) 1)
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin in Spargus")
  (smoke-invulnerable #t)
  (smoke-wait 4.0)
  (format 0 "SMOKE minimap marks: camps ~A ~A, artifact ~A~%" (-> *bf* points 0 icon) (-> *bf* points 1 icon) (-> *bf* points 2 icon))
  (smoke-check "the minimap marks the artifact alone, no camp"
               (and (not (-> *bf* points 0 icon)) (not (-> *bf* points 1 icon)) (-> *bf* points 2 icon))
               )
  (smoke-shot "r58-minimap")
  (smoke-step "the attackers, 90 s")
  (let ((best 0.0)
        (looks 0)
        (sum 0.0)
        )
    (dotimes (s 90)
      (smoke-wait 1.0)
      (let ((art (handle->process (-> *bf-artifact* proc)))
            (kg (smoke-r58-kg-units))
            )
        (if (zero? (mod s 15))
            (format 0 "SMOKE look ~Ds: artifact ~A, Krimzon Guard units ~D, on it ~D, Baron ~A health ~f~%" s art kg
                    (if art (bf-city-foes-of art) -1) (handle->process (-> *bf-boss-ref* champ BF_TEAM_KG)) (-> *bf-boss-hps* BF_TEAM_KG)
                    )
            )
        (when (and art (< 10 kg))
          (let ((share (/ (the float (bf-city-foes-of art)) (the float kg))))
            (when (< 30 s)
              (+! sum share)
              (+! looks 1)
              )
            (set! best (fmax best share))
            (if (zero? (mod s 15))
                (format 0 "SMOKE ~Ds: ~D on the artifact of ~D Krimzon Guard units, artifact hp ~f~%" s (bf-city-foes-of art) kg (-> *bf-artifact* hp))
                )
            )
          )
        )
      )
    (format 0 "SMOKE attackers on the artifact: mean share ~f after 30 s, best ~f~%" (if (> looks 0) (/ sum (the float looks)) 0.0) best)
    (smoke-check "most Krimzon Guard units have the artifact as their foe (mean over 60 %)"
                 (and (> looks 0) (< 0.6 (/ sum (the float looks))))
                 )
    )
  (smoke-shot "r58-fight")
  (smoke-step "Baron Praxis")
  (format 0 "SMOKE Baron before: ~A, health ~f, done ~D, losses ~D of ~D~%" (handle->process (-> *bf-boss-ref* champ BF_TEAM_KG))
          (-> *bf-boss-hps* BF_TEAM_KG) (-> *bf-boss-done* BF_TEAM_KG) (-> *bf* losses BF_TEAM_KG) (bf-boss-need)
          )
  (smoke-check "Baron Praxis's full health is 300 points" (= (bf-boss-hp-max BF_TEAM_KG) 300.0))
  (smoke-step "the war zone page's mode line")
  (smoke-start-page 'main)
  (smoke-wait-for 8.0 (lambda () (smoke-page-up? BF_PAGE_PAUSE)))
  (smoke-wait 0.5)
  (set! (-> (smoke-dir) page) BF_PAGE_ZONE)
  (set! (-> (smoke-dir) cursor) 1)
  (smoke-wait 0.6)
  (smoke-shot "r58-zone-spargus")
  (set! (-> (smoke-dir) cursor) 0)
  (smoke-wait 0.6)
  (smoke-shot "r58-zone-jak2")
  (set! (-> (smoke-dir) page) BF_PAGE_PAUSE)
  (set! (-> (smoke-dir) cursor) 0)
  (smoke-wait 0.6)
  )

;; Round 59: Spargus's battle reworked (the artifact by the force field, no ship, 30 units a side at
;; once and 500 in all, the champion sooner, the Krimzon Guard fighting the blue units near them, the
;; result page after the artifact's explosion)
(defun smoke-r59-awake ((team int))
  "Units of side TEAM awake now, every kind."
  (+ (smoke-awake-of team 0) (smoke-awake-of team 1) (smoke-awake-of team 2) (smoke-awake-of team 3))
  )

(define *smoke-r59-far* 0)

(defun smoke-r59-ff-far ()
  "Freedom League units awake (not in the traffic's `inactive` state, its sleeping pool) farther
   than 60 m from the artifact now (`*smoke-r59-far*`: a lambda reads no local)."
  (set! *smoke-r59-far* 0)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (let ((sym (-> p type symbol)))
        (when (and (or (= sym 'crimson-guard) (= sym 'flying-turret) (= sym 'roboguard-city) (= sym 'spydroid))
                   (= (bf-unit-team p) BF_TEAM_FF)
                   (not (logtest? (-> (the-as process-focusable p) focus-status) (focus-status dead)))
                   (-> p next-state) (!= (-> p next-state name) 'inactive)
                   (< (meters 60) (vector-vector-xz-distance (-> (the-as process-drawable p) root trans) *bf-artifact-near*))
                   )
          (+! *smoke-r59-far* 1)
          )
        )
      #t
      )
    *null-kernel-context*
    )
  *smoke-r59-far*
  )

(defbehavior smoke-s146 process ()
  "Scenario 146 (`smoke-scenario-late`), round 59, a battle in Spargus as Ashelin of the Freedom
   League: 30 units a side at once and 500 in all; no ship over the camps; the artifact by the force
   field, the Freedom League's camp by it; 120 s of fight: the drops (the Freedom League's within 90
   m of the artifact, the Krimzon Guard's farther than 170 m, none west of the field), each side at
   most 30 awake, the Krimzon Guard's units on the artifact and on the blue units, the blue units out
   hunting; the champion's losses; three Krimzon Guard guards killed at their cap: the next one 5 s
   later; the artifact destroyed: its explosion, then the result page."
  (dotimes (k 9)
    (set! (-> *smoke-r52* k) 0)
    )
  (set! (-> *bf-config* special) 1)
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin in Spargus")
  (smoke-invulnerable #t)
  (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
  (smoke-wait 6.0)
  (format 0 "SMOKE armies: reserve ~D, champion after ~D losses, caps ~D ~D ~D ~D" (-> *bf* reserve-max) (bf-boss-need)
          (-> *bf-team-caps* 0) (-> *bf-team-caps* 1) (-> *bf-team-caps* 2) (-> *bf-team-caps* 3)
          )
  (format 0 " | ~D ~D ~D ~D~%" (-> *bf-team-caps* 4) (-> *bf-team-caps* 5) (-> *bf-team-caps* 6) (-> *bf-team-caps* 7))
  (smoke-check "500 units a side in all" (= (-> *bf* reserve-max) 500))
  (smoke-check "30 units a side at once"
               (and (= 30 (+ (-> *bf-team-caps* 0) (-> *bf-team-caps* 1) (-> *bf-team-caps* 2) (-> *bf-team-caps* 3)))
                    (= 30 (+ (-> *bf-team-caps* 4) (-> *bf-team-caps* 5) (-> *bf-team-caps* 6) (-> *bf-team-caps* 7)))
                    )
               )
  (smoke-check "the champion comes after 10 % of the units (50)" (= (bf-boss-need) 50))
  (format 0 "SMOKE ships: ~A ~A; artifact at ~M ~M ~M~%" (handle->process (-> *bf* points 0 ship)) (handle->process (-> *bf* points 1 ship))
          (-> *bf* points 2 pos x) (-> *bf* points 2 pos y) (-> *bf* points 2 pos z)
          )
  (format 0 "SMOKE camps at ~M ~M ~M and ~M ~M ~M~%" (-> *bf* points 0 pos x) (-> *bf* points 0 pos y) (-> *bf* points 0 pos z)
          (-> *bf* points 1 pos x) (-> *bf* points 1 pos y) (-> *bf* points 1 pos z)
          )
  (smoke-check "no ship over the camps"
               (and (not (handle->process (-> *bf* points 0 ship))) (not (handle->process (-> *bf* points 1 ship))))
               )
  (smoke-check "the artifact by the force field (within 1 m of its place, 30 m of the field)"
               (and (handle->process (-> *bf-artifact* proc))
                    (< (vector-vector-xz-distance (-> *bf* points 2 pos) *bf-artifact-near*) (meters 1))
                    (< (fabs (- (-> *bf-artifact-near* z) (meters -316))) (meters 30))
                    )
               )
  (smoke-check "the Freedom League's camp within 40 m of it"
               (< (vector-vector-xz-distance (-> *bf* points 0 pos) *bf-artifact-near*) (meters 40))
               )
  (smoke-step "the artifact and the field")
  (let ((at (vector-copy! (new 'stack-no-clear 'vector) *bf-artifact-near*)))
    (+! (-> at z) (meters -22))
    (+! (-> at x) (meters 6))
    (move-to-point! (-> *target* control) at)
    (set! (-> *bf* view-yaw) (atan (- (-> *bf-artifact-near* x) (-> at x)) (- (-> *bf-artifact-near* z) (-> at z))))
    )
  (smoke-wait 2.5)
  (smoke-shot "r59-artifact")
  (let ((at (set-vector! (new 'stack-no-clear 'vector) (meters 2030.0) (meters 34.0) (meters -360.0) 1.0)))
    (move-to-point! (-> *target* control) at)
    (set! (-> *bf* view-yaw) (atan (- (-> *bf-artifact-near* x) (-> at x)) (- (-> *bf-artifact-near* z) (-> at z))))
    )
  (smoke-wait 2.5)
  (smoke-shot "r59-artifact-far")
  (smoke-step "the fight, 120 s")
  (let ((ff-near 0)
        (ff-all 0)
        (kg-far 0)
        (kg-all 0)
        (west 0)
        (most-ff 0)
        (most-kg 0)
        (looks 0)
        (sum 0.0)
        (most-out 0)
        (out-sum 0)
        )
    (dotimes (s 240)
      (smoke-wait 0.5)
      (let ((log *bf-sky-log*))
        (while (< (-> *smoke-r52* 6) (-> log count))
          (let* ((n (mod (-> *smoke-r52* 6) BF_SKY_LOG))
                 (g (-> log ground n))
                 (p (handle->process (-> log unit n)))
                 (team (if p (bf-unit-team p) -1))
                 (d (vector-vector-xz-distance g *bf-artifact-near*))
                 )
            (if (not (or (< (meters 2000) (-> g x)) (and (< (meters 1970) (-> g x)) (< (-> g z) (meters -316)))))
                (+! west 1)
                )
            (when (= team BF_TEAM_FF)
              (+! ff-all 1)
              (if (< d (meters 91)) (+! ff-near 1))
              )
            (when (= team BF_TEAM_KG)
              (+! kg-all 1)
              (if (< (meters 169) d) (+! kg-far 1))
              )
            )
          (+! (-> *smoke-r52* 6) 1)
          )
        )
      (set! most-ff (max most-ff (smoke-r59-awake BF_TEAM_FF)))
      (set! most-kg (max most-kg (smoke-r59-awake BF_TEAM_KG)))
      (when (zero? (mod s 2))
        (let ((art (handle->process (-> *bf-artifact* proc)))
              (kg (smoke-r58-kg-units))
              (out (smoke-r59-ff-far))
              )
          (set! most-out (max most-out out))
          (+! out-sum out)
          (when (and art (< 5 kg) (< 40 s))
            (+! sum (/ (the float (bf-city-foes-of art)) (the float kg)))
            (+! looks 1)
            )
          (if (zero? (mod s 30))
              (begin
                (format 0 "SMOKE ~Ds: awake FF ~D KG ~D, on the artifact ~D of ~D, FF out hunting ~D" (/ s 2)
                        (smoke-r59-awake BF_TEAM_FF) (smoke-r59-awake BF_TEAM_KG) (if art (bf-city-foes-of art) -1) kg out
                        )
                (format 0 ", artifact hp ~f, reserves ~D ~D~%" (-> *bf-artifact* hp) (-> *bf* reserve 0) (-> *bf* reserve 1))
                )
              )
          )
        )
      (if (= s 160)
          (smoke-shot "r59-fight")
          )
      )
    (format 0 "SMOKE drops: FF ~D (~D near), KG ~D (~D far), west ~D" ff-all ff-near kg-all kg-far west)
    (format 0 "; most awake FF ~D KG ~D~%" most-ff most-kg)
    (format 0 "SMOKE Krimzon Guard on the artifact: mean share ~f; FF out hunting: most ~D, mean ~f~%"
            (if (> looks 0) (/ sum (the float looks)) 0.0) most-out (/ (the float out-sum) 120.0)
            )
    (smoke-check "both sides' units come down" (and (< 10 ff-all) (< 10 kg-all)))
    (smoke-check "no unit comes down west of the field" (zero? west))
    (smoke-check "the Freedom League's come down around the artifact" (= ff-near ff-all))
    (smoke-check "the Krimzon Guard's come down far from it" (= kg-far kg-all))
    (smoke-check "each side at most 30 units awake" (and (<= most-ff 30) (<= most-kg 30)))
    (smoke-check "the Krimzon Guard's units go for the artifact and fight too (on it 20 to 95 %)"
                 (and (> looks 0) (< 0.2 (/ sum (the float looks))) (< (/ sum (the float looks)) 0.95))
                 )
    (smoke-check "blue units out hunting, over 60 m from the artifact" (<= 3 most-out))
    )
  (smoke-step "a unit's place waits 5 s")
  (let ((cap (-> *bf-team-caps* 4))
        (before (+ (smoke-awake-of BF_TEAM_KG 0) (bf-fallen-count BF_TEAM_KG 0)))
        (fallen-before (bf-fallen-count BF_TEAM_KG 0))
        (killed (smoke-kill-units BF_TEAM_KG 'crimson-guard 3 #f))
        (t0 (current-time))
        (first -1)
        (fallen0 0)
        )
    (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
    (smoke-wait 0.5)
    (set! fallen0 (bf-fallen-count BF_TEAM_KG 0))
    (dotimes (k 50)
      (smoke-wait 0.1)
      (let ((log *bf-sky-log*))
        (while (< (-> *smoke-r52* 6) (-> log count))
          (let ((p (handle->process (-> log unit (mod (-> *smoke-r52* 6) BF_SKY_LOG)))))
            (if (and (< first 0) p (= (-> p type symbol) 'crimson-guard) (= (bf-unit-team p) BF_TEAM_KG))
                (set! first (the int (- (current-time) t0)))
                )
            )
          (+! (-> *smoke-r52* 6) 1)
          )
        )
      )
    (format 0 "SMOKE killed ~D Krimzon Guard guards, their places ~D of ~D taken before (awake and fallen), next guard down after ~f s~%"
            killed before cap (if (>= first 0) (/ (the float first) 300.0) -1.0)
            )
    (format 0 "SMOKE fallen guards within 5 s: ~D before, ~D 0.5 s after the kill, ~D 5.5 s after~%" fallen-before fallen0 (bf-fallen-count BF_TEAM_KG 0))
    ;; a death counts once its death clip has played (the traffic's set-process-to-killed): the
    ;; killed guards are counted fallen within 5.5 s, and no guard comes down meanwhile
    (smoke-check "the killed guards' places wait: counted fallen, no guard down within 4.5 s"
                 (and (< 0 killed) (<= killed (bf-fallen-count BF_TEAM_KG 0)) (or (< first 0) (<= (seconds 4.5) first)))
                 )
    )
  (smoke-step "the artifact destroyed")
  (let ((art (the-as bf-artifact (handle->process (-> *bf-artifact* proc))))
        (unit (smoke-r54-kg-unit))
        )
    (format 0 "SMOKE artifact ~A, a Krimzon Guard unit ~A~%" art unit)
    (when (and art unit)
      (let ((at (vector-copy! (new 'stack-no-clear 'vector) *bf-artifact-near*)))
        (+! (-> at z) (meters -22))
        (+! (-> at x) (meters 6))
        (move-to-point! (-> *target* control) at)
        (set! (-> *bf* view-yaw) (atan (- (-> *bf-artifact-near* x) (-> at x)) (- (-> *bf-artifact-near* z) (-> at z))))
        )
      (smoke-wait 1.5)
      (set! (-> art hp) 3.0)
      (bf-boss-send-attack art unit 4.0)
      (smoke-wait 0.3)
      (smoke-shot "r59-boom")
      (smoke-wait 0.7)
      (smoke-shot "r59-boom2")
      (smoke-wait 1.0)
      (format 0 "SMOKE 2 s after: winner ~D, phase ~D~%" (-> *bf* winner) (-> *bf* phase))
      (smoke-check "its explosion plays before the result (the battle on 2 s after)"
                   (and (= (-> *bf* phase) BF_PHASE_FIGHT) (= (-> *bf* winner) BF_TEAM_NONE))
                   )
      (smoke-wait 3.0)
      (format 0 "SMOKE 5 s after: winner ~D, phase ~D~%" (-> *bf* winner) (-> *bf* phase))
      (smoke-check "then the Krimzon Guard wins" (and (= (-> *bf* winner) BF_TEAM_KG) (!= (-> *bf* phase) BF_PHASE_FIGHT)))
      (smoke-wait 1.0)
      (smoke-shot "r59-over")
      )
    )
  )

;; Round 60: the red guards' death as the blue ones', the blue drops away from the artifact, the hit
;; reactions of Ashelin and the Baron, Spargus's setup and tickets, Ashelin's punch

(defbehavior smoke-r60-config-check process ()
  "On the battle setup of Spargus: down from row 1 lands on row 4 (no units at once row since round
   61, no victory row since round 60), up back on 1."
  (set! (-> (smoke-dir) cursor) 1)
  (smoke-wait 0.4)
  (smoke-press (pad-buttons down) 0.4)
  (let ((down (-> (smoke-dir) cursor)))
    (smoke-shot "r61-config")
    (smoke-press (pad-buttons up) 0.4)
    (format 0 "SMOKE setup on Spargus: down from 1 to ~D, up back to ~D~%" down (-> (smoke-dir) cursor))
    (smoke-check "Spargus's setup has no units at once nor victory row (the cursor passes over them)"
                 (and (= down 4) (= (-> (smoke-dir) cursor) 1))
                 )
    )
  0
  )

;; the units watched dying: their handle, side, whether they went through the stock `die` state
;; (the standing death), and how long until hidden
(deftype smoke-r60-watch (structure)
  ((unit  handle 12)
   (team  int32 12)
   (die?  symbol 12)
   (dead  int32 12)   ;; the frame it was first seen dead, -1 not yet
   (hide  int32 12)
   (count int32)
   )
  )

(define *smoke-r60-watch* (new 'static 'smoke-r60-watch))

(defun smoke-r60-pick ((team int) (n int))
  "N living guards of side TEAM awake, out of a ship, into `*smoke-r60-watch*`."
  (let ((got 0))
    (dotimes (i (smoke-collect 'crimson-guard 'crimson-guard))
      (let ((proc (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
        (when (and proc (< got n) (= (bf-unit-team proc) team) (< (-> *smoke-r60-watch* count) 12)
                   (not (focus-test? (the-as process-focusable proc) dead inactive disable))
                   (-> proc next-state) (!= (-> proc next-state name) 'inactive) (!= (-> proc next-state name) 'exit-transport)
                   )
          (let ((k (-> *smoke-r60-watch* count)))
            (set! (-> *smoke-r60-watch* unit k) (process->handle proc))
            (set! (-> *smoke-r60-watch* team k) team)
            (set! (-> *smoke-r60-watch* die? k) #f)
            (set! (-> *smoke-r60-watch* hide k) -1)
            (set! (-> *smoke-r60-watch* dead k) -1)
            (+! (-> *smoke-r60-watch* count) 1)
            (+! got 1)
            )
          )
        )
      )
    got
    )
  )

(defun smoke-r60-unit ((team int))
  "A living awake guard of side TEAM, #f for none (an attacker the battle counts as that side's)."
  (dotimes (i (smoke-collect 'crimson-guard 'crimson-guard))
    (let ((proc (the-as process-drawable (handle->process (-> *smoke-handles* i)))))
      (when (and proc (= (bf-unit-team proc) team)
                 (not (focus-test? (the-as process-focusable proc) dead inactive disable))
                 (-> proc next-state) (!= (-> proc next-state name) 'inactive)
                 )
        (return proc)
        )
      )
    )
  (the-as process-drawable #f)
  )

(defbehavior smoke-s148 process ()
  "Scenario 148 (`smoke-scenario-late`), round 60, Spargus as Ashelin of the Freedom League: the
   special characters on by default; the setup without its victory row; no tickets for the Freedom
   League, the Krimzon Guard's from the setup; the Freedom League's drops 40 to 150 m from the
   artifact; three blue and three red guards killed alike: the same death (no standing death after a
   fall for either, `die` state), hidden as fast; Ashelin hit twice in 0.2 s: her hit clip, the
   second hit refused; her punch, her fist growing; Baron Praxis hit twice in 0.2 s: one hurts."
  (format 0 "SMOKE special characters by default: ~D~%" (-> *bf-config* special))
  (smoke-check "the special characters are on by default" (= (-> *bf-config* special) 1))
  (set! *smoke-r60-config?* #t)
  (set! (-> *bf-config* units) 300)
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (set! *smoke-r60-config?* #f)
  (smoke-deploy 4 "deploy Ashelin in Spargus")
  (smoke-invulnerable #t)
  (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
  (smoke-wait 5.0)
  (format 0 "SMOKE tickets: reserves ~D ~D of ~D, FF none ~A, KG none ~A~%" (-> *bf* reserve 0) (-> *bf* reserve 1) (-> *bf* reserve-max)
          (bf-no-tickets? BF_TEAM_FF) (bf-no-tickets? BF_TEAM_KG)
          )
  (smoke-check "no tickets for the Freedom League, the setup's 300 for the Krimzon Guard"
               (and (bf-no-tickets? BF_TEAM_FF) (not (bf-no-tickets? BF_TEAM_KG)) (= (-> *bf* reserve-max) 300))
               )
  (smoke-shot "r60-hud")
  ;; 40 s of drops
  (let ((ff-all 0) (ff-ring 0) (closest 1000000.0) (lost0 (-> *bf* losses BF_TEAM_FF)))
    (dotimes (s 80)
      (smoke-wait 0.5)
      (let ((log *bf-sky-log*))
        (while (< (-> *smoke-r52* 6) (-> log count))
          (let* ((n (mod (-> *smoke-r52* 6) BF_SKY_LOG))
                 (p (handle->process (-> log unit n)))
                 (d (vector-vector-xz-distance (-> log ground n) *bf-artifact-near*))
                 )
            (when (and p (= (bf-unit-team p) BF_TEAM_FF))
              (+! ff-all 1)
              (set! closest (fmin closest d))
              (if (and (< (meters 39) d) (< d (meters 151))) (+! ff-ring 1))
              )
            )
          (+! (-> *smoke-r52* 6) 1)
          )
        )
      )
    (format 0 "SMOKE Freedom League drops: ~D, ~D 40 to 150 m from the artifact, the closest ~M; FF losses ~D, reserve ~D~%"
            ff-all ff-ring closest (- (-> *bf* losses BF_TEAM_FF) lost0) (-> *bf* reserve BF_TEAM_FF)
            )
    (smoke-check "the Freedom League comes down 40 to 150 m from the artifact" (and (< 5 ff-all) (= ff-ring ff-all)))
    (smoke-check "its losses take no ticket" (= (-> *bf* reserve BF_TEAM_FF) (-> *bf* reserve-max)))
    )
  (smoke-shot "r60-fight")
  ;; the deaths, blue and red alike
  (smoke-step "three blue and three red guards killed")
  (set! (-> *smoke-r60-watch* count) 0)
  (smoke-r60-pick BF_TEAM_FF 6)
  (smoke-r60-pick BF_TEAM_KG 6)
  ;; each killed by a unit of the other side (an attack from the player's own side hurts no blue unit)
  (let ((ff (smoke-r60-unit BF_TEAM_FF))
        (kg (smoke-r60-unit BF_TEAM_KG))
        )
    (dotimes (k (-> *smoke-r60-watch* count))
      (let ((p (handle->process (-> *smoke-r60-watch* unit k)))
            (from (if (= (-> *smoke-r60-watch* team k) BF_TEAM_FF) kg ff))
            )
        (if (and p from) (bf-boss-send-attack p from 100.0))
        )
      )
    )
  (dotimes (f 240)
    (suspend)
    (dotimes (k (-> *smoke-r60-watch* count))
      ;; gone: hidden (death-end), put back to sleep by the traffic, or no longer a process
      (let ((p (the-as process-drawable (handle->process (-> *smoke-r60-watch* unit k)))))
        (if (and p (-> p next-state) (= (-> p next-state name) 'die))
            (set! (-> *smoke-r60-watch* die? k) #t)
            )
        (if (and p (< (-> *smoke-r60-watch* dead k) 0) (focus-test? (the-as process-focusable p) dead))
            (set! (-> *smoke-r60-watch* dead k) f)
            )
        (if (and (>= (-> *smoke-r60-watch* dead k) 0) (< (-> *smoke-r60-watch* hide k) 0)
                 (or (not p) (logtest? (-> p draw status) (draw-control-status no-draw))
                     (and (-> p next-state) (= (-> p next-state name) 'inactive))
                     )
                 )
            (set! (-> *smoke-r60-watch* hide k) f)
            )
        )
      )
    )
  (let ((blue-die 0) (red-die 0) (blue-hide 0) (red-hide 0) (blue-n 0) (red-n 0))
    (dotimes (k (-> *smoke-r60-watch* count))
      (format 0 "SMOKE death ~D: side ~D, dead at ~D, standing death ~A, gone at ~D~%" k (-> *smoke-r60-watch* team k)
              (-> *smoke-r60-watch* dead k) (-> *smoke-r60-watch* die? k) (-> *smoke-r60-watch* hide k)
              )
      ;; those seen dead and gone alone: some, landing, took no hit
      (when (and (>= (-> *smoke-r60-watch* dead k) 0) (>= (-> *smoke-r60-watch* hide k) 0))
        (let ((t (- (-> *smoke-r60-watch* hide k) (-> *smoke-r60-watch* dead k))))
          (cond
            ((= (-> *smoke-r60-watch* team k) BF_TEAM_FF)
             (+! blue-n 1)
             (if (-> *smoke-r60-watch* die? k) (+! blue-die 1))
             (+! blue-hide t)
             )
            (else
              (+! red-n 1)
              (if (-> *smoke-r60-watch* die? k) (+! red-die 1))
              (+! red-hide t)
              )
            )
          )
        )
      )
    (format 0 "SMOKE deaths: blue ~D (~D standing, ~D frames from death to gone in all), red ~D (~D standing, ~D frames)~%"
            blue-n blue-die blue-hide red-n red-die red-hide
            )
    (smoke-check "red guards die as the blue ones: no standing death on either side"
                 (and (< 0 blue-n) (< 0 red-n) (zero? blue-die) (zero? red-die))
                 )
    ;; how fast each goes is not measured: a unit is seen dead the frame the traffic puts it to
    ;; sleep (round 60's runs: dead and gone the same frame); its dissolve's 0.25 s is read in the
    ;; stock code (battlefront-h.gc BF_FIZZ_HIDE)
    )
  ;; Ashelin hit
  (smoke-step "Ashelin hit twice")
  (set! *smoke-r56-home?* #f)
  (smoke-invulnerable #f)
  (smoke-r56-rec "01-hit")
  (let ((unit (smoke-r54-kg-unit))
        (hp0 (-> *target* fact health))
        )
    (when unit
      (smoke-hit-from unit *target*)
      (smoke-wait 0.1)
      (let ((hp1 (-> *target* fact health))
            (anim (smoke-r58-anim))
            )
        (smoke-hit-from unit *target*)
        (smoke-wait 0.1)
        (format 0 "SMOKE Ashelin hit: health ~f, ~f after the first, ~f after the second; clip ~D~%" hp0 hp1 (-> *target* fact health) anim)
        (smoke-check "the first hit hurts and plays her hit clip" (and (< hp1 hp0) (= anim BF_ASHELIN_CLIP_HIT)))
        (smoke-check "the second, 0.1 s later, hurts nothing" (= (-> *target* fact health) hp1))
        )
      )
    )
  (smoke-wait 1.0)
  (smoke-r56-end)
  (smoke-invulnerable #t)
  ;; her punch
  (smoke-r56-rec "02-punch")
  (smoke-tap (pad-buttons square) 3)
  (smoke-wait 0.3)
  (format 0 "SMOKE punch: clip ~D~%" (smoke-r58-anim))
  (smoke-check "Square: her punch" (= (smoke-r58-anim) BF_ASHELIN_CLIP_PUNCH))
  (smoke-wait 1.8)
  (smoke-r56-end)
  ;; the Baron hit
  (smoke-step "Baron Praxis hit twice")
  (set! (-> *bf* losses BF_TEAM_KG) (bf-boss-need))
  (smoke-wait-for 15.0 (lambda () (handle->process (-> *bf-boss-ref* champ BF_TEAM_KG))))
  (smoke-wait 1.0)
  ;; a moment out of any hit reaction the units' fire gave him (`bf-avatar-hurt!`)
  (smoke-wait-for 20.0 (lambda () (let ((b (the-as bf-avatar (handle->process (-> *bf-boss-ref* champ BF_TEAM_KG)))))
                                    (and b (< BF_HURT_GAP (- (current-time) (-> b hurt-time))))
                                    )
                         )
                  )
  (let ((boss (the-as bf-boss (handle->process (-> *bf-boss-ref* champ BF_TEAM_KG)))))
    (when boss
      (let ((body (handle->process (-> boss body)))
            (hp0 (-> *bf-boss-hps* BF_TEAM_KG))
            (ff (smoke-r60-unit BF_TEAM_FF))
            )
        (bf-boss-send-attack body ff 4.0)
        (smoke-wait 0.1)
        (let ((hp1 (-> *bf-boss-hps* BF_TEAM_KG))
              (anim (-> boss anim))
              )
          (bf-boss-send-attack body ff 4.0)
          (smoke-wait 0.1)
          (format 0 "SMOKE Baron hit: health ~f, ~f after the first, ~f after the second; clip ~D~%" hp0 hp1 (-> *bf-boss-hps* BF_TEAM_KG) anim)
          (smoke-check "the Baron's first hit hurts and plays his hit clip" (and (< hp1 hp0) (= anim BF_BARON_CLIP_HIT)))
          (smoke-check "his second, 0.1 s later, hurts nothing" (= (-> *bf-boss-hps* BF_TEAM_KG) hp1))
          )
        )
      )
    )
  )

(defbehavior smoke-s140 process ()
  "Scenario 140 (`smoke-scenario-late`), round 54, a battle in Spargus, special characters on, the
   player Ashelin of the Freedom League (her model in Spargus's borrow heaps): the precursor artifact
   stands by the precursor game, the Freedom League's point, no other control point; the Freedom
   League comes down west of the pass, the Krimzon Guard east of it, the player at the west camp;
   180 s watched: no point taken, no early victory, the Krimzon Guard's units turn onto the
   artifact; then its health set low and a Krimzon Guard unit's blow: destroyed, its pieces, the
   Krimzon Guard wins."
  (dotimes (k 9)
    (set! (-> *smoke-r52* k) 0)
    )
  (dotimes (k 3)
    (set! (-> *smoke-r55* k) 0)
    )
  (set! (-> *bf-config* special) 1)
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 4 "deploy Ashelin in Spargus")
  (smoke-invulnerable #t)
  (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
  (smoke-wait 4.0)
  (smoke-step "the artifact")
  (let ((art (the-as bf-artifact (handle->process (-> *bf-artifact* proc)))))
    (format 0 "SMOKE artifact ~A hp ~f points ~D, point 2 owner ~D" art (-> *bf-artifact* hp) (-> *bf* point-count) (-> *bf* points 2 owner))
    (format 0 " at ~M ~M ~M~%" (-> *bf* points 2 pos x) (-> *bf* points 2 pos y) (-> *bf* points 2 pos z))
    (format 0 "SMOKE player at ~M ~M ~M, camps ~M and ~M~%" (-> *target* control trans x) (-> *target* control trans y)
            (-> *target* control trans z) (-> *bf* points 0 pos x) (-> *bf* points 1 pos x)
            )
    (smoke-check "the precursor artifact stands, at full health" (and art (= (-> *bf-artifact* hp) BF_ARTIFACT_HP)))
    (smoke-check "by the precursor game (within 40 m of its door)"
                 (< (vector-vector-xz-distance (-> *bf* points 2 pos) *bf-artifact-near*) (meters 40))
                 )
    (smoke-check "three points: the camps and the artifact's, the Freedom League's"
                 (and (= (-> *bf* point-count) 3) (= (-> *bf* points 2 owner) BF_TEAM_FF))
                 )
    (smoke-check "the Freedom League's camp is the west one, the player there"
                 (and (< (-> *bf* points 0 pos x) (meters 1990)) (< (meters 2110) (-> *bf* points 1 pos x))
                      (< (-> *target* control trans x) (meters 1990))
                      )
                 )
    (when art
      ;; the player beside it, facing it, for its picture
      (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> art root trans))))
        (+! (-> at x) (meters 14))
        (move-to-point! (-> *target* control) at)
        (set! (-> *bf* view-yaw) (atan (- (-> art root trans x) (-> at x)) (- (-> art root trans z) (-> at z))))
        )
      (smoke-wait 2.0)
      (smoke-shot "r54-artifact")
      )
    )
  (smoke-step "the fight, 180 s")
  (let ((pulled 0)
        (most-pulled 0)
        (owner-ok? #t)
        )
    (dotimes (s 720)
      (smoke-wait 0.25)
      (smoke-r52-sample)
      (if (!= (-> *bf* points 2 owner) BF_TEAM_FF)
          (set! owner-ok? #f)
          )
      (if (and (< 120 s) (zero? (mod s 8)))
          (smoke-r55-tally)
          )
      (when (handle->process (-> *bf-artifact* proc))
        (set! pulled (bf-city-foes-of (handle->process (-> *bf-artifact* proc))))
        (set! most-pulled (max most-pulled pulled))
        )
      (when (zero? (mod s 120))
        (format 0 "SMOKE ~Ds: artifact hp ~f hits ~D, foes on it ~D" (/ s 4) (-> *bf-artifact* hp) (-> *bf-artifact* hits) pulled)
        (format 0 ", phase ~D, losses ~D ~D~%" (-> *bf* phase) (-> *bf* losses 0) (-> *bf* losses 1))
        (smoke-r54-front)
        )
      (if (= s 400)
          (smoke-shot "r54-defence")
          )
      )
    (format 0 "SMOKE drops: wascityb ~D, wascitya ~D; Freedom League ~D (~D east), Krimzon Guard ~D (~D west)~%"
            (-> *smoke-r52* 0) (-> *smoke-r52* 1) (-> *smoke-r52* 2) (-> *smoke-r52* 7) (-> *smoke-r52* 3) (-> *smoke-r52* 8)
            )
    (format 0 "SMOKE artifact after 180 s: hp ~f, hits ~D, most units on it ~D~%" (-> *bf-artifact* hp) (-> *bf-artifact* hits) most-pulled)
    (smoke-check "both sides' units come down" (and (< 10 (-> *smoke-r52* 2)) (< 10 (-> *smoke-r52* 3))))
    (smoke-check "each side in its own district (Freedom League west, Krimzon Guard east)"
                 (and (zero? (-> *smoke-r52* 7)) (zero? (-> *smoke-r52* 8)))
                 )
    (smoke-check "no point taken: the artifact's stays the Freedom League's" owner-ok?)
    (smoke-check "no early end (the battle still on)" (= (-> *bf* phase) BF_PHASE_FIGHT))
    (smoke-check "the Krimzon Guard's units turn onto the artifact" (> most-pulled 0))
    ;; round 55: the defenders hunt, they do not wait around the artifact
    (format 0 "SMOKE hunt: Freedom League within 60 m of the artifact ~D of ~D looked at, most east of the pass ~D~%"
            (-> *smoke-r55* 0) (-> *smoke-r55* 1) (-> *smoke-r55* 2)
            )
    (smoke-check "the Freedom League hunts: under a quarter of its units around the artifact"
                 (< (* 4 (-> *smoke-r55* 0)) (-> *smoke-r55* 1))
                 )
    (smoke-check "the Freedom League hunts over the pass" (< 10 (-> *smoke-r55* 2)))
    )
  (smoke-step "its destruction")
  (let ((art (the-as bf-artifact (handle->process (-> *bf-artifact* proc))))
        (unit (smoke-r54-kg-unit))
        )
    (format 0 "SMOKE artifact ~A, a Krimzon Guard unit ~A~%" art unit)
    (when (and art unit)
      (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> art root trans))))
        (+! (-> at x) (meters 16))
        (move-to-point! (-> *target* control) at)
        (set! (-> *bf* view-yaw) (atan (- (-> art root trans x) (-> at x)) (- (-> art root trans z) (-> at z))))
        )
      (smoke-wait 1.0)
      (set! (-> art hp) 3.0)
      (bf-boss-send-attack art unit 4.0)
      (smoke-wait 0.3)
      (smoke-shot "r54-boom")
      (smoke-wait 0.5)
      (smoke-shot "r54-pieces")
      )
    (smoke-wait 2.0)
    (format 0 "SMOKE after the blow: artifact ~A done ~D, winner ~D, phase ~D~%" (handle->process (-> *bf-artifact* proc))
            (-> *bf-artifact* done) (-> *bf* winner) (-> *bf* phase)
            )
    (smoke-check "a Krimzon Guard blow destroys it, the Krimzon Guard wins"
                 (and (= (-> *bf* winner) BF_TEAM_KG) (!= (-> *bf* phase) BF_PHASE_FIGHT))
                 )
    )
  (smoke-wait 3.0)
  (smoke-shot "r54-over")
  (smoke-invulnerable #f)
  ;; the end page's X leaves the battle (START's page is not up over it)
  (smoke-step "leave the battle")
  (smoke-neutral)
  (smoke-tap (pad-buttons x) 4)
  (smoke-wait-for 90.0 (lambda () (smoke-title-up?)))
  (smoke-wait 1.0)
  (smoke-check "X on the end page leaves the battle: the title menu"
               (and (= (-> *bf* phase) BF_PHASE_OFF) (smoke-title-up?))
               )
  (set! (-> *bf-config* special) 0)
  0
  )

;; Round 61 measure: Jak's own punch and spin kick in the game (their travel, length, danger)
(defbehavior smoke-r61-trace process ((tag string) (frames int))
  "Every other frame for FRAMES frames: the seconds since the start, Jak's travel across from where he
   stood, his state, his clip and its frame, his danger mode."
  (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (t0 (smoke-now))
        )
    (dotimes (f frames)
      (let ((jc (-> *target* skel root-channel 0)))
        (if (zero? (logand f 1))
            (begin
              (format 0 "SMOKE ~S ~,,3f s: ~,,2M across, speed ~,,2M, " tag
                      (* 0.0033333334 (the float (- (smoke-now) t0)))
                      (vector-vector-xz-distance (-> *target* control trans) at)
                      (vector-xz-length (-> *target* control transv))
                      )
              (format 0 "~S ~S ~,,1f danger ~A~%" (-> *target* state name)
                      (if (-> jc frame-group) (-> jc frame-group name) "none")
                      (-> jc frame-num)
                      (-> *target* control danger-mode)
                      )
              )
            )
        )
      (suspend)
      )
    )
  0
  )

(defbehavior smoke-s149 process ()
  "Scenario 149 (`smoke-scenario-late`), round 61 measure: Jak (a blue guard, Jak moving himself)
   put in his punch and his spin kick standing, Square held and let go, then his punch running."
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (smoke-deploy 0 "deploy a blue guard")
  (smoke-invulnerable #t)
  (smoke-wait 3.0)
  (smoke-neutral)
  (smoke-hold (pad-buttons square))
  (go-process *target* target-running-attack)
  (smoke-r61-trace "punch-held" 70)
  (smoke-hold (the-as pad-buttons 0))
  (smoke-wait 1.0)
  (go-process *target* target-running-attack)
  (smoke-r61-trace "punch-tap" 50)
  (smoke-wait 1.0)
  (go-process *target* target-attack)
  (smoke-r61-trace "kick" 60)
  (smoke-wait 1.0)
  (smoke-stick 128 0 128 128)
  (smoke-wait 1.5)
  (format 0 "SMOKE run speed ~M~%" (vector-xz-length (-> *target* control transv)))
  (go-process *target* target-running-attack)
  (smoke-r61-trace "punch-run" 50)
  (smoke-neutral)
  )

;; Round 61: Ashelin's punch and kicks as Jak's (his lunge, his hitboxes, his kick's speed), Spargus's
;; units at once fixed, its force field a wall, the artifact at the white eco fountain
(define *smoke-r61-touch* #f)
(define *smoke-r61-wall* (the-as process #f)) ;; a force field's wall (a security-wall-child) ;; `smoke-r61-strike`: the unit's spheres reached the spin kick's

(defun smoke-r61-guard ()
  "An awake crimson guard of the Krimzon Guard, out of a ship, not dead; #f for none."
  (set! (-> *smoke-r54-ref* champ 0) (the-as handle #f))
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (if (and (not (handle->process (-> *smoke-r54-ref* champ 0))) (= (-> p type symbol) 'crimson-guard)
               (= (bf-unit-team p) BF_TEAM_KG) (-> p next-state) (!= (-> p next-state name) 'inactive)
               (!= (-> p next-state name) 'exit-transport) (not (focus-test? (the-as process-focusable p) dead))
               )
          (set! (-> *smoke-r54-ref* champ 0) (process->handle p))
          )
      #f
      )
    *null-kernel-context*
    )
  (handle->process (-> *smoke-r54-ref* champ 0))
  )

(defbehavior smoke-r61-calm process ()
  "Ashelin out of any hit reaction and kept from a new one for 1.5 s (`bf-avatar-hurt!`: in the
   fight, shots kept her in hers, the moves' buttons lost)."
  (set-time! (-> (smoke-av) hurt-time))
  (smoke-wait 0.6)
  (set-time! (-> (smoke-av) hurt-time))
  0
  )

(defun smoke-r61-unit-hp ((unit process))
  "UNIT's hit points (an enemy's), -1 for none."
  (if unit (-> (the-as enemy unit) hit-points) -1.0)
  )

(defbehavior smoke-r61-strike process ((tag string) (b pad-buttons) (before float) (ahead float) (aside float))
  "Ashelin's move B (tapped), and BEFORE seconds into it a Krimzon Guard unit put AHEAD m ahead of her
   and ASIDE m to her right (a crimson guard), its feet at hers; 0.35 s later, the hit points it lost (0: missed), and
   whether one of its collision spheres reaches Jak's spin kick's sphere (`*smoke-r61-touch*`). The
   move ends first."
  (let ((unit (smoke-r61-guard))
        (lost -1.0)
        )
    (when unit
      (let ((hp0 (smoke-r61-unit-hp unit)))
        ;; no hit reaction of hers meanwhile (`smoke-r61-calm`): the unit put against her strikes
        ;; her, and her reaction cut her move short (the first run)
        (smoke-r61-calm)
        (smoke-tap b 3)
        (smoke-wait before)
        (let* ((av (smoke-av))
               (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> av root quat)))
               (at (vector-copy! (new 'stack-no-clear 'vector) (-> av root trans)))
               )
          (set! (-> fwd y) 0.0)
          (vector-normalize! fwd 1.0)
          (+! (-> at x) (+ (* ahead (-> fwd x)) (* aside (- (-> fwd z)))))
          (+! (-> at z) (+ (* ahead (-> fwd z)) (* aside (-> fwd x))))
          (move-to-point! (the-as collide-shape (-> (the-as process-drawable unit) root)) at)
          )
        (smoke-wait 0.05)
        (let ((c (vector-copy! (new 'stack-no-clear 'vector) (-> (smoke-av) root trans))))
          (+! (-> c y) BF_JAK_SPIN_HEIGHT)
          (set! *smoke-r61-touch* (bf-shape-touches? (the-as collide-shape (-> (the-as process-drawable unit) root)) c BF_JAK_SPIN_RADIUS))
          )
        (smoke-wait 0.3)
        (set! lost (- hp0 (smoke-r61-unit-hp unit)))
        (format 0 "SMOKE ~S: a unit ~M ahead, ~M aside: ~f points lost of ~f (clip ~D)~%" tag ahead aside lost hp0 (smoke-r58-anim))
        )
      )
    (smoke-wait 1.0)
    lost
    )
  )

(defbehavior smoke-s150 process ()
  "Scenario 150 (`smoke-scenario-late`), round 61, Spargus as Ashelin of the Freedom League, the setup's
   units at once at 200: the setup without its units at once row; 30 units a side all the same; the
   artifact at the white eco fountain; the Freedom League's drops 40 to 150 m from it, the Krimzon
   Guard's farther; the force field: pushed at and crossed, no harm; Ashelin's kick: its clip faster,
   Jak's spin kick's hitbox (a unit 3.4 m away struck, 4.6 m away not); her punch: Jak's lunge (about
   3 m), free at 0.35 s, Jak's punch's hitbox (a unit 2.2 m aside struck, 4.5 m aside not)."
  (set! (-> *bf-config* at-once) 200)
  (set! *smoke-r60-config?* #t)
  (smoke-battle-start BF_ZONE_SPARGUS BF_TEAM_FF)
  (set! *smoke-r60-config?* #f)
  (smoke-deploy 4 "deploy Ashelin in Spargus")
  (smoke-invulnerable #t)
  (set! (-> *smoke-r52* 6) (-> *bf-sky-log* count))
  (smoke-wait 3.0)
  (let ((ff 0) (kg 0))
    (dotimes (k 4)
      (+! ff (-> *bf-team-caps* k))
      (+! kg (-> *bf-team-caps* (+ k 4)))
      )
    (format 0 "SMOKE caps: Freedom League ~D, Krimzon Guard ~D (setup at once ~D)~%" ff kg (-> *bf-config* at-once))
    (smoke-check "Spargus: 30 units a side at once, whatever the setup" (and (= ff 30) (= kg 30)))
    )
  ;; the artifact
  (let ((art (the-as process-drawable (handle->process (-> *bf-artifact* proc))))
        (vent (set-vector! (new 'stack-no-clear 'vector) (meters 2347.4) (meters 5.6) (meters -93.8) 1.0))
        )
    (when art
      (format 0 "SMOKE artifact at ~M ~M ~M, the point at ~M ~M~%" (-> art root trans x) (-> art root trans y) (-> art root trans z)
              (-> *bf* points BF_ARTIFACT_POINT pos x) (-> *bf* points BF_ARTIFACT_POINT pos z)
              )
      )
    (smoke-check "the artifact stands at the white eco fountain"
                 (and art (< (vector-vector-xz-distance (-> art root trans) vent) (meters 1))
                      (< (vector-vector-xz-distance (-> *bf* points BF_ARTIFACT_POINT pos) vent) (meters 1))
                      )
                 )
    (let ((at (vector-copy! (new 'stack-no-clear 'vector) vent)))
      (+! (-> at z) (meters 30))
      (+! (-> at y) (meters 6))
      (move-to-point! (-> *target* control) at)
      (set! (-> *bf* view-yaw) (atan 0.0 -1.0))
      )
    (smoke-wait 3.0)
    (format 0 "SMOKE by the artifact: Jak at ~M ~M ~M~%" (-> *target* control trans x) (-> *target* control trans y) (-> *target* control trans z))
    (smoke-shot "r61-artifact")
    )
  ;; 30 s of drops
  (let ((ff-all 0) (ff-ring 0) (kg-all 0) (kg-far 0) (ff-close 1000000.0) (kg-close 1000000.0))
    (dotimes (s 60)
      (smoke-wait 0.5)
      (let ((log *bf-sky-log*))
        (while (< (-> *smoke-r52* 6) (-> log count))
          (let* ((n (mod (-> *smoke-r52* 6) BF_SKY_LOG))
                 (p (handle->process (-> log unit n)))
                 (d (vector-vector-xz-distance (-> log ground n) *bf-artifact-near*))
                 )
            (when p
              (cond
                ((= (bf-unit-team p) BF_TEAM_FF)
                 (+! ff-all 1)
                 (set! ff-close (fmin ff-close d))
                 (if (and (< (meters 39) d) (< d (meters 151))) (+! ff-ring 1))
                 )
                (else
                  (+! kg-all 1)
                  (set! kg-close (fmin kg-close d))
                  (if (< (meters 149) d) (+! kg-far 1))
                  )
                )
              )
            )
          (+! (-> *smoke-r52* 6) 1)
          )
        )
      )
    (format 0 "SMOKE drops: Freedom League ~D, ~D 40 to 150 m from the artifact (closest ~M); " ff-all ff-ring ff-close)
    (format 0 "Krimzon Guard ~D, ~D farther than 150 m (closest ~M)~%" kg-all kg-far kg-close)
    (smoke-check "the Freedom League comes down 40 to 150 m from the artifact" (and (< 5 ff-all) (= ff-ring ff-all)))
    (smoke-check "the Krimzon Guard everywhere else, farther than 150 m" (and (< 5 kg-all) (= kg-far kg-all)))
    )
  (smoke-shot "r61-fight")
  ;; the force field
  (smoke-step "the force field")
  (smoke-invulnerable #f)
  (let ((at (set-vector! (new 'stack-no-clear 'vector) (meters 1990.0) (meters 37.5) (meters -330.0) 1.0))
        (hp0 (-> *target* fact health))
        )
    (move-to-point! (-> *target* control) at)
    (set! (-> *bf* view-yaw) 0.0)
    (smoke-wait 2.5)
    (smoke-stick 128 0 128 128)
    (smoke-wait 2.5)
    (smoke-shot "r61-field")
    (smoke-neutral)
    ;; the wall's own shock (ctywide-obs.gc security-wall-method-24, sent when Jak's place crosses its
    ;; plane) sent from it: refused, no health lost at once (the Krimzon Guard's camp is near: its
    ;; fire hurt her in the first run)
    (set! *smoke-r61-wall* (the-as process #f))
    (iterate-process-tree *active-pool*
                          (lambda ((p process)) (if (= (-> p type symbol) 'security-wall-child) (set! *smoke-r61-wall* p)) #t)
                          *null-kernel-context*
                          )
    (let ((h1 (-> *target* fact health))
          (answer (if *smoke-r61-wall*
                      (send-event *target* 'attack-invinc :from *smoke-r61-wall* #f
                                  (static-attack-info :mask (vehicle-impulse-factor)
                                                      ((id (new-attack-id)) (damage 2.0) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0) (mode 'grenade))
                                                      )
                                  )
                      'none
                      )
                  )
          )
      (format 0 "SMOKE the wall's shock: wall ~A, answer ~A, health ~f then ~f~%" *smoke-r61-wall* answer h1 (-> *target* fact health))
      (smoke-check "the force field's shock is taken without harm: no health lost" (and *smoke-r61-wall* (= (-> *target* fact health) h1)))
      )
    (smoke-wait 1.0)
    (let ((av (smoke-av)))
      (format 0 "SMOKE force field: health ~f, ~f now, dead ~A, respawn pending ~A, Ashelin at z ~M~%" hp0 (-> *target* fact health)
              (focus-test? *target* dead) (nonzero? (-> *bf* respawn-time)) (if av (-> av root trans z) 0.0)
              )
      (smoke-check "she cannot cross the force field: held as by a wall (z under -316 m)" (and av (< (-> av root trans z) (meters -316.2))))
      )
    )
  (smoke-invulnerable #t)
  ;; Ashelin's moves, by the artifact
  ;; the battle's last safe place there too: 26 m under the pass's lane, the move looked a fall into a
  ;; hole and put Jak back by the force field (battlefront.gc `bf-keep-in-zone`, the sixth run)
  (let ((at (set-vector! (new 'stack-no-clear 'vector) (meters 2347.4) (meters 9.0) (meters -63.8) 1.0)))
    (vector-copy! (-> *bf* safe) at)
    (move-to-point! (-> *target* control) at)
    )
  (smoke-wait 2.5)
  (format 0 "SMOKE for her moves: Ashelin at ~M ~M ~M~%" (-> (smoke-av) root trans x) (-> (smoke-av) root trans y) (-> (smoke-av) root trans z))
  (set! *smoke-r56-home?* #f)
  (smoke-step "her punch")
  (smoke-r56-rec "01-punch")
  (let* ((av (smoke-av))
         (at (vector-copy! (new 'stack-no-clear 'vector) (-> av root trans)))
         )
    (smoke-r61-calm)
    (vector-copy! at (-> av root trans))
    (smoke-tap (pad-buttons square) 3)
    (smoke-wait 0.2)
    (let ((anim (smoke-r58-anim)))
      (smoke-wait 0.25)
      (let ((lunge (vector-vector-xz-distance (-> av root trans) at)))
        (format 0 "SMOKE punch: clip ~D, ~M ahead after 0.45 s~%" anim lunge)
        (smoke-check "Square: her punch, lunging ahead as Jak's (2.3 to 3.6 m)"
                     (and (= anim BF_ASHELIN_CLIP_PUNCH) (< (meters 2.3) lunge) (< lunge (meters 3.6)))
                     )
        )
      )
    (smoke-stick 128 0 128 128)
    (smoke-wait 0.4)
    (format 0 "SMOKE after the punch, the stick: speed ~f m/s~%" (smoke-r58-speed))
    (smoke-check "free 0.35 s into it, as Jak: she runs" (< 4.0 (smoke-r58-speed)))
    (smoke-neutral)
    )
  (smoke-wait 0.6)
  (smoke-r56-end)
  (smoke-step "her kick")
  (smoke-r56-rec "02-kick")
  (smoke-r61-calm)
  (smoke-tap (pad-buttons circle) 3)
  (smoke-wait 0.15)
  (let ((av (smoke-av)))
    (format 0 "SMOKE kick: clip ~D, busy for ~f s~%" (smoke-r58-anim)
            (* 0.0033333334 (the float (- (-> av melee-until) (-> av melee-time))))
            )
    (smoke-check "Circle: her kick, 0.83 s long (1.34 until round 60)"
                 (and (= (smoke-r58-anim) BF_ASHELIN_CLIP_KICK) (= (- (-> av melee-until) (-> av melee-time)) BF_ASH_KICK_TIME))
                 )
    )
  (smoke-wait 1.0)
  (smoke-r56-end)
  (let ((near (smoke-r61-strike "kick near" (pad-buttons circle) 0.25 (meters 3.4) 0.0)))
    (smoke-check "her kick strikes a unit 3.4 m away (Jak's spin kick's sphere reaches its spheres)" (and (< 0.0 near) *smoke-r61-touch*))
    )
  (smoke-r61-strike "kick far" (pad-buttons circle) 0.25 (meters 7) 0.0)
  (smoke-check "a unit 7 m away is out of Jak's spin kick's sphere" (not *smoke-r61-touch*))
  (let ((near (smoke-r61-strike "punch aside" (pad-buttons square) 0.15 0.0 (meters 2.2))))
    (smoke-check "her punch strikes a unit 2.2 m to her side, as Jak's sphere around his body" (< 0.0 near))
    )
  )

