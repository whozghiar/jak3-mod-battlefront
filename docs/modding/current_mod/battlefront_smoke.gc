        (format 0 "SMOKE report at ~D s~%" (/ (- (smoke-now) t0) 300))
        (dotimes (i (-> *bf* point-count))
          (format 0 "SMOKE owner ~D ~D~%" i (-> *bf* points i owner))
          )
        (bf-city-unit-report)
        )
      (suspend)
      )
    )
  (smoke-check "the diagnosis ran" #t)
  0
  )

(defbehavior smoke-scenario-late process ()
  "Scenarios 36 to 40 (rounds 26 and 27), each in a function of its own, out of `smoke-scenario`:
   with them in it, the register allocator gave up on its size (RegAlloc Error)."
  (case SMOKE_SCENARIO
    ((46) (smoke-s46))
    ((45) (smoke-s45))
    ((44) (smoke-s44))
    ((43) (smoke-s43))
    ((42) (smoke-s42))
    ((41) (smoke-s41))
    ((40) (smoke-s40))
    ((39) (smoke-s39))
    ((38) (smoke-s38))
    ((37) (smoke-s37))
    ((36) (smoke-s36))
    )
  0
  )

(defbehavior smoke-scenario process ()
  (format 0 "SMOKE start scenario ~D~%" SMOKE_SCENARIO)
  (smoke-boot)
  (if (>= SMOKE_SCENARIO 36)
      (smoke-scenario-late)
      )
  (case SMOKE_SCENARIO
    ((1)
     ;; T1: the Mods menu opens with L3 + SELECT, as every mod's; the mode on, START opens the
     ;; battle's pause page, whose Options entry opens the game's menu, its Options page the stock one
     ;; (no Gamemode entry since round 26); switched off, START is the game's
     (format 0 "SMOKE bind ~X (L3 + SELECT is ~X)~%" *mods-menu-bind* (pad-buttons l3 select))
     (smoke-check "the Mods menu bind is L3 + SELECT" (= *mods-menu-bind* (pad-buttons l3 select)))
     (let ((n (-> *options-options-pc* options length)))
       (smoke-mods-toggle "mods-menu-on")
       (smoke-check "Battlefront mode on" *mod-battlefront-enable*)
       (smoke-start-page 'main)
       (smoke-wait-for 5.0 (lambda () (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE))))
       (smoke-shot "start-pause-page")
       (smoke-check "START opens the battle's pause page" (and (smoke-dir) (= (-> (smoke-dir) page) BF_PAGE_PAUSE)))
       (set! (-> (smoke-dir) cursor) 6)
       (smoke-wait 0.5)
       (smoke-press (pad-buttons x) 2.0)
       (smoke-wait-for 5.0 (lambda () (if *progress-process* #t #f)))
       (smoke-wait 1.5)
       (smoke-shot "start-options-ring")
       (smoke-check "its Options entry opens the game's START menu" (if *progress-process* #t #f))
       (smoke-check "the game's Options page is the stock one (no Gamemode)" (= (-> *options-options-pc* options length) n))
       (when *progress-process*
         (set-next-state (-> *progress-process* 0) 'go-away 0)
         )
       (smoke-wait 2.0)
       (smoke-mods-toggle "mods-menu-off")
       (smoke-check "Battlefront mode off" (not *mod-battlefront-enable*))
       (smoke-check "no battle director while the mode is off" (not (bf-active?)))
       )
     )
    ((2)
     ;; T2 to T5, Freedom League at the Port: the page order, the camera, the blue classes played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
