(defbehavior smoke-trl-spider-blast process ((clip string))
  "The spider, charged, set 3 m from the biggest enemy group, blows itself up (L1) seen from 40 m off
   and 15 m up: the fireball, the cloud and the foes around dying. Every game frame recorded (CLIP at
   half speed; every other frame for the normal speed), no HUD. Its last shot: the spider dies."
  (let* ((g (smoke-trl-group-foe (-> *target* control trans) (meters 150)))
         (gp (the-as process-drawable (handle->process g)))
         )
    (when gp
      (let ((at (vector-copy! (new 'stack-no-clear 'vector) (-> gp root trans))))
        (+! (-> at y) (meters 2))
        (move-to-point! (-> *target* control) at)
        )
      (smoke-wait 0.5)
      (smoke-neutral)
      (set! (-> *smoke-cine* nohud?) #t)
      (smoke-trl-cam-wide-jak (meters 40) (meters 15))
      (format 0 "SMOKE trailer nova charge ~f~%" (if (smoke-av) (bf-nova-charge (smoke-av)) -1.0))
      (smoke-wait 0.3)
      (smoke-hd-start clip 1)
      (smoke-wait 0.5)
      (smoke-hold (pad-buttons l1))
      (smoke-wait 0.3)
      (smoke-hold (the-as pad-buttons 0))
      (smoke-wait 6.0)
      (smoke-hd-stop)
      (smoke-cine-off)
      )
    )
  0
  )

(defbehavior smoke-trl-v3-pov process ((class int) (clip string) (dist float))
  "A point-of-view take of CLASS where units of both sides die (`smoke-trl-wait-deaths`), DIST from
   the enemy nearest Jak (`smoke-trl-pov`: HUD on, fire only while the aim is on an enemy)."
  (let ((at (new 'stack-no-clear 'vector)))
    (when (> (smoke-trl-wait-deaths at 4 30.0) 0)
      (+! (-> at y) (meters 2))
      (move-to-point! (-> *target* control) at)
      (smoke-wait 0.4)
      )
    )
  (smoke-trl-close dist)
  (smoke-trl-pov class clip)
  0
  )

(defbehavior smoke-s99 process ()
  "Scenario 99 (`smoke-scenario-late`), trailer v3: the Krimzon Guard's drops seen from an open spot
   (a red guard, a robotguard, a spider, a red jetpack leaving the ship); then fronts where the
   armies meet and fight (`smoke-trl-front2`): the Central Quarter against the East Market, battle
   clips where units of both sides die (the fight criterion logged); the red guard's abilities and two
   point-of-view takes there. No check of its own."
  (smoke-trl-v2-start BF_TEAM_KG 0 "deploy red guard")
  (smoke-trl-park-at 6)
  (smoke-wait 1.0)
  (smoke-trl-drop-spots BF_TEAM_KG)
  (smoke-trl-drop3 BF_TEAM_KG 'red-guard "drop-kg-guard" 5.0 40.0)
  (smoke-trl-drop3 BF_TEAM_KG 'roboguard-city "drop-kg-robot" 5.0 50.0)
  (smoke-trl-drop3 BF_TEAM_KG 'spydroid "drop-kg-spider" 5.0 50.0)
  (smoke-trl-drop3 BF_TEAM_KG 'red-jet "drop-kg-jetpack" 5.0 50.0)
