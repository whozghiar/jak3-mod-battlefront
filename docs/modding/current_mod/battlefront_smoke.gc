(defun smoke-trl-front3 ((p int) (a int) (b int))
  "A front at control point P, neutral: every unit of both sides is sent there; the Freedom League
   holds A and the Krimzon Guard B, two points about as far from P, so both sides' reinforcements
   come down near it at the same rate; every other control point neutral, every capture reset
   (called again before each clip, so neither side holds P)."
  (smoke-goal-force! -1)
  (set! (-> *smoke-goal-side* 0) p)
  (set! (-> *smoke-goal-side* 1) p)
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (when (not (-> pt base?))
        (set! (-> pt owner) (cond
                              ((= i a) BF_TEAM_FF)
                              ((= i b) BF_TEAM_KG)
                              (else BF_TEAM_NONE)
                              )
              )
        (set! (-> pt prog-team) BF_TEAM_NONE)
        (set! (-> pt progress) 0.0)
        )
      )
    )
  (format 0 "SMOKE trailer front at ~D (Freedom League from ~D, Krimzon Guard from ~D)~%" p a b)
  0
  )

(defbehavior smoke-trl-battles process ((p int) (a int) (b int) (n0 int) (count int))
  "COUNT battle clips at the front at P (`smoke-trl-front3`, staged again before each), numbered
   from N0, orbits and pushes in turn."
  (dotimes (k count)
    (smoke-trl-front3 p a b)
    (smoke-trl-battle #f (+ n0 k) (= (logand k 1) 1) 8 40.0)
    )
  0
  )

