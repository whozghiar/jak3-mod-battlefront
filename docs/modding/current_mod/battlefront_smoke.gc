  0
  )

;; ----------------------------------------------------------------------------
;; Jetpack hover: what the model does when the player lets go of everything
;; ----------------------------------------------------------------------------

(defbehavior smoke-hover-watch process ((tag string) (secs float))
  "For SECS, nothing pressed: count the model's clip changes, the frames Jak's on-surface flag
   changes, and the model's and Jak's height range, then print them; record it as a GIF (TAG)."
  (smoke-neutral)
  (smoke-rec-start tag 2)
  (let ((t0 (smoke-now))
        (av (smoke-av))
        (clips 0)
        (flips 0)
        (last-anim -2)
        (last-ground? #f)
        (lo 1000000000.0)
        (hi -1000000000.0)
        (jlo 1000000000.0)
        (jhi -1000000000.0)
        (frames 0)
        (last-frame -1.0)
        (advance 0.0)
        )
    (when av
      (set! last-anim (-> av anim))
      (set! last-ground? (logtest? (-> *target* control status) (collide-status on-surface)))
      (format 0 "SMOKE ~S start: clip ~D speed ~f frames ~D," tag (-> av anim)
              (-> av skel root-channel 0 frame-group speed) (-> av skel root-channel 0 frame-group frames num-frames))
      (format 0 " Jak ~M above his ground, state ~A, fuel ~f~%"
              (- (-> *target* control trans y) (-> *target* control gspot-pos y)) (-> *target* state name) (-> av fuel))
      )
    (while (and (smoke-av) (< (- (smoke-now) t0) (the int (* secs 300.0))))
      (let ((av (smoke-av)))
        (when (!= (-> av anim) last-anim)
          (+! clips 1)
          (set! last-anim (-> av anim))
          )
        ;; how far the clip moves each game frame (a loop wraps back by its length minus one)
        (let ((f (-> av skel root-channel 0 frame-num))
              (n (the float (+ (-> av skel root-channel 0 frame-group frames num-frames) -1)))
              )
          (when (<= 0.0 last-frame)
            (let ((d (- f last-frame)))
              (if (< d (* -0.5 n))
                  (+! d n)
                  )
              (+! advance (fabs d))
              )
            )
          (set! last-frame f)
          )
        (let ((g? (logtest? (-> *target* control status) (collide-status on-surface))))
          (when (!= g? last-ground?)
            (+! flips 1)
            (set! last-ground? g?)
            )
          )
        (set! lo (fmin lo (-> av root trans y)))
        (set! hi (fmax hi (-> av root trans y)))
        (set! jlo (fmin jlo (-> *target* control trans y)))
        (set! jhi (fmax jhi (-> *target* control trans y)))
        (+! frames 1)
        )
      (suspend)
      )
    (smoke-rec-stop)
    (format 0 "SMOKE hover ~S: ~D frames, ~D clip changes (now ~D), ~D on-surface flips," tag frames clips last-anim flips)
    (format 0 " model y range ~M, Jak y range ~M, state ~A, clip frames per game frame ~f~%" (- hi lo) (- jhi jlo)
            (if *target* (-> *target* state name) 'none) (/ advance (the float (max 1 frames))))
    ;; the Jak 2 rip's frames, 15 a second: a quarter of a clip frame each game frame
    (let ((pace (/ advance (the float (max 1 frames)))))
      (smoke-check "the jetpack's clip plays at the rip's pace (15 frames a second)" (and (< 0.2 pace) (< pace 0.3)))
      )
    clips
    )
  )

;; The model's joints against its root, the frame before (`smoke-pose-watch`).
(define *smoke-joints* (new 'global 'inline-array 'vector 64))

(defun smoke-pose-step ((av bf-avatar) (first? symbol))
  "How far, in meters, the model's joints moved against its root since the last call, summed over
   its joints (0 on the FIRST? call); the joints kept for the next call."
  (let ((sum 0.0)
        (p (new 'stack-no-clear 'vector))
        )
    (dotimes (i (min 64 (-> av node-list length)))
      (vector<-cspace! p (-> av node-list data i))
      (vector-! p p (-> av root trans))
      (if (not first?)
          (+! sum (vector-vector-distance p (-> *smoke-joints* i)))
          )
      (vector-copy! (-> *smoke-joints* i) p)
      )
    sum
    )
  )

(defbehavior smoke-pose-watch process ((tag string) (secs float) (old-pace? symbol))
  "For SECS, nothing pressed: the mean motion of the model's joints against its root each game
   frame, in centimeters, recorded as a GIF (TAG). OLD-PACE? plays the clip at the build's own speed,
   a clip frame each game frame, as before the fix: each frame this adds 0.75 to the frame the
   class code advanced by 0.25 (the joints are computed again after it, `bf-avatar-cam-post`)."
  (smoke-neutral)
  (smoke-rec-start tag 2)
  (let ((t0 (smoke-now))
        (frames 0)
        (total 0.0)
        )
    (when (smoke-av)
      (smoke-pose-step (smoke-av) #t)
      )
    (while (and (smoke-av) (< (- (smoke-now) t0) (the int (* secs 300.0))))
      (let* ((av (smoke-av))
             (ch (-> av skel root-channel 0))
             )
        (when old-pace?
          (let ((n (the float (+ (-> ch frame-group frames num-frames) -1)))
                (f (+ (-> ch frame-num) 0.75))
                )
            (set! (-> ch frame-num) (if (>= f n) (- f n) f))
            )
          )
        (+! total (smoke-pose-step av #f))
        (+! frames 1)
        )
      (suspend)
      )
    (smoke-rec-stop)
    (let ((cm (/ (* 100.0 (/ total (meters 1))) (the float (max 1 frames)))))
      (format 0 "SMOKE pose ~S: ~D frames, joints moved ~f cm a game frame (summed over the joints), clip ~D~%"
              tag frames cm (if (smoke-av) (-> (smoke-av) anim) -1))
      cm
      )
    )
  )

(defbehavior smoke-jet-log process ((tag string) (secs float))
  "For SECS, every 0.25 s: Jak's height over his ground, his state, the jetpack's fuel and clip."
  (let ((t0 (smoke-now)))
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (let ((av (smoke-av)))
        (format 0 "SMOKE ~S: Jak ~M above his ground, state ~A, fuel ~f, clip ~D~%" tag
                (- (-> *target* control trans y) (-> *target* control gspot-pos y)) (-> *target* state name)
                (if av (-> av fuel) -1.0) (if av (-> av anim) -1))
        )
      (smoke-wait 0.25)
      )
    )
  0
  )

;; ----------------------------------------------------------------------------
;; Endurance: long fights, the player's death and respawn, a restart
;; ----------------------------------------------------------------------------

;; Pickup rate: every real unit death goes through `bf-queue-drop` (battlefront-h.gc, called by
;; bf-unit-killed); this copy of it counts the deaths it saw with room in the queue and the drops
;; they left.
(define *smoke-deaths* 0)
(define *smoke-drops* 0)
(define-perm *smoke-stock-queue-drop* (function process none) bf-queue-drop)

(defun bf-queue-drop ((proc process))
  "The stock `bf-queue-drop`, counted (`*smoke-deaths*`, `*smoke-drops*`)."
  (let ((n (-> *bf* drop-count)))
    (*smoke-stock-queue-drop* proc)
    (when (and (type? proc process-drawable) (< n BF_DROP_MAX))
      (+! *smoke-deaths* 1)
      (if (< n (-> *bf* drop-count))
          (+! *smoke-drops* 1)
          )
      )
    )
  (none)
  )

(defbehavior smoke-free-fight process ((class int) (secs float))
  "SECS of fighting as CLASS: strafing left and right and turning, R1 held, then one of the class's
   own moves in turn (guards: a dodge, a weapon change, the rifle butt; jetpacks: a climb, a way
   down, a dive kick; robotguard: a roll, the shield, a punch; spider: a bite, a sprint, a high
   jump)."
  (let ((t0 (smoke-now))
        (n 0)
        )
    (while (< (- (smoke-now) t0) (the int (* secs 300.0)))
      (smoke-step "free fight: strafe, turn and fire")
      (smoke-stick (if (zero? (logand n 1)) 30 225) 90 (if (zero? (logand n 2)) 190 70) 128)
      (smoke-hold (pad-buttons r1))
      (smoke-wait 1.5)
      (smoke-hold (the-as pad-buttons 0))
      (smoke-stick 128 128 128 128)
      (case class
        ((BF_CLASS_BLUE_GUARD BF_CLASS_RED_GUARD)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: dodge")
            (smoke-press (if (zero? (logand n 1)) (pad-buttons l2) (pad-buttons r2)) 1.0)
            )
           ((1)
            (smoke-step "free fight: weapon change")
            (smoke-press (case (mod n 9) ((1) (pad-buttons left)) ((4) (pad-buttons up)) (else (pad-buttons down))) 0.6)
            )
           (else
             (smoke-step "free fight: rifle butt")
             (smoke-press (pad-buttons square) 1.0)
             )
           )
         )
        ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: jetpack climb")
            (smoke-hold (pad-buttons x))
            (smoke-wait 0.8)
            (smoke-hold (the-as pad-buttons 0))
            )
           ((1)
            (smoke-step "free fight: jetpack down")
            (smoke-hold (pad-buttons circle))
            (smoke-wait 0.8)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: dive kick")
             (smoke-press (pad-buttons square) 1.2)
             )
           )
         )
        ((BF_CLASS_ROBOGUARD)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: roll")
            (smoke-press (pad-buttons r2) 1.4)
            )
           ((1)
            (smoke-step "free fight: shield")
            (smoke-hold (pad-buttons circle))
            (smoke-wait 1.2)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: punch")
             (smoke-press (pad-buttons square) 1.2)
             )
           )
         )
        ((BF_CLASS_SPYDROID)
         (case (mod n 3)
           ((0)
            (smoke-step "free fight: bite")
            (smoke-press (pad-buttons circle) 0.8)
            )
           ((1)
            (smoke-step "free fight: sprint")
            (smoke-stick 128 0 128 128)
            (smoke-hold (pad-buttons r2))
            (smoke-wait 1.0)
            (smoke-hold (the-as pad-buttons 0))
            )
           (else
             (smoke-step "free fight: high jump")
             (smoke-hold (pad-buttons x))
             (smoke-wait 0.8)
             (smoke-hold (the-as pad-buttons 0))
             )
           )
         )
        )
      (+! n 1)
      )
    )
  (smoke-neutral)
  0
  )

(defbehavior smoke-kill-player process ()
  "A deadly generic attack on the player from this process (the invulnerable secret lifted for
   it, then put back as it was)."
  (let ((invuln? (logtest? (-> *game-info* secrets) (game-secrets invulnerable)))
        (id (+ (-> *game-info* attack-id) 1))
        (msg (new 'stack-no-clear 'event-message-block))
        )
    (logclear! (-> *game-info* secrets) (game-secrets invulnerable))
    (set! (-> *game-info* attack-id) id)
    (set! (-> msg from) (process->ppointer self))
    (set! (-> msg num-params) 2)
    (set! (-> msg message) 'attack)
    (set! (-> msg param 0) (the-as uint #f))
    (set! (-> msg param 1)
          (the-as uint (static-attack-info :mask (vehicle-impulse-factor) ((id id)
                                                                           (damage 100.0)
                                                                           (vehicle-damage-factor 1.0)
                                                                           (vehicle-impulse-factor 1.0)
                                                                           (mode 'generic)
                                                                           )
                                  )
                   )
          )
    (send-event-function *target* msg)
    (if invuln?
        (logior! (-> *game-info* secrets) (game-secrets invulnerable))
        )
    )
  0
  )

(defbehavior smoke-death-check process ((tag string))
  "The player killed: his side loses one, the camera watches an ally while the class model is
   gone, then he is back at the spawn as the same class, the battle camera on him again."
  (smoke-step "player death")
  (smoke-neutral)
  (let ((class (-> *bf* class))
        (lost (-> *bf* losses (-> *bf* team)))
        )
    (smoke-kill-player)
    (smoke-wait 1.0)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE ~S dead: respawn pending ~A, avatar ~A, camera ~A~%" tag (nonzero? (-> *bf* respawn-time))
              (bf-avatar-alive?) (if slave (-> slave 0 state name) 'none))
      )
    (smoke-check "the killed player waits to respawn, his class model gone"
                 (and (nonzero? (-> *bf* respawn-time)) (not (bf-avatar-alive?)))
                 )
    (smoke-wait-for 15.0 (lambda () (and (zero? (-> *bf* respawn-time)) (bf-avatar-alive?))))
    (smoke-wait 1.5)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE ~S respawned: class ~D (was ~D), losses ~D (were ~D)," tag (-> *bf* class) class
              (-> *bf* losses (-> *bf* team)) lost)
      (format 0 " camera ~A, state ~A~%" (if slave (-> slave 0 state name) 'none) (-> *target* state name))
      (smoke-check "back at the spawn as the same class, one more loss, the battle camera on him"
                   (and (bf-avatar-alive?)
                        (= (-> *bf* class) class)
                        (< lost (-> *bf* losses (-> *bf* team)))
                        slave
                        (= (-> slave 0 state name) 'cam-pov)
                        (not (focus-test? *target* dead))
                        )
                   )
      )
    )
  0
  )

(defbehavior smoke-restart process ()
  "START > Gamemode > Battlefront > Restart the battle: both reserves full again, the same class,
   the battle camera."
  (smoke-step "restart the battle")
  (smoke-neutral)
  (let ((class (-> *bf* class)))
    (smoke-start-page 'bf-battlefront)
    (smoke-menu-goto 2)
    (smoke-press (pad-buttons x) 3.0)
    (smoke-wait-for 90.0 (lambda () (and (bf-fighting?) (bf-avatar-alive?))))
    (smoke-wait 2.0)
    (let ((slave (-> *camera* slave)))
      (format 0 "SMOKE restart: reserves ~D ~D, class ~D (was ~D), camera ~A~%" (-> *bf* reserve 0) (-> *bf* reserve 1)
              (-> *bf* class) class (if slave (-> slave 0 state name) 'none))
      (smoke-check "Restart the battle: the same class at the spawn, the battle camera"
                   (and (bf-avatar-alive?) (= (-> *bf* class) class) slave (= (-> slave 0 state name) 'cam-pov))
                   )
      )
    )
  0
  )

(defbehavior smoke-endurance process ((zone int) (team int) (secs float))
  "A battle in ZONE on side TEAM: each class of the side fights SECS (`smoke-free-fight`), then the
   player is killed and respawns (`smoke-death-check`); a restart at the end, then Quit."
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start zone team)
  (smoke-deploy 0 "endurance first class")
  (dotimes (i (if (= team BF_TEAM_FF) 2 4))
    (when (> i 0)
      (smoke-change-class i "endurance next class")
      )
    (format 0 "SMOKE endurance class ~D for ~D s~%" (-> *bf* class) (the int secs))
    (smoke-free-fight (-> *bf* class) secs)
    (smoke-status "endurance")
    (smoke-check "still in the battle after the long fight" (and *target* (bf-fighting?)))
    (smoke-death-check "endurance")
    )
  (smoke-restart)
  (smoke-free-fight (-> *bf* class) 10.0)
  (let ((rate (/ (the float *smoke-drops*) (the float (max 1 *smoke-deaths*)))))
    (format 0 "SMOKE pickups: ~D of ~D unit deaths left one (~f)~%" *smoke-drops* *smoke-deaths* rate)
    (smoke-check "3 of every 10 fallen units leave a pickup" (and (< 100 *smoke-deaths*) (< 0.28 rate) (< rate 0.32)))
    )
  (smoke-quit)
  0
  )

;; ----------------------------------------------------------------------------
;; The scenarios
;; ----------------------------------------------------------------------------

(defun smoke-guard-masks ()
  "The guards of the battle near the player and their hidden mesh segments (draw-control seg-mask:
   a set bit hides that segment; a blue guard's 1 and 2 are its two armors, normal and dark guard,
   so both set leave its legs alone). Prints each such guard. Returns how many."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (n 0)
        (bare 0)
        )
    (set! (-> probe w) (meters 150))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and (= (handle->process (process->handle proc)) proc) (= (-> proc type symbol) 'crimson-guard))
              (+! n 1)
              (let ((draw (-> (the-as process-drawable proc) draw)))
                (when (= (logand (-> draw seg-mask) 6) 6)
                  (+! bare 1)
                  (format 0 "SMOKE guard with both armors hidden: pid ~D ~S seg-mask ~X effect-mask ~X state ~A~%"
                          (-> proc pid) (bf-art-name proc) (-> draw seg-mask) (-> draw effect-mask) (-> proc state name))
                  )
                )
              )
            )
          )
        )
      )
    (format 0 "SMOKE guards near: ~D, ~D with both armors hidden~%" n bare)
    bare
    )
  )

(defbehavior smoke-tazer-walk process ()
  "The tazer struck while walking ahead, filmed (smoke-rec-tazer-*): the stab plays on the upper
   body (its clip is the upper body's 0.2 s after R1) and Jak keeps walking (his move in the 1.2 s
   after the strike against the 1.2 s before)."
  (smoke-step "tazer while walking")
  (smoke-press (pad-buttons left) 1.0)
  (set! (-> *bf* tazer-time) 0)
  (smoke-stick 128 0 128 128)
  (smoke-wait 0.8)
  (let ((p0 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
    (smoke-rec-start "tazer" 2)
    (smoke-wait 1.2)
    (let ((before (/ (vector-vector-xz-distance (-> *target* control trans) p0) (meters 1)))
          (p1 (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
          (stab? #f)
          )
      (smoke-tap (pad-buttons r1) 4)
      (smoke-wait 0.2)
      (when (smoke-av)
        (let ((top (-> (smoke-av) skel top-anim))
              (clip (-> (smoke-av) draw art-group data BF_CLIP_TAZER))
              )
          (if top
              (set! stab? (or (= (-> top frame-group) clip) (= (-> top frame-targ) clip)))
              )
          )
        )
      (smoke-wait 1.0)
      (smoke-rec-stop)
      (smoke-stick 128 128 128 128)
      (let ((after (/ (vector-vector-xz-distance (-> *target* control trans) p1) (meters 1))))
        (format 0 "SMOKE tazer while walking: stab on the upper body ~A, ~f m in the 1.2 s before the strike, ~f m in the 1.2 s after~%"
                stab? before after)
        (smoke-check "the tazer's stab plays on the upper body" stab?)
        (smoke-check "the guard walks on while it strikes" (< (* 0.6 before) after))
        )
      )
    )
  (smoke-press (pad-buttons down) 1.0)
  0
  )

(defbehavior smoke-look-at-jetpack process ()
  "The nearest jetpack guard within 80 m: Jak brought 8 m from it, the camera turned and tilted
   toward it, two screenshots of its flames (smoke-jet-flames, -2). Returns #t when one was found."
  (let ((probe (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans)))
        (shapes (new 'stack-no-clear 'array 'collide-shape 64))
        (best (the-as process-drawable #f))
        (best-dist (meters 80))
        )
    (set! (-> probe w) (meters 80))
    (countdown (i (fill-actor-list-for-box *actor-hash* probe shapes 64))
      (let ((shape (as-type (-> shapes i) collide-shape)))
        (when shape
          (let ((proc (-> shape process)))
            (when (and (= (handle->process (process->handle proc)) proc) (bf-hover-art? proc))
              (let ((d (vector-vector-distance (-> (the-as process-drawable proc) root trans) probe)))
                (when (< d best-dist)
                  (set! best-dist d)
                  (set! best (the-as process-drawable proc))
                  )
                )
              )
            )
          )
        )
      )
    (when best
      ;; Jak brought 8 m from it, at his own height, for a close look
      (let ((d (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (-> best root trans))))
        (set! (-> d y) 0.0)
        (vector-normalize! d (meters 8))
        (vector+! d d (-> best root trans))
        (set! (-> d y) (-> *target* control trans y))
        (move-to-point! (-> *target* control) d)
        )
      (let ((h (process->handle best)))
        (dotimes (i 3)
          (let ((p (the-as process-drawable (handle->process h))))
            (when p
              (let ((d (vector-! (new 'stack-no-clear 'vector) (-> p root trans) (-> *target* control trans))))
                (set! (-> *bf* view-yaw) (vector-y-angle d))
                (set! (-> *bf* view-pitch) (fmax (degrees -30) (fmin (degrees 35) (atan (-> d y) (vector-xz-length d)))))
                )
              )
            )
          (smoke-wait 0.4)
          )
        )
      (format 0 "SMOKE jetpack guard ~M away~%" best-dist)
      (smoke-shot "jet-flames")
      (smoke-wait 0.3)
      (smoke-shot "jet-flames-2")
      (smoke-wait 0.5)
      (set! (-> *bf* view-pitch) 0.0)
      )
    (if best #t #f)
    )
  )

(defbehavior smoke-scenario process ()
  (format 0 "SMOKE start scenario ~D~%" SMOKE_SCENARIO)
  (smoke-boot)
  (case SMOKE_SCENARIO
    ((1)
     ;; T1: the Mods menu opens with L3 + SELECT, as every mod's; the mode's switch adds START >
     ;; Options > Gamemode; switched off, the stock Options page is back
     (format 0 "SMOKE bind ~X (L3 + SELECT is ~X)~%" *mods-menu-bind* (pad-buttons l3 select))
     (smoke-check "the Mods menu bind is L3 + SELECT" (= *mods-menu-bind* (pad-buttons l3 select)))
     (let ((n (-> *options-options-pc* options length)))
       (smoke-mods-toggle "mods-menu-on")
       (smoke-check "Battlefront mode on" *mod-battlefront-enable*)
       (smoke-check "START > Options gains Gamemode" (= (-> *options-options-pc* options length) (+ n 1)))
       (smoke-start-page 'options)
       (smoke-shot "options-gamemode")
       (when *progress-process*
         (set-next-state (-> *progress-process* 0) 'go-away 0)
         )
       (smoke-wait 2.0)
       (smoke-mods-toggle "mods-menu-off")
       (smoke-check "Battlefront mode off" (not *mod-battlefront-enable*))
       (smoke-check "START > Options back to the stock page" (= (-> *options-options-pc* options length) n))
       (smoke-check "no battle director while the mode is off" (not (bf-active?)))
       )
     )
    ((2)
     ;; T2 to T5, Freedom League at the Port: the page order, the camera, the blue classes played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-camera-checks)
     (smoke-play BF_CLASS_BLUE_GUARD "blue-guard")
     (smoke-change-class 1 "blue jetpack")
     (smoke-play BF_CLASS_BLUE_JETPACK "blue-jetpack")
     (smoke-quit)
     )
    ((3)
     ;; T4 and T5, Krimzon Guard in the Industrial Zone: every red class played
     (smoke-stock-camera)
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_KG)
     (smoke-deploy 0 "deploy red guard")
     (smoke-camera-checks)
     (smoke-play BF_CLASS_RED_GUARD "red-guard")
     (smoke-change-class 1 "red jetpack")
     (smoke-play BF_CLASS_RED_JETPACK "red-jetpack")
     (smoke-change-class 2 "robotguard")
     (smoke-play BF_CLASS_ROBOGUARD "robotguard")
     (smoke-change-class 3 "spider")
     (smoke-play BF_CLASS_SPYDROID "spider")
     (smoke-quit)
     )
    ((7)
     ;; T6 on film: a jetpack left alone at the clip pace before the fix and at the fixed one, on the
     ;; ground then hovering, in the same place
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 1 "deploy blue jetpack")
     (smoke-invulnerable #t)
     (smoke-step "jetpack on the ground, both paces")
     (let ((g-old (smoke-pose-watch "jet-ground-old" 3.0 #t))
           (g-new (smoke-pose-watch "jet-ground-new" 3.0 #f))
           )
       (smoke-step "jetpack up")
       (smoke-hold (pad-buttons x))
       (smoke-wait 1.5)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-wait 1.0)
       (smoke-step "jetpack hovering, both paces")
       (let ((h-old (smoke-pose-watch "jet-hover-old" 3.0 #t))
             (h-new (smoke-pose-watch "jet-hover-new" 3.0 #f))
             )
         (format 0 "SMOKE legs: ground ~f cm before, ~f after; hovering ~f before, ~f after~%" g-old g-new h-old h-new)
         (smoke-check "the jetpack's joints move at least three times less than before the fix, on the ground and hovering"
                      (and (< (* 3.0 g-new) g-old) (< (* 3.0 h-new) h-old))
                      )
         )
       )
     (smoke-quit)
     )
    ((5)
     ;; T7, Freedom League at the Freedom HQ: each class in a long fight, the player's death, a restart
     (smoke-endurance 3 BF_TEAM_FF 75.0)
     )
    ((6)
     ;; T7, Krimzon Guard in the Slums
     (smoke-endurance 2 BF_TEAM_KG 60.0)
     )
    ((4)
     ;; T6: a jetpack left alone, on the ground then in the air; T3 again on film: the camera turned
     ;; by the right stick, a strafe, a guard's rolls
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-deploy 1 "deploy blue jetpack")
     (smoke-invulnerable #t)
     (smoke-step "jetpack on the ground")
     (let ((g (smoke-hover-watch "jet-ground" 3.0)))
       (smoke-step "jetpack up")
       (smoke-hold (pad-buttons x))
       (smoke-jet-log "climb" 1.5)
       (smoke-hold (the-as pad-buttons 0))
       (smoke-jet-log "let go" 1.0)
       (smoke-step "jetpack hovering")
       (let ((h (smoke-hover-watch "jet-hover" 3.0)))
         (smoke-check "a jetpack left alone keeps its clip, on the ground and in the air" (and (zero? g) (zero? h)))
         )
       )
     (smoke-change-class 0 "blue guard")
     (smoke-step "film the camera")
     (smoke-rec-start "tps" 2)
     (smoke-stick 128 128 255 128)
     (smoke-wait 1.0)
     (smoke-stick 128 128 0 128)
     (smoke-wait 1.0)
     (smoke-stick 0 128 128 128)
     (smoke-wait 1.0)
     (smoke-stick 128 0 128 128)
     (smoke-wait 1.5)
     (smoke-neutral)
     (smoke-wait 0.5)
     (smoke-rec-stop)
     (smoke-rec-start "roll" 2)
     (smoke-roll 255 128)
     (smoke-wait 0.5)
     (smoke-roll 0 128)
     (smoke-rec-stop)
     (smoke-quit)
     )
    ((8)
     ;; T8 to T12, Freedom League at the Port: class help, health, the guard's ammo, tazer, rolls and
     ;; strafes, its close attack's delay, the START ring's locks, damage on the 24 point scale and
     ;; the kill counter, who aims at whom; the jetpack's health and boost
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 0 BF_TEAM_FF)
     (smoke-help-shots 2)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-hp-check BF_CLASS_BLUE_GUARD)
     (smoke-start-locks)
     (smoke-invulnerable #t)
     (smoke-guard-ammo)
     (smoke-weapon-shots)
     (smoke-tazer)
     (smoke-guard-moves)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-invulnerable #f)
     (smoke-player-hits #f)
     (smoke-unit-damage)
     (smoke-hatred-check)
     (smoke-change-class 1 "blue jetpack")
     (smoke-hp-check BF_CLASS_BLUE_JETPACK)
     (smoke-invulnerable #t)
     (smoke-jet-boost)
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    ((10)
     ;; The author's play (round 15): Freedom League in the Industrial Zone, the blue guard deployed at
     ;; once; the red guards' armor, the tazer's stab while walking, the roll and the strafe on film,
     ;; a jetpack guard's flames, then a long fight
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-status "blue guard deployed")
     (smoke-invulnerable #t)
     (smoke-check "no guard has both armors hidden" (zero? (smoke-guard-masks)))
     (smoke-tazer-walk)
     (smoke-step "film the rolls")
     (smoke-rec-start "roll" 2)
     (smoke-roll 255 128)
     (smoke-wait 0.5)
     (smoke-roll 128 0)
     (smoke-rec-stop)
     (smoke-step "film the strafe")
     (smoke-rec-start "strafe" 2)
     (smoke-strafe 255)
     (smoke-rec-stop)
     (smoke-guard-moves)
     (smoke-check "a jetpack guard near to look at" (smoke-look-at-jetpack))
     (smoke-invulnerable #f)
     (smoke-free-fight BF_CLASS_BLUE_GUARD 40.0)
     (smoke-check "no guard has both armors hidden after the fight" (zero? (smoke-guard-masks)))
     (smoke-status "blue guard after the fight")
     (smoke-check "still in the battle after the long fight" (and *target* (bf-fighting?)))
     (smoke-quit)
     )
    ((9)
     ;; T8 to T12, Krimzon Guard in the Industrial Zone: class help; the spider's health, leap and
     ;; sprint; the robotguard's health, shield and ball; the close attacks' delays; the red guard's
     ;; tazer; no tazer among the battle's guards; who aims at whom
     (smoke-mods-toggle "mods-menu-on")
     (smoke-battle-start 1 BF_TEAM_KG)
     (smoke-help-shots 4)
     ;; the spider first, at the spawn: its leap needs open sky (under the Industrial Zone's pipes it
     ;; stopped at 6.8 m)
     (smoke-deploy 3 "deploy spider")
     (smoke-hp-check BF_CLASS_SPYDROID)
     (smoke-invulnerable #t)
     (smoke-spider-r14)
     (smoke-melee-delay (pad-buttons circle) 1.0)
     (smoke-change-class 2 "robotguard")
     (smoke-hp-check BF_CLASS_ROBOGUARD)
     (smoke-robot-r14)
     (smoke-invulnerable #t)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-change-class 0 "red guard")
     (smoke-hp-check BF_CLASS_RED_GUARD)
     (smoke-weapon-shots)
     (smoke-tazer)
     (smoke-melee-delay (pad-buttons square) 1.5)
     (smoke-bot-weapons)
     (smoke-hatred-check)
     (smoke-invulnerable #f)
     (smoke-quit)
     )
    )
  (format 0 "SMOKE DONE~%")
  0
  )

(defun smoke-start ()
  "Spawn the scenario's process in *pc-pool*, which outlives the resets of a deployment, and let it
   run under the menus."
  (process-spawn-function
    process
    (lambda :behavior process ()
      ;; the main thread keeps 256 bytes of stack across a suspend unless told more: the scenario's
      ;; stack vectors outgrew it ("suspend called without enough stack", then the game stopped)
      (stack-size-set! (-> self main-thread) 4096)
      (process-mask-clear! (-> self mask) menu pause progress freeze)
      (smoke-scenario)
      (sleep-code)
      )
    :name "smoke-test"
    :from *default-dead-pool*
    :to *pc-pool*
    :stack-size #x8000
    )
  0
  )
