;; ----------------------------------------------------------------------------
;; Trailer v4 (scenarios 110 and up): the light chosen by stills, the point beams hidden in the
;; shots, the line of sight watched while recording, drops from close open spots, the palace overview
;; ----------------------------------------------------------------------------

(define-perm *smoke-points-stock* (function none) bf-draw-points)

(defun bf-draw-points ()
  "Trailer v4 wrapper: no point beam while `*smoke-cine*` nohud? (the shots show the battle alone),
   else the battle's beams."
  (if (not (-> *smoke-cine* nohud?))
      (*smoke-points-stock*)
      )
  (none)
  )

(defun smoke-trl-los-frame ()
  "Once a recorded game frame while `*smoke-los-watch*` (`smoke-cine-frame`): scenery between the
   camera and Jak's pivot (when `*smoke-los-jak?*`), or between the camera and the point it looks at
   (the tracked enemy's chest while the aim tracker runs, else the cinematic camera's look) marks the
   frame blocked; each run of blocked recorded frames is printed when it ends (`smoke-trl-los-flush`)."
  (let* ((cam (-> *math-camera* trans))
         (to (if (-> *smoke-aim* track?) (-> *smoke-cine* aim-at) *smoke-last-look*))
         (blocked? (or (not (smoke-trl-los? cam to))
                       (and *smoke-los-jak?* *target* (not (smoke-trl-los? cam (bf-cam-pivot (new 'stack-no-clear 'vector)))))
                       )
                   )
         )
    (cond
      ((and blocked? (< *smoke-los-from* 0))
       (set! *smoke-los-from* (-> *smoke-cine* n))
       )
      ((and (not blocked?) (>= *smoke-los-from* 0))
       (smoke-trl-los-flush)
       )
      )
    )
  0
  )

(defun smoke-trl-los-flush ()
  "Print the run of blocked frames under way (`smoke-trl-los-frame`), if any, and close it."
  (when (>= *smoke-los-from* 0)
    (format 0 "SMOKE blocked ~S frames ~D to ~D~%" *smoke-rec-clip* *smoke-los-from* (-> *smoke-cine* n))
    (set! *smoke-los-from* -1)
    )
  0
  )

(defbehavior smoke-v4-still process ((pt int) (tag string))
  "A still of battle point PT from 30 m off its clearest heading and 14 m up, looking at it 2 m over
   its ground: smoke-TAG.png. The same heading each call (the light compared on one view)."
  (let* ((at (vector-copy! (new 'stack-no-clear 'vector) (-> *bf* points pt pos)))
         (ang (smoke-trl-clear-dir at (meters 30) (meters 14)))
         (eye (new 'stack-no-clear 'vector))
         )
    (set-vector! eye (+ (-> at x) (* (meters 30) (sin ang))) (+ (-> at y) (meters 14)) (+ (-> at z) (* (meters 30) (cos ang))) 1.0)
    (+! (-> at y) (meters 2))
    (smoke-cine-line eye eye at 1.0)
    (smoke-wait 1.0)
    (smoke-shot tag)
    (smoke-wait 0.6)
    )
  0
  )

(define *smoke-palace-top* (new 'static 'vector))

(defbehavior smoke-v4-palace-scout process ()
  "The palace tower's top: probes straight down from 470 m (the city's collision ceiling) on a 10 m
   grid 200 m around the palace's foot (Jak 2's ctypal-shaft continue point, x 191 m, z 774 m); the
   highest hit into `*smoke-palace-top*`, logged with how many columns stand over 100 m. Returns
   its height (under 0 for no hit)."
  (let ((cq (new 'stack-no-clear 'collide-query))
        (best (meters -1000))
        (tall 0)
        )
    (set-vector! *smoke-palace-top* (meters 191) 0.0 (meters 774) 1.0)
    (dotimes (i 41)
      (dotimes (j 41)
        (set! (-> cq radius) (meters 0.5))
        (set! (-> cq collide-with) (collide-spec backgnd))
        (set! (-> cq ignore-process0) #f)
        (set! (-> cq ignore-process1) #f)
        (set! (-> cq ignore-pat) (new 'static 'pat-surface :nocamera #x1 :probe #x1 :noendlessfall #x1))
        (set! (-> cq action-mask) (collide-action solid))
        (set-vector! (-> cq start-pos)
                     (+ (meters 191) (* (meters 10) (the float (- i 20))))
                     (meters 470)
                     (+ (meters 774) (* (meters 10) (the float (- j 20))))
                     1.0
                     )
        (set-vector! (-> cq move-dist) 0.0 (meters -470) 0.0 1.0)
        (let ((t (fill-and-probe-using-line-sphere *collide-cache* cq)))
          (when (>= t 0.0)
            (let ((y (- (meters 470) (* t (meters 470)))))
              (if (< (meters 100) y)
                  (+! tall 1)
                  )
              (when (< best y)
                (set! best y)
                (set-vector! *smoke-palace-top* (-> cq start-pos x) y (-> cq start-pos z) 1.0)
                )
              )
            )
          )
        )
      (suspend)
      )
    (format 0 "SMOKE trailer palace top ~M ~M ~M (~D columns over 100 m)~%" (-> *smoke-palace-top* x)
            (-> *smoke-palace-top* y) (-> *smoke-palace-top* z) tall)
    best
    )
  )

(defun smoke-v4-city-middle ((out vector))
  "The middle of the battle points (the city's middle, on the ground) into OUT; returns OUT."
  (vector-reset! out)
  (dotimes (i (-> *bf* point-count))
    (vector+! out out (-> *bf* points i pos))
    )
  (vector-float*! out out (/ 1.0 (the float (-> *bf* point-count))))
  (set! (-> out w) 1.0)
  out
  )

(defbehavior smoke-s110 process ()
  "Scenario 110 (`smoke-scenario-late`), trailer v4 scouting: the light at 10:00, 12:00, 14:00 and
   16:00 on three battle points (the Palace HQ, the Central Quarter, the West Farms), stills; the
   palace tower's top found by probes (`smoke-v4-palace-scout`), stills of the tower from four sides
   (low and high) and from over its top toward the city's middle. No check of its own."
  (smoke-trl-v2-start BF_TEAM_KG 0 "deploy red guard")
  (smoke-trl-park-at 3)
  (smoke-wait 3.0)
  (let ((hours (new 'static 'array int32 4 10 12 14 16)))
    (dotimes (h 4)
      (send-event (ppointer->process *time-of-day*) 'change 'hour (-> hours h))
      (smoke-wait 2.0)
      (format (clear *smoke-name*) "v4-light-palace-~D" (-> hours h))
      (smoke-v4-still 3 *smoke-name*)
      (format (clear *smoke-name*) "v4-light-central-~D" (-> hours h))
      (smoke-v4-still 9 *smoke-name*)
      (format (clear *smoke-name*) "v4-light-farms-~D" (-> hours h))
      (smoke-v4-still 10 *smoke-name*)
      )
    )
  (smoke-trl-daylight)
  (smoke-v4-palace-scout)
  (let ((eye (new 'stack-no-clear 'vector))
        (look (new 'stack-no-clear 'vector))
        (mid (smoke-v4-city-middle (new 'stack-no-clear 'vector)))
        (dir (new 'stack-no-clear 'vector))
        )
    (dotimes (k 4)
      (let ((ang (degrees (* 90.0 (the float k)))))
        (set-vector! eye (+ (meters 191) (* (meters 350) (sin ang))) (meters 150) (+ (meters 774) (* (meters 350) (cos ang))) 1.0)
        (set-vector! look (meters 191) (meters 150) (meters 774) 1.0)
        (smoke-cine-line eye eye look 1.0)
        (smoke-wait 1.0)
        (format (clear *smoke-name*) "v4-scout-palace-low-~D" k)
        (smoke-shot *smoke-name*)
        (smoke-wait 0.6)
        (set-vector! look (meters 191) (meters 350) (meters 774) 1.0)
        (smoke-cine-line eye eye look 1.0)
        (smoke-wait 1.0)
        (format (clear *smoke-name*) "v4-scout-palace-high-~D" k)
        (smoke-shot *smoke-name*)
        (smoke-wait 0.6)
        )
      )
    ;; over the top toward the city's middle, and back at the top
    (vector-! dir mid *smoke-palace-top*)
    (set! (-> dir y) 0.0)
    (vector-normalize! dir 1.0)
    (vector+float*! eye *smoke-palace-top* dir (meters 30))
    (+! (-> eye y) (meters 25))
    (smoke-cine-line eye eye mid 1.0)
    (smoke-wait 1.5)
    (smoke-shot "v4-scout-top-view")
    (smoke-wait 0.6)
    (vector+float*! eye *smoke-palace-top* dir (meters 90))
    (+! (-> eye y) (meters 30))
    (smoke-cine-line eye eye *smoke-palace-top* 1.0)
    (smoke-wait 1.5)
    (smoke-shot "v4-scout-top-back")
    (smoke-wait 0.6)
    )
  (smoke-cine-off)
  0
  )

;; trailer v4: drops filmed close, from an open spot chosen around the ship's hatch

;; per style (0 low on the side, 1 high three-quarter over the landing, 2 low beyond the landing
;; facing the ship, 3 side at mid height): 6 headings from the hatch's way (degrees), 3 distances
;; (m, from the landing's near half; style 2 from under the ship), 2 heights over the ground (m), and
;; how high the look goes between the ground (0) and 3 m over the ship (1)
(define *smoke-v4-drop-offs* (new 'static 'array float 24
                                 90.0 -90.0 65.0 -65.0 115.0 -115.0
                                 40.0 -40.0 25.0 -25.0 60.0 -60.0
                                 0.0 20.0 -20.0 35.0 -35.0 50.0
                                 100.0 -100.0 125.0 -125.0 80.0 -80.0
                                 )
  )
;; trailer v4, after scenario 115: farther, so the ship and the landing fit the 38.7 degree high view
(define *smoke-v4-drop-dists* (new 'static 'array float 12 28.0 34.0 24.0 28.0 34.0 24.0 32.0 38.0 28.0 26.0 32.0 22.0))
(define *smoke-v4-drop-ups* (new 'static 'array float 8 1.2 2.4 14.0 10.0 1.5 3.0 5.0 7.0))
(define *smoke-v4-drop-high* (new 'static 'array float 4 0.5 0.15 0.45 0.35))
(define *smoke-v4-eye* (new 'static 'vector))
(define *smoke-v4-look* (new 'static 'vector))

(define-extern smoke-v4-ground-ok? (function vector vector symbol))

(defun smoke-v4-drop-cam ((pt int) (style int))
  "A still camera spot, close, for the ship over headquarters PT in STYLE (`*smoke-v4-drop-offs*`):
   its units leave the hatch at its back (the ship's -z) and land 12 to 18 m behind it. Of the
   style's headings, distances and heights, the first spot with a clear line (a 0.5 m sphere) to the
   ship, its top, its hatch's end, the landing ground and the landing's near half, nothing within 6 m
   in front of the lens (a 1.5 m sphere), open sky 25 m over it, and the ship's top and the landing
   ground at most 40 degrees apart as seen from it (both in the frame: scenario 111's first try
   looked at the ground and left the ship out). It looks halfway between those two directions. The
   spot into `*smoke-v4-eye*`, the point looked at into `*smoke-v4-look*`. Returns #t when one was
   found."
  (let ((ship (the-as process-drawable (handle->process (-> *bf* points pt ship)))))
    (when ship
      (let* ((sc (vector-copy! (new 'stack-no-clear 'vector) (-> ship root trans)))
             (gy (-> *bf* points pt pos y))
             (hatch (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> ship root quat)))
             (ground (new 'stack-no-clear 'vector))
             (mid (new 'stack-no-clear 'vector))
             (land (new 'stack-no-clear 'vector))
             (top (vector-copy! (new 'stack-no-clear 'vector) sc))
             (tail (new 'stack-no-clear 'vector))
             (dir (new 'stack-no-clear 'vector))
             (ahead (new 'stack-no-clear 'vector))
             (sky (new 'stack-no-clear 'vector))
             (n1 (new 'stack-no-clear 'vector))
             (n2 (new 'stack-no-clear 'vector))
             (eye *smoke-v4-eye*)
             (look *smoke-v4-look*)
             )
        (vector-negate! hatch hatch)
        (set! (-> hatch y) 0.0)
        (vector-normalize! hatch 1.0)
        (set-vector! ground (-> sc x) gy (-> sc z) 1.0)
        (vector+float*! mid ground hatch (meters 7))
        (+! (-> mid y) (meters 1))
        (vector+float*! land ground hatch (meters 15))
        (+! (-> land y) (meters 1))
        (+! (-> top y) (meters 2))
        (vector+float*! tail sc hatch (meters 8))
        (dotimes (r 3)
          (dotimes (u 2)
            (dotimes (k 6)
              (vector-rotate-around-y! dir hatch (degrees (-> *smoke-v4-drop-offs* (+ (* 6 style) k))))
              (vector+float*! eye (if (= style 2) ground mid) dir (meters (-> *smoke-v4-drop-dists* (+ (* 3 style) r))))
              (set! (-> eye y) (+ gy (meters (-> *smoke-v4-drop-ups* (+ (* 2 style) u)))))
              (set! (-> eye w) 1.0)
              (vector-! n1 top eye)
              (vector-normalize! n1 1.0)
              (vector-! n2 land eye)
              (+! (-> n2 y) (meters -1))
              (vector-normalize! n2 1.0)
              (vector-float*! ahead n1 0.58)
              (vector+float*! ahead ahead n2 0.42)
              (vector-normalize! ahead (meters 20))
              (vector+! look eye ahead)
              (vector-normalize! ahead (meters 6))
              (vector+! ahead ahead eye)
              (vector-copy! sky eye)
              (+! (-> sky y) (meters 25))
              (when (and (< 0.866 (vector-dot n1 n2))
                         (smoke-v4-ground-ok? eye look)
                         (smoke-trl-los-r? eye look (meters 1))
                         (smoke-trl-los-r? eye sc (meters 0.5))
                         (smoke-trl-los-r? eye top (meters 0.5))
                         (smoke-trl-los-r? eye tail (meters 0.5))
                         (smoke-trl-los-r? eye land (meters 0.5))
                         (smoke-trl-los-r? eye mid (meters 0.5))
                         (smoke-trl-los-r? eye ahead (meters 1.5))
                         (smoke-trl-los-r? eye sky (meters 0.5))
                         )
                (format 0 "SMOKE trailer drop spot point ~D style ~D: ~M m off at ~R from the hatch, ~M m up,"
                        pt style
                        (meters (-> *smoke-v4-drop-dists* (+ (* 3 style) r)))
                        (degrees (-> *smoke-v4-drop-offs* (+ (* 6 style) k)))
                        (meters (-> *smoke-v4-drop-ups* (+ (* 2 style) u)))
                        )
                (format 0 " ship ~M m up, cosine ~f~%" (- (-> sc y) gy) (vector-dot n1 n2))
                (return #t)
                )
              )
            )
          )
        )
      )
    )
  (format 0 "SMOKE trailer: no open drop spot for point ~D style ~D~%" pt style)
  #f
  )

(defun smoke-v4-ground-y ((pos vector))
  "The height of the ground under POS (a probe from 12 m over it down 40 m); -10000 m when none."
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (set! (-> cq radius) (meters 0.3))
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :nocamera #x1 :probe #x1 :noendlessfall #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (vector-copy! (-> cq start-pos) pos)
    (+! (-> cq start-pos y) (meters 12))
    (set-vector! (-> cq move-dist) 0.0 (meters -40) 0.0 1.0)
    (let ((t (fill-and-probe-using-line-sphere *collide-cache* cq)))
      (if (>= t 0.0)
          (- (+ (-> pos y) (meters 12)) (* t (meters 40)))
          (meters -10000)
          )
      )
    )
  )

(defun smoke-v4-ground-ok? ((eye vector) (look vector))
  "#t when the ground 6 and 12 m in front of EYE (toward LOOK, level) lies under it (0.5 m under at
   6 m, at most 1 m over at 12 m: no slope or stairs rising into the frame) and the ground under EYE
   itself is at most 25 m down."
  (let ((fwd (vector-! (new 'stack-no-clear 'vector) look eye))
        (p (new 'stack-no-clear 'vector))
        )
    (set! (-> fwd y) 0.0)
    (vector-normalize! fwd 1.0)
    (vector+float*! p eye fwd (meters 6))
    (and (< (smoke-v4-ground-y p) (- (-> eye y) (meters 0.3)))
         (begin
           (vector+float*! p eye fwd (meters 12))
           (< (smoke-v4-ground-y p) (+ (-> eye y) (meters 2)))
           )
         (< (- (-> eye y) (meters 25)) (smoke-v4-ground-y eye))
         )
    )
  )

(defun smoke-v4-points-neutral ()
  "Every control point neutral, its capture reset: no side holds one, so every reinforcement comes
   down from a ship over a headquarters (a held control point gets its side's units on its own)."
  (dotimes (i (-> *bf* point-count))
    (let ((pt (-> *bf* points i)))
      (when (not (-> pt base?))
        (set! (-> pt owner) BF_TEAM_NONE)
        (set! (-> pt prog-team) BF_TEAM_NONE)
        (set! (-> pt progress) 0.0)
        )
      )
    )
  0
  )

(defbehavior smoke-v4-drop process ((team int) (kind symbol) (hq int) (style int) (clip string) (wait float))
  "Wait (WAIT seconds at most) for a unit of KIND of TEAM leaving the ship over TEAM's headquarters
   HQ (0 or 1; -1 for either), then film it still from a close open spot of STYLE
   (`smoke-v4-drop-cam`; the next styles in turn when none): CLIP, 5 s, no HUD, no beam. Returns #t
   when filmed."
  (let ((t0 (smoke-now))
        (found (the-as handle #f))
        (pt -1)
        )
    (until (or (handle->process found) (< (the int (* 300.0 wait)) (- (smoke-now) t0)))
      ;; no control point held: the reinforcements come by ship (scenario 111: the Krimzon Guard
      ;; held points and dropped nothing in a minute)
      (smoke-v4-points-neutral)
      (dotimes (i (smoke-trl-gather))
        (let ((p (the-as process-drawable (handle->process (-> *smoke-trl-h* i)))))
          (when (and p (not (handle->process found)) (= (bf-unit-team p) team) (= (bf-unit-kind-name p) kind)
                     (= (-> p next-state name) 'exit-transport)
                     (!= (-> *smoke-trl-h* i) (-> *smoke-trl-last-drop* 0))
                     )
            (let ((q (smoke-trl-drop-ship p team)))
              (when (and (>= q 0) (or (< hq 0) (= q (+ team (* 2 hq)))))
                (set! pt q)
                (set! found (-> *smoke-trl-h* i))
                )
              )
            )
          )
        )
      (if (not (handle->process found))
          (suspend)
          )
      )
    (when (handle->process found)
      (set! (-> *smoke-trl-last-drop* 0) found)
      (dotimes (k 4)
        (when (smoke-v4-drop-cam pt (mod (+ style k) 4))
          (smoke-cine-line *smoke-v4-eye* *smoke-v4-eye* *smoke-v4-look* 1.0)
          (format 0 "SMOKE trailer drop ~S at point ~D, style ~D~%" kind pt (mod (+ style k) 4))
          ;; the HUD hidden from the next frame on: the first recorded frame showed it
          (smoke-wait 0.1)
          (smoke-cine-take clip 5.0 2)
          (smoke-cine-off)
          (return #t)
          )
        )
      )
    )
  (format 0 "SMOKE trailer: no ~S filmed for ~S~%" kind clip)
  #f
  )

(defbehavior smoke-v4-drop2 process ((team int) (kind symbol) (hq int) (style int) (clip string))
  "`smoke-v4-drop` at headquarters HQ (35 s at most), else at either (25 s more)."
  (if (not (smoke-v4-drop team kind hq style clip 35.0))
      (smoke-v4-drop team kind -1 style clip 25.0)
      )
  0
  )

(define *smoke-palace-axis* (new 'static 'vector :x 782336.0 :z 2293760.0 :w 1.0)) ;; x 191 m, z 560 m)

(defbehavior smoke-v4-still-at process ((eye vector) (look vector) (tag string))
  "A still from EYE looking at LOOK (no probe): smoke-TAG.png."
  (smoke-cine-line eye eye look 1.0)
  (smoke-wait 1.2)
  (smoke-shot tag)
  (smoke-wait 0.6)
  0
  )

(defbehavior smoke-v4-palace-scout2 process ()
  "The palace tower (seen in scenario 110's stills about x 191 m, z 560 m; no collision up there):
   stills to place the overview: straight down on it from 900 m, from 600 m east of it looking
   level at 250, 350, 450 and 550 m (what crosses the middle row stands that high), and from 120 and
   200 m out of its axis toward the city's middle at 300, 400 and 500 m up, looking at the middle."
  (let ((eye (new 'stack-no-clear 'vector))
        (look (new 'stack-no-clear 'vector))
        (mid (smoke-v4-city-middle (new 'stack-no-clear 'vector)))
        (dir (new 'stack-no-clear 'vector))
        (ax *smoke-palace-axis*)
        )
    (format 0 "SMOKE trailer city middle ~M ~M ~M~%" (-> mid x) (-> mid y) (-> mid z))
    (set-vector! eye (-> ax x) (meters 900) (-> ax z) 1.0)
    (set-vector! look (-> ax x) 0.0 (+ (-> ax z) (meters 40)) 1.0)
    (smoke-v4-still-at eye look "v4-scout2-down")
    (dotimes (k 4)
      (let ((h (meters (+ 250.0 (* 100.0 (the float k))))))
        (set-vector! eye (+ (-> ax x) (meters 600)) h (-> ax z) 1.0)
        (set-vector! look (-> ax x) h (-> ax z) 1.0)
        (format (clear *smoke-name*) "v4-scout2-level-~D" (+ 250 (* 100 k)))
        (smoke-v4-still-at eye look *smoke-name*)
        )
      )
    (vector-! dir mid ax)
    (set! (-> dir y) 0.0)
    (vector-normalize! dir 1.0)
    (dotimes (r 2)
      (dotimes (k 3)
        (vector+float*! eye ax dir (meters (if (zero? r) 120.0 200.0)))
        (set! (-> eye y) (meters (+ 300.0 (* 100.0 (the float k)))))
        (format (clear *smoke-name*) "v4-scout2-from-~D-~D" (if (zero? r) 120 200) (+ 300 (* 100 k)))
        (smoke-v4-still-at eye mid *smoke-name*)
        )
      )
    )
  0
  )

(defbehavior smoke-v4-overview process ()
  "The city from the palace's height, three candidate takes, 16 s each, no HUD: overview-palace-1,
   150 m out of the tower's axis toward the city's middle and 380 m up, a slow pan of 70 degrees
   looking down toward the middle; overview-palace-2, the same 110 m out and 470 m up;
   overview-palace-3, a slow glide from 160 m out and 420 m up, 160 m farther and 60 m down,
   looking at the middle."
  (let ((ax *smoke-palace-axis*)
        (mid (smoke-v4-city-middle (new 'stack-no-clear 'vector)))
        (dir (new 'stack-no-clear 'vector))
        (eye (new 'stack-no-clear 'vector))
        (b (new 'stack-no-clear 'vector))
        )
    (vector-! dir mid ax)
    (set! (-> dir y) 0.0)
    (vector-normalize! dir 1.0)
    (dotimes (k 2)
      (vector+float*! eye ax dir (if (zero? k) (meters 150) (meters 110)))
      (set! (-> eye y) (if (zero? k) (meters 380) (meters 470)))
      (smoke-cine-set SMOKE_CINE_PAN eye 0.0 0.0 (- (vector-y-angle dir) (degrees 35)) (degrees 4.375)
                      (* 0.8 (meters 100) (/ (- (-> eye y) (-> mid y)) (vector-vector-xz-distance eye mid))))
      (smoke-wait 0.5)
      (format (clear *smoke-name*) "overview-palace-~D" (+ k 1))
      (smoke-cine-take *smoke-name* 16.0 2)
      )
    (vector+float*! eye ax dir (meters 160))
    (set! (-> eye y) (meters 420))
    (vector+float*! b eye dir (meters 160))
    (+! (-> b y) (meters -60))
    (smoke-cine-line eye b mid 16.0)
    (smoke-wait 0.3)
    (smoke-cine-take "overview-palace-3" 16.0 2)
    (smoke-cine-off)
    )
  0
  )

(defbehavior smoke-v4-overview2 process ()
  "The city from the palace's height, level enough for its skyline (scenario 111's takes looked
   almost straight down): four candidate takes, 18 s each, no HUD. The tower stands about x 191 m,
   z 560 m, its disc about 300 to 330 m up, its spires to about 520 m (scenario 111's stills).
   overview-palace-4: 160 m out of the axis toward the city's middle and 360 m up, a pan of 80
   degrees looking 18 degrees down; overview-palace-5: 220 m out and 330 m up, the pan the other
   way, 15 degrees down; overview-palace-6: a glide from 130 m out and 380 m up to 330 m out and
   300 m up, looking at the ground 1100 m out; overview-palace-7: as 4, a quarter turn further
   round the tower."
  (let ((ax *smoke-palace-axis*)
        (mid (smoke-v4-city-middle (new 'stack-no-clear 'vector)))
        (dir (new 'stack-no-clear 'vector))
        (eye (new 'stack-no-clear 'vector))
        (b (new 'stack-no-clear 'vector))
        (far (new 'stack-no-clear 'vector))
        )
    (vector-! dir mid ax)
    (set! (-> dir y) 0.0)
    (vector-normalize! dir 1.0)
    (vector+float*! eye ax dir (meters 160))
    (set! (-> eye y) (meters 360))
    (smoke-cine-set SMOKE_CINE_PAN eye 0.0 0.0 (- (vector-y-angle dir) (degrees 40)) (degrees 4.444) (meters 32.5))
    (smoke-wait 0.5)
    (smoke-cine-take "overview-palace-4" 18.0 2)
    (vector+float*! eye ax dir (meters 220))
    (set! (-> eye y) (meters 330))
    (smoke-cine-set SMOKE_CINE_PAN eye 0.0 0.0 (+ (vector-y-angle dir) (degrees 40)) (degrees -4.444) (meters 26.8))
    (smoke-wait 0.5)
    (smoke-cine-take "overview-palace-5" 18.0 2)
    (vector+float*! eye ax dir (meters 130))
    (set! (-> eye y) (meters 380))
    (vector+float*! b ax dir (meters 330))
    (set! (-> b y) (meters 300))
    (vector+float*! far ax dir (meters 1100))
    (set! (-> far y) 0.0)
    (smoke-cine-line eye b far 18.0)
    (smoke-wait 0.3)
    (smoke-cine-take "overview-palace-6" 18.0 2)
    (vector-copy! b dir)
    (vector-rotate-around-y! dir b (degrees 90))
    (vector+float*! eye ax dir (meters 160))
    (set! (-> eye y) (meters 360))
    (smoke-cine-set SMOKE_CINE_PAN eye 0.0 0.0 (- (vector-y-angle dir) (degrees 40)) (degrees 4.444) (meters 32.5))
    (smoke-wait 0.5)
    (smoke-cine-take "overview-palace-7" 18.0 2)
    (smoke-cine-off)
    )
  0
  )

(defbehavior smoke-s111 process ()
  "Scenario 111 (`smoke-scenario-late`), trailer v4: stills around the palace tower
   (`smoke-v4-palace-scout2`), the city from the palace's height (three slow candidate takes,
   `smoke-v4-overview`), then the drops of both sides at their four headquarters, each from a
   close open spot of its own style (`smoke-v4-drop`), the line of sight watched. No check of its
   own."
  (set! *smoke-trl-hour* 12)
  (smoke-trl-v2-start BF_TEAM_KG 0 "deploy red guard")
  (smoke-trl-park-at 3)
  (smoke-v4-palace-scout2)
  (set! *smoke-los-watch* #t)
  (smoke-v4-overview)
  (smoke-trl-park-at 6)
  (smoke-v4-drop2 BF_TEAM_KG 'red-guard 1 0 "drop-kg-guard-palace")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 1 1 "drop-ff-guard-port")
  (smoke-v4-drop2 BF_TEAM_KG 'roboguard-city 0 3 "drop-kg-robot-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-jet 0 0 "drop-ff-jetpack-slums")
  (smoke-v4-drop2 BF_TEAM_KG 'spydroid 1 1 "drop-kg-spider-palace")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 0 2 "drop-ff-guard-slums")
  (smoke-v4-drop2 BF_TEAM_KG 'red-jet 0 2 "drop-kg-jetpack-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-jet 1 2 "drop-ff-jetpack-port")
  ;; spares, other styles
  (smoke-v4-drop2 BF_TEAM_KG 'red-guard 0 1 "drop-kg-guard-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 1 0 "drop-ff-guard-port-2")
  (smoke-v4-drop2 BF_TEAM_KG 'roboguard-city 1 2 "drop-kg-robot-palace")
  (smoke-v4-drop2 BF_TEAM_KG 'spydroid 0 0 "drop-kg-spider-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 0 3 "drop-ff-guard-slums-2")
  (smoke-v4-drop2 BF_TEAM_KG 'red-jet 1 0 "drop-kg-jetpack-palace")
  (set! *smoke-los-watch* #f)
  0
  )

;; trailer v4: the pull-back, the attacks seen from open still cameras, point of view without HUD,
;; the spider's sprint and blast

;; the units of each side a pull-back waits for (`smoke-v4-pullback`)
(define *smoke-v4-pull-want* 10)

(defbehavior smoke-v4-pullback process ((clip string) (up float) (secs float))
  "A dense fight (`smoke-trl-wait-mix`: 10 of each side within 40 m, 40 s at most): the camera from
   10 m over it and 4 m off, on its clearest heading, straight back and up to UP over it (a third of
   UP off), looking at the fight, its look following the mix (`smoke-trl-battle-take`, the fight
   criterion logged): CLIP, SECS, no HUD."
  (let ((at (new 'stack-no-clear 'vector))
        (a (new 'stack-no-clear 'vector))
        (b (new 'stack-no-clear 'vector))
        (look (new 'stack-no-clear 'vector))
        )
    (when (> (smoke-trl-wait-mix at *smoke-v4-pull-want* 60.0) 0)
      (let* ((off (/ up 3.0))
             (ang (smoke-trl-clear-dir at off up))
             )
        (set-vector! a (+ (-> at x) (* (meters 4) (sin ang))) (+ (-> at y) (meters 10)) (+ (-> at z) (* (meters 4) (cos ang))) 1.0)
        (set-vector! b (+ (-> at x) (* off (sin ang))) (+ (-> at y) up) (+ (-> at z) (* off (cos ang))) 1.0)
        )
      (vector-copy! look at)
      (+! (-> look y) (meters 1))
      (smoke-cine-line a b look secs)
      (smoke-wait 0.3)
      (smoke-trl-battle-take clip secs at)
      (smoke-cine-off)
      )
    )
  0
  )

(define *smoke-v4-sides* (new 'static 'array float 8 90.0 -90.0 70.0 -70.0 110.0 -110.0 135.0 -135.0))
;; the first of `*smoke-v4-sides*` tried (6: over the shoulder first, the shot's way toward the enemies)
(define *smoke-v4-side-start* 0)
;; points of view from a fight's flank (`smoke-v4-pov-flank`) instead of its open side
(define *smoke-v4-flank?* #f)
;; points of view with the battle's HUD on (normal gameplay; `smoke-v4-pov-hud`)
(define *smoke-v4-hud?* #f)
(define-extern smoke-v4-side-clear? (function vector vector float symbol))
(define-extern smoke-v4-pov-flank (function symbol :behavior process))

(defun smoke-v4-attack-cam ((near float) (far float) (up float) (lift float))
  "A still camera for an attack: around the point 40 % of the way from Jak to the tracked enemy, on
   the side of their line (8 headings from Jak's aim, 90 degrees first, 135 last: over his shoulder),
   NEAR then halfway then FAR off and UP high, then 1.5 times UP; the first spot with a clear line
   (a 0.5 m sphere) to Jak's chest (LIFT over his pivot: a jetpack's climb), the enemy's chest and that
   point, and nothing within 4 m in front of the lens (a 1.2 m sphere). Looks at that point 1.2 m up
   (and LIFT / 2). The cinematic camera set there; returns #t when one was found."
  (let ((jak (bf-cam-pivot (new 'stack-no-clear 'vector)))
        (foe (smoke-trl-foe-pos (new 'stack-no-clear 'vector)))
        (mid (new 'stack-no-clear 'vector))
        (fwd (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (eye (new 'stack-no-clear 'vector))
        (ahead (new 'stack-no-clear 'vector))
        )
    (+! (-> jak y) lift)
    (+! (-> foe y) (meters 1.5))
    (vector-lerp! mid jak foe 0.4)
    (+! (-> mid y) (* -0.5 lift))
    (vector-! fwd foe jak)
    (set! (-> fwd y) 0.0)
    (vector-normalize! fwd 1.0)
    (dotimes (h 2)
      (dotimes (r 3)
        (dotimes (k 8)
          (vector-rotate-around-y! dir fwd (degrees (-> *smoke-v4-sides* (mod (+ k *smoke-v4-side-start*) 8))))
          (vector+float*! eye mid dir (lerp near far (* 0.5 (the float r))))
          (+! (-> eye y) (* up (if (zero? h) 1.0 1.5)))
          (set! (-> eye w) 1.0)
          (vector-! ahead mid eye)
          (vector-normalize! ahead (meters 4))
          (vector+! ahead ahead eye)
          (when (and (smoke-trl-los-r? eye jak (meters 0.5))
                     (smoke-trl-los-r? eye foe (meters 0.5))
                     (smoke-trl-los-r? eye mid (meters 0.5))
                     (smoke-trl-los-r? eye ahead (meters 1.2))
                     (smoke-v4-side-clear? eye mid (meters 6))
                     )
            (format 0 "SMOKE trailer attack spot ~M m off at ~R from the aim, ~M m up~%"
                    (lerp near far (* 0.5 (the float r))) (degrees (-> *smoke-v4-sides* (mod (+ k *smoke-v4-side-start*) 8)))
                    (* up (if (zero? h) 1.0 1.5)))
            (smoke-cine-line eye eye mid 1.0)
            (return #t)
            )
          )
        )
      )
    )
  (format 0 "SMOKE trailer: no open attack spot~%")
  #f
  )

(defbehavior smoke-v4-attack-start process ((dist float) (near float) (far float) (up float) (lift float))
  "Before an attack clip: Jak where units die (`smoke-trl-ability-start`), DIST from the nearest
   enemy, the aim tracker on; then a still camera on the attack (`smoke-v4-attack-cam`), three tries
   moving him to another enemy. Returns #t when the camera is set."
  (dotimes (i 3)
    (smoke-trl-ability-start dist)
    (set! *smoke-los-jak?* #t)
    (if (smoke-v4-attack-cam near far up lift)
        (return #t)
        )
    (smoke-aim-off!)
    )
  #f
  )

(defbehavior smoke-v4-attack-end process ()
  "After an attack clip: the recording, the tracker and the camera off."
  (smoke-trl-ability-end)
  (set! *smoke-los-jak?* #f)
  0
  )

(defbehavior smoke-v4-guard-attacks process ((tag string))
  "The guard's ranged attacks, each from a still open camera beside it, no HUD: a rifle burst
   (14 m from the enemy), the grenade launcher on a group (20 m, a wider camera for the arc), the
   tazer's bolt (8 m). Clips attack-TAG-rifle, -grenade, -tazer."
  (when (smoke-v4-attack-start (meters 14) (meters 9) (meters 14) (meters 2.5) 0.0)
    (format (clear *smoke-name*) "attack-~S-rifle" tag)
    (smoke-hd-start *smoke-name* 2)
    (smoke-aim-burst (pad-buttons r1) 1.6)
    (smoke-wait 0.3)
    (smoke-aim-burst (pad-buttons r1) 1.6)
    (smoke-v4-attack-end)
    )
  (smoke-press (pad-buttons up) 0.5)
  (when (smoke-v4-attack-start (meters 20) (meters 13) (meters 19) (meters 4) 0.0)
    (smoke-aim-group)
    (format (clear *smoke-name*) "attack-~S-grenade" tag)
    (smoke-hd-start *smoke-name* 2)
    (smoke-aim-tap (pad-buttons r1) 1.7)
    (smoke-aim-tap (pad-buttons r1) 1.9)
    (smoke-v4-attack-end)
    )
  (smoke-press (pad-buttons left) 0.5)
  (when (smoke-v4-attack-start (meters 8) (meters 6) (meters 10) (meters 2) 0.0)
    (format (clear *smoke-name*) "attack-~S-tazer" tag)
    (smoke-hd-start *smoke-name* 2)
    (smoke-aim-tap (pad-buttons r1) 1.6)
    (smoke-trl-close (meters 8))
    (smoke-aim-tap (pad-buttons r1) 1.6)
    (smoke-v4-attack-end)
    )
  (smoke-press (pad-buttons down) 0.5)
  0
  )

(defbehavior smoke-v4-crouch-attack process ((tag string))
  "The guard firing crouched (L1 held), from a still open camera beside it: attack-TAG-crouch."
  (when (smoke-v4-attack-start (meters 14) (meters 8) (meters 13) (meters 2) 0.0)
    (format (clear *smoke-name*) "attack-~S-crouch" tag)
    (smoke-hd-start *smoke-name* 2)
    (set! (-> *smoke-aim* base) (the-as int (pad-buttons l1)))
    (smoke-aim-burst (pad-buttons r1) 3.4)
    (set! (-> *smoke-aim* base) 0)
    (smoke-v4-attack-end)
    )
  0
  )

(defbehavior smoke-v4-jetpack-attack process ((tag string))
  "The jetpack taking off and firing its gun from the air (no rocket), from a still open camera beside
   the line to the enemy, framed for the jetpack 4 m up: attack-TAG-gun."
  (when (smoke-v4-attack-start (meters 18) (meters 12) (meters 18) (meters 5) (meters 4))
    (format (clear *smoke-name*) "attack-~S-gun" tag)
    (smoke-hd-start *smoke-name* 2)
    (smoke-aim-base (pad-buttons x) 0.9)
    (smoke-aim-burst (pad-buttons r1) 1.8)
    (smoke-wait 0.2)
    (smoke-aim-burst (pad-buttons r1) 1.8)
    (smoke-v4-attack-end)
    )
  (smoke-press (pad-buttons circle) 1.5)
  (smoke-neutral)
  0
  )

(defbehavior smoke-v4-robot-attacks process ()
  "The robotguard's ranged attacks, each from a still open camera beside it, no HUD: twin shots,
   grenades on a group, the shield up while firing. Clips attack-robotguard-shots, -grenades,
   -shield."
  (when (smoke-v4-attack-start (meters 16) (meters 10) (meters 15) (meters 3) 0.0)
    (smoke-hd-start "attack-robotguard-shots" 2)
    (smoke-aim-burst (pad-buttons r1) 3.2)
    (smoke-v4-attack-end)
    )
  (when (smoke-v4-attack-start (meters 22) (meters 14) (meters 20) (meters 4.5) 0.0)
    (smoke-aim-group)
    (smoke-hd-start "attack-robotguard-grenades" 2)
    (smoke-aim-tap (pad-buttons l1) 1.0)
    (smoke-aim-tap (pad-buttons l1) 1.0)
    (smoke-aim-tap (pad-buttons l1) 1.3)
    (smoke-v4-attack-end)
    )
  (when (smoke-v4-attack-start (meters 16) (meters 10) (meters 15) (meters 3) 0.0)
    (smoke-press (pad-buttons circle) 0.3)
    (smoke-hd-start "attack-robotguard-shield" 2)
    (smoke-aim-burst (pad-buttons r1) 3.4)
    (smoke-v4-attack-end)
    )
  0
  )

(defbehavior smoke-v4-pov-spot process ()
  "Jak on open ground facing a dense fight (`smoke-trl-wait-mix`, 8 of each side, 30 s at most): of
   12 headings around it, 20, 24 then 16 m off, the first spot with ground under it, a clear line to
   the fight (a 0.8 m sphere) and room behind it for the camera (9 m back and 3 m up, clear from
   Jak and to the fight). Returns #t when one was found."
  (let ((at (new 'stack-no-clear 'vector))
        (p (new 'stack-no-clear 'vector))
        (c (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (low (new 'stack-no-clear 'vector))
        (dists (new 'static 'array float 3 20.0 24.0 16.0))
        )
    (when (> (smoke-trl-wait-mix at 8 30.0) 0)
      (+! (-> at y) (meters 1.5))
      (dotimes (r 3)
        (dotimes (k 12)
          (set-vector! dir (sin (degrees (* 30.0 (the float k)))) 0.0 (cos (degrees (* 30.0 (the float k)))) 1.0)
          (vector+float*! p at dir (meters (-> dists r)))
          (vector+float*! c p dir (meters 9))
          (+! (-> c y) (meters 3))
          (vector-copy! low p)
          (+! (-> low y) (meters -6))
          (when (and (not (smoke-trl-los-r? p low (meters 0.3)))
                     (smoke-trl-los-r? p at (meters 0.8))
                     (smoke-trl-los-r? p c (meters 0.6))
                     (smoke-trl-los-r? c at (meters 0.5))
                     )
            (format 0 "SMOKE trailer pov spot ~M m off the fight at ~R~%" (meters (-> dists r)) (degrees (* 30.0 (the float k))))
            (+! (-> p y) (meters 1))
            (move-to-point! (-> *target* control) p)
            (smoke-wait 0.4)
            (smoke-face at)
            (return #t)
            )
          )
        )
      )
    )
  (format 0 "SMOKE trailer: no open pov spot~%")
  #f
  )

(defbehavior smoke-v4-pov process ((class int) (clip string))
  "CLASS on open ground facing a dense fight (`smoke-v4-pov-spot`), the battle camera 1.4 times
   farther back (`*bf-cam-zoom*`), no HUD and no beam, the aim tracker on an enemy and every shot fired
   only while the aim is on one: CLIP, about 11 s. Guards run in, burst, strafe and burst, fire
   crouched, the grenade launcher on a group twice, the tazer twice; jetpacks climb, fire, boost,
   fire, come down; the robotguard fires, raises its shield and fires, throws grenades on a group,
   fires. No melee, no rocket, no blast. The blocked frames logged."
  (when (if *smoke-v4-flank?* (smoke-v4-pov-flank) (smoke-v4-pov-spot))
    (smoke-neutral)
    (set! *bf-cam-zoom* 1.4)
    (set! (-> *smoke-cine* nohud?) (not *smoke-v4-hud?*))
    (set! *smoke-los-jak?* #t)
    (smoke-aim-on! #f)
    (smoke-wait 0.8)
    (smoke-hd-start clip 2)
    (case class
      ((BF_CLASS_BLUE_GUARD BF_CLASS_RED_GUARD)
       (smoke-aim-run-to (meters 16) 1.0)
       (smoke-aim-burst (pad-buttons r1) 1.4)
       (smoke-stick 0 128 128 128)
       (smoke-press (pad-buttons l2) 0.5)
       (smoke-stick 128 128 128 128)
       (smoke-aim-burst (pad-buttons r1) 1.1)
       (set! (-> *smoke-aim* base) (the-as int (pad-buttons l1)))
       (smoke-aim-burst (pad-buttons r1) 1.4)
       (set! (-> *smoke-aim* base) 0)
       (smoke-press (pad-buttons up) 0.4)
       (smoke-aim-group)
       (smoke-aim-tap (pad-buttons r1) 1.2)
       (smoke-aim-tap (pad-buttons r1) 1.2)
       (smoke-press (pad-buttons left) 0.4)
       (smoke-aim-run-to (meters 9) 1.2)
       (smoke-aim-tap (pad-buttons r1) 1.2)
       (smoke-aim-tap (pad-buttons r1) 1.0)
       )
      ((BF_CLASS_BLUE_JETPACK BF_CLASS_RED_JETPACK)
       (smoke-aim-base (pad-buttons x) 0.8)
       (smoke-aim-burst (pad-buttons r1) 2.0)
       (smoke-stick 128 0 128 128)
       (smoke-aim-base (pad-buttons r2) 1.2)
       (smoke-stick 128 128 128 128)
       (smoke-aim-burst (pad-buttons r1) 1.8)
       (smoke-aim-burst (pad-buttons r1) 1.6)
       (smoke-aim-base (pad-buttons circle) 1.4)
       (smoke-aim-burst (pad-buttons r1) 1.2)
       )
      ((BF_CLASS_ROBOGUARD)
       (smoke-aim-burst (pad-buttons r1) 1.6)
       (smoke-press (pad-buttons circle) 0.3)
       (smoke-aim-burst (pad-buttons r1) 2.0)
       (smoke-aim-group)
       (smoke-aim-tap (pad-buttons l1) 0.9)
       (smoke-aim-tap (pad-buttons l1) 0.9)
       (smoke-aim-tap (pad-buttons l1) 0.9)
       (smoke-aim-burst (pad-buttons r1) 1.8)
       )
      )
    (smoke-hd-stop)
    (smoke-aim-off!)
    (if (or (= class BF_CLASS_BLUE_GUARD) (= class BF_CLASS_RED_GUARD))
        (smoke-press (pad-buttons down) 0.4)
        )
    (set! *bf-cam-zoom* 1.0)
    (set! (-> *smoke-cine* nohud?) #f)
    (set! *smoke-los-jak?* #f)
    (enable-hud)
    )
  0
  )

(defbehavior smoke-v4-respawn process ()
  "After the player's death (the spider's blast): X once he may respawn, then until he is in play
   again as the same class."
  (smoke-wait-for 20.0 (lambda () (and *target* (focus-test? *target* dead) (nonzero? (-> *bf* respawn-time))
                                       (>= (current-time) (-> *bf* respawn-time))
                                       )
                        )
                  )
  (smoke-press (pad-buttons x) 1.0)
  (smoke-wait-for 60.0 (lambda () (and (bf-avatar-alive?) *target* (not (focus-test? *target* dead)) (not (-> *bf* dropping?)))))
  (smoke-wait 1.0)
  0
  )

(defbehavior smoke-v4-spider-climax process ((clip string) (wide float) (high float))
  "The spider's last run, charged (`bf-nova-charge`, waited for): set 28 m from the biggest group of
   enemies on its clearest line, it sprints (R2) at the group, the camera low beside and behind it
   (3.5 m back, 4 m to the clearer side, 1.4 m up, looking 6 m ahead of it); within 6 m of the group
   (or 3 s in) the camera cuts to a still spot WIDE off the group and HIGH up (its clearest heading,
   a clear line to the spider checked, nearer and lower spots next) and the spider blows itself up
   (L1) among them; 6 s on the blast. Every game frame recorded (CLIP at half speed). Returns #t when
   filmed; the spider is dead after it."
  (smoke-wait-for 40.0 (lambda () (and (smoke-av) (>= (bf-nova-charge (smoke-av)) 1.0))))
  (format 0 "SMOKE trailer nova charge ~f~%" (if (smoke-av) (bf-nova-charge (smoke-av)) -1.0))
  (let* ((g (smoke-trl-group-foe (-> *target* control trans) (meters 200)))
         (gp (the-as process-drawable (handle->process g)))
         )
    (when gp
      (let* ((at (vector-copy! (new 'stack-no-clear 'vector) (-> gp root trans)))
             (ang (smoke-trl-clear-dir at (meters 28) (meters 2)))
             (s (new 'stack-no-clear 'vector))
             (fwd (new 'stack-no-clear 'vector))
             (side (new 'stack-no-clear 'vector))
             (eye (new 'stack-no-clear 'vector))
             (look (new 'stack-no-clear 'vector))
             (t0 0)
             )
        (set-vector! s (+ (-> at x) (* (meters 28) (sin ang))) (+ (-> at y) (meters 2)) (+ (-> at z) (* (meters 28) (cos ang))) 1.0)
        (move-to-point! (-> *target* control) s)
        (smoke-wait 0.5)
        (smoke-neutral)
        (smoke-face at)
        (smoke-aim-on! #t)
        (set! (-> *smoke-aim* foe) g)
        (vector-! fwd at s)
        (set! (-> fwd y) 0.0)
        (vector-normalize! fwd 1.0)
        (set-vector! side (-> fwd z) 0.0 (- (-> fwd x)) 1.0)
        ;; the clearer side
        (vector+float*! eye s side (meters 4))
        (if (not (smoke-trl-los-r? s eye (meters 0.5)))
            (vector-negate! side side)
            )
        (set! *smoke-los-jak?* #t)
        (set! (-> *smoke-cine* nohud?) #t)
        (smoke-hd-start clip 1)
        (smoke-stick 128 0 128 128)
        (set! (-> *smoke-aim* base) (the-as int (pad-buttons r2)))
        (set! t0 (smoke-now))
        (while (and (< (- (smoke-now) t0) (seconds 3))
                    (let ((q (the-as process-drawable (handle->process g))))
                      (or (not q) (< (meters 6) (vector-vector-xz-distance (-> q root trans) (-> *target* control trans))))
                      )
                    )
          (vector+float*! eye (-> *target* control trans) fwd (meters -3.5))
          (vector+float*! eye eye side (meters 4))
          (+! (-> eye y) (meters 1.4))
          (vector+float*! look (-> *target* control trans) fwd (meters 6))
          (+! (-> look y) (meters 0.8))
          (smoke-cine-line eye eye look 1.0)
          (suspend)
          )
        (smoke-stick 128 128 128 128)
        (set! (-> *smoke-aim* base) 0)
        ;; the wide spot
        (vector-copy! at (-> *target* control trans))
        (+! (-> at y) (meters 1))
        (let ((found #f))
          (dotimes (r 3)
            (when (not found)
              (let* ((d (* wide (-> (new 'static 'array float 3 1.0 0.85 1.15) r)))
                     (h (* high (-> (new 'static 'array float 3 1.0 0.8 1.2) r)))
                     (a2 (smoke-trl-clear-dir at d h))
                     )
                (set-vector! eye (+ (-> at x) (* d (sin a2))) (+ (-> at y) h) (+ (-> at z) (* d (cos a2))) 1.0)
                (when (smoke-trl-los-r? eye at (meters 0.5))
                  (set! found #t)
                  (format 0 "SMOKE trailer blast spot ~M m off, ~M m up~%" d h)
                  )
                )
              )
            )
          )
        (vector-copy! look at)
        (+! (-> look y) (meters 4))
        (smoke-cine-line eye eye look 1.0)
        (smoke-wait 0.25)
        (smoke-hold (pad-buttons l1))
        (smoke-wait 0.3)
        (smoke-hold (the-as pad-buttons 0))
        (smoke-wait 6.0)
        (smoke-hd-stop)
        (smoke-aim-off!)
        (smoke-cine-off)
        (set! *smoke-los-jak?* #f)
        (return #t)
        )
      )
    )
  #f
  )

(defbehavior smoke-v4-kg-part process ()
  "Trailer v4, the Krimzon Guard: the drops of both sides (no control point held, every unit sent
   to the Central Quarter, `smoke-v4-drop`); then at the Palace Plaza (both armies sent there,
   `smoke-trl-front3`): the overview candidates while the armies meet (`smoke-v4-overview2`); as the
   spider, two pull-backs over the fight (100 and 150 m up) while it charges, then its sprint into
   the enemies and its blast, twice (respawned between); the red guard's ranged attacks from still
   open cameras and two point-of-view takes without HUD; the red jetpack's gun from the air and a
   point-of-view take; the robotguard's ranged attacks and a point-of-view take. The line of sight
   watched. Starts the battle itself."
  (set! *smoke-trl-hour* 12)
  (smoke-trl-v2-start BF_TEAM_KG 0 "deploy red guard")
  (smoke-trl-park-at 6)
  (set! *smoke-los-watch* #t)
  (set! *smoke-battle-secs* 8.0)
  ;; drops: every unit sent to the Central Quarter, no control point held
  (smoke-goal-force! 9)
  (smoke-v4-points-neutral)
  (smoke-v4-drop2 BF_TEAM_KG 'red-guard 1 0 "drop-kg-guard-palace")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 1 1 "drop-ff-guard-port")
  (smoke-v4-drop2 BF_TEAM_KG 'roboguard-city 0 3 "drop-kg-robot-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-jet 0 0 "drop-ff-jetpack-slums")
  (smoke-v4-drop2 BF_TEAM_KG 'spydroid 1 1 "drop-kg-spider-palace")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 0 2 "drop-ff-guard-slums")
  (smoke-v4-drop2 BF_TEAM_KG 'red-jet 0 2 "drop-kg-jetpack-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-jet 1 2 "drop-ff-jetpack-port")
  (smoke-v4-drop2 BF_TEAM_KG 'red-guard 0 1 "drop-kg-guard-stadium")
  (smoke-v4-drop2 BF_TEAM_FF 'blue-guard 1 0 "drop-ff-guard-port-2")
  ;; the front at the Palace Plaza; the overview while the armies meet
  (smoke-trl-front3 14 9 11)
  (smoke-step "front palace plaza")
  (smoke-v4-overview2)
  ;; the spider charges (30 s) during the pull-backs
  (smoke-change-class 3 "spider")
  (smoke-trl-park-at 3)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-pullback "pullback-palace-1" (meters 100) 11.0)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-pullback "pullback-palace-2" (meters 150) 12.0)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-spider-climax "climax-spider-1-slow" (meters 45) (meters 15))
  (smoke-v4-respawn)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-spider-climax "climax-spider-2-slow" (meters 52) (meters 18))
  (smoke-v4-respawn)
  (smoke-change-class 0 "red guard")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-guard-attacks "red-guard")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-pov BF_CLASS_RED_GUARD "pov-red-guard-1")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-pov BF_CLASS_RED_GUARD "pov-red-guard-2")
  (smoke-change-class 1 "red jetpack")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-jetpack-attack "red-jetpack")
  (smoke-trl-front3 14 9 11)
  (set! *smoke-aim-pitch-min* (degrees -20))
  (smoke-v4-pov BF_CLASS_RED_JETPACK "pov-red-jetpack-1")
  (set! *smoke-aim-pitch-min* BF_PITCH_DOWN)
  (smoke-change-class 2 "robotguard")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-robot-attacks)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-pov BF_CLASS_ROBOGUARD "pov-robotguard-1")
  (smoke-trl-front-off)
  0
  )

(defun smoke-v4-front ((p int))
  "A front at control point P (`smoke-trl-front3`), its two held points chosen: of the other control
   points 150 to 520 m from P (the points stand 200 to 600 m apart; 70 to 260 m found no pair), the pair whose distances to P differ least, the Freedom League's the one
   nearer its headquarters (points 0 and 2). Returns #t when a pair was found."
  (let ((ba -1)
        (bb -1)
        (best (meters 100000))
        (pp (-> *bf* points p pos))
        )
    (dotimes (a (-> *bf* point-count))
      (dotimes (b (-> *bf* point-count))
        (when (and (< a b) (!= a p) (!= b p) (not (-> *bf* points a base?)) (not (-> *bf* points b base?)))
          (let ((da (vector-vector-xz-distance pp (-> *bf* points a pos)))
                (db (vector-vector-xz-distance pp (-> *bf* points b pos)))
                )
            (when (and (< (meters 150) da) (< da (meters 520)) (< (meters 150) db) (< db (meters 520))
                       (< (fabs (- da db)) best)
                       )
              (set! best (fabs (- da db)))
              (set! ba a)
              (set! bb b)
              )
            )
          )
        )
      )
    (when (>= ba 0)
      (let ((fa (fmin (vector-vector-xz-distance (-> *bf* points ba pos) (-> *bf* points 0 pos))
                      (vector-vector-xz-distance (-> *bf* points ba pos) (-> *bf* points 2 pos))
                      )
                )
            (fb (fmin (vector-vector-xz-distance (-> *bf* points bb pos) (-> *bf* points 0 pos))
                      (vector-vector-xz-distance (-> *bf* points bb pos) (-> *bf* points 2 pos))
                      )
                )
            )
        (if (< fa fb)
            (smoke-trl-front3 p ba bb)
            (smoke-trl-front3 p bb ba)
            )
        )
      (return #t)
      )
    )
  ;; none 150 to 520 m off (a headquarters far out): the two nearest control points
  (let ((n1 -1)
        (n2 -1)
        )
    (dotimes (a (-> *bf* point-count))
      (when (and (!= a p) (not (-> *bf* points a base?)))
        (let ((da (vector-vector-xz-distance (-> *bf* points p pos) (-> *bf* points a pos))))
          (cond
            ((or (< n1 0) (< da (vector-vector-xz-distance (-> *bf* points p pos) (-> *bf* points n1 pos))))
             (set! n2 n1)
             (set! n1 a)
             )
            ((or (< n2 0) (< da (vector-vector-xz-distance (-> *bf* points p pos) (-> *bf* points n2 pos))))
             (set! n2 a)
             )
            )
          )
        )
      )
    (when (>= n2 0)
      (format 0 "SMOKE trailer: no front pair for point ~D, the nearest two instead~%" p)
      (smoke-trl-front3 p n1 n2)
      (return #t)
      )
    )
  (format 0 "SMOKE trailer: no front pair for point ~D~%" p)
  #f
  )

(defbehavior smoke-v4-battles process ((p int) (n0 int) (count int))
  "COUNT battle clips at a front at P (`smoke-v4-front`, staged again before each; 55 s for the
   armies to meet first), numbered from N0, orbits and pushes in turn (`smoke-trl-battle`, 9 units of
   each side mixed, the fight criterion logged)."
  (when (smoke-v4-front p)
    (format (clear *smoke-name*) "front ~S" (-> *smoke-trl-slugs* p))
    (smoke-step *smoke-name*)
    (smoke-wait 55.0)
    (dotimes (k count)
      (smoke-v4-front p)
      (smoke-trl-battle #f (+ n0 k) (= (logand k 1) 1) 9 40.0)
      )
    )
  0
  )

(defbehavior smoke-v4-ff-part process ((new? symbol))
  "Trailer v4, the Freedom League (a new battle from the running one with NEW?, else the battle
   started from the title): at the Palace Plaza (both
   armies sent there), the blue guard firing crouched and its rifle from still open cameras, three
   point-of-view takes without HUD; the blue jetpack's gun from the air and a point-of-view take;
   then battle clips at fronts in six more districts (the North Farms, the West Farms, the Central
   Quarter, the South Industrial Zone, the North Industrial Zone, the South Slums). The battle points'
   places logged. The line of sight watched. No check of its own."
  (set! *smoke-trl-hour* 12)
  (cond
    (new?
     ;; START > New battle (`smoke-battle-start` in the city), the per-frame process already running
     (smoke-cine-off)
     (smoke-trl-front-off)
     (smoke-battle-start BF_ZONE_JAK2 BF_TEAM_FF)
     (smoke-deploy 0 "deploy blue guard")
     (smoke-invulnerable #t)
     (smoke-trl-daylight)
     )
    (else
      (smoke-trl-v2-start BF_TEAM_FF 0 "deploy blue guard")
      )
    )
  (smoke-trl-park-at 2)
  (dotimes (i (-> *bf* point-count))
    (format 0 "SMOKE point ~D ~S at ~M ~M ~M~%" i (-> *smoke-trl-slugs* i) (-> *bf* points i pos x) (-> *bf* points i pos y)
            (-> *bf* points i pos z))
    )
  (set! *smoke-los-watch* #t)
  (set! *smoke-battle-secs* 8.0)
  (smoke-trl-front3 14 9 11)
  (smoke-step "front palace plaza")
  (smoke-wait 80.0)
  (smoke-trl-front3 14 9 11)
  (smoke-v4-crouch-attack "blue-guard")
  (smoke-trl-front3 14 9 11)
  (when (smoke-v4-attack-start (meters 14) (meters 9) (meters 14) (meters 2.5) 0.0)
    (smoke-hd-start "attack-blue-guard-rifle" 2)
    (smoke-aim-burst (pad-buttons r1) 1.6)
    (smoke-wait 0.3)
    (smoke-aim-burst (pad-buttons r1) 1.6)
    (smoke-v4-attack-end)
    )
  (dotimes (k 3)
    (smoke-trl-front3 14 9 11)
    (format (clear *smoke-name*) "pov-blue-guard-~D" (+ k 1))
    (smoke-v4-pov BF_CLASS_BLUE_GUARD *smoke-name*)
    )
  (smoke-change-class 1 "blue jetpack")
  (smoke-trl-front3 14 9 11)
  (smoke-v4-jetpack-attack "blue-jetpack")
  (smoke-trl-front3 14 9 11)
  (set! *smoke-aim-pitch-min* (degrees -20))
  (smoke-v4-pov BF_CLASS_BLUE_JETPACK "pov-blue-jetpack-1")
  (set! *smoke-aim-pitch-min* BF_PITCH_DOWN)
  (smoke-change-class 0 "blue guard")
  (smoke-trl-park-at 2)
  (smoke-v4-battles 11 1 2)
  (smoke-v4-battles 10 3 2)
  (smoke-v4-battles 9 5 2)
  (smoke-v4-battles 16 7 2)
  (smoke-v4-battles 15 9 2)
  (smoke-v4-battles 6 11 2)
  (smoke-trl-front-off)
  (set! *smoke-los-watch* #f)
  0
  )

