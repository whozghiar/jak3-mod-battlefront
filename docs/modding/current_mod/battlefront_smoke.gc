  )

(defbehavior smoke-s38 process ()
  "Scenario 38 (`smoke-scenario-late`)."
  ;; Round 26: two minutes of battle watching the robotguards and spiders as they fall, out of the
  ;; sky and out of the ships, one by one
  (smoke-mods-toggle "mods-menu-on")
  (smoke-battle-start 0 BF_TEAM_KG)
  (smoke-deploy 0 "deploy red guard")
  (smoke-invulnerable #t)
